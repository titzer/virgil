// Represents the statically-known part of an operation, including type parameters, which is the
// minimal information to evaluate the operation on a program state. Together with representation
// decisions, an opcode is enough to generate target code.
// In order to make an opcode more useful to the rest of the compiler, it is normally wrapped
// into an {Operator}, which caches the signature (parameter and return types).
//
// This sketch mirrors the case set of {aeneas/src/core/Opcode.v3}, the signatures built in
// {V3Op} (aeneas/src/core/Operator.v3), and the facts registered in {Opcodes.table}, with the
// types folded into the opcode itself. Fields are typed as narrowly as every construction site
// allows; a field is a plain {Type} where a template operator holds a type parameter there
// until it is instantiated (e.g. the {T} of {Pointer.load<T>}).
type Opcode {
	def facts() -> Fact.set { return NONE; }			// optimization facts
	def sig() -> Signature;						// computes a new signature
	def subst(f: Type -> Type) -> Opcode { return this; }		// perform a type substitution
	def op() -> Operator { return Operator.new(this, sig()); }	// create an operator from this opcode

	// Boolean operators
	case BoolEq 			{ def facts() => P|C; def sig() => Sxx_y(TYPE_bool, TYPE_bool); }
	case BoolAnd			{ def facts() => P|C; def sig() => Sxx_x(TYPE_bool); }
	case BoolOr			{ def facts() => P|C; def sig() => Sxx_x(TYPE_bool); }
	case BoolNot			{ def facts() => P; def sig() => Sx_x(TYPE_bool); }
	// Integer arithmetic and conversions; {t} of {IntEq} is an {IntType}, {EnumType}, or {EnumSetType}
	case IntEq(t: Type)		{ def facts() => P|C; def sig() => Sxx_y(t, TYPE_bool); def subst(f: Type -> Type) => Opcode.IntEq(f(t)); }
	case IntAdd(t: IntType)		{ def facts() => P|C; def sig() => Sxx_x(t); }
	case IntSub(t: IntType)		{ def facts() => P; def sig() => Sxx_x(t); }
	case IntMul(t: IntType)		{ def facts() => P|C; def sig() => Sxx_x(t); }
	case IntDiv(t: IntType)		{ def facts() => F; def sig() => Sxx_x(t); }
	case IntMod(t: IntType)		{ def facts() => F; def sig() => Sxx_x(t); }
	case IntAnd(t: IntType)		{ def facts() => P|C; def sig() => Sxx_x(t); }
	case IntOr(t: IntType)		{ def facts() => P|C; def sig() => Sxx_x(t); }
	case IntXor(t: IntType)		{ def facts() => P|C; def sig() => Sxx_x(t); }
	case IntShl(t: IntType)		{ def facts() => P; def sig() => Sxy_x(t, TYPE_byte); }
	case IntSar(t: IntType)		{ def facts() => P; def sig() => Sxy_x(t, TYPE_byte); }
	case IntShr(t: IntType)		{ def facts() => P; def sig() => Sxy_x(t, TYPE_byte); }
	case IntLt(t: IntType)		{ def facts() => P; def sig() => Sxx_y(t, TYPE_bool); }
	case IntLteq(t: IntType)	{ def facts() => P; def sig() => Sxx_y(t, TYPE_bool); }
	// A wide (multi-word) arithmetic operation over the normalized parts of {op}'s operands.
	case IntWide(wideOp: Operator, paramTypes: Array<Type>, resultType: Type) {
		def facts() => P;
		def sig() => Sa_x(paramTypes, resultType);
	}
	// Floating point arithmetic
	case FloatAdd(t: FloatType)	{ def facts() => P|C; def sig() => Sxx_x(t); }
	case FloatSub(t: FloatType)	{ def facts() => P; def sig() => Sxx_x(t); }
	case FloatMul(t: FloatType)	{ def facts() => P|C; def sig() => Sxx_x(t); }
	case FloatDiv(t: FloatType)	{ def facts() => P; def sig() => Sxx_x(t); }
	case FloatBitEq(t: FloatType)	{ def facts() => P|C; def sig() => Sxx_y(t, TYPE_bool); }
	case FloatEq(t: FloatType)	{ def facts() => P|C; def sig() => Sxx_y(t, TYPE_bool); }
	case FloatNe(t: FloatType)	{ def facts() => P|C; def sig() => Sxx_y(t, TYPE_bool); }
	case FloatLt(t: FloatType)	{ def facts() => P; def sig() => Sxx_y(t, TYPE_bool); }
	case FloatLteq(t: FloatType)	{ def facts() => P; def sig() => Sxx_y(t, TYPE_bool); }
	case FloatAbs(t: FloatType)	{ def facts() => P; def sig() => Sx_x(t); }
	case FloatCeil(t: FloatType)	{ def facts() => P; def sig() => Sx_x(t); }
	case FloatFloor(t: FloatType)	{ def facts() => P; def sig() => Sx_x(t); }
	case FloatSqrt(t: FloatType)	{ def facts() => P; def sig() => Sx_x(t); }
	// Integer casts and conversions
	case IntCastF(from: FloatType, to: IntType)		{ def facts() => F; def sig() => Sx_y(from, to); }
	case IntQueryF(from: FloatType, to: IntType)		{ def facts() => P; def sig() => Sx_y(from, TYPE_bool); }
	case IntViewI(from: IntType, to: IntType)		{ def facts() => P; def sig() => Sx_y(from, to); }
	case IntViewB(to: IntType)				{ def facts() => P; def sig() => Sx_y(TYPE_bool, to); }
	case IntViewP(from: PointerType, to: IntType)		{ def sig() => Sx_y(from, to); }
	// Map an integer tag to an enum, out-of-range => tag 0.
	case EnumViewI(from: IntType, to: EnumType)		{ def facts() => P|NNEG; def sig() => Sx_y(from, to); }
	// Reinterpret an integer as an enum set's bit representation.
	case EnumSetViewI(from: Type, to: EnumSetType) {
		def facts() => P|NNEG;
		def sig() => Sx_y(from, to);
		def subst(f: Type -> Type) => Opcode.EnumSetViewI(f(from), to);
	}
	// The result is the unsigned integer type of the same width as {from}.
	case IntViewF(from: FloatType)				{ def facts() => P; def sig() => Sx_y(from, unsignedOfWidth(from)); }
	case IntTruncF(from: FloatType, to: IntType)		{ def facts() => P; def sig() => Sx_y(from, to); }
	// Floating point casts and conversions
	case FloatCastI(from: IntType, to: FloatType)		{ def facts() => F; def sig() => Sx_y(from, to); }
	case FloatCastD						{ def facts() => F; def sig() => Sx_y(TYPE_double, TYPE_float); }
	case FloatQueryI(from: IntType, to: FloatType)		{ def facts() => P; def sig() => Sx_y(from, TYPE_bool); }
	case FloatQueryD					{ def facts() => P; def sig() => Sx_y(TYPE_double, TYPE_bool); }
	case FloatPromoteI(from: IntType, to: FloatType)	{ def facts() => P; def sig() => Sx_y(from, to); }
	case FloatPromoteF					{ def facts() => P; def sig() => Sx_y(TYPE_float, TYPE_double); }
	case FloatViewI(from: Type, to: FloatType) {
		def facts() => P;
		def sig() => Sx_y(from, to);
		def subst(f: Type -> Type) => Opcode.FloatViewI(f(from), to);
	}
	case FloatRoundI(from: Type, to: FloatType) {
		def facts() => P;
		def sig() => Sx_y(from, to);
		def subst(f: Type -> Type) => Opcode.FloatRoundI(f(from), to);
	}
	case FloatRound(t: FloatType)				{ def facts() => P; def sig() => Sx_x(t); }
	case FloatRoundD					{ def facts() => P; def sig() => Sx_y(TYPE_double, TYPE_float); }
	// Reference equality
	case RefEq(t: Type)		{ def facts() => P|C; def sig() => Sxx_y(t, TYPE_bool); def subst(f: Type -> Type) => Opcode.RefEq(f(t)); }
	// Default value operator
	case DefaultValue(t: Type)	{ def facts() => P; def sig() => S_x(t); def subst(f: Type -> Type) => Opcode.DefaultValue(f(t)); }
	// Tuple operations
	case TupleCreate(t: TupleType) {
		def facts() => P;
		def sig() => Sa_x(t.elems(), t);
		def subst(f: Type -> Type) => Opcode.TupleCreate(TupleType.!(f(t)));
	}
	case TupleGetElem(t: TupleType, index: int) {
		def facts() => P;
		def sig() => Sx_y(t, t.elems()[index]);
		def subst(f: Type -> Type) => Opcode.TupleGetElem(TupleType.!(f(t)), index);
	}
	// Array operations
	case ArrayAlloc(t: ArrayType) {
		def facts() => NZ;
		def sig() => Sx_y(TYPE_int, t);
		def subst(f: Type -> Type) => Opcode.ArrayAlloc(ArrayType.!(f(t)));
	}
	case ArrayFill(t: ArrayType) {
		def facts() => NZ;
		def sig() => Sxy_x(t, t.elem());
		def subst(f: Type -> Type) => Opcode.ArrayFill(ArrayType.!(f(t)));
	}
	case ArrayInit(t: ArrayType, length: int) {
		def facts() => NZ;
		def sig() => Sa_x(Arrays_repeat(t.elem(), length), t);
		def subst(f: Type -> Type) => Opcode.ArrayInit(ArrayType.!(f(t)), length);
	}
	// Initializes an array of tuples from {length} groups of {elems} flattened tuple elements.
	case ArrayTupleInit(t: ArrayType, elems: int, length: int) {
		def facts() => NZ;
		def sig() => Sa_x(tupleElemsRepeat(t, elems, length), t);
		def subst(f: Type -> Type) => Opcode.ArrayTupleInit(ArrayType.!(f(t)), elems, length);
	}
	case ArrayGetElem(t: ArrayType, it: IntType) {
		def sig() => Sxy_z(t, it, t.elem());
		def subst(f: Type -> Type) => Opcode.ArrayGetElem(ArrayType.!(f(t)), it);
	}
	case ArraySetElem(t: ArrayType, it: IntType) {
		def sig() => Sxyz_w(t, it, t.elem(), TYPE_void);
		def subst(f: Type -> Type) => Opcode.ArraySetElem(ArrayType.!(f(t)), it);
	}
	case ArrayGetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() => Sxy_z(t, it, tupleElem(t, index));
		def subst(f: Type -> Type) => Opcode.ArrayGetElemElem(ArrayType.!(f(t)), it, index);
	}
	case ArraySetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() => Sxyz_w(t, it, tupleElem(t, index), TYPE_void);
		def subst(f: Type -> Type) => Opcode.ArraySetElemElem(ArrayType.!(f(t)), it, index);
	}
	case ArrayGetLength(t: ArrayType) {
		def facts() => F|NNEG;
		def sig() => Sx_y(t, TYPE_int);
		def subst(f: Type -> Type) => Opcode.ArrayGetLength(ArrayType.!(f(t)));
	}
	// Range operations
	case RangeFromTo(t: RangeType, startType: IntType, endType: IntType) {
		def facts() => F;
		def sig() => Sxyz_w(t, startType, endType, t);
		def subst(f: Type -> Type) => Opcode.RangeFromTo(RangeType.!(f(t)), startType, endType);
	}
	case RangeFromPlus(t: RangeType, startType: IntType, lengthType: IntType) {
		def facts() => F;
		def sig() => Sxyz_w(t, startType, lengthType, t);
		def subst(f: Type -> Type) => Opcode.RangeFromPlus(RangeType.!(f(t)), startType, lengthType);
	}
	case RangeGetElem(t: RangeType, it: IntType) {
		def sig() => Sxy_z(t, it, t.elem());
		def subst(f: Type -> Type) => Opcode.RangeGetElem(RangeType.!(f(t)), it);
	}
	case RangeSetElem(t: RangeType, it: IntType) {
		def sig() => Sxyz_w(t, it, t.elem(), TYPE_void);
		def subst(f: Type -> Type) => Opcode.RangeSetElem(RangeType.!(f(t)), it);
	}
	case RangeGetLength(t: RangeType) {
		def facts() => P;
		def sig() => Sx_y(t, TYPE_int);
		def subst(f: Type -> Type) => Opcode.RangeGetLength(RangeType.!(f(t)));
	}
	// Normalized range operations; {t} is the type of the array underlying the range, whose
	// start is passed as a separate #RangeStart parameter.
	case RangeStartPlusIndex(t: ArrayType, it: IntType) {
		def facts() => P;
		def sig() => Sxyz_w(t, TYPE_range_start, it, TYPE_range_start);
		def subst(f: Type -> Type) => Opcode.RangeStartPlusIndex(ArrayType.!(f(t)), it);
	}
	case NormRangeGetElem(t: ArrayType, it: IntType) {
		def sig() => Sxyz_w(t, TYPE_range_start, it, t.elem());
		def subst(f: Type -> Type) => Opcode.NormRangeGetElem(ArrayType.!(f(t)), it);
	}
	case NormRangeGetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() => Sxyz_w(t, TYPE_range_start, it, tupleElem(t, index));
		def subst(f: Type -> Type) => Opcode.NormRangeGetElemElem(ArrayType.!(f(t)), it, index);
	}
	case NormRangeSetElem(t: ArrayType, it: IntType) {
		def sig() => Sxyzw_v(t, TYPE_range_start, it, t.elem(), TYPE_void);
		def subst(f: Type -> Type) => Opcode.NormRangeSetElem(ArrayType.!(f(t)), it);
	}
	case NormRangeSetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() => Sxyzw_v(t, TYPE_range_start, it, tupleElem(t, index), TYPE_void);
		def subst(f: Type -> Type) => Opcode.NormRangeSetElemElem(ArrayType.!(f(t)), it, index);
	}
	// Component operations
	case Init(method: IrMethod) 				{ def sig() => S_x(method.receiver); }
	case ComponentGetField(t: ComponentType, field: IrField) { def facts() => NNC; def sig() => Sx_y(t, fieldType(t, field)); }
	case ComponentSetField(t: ComponentType, field: IrField) { def facts() => NNC; def sig() => Sxy_z(t, fieldType(t, field), TYPE_void); }
	// Class operations
	case ClassAlloc(t: ClassType) {
		def facts() => NZ;
		def sig() => S_x(t);
		def subst(f: Type -> Type) => Opcode.ClassAlloc(ClassType.!(f(t)));
	}
	case ClassAllocWithDescriptor(t: ClassType, descType: Type) {
		def facts() => NZ;
		def sig() => Sx_y(descType, t);
		def subst(f: Type -> Type) => Opcode.ClassAllocWithDescriptor(ClassType.!(f(t)), f(descType));
	}
	case ClassNew(spec: IrSpec) {
		def sig() => Sa_x(spec.getBoundType().paramTypes(), spec.receiver);
		def subst(f: Type -> Type) => Opcode.ClassNew(substSpec(spec, f));
	}
	case ClassGetField(t: ClassType, field: IrField) {
		def sig() => Sx_y(t, fieldType(t, field));
		def subst(f: Type -> Type) => Opcode.ClassGetField(ClassType.!(f(t)), field);
	}
	case ClassInitField(t: ClassType, field: IrField) {
		def facts() => NNC;
		def sig() => Sxy_z(t, fieldType(t, field), TYPE_void);
		def subst(f: Type -> Type) => Opcode.ClassInitField(ClassType.!(f(t)), field);
	}
	case ClassSetField(t: ClassType, field: IrField) {
		def sig() => Sxy_z(t, fieldType(t, field), TYPE_void);
		def subst(f: Type -> Type) => Opcode.ClassSetField(ClassType.!(f(t)), field);
	}
	case ClassGetMethod(spec: IrSpec) {
		def facts() => NZ|F;
		def sig() => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) => Opcode.ClassGetMethod(substSpec(spec, f));
	}
	case ClassGetVirtual(spec: IrSpec) {
		def facts() => NZ|F;
		def sig() => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) => Opcode.ClassGetVirtual(substSpec(spec, f));
	}
	case ClassGetSelector(spec: IrSpec) {
		def facts() => NZ|F;
		def sig() => Sx_y(spec.receiver, spec.getFuncType());
		def subst(f: Type -> Type) => Opcode.ClassGetSelector(substSpec(spec, f));
	}
	// Variant operations
	case VariantEq(t: ClassType) {
		def facts() => P|C;
		def sig() => Sxx_y(t, TYPE_bool);
		def subst(f: Type -> Type) => Opcode.VariantEq(ClassType.!(f(t)));
	}
	case VariantGetTag(t: ClassType) {
		def facts() => P|NNEG;
		def sig() => Sx_y(t, t.getTagType());
		def subst(f: Type -> Type) => Opcode.VariantGetTag(ClassType.!(f(t)));
	}
	// The (constant) representation tag of a specific variant case.
	case VariantRepTag(t: ClassType) {
		def facts() => P|NNEG;
		def sig() => S_x(TYPE_int);
		def subst(f: Type -> Type) => Opcode.VariantRepTag(ClassType.!(f(t)));
	}
	// Extract the representation tag from a (possibly packed) variant value.
	case VariantGetRepTag(t: ClassType) {
		def facts() => P|NNEG;
		def sig() => Sx_y(t, TYPE_int);
		def subst(f: Type -> Type) => Opcode.VariantGetRepTag(ClassType.!(f(t)));
	}
	case VariantAlloc(t: ClassType, fieldTypes: Array<Type>) {
		def sig() => Sa_x(fieldTypes, t);
		def subst(f: Type -> Type) => Opcode.VariantAlloc(ClassType.!(f(t)), Arrays_map(fieldTypes, f));
	}
	case VariantGetField(t: ClassType, field: IrField) {
		def facts() => P;
		def sig() => Sx_y(t, fieldType(t, field));
		def subst(f: Type -> Type) => Opcode.VariantGetField(ClassType.!(f(t)), field);
	}
	case VariantGetMethod(spec: IrSpec) {
		def facts() => NZ|P;
		def sig() => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) => Opcode.VariantGetMethod(substSpec(spec, f));
	}
	case VariantGetVirtual(spec: IrSpec) {
		def facts() => NZ|P;
		def sig() => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) => Opcode.VariantGetVirtual(substSpec(spec, f));
	}
	case VariantGetSelector(spec: IrSpec) {
		def facts() => NZ|P;
		def sig() => Sx_y(spec.receiver, spec.getFuncType());
		def subst(f: Type -> Type) => Opcode.VariantGetSelector(substSpec(spec, f));
	}
	// Safety checks
	case NullCheck(t: Type)		{ def facts() => F|NZ; def sig() => Sx_x(t); def subst(f: Type -> Type) => Opcode.NullCheck(f(t)); }
	case BoundsCheck(t: Type)	{ def facts() => F; def sig() => Sxy_z(t, TYPE_int, TYPE_void); def subst(f: Type -> Type) => Opcode.BoundsCheck(f(t)); }
	case DescriptorCheck(t: ClassType) {
		def facts() => F|NZ;
		def sig() => Sx_x(t);
		def subst(f: Type -> Type) => Opcode.DescriptorCheck(ClassType.!(f(t)));
	}
	case ConditionalThrow(exception: string)	{ def facts() => F; def sig() => Sx_y(TYPE_bool, TYPE_void); }
	// Overloaded, polymorphic casts. A substitution keeps the cast or query computed for the
	// original types; the optimizer recomputes it for the new types.
	case OverloadedEq(t: Type) {
		def facts() => P|C;
		def sig() => Sxx_y(t, TYPE_bool);
		def subst(f: Type -> Type) => Opcode.OverloadedEq(f(t));
	}
	case TypeCast(cast: TypeCast, from: Type, to: Type) {
		def facts() => F;
		def sig() => Sx_y(from, to);
		def subst(f: Type -> Type) => Opcode.TypeCast(cast, f(from), f(to));
	}
	case TypeQuery(query: TypeQuery, from: Type, to: Type) {
		def facts() => P;
		def sig() => Sx_y(from, TYPE_bool);
		def subst(f: Type -> Type) => Opcode.TypeQuery(query, f(from), f(to));
	}
	case TypeSubsume(from: Type, to: Type) {
		def facts() => P;
		def sig() => Sx_y(from, to);
		def subst(f: Type -> Type) => Opcode.TypeSubsume(f(from), f(to));
	}
	// Closure and call operations
	case CallMethod(spec: IrSpec) 		{ def sig() => unboundSig(spec); def subst(f: Type -> Type) => Opcode.CallMethod(substSpec(spec, f)); }
	case CallClassMethod(spec: IrSpec) 	{ def sig() => unboundSig(spec); def subst(f: Type -> Type) => Opcode.CallClassMethod(substSpec(spec, f)); }
	case CallClassVirtual(spec: IrSpec) 	{ def sig() => unboundSig(spec); def subst(f: Type -> Type) => Opcode.CallClassVirtual(substSpec(spec, f)); }
	case CallClassSelector(spec: IrSpec) 	{ def sig() => unboundSig(spec); def subst(f: Type -> Type) => Opcode.CallClassSelector(substSpec(spec, f)); }
	case CallVariantVirtual(spec: IrSpec) 	{ def sig() => unboundSig(spec); def subst(f: Type -> Type) => Opcode.CallVariantVirtual(substSpec(spec, f)); }
	case CallVariantSelector(spec: IrSpec) 	{ def sig() => unboundSig(spec); def subst(f: Type -> Type) => Opcode.CallVariantSelector(substSpec(spec, f)); }
	// The closure is passed as the first argument.
	case CallClosure(t: FuncType) {
		def sig() => Sa_x(Arrays_prepend(t, t.paramTypes()), t.returnType());
		def subst(f: Type -> Type) => Opcode.CallClosure(FuncType.!(f(t)));
	}
	// The function reference is passed as the first argument.
	case CallFunction(t: FuncType) {
		def sig() => Sa_x(Arrays_prepend(t, t.paramTypes()), t.returnType());
		def subst(f: Type -> Type) => Opcode.CallFunction(FuncType.!(f(t)));
	}
	// Binds {spec} to an object of type {t}.
	case CreateClosure(spec: IrSpec, t: Type) {
		def facts() => NZ|P|NNC;
		def sig() => Sx_y(t, spec.getBoundType());
		def subst(f: Type -> Type) => Opcode.CreateClosure(substSpec(spec, f), f(t));
	}
	case ForgeClosure(ptrType: PointerType, receiver: Type, param: Type, result: Type) {
		def facts() => P|NNC;
		def sig() => Sxy_z(ptrType, receiver, newFuncType(param, result));
		def subst(f: Type -> Type) => Opcode.ForgeClosure(ptrType, f(receiver), f(param), f(result));
	}
	case UnpackClosure(ptrType: PointerType, receiver: Type, param: Type, result: Type) {
		def facts() => P|NNC;
		def sig() => Sx_y(newFuncType(param, result), newTupleType(ptrType, receiver));
		def subst(f: Type -> Type) => Opcode.UnpackClosure(ptrType, f(receiver), f(param), f(result));
	}
	case ForgeRange(elemType: Type, ptrType: PointerType) {
		def facts() => P;
		def sig() => Sxy_z(ptrType, TYPE_int, newRangeType(elemType));
		def subst(f: Type -> Type) => Opcode.ForgeRange(f(elemType), ptrType);
	}
	// Return a value to a (previously captured) return address.
	case ReturnTo(returnType: Type, ptrType: PointerType) {
		def sig() => Sxy_z(ptrType, returnType, TYPE_void);
		def subst(f: Type -> Type) => Opcode.ReturnTo(f(returnType), ptrType);
	}
	// RefLayout operations
	case RefLayoutAt(t: RefType)						{ def facts() => NZ|F; def sig() => Sxy_z(TYPE_array_byte, TYPE_int, t); }
	case RefLayoutOf(t: RefType)						{ def sig() => Sx_y(TYPE_range_byte, t); }
	case RefLayoutIn(t: RefType, offset: int, result: RefType)		{ def facts() => P|F; def sig() => Sx_y(t, result); }
	case RefLayoutGetField(t: RefType, offset: int, order: ByteOrder, fieldType: Type)	{ def sig() => Sx_y(t, fieldType); }
	case RefLayoutSetField(t: RefType, offset: int, order: ByteOrder, fieldType: Type)	{ def sig() => Sxy_z(t, fieldType, TYPE_void); }
	case RefLayoutAtRepeatedField(t: RefType, offset: int, scale: int, max: int, result: RefType) {
		def facts() => P;
		def sig() => Sxy_z(t, TYPE_int, result);
	}
	case RefLayoutGetRepeatedField(t: RefType, offset: int, scale: int, max: int, order: ByteOrder, fieldType: Type) {
		def sig() => Sxy_z(t, TYPE_int, fieldType);
	}
	case RefLayoutSetRepeatedField(t: RefType, offset: int, scale: int, max: int, order: ByteOrder, fieldType: Type) {
		def sig() => Sxyz_w(t, TYPE_int, fieldType, TYPE_void);
	}
	// {startType} is {int} or #RangeStart.
	case ByteArrayGetField(fieldType: Type, startType: Type, offset: int, order: ByteOrder) {
		def sig() => Sxy_z(TYPE_array_byte, startType, fieldType);
		def subst(f: Type -> Type) => Opcode.ByteArrayGetField(f(fieldType), f(startType), offset, order);
	}
	case ByteArraySetField(fieldType: Type, startType: Type, offset: int, order: ByteOrder) {
		def sig() => Sxyz_w(TYPE_array_byte, startType, fieldType, TYPE_void);
		def subst(f: Type -> Type) => Opcode.ByteArraySetField(f(fieldType), f(startType), offset, order);
	}
	// Pointer tagging operations (for unboxing and descriptor tricks)
	case SetAuxTag(t: PointerType, tagType: Type) {
		def sig() => Sxy_z(t, tagType, t);
		def subst(f: Type -> Type) => Opcode.SetAuxTag(t, f(tagType));
	}
	case GetAuxTag(t: PointerType, it: IntType)	{ def sig() => Sx_y(t, it); }
	case SetRefTag(t: PointerType, tagType: Type) {
		def sig() => Sxy_z(t, tagType, t);
		def subst(f: Type -> Type) => Opcode.SetRefTag(t, f(tagType));
	}
	case GetRefTag(t: PointerType, it: IntType)	{ def sig() => Sx_y(t, it); }
	// setDescriptorExtension<D>(desc: D, refmap: int, byteSize: int) -> void
	case SetDescriptorExtension(t: Type) {
		def sig() => Sxyz_w(t, TYPE_int, TYPE_int, TYPE_void);
		def subst(f: Type -> Type) => Opcode.SetDescriptorExtension(f(t));
	}
	// System operations
	case SystemCall(syscall: SystemCall)	{ def sig() => Sa_x(syscall.paramTypes, syscall.returnType); }
	// Container for VST operations
	case VstSugar(vstOp: VstOperator, typeArgs: Array<Type>, paramTypes: Array<Type>, resultType: Type) {
		def sig() => Sa_x(paramTypes, resultType);
		def subst(f: Type -> Type) => Opcode.VstSugar(vstOp, Arrays_map(typeArgs, f), Arrays_map(paramTypes, f), f(resultType));
	}

// ------- Machine-level operations ---------------------------------------------
	// Pointer arithmetic. Machine lowering also applies {PtrAdd}, {PtrLoad}, and {PtrStore}
	// directly to references, so their {t} is a {Type}.
	case PtrAdd(t: Type, it: IntType)		{ def facts() => F|R; def sig() => Sxy_x(t, it); def subst(f: Type -> Type) => Opcode.PtrAdd(f(t), it); }
	case PtrSub(t: PointerType, it: IntType)	{ def facts() => P; def sig() => Sxx_y(t, it); }
	case PtrLt(t: PointerType)			{ def facts() => P; def sig() => Sxx_y(t, TYPE_bool); }
	case PtrLteq(t: PointerType)			{ def facts() => P; def sig() => Sxx_y(t, TYPE_bool); }
	// Pointer-to-interior operations (compute addresses within objects/arrays/ranges)
	case PtrAtContents(t: RangeType, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtContents(RangeType.!(f(t)), ptrType);
	}
	case PtrAtLength(t: ArrayType, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtLength(ArrayType.!(f(t)), ptrType);
	}
	case PtrAtObject(t: Type, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtObject(f(t), ptrType);
	}
	case PtrAtRangeElem(t: RangeType, it: IntType, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sxy_z(t, it, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtRangeElem(RangeType.!(f(t)), it, ptrType);
	}
	case PtrAtArrayElem(t: ArrayType, it: IntType, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sxy_z(t, it, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtArrayElem(ArrayType.!(f(t)), it, ptrType);
	}
	case PtrAtEnd(t: Type, ptrType: PointerType) {
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtEnd(f(t), ptrType);
	}
	// {t} is a {RefType} once instantiated.
	case PtrAtRef(t: Type, ptrType: PointerType) {
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtRef(f(t), ptrType);
	}
	case PtrAtComponentField(t: ComponentType, field: IrField, ptrType: PointerType)	{ def facts() => P; def sig() => S_x(ptrType); }
	case PtrAtObjectField(t: ClassType, field: IrField, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtObjectField(ClassType.!(f(t)), field, ptrType);
	}
	case PtrAtRefLayoutField(t: RefType, offset: int, ptrType: PointerType)	{ def sig() => Sx_y(t, ptrType); }
	// Address of a field reached through a chain of unboxed (inlined) fields
	case PtrAtUnboxedObjectField(t: ClassType, fields: List<IrField>, ptrType: PointerType) {
		def facts() => F;
		def sig() => Sx_y(t, ptrType);
		def subst(f: Type -> Type) => Opcode.PtrAtUnboxedObjectField(ClassType.!(f(t)), fields, ptrType);
	}
	case PtrAtUnboxedComponentField(t: ComponentType, fields: List<IrField>, ptrType: PointerType) {
		def facts() => P;
		def sig() => Sx_y(t, ptrType);
	}
	// Pointer memory operations
	case PtrCmpSwp(t: PointerType, valType: Type) {
		def sig() => Sxyz_w(t, valType, valType, TYPE_bool);
		def subst(f: Type -> Type) => Opcode.PtrCmpSwp(t, f(valType));
	}
	case PtrLoad(t: Type, valType: Type) {
		def sig() => Sx_y(t, valType);
		def subst(f: Type -> Type) => Opcode.PtrLoad(f(t), f(valType));
	}
	case PtrStore(t: Type, valType: Type) {
		def sig() => Sxy_z(t, valType, TYPE_void);
		def subst(f: Type -> Type) => Opcode.PtrStore(f(t), f(valType));
	}
	case PtrAddRangeStart(t: PointerType)		{ def facts() => F|R; def sig() => Sxy_x(t, TYPE_range_start); }
	// Get caller instruction pointer or stack pointer
	case CallerIp(ptrType: PointerType)		{ def facts() => P; def sig() => S_x(ptrType); }
	case CallerSp(ptrType: PointerType)		{ def facts() => P; def sig() => S_x(ptrType); }
	// Allocate raw memory for an object of type {t}
	case Alloc(t: Type)				{ def sig() => Sx_y(TYPE_int, t); def subst(f: Type -> Type) => Opcode.Alloc(f(t)); }
	// Wasm target
	case WasmFunctionTypeId(paramType: Type, resultType: Type) {
		def facts() => P;
		def sig() => S_x(TYPE_int);
		def subst(f: Type -> Type) => Opcode.WasmFunctionTypeId(f(paramType), f(resultType));
	}
	case WasmFunctionId(paramType: Type, resultType: Type) {
		def facts() => P;
		def sig() => Sx_y(newFuncType(paramType, resultType), TYPE_int);
		def subst(f: Type -> Type) => Opcode.WasmFunctionId(f(paramType), f(resultType));
	}
	// For testing the register allocator and the garbage collector
	case KillRegisters			{ def sig() => Sv_v(); }
	case ForceGc				{ def sig() => Sv_v(); }
	// Machine-level calls
	case CallAddress(rep: Mach_FuncRep)	{ def sig() => Sa_x(rep.paramTypes, rep.returnType()); }
	// Kernel.syscall<T>(number: int, args: T) -> resultType
	case CallKernel(kernel: Kernel, t: Type, resultType: Type) {
		def sig() => Sa_a([TYPE_int, t], tupleElems(resultType));
		def subst(f: Type -> Type) => Opcode.CallKernel(kernel, f(t), resultType);
	}

	// Structural equality, comparing the specializations of members by value.
	def equals(that: Opcode) -> bool {
		if (this == that) return true;
		if (this.tag != that.tag) return false;
		var a = specOf(this), b = specOf(that);
		if (a == null || b == null) return false;
		match (this) {
			CreateClosure(spec, t) => if (t != Opcode.CreateClosure.!(that).t) return false;
			_ => ;
		}
		return a.equals(b);
	}
}

component Opcodes {
	// Whether an opcode mentions any open (polymorphic) type.
	def checkOpenness(opcode: Opcode) -> Open {
		return OPEN_CHECKER.check(opcode);
	}
	def render(op: Opcode, buf: StringBuilder) -> StringBuilder {
		buf.puts(op.name);
		match (op) {
			IntEq(t)	=> appendT(t, buf);
			IntAdd(t)	=> appendT(t, buf);
			IntSub(t)	=> appendT(t, buf);
			IntMul(t)	=> appendT(t, buf);
			IntDiv(t)	=> appendT(t, buf);
			IntMod(t)	=> appendT(t, buf);
			IntAnd(t)	=> appendT(t, buf);
			IntOr(t)	=> appendT(t, buf);
			IntXor(t)	=> appendT(t, buf);
			IntShl(t)	=> appendT(t, buf);
			IntSar(t)	=> appendT(t, buf);
			IntShr(t)	=> appendT(t, buf);
			IntLt(t)	=> appendT(t, buf);
			IntLteq(t)	=> appendT(t, buf);
			IntWide(wideOp, paramTypes, resultType) => buf.putc('[').puts(wideOp.opcode.name).putc(']');
			FloatAdd(t)	=> appendT(t, buf);
			FloatSub(t)	=> appendT(t, buf);
			FloatMul(t)	=> appendT(t, buf);
			FloatDiv(t)	=> appendT(t, buf);
			FloatBitEq(t)	=> appendT(t, buf);
			FloatEq(t)	=> appendT(t, buf);
			FloatNe(t)	=> appendT(t, buf);
			FloatLt(t)	=> appendT(t, buf);
			FloatLteq(t)	=> appendT(t, buf);
			FloatAbs(t)	=> appendT(t, buf);
			FloatCeil(t)	=> appendT(t, buf);
			FloatFloor(t)	=> appendT(t, buf);
			FloatSqrt(t)	=> appendT(t, buf);
			IntCastF(from, to)	=> appendTT(from, to, buf);
			IntQueryF(from, to)	=> appendTT(from, to, buf);
			IntViewI(from, to)	=> appendTT(from, to, buf);
			IntViewB(to)		=> appendT(to, buf);
			IntViewP(from, to)	=> appendTT(from, to, buf);
			EnumViewI(from, to)	=> appendTT(from, to, buf);
			EnumSetViewI(from, to)	=> appendTT(from, to, buf);
			IntViewF(from)		=> appendT(from, buf);
			IntTruncF(from, to)	=> appendTT(from, to, buf);
			FloatCastI(from, to)	=> appendTT(from, to, buf);
			FloatQueryI(from, to)	=> appendTT(from, to, buf);
			FloatPromoteI(from, to)	=> appendTT(from, to, buf);
			FloatViewI(from, to)	=> appendTT(from, to, buf);
			FloatRoundI(from, to)	=> appendTT(from, to, buf);
			FloatRound(t)		=> appendT(t, buf);
			RefEq(t)		=> appendT(t, buf);
			DefaultValue(t)		=> appendT(t, buf);
			TupleCreate(t)		=> appendT(t, buf);
			TupleGetElem(t, index)	=> appendIdxT(index, t, buf);
			ArrayAlloc(t)		=> appendT(t, buf);
			ArrayFill(t)		=> appendT(t, buf);
			ArrayInit(t, length)	=> appendIdxT(length, t, buf);
			ArrayTupleInit(t, elems, length) => {
				buf.putc('[').putd(elems).putc(',').putd(length).putc(']');
				appendT(t, buf);
			}
			ArrayGetElem(t, it)		=> appendTT(t, it, buf);
			ArraySetElem(t, it)		=> appendTT(t, it, buf);
			ArrayGetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			ArraySetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			ArrayGetLength(t)		=> appendT(t, buf);
			RangeFromTo(t, startType, endType)	=> appendTTT(t, startType, endType, buf);
			RangeFromPlus(t, startType, lengthType)	=> appendTTT(t, startType, lengthType, buf);
			RangeGetElem(t, it)		=> appendTT(t, it, buf);
			RangeSetElem(t, it)		=> appendTT(t, it, buf);
			RangeGetLength(t)		=> appendT(t, buf);
			RangeStartPlusIndex(t, it)	=> appendTT(t, it, buf);
			NormRangeGetElem(t, it)			=> appendTT(t, it, buf);
			NormRangeGetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			NormRangeSetElem(t, it)			=> appendTT(t, it, buf);
			NormRangeSetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			Init(method)			=> appendMember(method, buf);
			ComponentGetField(t, field)	=> appendMember(field, buf);
			ComponentSetField(t, field)	=> appendMember(field, buf);
			ClassAlloc(t)			=> appendT(t, buf);
			ClassAllocWithDescriptor(t, d)	=> appendTT(t, d, buf);
			ClassNew(spec)			=> appendSpec(spec, buf);
			ClassGetField(t, field)		=> appendMemberT(field, t, buf);
			ClassInitField(t, field)	=> appendMemberT(field, t, buf);
			ClassSetField(t, field)		=> appendMemberT(field, t, buf);
			ClassGetMethod(spec)		=> appendSpec(spec, buf);
			ClassGetVirtual(spec)		=> appendSpec(spec, buf);
			ClassGetSelector(spec)		=> appendSpec(spec, buf);
			VariantEq(t)			=> appendT(t, buf);
			VariantGetTag(t)		=> appendT(t, buf);
			VariantRepTag(t)		=> appendT(t, buf);
			VariantGetRepTag(t)		=> appendT(t, buf);
			VariantAlloc(t, fieldTypes)	=> appendT(t, buf);
			VariantGetField(t, field)	=> appendMemberT(field, t, buf);
			VariantGetMethod(spec)		=> appendSpec(spec, buf);
			VariantGetVirtual(spec)		=> appendSpec(spec, buf);
			VariantGetSelector(spec)	=> appendSpec(spec, buf);
			NullCheck(t)		=> appendT(t, buf);
			BoundsCheck(t)		=> appendT(t, buf);
			DescriptorCheck(t)	=> appendT(t, buf);
			ConditionalThrow(exception) => buf.putc('[').puts(exception).putc(']');
			OverloadedEq(t)		=> appendT(t, buf);
			TypeCast(cast, from, to)	=> { buf.putc('[').puts(cast.name).putc(']'); appendTT(from, to, buf); }
			TypeQuery(query, from, to)	=> { buf.putc('[').puts(query.name).putc(']'); appendTT(from, to, buf); }
			TypeSubsume(from, to)		=> appendTT(from, to, buf);
			CallMethod(spec)		=> appendSpec(spec, buf);
			CallClassMethod(spec)		=> appendSpec(spec, buf);
			CallClassVirtual(spec)		=> appendSpec(spec, buf);
			CallClassSelector(spec)		=> appendSpec(spec, buf);
			CallVariantVirtual(spec)	=> appendSpec(spec, buf);
			CallVariantSelector(spec)	=> appendSpec(spec, buf);
			CallClosure(t)			=> appendT(t, buf);
			CallFunction(t)			=> appendT(t, buf);
			CreateClosure(spec, t)		=> { appendSpec(spec, buf); appendT(t, buf); }
			ForgeClosure(ptrType, receiver, param, result)	=> appendTTT(receiver, param, result, buf);
			UnpackClosure(ptrType, receiver, param, result)	=> appendTTT(receiver, param, result, buf);
			ForgeRange(elemType, ptrType)		=> appendTT(elemType, ptrType, buf);
			ReturnTo(returnType, ptrType)		=> appendTT(returnType, ptrType, buf);
			RefLayoutAt(t)				=> appendT(t, buf);
			RefLayoutOf(t)				=> appendT(t, buf);
			RefLayoutIn(t, offset, result)		=> appendIdxTT(offset, t, result, buf);
			RefLayoutGetField(t, offset, order, fieldType)	=> appendIdxOrderTT(offset, order, t, fieldType, buf);
			RefLayoutSetField(t, offset, order, fieldType)	=> appendIdxOrderTT(offset, order, t, fieldType, buf);
			RefLayoutAtRepeatedField(t, offset, scale, max, result) => {
				buf.putc('[').putd(offset).putc(',').putd(scale).putc(']');
				appendTT(t, result, buf);
			}
			RefLayoutGetRepeatedField(t, offset, scale, max, order, fieldType) => {
				buf.putc('[').putd(offset).putc(',').putd(scale).putc(',').puts(order.name).putc(']');
				appendTT(t, fieldType, buf);
			}
			RefLayoutSetRepeatedField(t, offset, scale, max, order, fieldType) => {
				buf.putc('[').putd(offset).putc(',').putd(scale).putc(',').puts(order.name).putc(']');
				appendTT(t, fieldType, buf);
			}
			ByteArrayGetField(fieldType, startType, offset, order)	=> appendIdxOrderTT(offset, order, fieldType, startType, buf);
			ByteArraySetField(fieldType, startType, offset, order)	=> appendIdxOrderTT(offset, order, fieldType, startType, buf);
			SetAuxTag(t, tagType)		=> appendTT(t, tagType, buf);
			GetAuxTag(t, it)		=> appendTT(t, it, buf);
			SetRefTag(t, tagType)		=> appendTT(t, tagType, buf);
			GetRefTag(t, it)		=> appendTT(t, it, buf);
			SetDescriptorExtension(t)	=> appendT(t, buf);
			SystemCall(syscall)		=> buf.putc('[').puts(syscall.name).putc(']');
			VstSugar(vstOp, typeArgs, paramTypes, resultType) => buf.putc('[').puts(vstOp.name).putc(']');
			PtrAdd(t, it)		=> appendTT(t, it, buf);
			PtrSub(t, it)		=> appendTT(t, it, buf);
			PtrLt(t)		=> appendT(t, buf);
			PtrLteq(t)		=> appendT(t, buf);
			PtrAtContents(t, ptrType)		=> appendTT(t, ptrType, buf);
			PtrAtLength(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtObject(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtRangeElem(t, it, ptrType)		=> appendTTT(t, it, ptrType, buf);
			PtrAtArrayElem(t, it, ptrType)		=> appendTTT(t, it, ptrType, buf);
			PtrAtEnd(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtRef(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtComponentField(t, field, ptrType)	=> appendMember(field, buf);
			PtrAtObjectField(t, field, ptrType)	=> appendMemberT(field, t, buf);
			PtrAtRefLayoutField(t, offset, ptrType)	=> appendIdxTT(offset, t, ptrType, buf);
			PtrAtUnboxedObjectField(t, fields, ptrType)	=> appendMembers(fields, buf);
			PtrAtUnboxedComponentField(t, fields, ptrType)	=> appendMembers(fields, buf);
			PtrCmpSwp(t, valType)	=> appendTT(t, valType, buf);
			PtrLoad(t, valType)	=> appendTT(t, valType, buf);
			PtrStore(t, valType)	=> appendTT(t, valType, buf);
			PtrAddRangeStart(t)	=> appendT(t, buf);
			CallerIp(ptrType)	=> appendT(ptrType, buf);
			CallerSp(ptrType)	=> appendT(ptrType, buf);
			Alloc(t)		=> appendT(t, buf);
			WasmFunctionTypeId(paramType, resultType)	=> appendTT(paramType, resultType, buf);
			WasmFunctionId(paramType, resultType)		=> appendTT(paramType, resultType, buf);
			CallAddress(rep)	=> appendT(rep.machType, buf);
			CallKernel(kernel, t, resultType) => { buf.putc('[').puts(kernel.name).putc(']'); appendT(t, buf); }
			_ => ;  // name only: Bool*, FloatCastD, FloatQueryD, FloatPromoteF, FloatRoundD, KillRegisters, ForceGc
		}
		return buf;
	}
	// The member specialization carried by {opcode}, if any.
	def specOf(opcode: Opcode) -> IrSpec {
		match (opcode) {
			ClassNew(spec) => return spec;
			ClassGetMethod(spec) => return spec;
			ClassGetVirtual(spec) => return spec;
			ClassGetSelector(spec) => return spec;
			VariantGetMethod(spec) => return spec;
			VariantGetVirtual(spec) => return spec;
			VariantGetSelector(spec) => return spec;
			CallMethod(spec) => return spec;
			CallClassMethod(spec) => return spec;
			CallClassVirtual(spec) => return spec;
			CallClassSelector(spec) => return spec;
			CallVariantVirtual(spec) => return spec;
			CallVariantSelector(spec) => return spec;
			CreateClosure(spec, t) => return spec;
			_ => return null;
		}
	}
	// Smart constructors that choose an opcode based on a type.
	def newEqual(t: Type) -> Operator;
	def newArrayGetElem(t: Type, it: IntType) -> Operator;	// array or range
	def newArraySetElem(t: Type, it: IntType) -> Operator;	// array or range
	def newArrayGetLength(t: Type) -> Operator;		// array or range
	def bestCallVirtual(spec: IrSpec) -> Operator;		// class or variant, devirtualized if not overridden
	def bestGetVirtual(spec: IrSpec) -> Operator;		// class or variant, devirtualized if not overridden
	def bestGetSelector(spec: IrSpec) -> Operator;		// class or variant

	// Append <t>
	def appendT(t: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('<');
		t.render(buf);
		return buf.putc('>');
	}
	// Append <t1,t2>
	def appendTT(t1: Type, t2: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('<');
		t1.render(buf);
		buf.putc(',');
		t2.render(buf);
		return buf.putc('>');
	}
	// Append <t1,t2,t3>
	def appendTTT(t1: Type, t2: Type, t3: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('<');
		t1.render(buf);
		buf.putc(',');
		t2.render(buf);
		buf.putc(',');
		t3.render(buf);
		return buf.putc('>');
	}
	// Append [n]<t>
	def appendIdxT(n: int, t: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('[').putd(n).putc(']');
		return appendT(t, buf);
	}
	// Append [n]<t1,t2>
	def appendIdxTT(n: int, t1: Type, t2: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('[').putd(n).putc(']');
		return appendTT(t1, t2, buf);
	}
	// Append [n,order]<t1,t2>
	def appendIdxOrderTT(n: int, order: ByteOrder, t1: Type, t2: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('[').putd(n).putc(',').puts(order.name).putc(']');
		return appendTT(t1, t2, buf);
	}
	// Append [member]
	def appendMember(m: IrMember, buf: StringBuilder) -> StringBuilder {
		buf.putc('[');
		m.render(buf);
		return buf.putc(']');
	}
	// Append [member]<t>
	def appendMemberT(m: IrMember, t: Type, buf: StringBuilder) -> StringBuilder {
		appendMember(m, buf);
		return appendT(t, buf);
	}
	// Append [member,member,...]
	def appendMembers(members: List<IrField>, buf: StringBuilder) -> StringBuilder {
		buf.putc('[');
		for (l = members; l != null; l = l.tail) {
			l.head.render(buf);
			if (l.tail != null) buf.putc(',');
		}
		return buf.putc(']');
	}
	// Append [spec]
	def appendSpec(spec: IrSpec, buf: StringBuilder) -> StringBuilder {
		buf.putc('[');
		spec.render(buf);
		return buf.putc(']');
	}
}

// An operator caches the signature of its opcode. The signature of a closure call over a
// lambda's unflattened parameters differs from the one {Opcode.CallClosure} computes, so the
// signature is passed in rather than always recomputed.
class Operator(opcode: Opcode, sig: Signature) {
	def subst(f: Type -> Type) -> Operator;
	def equals(that: Operator) -> bool { return this == that || this.opcode.equals(that.opcode); }
}

// External definitions.
class Type {
	def open() -> bool;
	def render(buf: StringBuilder) -> StringBuilder;
}
class PrimType extends Type {}
class VoidType extends PrimType {}
class BoolType extends PrimType {}
class IntType extends PrimType {}
class FloatType extends PrimType {}
class EnumType extends PrimType {}
class EnumSetType extends PrimType {}
class PointerType extends PrimType {}
class TupleType extends Type {
	def elems() -> Array<Type>;
}
class ClassType extends Type {
	def getTagType() -> IntType;		// for variants
}
class ComponentType extends Type {}
class RefType extends Type {}
class RangeStartType extends Type {}
class ArrayType extends Type {
	def elem() -> Type;			// element type of this array
}
class RangeType extends Type {
	def elem() -> Type;			// element type of this range
}
class FuncType extends Type {
	def paramTypes() -> Array<Type>;
	def returnType() -> Type;
}

enum Fact {
	O_FOLDABLE,
	O_PURE,
	O_COMMUTATIVE,
	O_REMOVABLE,
	O_NO_NULL_CHECK,
	V_NON_NEGATIVE,
	V_NON_ZERO
}

class Signature {}
class IrMember {
	def render(buf: StringBuilder) -> StringBuilder;
}
class IrMethod extends IrMember {
	def receiver: Type;
}
class IrField extends IrMember {}
class IrSpec(receiver: Type, typeArgs: Array<Type>, member: IrMember) {
	def getBoundType() -> FuncType;
	def getUnboundType() -> FuncType;
	def getFuncType() -> FuncType;
	def equals(that: IrSpec) -> bool;
	def render(buf: StringBuilder) -> StringBuilder;
}
class Mach_FuncRep {
	def machType: Type;
	def paramTypes: Array<Type>;
	def returnType() -> Type;
}

enum Open { UNKNOWN, CLOSED, OPEN }
enum ByteOrder { LITTLE_ENDIAN, BIG_ENDIAN }
enum Kernel { UNKNOWN, LINUX, DARWIN }
enum SystemCall(paramTypes: Array<Type>, returnType: Type) { OPEN(null, null) }
type TypeQuery { case POLY; }
type TypeCast { case POLY; }
type VstOperator { case SUGAR; }

def NONE: Fact.set;
def F: Fact.set = Fact.O_FOLDABLE;
def P: Fact.set = Fact.O_PURE | Fact.O_FOLDABLE; // pure => foldable
def C: Fact.set = Fact.O_COMMUTATIVE;
def R: Fact.set = Fact.O_REMOVABLE;
def NZ:   Fact.set = Fact.V_NON_ZERO;
def NNEG: Fact.set = Fact.V_NON_NEGATIVE;
def NNC: Fact.set = Fact.O_NO_NULL_CHECK;
def S_x:    Type -> Signature;				// () -> x
def Sx_x:   Type -> Signature;				// (x) -> x
def Sx_y:   (Type, Type) -> Signature;			// (x) -> y
def Sxx_x:  Type -> Signature;				// (x, x) -> x
def Sxx_y:  (Type, Type) -> Signature;			// (x, x) -> y
def Sxy_x:  (Type, Type) -> Signature;			// (x, y) -> x
def Sxy_z:  (Type, Type, Type) -> Signature;		// (x, y) -> z
def Sxyz_w: (Type, Type, Type, Type) -> Signature;	// (x, y, z) -> w
def Sxyzw_v: (Type, Type, Type, Type, Type) -> Signature;	// (x, y, z, w) -> v
def Sa_x: (Array<Type>, Type) -> Signature;		// [x] -> y
def Sa_a: (Array<Type>, Array<Type>) -> Signature;	// [x] -> [y]
def Sv_v: () -> Signature;				// () -> ()

def newTupleType(a: Type, b: Type) -> TupleType;
def newFuncType(a: Type, b: Type) -> FuncType;
def newRangeType(elem: Type) -> RangeType;
def unsignedOfWidth(t: FloatType) -> IntType;
def tupleElems(t: Type) -> Array<Type>;			// the elements of a tuple, [] for void, or [t]
def fieldType(receiver: Type, field: IrField) -> Type;	// the field's type, instantiated for {receiver}
def substSpec(spec: IrSpec, f: Type -> Type) -> IrSpec;
def unboundSig(spec: IrSpec) -> Signature { var t = spec.getUnboundType(); return Sa_x(t.paramTypes(), t.returnType()); }

def TYPE_array_byte: ArrayType;
def TYPE_range_byte: RangeType;
def TYPE_range_start: RangeStartType;
def TYPE_bool: BoolType;
def TYPE_byte: IntType;
def TYPE_int: IntType;
def TYPE_float: FloatType;
def TYPE_double: FloatType;
def TYPE_void: VoidType;

def Arrays_repeat<A>(a: A, length: int) -> Array<A> {
	var result = Array<A>.new(length);
	for (i < length) result[i] = a;
	return result;
}
def Arrays_prepend<A>(a: A, array: Array<A>) -> Array<A> {
	var result = Array<A>.new(array.length + 1);
	result[0] = a;
	for (i < array.length) result[i + 1] = array[i];
	return result;
}
def Arrays_map<A, B>(array: Array<A>, f: A -> B) -> Array<B> {
	var result = Array<B>.new(array.length);
	for (i < array.length) result[i] = f(array[i]);
	return result;
}
// The flattened parameter types of an {ArrayTupleInit}: the array's tuple element
// types, concatenated {length} times.
def tupleElemsRepeat(t: ArrayType, elems: int, length: int) -> Array<Type> {
	var types = TupleType.!(t.elem()).elems();
	var result = Array<Type>.new(elems * length);
	for (i < length) {
		for (j < elems) result[i * elems + j] = types[j];
	}
	return result;
}
// The {index}th component of an array's tuple element type.
def tupleElem(t: ArrayType, index: int) -> Type {
	return TupleType.!(t.elem()).elems()[index];
}
def specOf = Opcodes.specOf;

def OPEN_CHECKER = OpenOpcodeChecker.new();
class OpenOpcodeChecker {
	var open = Open.CLOSED;
	def check(opcode: Opcode) -> Open {
		open = Open.CLOSED;
		opcode.subst(subst);
		return open;
	}
	def subst(t: Type) -> Type {
		if (t.open()) open = Open.OPEN;
		return t;
	}
}
