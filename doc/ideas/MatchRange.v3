//Idea: allow matching within a range and the rest of a range

type T {
	case A(f: int);
	case B(g: int);
}

// Demonstrate matching on the range {t}.
def m(t: Range<T>) -> (int, Range<T>) {
	match (t) {
		// The syntax {match-expr ... var} for a case matches element 0 and binds the range[1 ...] to the variable {var}.
		A(f) ... rest => return (f + 77, rest); // "rest" has type Range<T>
		B(g) ... rest => return (g + 99, rest); // "rest" has type Range<T>
	}
}

def keywords(str: Range<byte>) -> (int, Range<T>) {
	match(str) {
		"if" ... rest => return (11, rest);
		"case" ... rest => return (12, rest);
		"match" ... rest => return (13, rest);
	}
	return (-1, str);
}

def parse_literal(str: Range<byte>) -> (Lit, Range<T>) {
	match (str) {
		IntLiteralMatch(x) ... rest => (Lit.Int(x), rest);
		BoolLiteralMatch(x) ... rest => (Lit.Bool(x), rest);
		"case ${x: int} of foo" ... rest => (Lit.CaseInt(x), rest);
	}
}

// Parsing in a loop can use the rest binding to avoid any intermediate allocations; just use ranges.
def parseListA(str: string) -> List<int> {
	var list: List<int>;
	while (str.length > 0) {
		match (str) {
			"A," ... rest => { // allow eating comma
				list = List.new("A", list);
				str = rest;
			}
			"A" ... rest => { // no comma, maybe last
				list = List.new("A", list);
				str = rest;
			}
			" " ... rest => { // skip spaces
				str = rest;
			}
			_ => break; // everything else
		}
	}
	return Lists.reverse(list);
}

// An iterator implemented with rest matching
def iterateA(str: string) ->* int {
	var pos = 0;
	while (str.length > 0) {
		"A" ... rest => {
			yield pos++;
			str = rest;
		}
		_ => {
			str = str[1 ...];
			pos++;
		}
	}
}
