//@execute 0=1; 1=1; 2=1; 3=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = null;
	CiTest.forceGc();
	var u0 = RiGc.usedBytes();
	// used bytes includes data that survived a collection
	var size = 1000 * (a + 1);
	g = Array<byte>.new(size);
	CiTest.forceGc();
	var u1 = RiGc.usedBytes();
	if (g.length != size) return -2;
	if (GcStats.gc_current_allocated() != 0) return -1;
	return if(u1 - u0 >= size && u1 - u0 < size + 100, 1, 0);
}
