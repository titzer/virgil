//@execute 0=1; 1=1; 5=1; 7=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = null;
	CiTest.forceGc();
	var before = GcStats.total_allocated_bytes();
	var size = 500 * (a + 1);
	g = Array<byte>.new(size);
	var diff = GcStats.total_allocated_bytes() - before;
	if (g.length != size) return -1;
	return if(diff >= size && diff < size + 100, 1, 0);
}
