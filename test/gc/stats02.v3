//@execute 0=0; 1=10101; 3=30303; 7=70707
var pre: int;
var post: int;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	pre = post = 0;
	var before = GcStats.gc_count;
	RiGc.preGC = onPre;
	RiGc.postGC = onPost;
	for (i < a) CiTest.forceGc();
	RiGc.preGC = null;
	RiGc.postGC = null;
	return pre * 10000 + post * 100 + (GcStats.gc_count - before);
}
def onPre() { pre++; }
def onPost() { post++; }
