//@execute 0=1; 1=1; 2=1; 4=1
var g: Array<Array<byte>>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = true;
	g = null;
	CiTest.forceGc();
	// survived bytes of a collection include all live data
	var live = Array<Array<byte>>.new(a + 1);
	for (i < live.length) live[i] = Array<byte>.new(500);
	g = live;
	var min = live.length * 500;
	var s0 = GcStats.survived_bytes;
	CiTest.forceGc();
	var s1 = GcStats.survived_bytes;
	CiTest.forceGc();
	var s2 = GcStats.survived_bytes;
	var d1 = s1 - s0, d2 = s2 - s1;
	// with no allocation in between, the same data survives each time
	if (d1 != d2) return -1;
	if (g.length != a + 1) return -2;
	return if(d1 >= min && d1 < min + 1000, 1, 0);
}
