//@execute 0=202; 1=202; 3=202
var pre: int;
var post: int;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	pre = post = 0;
	RiGc.preGC = onPre;
	RiGc.postGC = onPost;
	CiTest.forceGc();
	CiTest.forceGc();
	// cleared callbacks are no longer invoked
	RiGc.preGC = null;
	RiGc.postGC = null;
	for (i < a) CiTest.forceGc();
	return pre * 100 + post;
}
def onPre() { pre++; }
def onPost() { post++; }
