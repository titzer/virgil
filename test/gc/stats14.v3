//@execute 0=1; 1=1; 2=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = null;
	CiTest.forceGc();
	var h0 = RiGc.allocationHeadroom();
	if (GcStats.alloc_headroom() != h0) return -1;
	var size = 1000 * (a + 1);
	g = Array<byte>.new(size);
	var h1 = GcStats.alloc_headroom();
	if (RiGc.allocationHeadroom() != h1) return -2;
	if (g.length != size) return -4;
	var c = GcStats.gc_current_allocated();
	if (c < size || c >= size + 100) return -3;
	return if(h0 - h1 >= size && h0 - h1 < size + 100, 1, 0);
}
