//@execute 0=1; 1=1; 3=1; 6=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = false;
	var c = GcStats.collected_bytes, s = GcStats.survived_bytes, t = GcStats.collection_us;
	var al = GcStats.allocated_bytes, mx = GcStats.max_pause_us, gcs = GcStats.gc_count;
	for (i < a) {
		g = Array<byte>.new(500);
		CiTest.forceGc();
	}
	if (g != null && g.length != 500) return -1;
	if (c != GcStats.collected_bytes) return -2;
	if (s != GcStats.survived_bytes) return -3;
	if (t != GcStats.collection_us) return -4;
	if (al != GcStats.allocated_bytes) return -5;
	if (mx != GcStats.max_pause_us) return -6;
	return if(GcStats.gc_count - gcs >= a, 1, 0);
}
