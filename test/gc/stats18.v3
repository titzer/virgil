//@execute 0=1; 1=1; 3=1
//@heap-size=2000
var g: Array<byte>;
def main(a: int) -> int {
	g = null; // may hold a stale reference from a previous run
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = true;
	CiTest.forceGc();
	var s0 = GcStats.survived_bytes, a0 = GcStats.allocated_bytes;
	if (GcStats.min_pause_us > GcStats.max_pause_us) return -1;
	// disabling stats freezes them
	GcStats.enabled = false;
	var t = GcStats.collection_us, min = GcStats.min_pause_us, max = GcStats.max_pause_us;
	for (i < a + 2) CiTest.forceGc();
	if (t != GcStats.collection_us) return -2;
	if (min != GcStats.min_pause_us || max != GcStats.max_pause_us) return -3;
	if (s0 != GcStats.survived_bytes || a0 != GcStats.allocated_bytes) return -4;
	// re-enabling resumes collection
	GcStats.enabled = true;
	g = alloc();
	g = alloc();
	CiTest.forceGc();
	if (GcStats.allocated_bytes - a0 < 100) return -5;
	if (g.length != 50) return -6;
	return if(GcStats.min_pause_us <= min && GcStats.max_pause_us >= max, 1, 0);
}
def alloc() -> Array<byte> #no-inline {
	return Array<byte>.new(50);
}
