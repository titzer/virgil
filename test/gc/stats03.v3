//@execute 0=1111; 1=1111; 2=1111
var pre_count: int;
var post_count: int;
var pre_inGC: bool;
var post_inGC: bool;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	for (i < a) CiTest.forceGc();
	var before = GcStats.gc_count;
	RiGc.preGC = onPre;
	RiGc.postGC = onPost;
	CiTest.forceGc();
	RiGc.preGC = null;
	RiGc.postGC = null;
	return (if(pre_count == before, 1000))
		+ (if(post_count == before + 1, 100))
		+ (if(pre_inGC, 10))
		+ (if(!post_inGC, 1));
}
def onPre() {
	pre_count = GcStats.gc_count;
	pre_inGC = RiGc.inGC();
}
def onPost() {
	post_count = GcStats.gc_count;
	post_inGC = RiGc.inGC();
}
