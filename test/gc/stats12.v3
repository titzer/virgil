//@execute 0=0; 1=0; 2=0; 5=0
var g: Array<byte>;
var t: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = t = null;
	// the from-space at a collection holds the previous survivors plus new allocation
	CiTest.forceGc();
	var s0 = GcStats.survived_bytes;
	CiTest.forceGc();
	var surv_first = GcStats.survived_bytes - s0;
	var c0 = GcStats.collected_bytes, a0 = GcStats.allocated_bytes, s1 = GcStats.survived_bytes;
	for (i < a) {
		g = Array<byte>.new(300 * i);
		CiTest.forceGc();
		t = Array<byte>.new(700);
	}
	if (a > 0 && (g.length != 300 * (a - 1) || t.length != 700)) return -1;
	var s2 = GcStats.survived_bytes;
	CiTest.forceGc();
	var surv_last = GcStats.survived_bytes - s2;
	var dc = GcStats.collected_bytes - c0;
	var da = GcStats.allocated_bytes - a0;
	var ds = GcStats.survived_bytes - s1;
	return int.!(dc - da - (surv_first + ds - surv_last));
}
