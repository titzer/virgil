//@execute 0=1; 1=1; 4=1; 10=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = null;
	var before = GcStats.gc_count;
	// allocate well over a semispace of garbage
	for (i < 30 + a) g = Array<byte>.new(1000);
	var count = GcStats.gc_count - before;
	return if(count >= 5 && g.length == 1000, 1, 0);
}
