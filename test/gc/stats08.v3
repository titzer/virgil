//@execute 0=0; 1=0; 4=0; 9=0
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = true;
	g = Array<byte>.new(1000);
	CiTest.forceGc();
	// collecting live data does not count as allocation
	var before = GcStats.total_allocated_bytes();
	for (i < a) CiTest.forceGc();
	return int.!(GcStats.total_allocated_bytes() - before) + g.length - 1000;
}
