//@execute 0=1; 1=1; 3=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = true;
	g = Array<byte>.new(1000);
	CiTest.forceGc();
	var s0 = GcStats.survived_bytes;
	CiTest.forceGc();
	var big = GcStats.survived_bytes - s0;
	if (g.length != 1000) return -1;
	// dead data does not survive
	g = null;
	CiTest.forceGc();
	var s1 = GcStats.survived_bytes;
	CiTest.forceGc();
	var small = GcStats.survived_bytes - s1;
	return if(big - small >= 1000 && big - small < 1100, 1, 0);
}
