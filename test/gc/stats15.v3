//@execute 0=0; 1=0; 3=0
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = Array<byte>.new(800);
	CiTest.forceGc();
	CiTest.forceGc();
	// used bytes plus headroom is the size of a semispace
	var space = RiGc.usedBytes() + RiGc.allocationHeadroom();
	for (i < a) {
		g = Array<byte>.new(100 * i);
		CiTest.forceGc();
		CiTest.forceGc();
	}
	if (a > 0 && g.length != 100 * (a - 1)) return -1;
	return int.!(RiGc.usedBytes() + RiGc.allocationHeadroom() - space);
}
