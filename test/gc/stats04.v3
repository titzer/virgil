//@execute 0=111; 1=111; 5=111
var g: Array<int>;
var pre: int;
var post: int;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	g = null;
	pre = post = 0;
	var before = GcStats.gc_count;
	RiGc.preGC = onPre;
	RiGc.postGC = onPost;
	// collections triggered by allocation also invoke the callbacks
	for (i < 20 + a) g = Array<int>.new(250);
	RiGc.preGC = null;
	RiGc.postGC = null;
	var count = GcStats.gc_count - before;
	if (g.length != 250) return -1;
	return (if(count > 0, 100))
		+ (if(pre == count, 10))
		+ (if(post == count, 1));
}
def onPre() { pre++; }
def onPost() { post++; }
