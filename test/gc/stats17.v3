//@execute 0=1; 1=1; 2=1; 7=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = true;
	var gcs = GcStats.gc_count;
	for (i < a + 1) {
		g = Array<byte>.new(400 * i);
		CiTest.forceGc();
	}
	var count = GcStats.gc_count - gcs;
	var min = GcStats.min_pause_us, max = GcStats.max_pause_us, total = GcStats.collection_us;
	if (count < a + 1) return -1;
	if (min < 0 || min > max) return -2;
	if (total < long.!(min) * count) return -3;
	if (total > long.!(max) * count) return -4;
	return 1;
}
