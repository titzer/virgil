//@execute 0=0; 1=5; 2=11; 5=35
class A(x: int) { }
var last: A;
def main(a: int) -> int {
	var arr: Array<byte> = [1, 2, 3, 4, 5, 6];
	var r = arr[2 ...];
	var sum = 0;
	for (i < a) {
		last = A.new(i);
		var p = Pointer.atContents(r);
		last = A.new(last.x);
		sum += p.load<u8>() + p.load<u8>() - 1 + last.x;
	}
	return sum;
}
