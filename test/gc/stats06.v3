//@execute 0=4; 1=6; 3=10; 10=24
class Counter {
	var count: int;
	var data = Array<int>.new(10);
	def inc() {
		count++;
		data[count % data.length] = count;
	}
}
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	// bound delegates are GC roots; their receivers move during collection
	var pre = Counter.new(), post = Counter.new();
	RiGc.preGC = pre.inc;
	RiGc.postGC = post.inc;
	for (i < 2 + a) CiTest.forceGc();
	RiGc.preGC = null;
	RiGc.postGC = null;
	if (pre.count != post.count) return -1;
	return pre.count + pre.data[pre.count % 10];
}
