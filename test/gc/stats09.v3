//@execute 0=1; 1=1; 3=1
var g: Array<byte>;
def main(a: int) -> int {
	RiGc.preGC = null;
	RiGc.postGC = null;
	GcStats.enabled = true;
	g = null;
	var before = GcStats.total_allocated_bytes();
	var gcs = GcStats.gc_count;
	// allocate many times the heap size, across many collections
	var count = 50 * (a + 1);
	for (i < count) g = Array<byte>.new(1000);
	var diff = GcStats.total_allocated_bytes() - before;
	if (GcStats.gc_count - gcs < 5) return -1;
	if (g.length != 1000) return -2;
	return if(diff >= count * 1000 && diff < count * 1100, 1, 0);
}
