//@execute 0=0; 1=-1; 2=1073741823; 3=-1073741824; 4=0; 5=0; 6=-1; 7=1073741822
type N {
	case Leaf(t: T);
	case Node(l: N, r: N);
}
type T #unboxed #packed {
	case I(x: i31);
	case Sub(n: N);
}
def dn = Array<N>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824),
	T.Sub(dn[0]),
	T.Sub(N.Leaf(T.I(0))),
	T.Sub(N.Leaf(T.I(-1))),
	T.Sub(N.Node(N.Leaf(T.I(-1)), N.Leaf(T.Sub(N.Leaf(T.I(1073741823))))))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.I(xs[0]);
		1 => return T.I(xs[1]);
		2 => return T.I(xs[2]);
		3 => return T.I(xs[3]);
		4 => return T.Sub(dn[0]);
		5 => return T.Sub(N.Leaf(T.I(xs[0])));
		6 => return T.Sub(N.Leaf(T.I(xs[1])));
		_ => return T.Sub(N.Node(N.Leaf(T.I(xs[1])), N.Leaf(T.Sub(N.Leaf(T.I(xs[2]))))));
	}
}
def sum(n: N) -> int {
	match (n) {
		Leaf(t) => return get(t);
		Node(l, r) => return sum(l) + sum(r);
	}
}
def get(v: T) -> int {
	match (v) {
		I(x) => return x;
		Sub(n) => return sum(n);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
