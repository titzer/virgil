//@execute 0=1; 1=-1; 2=0; 3=32; 4=-268435485; 5=-134217725; 6=-134217755; 7=-1521134261; 8=1252698775; 9=-134217724; 10=4; 11=-134217728
enum E { E0, E1, E2, E3, E4 }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E, x: u28);
}
def rs: Array<string> = ["r", null];
def es = [E.E0, E.E1, E.E2, E.E3, E.E4];
def xs: Array<u28> = [0, 1, 268435455, 134217728, 134217727, 89478485, 178956970, 134217728, 0, 134217728];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.E0, 0),
	T.X(E.E1, 1),
	T.X(E.E2, 268435455),
	T.X(E.E3, 134217728),
	T.X(E.E4, 134217727),
	T.X(E.E0, 89478485),
	T.X(E.E1, 178956970),
	T.X(E.E4, 134217728),
	T.X(E.E4, 0),
	T.X(E.E0, 134217728)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0], xs[0]);
		3 => return T.X(es[1], xs[1]);
		4 => return T.X(es[2], xs[2]);
		5 => return T.X(es[3], xs[3]);
		6 => return T.X(es[4], xs[4]);
		7 => return T.X(es[0], xs[5]);
		8 => return T.X(es[1], xs[6]);
		9 => return T.X(es[4], xs[7]);
		10 => return T.X(es[4], xs[8]);
		_ => return T.X(es[0], xs[9]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		X(e, x) => return (int.view(x)) * 31 + e.tag;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
