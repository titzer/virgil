//@execute 0=1; 1=-1; 2=0; 3=1; 4=32767; 5=16384; 6=16383; 7=21845; 8=-1; 9=-2; 10=0; 11=-16384; 12=16383; 13=-5462
type P #unboxed #packed {
	case X(a: u15);
	case Y(b: i15);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<u15> = [0, 1, 32767, 16384, 16383, 21845];
def xb: Array<i15> = [0, 1, -1, 16383, -16384, 5461];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(32767)),
	T.N0(P.X(16384)),
	T.N0(P.X(16383)),
	T.N0(P.X(21845)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(-1)),
	T.N0(P.Y(16383)),
	T.N0(P.Y(-16384)),
	T.N0(P.Y(5461))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		_ => return T.N0(P.Y(xb[5]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N0(p) => match (p) {
			X(a) => return (int.view(a)) + 0;
			Y(b) => return ~(int.view(b)) + 0;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
