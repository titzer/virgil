//@execute 0=-1; 1=1073741823; 2=-1073741827; 3=1073741823; 4=-1073741827; 5=5
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i31);
	case I1(x: i31);
}
def vs = [T.R("s1"), T.R(null), T.I0(-1073741824), T.I0(-1), T.I1(1073741823), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
type Bx {
	case K(t: T, u: T);
}
def main(a: int) -> int {
	var b = Bx.K(vs[a], vs[(a + 1) % vs.length]);
	if (b != Bx.K(vs[a], vs[(a + 1) % vs.length])) return -99;
	var k = Bx.K.!(b);
	return get(k.t) + 3 * get(k.u);
}
