//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096
type T #unboxed #packed {
	case R(s: string);
	case P0(a: i10, b: i10, c: i11);
}
def rs: Array<string> = ["r", null];
def f0a: Array<i10> = [0, -512, 511, 0, 0, 0, 0, -512, 511, 341, -342];
def f0b: Array<i10> = [0, 0, 0, -512, 511, 0, 0, -512, 511, -342, 341];
def f0c: Array<i11> = [0, 0, 0, 0, 0, -1024, 1023, -1024, 1023, -683, 682];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0, 0),
	T.P0(-512, 0, 0),
	T.P0(511, 0, 0),
	T.P0(0, -512, 0),
	T.P0(0, 511, 0),
	T.P0(0, 0, -1024),
	T.P0(0, 0, 1023),
	T.P0(-512, -512, -1024),
	T.P0(511, 511, 1023),
	T.P0(341, -342, -683),
	T.P0(-342, 341, 682)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0], f0c[0]);
		3 => return T.P0(f0a[1], f0b[1], f0c[1]);
		4 => return T.P0(f0a[2], f0b[2], f0c[2]);
		5 => return T.P0(f0a[3], f0b[3], f0c[3]);
		6 => return T.P0(f0a[4], f0b[4], f0c[4]);
		7 => return T.P0(f0a[5], f0b[5], f0c[5]);
		8 => return T.P0(f0a[6], f0b[6], f0c[6]);
		9 => return T.P0(f0a[7], f0b[7], f0c[7]);
		10 => return T.P0(f0a[8], f0b[8], f0c[8]);
		11 => return T.P0(f0a[9], f0b[9], f0c[9]);
		_ => return T.P0(f0a[10], f0b[10], f0c[10]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
