//@execute 0=true; 1=false; 2=true; 3=false
type X {
	case None;
	case IsY(p: (Y, int));
}
type Y {
	case None;
	case IsX(p: (int, X));
}
def xn = X.None, yn = Y.None;
def xy = X.IsY((yn, 3)), yx = Y.IsX((4, xn));
def main(a: int) -> bool {
	match (a) {
		0 => return xy == X.IsY((Y.None, 3));
		1 => return xy == xn;
		2 => return yx == Y.IsX((4, X.None));
		_ => return yx == yn;
	}
}
