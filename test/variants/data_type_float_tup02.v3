//@execute 0=1; 1=-1071644672; 2=-266631570; 3=1074340345; 4=-12345; 5=2139095040; 6=0; 7=-2147483648
// Bit-exact round trip through a data type whose field is a nested int/float/double tuple.
type D(v: (int, (float, double))) #unboxed;

def ts = [
	D((1, (-2.5f, 3.14159d))),
	D((-12345, (float.infinity, -0d)))
];

def main(a: int) -> int {
	var v = ts[(a >> 2) & 1].v;
	var d = u64.view(v.1.1);
	match (a & 3) {
		0 => return v.0;
		1 => return int.view(u32.view(v.1.0));
		2 => return int.view(d);
		_ => return int.view(d >> 32);
	}
}
