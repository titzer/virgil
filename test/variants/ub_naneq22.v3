//@execute 0=false; 1=false; 2=true; 3=true; 4=true
// A tagless unboxed variant with two constant payloads, one a NaN and one a -0.0.
// The NaN alone makes every value of the case unequal to itself.
type T #unboxed {
	case F(nonce: int, x: double, y: double);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(11, double.nan, -0d), T.F(22, double.nan, -0d)];
def G: Array<T> = [T.F(33, 1d, -0d), T.F(44, 1d, -0d)];
def main(a: int) -> bool {
	match (a) {
		0 => return CACHE[0] == CACHE[0];
		1 => return CACHE[1] == CACHE[1];
		2 => return G[0] == G[0];
		3 => return G[1] == G[1];
		_ => return !(G[0] == G[1]);
	}
}
