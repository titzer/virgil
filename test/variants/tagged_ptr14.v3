//@execute 0=3; 1=-1; 2=5; 3=-2147483648; 4=2147483647; 5=0
type T #unboxed #packed {
	case A(x: string);
	case B(x: int);
}

def ts = [T.A("abc"), T.B(-1), T.A("defgh"), T.B(int.min), T.B(int.max), T.B(0)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(v) => return v;
	}
}
