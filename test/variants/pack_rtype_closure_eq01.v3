//@execute 0=true; 1=false; 2=false; 3=false
type T #unboxed {
	case F(f: int -> int);
	case S(s: string);
}
def inc(x: int) -> int { return x + 1; }
def dec(x: int) -> int { return x - 1; }
def fs = [inc, dec];
def ss = ["abc", "de"];
def mk(a: int) -> T {
	if (a < 2) return T.F(fs[a]);
	return T.S(ss[a - 2]);
}
def main(a: int) -> bool {
	return mk(a) == mk(0);
}
