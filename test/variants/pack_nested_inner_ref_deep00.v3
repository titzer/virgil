//@execute 0=3; 1=5; 2=-1; 3=17; 4=-3; 5=2; 6=101; 7=-103; 8=44
//@heap-size=10000
type Q #unboxed #packed {
	case S(s: string);
	case I(x: i29);
}
type P #unboxed #packed {
	case Q(q: Q);
	case J(x: i30);
}
type T #unboxed #packed {
	case P(p: P);
	case K(x: i31);
}
def vs = [T.P(P.Q(Q.S("abc"))), T.P(P.Q(Q.I(5))), T.P(P.Q(Q.I(-1))), T.P(P.J(17)), T.P(P.J(-3)), T.P(P.Q(Q.S("de"))), T.K(101), T.K(-103), T.P(P.J(44))];
def get(t: T) -> int {
	match (t) {
		P(p) => match (p) {
			Q(q) => match (q) {
				S(s) => return s.length;
				I(x) => return x;
			}
			J(x) => return x;
		}
		K(x) => return x;
	}
}
def main(a: int) -> int {
	var copy = Array<T>.new(vs.length);
	for (i < vs.length) copy[i] = vs[(i + a) % vs.length];
	if (copy[0] != vs[a]) return -99;
	return get(copy[0]);
}
