//@execute 0=1; 1=0; 2=1; 3=1; 4=0; 5=2
type A {
	case None;
	case IsB(v: B);
}
type B {
	case None;
	case IsC(v: C);
}
type C {
	case None;
	case IsA(v: A);
}
def an = A.None, bn = B.None, cn = C.None;
def ab = A.IsB(bn), bc = B.IsC(cn), ca1 = C.IsA(an), ca2 = C.IsA(ab);
def hops(c: C) -> int {
	match (c) {
		None => return 0;
		IsA(a) => match (a) {
			None => return 1;
			IsB(b) => return 2;
		}
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return if(ab == A.IsB(B.None), 1, 0);
		1 => return if(ab == an, 1, 0);
		2 => return if(bc == B.IsC(C.None), 1, 0);
		3 => return if(ca2 == C.IsA(A.IsB(B.None)), 1, 0);
		4 => return if(ca1 == ca2, 1, 0);
		_ => return hops(ca2);
	}
}
