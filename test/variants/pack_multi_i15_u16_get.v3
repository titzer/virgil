//@execute 0=1; 1=-1; 2=0; 3=-16384; 4=16383; 5=2031585; 6=2047968; 7=1343467; 8=688117
type T #unboxed #packed {
	case R(s: string);
	case P0(a: i15, b: u16);
}
def rs: Array<string> = ["r", null];
def f0a: Array<i15> = [0, -16384, 16383, 0, 16383, -10923, 10922];
def f0b: Array<u16> = [0, 0, 0, 65535, 65535, 43690, 21845];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0),
	T.P0(-16384, 0),
	T.P0(16383, 0),
	T.P0(0, 65535),
	T.P0(16383, 65535),
	T.P0(-10923, 43690),
	T.P0(10922, 21845)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0]);
		3 => return T.P0(f0a[1], f0b[1]);
		4 => return T.P0(f0a[2], f0b[2]);
		5 => return T.P0(f0a[3], f0b[3]);
		6 => return T.P0(f0a[4], f0b[4]);
		7 => return T.P0(f0a[5], f0b[5]);
		_ => return T.P0(f0a[6], f0b[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		P0(a, b) => return int.view(a) + 31 * int.view(b) + 0;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
