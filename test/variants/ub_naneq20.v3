//@execute 0=false; 1=false; 2=false
// ub_naneq00b where the discriminating field is itself a double, so every scalar in
// the tagless representation is a float slot.
type T #unboxed {
	case F(nonce: double, x: double);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(1d, double.nan), T.F(2d, double.nan), T.F(-0d, double.nan)];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
