//@execute 0=true; 1=false; 2=true; 3=true
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
def xs = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
type B #unboxed {
	case X(c: C);
	case Y(s: string);
}
type A #unboxed {
	case Dead;
	case IsB(b: B);
}
def ss = ["s"];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.X(mkC(0))) == A.IsB(B.X(cs[0]));
		1 => return A.IsB(B.X(mkC(1))) == A.IsB(B.X(cs[0]));
		2 => return A.IsB(B.X(mkC(2))) == A.IsB(B.X(cs[2]));
		_ => return A.IsB(B.Y(ss[0])) == A.IsB(B.Y(ss[0]));
	}
}
