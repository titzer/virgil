//@execute 0=10; 1=-1; 2=11; 3=-2; 4=12; 5=-3; 6=0; 7=1; 8=536870911; 9=268435456; 10=268435455; 11=357913941; 12=178956970; 13=-1; 14=-2; 15=-536870912; 16=-268435457; 17=-268435456; 18=-357913942; 19=-178956971; 20=7; 21=8; 22=536870918; 23=268435463; 24=268435462; 25=357913948; 26=178956977
class C0(v: int) { }
class C1(v: int) { }
class C2(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case R2(x: C2);
	case I0(x: u29);
	case I1(x: u29);
	case I2(x: u29);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def r2: Array<C2> = [C2.new(12), null];
def xs: Array<u29> = [0, 1, 536870911, 268435456, 268435455, 357913941, 178956970];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.R2(r2[0]),
	T.R2(r2[1]),
	T.I0(0),
	T.I0(1),
	T.I0(536870911),
	T.I0(268435456),
	T.I0(268435455),
	T.I0(357913941),
	T.I0(178956970),
	T.I1(0),
	T.I1(1),
	T.I1(536870911),
	T.I1(268435456),
	T.I1(268435455),
	T.I1(357913941),
	T.I1(178956970),
	T.I2(0),
	T.I2(1),
	T.I2(536870911),
	T.I2(268435456),
	T.I2(268435455),
	T.I2(357913941),
	T.I2(178956970)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.R2(r2[0]);
		5 => return T.R2(r2[1]);
		6 => return T.I0(xs[0]);
		7 => return T.I0(xs[1]);
		8 => return T.I0(xs[2]);
		9 => return T.I0(xs[3]);
		10 => return T.I0(xs[4]);
		11 => return T.I0(xs[5]);
		12 => return T.I0(xs[6]);
		13 => return T.I1(xs[0]);
		14 => return T.I1(xs[1]);
		15 => return T.I1(xs[2]);
		16 => return T.I1(xs[3]);
		17 => return T.I1(xs[4]);
		18 => return T.I1(xs[5]);
		19 => return T.I1(xs[6]);
		20 => return T.I2(xs[0]);
		21 => return T.I2(xs[1]);
		22 => return T.I2(xs[2]);
		23 => return T.I2(xs[3]);
		24 => return T.I2(xs[4]);
		25 => return T.I2(xs[5]);
		_ => return T.I2(xs[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x.v);
		R1(x) => return if(x == null, -2, x.v);
		R2(x) => return if(x == null, -3, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~(int.view(x));
		I2(x) => return (int.view(x)) + 7;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
