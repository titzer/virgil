//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33
type T #unboxed #packed {
	case R(s: string);
	case P0(a: u8, b: u16, c: i7);
}
def rs: Array<string> = ["r", null];
def f0a: Array<u8> = [0, 255, 0, 0, 0, 255, 85, 170];
def f0b: Array<u16> = [0, 0, 65535, 0, 0, 65535, 43690, 21845];
def f0c: Array<i7> = [0, 0, 0, -64, 63, 63, -43, 42];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0, 0),
	T.P0(255, 0, 0),
	T.P0(0, 65535, 0),
	T.P0(0, 0, -64),
	T.P0(0, 0, 63),
	T.P0(255, 65535, 63),
	T.P0(85, 43690, -43),
	T.P0(170, 21845, 42)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0], f0c[0]);
		3 => return T.P0(f0a[1], f0b[1], f0c[1]);
		4 => return T.P0(f0a[2], f0b[2], f0c[2]);
		5 => return T.P0(f0a[3], f0b[3], f0c[3]);
		6 => return T.P0(f0a[4], f0b[4], f0c[4]);
		7 => return T.P0(f0a[5], f0b[5], f0c[5]);
		8 => return T.P0(f0a[6], f0b[6], f0c[6]);
		_ => return T.P0(f0a[7], f0b[7], f0c[7]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.P0.?(d)) r |= 32;
	return r;
}
