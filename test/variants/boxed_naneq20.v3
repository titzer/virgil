//@execute 0=true; 1=true; 2=false; 3=false; 4=true
// The comparisons run during component initialization, not in main.
type T {
	case F(x: double);
	case I(x: int);
}
def ZP: T = T.F(0d);
def ZN: T = T.F(-0d);
def NP: T = T.F(double.nan);
def IP: T = T.F(double.infinity);

def R = [
	ZP == ZP,
	ZP == ZN,
	NP == NP,
	NP == ZP,
	IP == IP
];

def main(i: int) -> bool {
	return R[i];
}
