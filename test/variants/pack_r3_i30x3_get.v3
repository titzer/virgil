//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=0; 10=1; 11=-1; 12=536870911; 13=-536870912; 14=536870910; 15=-536870911; 16=357913941; 17=-357913942; 18=268435456; 19=-268435456; 20=19088743; 21=-124076833; 22=-1; 23=-2; 24=0; 25=-536870912; 26=536870911; 27=-536870911; 28=536870910; 29=-357913942; 30=357913941; 31=-268435457; 32=268435455; 33=-19088744; 34=124076832; 35=7; 36=8; 37=6; 38=536870918; 39=-536870905; 40=536870917; 41=-536870904; 42=357913948; 43=-357913935; 44=268435463; 45=-268435449; 46=19088750; 47=-124076826
class A(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case I0(x: i30);
	case I1(x: i30);
	case I2(x: i30);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def xs: Array<i30> = [0, 1, -1, 536870911, -536870912, 536870910, -536870911, 357913941, -357913942, 268435456, -268435456, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(536870911), T.I0(-536870912), T.I0(536870910), T.I0(-536870911), T.I0(357913941), T.I0(-357913942), T.I0(268435456), T.I0(-268435456), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(536870911), T.I1(-536870912), T.I1(536870910), T.I1(-536870911), T.I1(357913941), T.I1(-357913942), T.I1(268435456), T.I1(-268435456), T.I1(19088743), T.I1(-124076833),
	T.I2(0), T.I2(1), T.I2(-1), T.I2(536870911), T.I2(-536870912), T.I2(536870910), T.I2(-536870911), T.I2(357913941), T.I2(-357913942), T.I2(268435456), T.I2(-268435456), T.I2(19088743), T.I2(-124076833)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
