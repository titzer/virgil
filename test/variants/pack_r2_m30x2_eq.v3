//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 32=6; 33=7; 34=8; 35=9; 36=10; 37=11; 38=12; 39=13; 40=14; 41=15; 42=16; 43=17; 44=18; 48=19; 49=20; 50=21; 51=22; 52=23; 53=24; 54=25; 55=26; 56=27; 57=28; 58=29; 59=30; 60=31
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: i30);
	case I1(x: u30);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xi: Array<i30> = [0, 1, -1, 536870911, -536870912, 536870910, -536870911, 357913941, -357913942, 268435456, -268435456, 19088743, -124076833];
def xu: Array<u30> = [0, 1, 2, 1073741823, 1073741822, 536870912, 536870911, 357913941, 715827882, 268435456, 805306368, 19088743, 949664990];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(536870911), T.I0(-536870912), T.I0(536870910), T.I0(-536870911), T.I0(357913941), T.I0(-357913942), T.I0(268435456), T.I0(-268435456), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(2), T.I1(1073741823), T.I1(1073741822), T.I1(536870912), T.I1(536870911), T.I1(357913941), T.I1(715827882), T.I1(268435456), T.I1(805306368), T.I1(19088743), T.I1(949664990)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.I0(xi[k]);
		_ => return T.I1(xu[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
