//@execute 0=8; 1=6; 2=3; 3=2
type T #unboxed {
	case F(f: int -> int);
	case S(s: string);
}
def inc(x: int) -> int { return x + 1; }
def dec(x: int) -> int { return x - 1; }
def vs = [T.F(inc), T.F(dec), T.S("abc"), T.S("de")];
def main(a: int) -> int {
	match (vs[a]) {
		F(f) => return f(7);
		S(s) => return s.length;
	}
}
