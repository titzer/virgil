//@execute 0=21; 1=32; 2=43
// Two tagged variant fields in one object, swapped into a new object across collections.
type T #unboxed #packed {
	case A(s: string);
	case B(x: u8);
}
class Pair(x: T, y: T) { }

def get(t: T) -> int {
	match (t) {
		A(s) => return s.length;
		B(x) => return x;
	}
}

def main(a: int) -> int {
	var p = Pair.new(T.A(Array<byte>.new(a + 1)), T.B(u8.!(a + 2)));
	CiTest.forceGc();
	var q = Pair.new(p.y, p.x);
	CiTest.forceGc();
	return get(q.x) * 10 + get(q.y);
}
