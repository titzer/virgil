//@execute 0=3; 1=4; 2=5; 3=6; 4=-1
class C(i: int) { }
type T #unboxed #packed {
	case A(s: string);
	case B(c: C);
	case D(a: Array<int>);
}

def ts = [T.A("abc"), T.B(C.new(4)), T.D([0, 1, 2, 3, 4]), T.D([0, 1, 2, 3, 4, 5]), T.B(null)];

def main(a: int) -> int {
	match (ts[a]) {
		A(s) => return s.length;
		B(c) => return if(c == null, -1, c.i);
		D(arr) => return arr.length;
	}
}
