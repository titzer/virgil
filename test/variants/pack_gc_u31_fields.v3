//@execute 0=-1; 1=-1073741825; 2=1073741827; 3=-2147483647; 4=2147483645; 5=5
//@heap-size=20000
type T #unboxed #packed {
	case R(s: string);
	case I0(x: u31);
	case I1(x: u31);
}
def vs = [T.R("s1"), T.R(null), T.I0(1073741824), T.I0(1), T.I1(2147483647), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
class N(t: T, next: N) {
	var u: T;
}
def main(a: int) -> int {
	var l: N;
	for (i < vs.length) {
		l = N.new(vs[(a + i) % vs.length], l);
		l.u = T.R(Array<byte>.new(i));
		if ((i & 1) == 1) CiTest.forceGc();
	}
	CiTest.forceGc();
	var i = vs.length - 1;
	for (n = l; n != null; n = n.next) {
		if (get(n.u) != i) return -99;
		if (n.t != vs[(a + i) % vs.length]) return -98;
		i--;
	}
	return get(l.next.next.next.next.next.t) + 3 * get(l.next.next.next.next.t);
}
