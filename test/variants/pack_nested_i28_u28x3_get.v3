//@execute 0=1; 1=-1; 2=0; 3=1; 4=-1; 5=134217727; 6=-1; 7=-2; 8=-268435456; 9=-134217729; 10=1; 11=2; 12=0; 13=134217728; 14=0; 15=-1; 16=-268435455; 17=-134217728; 18=2; 19=3; 20=1; 21=134217729; 22=1; 23=0; 24=-268435454; 25=-134217727
type P #unboxed #packed {
	case X(a: i28);
	case Y(b: u28);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
	case N1(p: P);
	case N2(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i28> = [0, 1, -1, 134217727];
def xb: Array<u28> = [0, 1, 268435455, 134217728];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(134217727)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(268435455)),
	T.N0(P.Y(134217728)),
	T.N1(P.X(0)),
	T.N1(P.X(1)),
	T.N1(P.X(-1)),
	T.N1(P.X(134217727)),
	T.N1(P.Y(0)),
	T.N1(P.Y(1)),
	T.N1(P.Y(268435455)),
	T.N1(P.Y(134217728)),
	T.N2(P.X(0)),
	T.N2(P.X(1)),
	T.N2(P.X(-1)),
	T.N2(P.X(134217727)),
	T.N2(P.Y(0)),
	T.N2(P.Y(1)),
	T.N2(P.Y(268435455)),
	T.N2(P.Y(134217728))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.Y(xb[0]));
		7 => return T.N0(P.Y(xb[1]));
		8 => return T.N0(P.Y(xb[2]));
		9 => return T.N0(P.Y(xb[3]));
		10 => return T.N1(P.X(xa[0]));
		11 => return T.N1(P.X(xa[1]));
		12 => return T.N1(P.X(xa[2]));
		13 => return T.N1(P.X(xa[3]));
		14 => return T.N1(P.Y(xb[0]));
		15 => return T.N1(P.Y(xb[1]));
		16 => return T.N1(P.Y(xb[2]));
		17 => return T.N1(P.Y(xb[3]));
		18 => return T.N2(P.X(xa[0]));
		19 => return T.N2(P.X(xa[1]));
		20 => return T.N2(P.X(xa[2]));
		21 => return T.N2(P.X(xa[3]));
		22 => return T.N2(P.Y(xb[0]));
		23 => return T.N2(P.Y(xb[1]));
		24 => return T.N2(P.Y(xb[2]));
		_ => return T.N2(P.Y(xb[3]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N0(p) => match (p) {
			X(a) => return (int.view(a)) + 0;
			Y(b) => return ~(int.view(b)) + 0;
		}
		N1(p) => match (p) {
			X(a) => return (int.view(a)) + 1;
			Y(b) => return ~(int.view(b)) + 1;
		}
		N2(p) => match (p) {
			X(a) => return (int.view(a)) + 2;
			Y(b) => return ~(int.view(b)) + 2;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
