//@execute 0=true; 1=true; 2=false; 3=false
// Control for ub_naneq00b: the dropped constant payload is `-0.0`, which *is* equal
// to itself, so the surviving scalar comparison stands. The two entries still
// differ in their nonce.
type T #unboxed {
	case F(nonce: int, x: double);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(11, -0d), T.F(22, -0d)];
def main(a: int) -> bool {
	var i = a & 1;
	var l = CACHE[i], r = CACHE[if((a & 2) == 0, i, 1 - i)];
	return l == r;
}
