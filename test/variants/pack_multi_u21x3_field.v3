//@execute 0=1; 1=1; 2=1; 3=1; 4=!TypeCheckException
type T #unboxed #packed {
	case R(s: string);
	case P(a: u21, b: u21, c: u21);
}
def fa: Array<u21> = [0, 2097151, 699050, 1];
def fb: Array<u21> = [2097151, 0, 1398101, 2];
def fc: Array<u21> = [1, 2, 2097151, 0];
def vs = [T.P(0, 2097151, 1), T.P(2097151, 0, 2), T.P(699050, 1398101, 2097151), T.P(1, 2, 0), T.R("r")];
def main(a: int) -> int {
	var p = T.P.!(vs[a]), n = (a + 1) & 3, r = 0;
	if (p == T.P(fa[a], fb[a], fc[a])) r |= 1;
	if (p.a != fa[a]) r |= 2;
	if (p.a == fa[n]) r |= 4;
	if (p == T.P(fa[n], fb[a], fc[a])) r |= 8;
	if (p.b != fb[a]) r |= 16;
	if (p.b == fb[n]) r |= 32;
	if (p == T.P(fa[a], fb[n], fc[a])) r |= 64;
	if (p.c != fc[a]) r |= 128;
	if (p.c == fc[n]) r |= 256;
	if (p == T.P(fa[a], fb[a], fc[n])) r |= 512;
	return r;
}
