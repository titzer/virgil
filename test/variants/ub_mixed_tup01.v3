//@execute 0=1; 1=2; 2=4; 3=8; 4=48; 5=48; 6=0; 7=0
// Equality over the nested-tuple case of ub_mixed_tup00.
type T #unboxed {
	case W(v: (int, (float, double)));
	case N;
}

def ts = [
	T.W((1, (1f, 1d))),
	T.W((2, (1f, 1d))),
	T.W((1, (2f, 1d))),
	T.W((1, (1f, 2d))),
	T.W((0, (0f, -0d))),
	T.W((0, (-0f, 0d))),
	T.W((0, (float.nan, 0d))),
	T.W((0, (0f, double.nan)))
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
