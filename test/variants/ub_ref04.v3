//@execute 0=1; 1=2
type B(j: byte) {}
type A #unboxed #packed { 
	case X(b: B) #unboxed #packed;
}
def main(a: int) -> int {
	def b1 = B(1);
	def b2 = B(2);
	def one = A.X(b1);
	def thr = A.X(b2);
	def arr = [one, thr];

	match(a) {
		0 => return A.X.!(arr[0]).b.j;
		1 => return A.X.!(arr[1]).b.j;
		_ => return 42;
	}
}
