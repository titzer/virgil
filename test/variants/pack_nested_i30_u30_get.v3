//@execute 0=1; 1=-1; 2=0; 3=1; 4=-1; 5=536870911; 6=-536870912; 7=357913941; 8=-1; 9=-2; 10=-1073741824; 11=-536870913; 12=-536870912; 13=-357913942
type P #unboxed #packed {
	case X(a: i30);
	case Y(b: u30);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i30> = [0, 1, -1, 536870911, -536870912, 357913941];
def xb: Array<u30> = [0, 1, 1073741823, 536870912, 536870911, 357913941];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(536870911)),
	T.N0(P.X(-536870912)),
	T.N0(P.X(357913941)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(1073741823)),
	T.N0(P.Y(536870912)),
	T.N0(P.Y(536870911)),
	T.N0(P.Y(357913941))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		_ => return T.N0(P.Y(xb[5]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N0(p) => match (p) {
			X(a) => return (int.view(a)) + 0;
			Y(b) => return ~(int.view(b)) + 0;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
