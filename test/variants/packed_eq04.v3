//@execute 0=true; 1=false; 2=false; 3=false; 4=false; 5=true
// Four packed fields; changing any single one must break equality.
type T #unboxed #packed {
	case A(p: u4, q: u4, r: u8, s: bool);
	case B(z: u4);
}

def base = T.A(5, 6, 200, true);
def ts = [T.A(5, 6, 200, true), T.A(4, 6, 200, true), T.A(5, 7, 200, true), T.A(5, 6, 201, true), T.A(5, 6, 200, false), T.A(5, 6, 200, true)];

def main(a: int) -> bool {
	match (a) {
		0 => return base == ts[0];
		1 => return base == ts[1];
		2 => return base == ts[2];
		3 => return base == ts[3];
		4 => return base == ts[4];
		_ => return ts[0] == ts[5];
	}
}
