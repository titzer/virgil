//@execute 0=2; 1=-1; 2=1073741824; 3=1; 4=-2147483648; 5=-1
//@heap-size=20000
type T #unboxed #packed {
	case R(s: string);
	case I0(x: u31);
	case I1(x: u31);
}
def vs = [T.R("s1"), T.R(null), T.I0(1073741824), T.I0(1), T.I1(2147483647), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	var p = vs[a], q = T.R(Array<byte>.new(a + 3)), r = vs[(a + 2) % vs.length];
	CiTest.forceGc();
	var s = Array<byte>.new(5);
	CiTest.forceGc();
	if (r != vs[(a + 2) % vs.length]) return -99;
	if (get(q) != a + 3) return -98;
	if (p != vs[a]) return -97;
	return get(p) + s.length - 5;
}
