//@execute = 111
// boxed_naneq21 for an unboxed variant.
type T #unboxed {
	case F(x: double);
	case I(x: int);
}
def V: T = T.F(double.nan);
def A: Array<T> = [T.F(double.nan)];
def INIT = if(V != V, 1, 0);
def main() -> int {
	var folded = if(T.F(double.nan) != T.F(double.nan), 1, 0);
	var live = if(A[0] != A[0], 1, 0);
	return INIT * 100 + folded * 10 + live;
}
