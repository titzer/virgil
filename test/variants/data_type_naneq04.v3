//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48
// The full matrix for a data type with two double fields.
type D(x: double, y: double) { }
def ts = [
	D(0d, 0d),
	D(-0d, -0d),
	D(double.nan, 0d),
	D(0d, double.nan),
	D(1d, 2d),
	D(1d, 2d)
];
def main(i: int) -> int {
	var l = ts[i];
	var out = 0;
	for (j < ts.length) {
		if (l == ts[j]) out |= (1 << u5.view(j));
	}
	return out;
}
