//@execute 0=12; 1=18; 2=24
// Two reference cases with non-zero tags plus a non-reference case.
class C(x: int) { }

type T #unboxed #packed {
	case A(x: u8);
	case B(c: C);
	case D(s: string);
	def get() -> int {
		match (this) {
			A(x) => return x;
			B(c) => return c.x;
			D(s) => return s.length;
		}
	}
}

var roots = Array<T>.new(6);

def main(a: int) -> int {
	for (i < roots.length) {
		CiTest.forceGc();
		match (i % 3) {
			0 => roots[i] = T.A(u8.!(a + 1));
			1 => roots[i] = T.B(C.new(a + 2));
			_ => roots[i] = T.D(Array<byte>.new(a + 3));
		}
	}
	var sum = 0;
	for (r in roots) {
		CiTest.forceGc();
		sum += r.get();
	}
	return sum;
}
