//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false; 6=true
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type B #unboxed {
	case None;
	case Box(c: C);
}
type A #unboxed {
	case Dead;
	case IsB(b: B);
}
def c1 = cs[0];
def bs = [B.None, B.Box(c1), B.Box(cs[2]), B.Box(cs[1])];
def mk(i: int) -> A.IsB { return A.IsB(bs[i]); }
def main(a: int) -> bool {
	match (a) {
		0 => return mk(0) == mk(0);
		1 => return mk(0) == mk(1);
		2 => return mk(1) == mk(1);
		3 => { var x: A = mk(0), y: A = mk(1); return x == y; }
		4 => { var x: A = mk(0), y: A = A.IsB(B.None); return x == y; }
		5 => return mk(2) == mk(1);
		_ => return mk(2) == mk(2);
	}
}
