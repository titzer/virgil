//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=41; 10=42; 11=-4; 12=0; 13=1; 14=2; 15=1073741823; 16=1073741822; 17=536870912; 18=536870911; 19=357913941; 20=715827882; 21=268435456; 22=805306368; 23=19088743; 24=949664990; 25=-1; 26=-2; 27=-3; 28=-1073741824; 29=-1073741823; 30=-536870913; 31=-536870912; 32=-357913942; 33=-715827883; 34=-268435457; 35=-805306369; 36=-19088744; 37=-949664991; 38=7; 39=8; 40=9; 41=1073741830; 42=1073741829; 43=536870919; 44=536870918; 45=357913948; 46=715827889; 47=268435463; 48=805306375; 49=19088750; 50=949664997; 51=0; 52=-1; 53=-2; 54=-1073741823; 55=-1073741822; 56=-536870912; 57=-536870911; 58=-357913941; 59=-715827882; 60=-268435456; 61=-805306368; 62=-19088743; 63=-949664990
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: u30);
	case I1(x: u30);
	case I2(x: u30);
	case I3(x: u30);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<u30> = [0, 1, 2, 1073741823, 1073741822, 536870912, 536870911, 357913941, 715827882, 268435456, 805306368, 19088743, 949664990];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(1073741823), T.I0(1073741822), T.I0(536870912), T.I0(536870911), T.I0(357913941), T.I0(715827882), T.I0(268435456), T.I0(805306368), T.I0(19088743), T.I0(949664990),
	T.I1(0), T.I1(1), T.I1(2), T.I1(1073741823), T.I1(1073741822), T.I1(536870912), T.I1(536870911), T.I1(357913941), T.I1(715827882), T.I1(268435456), T.I1(805306368), T.I1(19088743), T.I1(949664990),
	T.I2(0), T.I2(1), T.I2(2), T.I2(1073741823), T.I2(1073741822), T.I2(536870912), T.I2(536870911), T.I2(357913941), T.I2(715827882), T.I2(268435456), T.I2(805306368), T.I2(19088743), T.I2(949664990),
	T.I3(0), T.I3(1), T.I3(2), T.I3(1073741823), T.I3(1073741822), T.I3(536870912), T.I3(536870911), T.I3(357913941), T.I3(715827882), T.I3(268435456), T.I3(805306368), T.I3(19088743), T.I3(949664990)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
		I3(x) => return 0 - int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
