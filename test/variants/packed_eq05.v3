//@execute 0=true; 1=false; 2=false; 3=true; 4=false; 5=true
// Signed packed fields, including negative values and the extremes.
type T #unboxed #packed {
	case A(x: i8, y: i16);
	case B(z: u4);
}

def ts = [T.A(-1, -2), T.A(-1, -2), T.A(1, -2), T.A(-1, 2), T.A(127, -32768), T.A(-128, 32767), T.A(127, -32768)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[0] == ts[3];
		3 => return ts[4] == ts[6];
		4 => return ts[4] == ts[5];
		_ => return ts[0] != ts[2];
	}
}
