//@execute 0=true; 1=true; 2=true; 3=true
// The signed-zero half for data types, boxed and unboxed.
type D(v: (float, double)) { }
type U(v: (float, double)) #unboxed;

def POS: Array<D> = [D((0f, 0d)), D((-0f, 0d))];
def NEG: Array<D> = [D((-0f, -0d)), D((0f, -0d))];
def UPOS: Array<U> = [U((0f, 0d)), U((-0f, 0d))];
def UNEG: Array<U> = [U((-0f, -0d)), U((0f, -0d))];

def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, POS[i] == NEG[i], UPOS[i] == UNEG[i]);
}
