//@execute 0=false; 1=false; 2=false; 3=false
// boxed_naneq16 for double: NaNs that are not the canonical quiet NaN, including a
// signaling one and an all-ones payload.
type T {
	case D(x: double);
	case L(x: long);
}
def CACHE: Array<T> = [
	T.D(double.view(0x7FF00000_00000001uL)),	// signaling
	T.D(double.view(0xFFF80000_00000000uL)),	// negative quiet
	T.D(double.view(0x7FF80000_00000001uL)),	// quiet with payload
	T.D(double.view(0xFFFFFFFF_FFFFFFFFuL))		// all ones
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
