//@execute 0=-6; 1=5; 2=5; 3=-6
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f) => return u32.view(f(i32.view(v)));
			U(f) => return f(v);
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

def fs = [
	F.S(id_s),
	F.S(flip_s),
	F.U(id_u),
	F.U(flip_u)
];

def main(a: int) -> int {
	var arr = Array<F>.new(4);
	for (i < 4) arr[i] = fs[(i + a) & 3];
	var t = arr[0];
	arr[0] = arr[3];
	arr[3] = t;
	return int.view(arr[a & 3].apply(5));
}
