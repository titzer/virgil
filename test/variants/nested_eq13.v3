//@execute 0=true; 1=false; 2=true; 3=true; 4=false; 5=true
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type B #unboxed {
	case None;
	case Box(c: C);
}
def c1 = cs[0];
def bs = [B.None, B.Box(c1), B.Box(cs[2]), B.Box(cs[1])];
def mk(i: int, j: int) -> ((B, B), B) { return ((bs[i], bs[j]), bs[i]); }
def main(a: int) -> bool {
	match (a) {
		0 => return mk(0, 1) == ((B.None, B.Box(c1)), B.None);
		1 => return mk(0, 1) == mk(1, 0);
		2 => return mk(1, 0) == mk(1, 0);
		3 => return mk(2, 0) == ((B.Box(cs[2]), B.None), B.Box(cs[2]));
		4 => return mk(2, 1) == mk(1, 2);
		_ => return mk(3, 1) == mk(3, 1);
	}
}
