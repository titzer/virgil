//@execute 0=1; 1=2; 2=3; 3=0; 4=7; 5=10; 6=4; 7=3
type F #unboxed {
	case A(f: int -> int);
	case B(f: long -> long);
	case C(f: byte -> byte);
	case D(f: bool -> bool);
	case E(f: void -> int);
	case G(f: (int, int) -> int);
	case H(f: string -> int);
	case I(f: int -> string);

	def apply(v: int) -> int {
		match (this) {
			A(f) => return f(v);
			B(f) => return int.view(f(v));
			C(f) => return f(byte.view(v));
			D(f) => return if(f(v > 0), 1, 0);
			E(f) => return f();
			G(f) => return f(v, v);
			H(f) => return f("four");
			I(f) => return f(v).length;
		}
	}
}

def inc(x: int) => x + 1;
def dbl(x: long) => x + x;
def binc(x: byte) => byte.view(x + 1);
def not(x: bool) => !x;
def seven() => 7;
def add(x: int, y: int) => x + y;
def len(s: string) => s.length;
def str(x: int) => if(x > 0, "pos", "nonpos");

def fs = [F.A(inc), F.B(dbl), F.C(binc), F.D(not), F.E(seven), F.G(add), F.H(len), F.I(str)];

def main(a: int) -> int {
	return fs[a & 7].apply(a);
}
