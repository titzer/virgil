//@execute 0=true; 1=true; 2=false
// A class-typed field compares by reference; the NaN inside the object does not
// reach variant equality.
class C(x: double) { }
def NAN_OBJ = C.new(double.nan);
def ONE_OBJ = C.new(1d);
type T {
	case A(c: C);
	case B(x: double);
}
def CACHE: Array<T> = [T.A(NAN_OBJ), T.A(ONE_OBJ), T.B(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
