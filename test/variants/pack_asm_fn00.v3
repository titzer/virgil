//@execute 0=134217984; 1=134217984; 2=268435455; 3=201392127; 4=67108863; 5=7
def encJ = int.pack<(u6, u26)>;
def encI(op: u6, t: u26) -> int { return int.pack<(u6, u26)>((op, u16.view(t))); }
def ENCODERS: Array<(u6, u26) -> int> = [encJ, encI];
def decJ = int.unpack<(u6, u26)>;
def main(a: int) -> int {
	match (a) {
		0 => return ENCODERS[0]((2, 0x100));
		1 => return ENCODERS[1]((2, 0x100));
		2 => return ENCODERS[0]((3, 0x3FFFFFF));
		3 => return ENCODERS[1]((3, 0x3FFFFFF));
		4 => return decJ(encJ((5, 0x3FFFFFF))).1;
		_ => return decJ(encJ((7, 0x3FFFFFF))).0;
	}
}
