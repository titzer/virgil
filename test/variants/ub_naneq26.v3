//@execute 0=false; 1=true; 2=true; 3=false
// An unboxed variant nested in a tuple: tuple equality has to delegate to variant
// equality rather than compare the scalars it was flattened into.
type T #unboxed {
	case F(x: double);
	case I(y: int);
}
def CACHE: Array<(T, int)> = [
	(T.F(double.nan), 1),
	(T.F(1d), 1),
	(T.I(2), 1),
	(T.F(-0d), 1)
];
def main(a: int) -> bool {
	var v = CACHE[a];
	var r = v == v;
	return if(a == 3, !r, r);
}
