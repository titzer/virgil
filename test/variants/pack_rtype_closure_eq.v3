//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256
type T #unboxed #packed {
	case F(f: int -> int);
	case S(s: string);
	case I(x: i31);
}
def inc(x: int) -> int { return x + 1; }
def dec(x: int) -> int { return x - 1; }
def rf: Array<int -> int> = [inc, dec, null];
def rs: Array<string> = ["abc", null];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.F(rf[0]),
	T.F(rf[1]),
	T.F(rf[2]),
	T.S(rs[0]),
	T.S(rs[1]),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.F(rf[0]);
		1 => return T.F(rf[1]);
		2 => return T.F(rf[2]);
		3 => return T.S(rs[0]);
		4 => return T.S(rs[1]);
		5 => return T.I(xs[0]);
		6 => return T.I(xs[1]);
		7 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
