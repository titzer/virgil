//@execute 0=true; 1=true; 2=false; 3=true; 4=false; 5=true
// Three instantiations of one two-parameter variant in the same program.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def is: Array<T<int, int>> = [T.IsA(0), T.IsB(-1)];
def fs: Array<T<int, float>> = [T.IsB(float.nan), T.IsB(-0f)];
def ds: Array<T<double, long>> = [T.IsA(double.nan), T.IsB(-1L)];

def cmpI = T<int, int>.==;
def cmpF = T<int, float>.==;
def cmpD = T<double, long>.==;

def main(a: int) -> bool {
	match (a) {
		0 => return cmpI(is[0], is[0]);
		1 => return cmpI(is[1], is[1]);
		2 => return cmpF(fs[0], fs[0]);
		3 => return cmpF(fs[1], fs[1]);
		4 => return cmpD(ds[0], ds[0]);
		_ => return cmpD(ds[1], ds[1]);
	}
}
