//@execute 0=1; 1=-1; 2=0; 3=1; 4=-1073741824; 5=536870912; 6=-536870912; 7=1073741824; 8=-2147483648; 9=-2004318072; 10=-1; 11=-2; 12=1073741823; 13=-536870913; 14=536870911; 15=-1073741825; 16=2147483647; 17=2004318071
enum E { E0, E1, E2, E3, E4, E5, E6, E7, E8, E9, E10, E11, E12, E13, E14, E15, E16, E17, E18, E19, E20, E21, E22, E23, E24, E25, E26, E27, E28, E29, E30, E31, E32, E33, E34, E35, E36, E37, E38, E39, E40, E41, E42, E43, E44, E45, E46, E47, E48, E49, E50, E51, E52, E53, E54, E55, E56, E57, E58, E59, E60, E61 }
type T #unboxed #packed {
	case R(s: string);
	case S0(s: E.set);
	case S1(s: E.set);
}
def rs: Array<string> = ["r", null];
def ms = [0L, 1L, 4611686018427387903L, 2305843009213693952L, 2305843009213693951L, 1537228672809129301L, 3074457345618258602L, 81985529216486895L];
def set(m: long) -> E.set {
	var s: E.set;
	for (e in E.set.all) if (((m >> u6.view(e.tag)) & 1) != 0) s |= e;
	return s;
}
def bits(s: E.set) -> int {
	var r: long;
	for (e in s) r |= 1L << u6.view(e.tag);
	return int.view(r) ^ int.view(r >> 32);
}
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.S0(set(ms[0])),
	T.S0(set(ms[1])),
	T.S0(set(ms[2])),
	T.S0(set(ms[3])),
	T.S0(set(ms[4])),
	T.S0(set(ms[5])),
	T.S0(set(ms[6])),
	T.S0(set(ms[7])),
	T.S1(set(ms[0])),
	T.S1(set(ms[1])),
	T.S1(set(ms[2])),
	T.S1(set(ms[3])),
	T.S1(set(ms[4])),
	T.S1(set(ms[5])),
	T.S1(set(ms[6])),
	T.S1(set(ms[7]))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.S0(set(ms[0]));
		3 => return T.S0(set(ms[1]));
		4 => return T.S0(set(ms[2]));
		5 => return T.S0(set(ms[3]));
		6 => return T.S0(set(ms[4]));
		7 => return T.S0(set(ms[5]));
		8 => return T.S0(set(ms[6]));
		9 => return T.S0(set(ms[7]));
		10 => return T.S1(set(ms[0]));
		11 => return T.S1(set(ms[1]));
		12 => return T.S1(set(ms[2]));
		13 => return T.S1(set(ms[3]));
		14 => return T.S1(set(ms[4]));
		15 => return T.S1(set(ms[5]));
		16 => return T.S1(set(ms[6]));
		_ => return T.S1(set(ms[7]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		S0(s) => return bits(s);
		S1(s) => return ~bits(s);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
