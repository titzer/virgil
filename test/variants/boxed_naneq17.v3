//@execute 0=false; 1=false
// The cached value is reached through a class field rather than an array.
type T {
	case F(x: float);
	case I(x: int);
}
class Box(v: T) { }
def BOXES: Array<Box> = [Box.new(T.F(float.nan)), Box.new(T.F(float.nan))];
def main(a: int) -> bool {
	var b = BOXES[a];
	return b.v == b.v;
}
