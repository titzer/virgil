//@execute = 11
// eq_nan02 for double: the folded and the live comparison of identical bits must
// give the same answer.
type F {
	case M(x: double);
}
def NANS: Array<double> = [double.nan];
def main() -> int {
	var k = double.nan;			// constant
	var v = NANS[0];			// runtime value, same bits
	if (long.view(k) != long.view(v)) return -1;	// precondition: identical bits
	var folded = if(F.M(k) != F.M(k), 1, 0);
	var live = if(F.M(v) != F.M(v), 1, 0);
	return folded * 10 + live;		// 11 or 00, never 10
}
