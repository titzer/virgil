//@execute 0=true; 1=false; 2=true; 3=true; 4=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
def xs = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
type D #unboxed {
	case X(c: C);
	case Y(s: string);
}
type B #unboxed {
	case None;
	case IsD(d: D);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def ss = ["s", "t"];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.IsD(D.X(mkC(0)))) == A.IsB(B.IsD(D.X(cs[0])));
		1 => return A.IsB(B.IsD(D.X(mkC(1)))) == A.IsB(B.IsD(D.X(cs[0])));
		2 => return A.IsB(B.IsD(D.X(mkC(2)))) == A.IsB(B.IsD(D.X(cs[2])));
		3 => return A.IsB(B.IsD(D.Y(ss[0]))) == A.IsB(B.IsD(D.Y(ss[0])));
		_ => return A.IsB(B.IsD(D.Y(ss[0]))) == A.IsB(B.None);
	}
}
