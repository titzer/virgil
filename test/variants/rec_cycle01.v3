//@execute 0=1; 1=1; 2=1; 3=1; 4=1; 5=0; 6=0
type A {
	case None;
	case IsB(v: B);
}
type B {
	case None;
	case IsC(v: C);
}
type C {
	case None;
	case IsD(v: D);
}
type D {
	case None;
	case IsE(v: E);
}
type E {
	case None;
	case IsA(v: A);
}
def ab = A.IsB(B.None), bc = B.IsC(C.None), cd = C.IsD(D.None), de = D.IsE(E.None), ea = E.IsA(A.None);
def main(a: int) -> int {
	match (a) {
		0 => return ab.tag;
		1 => return bc.tag;
		2 => return cd.tag;
		3 => return de.tag;
		4 => return ea.tag;
		5 => return A.None.tag;
		_ => return if(ab == A.None || ea == E.None, 1, 0);
	}
}
