//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type T #unboxed #packed {
	case A(t: (P, u8));
	case B(x: i31);
}
def ss = ["abc", "de"];
def xs: Array<i30> = [5, -1];
def ys: Array<i31> = [6, -2];
def vs = [T.A((P.S(ss[0]), 1)), T.A((P.S(ss[1]), 2)), T.A((P.I(5), 3)), T.A((P.I(-1), 4)), T.B(6), T.B(-2)];
def mk(a: int) -> T {
	match (a) {
		0 => return T.A((P.S(ss[0]), 1));
		1 => return T.A((P.S(ss[1]), 2));
		2 => return T.A((P.I(xs[0]), 3));
		3 => return T.A((P.I(xs[1]), 4));
		4 => return T.B(ys[0]);
		_ => return T.B(ys[1]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
