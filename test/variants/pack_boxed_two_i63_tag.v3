//@execute 0=16; 1=16; 2=16; 3=33; 4=33; 5=33; 6=66; 7=66; 8=66; 9=66; 10=66
type P {
	case U(a: int);
	case V(b: long);
}
type Q {
	case U(a: int);
	case W(s: string);
}
type T #unboxed #packed {
	case X(p: P);
	case Y(q: Q);
	case I(x: i63);
}
def ks = [9, 0];
def xs: Array<i63> = [0, -1, 4611686018427387903, -4611686018427387904, 3074457345618258602];
def vs = [
	T.X(P.U(9)),
	T.X(P.U(0)),
	T.X(P.V(9)),
	T.Y(Q.U(9)),
	T.Y(Q.U(0)),
	T.Y(Q.W("w")),
	T.I(0),
	T.I(-1),
	T.I(4611686018427387903),
	T.I(-4611686018427387904),
	T.I(3074457345618258602)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(P.U(ks[0]));
		1 => return T.X(P.U(ks[1]));
		2 => return T.X(P.V(ks[0]));
		3 => return T.Y(Q.U(ks[0]));
		4 => return T.Y(Q.U(ks[1]));
		5 => return T.Y(Q.W("w"));
		6 => return T.I(xs[0]);
		7 => return T.I(xs[1]);
		8 => return T.I(xs[2]);
		9 => return T.I(xs[3]);
		_ => return T.I(xs[4]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.X.?(d)) r |= 16;
	if (T.Y.?(d)) r |= 32;
	if (T.I.?(d)) r |= 64;
	return r;
}
