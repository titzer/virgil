//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=0; 6=192; 7=192
// The full matrix for a polymorphic data type at float.
type Pair<X>(x: X, y: X) { }

def ts = [
	Pair(0f, 0f),
	Pair(-0f, 0f),
	Pair(0f, -0f),
	Pair(1f, float.nan),
	Pair(float.nan, 1f),
	Pair(float.nan, float.nan),
	Pair(1f, 2f),
	Pair(1f, 2f)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
