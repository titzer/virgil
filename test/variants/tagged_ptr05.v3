//@execute 0=3; 1=200; 2=-1234; 3=5; 4=0; 5=32767; 6=-32768
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
	case C(x: i16);
}

def ts = [T.A("abc"), T.B(200), T.C(-1234), T.A("defgh"), T.B(0), T.C(32767), T.C(-32768)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(v) => return v;
		C(v) => return v;
	}
}
