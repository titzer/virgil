//@execute 0=false; 1=true; 2=true; 3=false
// ub_enumeq00 for a boxed variant: the constant field is dropped from the record
// too, so the generated comparator has no field left to compare.
type T {
	case F(x: double);
	case G;
	case H;
}
def CACHE: Array<T> = [T.F(double.nan), T.G, T.H, T.F(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
