//@execute 0=3; 1=2; 2=5; 3=4; 4=-1; 5=-2
type T #unboxed #packed {
	case A(x: string);
	case B(x: Array<int>);
}

def ts = [T.A("abc"), T.B([1, 2]), T.A("defgh"), T.B([1, 2, 3, 4]), T.A(null), T.B(null)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return if(str == null, -1, str.length);
		B(arr) => return if(arr == null, -2, arr.length);
	}
}
