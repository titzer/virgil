//@execute 0=16; 1=16; 2=16; 16=33; 17=33; 18=33; 32=66; 33=66; 34=66; 48=131; 49=131; 50=131; 64=260; 65=260; 66=260; 67=260; 68=260; 69=260; 70=260; 71=260; 72=260; 73=260; 74=260; 75=260; 76=260
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: u63);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<u63> = [0, 1, 2, 9223372036854775807, 9223372036854775806, 4611686018427387904, 4611686018427387903, 6148914691236517205, 3074457345618258602, 2305843009213693952, 6917529027641081856, 19088743, 9223372036730698974];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(9223372036854775807), T.I0(9223372036854775806), T.I0(4611686018427387904), T.I0(4611686018427387903), T.I0(6148914691236517205), T.I0(3074457345618258602), T.I0(2305843009213693952), T.I0(6917529027641081856), T.I0(19088743), T.I0(9223372036730698974)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.R2(r2[k]);
		3 => return T.R3(r3[k]);
		_ => return T.I0(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r: int = d.tag;
	if (T.R0.?(d)) r |= 16;
	if (T.R1.?(d)) r |= 32;
	if (T.R2.?(d)) r |= 64;
	if (T.R3.?(d)) r |= 128;
	if (T.I0.?(d)) r |= 256;
	return r;
}
