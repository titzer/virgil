//@execute 0=11; 1=12; 2=-1; 3=0; 4=1; 5=2; 6=536870911; 7=536870910; 8=268435456; 9=268435455; 10=357913941; 11=178956970; 12=134217728; 13=402653184; 14=19088743; 15=412794078; 16=-1; 17=-2; 18=-3; 19=-536870912; 20=-536870911; 21=-268435457; 22=-268435456; 23=-357913942; 24=-178956971; 25=-134217729; 26=-402653185; 27=-19088744; 28=-412794079; 29=7; 30=8; 31=9; 32=536870918; 33=536870917; 34=268435463; 35=268435462; 36=357913948; 37=178956977; 38=134217735; 39=402653191; 40=19088750; 41=412794085
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: u29);
	case I1(x: u29);
	case I2(x: u29);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<u29> = [0, 1, 2, 536870911, 536870910, 268435456, 268435455, 357913941, 178956970, 134217728, 402653184, 19088743, 412794078];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(536870911), T.I0(536870910), T.I0(268435456), T.I0(268435455), T.I0(357913941), T.I0(178956970), T.I0(134217728), T.I0(402653184), T.I0(19088743), T.I0(412794078),
	T.I1(0), T.I1(1), T.I1(2), T.I1(536870911), T.I1(536870910), T.I1(268435456), T.I1(268435455), T.I1(357913941), T.I1(178956970), T.I1(134217728), T.I1(402653184), T.I1(19088743), T.I1(412794078),
	T.I2(0), T.I2(1), T.I2(2), T.I2(536870911), T.I2(536870910), T.I2(268435456), T.I2(268435455), T.I2(357913941), T.I2(178956970), T.I2(134217728), T.I2(402653184), T.I2(19088743), T.I2(412794078)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
