//@execute 0=true; 1=false; 2=false; 3=true; 4=false; 5=true
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy = X.IsY(yn), yx = Y.IsX(xn);
def main(a: int) -> bool {
	match (a) {
		0 => return xn == X.None;
		1 => return xn == xy;
		2 => return yn == yx;
		3 => return xy == X.IsY(Y.None);
		4 => return xy != X.IsY(yn);
		_ => return yx == Y.IsX(xn) && !(yx == Y.None);
	}
}
