//@execute 0=10; 1=-1; 2=11; 3=-2; 4=12; 5=-3; 6=13; 7=-4; 8=0; 9=1; 10=-1073741824; 11=536870912; 12=-536870912; 13=1073741824; 14=-2147483648; 15=-1; 16=-2; 17=1073741823; 18=-536870913; 19=536870911; 20=-1073741825; 21=2147483647
class C0(v: int) { }
class C1(v: int) { }
class C2(v: int) { }
class C3(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case R2(x: C2);
	case R3(x: C3);
	case I0(x: u62);
	case I1(x: u62);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def r2: Array<C2> = [C2.new(12), null];
def r3: Array<C3> = [C3.new(13), null];
def xs: Array<u62> = [0, 1, 4611686018427387903, 2305843009213693952, 2305843009213693951, 1537228672809129301, 3074457345618258602];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.R2(r2[0]),
	T.R2(r2[1]),
	T.R3(r3[0]),
	T.R3(r3[1]),
	T.I0(0),
	T.I0(1),
	T.I0(4611686018427387903),
	T.I0(2305843009213693952),
	T.I0(2305843009213693951),
	T.I0(1537228672809129301),
	T.I0(3074457345618258602),
	T.I1(0),
	T.I1(1),
	T.I1(4611686018427387903),
	T.I1(2305843009213693952),
	T.I1(2305843009213693951),
	T.I1(1537228672809129301),
	T.I1(3074457345618258602)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.R2(r2[0]);
		5 => return T.R2(r2[1]);
		6 => return T.R3(r3[0]);
		7 => return T.R3(r3[1]);
		8 => return T.I0(xs[0]);
		9 => return T.I0(xs[1]);
		10 => return T.I0(xs[2]);
		11 => return T.I0(xs[3]);
		12 => return T.I0(xs[4]);
		13 => return T.I0(xs[5]);
		14 => return T.I0(xs[6]);
		15 => return T.I1(xs[0]);
		16 => return T.I1(xs[1]);
		17 => return T.I1(xs[2]);
		18 => return T.I1(xs[3]);
		19 => return T.I1(xs[4]);
		20 => return T.I1(xs[5]);
		_ => return T.I1(xs[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x.v);
		R1(x) => return if(x == null, -2, x.v);
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		I0(x) => return int.view(x) ^ int.view(x >> 32);
		I1(x) => return ~(int.view(x) ^ int.view(x >> 32));
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
