//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33
enum E { A, B, C, D }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E);
}
def rs: Array<string> = ["r", null];
def es = [E.A, E.B, E.C, E.D];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.A),
	T.X(E.B),
	T.X(E.C),
	T.X(E.D)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0]);
		3 => return T.X(es[1]);
		4 => return T.X(es[2]);
		_ => return T.X(es[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.X.?(d)) r |= 32;
	return r;
}
