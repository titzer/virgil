//@execute 0=2; -999=-42; 555=3; -222=4
type Val #unboxed #packed {
	case Str(s: string);
	case I31(x: i31);
}

def vs = [Val.Str("hello"), Val.Str("there"), Val.I31(0), Val.I31(555), Val.I31(-222)];

def main(a: i31) -> int {
	var e = Val.I31(a);
	for (i < vs.length) {
		if (e == vs[i]) return i;
	}
	return -42;
}
