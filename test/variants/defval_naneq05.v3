//@execute 0=3; 1=3; 2=0
// The default value of a tuple-typed variant field.
type T {
	case P(v: (double, float, int));
	case N;
}
def D: T;
def CACHE: Array<T> = [
	T.P((0d, 0f, 0)),
	T.P((-0d, -0f, 0)),
	T.P((-0d, float.nan, 0))
];
def main(a: int) -> int {
	var l = D, r = CACHE[a];
	return if(l == r, 1) | if(r == l, 2);
}
