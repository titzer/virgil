//@execute 0=3; 1=3; 2=0; 3=3
// The default value of a variant is the all-zero first case. `-0.0` compares equal
// to it (IEEE), a NaN does not, and both directions of the comparison must agree.
type T {
	case F(x: double);
	case I(y: int);
}
def D: T;
def CACHE: Array<T> = [T.F(0d), T.F(-0d), T.F(double.nan), T.F(0d)];
def main(a: int) -> int {
	var l = D, r = CACHE[a];
	return if(l == r, 1) | if(r == l, 2);
}
