//@execute 0=true; 1=true; 2=true; 3=true; 4=true; 5=true
// fails on x86-64: nested tagged ref loses its tag bits
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type T #unboxed #packed {
	case A(p: P);
	case B(x: i31);
}
def ss = ["abc", "de"];
def xs: Array<i30> = [5, -1];
def ys: Array<i31> = [6, -2];
def vs = [T.A(P.S(ss[0])), T.A(P.S(ss[1])), T.A(P.I(5)), T.A(P.I(-1)), T.B(6), T.B(-2)];
def main(a: int) -> bool {
	if (a < 2) return T.A(P.S(ss[a])) == vs[a];
	if (a < 4) return T.A(P.I(xs[a - 2])) == vs[a];
	return T.B(ys[a - 4]) == vs[a];
}
