//@execute 0=1; 1=-1; 2=0; 3=1; 4=-1; 5=1073741823; 6=-1073741824; 7=357913941; 8=-1; 9=-2; 10=-2147483648; 11=-1073741825; 12=-1073741824; 13=-1431655766
type P #unboxed #packed {
	case X(a: i31);
	case Y(b: u31);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i31> = [0, 1, -1, 1073741823, -1073741824, 357913941];
def xb: Array<u31> = [0, 1, 2147483647, 1073741824, 1073741823, 1431655765];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(1073741823)),
	T.N0(P.X(-1073741824)),
	T.N0(P.X(357913941)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(2147483647)),
	T.N0(P.Y(1073741824)),
	T.N0(P.Y(1073741823)),
	T.N0(P.Y(1431655765))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		_ => return T.N0(P.Y(xb[5]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N0(p) => match (p) {
			X(a) => return (int.view(a)) + 0;
			Y(b) => return ~(int.view(b)) + 0;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
