//@execute 0=1; 1=102; 2=203; 3=304
// Tagged variants live in locals across calls that collect.
type T #unboxed #packed {
	case A(s: string);
	case B(x: u8);
}

def get(t: T) -> int {
	match (t) {
		A(s) => return s.length;
		B(x) => return x;
	}
}
def mk(i: int) -> T {
	CiTest.forceGc();
	return if((i & 1) == 0, T.A(Array<byte>.new(i)), T.B(u8.!(i)));
}

def main(a: int) -> int {
	var t = mk(a);
	CiTest.forceGc();
	var u = mk(a + 1);
	CiTest.forceGc();
	return get(t) * 100 + get(u);
}
