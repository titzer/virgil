//@execute 0=1; 1=0; 2=1; 3=0; 4=1; 5=2
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy = X.IsY(yn), yx = Y.IsX(xn);
def depth(x: X) -> int {
	match (x) {
		None => return 0;
		IsY(y) => match (y) {
			None => return 1;
			IsX(x) => return 2 + depth(x);
		}
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return if(xn == X.None, 1, 0);
		1 => return if(xn == xy, 1, 0);
		2 => return if(xy == X.IsY(Y.None), 1, 0);
		3 => return if(yn == yx, 1, 0);
		4 => return depth(xy);
		_ => return depth(X.IsY(yx));
	}
}
