//@execute 0=true; 1=false; 2=true
// Array fields are compared by reference, not by content: two distinct arrays with
// the same elements make the variants unequal, and the same array makes them equal
// even when the elements are NaNs.
type T {
	case A(a: Array<double>);
	case N;
}
def X: Array<double> = [double.nan];
def Y: Array<double> = [double.nan];
def main(a: int) -> bool {
	match (a) {
		0 => return T.A(X) == T.A(X);
		1 => return T.A(X) == T.A(Y);
		_ => return T.N == T.N;
	}
}
