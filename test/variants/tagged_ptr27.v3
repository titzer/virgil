//@execute 0=12; 1=160; 2=11
type X(a: u8, b: u8) #unboxed #packed {
}
type T #unboxed #packed {
	case A(x: X)		{ def get() => int.!(x.a + x.b); }
	case B(y: string)	{ def get() => y.length; }
	def get() -> int;
}

var xs = [X(3, 3), X(77, 77), X(200, 61)];

def g = T.B("foobar");

def main(a: int) -> int {
	var x = xs[a];
	var t = T.A(x);
	return t.get() + g.get();
}
