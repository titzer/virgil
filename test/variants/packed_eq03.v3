//@execute 0=true; 1=false; 2=false; 3=true; 4=false
// Equality on values typed as a case of a packed variant.
type T #unboxed #packed {
	case A(x: u8, y: u8);
	case B(z: u8);
}

def a12: T.A = T.A(1, 2);
def a13: T.A = T.A(1, 3);
def a22: T.A = T.A(2, 2);
def b1: T.B = T.B(1);

def main(a: int) -> bool {
	match (a) {
		0 => return a12 == T.A(1, 2);
		1 => return a12 == a13;
		2 => return a12 == a22;
		3 => return a12 != a13;
		_ => { var t: T = a12; return t == b1; }
	}
}
