//@execute 0=true; 1=false; 2=false; 3=false; 4=true; 5=true; 6=true; 7=false
// Packed fields at non-zero bit offsets must all take part in equality.
type T #unboxed #packed {
	case A(x: u8, y: u8);
	case B(z: u8);
}

def ts = [T.A(1, 2), T.A(1, 3), T.A(2, 2), T.A(2, 3), T.B(1), T.B(2)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == T.A(1, 2);
		1 => return ts[0] == ts[1]; // y differs
		2 => return ts[0] == ts[2]; // x differs
		3 => return ts[0] == ts[3]; // both differ
		4 => return ts[0] != ts[1];
		5 => return ts[1] != ts[2];
		6 => return ts[4] != ts[5];
		_ => return ts[4] == ts[5];
	}
}
