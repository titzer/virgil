//@execute 0=10; 1=12; 2=14
// A boolean packed next to the reference must survive the GC re-tagging the pointer.
type T #unboxed #packed {
	case A(s: string, neg: bool);
	case B(x: u8);
	def get() -> int {
		match (this) {
			A(s, neg) => return if(neg, 0 - s.length, s.length);
			B(x) => return x;
		}
	}
}

var roots = Array<T>.new(6);

def main(a: int) -> int {
	for (i < roots.length) {
		CiTest.forceGc();
		match (i % 3) {
			0 => roots[i] = T.A(Array<byte>.new(a + 1), false);
			1 => roots[i] = T.A(Array<byte>.new(a + 1), true);
			_ => roots[i] = T.B(u8.!(a + 5));
		}
	}
	var sum = 0;
	for (r in roots) {
		CiTest.forceGc();
		sum += r.get();
	}
	return sum;
}
