//@execute 0=0; 1=-2147483648; 2=2146435072; 3=-1048576; 4=1073217536; 5=-1074266112; 6=0; 7=!TypeCheckException
// Bit-exact round trip of the extreme double payloads through an unboxed case.
type T #unboxed {
	case L(val: u64);
	case D(val: double);
}

def ts = [
	T.D(0d), T.D(-0d),
	T.D(double.infinity),
	T.D(-double.infinity),
	T.D(1.5d),
	T.D(-1.5d),
	T.D(double.view(1uL)),
	T.L(0xDEADBEEF_CAFEBABE)
];

def main(a: int) -> int {
	var v = ts[a];
	var d = T.D.!(v);
	var l = u64.view(d.val);
	return int.view(l >> 32);
}
