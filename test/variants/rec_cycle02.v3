//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false; 6=true
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
	case IsZ(z: Z);
}
type Z {
	case None;
	case IsY(y: Y);
}
def xn = X.None, yn = Y.None, zn = Z.None;
def xy = X.IsY(yn), yx = Y.IsX(xn), yz = Y.IsZ(zn), zy = Z.IsY(yn);
def main(a: int) -> bool {
	match (a) {
		0 => return xy == X.IsY(Y.None);
		1 => return xy == xn;
		2 => return yx == Y.IsX(X.None);
		3 => return yx == yz;
		4 => return yz == Y.IsZ(Z.None);
		5 => return zy == zn;
		_ => return zy == Z.IsY(Y.None) && yn.tag == 0 && yx.tag == 1 && yz.tag == 2;
	}
}
