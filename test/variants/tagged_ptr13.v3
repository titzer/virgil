//@execute 0=3; 1=1; 2=5; 3=2
type T #unboxed #packed {
	case A(x: string);
	case B(x: u62);
}

def ts = [T.A("abc"), T.B(1), T.A("defgh"), T.B(0x3FFF_FFFF_FFFF_FFFF)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(v) => return if(v == 0x3FFF_FFFF_FFFF_FFFF, 2, if(v == 1, 1, -1));
	}
}
