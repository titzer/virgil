//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=0; 7=1; 8=2; 9=2147483647; 10=2147483646; 11=1073741824; 12=1073741823; 13=1431655765; 14=715827882; 15=536870912; 16=1610612736; 17=19088743; 18=2023406814; 19=-1; 20=-2; 21=-3; 22=-2147483648; 23=-2147483647; 24=-1073741825; 25=-1073741824; 26=-1431655766; 27=-715827883; 28=-536870913; 29=-1610612737; 30=-19088744; 31=-2023406815
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: u31);
	case I1(x: u31);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xs: Array<u31> = [0, 1, 2, 2147483647, 2147483646, 1073741824, 1073741823, 1431655765, 715827882, 536870912, 1610612736, 19088743, 2023406814];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(2147483647), T.I0(2147483646), T.I0(1073741824), T.I0(1073741823), T.I0(1431655765), T.I0(715827882), T.I0(536870912), T.I0(1610612736), T.I0(19088743), T.I0(2023406814),
	T.I1(0), T.I1(1), T.I1(2), T.I1(2147483647), T.I1(2147483646), T.I1(1073741824), T.I1(1073741823), T.I1(1431655765), T.I1(715827882), T.I1(536870912), T.I1(1610612736), T.I1(19088743), T.I1(2023406814)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
