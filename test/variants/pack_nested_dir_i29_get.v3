//@execute 0=1; 1=-1; 2=0; 3=-4; 4=1073741820; 5=-1073741824; 6=1; 7=-3; 8=1073741821; 9=-1073741823; 10=2; 11=-2; 12=1073741822; 13=-1073741822; 14=3; 15=-1; 16=1073741823; 17=-1073741821
type D #unboxed {
	case N;
	case S;
	case E;
	case W;
}
type T #unboxed #packed {
	case R(s: string);
	case M(d: D, x: i29);
}
def rs: Array<string> = ["r", null];
def ds = [D.N, D.S, D.E, D.W];
def xs: Array<i29> = [0, -1, 268435455, -268435456];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.M(D.N, 0),
	T.M(D.N, -1),
	T.M(D.N, 268435455),
	T.M(D.N, -268435456),
	T.M(D.S, 0),
	T.M(D.S, -1),
	T.M(D.S, 268435455),
	T.M(D.S, -268435456),
	T.M(D.E, 0),
	T.M(D.E, -1),
	T.M(D.E, 268435455),
	T.M(D.E, -268435456),
	T.M(D.W, 0),
	T.M(D.W, -1),
	T.M(D.W, 268435455),
	T.M(D.W, -268435456)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.M(ds[0], xs[0]);
		3 => return T.M(ds[0], xs[1]);
		4 => return T.M(ds[0], xs[2]);
		5 => return T.M(ds[0], xs[3]);
		6 => return T.M(ds[1], xs[0]);
		7 => return T.M(ds[1], xs[1]);
		8 => return T.M(ds[1], xs[2]);
		9 => return T.M(ds[1], xs[3]);
		10 => return T.M(ds[2], xs[0]);
		11 => return T.M(ds[2], xs[1]);
		12 => return T.M(ds[2], xs[2]);
		13 => return T.M(ds[2], xs[3]);
		14 => return T.M(ds[3], xs[0]);
		15 => return T.M(ds[3], xs[1]);
		16 => return T.M(ds[3], xs[2]);
		_ => return T.M(ds[3], xs[3]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		M(d, x) => return x * 4 + d.tag;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
