//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096
class C0(v: int) { }
class C1(v: int) { }
class C2(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case R2(x: C2);
	case I0(x: i63);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def r2: Array<C2> = [C2.new(12), null];
def xs: Array<i63> = [0, 1, -1, 4611686018427387903, -4611686018427387904, 1537228672809129301, -1537228672809129302];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.R2(r2[0]),
	T.R2(r2[1]),
	T.I0(0),
	T.I0(1),
	T.I0(-1),
	T.I0(4611686018427387903),
	T.I0(-4611686018427387904),
	T.I0(1537228672809129301),
	T.I0(-1537228672809129302)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.R2(r2[0]);
		5 => return T.R2(r2[1]);
		6 => return T.I0(xs[0]);
		7 => return T.I0(xs[1]);
		8 => return T.I0(xs[2]);
		9 => return T.I0(xs[3]);
		10 => return T.I0(xs[4]);
		11 => return T.I0(xs[5]);
		_ => return T.I0(xs[6]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
