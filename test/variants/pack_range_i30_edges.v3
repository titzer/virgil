//@execute 0=1209882128; 1=-1506519057; 2=1478317584
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i30);
	case I1(x: i30);
}
def bases = [-16L, 536870895L, 268435440L];
def cell: Array<T> = [T.R("r"), T.R(null)];
def main(a: int) -> int {
	var acc = 0;
	for (d < 33) {
		var x = i30.view(bases[a] + d);
		cell[1] = if((d & 1) == 0, T.I0(x), T.I1(x));
		if (cell[1] == cell[0]) return -100;
		if (cell[1] == if((d & 1) == 0, T.I1(x), T.I0(x))) return -300;
		match (cell[1]) {
			R(s) => return -200;
			I0(y) => {
				if (y != x) return -1 - d;
				acc = acc * 31 + int.view(y);
			}
			I1(y) => {
				if (y != x) return -1 - d;
				acc = acc * 31 + ~int.view(y);
			}
		}
	}
	return acc;
}
