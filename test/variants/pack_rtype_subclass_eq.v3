//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64
class P(v: int) { }
class Q extends P {
	new(v: int) super(v) { }
}
type T #unboxed #packed {
	case X(p: P);
	case Y(q: Q);
}
def q0 = Q.new(5), q1 = Q.new(6);
def rp: Array<P> = [q0, q1, P.new(7), null];
def rq: Array<Q> = [q0, q1, null];
def vs = [
	T.X(rp[0]),
	T.X(rp[1]),
	T.X(rp[2]),
	T.X(rp[3]),
	T.Y(rq[0]),
	T.Y(rq[1]),
	T.Y(rq[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(rp[0]);
		1 => return T.X(rp[1]);
		2 => return T.X(rp[2]);
		3 => return T.X(rp[3]);
		4 => return T.Y(rq[0]);
		5 => return T.Y(rq[1]);
		_ => return T.Y(rq[2]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
