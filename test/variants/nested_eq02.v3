//@execute 0=true; 1=true; 2=false; 3=false; 4=false; 5=true; 6=true
type C {
	case None;
	case Val(x: int);
}
type B #unboxed {
	case None;
	case S(s: string);
	case Box(c: C);
	case I(x: int);
}
type A #unboxed {
	case None;
	case IsB(b: B);
	case Two(b1: B, b2: B);
}
def ss = ["s"];
def vals = [A.IsB(B.None), A.IsB(B.S(ss[0])), A.IsB(B.Box(C.Val(3))), A.IsB(B.I(7)), A.Two(B.None, B.I(7)), A.Two(B.I(7), B.None), A.Two(B.Box(C.None), B.S(ss[0]))];
def mk(a: int) -> A {
	match (a) {
		0 => return A.IsB(B.None);
		1 => return A.IsB(B.S(ss[0]));
		2 => return A.IsB(B.I(7));
		3 => return A.IsB(B.Box(C.Val(3)));
		4 => return A.Two(B.I(7), B.None);
		5 => return A.Two(B.I(7), B.None);
		_ => return A.Two(B.Box(C.None), B.S(ss[0]));
	}
}
def main(a: int) -> bool {
	var d = mk(a);
	return d == vals[a];
}
