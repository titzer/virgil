//@execute 0=-1719109786; 1=1432778632; 2=-481036337; 3=-309237645; 4=-1430532899; 5=287454020; 6=1075780517; 7=-1071382660
type T #unboxed {
	case L(val: u64);
	case D(val: double);
}

def ts = [T.L(0xAABBCCDD_99887766), T.L(0x11223344_55667788), T.D(7.777d), T.D(-9.999d)];

def main(a: int) -> int {
	var v = ts[a & 3];
	var low = (a & 4) == 0;
	var l: u64;
	match (v) {
		L(v) => l = u64.view(v);
		D(v) => l = u64.view(v);
	}
	return if(low, int.view(l), int.view(l >> 32));
}
