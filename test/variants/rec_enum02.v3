//@execute 0=1; 1=2; 2=12; 3=13; 4=-1
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xs = [X.None, X.IsY(Y.None), X.IsY(Y.IsX(X.None)), X.IsY(Y.IsX(X.IsY(Y.None)))];
def get(x: X) -> int {
	match (x) {
		None => return 1;
		IsY(y) => match (y) {
			None => return 2;
			IsX(x) => return 10 + get(x) + 1;
		}
	}
}
def main(a: int) -> int {
	if (a >= xs.length) return -1;
	return get(xs[a]);
}
