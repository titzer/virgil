//@execute 0=true; 1=true; 2=true; 3=true; 4=true
// ub_zeroeq00 over every position a signed zero can occupy in an unboxed variant.
type T #unboxed {
	case A(x: double);
	case B(x: double, y: double);
	case C(v: (double, float));
}
def POS: Array<T> = [T.A(0d), T.B(0d, 1d), T.B(1d, 0d), T.C((0d, 1f)), T.C((1d, 0f))];
def NEG: Array<T> = [T.A(-0d), T.B(-0d, 1d), T.B(1d, -0d), T.C((-0d, 1f)), T.C((1d, -0f))];
def main(a: int) -> bool {
	return POS[a] == NEG[a];
}
