//@execute 0=6373; 1=6374; 2=6375
// A large array mixing two reference cases and two non-reference cases, collected periodically.
class C(x: int) { }

type T #unboxed #packed {
	case A(s: string);
	case B(c: C);
	case D(x: u8);
	case E(y: u16);
	def get() -> int {
		match (this) {
			A(s) => return s.length;
			B(c) => return c.x;
			D(x) => return x;
			E(y) => return y;
		}
	}
}

def main(a: int) -> int {
	var arr = Array<T>.new(100);
	for (i < arr.length) {
		if ((i % 10) == 0) CiTest.forceGc();
		match (i % 4) {
			0 => arr[i] = T.A(Array<byte>.new(i % 7));
			1 => arr[i] = T.B(C.new(i));
			2 => arr[i] = T.D(u8.!(i));
			_ => arr[i] = T.E(u16.!(i * 3));
		}
	}
	CiTest.forceGc();
	var sum = 0;
	for (t in arr) sum += t.get();
	return sum + a;
}
