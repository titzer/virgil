//@execute 0=1; 1=1; 2=1; 3=1; 4=!TypeCheckException
type T #unboxed #packed {
	case R(s: string);
	case P(a: u16, b: i15);
}
def fa: Array<u16> = [0, 65535, 21845, 1];
def fb: Array<i15> = [0, -16384, 16383, -1];
def vs = [T.P(0, 0), T.P(65535, -16384), T.P(21845, 16383), T.P(1, -1), T.R("r")];
def main(a: int) -> int {
	var p = T.P.!(vs[a]), n = (a + 1) & 3, r = 0;
	if (p == T.P(fa[a], fb[a])) r |= 1;
	if (p.a != fa[a]) r |= 2;
	if (p.a == fa[n]) r |= 4;
	if (p == T.P(fa[n], fb[a])) r |= 8;
	if (p.b != fb[a]) r |= 16;
	if (p.b == fb[n]) r |= 32;
	if (p == T.P(fa[a], fb[n])) r |= 64;
	return r;
}
