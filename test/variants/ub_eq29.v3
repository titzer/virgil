//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48; 6=64; 7=128
// The three-case shape with both type parameters floating point.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
	case IsBoth(x: A, y: B);
}

def ts: Array<T<float, double>> = [
	T.IsBoth(0f, 0d),
	T.IsBoth(-0f, -0d),
	T.IsBoth(float.nan, 0d),
	T.IsBoth(0f, double.nan),
	T.IsBoth(float.view(0x00000001u), double.view(0x00000000_00000001uL)),
	T.IsBoth(float.view(0x00000001u), double.view(0x00000000_00000001uL)),
	T.IsA(0f),
	T.IsB(0d)
];

def cmp = T<float, double>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
