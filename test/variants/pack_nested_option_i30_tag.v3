//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33
type Opt<X> #unboxed {
	case None;
	case Some(x: X);
}
type T #unboxed #packed {
	case R(s: string);
	case O(o: Opt<i30>);
}
def rs: Array<string> = ["r", null];
def xs: Array<i30> = [0, -1, 536870911, -536870912, 357913941];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.O(Opt<i30>.None),
	T.O(Opt<i30>.Some(0)),
	T.O(Opt<i30>.Some(-1)),
	T.O(Opt<i30>.Some(536870911)),
	T.O(Opt<i30>.Some(-536870912)),
	T.O(Opt<i30>.Some(357913941))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.O(Opt<i30>.None);
		3 => return T.O(Opt<i30>.Some(xs[0]));
		4 => return T.O(Opt<i30>.Some(xs[1]));
		5 => return T.O(Opt<i30>.Some(xs[2]));
		6 => return T.O(Opt<i30>.Some(xs[3]));
		_ => return T.O(Opt<i30>.Some(xs[4]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.O.?(d)) r |= 32;
	return r;
}
