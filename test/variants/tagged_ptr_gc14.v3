//@execute 0=12; 1=16; 2=20
// Field-less cases mixed with reference cases across collections.
class C(x: int) { }

type T #unboxed #packed {
	case A(s: string);
	case N;
	case B(c: C);
	case M;
	def get() -> int {
		match (this) {
			A(s) => return s.length;
			N => return 1;
			B(c) => return c.x;
			M => return 2;
		}
	}
}

var roots = Array<T>.new(8);

def main(a: int) -> int {
	for (i < roots.length) roots[i] = T.N;
	for (i < roots.length) {
		CiTest.forceGc();
		match (i % 4) {
			0 => roots[i] = T.A(Array<byte>.new(a + 1));
			1 => roots[i] = T.N;
			2 => roots[i] = T.B(C.new(a + 2));
			_ => roots[i] = T.M;
		}
	}
	var sum = 0;
	for (r in roots) {
		CiTest.forceGc();
		sum += r.get();
	}
	return sum;
}
