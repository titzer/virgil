//@execute 0=false; 1=false
// A tagless unboxed variant whose dropped constant is a NaN inside a nested variant.
type Inner {
	case F(x: double);
	case N;
}
type T #unboxed {
	case W(nonce: int, i: Inner);
	case I(x: int);
}
def CACHE: Array<T> = [T.W(11, Inner.F(double.nan)), T.W(22, Inner.F(double.nan))];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
