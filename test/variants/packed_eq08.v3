//@execute 0=true; 1=false; 2=false; 3=true
// A nested unboxed data type flattened into a packed variant.
type P(a: u4, b: u4) #unboxed { }
type T #unboxed #packed {
	case A(p: P, c: u8);
	case B(w: u8);
}

def ts = [T.A(P(1, 2), 3), T.A(P(1, 2), 3), T.A(P(2, 2), 3), T.A(P(1, 3), 3), T.A(P(1, 2), 4)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[0] == ts[3];
		_ => return ts[0] != ts[4];
	}
}
