//@execute -1=false; 0=true; 1=false
type R(a: int, r: R) #unboxed;
type A0(x: int) #unboxed;
type A1(x: int, y: int) #unboxed;
type A2(x: int, y: int, z: int) #unboxed;
type A3(x: long) #unboxed;

def main(a: int) -> bool {
	var d: R;
	var v = R(a, d);
	var k = A0(a) == A0(a) && A1(a, a) == A1(a, a) && A2(a, a, a) == A2(a, a, a) && A3(a) == A3(a);
	return k && d == v;
}
