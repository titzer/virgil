//@execute 0=false; 1=false; 2=false
// boxed_naneq07/08/12 for double: the NaN is the second of two fields, then inside a
// tuple field, then beside an integer field.
type T {
	case A(x: double, y: double);
	case B(v: (double, double));
	case C(k: int, x: double);
}
def CACHE: Array<T> = [
	T.A(1d, double.nan),
	T.B((double.nan, 2d)),
	T.C(9, double.nan)
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
