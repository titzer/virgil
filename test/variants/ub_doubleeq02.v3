//@execute 0=1; 1=2; 2=4; 3=0
type T #unboxed {
	case L(v: u64);
	case F(v: double);
}

def ts = [T.L(33), T.L(0x33445566_88997766), T.F(33.333d), T.F(double.nan)];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
