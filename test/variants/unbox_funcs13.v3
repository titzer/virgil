//@execute 0=100; 1=-102; 2=9; 3=5
type F #unboxed {
	case S(f: i32 -> i32, k: i32);
	case U(k: u32, f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f, k) => return u32.view(f(i32.view(v)) + k);
			U(k, f) => return f(v) + k;
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

def fs = [
	F.S(id_s, 100),
	F.S(flip_s, -100),
	F.U(7, id_u),
	F.U(9, flip_u)
];

def main(a: u32) -> u32 {
	return fs[a & 3].apply(a);
}
