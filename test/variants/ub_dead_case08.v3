//@execute 0=10; 1=20; 2=30
// A parameterized unboxed variant whose last matched case is never allocated.
type Op<T> #unboxed {
	case A(x: T);
	case B(x: T, y: int);
	case D(r: Array<T>);
}
def visitD<T>(x: Op<T>.D) -> int { return x.r.length; }
def visit<T>(op: Op<T>, f: T -> int) -> int {
	match (op) {
		x: Op<T>.A => return f(x.x);
		x: Op<T>.B => return f(x.x) + x.y;
		x: Op<T>.D => return visitD(x);
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return visit(Op<int>.A(10), int.!<int>);
		1 => return visit(Op<byte>.B(15, 5), int.!<byte>);
		2 => return visit(Op<long>.A(30), int.view<long>);
	}
	return -1;
}
