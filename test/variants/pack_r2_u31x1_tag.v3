//@execute 0=16; 1=16; 2=16; 16=33; 17=33; 18=33; 32=66; 33=66; 34=66; 35=66; 36=66; 37=66; 38=66; 39=66; 40=66; 41=66; 42=66; 43=66; 44=66
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: u31);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xs: Array<u31> = [0, 1, 2, 2147483647, 2147483646, 1073741824, 1073741823, 1431655765, 715827882, 536870912, 1610612736, 19088743, 2023406814];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(2147483647), T.I0(2147483646), T.I0(1073741824), T.I0(1073741823), T.I0(1431655765), T.I0(715827882), T.I0(536870912), T.I0(1610612736), T.I0(19088743), T.I0(2023406814)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		_ => return T.I0(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r: int = d.tag;
	if (T.R0.?(d)) r |= 16;
	if (T.R1.?(d)) r |= 32;
	if (T.I0.?(d)) r |= 64;
	return r;
}
