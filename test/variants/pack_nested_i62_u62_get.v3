//@execute 0=1; 1=-1; 2=0; 3=1; 4=0; 5=-536870912; 6=-536870912; 7=1073741824; 8=-1; 9=-2; 10=1073741823; 11=-536870913; 12=536870911; 13=-1073741825
type P #unboxed #packed {
	case X(a: i62);
	case Y(b: u62);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i62> = [0, 1, -1, 2305843009213693951, -2305843009213693952, 1537228672809129301];
def xb: Array<u62> = [0, 1, 4611686018427387903, 2305843009213693952, 2305843009213693951, 1537228672809129301];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(2305843009213693951)),
	T.N0(P.X(-2305843009213693952)),
	T.N0(P.X(1537228672809129301)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(4611686018427387903)),
	T.N0(P.Y(2305843009213693952)),
	T.N0(P.Y(2305843009213693951)),
	T.N0(P.Y(1537228672809129301))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		_ => return T.N0(P.Y(xb[5]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N0(p) => match (p) {
			X(a) => return (int.view(a) ^ int.view(a >> 32)) + 0;
			Y(b) => return ~(int.view(b) ^ int.view(b >> 32)) + 0;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
