//@execute 0=2; 1=-1; 2=-1073741824; 3=0; 4=1073741823; 5=-1
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i63);
	case I1(x: i63);
}
def vs = [T.R("s1"), T.R(null), T.I0(-4611686018427387904), T.I0(-1), T.I1(4611686018427387903), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return (int.view(x) ^ int.view(x >> 32));
		I1(x) => return ~(int.view(x) ^ int.view(x >> 32));
	}
}
def main(a: int) -> int {
	var copy = Array<T>.new(vs.length);
	for (i < vs.length) copy[vs.length - 1 - i] = vs[i];
	return get(copy[vs.length - 1 - a]);
}
