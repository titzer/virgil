//@execute 0=-1; 1=1; 2=-3; 3=77
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f) => return u32.view(f(i32.view(v)));
			U(f) => return f(v);
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

type G #unboxed {
	case One(f: F);
	case Two(f: F, g: F);
	case K(v: u32);

	def apply(v: u32) -> u32 {
		match (this) {
			One(f) => return f.apply(v);
			Two(f, g) => return g.apply(f.apply(v));
			K(k) => return k;
		}
	}
}

def gs = [
	G.One(F.S(flip_s)),
	G.Two(F.S(flip_s), F.U(flip_u)),
	G.Two(F.U(id_u), F.S(flip_s)),
	G.K(77)
];

def main(a: u32) -> u32 {
	return gs[a & 3].apply(a);
}
