//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=96; 6=96
// A polymorphic data type whose type parameter is a tuple of a float and a double.
type Pair<X>(x: X, y: X) { }

def ts = [
	Pair((0f, 0d), (0f, 0d)),
	Pair((-0f, -0d), (0f, 0d)),
	Pair((0f, 0d), (-0f, -0d)),
	Pair((1f, 1d), (1f, double.nan)),
	Pair((float.nan, 1d), (1f, 1d)),
	Pair((1f, 2d), (3f, 4d)),
	Pair((1f, 2d), (3f, 4d))
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
