//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512
type T #unboxed #packed {
	case R(s: string);
	case P0(a: bool, b: bool, c: i29);
}
def rs: Array<string> = ["r", null];
def f0a = [false, true, false, false, false, true, false, true];
def f0b = [false, false, true, false, false, true, true, false];
def f0c: Array<i29> = [0, 0, 0, -268435456, 268435455, 268435455, -178956971, 178956970];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(false, false, 0),
	T.P0(true, false, 0),
	T.P0(false, true, 0),
	T.P0(false, false, -268435456),
	T.P0(false, false, 268435455),
	T.P0(true, true, 268435455),
	T.P0(false, true, -178956971),
	T.P0(true, false, 178956970)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0], f0c[0]);
		3 => return T.P0(f0a[1], f0b[1], f0c[1]);
		4 => return T.P0(f0a[2], f0b[2], f0c[2]);
		5 => return T.P0(f0a[3], f0b[3], f0c[3]);
		6 => return T.P0(f0a[4], f0b[4], f0c[4]);
		7 => return T.P0(f0a[5], f0b[5], f0c[5]);
		8 => return T.P0(f0a[6], f0b[6], f0c[6]);
		_ => return T.P0(f0a[7], f0b[7], f0c[7]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
