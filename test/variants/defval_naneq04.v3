//@execute 0=3; 1=3; 2=0; 3=0
// A nested default: the default of `Outer` contains the default of `Inner`, so the
// zero comparison has to recurse through both levels.
type Inner {
	case F(x: double);
	case N;
}
type Outer {
	case W(i: Inner, y: double);
	case N;
}
def D: Outer;
def CACHE: Array<Outer> = [
	Outer.W(Inner.F(0d), 0d),
	Outer.W(Inner.F(-0d), -0d),
	Outer.W(Inner.F(double.nan), 0d),
	Outer.W(Inner.F(0d), double.nan)
];
def main(a: int) -> int {
	var l = D, r = CACHE[a];
	return if(l == r, 1) | if(r == l, 2);
}
