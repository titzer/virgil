//@execute 0=16; 1=16; 2=16; 3=33; 4=33; 5=66; 6=66; 7=66; 8=66
type B {
	case X;
	case Y;
	case Z;
}
type T #unboxed #packed {
	case R(b: B);
	case S(s: string);
	case I(x: i29);
}
def rb = [B.X, B.Y, B.Z];
def rs: Array<string> = ["s", null];
def xs: Array<i29> = [0, -1, 268435455, -268435456];
def vs = [
	T.R(rb[0]),
	T.R(rb[1]),
	T.R(rb[2]),
	T.S(rs[0]),
	T.S(rs[1]),
	T.I(0),
	T.I(-1),
	T.I(268435455),
	T.I(-268435456)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rb[0]);
		1 => return T.R(rb[1]);
		2 => return T.R(rb[2]);
		3 => return T.S(rs[0]);
		4 => return T.S(rs[1]);
		5 => return T.I(xs[0]);
		6 => return T.I(xs[1]);
		7 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.S.?(d)) r |= 32;
	if (T.I.?(d)) r |= 64;
	return r;
}
