//@execute 0=5; 1=0; 2=0; 3=-7; 4=103; 5=1803; 6=-1; 7=0; 8=-1; 9=1073741823; 10=-1073741824
type B {
	case X(a: int);
	case Y(s: string);
}
type T #unboxed #packed {
	case R(b: B);
	case I(x: i31);
}
def ks = [5, 0, -7];
def ss = ["hey", "you"];
def db = Array<B>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.R(B.X(5)),
	T.R(B.X(0)),
	T.R(db[0]),
	T.R(B.X(-7)),
	T.R(B.Y(ss[0])),
	T.R(B.Y(ss[1])),
	T.R(B.Y(null)),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(B.X(ks[0]));
		1 => return T.R(B.X(ks[1]));
		2 => return T.R(db[0]);
		3 => return T.R(B.X(ks[2]));
		4 => return T.R(B.Y(ss[0]));
		5 => return T.R(B.Y(ss[1]));
		6 => return T.R(B.Y(null));
		7 => return T.I(xs[0]);
		8 => return T.I(xs[1]);
		9 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(b) => match (b) {
			X(a) => return a;
			Y(s) => return if(s == null, -1, s.length + 100 * (s[0] - 'g'));
		}
		I(x) => return x;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
