//@execute =true
type A {
	case None;
	case IsB(v: B);
}
type B {
	case None;
	case IsC(v: C);
}
type C {
	case None;
	case IsD(v: D);
}
type D {
	case None;
	case IsA(v: A);
}
def an = A.None, bn = B.None, cn = C.None, dn = D.None;
def ab = A.IsB(bn), bc = B.IsC(cn), cd = C.IsD(dn), da = D.IsA(an);
def main() -> bool {
	return da == D.IsA(an) && cd == C.IsD(dn) && bc == B.IsC(cn) && ab == A.IsB(bn) && !(an == ab);
}
