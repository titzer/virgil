//@execute 0=true; 1=false; 2=true; 3=false; 4=true
type C {
	case None;
	case Val(x: int);
}
type B #unboxed {
	case None;
	case Box(c: C);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def bn = B.None;
def ab = A.IsB(bn), ac = A.IsB(B.Box(C.Val(3)));
def main(a: int) -> bool {
	match (a) {
		0 => return ab == A.IsB(B.None);
		1 => return ab == ac;
		2 => return ac == A.IsB(B.Box(C.Val(3)));
		3 => return ac == A.IsB(B.Box(C.Val(4)));
		_ => return A.IsB(B.Box(C.None)) == A.IsB(B.Box(C.None));
	}
}
