//@execute 0=3; 1=3; 2=12; 3=12; 4=0; 5=0; 6=64; 7=128
// A tuple of doubles as a case field.
type T #unboxed {
	case P(v: (double, double));
	case Q(v: (int, double));
	case N;
}

def ts = [
	T.P((0d, 0d)),
	T.P((-0d, -0d)),
	T.P((double.infinity, 1d)),
	T.P((double.infinity, 1d)),
	T.P((double.nan, double.nan)),
	T.P((1d, double.nan)),
	T.Q((7, 8d)),
	T.N
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
