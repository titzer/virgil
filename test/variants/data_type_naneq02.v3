//@execute 0=false; 1=false
// The same cached data type reached through two array slots.
type D(v: (float, double)) { }
def CACHE: Array<D> = [D((float.nan, 1d)), D((1f, double.nan))];
def main(a: int) -> bool {
	var v = CACHE[a];
	var arr = Array<D>.new(2);
	arr[0] = v;
	arr[1] = v;
	return arr[0] == arr[1];
}
