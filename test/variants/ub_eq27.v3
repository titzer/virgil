//@execute 0=1; 1=6; 2=6; 3=8; 4=16; 5=32; 6=64; 7=128
// ub_eq17 over the values where a bitwise comparison and an IEEE one disagree.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<int, float>> = [
	T.IsA(0),
	T.IsB(0f),
	T.IsB(-0f),
	T.IsB(float.view(0x00000001u)),		// smallest positive subnormal
	T.IsB(float.view(0x80000001u)),		// smallest negative subnormal
	T.IsB(float.view(0x007FFFFFu)),		// largest subnormal
	T.IsA(1),
	T.IsB(1f)
];

def cmp = T<int, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
