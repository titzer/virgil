//@execute 0=0; 1=-2; 2=2; 3=-4; 4=4; 5=-6; 6=6; 7=-8
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def asU() -> u32 -> u32 {
		match (this) {
			S(f) => return conv(f, _);
			U(f) => return f;
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

def conv(f: i32 -> i32, v: u32) -> u32 {
	return u32.view(f(i32.view(v)));
}

def fs = [
	F.S(id_s),
	F.S(flip_s),
	F.U(id_u),
	F.U(flip_u)
];

def main(a: u32) -> u32 {
	return fs[a & 3].asU()(a);
}
