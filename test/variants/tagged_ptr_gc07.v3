//@execute 0=7; 1=8; 2=9; 3=10
// A chain of objects each holding a tagged variant that references the next object.
class Box(t: T) { }

type T #unboxed #packed {
	case Leaf(x: u8);
	case Ref(b: Box);
}

def depth(t: T) -> int {
	match (t) {
		Leaf(x) => return x;
		Ref(b) => return 1 + depth(b.t);
	}
}

def main(a: int) -> int {
	var t: T = T.Leaf(7);
	for (i < a) {
		CiTest.forceGc();
		t = T.Ref(Box.new(t));
	}
	CiTest.forceGc();
	return depth(t);
}
