//@execute 0=16; 1=16; 2=16; 3=33; 4=33; 5=33
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case X(a: A);
	case Y(b: B);
}
def ra: Array<A> = [A.new(11), A.new(12), null];
def rb: Array<B> = [B.new(21), B.new(22), null];
def vs = [
	T.X(ra[0]),
	T.X(ra[1]),
	T.X(ra[2]),
	T.Y(rb[0]),
	T.Y(rb[1]),
	T.Y(rb[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(ra[0]);
		1 => return T.X(ra[1]);
		2 => return T.X(ra[2]);
		3 => return T.Y(rb[0]);
		4 => return T.Y(rb[1]);
		_ => return T.Y(rb[2]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.X.?(d)) r |= 16;
	if (T.Y.?(d)) r |= 32;
	return r;
}
