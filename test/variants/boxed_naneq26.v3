//@execute 0=false; 1=false
// boxed_naneq17 for double: the cached value is reached through a class field
// rather than an array, so the two loads cannot be CSE'd into one.
type T {
	case D(x: double);
	case L(x: long);
}
class Box(v: T) { }
def BOXES: Array<Box> = [Box.new(T.D(double.nan)), Box.new(T.D(double.nan))];
def main(a: int) -> bool {
	var b = BOXES[a];
	return b.v == b.v;
}
