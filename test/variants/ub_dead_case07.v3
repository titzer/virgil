//@execute 0=!TypeCheckException; 1=!TypeCheckException
// Casting to a never-allocated case of an unboxed variant throws.
type Op #unboxed {
	case A(x: int);
	case B(x: long, y: int);
	case D(y: long);
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A(1);
		_ => return Op.B(2, 3);
	}
}
def main(a: int) -> int {
	return int.view(Op.D.!(make(a)).y);
}
