//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024
enum E { E0, E1, E2 }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E, x: i61);
}
def rs: Array<string> = ["r", null];
def es = [E.E0, E.E1, E.E2];
def xs: Array<i61> = [0, 1, -1, 1152921504606846975, -1152921504606846976, 384307168202282325, -384307168202282326, 1152921504606846975, 0];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.E0, 0),
	T.X(E.E1, 1),
	T.X(E.E2, -1),
	T.X(E.E0, 1152921504606846975),
	T.X(E.E1, -1152921504606846976),
	T.X(E.E2, 384307168202282325),
	T.X(E.E0, -384307168202282326),
	T.X(E.E2, 1152921504606846975),
	T.X(E.E2, 0)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0], xs[0]);
		3 => return T.X(es[1], xs[1]);
		4 => return T.X(es[2], xs[2]);
		5 => return T.X(es[0], xs[3]);
		6 => return T.X(es[1], xs[4]);
		7 => return T.X(es[2], xs[5]);
		8 => return T.X(es[0], xs[6]);
		9 => return T.X(es[2], xs[7]);
		_ => return T.X(es[2], xs[8]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
