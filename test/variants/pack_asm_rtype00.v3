//@execute 0=19546144; 1=606336; 2=65011720; 3=67108863; 4=-1
enum Reg { R0, R1, R2, R3, R4, R5, R6, R7, R8, R9, R10, R11, R12, R13, R14, R15, R16, R17, R18, R19, R20, R21, R22, R23, R24, R25, R26, R27, R28, R29, R30, R31 }
def rtype(rs: Reg, rt: Reg, rd: Reg, sa: u5, funct: u6) -> int {
	return int.pack<(u6, Reg, Reg, Reg, u5, u6)>((0, rs, rt, rd, sa, funct));
}
def main(a: int) -> int {
	match (a) {
		0 => return rtype(Reg.R9, Reg.R10, Reg.R8, 0, 0x20);   // add $t0, $t1, $t2
		1 => return rtype(Reg.R0, Reg.R9, Reg.R8, 2, 0);       // sll $t0, $t1, 2
		2 => return rtype(Reg.R31, Reg.R0, Reg.R0, 0, 8);      // jr $ra
		3 => return rtype(Reg.R31, Reg.R31, Reg.R31, 31, 63);  // all fields saturated
		_ => return -1;
	}
}
