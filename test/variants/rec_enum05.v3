//@execute 0=1; 1=0; 2=1; 3=0; 4=7; 5=-7
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X, v: int);
}
def xs = [X.None, X.IsY(Y.None), X.IsY(Y.IsX(X.None, 7)), X.IsY(Y.IsX(X.None, -7))];
def val(x: X) -> int {
	match (x) {
		None => return 0;
		IsY(y) => match (y) {
			None => return 0;
			IsX(x, v) => return v;
		}
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return if(xs[0] == X.None, 1, 0);
		1 => return if(xs[1] == xs[0], 1, 0);
		2 => return if(xs[2] == X.IsY(Y.IsX(X.None, 7)), 1, 0);
		3 => return if(xs[2] == xs[3], 1, 0);
		4 => return val(xs[2]);
		_ => return val(xs[3]);
	}
}
