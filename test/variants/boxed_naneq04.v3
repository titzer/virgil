//@execute 0=false; 1=false
// The same object passed as both arguments of a comparison helper.
type T {
	case F(x: float);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(float.nan), T.F(float.nan)];
def eq(a: T, b: T) -> bool {
	return a == b;
}
def main(a: int) -> bool {
	var v = CACHE[a];
	return eq(v, v);
}
