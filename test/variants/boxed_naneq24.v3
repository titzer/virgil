//@execute 0=false; 1=false
// boxed_naneq00c for a double payload: only `T.F` is live and its payload is a
// single constant NaN, so the live-field set reduces to the nonce.
type T {
	case F(nonce: int, x: double);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(11, double.nan), T.F(22, double.nan)];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
