//@execute 0=11; 1=11
// Pins folded and runtime comparisons of the same cached object against each other.
type T {
	case F(x: float);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(float.nan), T.F(float.nan)];
def main(a: int) -> int {
	var v = CACHE[a];
	var live = if(v != v, 1, 0);				// same object, runtime
	var folded = if(T.F(float.nan) != T.F(float.nan), 1, 0);	// constants
	return live * 10 + folded;				// 11 or 00, never 10
}
