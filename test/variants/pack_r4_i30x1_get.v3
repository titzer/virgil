//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=41; 10=42; 11=-4; 12=0; 13=1; 14=-1; 15=536870911; 16=-536870912; 17=536870910; 18=-536870911; 19=357913941; 20=-357913942; 21=268435456; 22=-268435456; 23=19088743; 24=-124076833
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: i30);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<i30> = [0, 1, -1, 536870911, -536870912, 536870910, -536870911, 357913941, -357913942, 268435456, -268435456, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(536870911), T.I0(-536870912), T.I0(536870910), T.I0(-536870911), T.I0(357913941), T.I0(-357913942), T.I0(268435456), T.I0(-268435456), T.I0(19088743), T.I0(-124076833)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		I0(x) => return int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
