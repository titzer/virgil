//@execute 0=0; 1=2; 2=4; 3=0
// ub_enumeq00's full matrix: the two NaN cases match nothing, including themselves
// and each other, while the payload-free cases behave like enum members.
type T #unboxed {
	case F(x: double);
	case E(y: float);
	case G;
	case H;
}
def ts: Array<T> = [T.F(double.nan), T.G, T.H, T.E(float.nan)];
def main(i: int) -> int {
	var l = ts[i];
	var out = 0;
	for (j < ts.length) {
		if (l == ts[j]) out |= (1 << u5.view(j));
	}
	return out;
}
