//@execute 0=16; 1=16; 2=33; 3=33; 4=66; 5=66; 6=131; 7=131; 8=131; 9=131; 10=131; 11=131; 12=131
class C0(v: int) { }
class C1(v: int) { }
class C2(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case R2(x: C2);
	case I0(x: u31);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def r2: Array<C2> = [C2.new(12), null];
def xs: Array<u31> = [0, 1, 2147483647, 1073741824, 1073741823, 1431655765, 715827882];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.R2(r2[0]),
	T.R2(r2[1]),
	T.I0(0),
	T.I0(1),
	T.I0(2147483647),
	T.I0(1073741824),
	T.I0(1073741823),
	T.I0(1431655765),
	T.I0(715827882)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.R2(r2[0]);
		5 => return T.R2(r2[1]);
		6 => return T.I0(xs[0]);
		7 => return T.I0(xs[1]);
		8 => return T.I0(xs[2]);
		9 => return T.I0(xs[3]);
		10 => return T.I0(xs[4]);
		11 => return T.I0(xs[5]);
		_ => return T.I0(xs[6]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R0.?(d)) r |= 16;
	if (T.R1.?(d)) r |= 32;
	if (T.R2.?(d)) r |= 64;
	if (T.I0.?(d)) r |= 128;
	return r;
}
