//@execute 0=-2147483648; 1=-2147483648
// mzero_field00 with the store happening at run time into a freshly allocated array.
type T {
	case F(x: double);
	case I(y: int);
}
def main(a: int) -> int {
	var arr = Array<T>.new(2);
	arr[a] = T.F(-0d);
	match (arr[a]) {
		F(x) => return int.view(u64.view(x) >> 32);
		I(y) => return -1;
	}
}
