//@execute 0=true; 1=true; 2=false; 3=true; 4=false; 5=true; 6=false
type C {
	case None;
	case Val(x: int);
}
type P #unboxed #packed {
	case S(s: string);
	case Q(c: C);
	case I(x: i30);
}
type T #unboxed {
	case None;
	case IsP(p: P);
}
def ss = ["s", "t"];
def xs = [1, 2];
def is: Array<i30> = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
def cs = [C.Val(1), C.Val(2), C.None];
def main(a: int) -> bool {
	match (a) {
		0 => return T.IsP(P.Q(mkC(0))) == T.IsP(P.Q(cs[0]));
		1 => return T.IsP(P.Q(mkC(2))) == T.IsP(P.Q(cs[2]));
		2 => return T.IsP(P.Q(mkC(1))) == T.IsP(P.Q(cs[0]));
		3 => return T.IsP(P.S(ss[0])) == T.IsP(P.S(ss[0]));
		4 => return T.IsP(P.S(ss[0])) == T.IsP(P.I(is[0]));
		5 => return T.IsP(P.I(is[1])) == T.IsP(P.I(2));
		_ => return T.IsP(P.Q(mkC(0))) == T.None;
	}
}
