//@execute 0=2097152; 1=6299648; 2=10502144; 3=14704640; 4=2129920; 5=6332416; 6=10534912; 7=14737408
enum RegShift { LSL, LSR, ASR, NONE }
enum DataRegExtend { UXTB, UXTH, UXTW, UXTX, SXTB, SXTH, SXTW, SXTX }
def SHIFTS = [RegShift.LSL, RegShift.LSR, RegShift.ASR, RegShift.NONE];
def EXTENDS = [DataRegExtend.UXTB, DataRegExtend.UXTH, DataRegExtend.UXTW, DataRegExtend.UXTX,
	DataRegExtend.SXTB, DataRegExtend.SXTH, DataRegExtend.SXTW, DataRegExtend.SXTX];
def shifted(code: u8, sh: RegShift, rm: u5, imm: u6, rn: u5, rd: u5) -> int {
	return int.pack<(u8, RegShift, u1, u5, u6, u5, u5)>((code, sh, 0, rm, imm, rn, rd));
}
def extended(code: u8, ex: DataRegExtend, rm: u5, imm: u3, rn: u5, rd: u5) -> int {
	return int.pack<(u8, u2, u1, u5, DataRegExtend, u3, u5, u5)>((code, 0, 1, rm, ex, imm, rn, rd));
}
def main(a: int) -> int {
	var sh = SHIFTS[a & 3], ex = EXTENDS[a & 7];
	// also check that the enum round-trips through unpack
	if (int.unpack<(u8, RegShift, u1, u5, u6, u5, u5)>(shifted(0x8B, sh, 7, u6.view(a), 1, 2)).1 != sh) return -1;
	if (int.unpack<(u8, u2, u1, u5, DataRegExtend, u3, u5, u5)>(extended(0x8B, ex, 7, u3.view(a), 1, 2)).4 != ex) return -2;
	return shifted(0x8B, sh, 7, u6.view(a), 1, 2) ^ extended(0x8B, ex, 7, u3.view(a), 1, 2);
}
