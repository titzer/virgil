//@execute 0=16; 1=16; 2=33; 3=33; 4=66; 5=66; 6=131; 7=131; 8=131; 9=131
class G<X>(v: X) { }
type T #unboxed #packed {
	case GI(g: G<int>);
	case GZ(g: G<bool>);
	case GS(g: G<string>);
	case I(x: i31);
}
def ri: Array<G<int>> = [G<int>.new(44), null];
def rz: Array<G<bool>> = [G<bool>.new(true), null];
def rs: Array<G<string>> = [G<string>.new("xyz"), null];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.GI(ri[0]),
	T.GI(ri[1]),
	T.GZ(rz[0]),
	T.GZ(rz[1]),
	T.GS(rs[0]),
	T.GS(rs[1]),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.GI(ri[0]);
		1 => return T.GI(ri[1]);
		2 => return T.GZ(rz[0]);
		3 => return T.GZ(rz[1]);
		4 => return T.GS(rs[0]);
		5 => return T.GS(rs[1]);
		6 => return T.I(xs[0]);
		7 => return T.I(xs[1]);
		8 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.GI.?(d)) r |= 16;
	if (T.GZ.?(d)) r |= 32;
	if (T.GS.?(d)) r |= 64;
	if (T.I.?(d)) r |= 128;
	return r;
}
