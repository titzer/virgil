//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=0; 6=192; 7=192
// poly_floateq00 for double: the full matrix for a polymorphic data type.
type Pair<X>(x: X, y: X) { }

def ts = [
	Pair(0d, 0d),
	Pair(-0d, 0d),
	Pair(0d, -0d),
	Pair(1d, double.nan),
	Pair(double.nan, 1d),
	Pair(double.nan, double.nan),
	Pair(1d, 2d),
	Pair(1d, 2d)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
