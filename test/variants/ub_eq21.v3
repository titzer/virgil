//@execute 0=3; 1=3; 2=0; 3=8; 4=48; 5=48; 6=0; 7=128
// Both type parameters are floating point.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<float, double>> = [
	T.IsA(0f),
	T.IsA(-0f),
	T.IsA(float.nan),
	T.IsA(float.view(0x00000001u)),
	T.IsB(0d),
	T.IsB(-0d),
	T.IsB(double.nan),
	T.IsB(double.view(0x00000000_00000001uL))
];

def cmp = T<float, double>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
