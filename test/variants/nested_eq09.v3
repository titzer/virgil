//@execute 0=true; 1=true; 2=false; 3=true; 4=false; 5=true
type C {
	case None;
	case Val(x: int);
}
type B #unboxed {
	case None;
	case Box(c: C);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def cs = [C.Val(1), C.Val(2), C.None];
def mkB(i: int) -> B { return if(i == 0, B.None, B.Box(cs[i - 1])); }
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(mkB(0)) == A.IsB(mkB(0));
		1 => return A.IsB(mkB(1)) == A.IsB(mkB(1));
		2 => return A.IsB(mkB(1)) == A.IsB(mkB(3));
		3 => return A.IsB(mkB(1)) == A.IsB(B.Box(C.Val(1)));
		4 => return A.IsB(mkB(0)) == A.IsB(mkB(1));
		_ => return A.IsB(mkB(3)) == A.IsB(B.Box(cs[2]));
	}
}
