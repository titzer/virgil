//@execute 0=16; 1=16; 2=16; 3=16; 4=33; 5=33; 6=33; 7=33
type W(s: string, n: int) { }
type T #unboxed #packed {
	case R(w: W);
	case I(x: i31);
}
def ss: Array<string> = ["ww", null];
def ks = [4, 0];
def dw = Array<W>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.R(W(ss[0], 4)),
	T.R(W(null, 4)),
	T.R(W(null, 0)),
	T.R(dw[0]),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(W(ss[0], ks[0]));
		1 => return T.R(W(ss[1], ks[0]));
		2 => return T.R(W(ss[1], ks[1]));
		3 => return T.R(dw[0]);
		4 => return T.I(xs[0]);
		5 => return T.I(xs[1]);
		6 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.I.?(d)) r |= 32;
	return r;
}
