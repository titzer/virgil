//@execute 0=true; 1=true; 2=true; 3=true; 4=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type D #unboxed {
	case None;
	case Box(c: C);
}
type B #unboxed {
	case None;
	case IsD(d: D);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def c1 = cs[0];
def vals = [A.IsB(B.None), A.IsB(B.IsD(D.None)), A.IsB(B.IsD(D.Box(c1))), A.None, A.IsB(B.IsD(D.Box(cs[1]))), A.IsB(B.IsD(D.Box(cs[2])))];
def mk(a: int) -> A {
	match (a) {
		0 => return A.IsB(B.None);
		1 => return A.IsB(B.IsD(D.None));
		2 => return A.IsB(B.IsD(D.Box(c1)));
		3 => return A.IsB(B.IsD(D.Box(cs[0])));
		_ => return A.IsB(B.IsD(D.Box(cs[2])));
	}
}
def main(a: int) -> bool {
	return mk(a) == vals[if(a < 3, a, if(a == 3, 2, 0))];
}
