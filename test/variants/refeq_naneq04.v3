//@execute 0=true; 1=true; 2=false; 3=true
// refeq_naneq00 for an unboxed variant: the array reference and the double land in
// different scalars, and only the double one is non-reflexive.
type T #unboxed {
	case A(a: Array<double>);
	case B(x: double);
	case N;
}
def NANS: Array<double> = [double.nan, double.nan];
def ONES: Array<double> = [1d, 1d];
def CACHE: Array<T> = [T.A(NANS), T.A(ONES), T.B(double.nan), T.N];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
