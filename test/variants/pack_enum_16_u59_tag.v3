//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33; 11=33
enum E { E0, E1, E2, E3, E4, E5, E6, E7, E8, E9, E10, E11, E12, E13, E14, E15 }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E, x: u59);
}
def rs: Array<string> = ["r", null];
def es = [E.E0, E.E1, E.E2, E.E3, E.E4, E.E5, E.E6, E.E7, E.E8, E.E9, E.E10, E.E11, E.E12, E.E13, E.E14, E.E15];
def xs: Array<u59> = [0, 1, 576460752303423487, 288230376151711744, 288230376151711743, 384307168202282325, 192153584101141162, 288230376151711744, 0, 288230376151711744];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.E0, 0),
	T.X(E.E1, 1),
	T.X(E.E2, 576460752303423487),
	T.X(E.E3, 288230376151711744),
	T.X(E.E4, 288230376151711743),
	T.X(E.E5, 384307168202282325),
	T.X(E.E6, 192153584101141162),
	T.X(E.E15, 288230376151711744),
	T.X(E.E15, 0),
	T.X(E.E0, 288230376151711744)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0], xs[0]);
		3 => return T.X(es[1], xs[1]);
		4 => return T.X(es[2], xs[2]);
		5 => return T.X(es[3], xs[3]);
		6 => return T.X(es[4], xs[4]);
		7 => return T.X(es[5], xs[5]);
		8 => return T.X(es[6], xs[6]);
		9 => return T.X(es[15], xs[7]);
		10 => return T.X(es[15], xs[8]);
		_ => return T.X(es[0], xs[9]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.X.?(d)) r |= 32;
	return r;
}
