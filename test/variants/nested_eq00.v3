//@execute 0=true; 1=true; 2=false; 3=true; 4=false; 5=true
class C(v: int) { }
type B #unboxed {
	case None;
	case Ref(c: C);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def c1 = C.new(1);
def an = A.None, bn = B.None;
def ab = A.IsB(bn), ac = A.IsB(B.Ref(c1));
def main(a: int) -> bool {
	match (a) {
		0 => return ab == A.IsB(B.None);
		1 => return ab == A.IsB(bn);
		2 => return ab == ac;
		3 => return ac == A.IsB(B.Ref(c1));
		4 => return ac == A.IsB(B.Ref(C.new(1)));
		_ => return an != ab;
	}
}
