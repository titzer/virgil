//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512
type T #unboxed #packed {
	case I(x: Array<int>);
	case L(x: Array<long>);
	case B(x: Array<byte>);
	case S(x: Array<string>);
	case Z(x: Array<bool>);
}
def ri: Array<Array<int>> = [[7], null];
def rl: Array<Array<long>> = [[8L], null];
def rb: Array<Array<byte>> = ["c", null];
def rs: Array<Array<string>> = [["dd"], null];
def rz: Array<Array<bool>> = [[true], null];
def vs = [
	T.I(ri[0]),
	T.I(ri[1]),
	T.L(rl[0]),
	T.L(rl[1]),
	T.B(rb[0]),
	T.B(rb[1]),
	T.S(rs[0]),
	T.S(rs[1]),
	T.Z(rz[0]),
	T.Z(rz[1])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.I(ri[0]);
		1 => return T.I(ri[1]);
		2 => return T.L(rl[0]);
		3 => return T.L(rl[1]);
		4 => return T.B(rb[0]);
		5 => return T.B(rb[1]);
		6 => return T.S(rs[0]);
		7 => return T.S(rs[1]);
		8 => return T.Z(rz[0]);
		_ => return T.Z(rz[1]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
