//@execute 0=3; 1=3; 2=4; 3=8; 4=0; 5=32; 6=64; 7=0
// The full matrix for an unboxed polymorphic variant at double.
type UOpt<X> #unboxed {
	case Some(v: X);
	case None;
}

def ts: Array<UOpt<double>> = [
	UOpt<double>.Some(0d),
	UOpt<double>.Some(-0d),
	UOpt<double>.Some(double.infinity),
	UOpt<double>.Some(-double.infinity),
	UOpt<double>.Some(double.nan),
	UOpt<double>.Some(1d),
	UOpt<double>.None,
	UOpt<double>.Some(double.view(0xFFF80000_00000000uL))
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
