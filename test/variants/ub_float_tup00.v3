//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=32; 6=64; 7=128
// A tuple of floats as a case field.
type T #unboxed {
	case P(v: (float, float));
	case Q(v: (int, float));
	case N;
}

def ts = [
	T.P((0f, 0f)),
	T.P((-0f, 0f)),
	T.P((0f, -0f)),
	T.P((1f, float.nan)),
	T.P((float.nan, 1f)),
	T.P((1f, 2f)),
	T.Q((1, 2f)),
	T.N
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
