//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=66; 10=66; 11=66; 12=66; 13=66; 14=66; 15=66
type T #unboxed #packed {
	case R(s: string);
	case P0(a: u15, b: i15);
	case P1(a: i15, b: u15);
}
def rs: Array<string> = ["r", null];
def f0a: Array<u15> = [0, 32767, 0, 0, 32767, 21845, 10922];
def f0b: Array<i15> = [0, 0, -16384, 16383, 16383, 10922, -10923];
def f1a: Array<i15> = [0, -16384, 16383, 0, 16383, -10923, 10922];
def f1b: Array<u15> = [0, 0, 0, 32767, 32767, 10922, 21845];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0),
	T.P0(32767, 0),
	T.P0(0, -16384),
	T.P0(0, 16383),
	T.P0(32767, 16383),
	T.P0(21845, 10922),
	T.P0(10922, -10923),
	T.P1(0, 0),
	T.P1(-16384, 0),
	T.P1(16383, 0),
	T.P1(0, 32767),
	T.P1(16383, 32767),
	T.P1(-10923, 10922),
	T.P1(10922, 21845)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0]);
		3 => return T.P0(f0a[1], f0b[1]);
		4 => return T.P0(f0a[2], f0b[2]);
		5 => return T.P0(f0a[3], f0b[3]);
		6 => return T.P0(f0a[4], f0b[4]);
		7 => return T.P0(f0a[5], f0b[5]);
		8 => return T.P0(f0a[6], f0b[6]);
		9 => return T.P1(f1a[0], f1b[0]);
		10 => return T.P1(f1a[1], f1b[1]);
		11 => return T.P1(f1a[2], f1b[2]);
		12 => return T.P1(f1a[3], f1b[3]);
		13 => return T.P1(f1a[4], f1b[4]);
		14 => return T.P1(f1a[5], f1b[5]);
		_ => return T.P1(f1a[6], f1b[6]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.P0.?(d)) r |= 32;
	if (T.P1.?(d)) r |= 64;
	return r;
}
