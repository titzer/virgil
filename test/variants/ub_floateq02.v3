//@execute 0=1; 1=2; 2=12; 3=12; 4=0; 5=32; 6=64; 7=0
// Float and double cases in one unboxed variant, over values where IEEE and bitwise differ.
type T #unboxed {
	case I(v: int);
	case F(v: float);
	case D(v: double);
}

def ts = [
	T.I(0), T.I(-1),
	T.F(0f), T.F(-0f), T.F(float.nan), T.F(1.5f),
	T.D(0d), T.D(double.nan)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
