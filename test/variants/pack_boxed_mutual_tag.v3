//@execute 0=16; 1=16; 2=16; 3=16; 4=33; 5=33; 6=33; 7=33
type N {
	case Leaf(t: T);
	case Node(l: N, r: N);
}
type T #unboxed #packed {
	case I(x: i31);
	case Sub(n: N);
}
def dn = Array<N>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824),
	T.Sub(dn[0]),
	T.Sub(N.Leaf(T.I(0))),
	T.Sub(N.Leaf(T.I(-1))),
	T.Sub(N.Node(N.Leaf(T.I(-1)), N.Leaf(T.Sub(N.Leaf(T.I(1073741823))))))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.I(xs[0]);
		1 => return T.I(xs[1]);
		2 => return T.I(xs[2]);
		3 => return T.I(xs[3]);
		4 => return T.Sub(dn[0]);
		5 => return T.Sub(N.Leaf(T.I(xs[0])));
		6 => return T.Sub(N.Leaf(T.I(xs[1])));
		_ => return T.Sub(N.Node(N.Leaf(T.I(xs[1])), N.Leaf(T.Sub(N.Leaf(T.I(xs[2]))))));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.I.?(d)) r |= 16;
	if (T.Sub.?(d)) r |= 32;
	return r;
}
