//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 19=6; 20=7; 21=8; 22=9; 23=10; 24=11; 25=12; 26=13; 27=14; 28=15; 32=16; 33=17; 34=18; 35=19; 36=20; 37=21; 38=22; 39=23; 40=24; 41=25; 42=26; 43=27; 44=28; 48=29; 49=30; 50=31; 51=32; 52=33; 53=34; 54=35; 55=36; 56=37; 57=38; 58=39; 59=40; 60=41
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: i60);
	case I1(x: i60);
	case I2(x: i60);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<i60> = [0, 1, -1, 576460752303423487, -576460752303423488, 576460752303423486, -576460752303423487, 384307168202282325, -384307168202282326, 288230376151711744, -288230376151711744, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(576460752303423487), T.I0(-576460752303423488), T.I0(576460752303423486), T.I0(-576460752303423487), T.I0(384307168202282325), T.I0(-384307168202282326), T.I0(288230376151711744), T.I0(-288230376151711744), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(576460752303423487), T.I1(-576460752303423488), T.I1(576460752303423486), T.I1(-576460752303423487), T.I1(384307168202282325), T.I1(-384307168202282326), T.I1(288230376151711744), T.I1(-288230376151711744), T.I1(19088743), T.I1(-124076833),
	T.I2(0), T.I2(1), T.I2(-1), T.I2(576460752303423487), T.I2(-576460752303423488), T.I2(576460752303423486), T.I2(-576460752303423487), T.I2(384307168202282325), T.I2(-384307168202282326), T.I2(288230376151711744), T.I2(-288230376151711744), T.I2(19088743), T.I2(-124076833)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.I0(xs[k]);
		2 => return T.I1(xs[k]);
		_ => return T.I2(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
