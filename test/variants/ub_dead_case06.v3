//@execute 0=0; 1=0; 2=0
// Querying and casting to a never-allocated case of an unboxed variant.
type Op #unboxed {
	case A(x: int);
	case B(x: long, y: int);
	case D(y: long);
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A(1);
		1 => return Op.B(2, 3);
		_ => return Op.A(4);
	}
}
def main(a: int) -> int {
	var op = make(a);
	if (Op.D.?(op)) return -1;
	return 0;
}
