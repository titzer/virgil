//@execute 0=false; 1=false
// A polymorphic variant instantiated at itself.
type Opt<X> {
	case Some(v: X);
	case None;
}
def CACHE: Array<Opt<Opt<float>>> = [
	Opt<Opt<float>>.Some(Opt<float>.Some(float.nan)),
	Opt<Opt<float>>.Some(Opt<float>.Some(float.view(0xFFC00000u)))
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
