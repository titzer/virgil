//@execute 0=190; 1=191; 2=192
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
}

def val(t: T) -> int {
	match (t) {
		A(str) => return str.length;
		B(v) => return v;
	}
}

def main(a: int) -> int {
	var arr = Array<T>.new(20);
	for (i < arr.length) {
		arr[i] = if((i & 1) == 0, T.A(Array<byte>.new(i)), T.B(byte.view(i)));
	}
	var sum = 0;
	for (t in arr) sum += val(t);
	return sum + a;
}
