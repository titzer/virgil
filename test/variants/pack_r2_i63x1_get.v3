def xs: Array<i63> = [0, 1, -1, 4611686018427387903, -4611686018427387904, 4611686018427387902, -4611686018427387903, 1537228672809129301, -1537228672809129302, 2305843009213693952, -2305843009213693952, 19088743, -124076833];
