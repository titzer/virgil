//@execute 0=3; 1=3; 2=12; 3=12; 4=0; 5=0; 6=64; 7=128
// Both type parameters instantiated to the same float type.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<float, float>> = [
	T.IsA(0f),
	T.IsA(-0f),
	T.IsB(0f),
	T.IsB(-0f),
	T.IsA(float.nan),
	T.IsB(float.nan),
	T.IsA(float.view(0x00000001u)),
	T.IsB(float.view(0x00000001u))
];

def cmp = T<float, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
