//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=true; 6=false; 7=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type B #unboxed {
	case None;
	case Box(c: C);
}
def c1 = cs[0];
def bs = [B.None, B.Box(c1), B.Box(cs[2]), B.Box(cs[1])];
def mk(i: int, n: int) -> (B, int) { return (bs[i], n); }
def main(a: int) -> bool {
	match (a) {
		0 => return mk(0, 1) == (B.None, 1);
		1 => return mk(0, 1) == mk(1, 1);
		2 => return mk(1, 2) == (B.Box(c1), 2);
		3 => return mk(1, 2) == mk(1, 3);
		4 => return mk(0, 5) == mk(0, 5);
		5 => return mk(2, 5) == (B.Box(cs[2]), 5);
		6 => return mk(2, 5) == mk(1, 5);
		_ => return mk(3, 5) == mk(1, 5);
	}
}
