//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 32=6; 33=7; 34=8; 48=9; 49=10; 50=11; 51=12; 52=13; 53=14; 54=15; 55=16; 56=17; 57=18; 58=19; 59=20; 60=21
class A(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case I0(x: u62);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def xs: Array<u62> = [0, 1, 2, 4611686018427387903, 4611686018427387902, 2305843009213693952, 2305843009213693951, 1537228672809129301, 3074457345618258602, 1152921504606846976, 3458764513820540928, 19088743, 4611686018303311070];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(4611686018427387903), T.I0(4611686018427387902), T.I0(2305843009213693952), T.I0(2305843009213693951), T.I0(1537228672809129301), T.I0(3074457345618258602), T.I0(1152921504606846976), T.I0(3458764513820540928), T.I0(19088743), T.I0(4611686018303311070)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.R2(r2[k]);
		_ => return T.I0(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
