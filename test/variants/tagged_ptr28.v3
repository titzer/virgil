//@execute 0=8; 1=6; 2=88; 3=66; 4=88888
type T #unboxed #packed { // no tag necessary with type discrimination
	case Int(x: Array<int>);
	case Byte(x: Array<byte>);

	def sum() -> int {
		var sum = 0;
		match (this) {
			Int(x) => for (v in x) sum += v;
			Byte(x) => for (v in x) sum += v;
		}
		return sum;
	}
}

def ts = [T.Int([5, 3]), T.Byte([2, 4]), T.Int([55, 33]), T.Byte([22, 44]), T.Int([55555, 33333])];

def main(a: int) -> int {
	return ts[a].sum();
}