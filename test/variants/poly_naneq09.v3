//@execute 0=false; 1=false
// poly_naneq06 for double: the same object reaches the comparison through two array
// slots, so the loads cannot be CSE'd into one.
type Opt<X> {
	case Some(v: X);
	case None;
}
def CACHE: Array<Opt<double>> = [Opt<double>.Some(double.nan), Opt<double>.Some(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	var arr = Array<Opt<double>>.new(2);
	arr[0] = v;
	arr[1] = v;
	return arr[0] == arr[1];
}
