//@execute 0=-2103752598; 1=-2103752598; 2=912370176; 3=912370176
type T #unboxed #packed {
	case R(s: string);
	case I(x: u64);
}
def cell: Array<T> = [T.R("r"), T.R(null)];
def main(a: int) -> int {
	var acc = 0, r = cell[0];
	for (b < 64) {
		var p = 1L << u6.view(b);
		if (a == 1) p = ~p;
		if (a == 2) p = p - 1;
		if (a == 3) p = 0 - p;
		var x = u64.view(p);
		cell[1] = T.I(x);
		if (cell[1] == r) return -100;
		match (cell[1]) {
			R(s) => return -200;
			I(y) => {
				if (y != x) return -1 - b;
				acc = acc * 31 + (int.view(y) ^ int.view(y >> 32));
			}
		}
	}
	return acc;
}
