//@execute 0=3; 1=-3; 2=100; 3=5; 4=-5
type T #unboxed #packed {
	case A(x: string, neg: bool);
	case B(x: u16);
}

def ts = [T.A("abc", false), T.A("abc", true), T.B(100), T.A("defgh", false), T.A("defgh", true)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str, neg) => return if(neg, 0 - str.length, str.length);
		B(v) => return v;
	}
}
