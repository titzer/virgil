//@execute 0=false; 1=false; 2=false; 3=true; 4=true; 5=true; 6=false
// Cross-case comparisons of packed variants whose field bits coincide.
type T #unboxed #packed {
	case A(x: u8);
	case B(x: u8);
	case C(x: u4, y: u4);
}

def ts = [T.A(1), T.B(1), T.C(1, 0), T.A(1), T.B(1), T.C(1, 0), T.C(0, 1)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[1] == ts[2];
		3 => return ts[0] == ts[3];
		4 => return ts[1] == ts[4];
		5 => return ts[2] == ts[5];
		_ => return ts[2] == ts[6];
	}
}
