//@execute 0=false; 1=false; 2=false; 3=false
// ub_naneq06 and ub_naneq07 for double: reached through a generic equality and
// through the `==` method reference.
type T #unboxed {
	case D(x: double);
	case L(x: long);
}
def CACHE: Array<T> = [T.D(double.nan), T.D(double.view(0xFFF80000_00000000uL))];
def eq<X>(x: X) -> bool {
	return x == x;
}
def main(a: int) -> bool {
	var v = CACHE[a & 1];
	if ((a & 2) == 0) return eq(v);
	var f = T.==;
	return f(v, v);
}
