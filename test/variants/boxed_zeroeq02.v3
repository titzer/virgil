//@execute 0=true; 1=true
// Signed zeros in a double payload, and in the second component of a tuple.
type T {
	case D(x: double);
	case P(v: (double, double));
}
def POS: Array<T> = [T.D(0d), T.P((1d, 0d))];
def NEG: Array<T> = [T.D(-0d), T.P((1d, -0d))];
def main(a: int) -> bool {
	return POS[a] == NEG[a];
}
