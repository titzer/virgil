//@execute 0=8; 1=0; 2=56
// All pairs of three packed boolean fields.
type T #unboxed #packed {
	case A(a: bool, b: bool, c: bool);
	case B(z: u8);
}

def make(i: int) -> T {
	return T.A((i & 1) != 0, (i & 2) != 0, (i & 4) != 0);
}

def main(a: int) -> int {
	var eq = 0, ne = 0, self = 0;
	for (i < 8) for (j < 8) {
		if (make(i) == make(j)) {
			if (i == j) self++;
			else eq++;
		} else {
			ne++;
		}
	}
	match (a) {
		0 => return self;
		1 => return eq;
		_ => return ne;
	}
}
