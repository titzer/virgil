//@execute 0=1; 1=-1; 2=0; 3=32; 4=-29; 5=-134217756; 6=134217732; 7=-1521134256; 8=1521134236; 9=-134217752; 10=7; 11=-134217759
enum E { E0, E1, E2, E3, E4, E5, E6, E7 }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E, x: i28);
}
def rs: Array<string> = ["r", null];
def es = [E.E0, E.E1, E.E2, E.E3, E.E4, E.E5, E.E6, E.E7];
def xs: Array<i28> = [0, 1, -1, 134217727, -134217728, 89478485, -89478486, 134217727, 0, 134217727];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.E0, 0),
	T.X(E.E1, 1),
	T.X(E.E2, -1),
	T.X(E.E3, 134217727),
	T.X(E.E4, -134217728),
	T.X(E.E5, 89478485),
	T.X(E.E6, -89478486),
	T.X(E.E7, 134217727),
	T.X(E.E7, 0),
	T.X(E.E0, 134217727)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0], xs[0]);
		3 => return T.X(es[1], xs[1]);
		4 => return T.X(es[2], xs[2]);
		5 => return T.X(es[3], xs[3]);
		6 => return T.X(es[4], xs[4]);
		7 => return T.X(es[5], xs[5]);
		8 => return T.X(es[6], xs[6]);
		9 => return T.X(es[7], xs[7]);
		10 => return T.X(es[7], xs[8]);
		_ => return T.X(es[0], xs[9]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		X(e, x) => return (int.view(x)) * 31 + e.tag;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
