//@execute 0=16; 1=16; 2=16; 3=16; 4=16; 5=16; 6=16; 7=33; 8=33; 9=33; 10=33
type B {
	case X(a: int);
	case Y(s: string);
}
type T #unboxed #packed {
	case R(b: B);
	case I(x: i31);
}
def ks = [5, 0, -7];
def ss = ["hey", "you"];
def db = Array<B>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.R(B.X(5)),
	T.R(B.X(0)),
	T.R(db[0]),
	T.R(B.X(-7)),
	T.R(B.Y(ss[0])),
	T.R(B.Y(ss[1])),
	T.R(B.Y(null)),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(B.X(ks[0]));
		1 => return T.R(B.X(ks[1]));
		2 => return T.R(db[0]);
		3 => return T.R(B.X(ks[2]));
		4 => return T.R(B.Y(ss[0]));
		5 => return T.R(B.Y(ss[1]));
		6 => return T.R(B.Y(null));
		7 => return T.I(xs[0]);
		8 => return T.I(xs[1]);
		9 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.I.?(d)) r |= 32;
	return r;
}
