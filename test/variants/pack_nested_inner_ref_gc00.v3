//@execute 0=3; 1=5; 2=-1; 3=6; 4=-2
//@heap-size=20000
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type T #unboxed #packed {
	case A(p: P);
	case B(x: i31);
}
class N(t: T, next: N) { }
def get(t: T) -> int {
	match (t) {
		A(p) => match (p) {
			S(s) => return s.length;
			I(x) => return x;
		}
		B(x) => return x;
	}
}
def ss = [Array<byte>.new(3)];
def mk(a: int) -> T {
	match (a) {
		0 => return T.A(P.S(ss[0]));
		1 => return T.A(P.I(5));
		2 => return T.A(P.I(-1));
		3 => return T.B(6);
		_ => return T.B(-2);
	}
}
def main(a: int) -> int {
	ss[0] = null;
	ss[0] = Array<byte>.new(3);
	var l: N;
	for (i < 5) l = N.new(mk((a + i) % 5), l);
	CiTest.forceGc();
	for (n = l; n != null; n = n.next) { ss[0] = Array<byte>.new(3); l = N.new(n.t, l); CiTest.forceGc(); }
	var i = 4;
	for (n = l.next.next.next.next.next; n != null; n = n.next) { if (get(n.t) != get(mk((a + i) % 5))) return -99; i--; }
	return get(l.next.next.next.next.next.next.next.next.next.t);
}
