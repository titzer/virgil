//@execute 0=false; 1=false; 2=true; 3=true
// A recursive variant carrying a double. Recursion forces the variant to stay boxed,
// so the comparator's reference-identity fastpath must be suppressed all the way
// down the spine, not just at the root.
type L {
	case Cons(head: double, tail: L);
	case Nil;
}
def CACHE: Array<L> = [
	L.Cons(double.nan, L.Nil),		// NaN at the head
	L.Cons(1d, L.Cons(double.nan, L.Nil)),	// NaN one level down
	L.Cons(1d, L.Cons(2d, L.Nil)),
	L.Nil
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
