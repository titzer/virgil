//@execute 0=16; 1=16; 2=16; 3=16; 4=16; 5=16; 6=33; 7=33; 8=33; 9=33; 10=66; 11=66; 12=66; 13=66; 14=66; 15=66
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type T #unboxed #packed {
	case A(p: P);
	case B(x: i31);
	case C(p: P);
}
def rs: Array<string> = ["r", null];
def xs: Array<i30> = [0, -1, 536870911, -536870912];
def ys: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.A(P.S(rs[0])),
	T.A(P.S(rs[1])),
	T.A(P.I(0)),
	T.A(P.I(-1)),
	T.A(P.I(536870911)),
	T.A(P.I(-536870912)),
	T.B(0),
	T.B(-1),
	T.B(1073741823),
	T.B(-1073741824),
	T.C(P.S(rs[0])),
	T.C(P.S(rs[1])),
	T.C(P.I(0)),
	T.C(P.I(-1)),
	T.C(P.I(536870911)),
	T.C(P.I(-536870912))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.A(P.S(rs[0]));
		1 => return T.A(P.S(rs[1]));
		2 => return T.A(P.I(xs[0]));
		3 => return T.A(P.I(xs[1]));
		4 => return T.A(P.I(xs[2]));
		5 => return T.A(P.I(xs[3]));
		6 => return T.B(ys[0]);
		7 => return T.B(ys[1]);
		8 => return T.B(ys[2]);
		9 => return T.B(ys[3]);
		10 => return T.C(P.S(rs[0]));
		11 => return T.C(P.S(rs[1]));
		12 => return T.C(P.I(xs[0]));
		13 => return T.C(P.I(xs[1]));
		14 => return T.C(P.I(xs[2]));
		_ => return T.C(P.I(xs[3]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.A.?(d)) r |= 16;
	if (T.B.?(d)) r |= 32;
	if (T.C.?(d)) r |= 64;
	return r;
}
