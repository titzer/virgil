//@execute 0=10; 1=-1; 2=11; 3=-2; 4=0; 5=1; 6=-1; 7=1073741823; 8=-1073741824; 9=357913941; 10=-357913942
class C0(v: int) { }
class C1(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case I0(x: i31);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def xs: Array<i31> = [0, 1, -1, 1073741823, -1073741824, 357913941, -357913942];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.I0(0),
	T.I0(1),
	T.I0(-1),
	T.I0(1073741823),
	T.I0(-1073741824),
	T.I0(357913941),
	T.I0(-357913942)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.I0(xs[0]);
		5 => return T.I0(xs[1]);
		6 => return T.I0(xs[2]);
		7 => return T.I0(xs[3]);
		8 => return T.I0(xs[4]);
		9 => return T.I0(xs[5]);
		_ => return T.I0(xs[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x.v);
		R1(x) => return if(x == null, -2, x.v);
		I0(x) => return int.view(x);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
