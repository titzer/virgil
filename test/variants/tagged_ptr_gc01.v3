//@execute 0=9; 1=15; 2=21
// Two reference cases: the case tag lives in the aux tag bit next to the pointer.
class C(x: int) { }

type T #unboxed #packed {
	case A(s: string);
	case B(c: C);
	def get() -> int {
		match (this) {
			A(s) => return s.length;
			B(c) => return c.x;
		}
	}
}

var roots = Array<T>.new(6);

def main(a: int) -> int {
	for (i < roots.length) {
		CiTest.forceGc();
		roots[i] = if((i % 2) == 0, T.A(Array<byte>.new(a + 1)), T.B(C.new(a + 2)));
	}
	var sum = 0;
	for (r in roots) {
		CiTest.forceGc();
		sum += r.get();
	}
	return sum;
}
