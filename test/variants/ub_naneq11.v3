//@execute 0=false; 1=false
// A boxed variant nested inside an unboxed one.
type Inner {
	case F(x: float);
	case I(x: int);
}
type Outer #unboxed {
	case W(i: Inner);
	case N;
}
def CACHE: Array<Outer> = [Outer.W(Inner.F(float.nan)), Outer.W(Inner.F(float.nan))];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
