//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256
type T #unboxed #packed {
	case R(s: string);
	case P0(a: u1, b: i30);
}
def rs: Array<string> = ["r", null];
def f0a: Array<u1> = [0, 1, 0, 0, 1, 1, 0];
def f0b: Array<i30> = [0, 0, -536870912, 536870911, 536870911, -357913942, 357913941];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0),
	T.P0(1, 0),
	T.P0(0, -536870912),
	T.P0(0, 536870911),
	T.P0(1, 536870911),
	T.P0(1, -357913942),
	T.P0(0, 357913941)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0]);
		3 => return T.P0(f0a[1], f0b[1]);
		4 => return T.P0(f0a[2], f0b[2]);
		5 => return T.P0(f0a[3], f0b[3]);
		6 => return T.P0(f0a[4], f0b[4]);
		7 => return T.P0(f0a[5], f0b[5]);
		_ => return T.P0(f0a[6], f0b[6]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
