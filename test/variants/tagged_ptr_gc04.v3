//@execute 0=172; 1=180; 2=188
// A linked list whose nodes hold tagged variants, built and walked with collections in between.
type T #unboxed #packed {
	case A(s: string);
	case B(x: u16);
}
class Node(t: T, next: Node) { }

def get(t: T) -> int {
	match (t) {
		A(s) => return s.length;
		B(x) => return x;
	}
}

def main(a: int) -> int {
	var list: Node;
	for (i < 8) {
		CiTest.forceGc();
		list = Node.new(if((i & 1) == 0, T.A(Array<byte>.new(i + a)), T.B(u16.!(i * 10 + a))), list);
	}
	var sum = 0;
	for (n = list; n != null; n = n.next) {
		CiTest.forceGc();
		sum += get(n.t);
	}
	return sum;
}
