//@execute 0=true; 1=false; 2=false; 3=true
// Wide packed fields that fill a 64-bit scalar together with the tag.
type T #unboxed #packed {
	case A(x: u32, y: u31);
	case B(z: u8);
}

def ts = [T.A(0xFFFFFFFF, 0x7FFFFFFF), T.A(0xFFFFFFFF, 0x7FFFFFFF), T.A(0xFFFFFFFE, 0x7FFFFFFF), T.A(0xFFFFFFFF, 0x7FFFFFFE)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[0] == ts[3];
		_ => return ts[2] != ts[3];
	}
}
