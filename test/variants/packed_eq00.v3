//@execute 0=false; 1=true; 2=false; 3=true; 4=false; 5=false
type T #unboxed #packed {
	case A(x: u8, y: u8);
	case B(z: u4);
}

def ts = [T.A(1, 2), T.A(1, 3), T.B(1), T.B(2), T.A(2, 2)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == T.A(1, 2);
		2 => return ts[2] == ts[3];
		3 => return ts[3] == T.B(2);
		4 => return ts[0] == ts[4];
		_ => return ts[0] == ts[2];
	}
}
