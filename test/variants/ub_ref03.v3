//@execute 0=0; 1=2; 2=1; 3=2
class C(i: int) {}
type A #unboxed #packed { 
	case X(i: byte, c: C) #unboxed #packed;
}
def main(a: int) -> int {
	def C1 = C.new(1);
	def C2 = C.new(2);
	def one = A.X(0, C1);
	def thr = A.X(2, C2);
	def arr = [one, thr];

	match(a) {
		0 => return A.X.!(arr[0]).i;
		1 => return A.X.!(arr[1]).i;
		2 => return A.X.!(arr[0]).c.i;
		3 => return A.X.!(arr[1]).c.i;
		_ => return 42;
	}
}
