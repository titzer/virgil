//@execute 0=-2147483648; 1=-2147483648; 2=11; 3=22
// A constant `-0.0` field dropped from a tagless unboxed variant, beside a field
// that really does vary. Compare with ub_naneq19, which compares such values.
type T #unboxed {
	case F(nonce: int, x: double);
	case I(y: int);
}
def CACHE: Array<T> = [T.F(11, -0d), T.F(22, -0d)];
def main(a: int) -> int {
	match (CACHE[a & 1]) {
		F(nonce, x) => return if((a & 2) == 0, int.view(u64.view(x) >> 32), nonce);
		I(y) => return -1;
	}
}
