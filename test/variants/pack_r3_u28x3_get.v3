//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=0; 10=1; 11=2; 12=268435455; 13=268435454; 14=134217728; 15=134217727; 16=89478485; 17=178956970; 18=67108864; 19=201326592; 20=19088743; 21=144358622; 22=-1; 23=-2; 24=-3; 25=-268435456; 26=-268435455; 27=-134217729; 28=-134217728; 29=-89478486; 30=-178956971; 31=-67108865; 32=-201326593; 33=-19088744; 34=-144358623; 35=7; 36=8; 37=9; 38=268435462; 39=268435461; 40=134217735; 41=134217734; 42=89478492; 43=178956977; 44=67108871; 45=201326599; 46=19088750; 47=144358629
class A(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case I0(x: u28);
	case I1(x: u28);
	case I2(x: u28);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def xs: Array<u28> = [0, 1, 2, 268435455, 268435454, 134217728, 134217727, 89478485, 178956970, 67108864, 201326592, 19088743, 144358622];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(268435455), T.I0(268435454), T.I0(134217728), T.I0(134217727), T.I0(89478485), T.I0(178956970), T.I0(67108864), T.I0(201326592), T.I0(19088743), T.I0(144358622),
	T.I1(0), T.I1(1), T.I1(2), T.I1(268435455), T.I1(268435454), T.I1(134217728), T.I1(134217727), T.I1(89478485), T.I1(178956970), T.I1(67108864), T.I1(201326592), T.I1(19088743), T.I1(144358622),
	T.I2(0), T.I2(1), T.I2(2), T.I2(268435455), T.I2(268435454), T.I2(134217728), T.I2(134217727), T.I2(89478485), T.I2(178956970), T.I2(67108864), T.I2(201326592), T.I2(19088743), T.I2(144358622)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
