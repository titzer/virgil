//@execute 0=false; 1=false
// The same cached boxed value, loaded twice.
type T {
	case F(x: float);
	case I(x: int);
}
def nan(i: int) -> T {
	i |= int.view(float.nan); 
	return T.F(float.view(i));
}
def CACHE: Array<T> = [nan(6), nan(7)];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
