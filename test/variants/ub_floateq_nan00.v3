//@execute 0=0; 1=0; 2=0; 3=0; 4=16; 5=32; 6=64; 7=128
// A zoo of float NaN encodings.
type T #unboxed {
	case F(v: float);
	case I(v: u32);
}

def ts = [
	T.F(float.nan),
	T.F(float.view(0x7FC00001u)),
	T.F(float.view(0xFFC00000u)),
	T.F(float.view(0x7F800001u)),
	T.F(1f),
	T.F(float.infinity),
	T.I(0x7FC00000),
	T.I(0)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
