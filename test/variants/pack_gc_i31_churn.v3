//@execute 0=2; 1=-1; 2=-1073741824; 3=-1; 4=-1073741824; 5=-1
//@heap-size=200000
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i31);
	case I1(x: i31);
}
def vs = [T.R("s1"), T.R(null), T.I0(-1073741824), T.I0(-1), T.I1(1073741823), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	var ring = Array<T>.new(16);
	for (i < 2000) {
		var j = i & 15;
		if ((i & 3) == 0) ring[j] = T.R(Array<byte>.new(i & 31));
		else ring[j] = vs[(a + i) % vs.length];
		if ((i & 255) == 255) CiTest.forceGc();
		var e = i - 7;
		if (e < 0) continue;
		var old = ring[e & 15];
		if ((e & 3) == 0) {
			if (get(old) != (e & 31)) return -1 - i;
		} else {
			if (old != vs[(a + e) % vs.length]) return -1 - i;
		}
	}
	for (i < 16) {
		var e = 1984 + i;
		if ((e & 3) != 0 && ring[i] != vs[(a + e) % vs.length]) return -5000 - i;
	}
	return get(vs[a]);
}
