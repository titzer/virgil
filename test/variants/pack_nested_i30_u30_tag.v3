//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33; 11=33; 12=33; 13=33
type P #unboxed #packed {
	case X(a: i30);
	case Y(b: u30);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i30> = [0, 1, -1, 536870911, -536870912, 357913941];
def xb: Array<u30> = [0, 1, 1073741823, 536870912, 536870911, 357913941];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(536870911)),
	T.N0(P.X(-536870912)),
	T.N0(P.X(357913941)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(1073741823)),
	T.N0(P.Y(536870912)),
	T.N0(P.Y(536870911)),
	T.N0(P.Y(357913941))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		_ => return T.N0(P.Y(xb[5]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.N0.?(d)) r |= 32;
	return r;
}
