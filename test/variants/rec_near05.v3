//@execute 0=true; 1=false; 2=true; 3=true; 4=true; 5=true
type L {
	case Nil;
	case Cons(t: L);
}
def nil = L.Nil, one = L.Cons(nil);
def len(l: L) -> int {
	match (l) {
		Nil => return 0;
		Cons(t) => return 1 + len(t);
	}
}
def main(a: int) -> bool {
	match (a) {
		0 => return one == L.Cons(L.Nil);
		1 => return one == nil;
		2 => return nil == L.Nil;
		3 => return len(nil) == 0;
		4 => return len(one) == 1;
		_ => return one.tag == 1;
	}
}
