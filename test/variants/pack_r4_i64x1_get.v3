//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=41; 10=42; 11=-4; 12=0; 13=1; 14=0; 15=-2147483648; 16=-2147483648; 17=-2147483647; 18=-2147483647; 19=0; 20=0; 21=1073741824; 22=-1073741824; 23=19088743; 24=124076832
class A(v: int) { }
