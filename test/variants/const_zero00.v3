//@execute 0=-2147483648; 1=-2147483648
// The float field holds the same value everywhere in the program, so it is dropped
// from the representation and every read folds to the constant. `-0.0` must survive
// that fold; it is not the zero value.
type F(x: float) { }
def CACHE = [F(-0f), F(-0f)];
def main(a: int) -> int {
	return int.view(CACHE[a].x);
}
