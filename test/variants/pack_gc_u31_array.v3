//@execute 0=2; 1=-1; 2=1073741824; 3=1; 4=-2147483648; 5=-1
//@heap-size=20000
type T #unboxed #packed {
	case R(s: string);
	case I0(x: u31);
	case I1(x: u31);
}
def vs = [T.R("s1"), T.R(null), T.I0(1073741824), T.I0(1), T.I1(2147483647), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	var copy = Array<T>.new(vs.length + 1);
	for (i < vs.length) copy[i] = vs[i];
	copy[vs.length] = T.R(Array<byte>.new(a + 1));
	CiTest.forceGc();
	var again = Array<T>.new(copy.length);
	for (i < copy.length) again[i] = copy[i];
	CiTest.forceGc();
	for (i < vs.length) if (again[i] != vs[i]) return -90 - i;
	if (get(again[vs.length]) != a + 1) return -99;
	return get(again[a]);
}
