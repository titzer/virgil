//@execute 0=true; 1=false; 2=false; 3=true; 4=false; 5=true
// A reference case with a non-zero tag and a packed boolean next to the reference.
type T #unboxed #packed {
	case B(x: u8);
	case A(s: string, f: bool);
}

def s = "abc";
def ts = [T.A(s, true), T.A(s, true), T.A(s, false), T.A("abc", true), T.B(1), T.B(1)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[0] == ts[3];
		3 => return ts[0] != ts[2];
		4 => return ts[4] == ts[0];
		_ => return ts[4] == ts[5];
	}
}
