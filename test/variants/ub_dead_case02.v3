//@execute 0=11; 1=22
// The only cases with fields are never allocated; the bound value is passed along.
type Op #unboxed {
	case A;
	case B;
	case C(r: Array<int>, x: long);
	case D(f: double);
}
def visitC(x: Op.C) -> int { return x.r.length; }
def visitD(x: Op.D) -> int { return int.truncd(x.f); }
def visit(op: Op) -> int {
	match (op) {
		x: Op.A => return 11;
		x: Op.B => return 22;
		x: Op.C => return visitC(x);
		x: Op.D => return visitD(x);
	}
}
def main(a: int) -> int {
	return visit(if(a == 0, Op.A, Op.B));
}
