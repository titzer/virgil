//@execute 0=-999; 1=898; 2=-999; 3=898
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f) => return u32.view(f(i32.view(v)));
			U(f) => return f(v);
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

def fs = [
	F.S(id_s),
	F.S(flip_s),
	F.U(id_u),
	F.U(flip_u)
];

class Box(var f: F) { }

def pick(i: int) -> (F, F) {
	return (fs[i & 3], fs[(i + 1) & 3]);
}

def main(a: int) -> int {
	var b = Box.new(pick(a).1);
	var r = b.f.apply(9);
	b.f = pick(a).0;
	return int.view(r * 100 + b.f.apply(1));
}
