//@execute 0=true; 1=true; 2=true; 3=false; 4=false
// Equality of tagged variants after the GC has moved the referenced objects.
type T #unboxed #packed {
	case A(s: string);
	case B(x: u8);
}

def main(a: int) -> bool {
	var s = Array<byte>.new(3);
	var t1 = T.A(s), t2 = T.A(s), b1 = T.B(7), b2 = T.B(7);
	var arr = [t1, b1];
	CiTest.forceGc();
	var copy = Array<T>.new(2);
	for (i < 2) copy[i] = arr[i];
	CiTest.forceGc();
	match (a) {
		0 => return copy[0] == t2;
		1 => return copy[1] == b2;
		2 => return copy[0] == arr[0];
		3 => return copy[0] == copy[1];
		_ => return copy[0] == T.A(Array<byte>.new(3));
	}
}
