//@execute 0=1; 1=2; 2=5; 3=9; 4=5; 5=10; 6=9; 7=21
type F #unboxed {
	case I(f: int -> int);
	case L(f: long -> long);
	case P(f: (int, int) -> int);

	def apply(v: int) -> int {
		match (this) {
			I(f) => return f(v);
			L(f) => return int.view(f(v));
			P(f) => return f(v, 3);
		}
	}
}

def inc(x: int) => x + 1;
def dbl(x: long) => x + x;
def add(x: int, y: int) => x + y;
def mul(x: int, y: int) => x * y;

def fs = [F.I(inc), F.L(dbl), F.P(add), F.P(mul)];

def main(a: int) -> int {
	return fs[a & 3].apply(a);
}
