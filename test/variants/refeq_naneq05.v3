//@execute 0=true; 1=true; 2=true; 3=false
// A `Range<double>` field compares by reference, start and length, not by content,
// so NaNs inside the underlying array leave the variant reflexive. The bare double
// field is what makes case B non-reflexive.
type T {
	case A(r: Range<double>);
	case B(x: double);
}
def NANS: Array<double> = [double.nan, double.nan, 1d];
def CACHE: Array<T> = [T.A(NANS), T.A(NANS[0 ... 2]), T.A(NANS[2 ...]), T.B(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
