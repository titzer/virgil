//@execute 0=10; 1=-1; 2=11; 3=-2; 4=0; 5=1; 6=-1; 7=536870911; 8=-536870912; 9=357913941; 10=-357913942; 11=-1; 12=-2; 13=0; 14=-536870912; 15=536870911; 16=-357913942; 17=357913941
class C0(v: int) { }
class C1(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case I0(x: i30);
	case I1(x: i30);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def xs: Array<i30> = [0, 1, -1, 536870911, -536870912, 357913941, -357913942];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.I0(0),
	T.I0(1),
	T.I0(-1),
	T.I0(536870911),
	T.I0(-536870912),
	T.I0(357913941),
	T.I0(-357913942),
	T.I1(0),
	T.I1(1),
	T.I1(-1),
	T.I1(536870911),
	T.I1(-536870912),
	T.I1(357913941),
	T.I1(-357913942)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.I0(xs[0]);
		5 => return T.I0(xs[1]);
		6 => return T.I0(xs[2]);
		7 => return T.I0(xs[3]);
		8 => return T.I0(xs[4]);
		9 => return T.I0(xs[5]);
		10 => return T.I0(xs[6]);
		11 => return T.I1(xs[0]);
		12 => return T.I1(xs[1]);
		13 => return T.I1(xs[2]);
		14 => return T.I1(xs[3]);
		15 => return T.I1(xs[4]);
		16 => return T.I1(xs[5]);
		_ => return T.I1(xs[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x.v);
		R1(x) => return if(x == null, -2, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~(int.view(x));
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
