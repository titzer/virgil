//@execute 0=2; 1=-1; 2=102; 3=-2; 4=0; 5=-1; 6=1073741823; 7=-1073741824
class A(v: int) { }
type T<X> #unboxed #packed {
	case One(x: X);
	case Many(x: Array<X>);
	case I(n: i31);
}
def r1: Array<A> = [A.new(2), null];
def rn: Array<Array<A>> = [[A.new(2)], null];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T<A>.One(r1[0]),
	T<A>.One(r1[1]),
	T<A>.Many(rn[0]),
	T<A>.Many(rn[1]),
	T<A>.I(0),
	T<A>.I(-1),
	T<A>.I(1073741823),
	T<A>.I(-1073741824)
];
def mk(i: int) -> T<A> {
	match (i) {
		0 => return T<A>.One(r1[0]);
		1 => return T<A>.One(r1[1]);
		2 => return T<A>.Many(rn[0]);
		3 => return T<A>.Many(rn[1]);
		4 => return T<A>.I(xs[0]);
		5 => return T<A>.I(xs[1]);
		6 => return T<A>.I(xs[2]);
		_ => return T<A>.I(xs[3]);
	}
}
def get(v: T<A>) -> int {
	match (v) {
		One(x) => return if(x == null, -1, x.v);
		Many(x) => return if(x == null, -2, 100 + x[0].v);
		I(n) => return n;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
