//@execute 0=0; 1=0; 2=0; 3=1; 4=0; 5=0
type T #unboxed #packed {
	case I0(x: i63);
	case I1(x: i63);
	case R(s: string);
}
def vs = [T.R("s1"), T.R(null), T.I0(-4611686018427387904), T.I0(-1), T.I1(4611686018427387903), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return (int.view(x) ^ int.view(x >> 32));
		I1(x) => return ~(int.view(x) ^ int.view(x >> 32));
	}
}
var d: T;
def ds = Array<T>.new(2);
def main(a: int) -> int {
	match (a) {
		0 => return d.tag;
		1 => return if(d == vs[1], 1, 0);
		2 => return if(ds[1] == vs[5], 1, 0);
		3 => return if(d == T.I0(0), 1, 0);
		4 => return if(T.R.?(ds[0]), 1, 0);
		_ => return get(ds[0]);
	}
}
