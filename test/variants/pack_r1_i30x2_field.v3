//@execute 0=5; 1=5; 2=5; 16=5; 17=5; 18=5; 19=5; 20=5; 21=5; 22=5; 23=5; 24=5; 25=5; 26=5; 27=5; 28=5; 32=5; 33=5; 34=5; 35=5; 36=5; 37=5; 38=5; 39=5; 40=5; 41=5; 42=5; 43=5; 44=5; 48=!TypeCheckException
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: i30);
	case I1(x: i30);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<i30> = [0, 1, -1, 536870911, -536870912, 536870910, -536870911, 357913941, -357913942, 268435456, -268435456, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(536870911), T.I0(-536870912), T.I0(536870910), T.I0(-536870911), T.I0(357913941), T.I0(-357913942), T.I0(268435456), T.I0(-268435456), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(536870911), T.I1(-536870912), T.I1(536870910), T.I1(-536870911), T.I1(357913941), T.I1(-357913942), T.I1(268435456), T.I1(-268435456), T.I1(19088743), T.I1(-124076833)
];
def idx = [0, 3, 16];
def main(a: int) -> int {
	var c = a / 16, k = a % 16, r = 0;
	if (c == 3) return int.view(T.I0.!(vs[0]).x);
	match (c) {
		0 => {
			var p = T.R0.!(vs[idx[c] + k]), q = T.R0(r0[k]), o = T.R0.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r0[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		1 => {
			var p = T.I0.!(vs[idx[c] + k]), q = T.I0(xs[k]), o = T.I0.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		_ => {
			var p = T.I1.!(vs[idx[c] + k]), q = T.I1(xs[k]), o = T.I1.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
	}
	return r;
}
