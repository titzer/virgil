//@execute 0=false; 1=false
// boxed_naneq22 for double: the NaNs are built at initialization time with distinct
// payloads, so neither the field nor the record is a shared constant.
type T {
	case D(x: double);
	case L(x: long);
}
def nan(i: long) -> T {
	i |= long.view(double.nan);
	return T.D(double.view(i));
}
def CACHE: Array<T> = [nan(6), nan(7)];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
