//@execute 0=false; 1=true; 2=false; 3=true; 4=true; 5=false; 6=false
type T #unboxed #packed {
	case A(s: string, b: bool);
	case B(x: u8, y: u8);
}

def s = "abc";
def ts = [T.A(s, false), T.A(s, true), T.B(1, 2), T.B(1, 3), T.B(2, 2)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == T.A(s, false);
		2 => return ts[2] == ts[3];
		3 => return ts[2] == T.B(1, 2);
		4 => return ts[1] == T.A(s, true);
		5 => return ts[2] == ts[4];
		_ => return ts[0] == ts[2];
	}
}
