//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false; 6=true; 7=false
// Equality of variants packed into tagged references: several reference cases, nulls.
class C(i: int) { }
type T #unboxed #packed {
	case A(s: string);
	case B(c: C);
	case D(x: u8);
	case E(a: Array<int>);
}

def s = "abc";
def c = C.new(1);
def arr = [1, 2];
def ts = [T.A(s), T.A("abc"), T.B(c), T.B(C.new(1)), T.D(9), T.E(arr), T.A(null), T.B(null)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == T.A(s);
		1 => return ts[0] == ts[1];
		2 => return ts[2] == T.B(c);
		3 => return ts[2] == ts[3];
		4 => return ts[4] == T.D(9);
		5 => return ts[6] == ts[7];
		6 => return ts[6] == T.A(null);
		_ => return ts[5] == T.E([1, 2]);
	}
}
