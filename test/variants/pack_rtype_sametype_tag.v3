//@execute 0=16; 1=16; 2=16; 3=33; 4=33; 5=33
type T #unboxed #packed {
	case S(x: string);
	case B(x: Array<byte>);
}
def rs: Array<string> = ["ab", "cd", null];
def vs = [
	T.S(rs[0]),
	T.S(rs[1]),
	T.S(rs[2]),
	T.B(rs[0]),
	T.B(rs[1]),
	T.B(rs[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.S(rs[0]);
		1 => return T.S(rs[1]);
		2 => return T.S(rs[2]);
		3 => return T.B(rs[0]);
		4 => return T.B(rs[1]);
		_ => return T.B(rs[2]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.S.?(d)) r |= 16;
	if (T.B.?(d)) r |= 32;
	return r;
}
