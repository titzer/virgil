//@execute 0=3; 1=-1; 2=-1; 3=7; 4=8; 5=5
// A reference case and a field-less case (declared second); fits the single aux tag bit on 32-bit.
type T #unboxed #packed {
	case A(s: string);
	case N;
}

def ts = [T.A("abc"), T.N];

def get(t: T) -> int {
	match (t) {
		A(s) => return s.length;
		N => return -1;
	}
}

def main(a: int) -> int {
	match (a) {
		0 => return get(ts[0]);
		1 => return get(ts[1]);
		2 => return get(T.N);
		3 => return if(ts[1] == T.N, 7, 8);
		4 => return if(ts[0] == T.N, 7, 8);
		_ => return get(T.A(Array<byte>.new(5)));
	}
}
