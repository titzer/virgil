//@execute 0=0; 1=0; 2=0; 3=8; 4=16; 5=32; 6=64
// ub_floateq_nan00 for double NaN encodings.
type T #unboxed {
	case D(v: double);
	case L(v: u64);
}

def ts = [
	T.D(double.nan),
	T.D(double.view(0xFFF80000_00000000uL)),
	T.D(double.view(0x7FF00000_00000001uL)),
	T.D(1d),
	T.D(-double.infinity),
	T.L(0x7FF80000_00000000),
	T.L(0)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
