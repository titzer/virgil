//@execute 0=true; 1=true; 2=true
// Control for ub_enumeq00: the dropped constant is -0.0, which is equal to itself,
// so no case needs to be excluded and the plain tag comparison stands.
type T #unboxed {
	case F(x: double);
	case G;
	case H;
}
def CACHE: Array<T> = [T.F(-0d), T.G, T.H];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
