//@execute 0=true; 1=true; 2=true
// Control for rec_naneq00: a recursive variant with no floating point member is
// reflexive, and the cycle check in the non-reflexivity test must not report it
// as non-reflexive just because it is recursive.
type L {
	case Cons(head: int, tail: L);
	case Nil;
}
def CACHE: Array<L> = [L.Cons(0, L.Nil), L.Cons(1, L.Cons(2, L.Nil)), L.Nil];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
