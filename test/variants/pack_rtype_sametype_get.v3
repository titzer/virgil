//@execute 0=97; 1=99; 2=-1; 3=1098; 4=1100; 5=-2
type T #unboxed #packed {
	case S(x: string);
	case B(x: Array<byte>);
}
def rs: Array<string> = ["ab", "cd", null];
def vs = [
	T.S(rs[0]),
	T.S(rs[1]),
	T.S(rs[2]),
	T.B(rs[0]),
	T.B(rs[1]),
	T.B(rs[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.S(rs[0]);
		1 => return T.S(rs[1]);
		2 => return T.S(rs[2]);
		3 => return T.B(rs[0]);
		4 => return T.B(rs[1]);
		_ => return T.B(rs[2]);
	}
}
def get(v: T) -> int {
	match (v) {
		S(x) => return if(x == null, -1, int.view(x[0]));
		B(x) => return if(x == null, -2, 1000 + x[1]);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
