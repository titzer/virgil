//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 19=6; 20=7; 21=8; 22=9; 23=10; 24=11; 25=12; 26=13; 27=14; 28=15; 32=16; 33=17; 34=18; 35=19; 36=20; 37=21; 38=22; 39=23; 40=24; 41=25; 42=26; 43=27; 44=28; 48=29; 49=30; 50=31; 51=32; 52=33; 53=34; 54=35; 55=36; 56=37; 57=38; 58=39; 59=40; 60=41; 64=42; 65=43; 66=44; 67=45; 68=46; 69=47; 70=48; 71=49; 72=50; 73=51; 74=52; 75=53; 76=54
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: u62);
	case I1(x: u62);
	case I2(x: u62);
	case I3(x: u62);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<u62> = [0, 1, 2, 4611686018427387903, 4611686018427387902, 2305843009213693952, 2305843009213693951, 1537228672809129301, 3074457345618258602, 1152921504606846976, 3458764513820540928, 19088743, 4611686018303311070];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(4611686018427387903), T.I0(4611686018427387902), T.I0(2305843009213693952), T.I0(2305843009213693951), T.I0(1537228672809129301), T.I0(3074457345618258602), T.I0(1152921504606846976), T.I0(3458764513820540928), T.I0(19088743), T.I0(4611686018303311070),
	T.I1(0), T.I1(1), T.I1(2), T.I1(4611686018427387903), T.I1(4611686018427387902), T.I1(2305843009213693952), T.I1(2305843009213693951), T.I1(1537228672809129301), T.I1(3074457345618258602), T.I1(1152921504606846976), T.I1(3458764513820540928), T.I1(19088743), T.I1(4611686018303311070),
	T.I2(0), T.I2(1), T.I2(2), T.I2(4611686018427387903), T.I2(4611686018427387902), T.I2(2305843009213693952), T.I2(2305843009213693951), T.I2(1537228672809129301), T.I2(3074457345618258602), T.I2(1152921504606846976), T.I2(3458764513820540928), T.I2(19088743), T.I2(4611686018303311070),
	T.I3(0), T.I3(1), T.I3(2), T.I3(4611686018427387903), T.I3(4611686018427387902), T.I3(2305843009213693952), T.I3(2305843009213693951), T.I3(1537228672809129301), T.I3(3074457345618258602), T.I3(1152921504606846976), T.I3(3458764513820540928), T.I3(19088743), T.I3(4611686018303311070)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.I0(xs[k]);
		2 => return T.I1(xs[k]);
		3 => return T.I2(xs[k]);
		_ => return T.I3(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
