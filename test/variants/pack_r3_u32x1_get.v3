//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=0; 10=1; 11=2; 12=-1; 13=-2; 14=-2147483648; 15=2147483647; 16=1431655765; 17=-1431655766; 18=1073741824; 19=-1073741824; 20=19088743; 21=-124076834
class A(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case I0(x: u32);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def xs: Array<u32> = [0, 1, 2, 4294967295u, 4294967294u, 2147483648u, 2147483647, 1431655765, 2863311530u, 1073741824, 3221225472u, 19088743, 4170890462u];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(4294967295u), T.I0(4294967294u), T.I0(2147483648u), T.I0(2147483647), T.I0(1431655765), T.I0(2863311530u), T.I0(1073741824), T.I0(3221225472u), T.I0(19088743), T.I0(4170890462u)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		I0(x) => return int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
