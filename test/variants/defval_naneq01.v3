//@execute 0=3; 1=3; 2=0; 3=3
// defval_naneq00 for an unboxed variant.
type T #unboxed {
	case F(x: double);
	case I(y: int);
}
def D: T;
def CACHE: Array<T> = [T.F(0d), T.F(-0d), T.F(double.nan), T.F(0d)];
def main(a: int) -> int {
	var l = D, r = CACHE[a];
	return if(l == r, 1) | if(r == l, 2);
}
