//@execute 0=5; 1=5; 2=5; 16=5; 17=5; 18=5; 32=5; 33=5; 34=5; 35=5; 36=5; 37=5; 38=5; 39=5; 40=5; 41=5; 42=5; 43=5; 44=5; 48=5; 49=5; 50=5; 51=5; 52=5; 53=5; 54=5; 55=5; 56=5; 57=5; 58=5; 59=5; 60=5; 64=!TypeCheckException
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: i62);
	case I1(x: i62);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xs: Array<i62> = [0, 1, -1, 2305843009213693951, -2305843009213693952, 2305843009213693950, -2305843009213693951, 1537228672809129301, -1537228672809129302, 1152921504606846976, -1152921504606846976, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(2305843009213693951), T.I0(-2305843009213693952), T.I0(2305843009213693950), T.I0(-2305843009213693951), T.I0(1537228672809129301), T.I0(-1537228672809129302), T.I0(1152921504606846976), T.I0(-1152921504606846976), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(2305843009213693951), T.I1(-2305843009213693952), T.I1(2305843009213693950), T.I1(-2305843009213693951), T.I1(1537228672809129301), T.I1(-1537228672809129302), T.I1(1152921504606846976), T.I1(-1152921504606846976), T.I1(19088743), T.I1(-124076833)
];
def idx = [0, 3, 6, 19];
def main(a: int) -> int {
	var c = a / 16, k = a % 16, r = 0;
	if (c == 4) return int.view(T.I0.!(vs[0]).x);
	match (c) {
		0 => {
			var p = T.R0.!(vs[idx[c] + k]), q = T.R0(r0[k]), o = T.R0.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r0[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		1 => {
			var p = T.R1.!(vs[idx[c] + k]), q = T.R1(r1[k]), o = T.R1.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r1[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		2 => {
			var p = T.I0.!(vs[idx[c] + k]), q = T.I0(xs[k]), o = T.I0.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		_ => {
			var p = T.I1.!(vs[idx[c] + k]), q = T.I1(xs[k]), o = T.I1.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
	}
	return r;
}
