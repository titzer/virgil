//@execute 0=0; 1=-2147483648; 2=1072693248; 3=-1074790400; 4=2146435072; 5=-1048576
// array_def01 for a variant with a double payload: -0.0 must survive laying the
// constant array out in the data section.
type D(x: double) { }
def vals = [D(0d), D(-0d), D(1d), D(-1d), D(double.infinity), D(-double.infinity)];
def main(a: int) -> int {
	return int.view(u64.view(vals[a].x) >> 32);
}
