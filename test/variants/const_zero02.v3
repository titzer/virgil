//@execute 0=2146959360; 1=2146959360
// A constant NaN field is dropped from the representation too; reading it back must
// still produce the NaN bits it was built with.
type D(x: double) { }
def CACHE = [D(double.nan), D(double.nan)];
def main(a: int) -> int {
	return int.view(u64.view(CACHE[a].x) >> 32);
}
