//@execute 0=true; 1=true; 2=true; 3=true
// The signed-zero half for polymorphic variants.
type Opt<X> {
	case Some(v: X);
	case None;
}
type UOpt<X> #unboxed {
	case Some(v: X);
	case None;
}
def FP: Array<Opt<float>> = [Opt<float>.Some(0f)];
def FN: Array<Opt<float>> = [Opt<float>.Some(-0f)];
def DP: Array<Opt<double>> = [Opt<double>.Some(0d)];
def DN: Array<Opt<double>> = [Opt<double>.Some(-0d)];
def UFP: Array<UOpt<float>> = [UOpt<float>.Some(0f)];
def UFN: Array<UOpt<float>> = [UOpt<float>.Some(-0f)];
def UDP: Array<UOpt<double>> = [UOpt<double>.Some(0d)];
def UDN: Array<UOpt<double>> = [UOpt<double>.Some(-0d)];
def main(a: int) -> bool {
	match (a) {
		0 => return FP[0] == FN[0];
		1 => return DP[0] == DN[0];
		2 => return UFP[0] == UFN[0];
		_ => return UDP[0] == UDN[0];
	}
}
