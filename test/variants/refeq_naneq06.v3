//@execute 0=true; 1=true; 2=false
// A closure field compares by (function, receiver) and stays reflexive even when the
// captured state is a NaN.
class Adder(k: double) {
	def add(x: double) -> double { return x + k; }
}
type T {
	case F(f: double -> double);
	case B(x: double);
}
def NAN_ADDER = Adder.new(double.nan);
def CACHE: Array<T> = [T.F(NAN_ADDER.add), T.F(Adder.new(1d).add), T.B(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
