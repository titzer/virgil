//@execute 0=16; 1=16; 2=33; 3=33; 4=66; 5=66; 6=66; 7=66
type T<X> #unboxed #packed {
	case One(x: X);
	case Many(x: Array<X>);
	case I(n: i31);
}
def r1: Array<string> = ["pq", null];
def rn: Array<Array<string>> = [["pq"], null];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T<string>.One(r1[0]),
	T<string>.One(r1[1]),
	T<string>.Many(rn[0]),
	T<string>.Many(rn[1]),
	T<string>.I(0),
	T<string>.I(-1),
	T<string>.I(1073741823),
	T<string>.I(-1073741824)
];
def mk(i: int) -> T<string> {
	match (i) {
		0 => return T<string>.One(r1[0]);
		1 => return T<string>.One(r1[1]);
		2 => return T<string>.Many(rn[0]);
		3 => return T<string>.Many(rn[1]);
		4 => return T<string>.I(xs[0]);
		5 => return T<string>.I(xs[1]);
		6 => return T<string>.I(xs[2]);
		_ => return T<string>.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T<string>.One.?(d)) r |= 16;
	if (T<string>.Many.?(d)) r |= 32;
	if (T<string>.I.?(d)) r |= 64;
	return r;
}
