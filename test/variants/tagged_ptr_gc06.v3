//@execute 0=-1; 1=-2; 2=3; 3=5
// Null references inside reference cases with different tags across collections.
class C(x: int) { }

type T #unboxed #packed {
	case B(x: u8);
	case A(s: string);
	case C(c: C);
}

def main(a: int) -> int {
	var arr = [T.A(null), T.C(null), T.A(Array<byte>.new(3)), T.B(5)];
	CiTest.forceGc();
	var r = arr[a];
	CiTest.forceGc();
	match (r) {
		A(s) => return if(s == null, -1, s.length);
		C(c) => return if(c == null, -2, c.x);
		B(x) => return x;
	}
}
