//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33; 11=33; 12=33; 13=33; 14=33; 15=33; 16=33; 17=33
type D #unboxed {
	case N;
	case S;
	case E;
	case W;
}
type T #unboxed #packed {
	case R(s: string);
	case M(d: D, x: i29);
}
def rs: Array<string> = ["r", null];
def ds = [D.N, D.S, D.E, D.W];
def xs: Array<i29> = [0, -1, 268435455, -268435456];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.M(D.N, 0),
	T.M(D.N, -1),
	T.M(D.N, 268435455),
	T.M(D.N, -268435456),
	T.M(D.S, 0),
	T.M(D.S, -1),
	T.M(D.S, 268435455),
	T.M(D.S, -268435456),
	T.M(D.E, 0),
	T.M(D.E, -1),
	T.M(D.E, 268435455),
	T.M(D.E, -268435456),
	T.M(D.W, 0),
	T.M(D.W, -1),
	T.M(D.W, 268435455),
	T.M(D.W, -268435456)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.M(ds[0], xs[0]);
		3 => return T.M(ds[0], xs[1]);
		4 => return T.M(ds[0], xs[2]);
		5 => return T.M(ds[0], xs[3]);
		6 => return T.M(ds[1], xs[0]);
		7 => return T.M(ds[1], xs[1]);
		8 => return T.M(ds[1], xs[2]);
		9 => return T.M(ds[1], xs[3]);
		10 => return T.M(ds[2], xs[0]);
		11 => return T.M(ds[2], xs[1]);
		12 => return T.M(ds[2], xs[2]);
		13 => return T.M(ds[2], xs[3]);
		14 => return T.M(ds[3], xs[0]);
		15 => return T.M(ds[3], xs[1]);
		16 => return T.M(ds[3], xs[2]);
		_ => return T.M(ds[3], xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.M.?(d)) r |= 32;
	return r;
}
