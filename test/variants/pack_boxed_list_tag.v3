//@execute 0=16; 1=16; 2=16; 3=16; 4=16; 5=33; 6=33; 7=33; 8=33
type L {
	case Nil;
	case Cons(h: int, t: L);
}
type T #unboxed #packed {
	case List(l: L);
	case Int(x: i31);
}
def ks = [1, 2, 3];
def dl = Array<L>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.List(L.Nil),
	T.List(dl[0]),
	T.List(L.Cons(1, L.Nil)),
	T.List(L.Cons(1, L.Cons(2, L.Nil))),
	T.List(L.Cons(1, L.Cons(3, L.Nil))),
	T.Int(0),
	T.Int(-1),
	T.Int(1073741823),
	T.Int(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.List(L.Nil);
		1 => return T.List(dl[0]);
		2 => return T.List(L.Cons(ks[0], L.Nil));
		3 => return T.List(L.Cons(ks[0], L.Cons(ks[1], L.Nil)));
		4 => return T.List(L.Cons(ks[0], L.Cons(ks[2], dl[0])));
		5 => return T.Int(xs[0]);
		6 => return T.Int(xs[1]);
		7 => return T.Int(xs[2]);
		_ => return T.Int(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.List.?(d)) r |= 16;
	if (T.Int.?(d)) r |= 32;
	return r;
}
