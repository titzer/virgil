//@execute 0=6; 1=5; 2=104; 3=-1
type F #unboxed {
	case A(f: Array<int> -> int);
	case S(f: string -> int);
	case N;
}

def sum(a: Array<int>) -> int {
	var s = 0;
	for (x in a) s += x;
	return s;
}
def len(s: string) => s.length;
def first(s: string) => int.view(s[0]);

def fa = [sum];
def fs = [len, first];

def mk(a: int) -> F {
	match (a) {
		0 => return F.A(fa[0]);
		1 => return F.S(fs[0]);
		2 => return F.S(fs[1]);
		_ => return F.N;
	}
}

def main(a: int) -> int {
	match (mk(a)) {
		A(f) => return f([1, 2, 3]);
		S(f) => return f("hello");
		N => return -1;
	}
}
