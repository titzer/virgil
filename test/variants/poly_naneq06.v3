//@execute 0=false; 1=false
// The reference fastpath for a polymorphic variant.
type Opt<X> {
	case Some(v: X);
	case None;
}
def CACHE: Array<Opt<float>> = [Opt<float>.Some(float.nan), Opt<float>.Some(float.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	var arr = Array<Opt<float>>.new(2);
	arr[0] = v;
	arr[1] = v;
	return arr[0] == arr[1];
}
