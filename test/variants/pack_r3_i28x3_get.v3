def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(134217727), T.I0(-134217728), T.I0(134217726), T.I0(-134217727), T.I0(89478485), T.I0(-89478486), T.I0(67108864), T.I0(-67108864), T.I0(19088743), T.I0(-124076833),
