//@execute 0=false; 1=false; 2=false; 3=false
// ub_naneq02 for double, and with the NaN in each component of the tuple in turn.
type T #unboxed {
	case P(v: (double, double));
	case I(x: int);
}
def CACHE: Array<T> = [
	T.P((1d, double.nan)),
	T.P((double.nan, 1d)),
	T.P((double.nan, double.nan)),
	T.P((-0d, double.nan))
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
