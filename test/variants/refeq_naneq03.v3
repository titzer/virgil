//@execute 0=true; 1=true
// A function-typed field compares by reference and is always reflexive, even when
// the function itself traffics in NaNs.
type T {
	case F(f: double -> double);
	case N;
}
def neg(x: double) -> double { return 0d - x; }
def CACHE: Array<T> = [T.F(neg), T.N];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
