//@execute 0=1; 1=3; 2=4
// As ub_dead_case00, but with the variant values allocated at initialization time.
class R(v: int) { }
type Op #unboxed {
	case A;
	case B(x: int);
	case C(r: R);
	case D(y: long);
}
class Holder(op: Op) { }
def visitA(x: Op.A) -> int { return 1; }
def visitB(x: Op.B) -> int { return x.x; }
def visitC(x: Op.C) -> int { return x.r.v; }
def visitD(x: Op.D) -> int { return 7; }
def visit(h: Holder) -> int {
	match (h.op) {
		x: Op.A => return visitA(x);
		x: Op.B => return visitB(x);
		x: Op.C => return visitC(x);
		x: Op.D => return visitD(x);
	}
}
def ops = [Op.A, Op.B(3), Op.C(R.new(4))];
def main(a: int) -> int {
	return visit(Holder.new(ops[a]));
}
