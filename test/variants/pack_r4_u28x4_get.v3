//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=41; 10=42; 11=-4; 12=0; 13=1; 14=2; 15=268435455; 16=268435454; 17=134217728; 18=134217727; 19=89478485; 20=178956970; 21=67108864; 22=201326592; 23=19088743; 24=144358622; 25=-1; 26=-2; 27=-3; 28=-268435456; 29=-268435455; 30=-134217729; 31=-134217728; 32=-89478486; 33=-178956971; 34=-67108865; 35=-201326593; 36=-19088744; 37=-144358623; 38=7; 39=8; 40=9; 41=268435462; 42=268435461; 43=134217735; 44=134217734; 45=89478492; 46=178956977; 47=67108871; 48=201326599; 49=19088750; 50=144358629; 51=0; 52=-1; 53=-2; 54=-268435455; 55=-268435454; 56=-134217728; 57=-134217727; 58=-89478485; 59=-178956970; 60=-67108864; 61=-201326592; 62=-19088743; 63=-144358622
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: u28);
	case I1(x: u28);
	case I2(x: u28);
	case I3(x: u28);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<u28> = [0, 1, 2, 268435455, 268435454, 134217728, 134217727, 89478485, 178956970, 67108864, 201326592, 19088743, 144358622];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(268435455), T.I0(268435454), T.I0(134217728), T.I0(134217727), T.I0(89478485), T.I0(178956970), T.I0(67108864), T.I0(201326592), T.I0(19088743), T.I0(144358622),
	T.I1(0), T.I1(1), T.I1(2), T.I1(268435455), T.I1(268435454), T.I1(134217728), T.I1(134217727), T.I1(89478485), T.I1(178956970), T.I1(67108864), T.I1(201326592), T.I1(19088743), T.I1(144358622),
	T.I2(0), T.I2(1), T.I2(2), T.I2(268435455), T.I2(268435454), T.I2(134217728), T.I2(134217727), T.I2(89478485), T.I2(178956970), T.I2(67108864), T.I2(201326592), T.I2(19088743), T.I2(144358622),
	T.I3(0), T.I3(1), T.I3(2), T.I3(268435455), T.I3(268435454), T.I3(134217728), T.I3(134217727), T.I3(89478485), T.I3(178956970), T.I3(67108864), T.I3(201326592), T.I3(19088743), T.I3(144358622)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
		I3(x) => return 0 - int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
