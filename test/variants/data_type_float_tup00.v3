//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=96; 6=96; 7=128
// A data type -- a case-less variant -- whose single field is a tuple of a float and a double.
type D(v: (float, double)) { }

def ts = [
	D((0f, 0d)),
	D((-0f, -0d)),
	D((0f, -0d)),
	D((float.nan, 1d)),
	D((1f, double.nan)),
	D((1f, 2d)),
	D((1f, 2d)),
	D((float.infinity, -double.infinity))
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
