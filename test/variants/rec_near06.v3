//@execute 0=true; 1=false; 2=true; 3=false; 4=true
type X #unboxed {
	case None;
	case IsY(y: Y);
}
type Y #unboxed {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy = X.IsY(yn), yx = Y.IsX(xn);
def main(a: int) -> bool {
	match (a) {
		0 => return xy == X.IsY(Y.None);
		1 => return xy == xn;
		2 => return yx == Y.IsX(X.None);
		3 => return yx == yn;
		_ => return xn.tag == 0 && xy.tag == 1 && yx.tag == 1;
	}
}
