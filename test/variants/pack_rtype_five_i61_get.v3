//@execute 0=10; 1=-1; 2=11; 3=-2; 4=12; 5=-3; 6=13; 7=-4; 8=14; 9=-5; 10=0; 11=1; 12=0; 13=-268435456; 14=-268435456; 15=1342177280; 16=1342177280
class C0(v: int) { }
class C1(v: int) { }
class C2(v: int) { }
class C3(v: int) { }
class C4(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case R2(x: C2);
	case R3(x: C3);
	case R4(x: C4);
	case I0(x: i61);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def r2: Array<C2> = [C2.new(12), null];
def r3: Array<C3> = [C3.new(13), null];
def r4: Array<C4> = [C4.new(14), null];
def xs: Array<i61> = [0, 1, -1, 1152921504606846975, -1152921504606846976, 384307168202282325, -384307168202282326];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.R2(r2[0]),
	T.R2(r2[1]),
	T.R3(r3[0]),
	T.R3(r3[1]),
	T.R4(r4[0]),
	T.R4(r4[1]),
	T.I0(0),
	T.I0(1),
	T.I0(-1),
	T.I0(1152921504606846975),
	T.I0(-1152921504606846976),
	T.I0(384307168202282325),
	T.I0(-384307168202282326)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.R2(r2[0]);
		5 => return T.R2(r2[1]);
		6 => return T.R3(r3[0]);
		7 => return T.R3(r3[1]);
		8 => return T.R4(r4[0]);
		9 => return T.R4(r4[1]);
		10 => return T.I0(xs[0]);
		11 => return T.I0(xs[1]);
		12 => return T.I0(xs[2]);
		13 => return T.I0(xs[3]);
		14 => return T.I0(xs[4]);
		15 => return T.I0(xs[5]);
		_ => return T.I0(xs[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x.v);
		R1(x) => return if(x == null, -2, x.v);
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		R4(x) => return if(x == null, -5, x.v);
		I0(x) => return int.view(x) ^ int.view(x >> 32);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
