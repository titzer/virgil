//@execute 0=817164816; 1=1727967248; 2=1354035728
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i63);
	case I1(x: i63);
}
def bases = [-16L, 4611686018427387887L, 2305843009213693936L];
def cell: Array<T> = [T.R("r"), T.R(null)];
def main(a: int) -> int {
	var acc = 0;
	for (d < 33) {
		var x = i63.view(bases[a] + d);
		cell[1] = if((d & 1) == 0, T.I0(x), T.I1(x));
		if (cell[1] == cell[0]) return -100;
		if (cell[1] == if((d & 1) == 0, T.I1(x), T.I0(x))) return -300;
		match (cell[1]) {
			R(s) => return -200;
			I0(y) => {
				if (y != x) return -1 - d;
				acc = acc * 31 + (int.view(y) ^ int.view(y >> 32));
			}
			I1(y) => {
				if (y != x) return -1 - d;
				acc = acc * 31 + ~(int.view(y) ^ int.view(y >> 32));
			}
		}
	}
	return acc;
}
