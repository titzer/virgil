//@execute 0=1; 1=-1; 2=0; 3=-2147483648; 4=2147483647; 5=1073741824; 6=-1073741855; 7=-1073741824; 8=1073741792; 9=2147483627; 10=2147483637
type T #unboxed #packed {
	case R(s: string);
	case P0(a: i32, b: i31);
}
def rs: Array<string> = ["r", null];
def f0a: Array<i32> = [0, -2147483648, 2147483647, 0, 0, -2147483648, 2147483647, 1431655765, -1431655766];
def f0b: Array<i31> = [0, 0, 0, -1073741824, 1073741823, -1073741824, 1073741823, 715827882, -715827883];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0),
	T.P0(-2147483648, 0),
	T.P0(2147483647, 0),
	T.P0(0, -1073741824),
	T.P0(0, 1073741823),
	T.P0(-2147483648, -1073741824),
	T.P0(2147483647, 1073741823),
	T.P0(1431655765, 715827882),
	T.P0(-1431655766, -715827883)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0]);
		3 => return T.P0(f0a[1], f0b[1]);
		4 => return T.P0(f0a[2], f0b[2]);
		5 => return T.P0(f0a[3], f0b[3]);
		6 => return T.P0(f0a[4], f0b[4]);
		7 => return T.P0(f0a[5], f0b[5]);
		8 => return T.P0(f0a[6], f0b[6]);
		9 => return T.P0(f0a[7], f0b[7]);
		_ => return T.P0(f0a[8], f0b[8]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		P0(a, b) => return int.view(a) + 31 * int.view(b) + 0;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
