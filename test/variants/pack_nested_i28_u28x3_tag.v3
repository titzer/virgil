//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=66; 11=66; 12=66; 13=66; 14=66; 15=66; 16=66; 17=66; 18=131; 19=131; 20=131; 21=131; 22=131; 23=131; 24=131; 25=131
type P #unboxed #packed {
	case X(a: i28);
	case Y(b: u28);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
	case N1(p: P);
	case N2(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i28> = [0, 1, -1, 134217727];
def xb: Array<u28> = [0, 1, 268435455, 134217728];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(134217727)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(268435455)),
	T.N0(P.Y(134217728)),
	T.N1(P.X(0)),
	T.N1(P.X(1)),
	T.N1(P.X(-1)),
	T.N1(P.X(134217727)),
	T.N1(P.Y(0)),
	T.N1(P.Y(1)),
	T.N1(P.Y(268435455)),
	T.N1(P.Y(134217728)),
	T.N2(P.X(0)),
	T.N2(P.X(1)),
	T.N2(P.X(-1)),
	T.N2(P.X(134217727)),
	T.N2(P.Y(0)),
	T.N2(P.Y(1)),
	T.N2(P.Y(268435455)),
	T.N2(P.Y(134217728))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.Y(xb[0]));
		7 => return T.N0(P.Y(xb[1]));
		8 => return T.N0(P.Y(xb[2]));
		9 => return T.N0(P.Y(xb[3]));
		10 => return T.N1(P.X(xa[0]));
		11 => return T.N1(P.X(xa[1]));
		12 => return T.N1(P.X(xa[2]));
		13 => return T.N1(P.X(xa[3]));
		14 => return T.N1(P.Y(xb[0]));
		15 => return T.N1(P.Y(xb[1]));
		16 => return T.N1(P.Y(xb[2]));
		17 => return T.N1(P.Y(xb[3]));
		18 => return T.N2(P.X(xa[0]));
		19 => return T.N2(P.X(xa[1]));
		20 => return T.N2(P.X(xa[2]));
		21 => return T.N2(P.X(xa[3]));
		22 => return T.N2(P.Y(xb[0]));
		23 => return T.N2(P.Y(xb[1]));
		24 => return T.N2(P.Y(xb[2]));
		_ => return T.N2(P.Y(xb[3]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.N0.?(d)) r |= 32;
	if (T.N1.?(d)) r |= 64;
	if (T.N2.?(d)) r |= 128;
	return r;
}
