//@execute 0=1; 1=-1; 2=0; 3=2097151; 4=65011681; 5=2015362111; 6=2082470943; 7=1366643712; 8=715827231
type T #unboxed #packed {
	case R(s: string);
	case P0(a: u21, b: u21, c: u21);
}
def rs: Array<string> = ["r", null];
def f0a: Array<u21> = [0, 2097151, 0, 0, 2097151, 1398101, 699050];
def f0b: Array<u21> = [0, 0, 2097151, 0, 2097151, 699050, 1398101];
def f0c: Array<u21> = [0, 0, 0, 2097151, 2097151, 1398101, 699050];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0, 0),
	T.P0(2097151, 0, 0),
	T.P0(0, 2097151, 0),
	T.P0(0, 0, 2097151),
	T.P0(2097151, 2097151, 2097151),
	T.P0(1398101, 699050, 1398101),
	T.P0(699050, 1398101, 699050)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0], f0c[0]);
		3 => return T.P0(f0a[1], f0b[1], f0c[1]);
		4 => return T.P0(f0a[2], f0b[2], f0c[2]);
		5 => return T.P0(f0a[3], f0b[3], f0c[3]);
		6 => return T.P0(f0a[4], f0b[4], f0c[4]);
		7 => return T.P0(f0a[5], f0b[5], f0c[5]);
		_ => return T.P0(f0a[6], f0b[6], f0c[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		P0(a, b, c) => return int.view(a) + 31 * int.view(b) + 961 * int.view(c) + 0;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
