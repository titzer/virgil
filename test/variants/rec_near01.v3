//@execute 0=1; 1=0; 2=1; 3=0; 4=0; 5=1
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy = X.IsY(yn), yx = Y.IsX(xn);
def isNone(x: X) -> bool {
	match (x) {
		None => return true;
		IsY(y) => return y == Y.None;
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return if(xn == X.None, 1, 0);
		1 => return if(xn == xy, 1, 0);
		2 => return if(xy == X.IsY(Y.None), 1, 0);
		3 => return if(yn == yx, 1, 0);
		4 => return if(isNone(X.IsY(yx)), 1, 0);
		_ => return if(isNone(xy), 1, 0);
	}
}
