//@execute 0=true; 1=true; 2=true; 3=true; 4=false; 5=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type B #unboxed {
	case None;
	case Ref(r: C);
	case I(x: int);
}
type A #unboxed {
	case None;
	case One(b: B);
}
def r1 = cs[0], r2 = cs[2];
def keep = [B.I(3), B.I(4)];
def vals = [A.One(B.None), A.One(B.Ref(r1)), A.One(B.I(3)), A.None, A.One(B.Ref(cs[1]))];
def mk(a: int) -> A {
	match (a) {
		0 => return A.One(B.None);
		1 => return A.One(B.Ref(r1));
		2 => return A.One(B.I(3));
		3 => return A.None;
		4 => return A.One(B.Ref(r2));
		_ => return A.One(B.I(4));
	}
}
def main(a: int) -> bool {
	var d = mk(a);
	return d == vals[a % 4];
}
