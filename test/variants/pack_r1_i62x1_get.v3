	T.I0(0), T.I0(1), T.I0(-1), T.I0(2305843009213693951), T.I0(-2305843009213693952), T.I0(2305843009213693950), T.I0(-2305843009213693951), T.I0(1537228672809129301), T.I0(-1537228672809129302), T.I0(1152921504606846976), T.I0(-1152921504606846976), T.I0(19088743), T.I0(-124076833)
