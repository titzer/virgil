//@execute 0=true; 1=false; 2=true; 3=true; 4=false; 5=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type B #unboxed {
	case None;
	case Box(c: C);
}
type A(b: B) #unboxed { }
def c1 = cs[0];
def bs = [B.None, B.Box(c1), B.Box(cs[2]), B.Box(cs[1])];
def main(a: int) -> bool {
	match (a) {
		0 => return A(bs[0]) == A(B.None);
		1 => return A(bs[0]) == A(bs[1]);
		2 => return A(bs[1]) == A(B.Box(c1));
		3 => return A(bs[2]) == A(B.Box(C.None));
		4 => return A(bs[2]) == A(bs[0]);
		_ => return A(bs[3]) == A(bs[1]);
	}
}
