//@execute 0=18; 1=27; 2=36
// Roots are overwritten in place between collections, cycling through all cases.
class C(x: int) { }

type T #unboxed #packed {
	case B(x: u8);
	case A(s: string);
	case C(c: C);
	def get() -> int {
		match (this) {
			B(x) => return x;
			A(s) => return s.length;
			C(c) => return c.x;
		}
	}
}

var roots = Array<T>.new(3);

def fill(a: int, round: int) {
	for (i < roots.length) {
		CiTest.forceGc();
		match ((i + round) % 3) {
			0 => roots[i] = T.B(u8.!(a + 1));
			1 => roots[i] = T.A(Array<byte>.new(a + 2));
			_ => roots[i] = T.C(C.new(a + 3));
		}
	}
}

def main(a: int) -> int {
	var sum = 0;
	for (round < 3) {
		fill(a, round);
		CiTest.forceGc();
		for (r in roots) sum += r.get();
	}
	return sum;
}
