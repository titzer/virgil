//@execute 0=-1520592975; 1=1078568823; 2=1306427933; 3=-699990109
type T #unboxed #packed {
	case R0(x: string);
	case R1(x: Array<int>);
	case I0(x: u30);
	case I1(x: u30);
}
def ring = Array<T>.new(8);
def r0 = "lcg", r1 = [7];
def check(v: T, k: int, x: u30) -> bool {
	match (v) {
		R0(y) => return k == 0 && y == r0;
		R1(y) => return k == 1 && y == r1;
		I0(y) => return k == 2 && y == x;
		I1(y) => return k == 3 && y == x;
	}
}
def main(a: int) -> int {
	var s = 88172645463325252L + a, acc = 0;
	for (i < 1000) {
		s = s * 6364136223846793005 + 1442695040888963407;
		var x = u30.view(s >> 34), k = int.view(s >> 8) & 3;
		var v: T;
		match (k) {
			0 => v = T.R0(r0);
			1 => v = T.R1(r1);
			2 => v = T.I0(x);
			_ => v = T.I1(x);
		}
		ring[i & 7] = v;
		var w = ring[i & 7];
		if (w != v || !check(w, k, x)) return -1 - i;
		if (k >= 2) acc = acc * 31 + int.view(x) + k;
	}
	return acc;
}
