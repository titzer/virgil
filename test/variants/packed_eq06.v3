//@execute 0=true; 1=false; 2=false; 3=false; 4=true
// Packed fields that straddle the 32-bit boundary of a 64-bit scalar.
type T #unboxed #packed {
	case A(x: u20, y: u20, z: u20);
	case B(w: u8);
}

def ts = [T.A(0xFFFFF, 0x12345, 0x54321), T.A(0xFFFFF, 0x12345, 0x54321), T.A(0xFFFFE, 0x12345, 0x54321), T.A(0xFFFFF, 0x12346, 0x54321), T.A(0xFFFFF, 0x12345, 0x54320)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[0] == ts[3];
		3 => return ts[0] == ts[4];
		_ => return ts[0] != ts[4];
	}
}
