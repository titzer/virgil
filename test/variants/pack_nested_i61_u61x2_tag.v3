//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33; 11=33; 12=33; 13=33; 14=66; 15=66; 16=66; 17=66; 18=66; 19=66; 20=66; 21=66; 22=66; 23=66; 24=66; 25=66
type P #unboxed #packed {
	case X(a: i61);
	case Y(b: u61);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
	case N1(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i61> = [0, 1, -1, 1152921504606846975, -1152921504606846976, 384307168202282325];
def xb: Array<u61> = [0, 1, 2305843009213693951, 1152921504606846976, 1152921504606846975, 1537228672809129301];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(1152921504606846975)),
	T.N0(P.X(-1152921504606846976)),
	T.N0(P.X(384307168202282325)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(2305843009213693951)),
	T.N0(P.Y(1152921504606846976)),
	T.N0(P.Y(1152921504606846975)),
	T.N0(P.Y(1537228672809129301)),
	T.N1(P.X(0)),
	T.N1(P.X(1)),
	T.N1(P.X(-1)),
	T.N1(P.X(1152921504606846975)),
	T.N1(P.X(-1152921504606846976)),
	T.N1(P.X(384307168202282325)),
	T.N1(P.Y(0)),
	T.N1(P.Y(1)),
	T.N1(P.Y(2305843009213693951)),
	T.N1(P.Y(1152921504606846976)),
	T.N1(P.Y(1152921504606846975)),
	T.N1(P.Y(1537228672809129301))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		13 => return T.N0(P.Y(xb[5]));
		14 => return T.N1(P.X(xa[0]));
		15 => return T.N1(P.X(xa[1]));
		16 => return T.N1(P.X(xa[2]));
		17 => return T.N1(P.X(xa[3]));
		18 => return T.N1(P.X(xa[4]));
		19 => return T.N1(P.X(xa[5]));
		20 => return T.N1(P.Y(xb[0]));
		21 => return T.N1(P.Y(xb[1]));
		22 => return T.N1(P.Y(xb[2]));
		23 => return T.N1(P.Y(xb[3]));
		24 => return T.N1(P.Y(xb[4]));
		_ => return T.N1(P.Y(xb[5]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.N0.?(d)) r |= 32;
	if (T.N1.?(d)) r |= 64;
	return r;
}
