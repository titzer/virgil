//@execute 0=16; 1=16; 2=16; 3=16; 4=33; 5=33; 6=66; 7=66
class P(v: int) { }
class A extends P {
	new(v: int) super(v) { }
}
class B extends P {
	new(v: int) super(v) { }
}
type T #unboxed #packed {
	case X(p: P);
	case Y(a: A);
	case Z(b: B);
}
def a0 = A.new(1), b0 = B.new(2);
def rp: Array<P> = [a0, b0, P.new(3), null];
def ra: Array<A> = [a0, null];
def rb: Array<B> = [b0, null];
def vs = [
	T.X(rp[0]),
	T.X(rp[1]),
	T.X(rp[2]),
	T.X(rp[3]),
	T.Y(ra[0]),
	T.Y(ra[1]),
	T.Z(rb[0]),
	T.Z(rb[1])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(rp[0]);
		1 => return T.X(rp[1]);
		2 => return T.X(rp[2]);
		3 => return T.X(rp[3]);
		4 => return T.Y(ra[0]);
		5 => return T.Y(ra[1]);
		6 => return T.Z(rb[0]);
		_ => return T.Z(rb[1]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.X.?(d)) r |= 16;
	if (T.Y.?(d)) r |= 32;
	if (T.Z.?(d)) r |= 64;
	return r;
}
