//@execute 0=false; 1=true; 2=true; 3=false
// `T.F`'s only field is the same constant NaN everywhere, so it is dropped and the
// whole variant normalizes down to a bare tag. Comparing tags alone would call two
// `T.F` values equal; the tag comparison has to be guarded by "and not F".
type T #unboxed {
	case F(x: double);
	case G;
	case H;
}
def CACHE: Array<T> = [T.F(double.nan), T.G, T.H, T.F(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
