//@execute (0,2)=9
type V {
	case X(i: int);
	case Y(i: int);
}
def compare(x: V, y: V) -> int {
	var a = x == x;
	var b = x == y;
	var c = y == x;
	var d = y == y;
	return	if(a, 0b0001) |
		if(b, 0b0010) |
		if(c, 0b0100) |
		if(d, 0b1000);
}
def d: V;
def xx = [d, V.X(0), V.X(11), V.Y(0)];
def main(a: int, b: int) -> int {
	return compare(xx[a], xx[b]);
}
