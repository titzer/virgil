//@execute 0=2; 1=-1; 2=-1073741824; 3=-1; 4=-1073741824; 5=-1
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i31);
	case I1(x: i31);
}
def vs = [T.R("s1"), T.R(null), T.I0(-1073741824), T.I0(-1), T.I1(1073741823), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def pick(sel: int, a: T, b: T, c: T, d: T, e: T, f: T, g: T, h: T) -> T {
	match (sel) {
		0 => return a;
		1 => return b;
		2 => return c;
		3 => return d;
		4 => return e;
		5 => return f;
		6 => return g;
		_ => return h;
	}
}
def main(a: int) -> int {
	var v = pick(a, vs[0], vs[1], vs[2], vs[3], vs[4], vs[5], vs[0], vs[1]);
	var w = pick(7 - a, vs[1], vs[0], vs[5], vs[4], vs[3], vs[2], vs[1], vs[0]);
	if (v != w) return -99;
	return get(v);
}
