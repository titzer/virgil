//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33; 11=33; 12=33; 13=33; 14=66; 15=66; 16=66; 17=66
type Q #unboxed #packed {
	case U(a: u13);
	case V(b: i13);
}
type P #unboxed #packed {
	case X(q: Q);
	case Y(c: u14);
}
type T #unboxed #packed {
	case R(s: string);
	case N(p: P);
	case M(x: i29);
}
def rs: Array<string> = ["r", null];
def xa: Array<u13> = [0, 1, 8191, 5461];
def xb: Array<i13> = [0, -1, 4095, -4096];
def xc: Array<u14> = [0, 1, 16383, 10922];
def xs: Array<i29> = [0, -1, 268435455, -268435456];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N(P.X(Q.U(0))),
	T.N(P.X(Q.U(1))),
	T.N(P.X(Q.U(8191))),
	T.N(P.X(Q.U(5461))),
	T.N(P.X(Q.V(0))),
	T.N(P.X(Q.V(-1))),
	T.N(P.X(Q.V(4095))),
	T.N(P.X(Q.V(-4096))),
	T.N(P.Y(0)),
	T.N(P.Y(1)),
	T.N(P.Y(16383)),
	T.N(P.Y(10922)),
	T.M(0),
	T.M(-1),
	T.M(268435455),
	T.M(-268435456)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N(P.X(Q.U(xa[0])));
		3 => return T.N(P.X(Q.U(xa[1])));
		4 => return T.N(P.X(Q.U(xa[2])));
		5 => return T.N(P.X(Q.U(xa[3])));
		6 => return T.N(P.X(Q.V(xb[0])));
		7 => return T.N(P.X(Q.V(xb[1])));
		8 => return T.N(P.X(Q.V(xb[2])));
		9 => return T.N(P.X(Q.V(xb[3])));
		10 => return T.N(P.Y(xc[0]));
		11 => return T.N(P.Y(xc[1]));
		12 => return T.N(P.Y(xc[2]));
		13 => return T.N(P.Y(xc[3]));
		14 => return T.M(xs[0]);
		15 => return T.M(xs[1]);
		16 => return T.M(xs[2]);
		_ => return T.M(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.N.?(d)) r |= 32;
	if (T.M.?(d)) r |= 64;
	return r;
}
