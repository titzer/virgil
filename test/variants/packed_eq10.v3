//@execute 0=1; 1=1; 2=7; 3=0
// Equality of packed variants constructed at runtime.
type T #unboxed #packed {
	case A(x: u8, y: u8);
	case B(z: u4);
}

def make(i: int) -> T {
	if (i < 4) return T.A(byte.view(i & 1), byte.view(i >> 1));
	return T.B(u4.view(i - 4));
}
def count(t: T, n: int) -> int {
	var c = 0;
	for (i < n) if (make(i) == t) c++;
	return c;
}
def countNe(t: T, n: int) -> int {
	var c = 0;
	for (i < n) if (make(i) != t) c++;
	return c;
}

def main(a: int) -> int {
	match (a) {
		0 => return count(T.A(0, 0), 8);
		1 => return count(T.B(2), 8);
		2 => return countNe(T.A(1, 1), 8);
		_ => return count(T.A(2, 0), 8);
	}
}
