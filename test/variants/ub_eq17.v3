//@execute 0=1; 1=2; 2=4; 3=8
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<int, float>> = [T.IsA(0), T.IsB(1f), T.IsA(-99), T.IsB(666.666f)];

def cmp = T<int, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
