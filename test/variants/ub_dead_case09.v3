//@execute 0=3; 1=12; 2=5
// A never-allocated case reached through a closure over its visit method.
class R(v: int) { }
type Op #unboxed {
	case A(r: R);
	case B(x: int, y: int);
	case D(y: long, r: R);
}
def visitD(x: Op.D) -> int { return x.r.v; }
def visit(op: Op) -> int {
	var fd = visitD;
	match (op) {
		x: Op.A => return x.r.v;
		x: Op.B => return x.x * x.y;
		x: Op.D => return fd(x);
	}
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A(R.new(3));
		1 => return Op.B(3, 4);
		_ => return Op.A(R.new(5));
	}
}
def main(a: int) -> int {
	return visit(make(a));
}
