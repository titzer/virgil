//@execute 0=137; 1=2; 2=4; 3=137; 4=16; 5=32; 6=64; 7=137; 8=!BoundsCheckException
class A { }
class B { }

type T #unboxed #packed {
	case IsA(x: A);
	case IsB(x: B);
	case IsInt(x: u31);
}

def vs = [T.IsInt(44), T.IsA(A.new()), T.IsB(null), T.IsInt(44), T.IsInt(5555555), T.IsA(A.new()), T.IsB(B.new()), T.IsInt(44)];

def main(a: int) -> int {
	var e = vs[a];

	var result = 0;
	for (i < vs.length) {
		var v = vs[i];
		if (v == e) result |= (1 << u5.view(i));
	}
	return result;
}