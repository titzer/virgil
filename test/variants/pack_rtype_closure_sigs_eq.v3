//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256
type T #unboxed #packed {
	case F(f: int -> int);
	case G(g: (int, int) -> int);
	case H(h: int -> int);
	case S(s: string);
	case I(x: i31);
}
def inc(x: int) -> int { return x + 1; }
def dec(x: int) -> int { return x - 1; }
def add(x: int, y: int) -> int { return x + y; }
def sub(x: int, y: int) -> int { return x - y; }
def fs = [inc, dec];
def gs = [add, sub];
def ss = ["abc"];
def xs: Array<i31> = [1073741823, -1073741824];
def vs = [T.F(inc), T.F(dec), T.G(add), T.G(sub), T.H(inc), T.H(dec), T.S(ss[0]), T.I(1073741823), T.I(-1073741824)];
def mk(i: int) -> T {
	match (i) {
		0 => return T.F(fs[0]);
		1 => return T.F(fs[1]);
		2 => return T.G(gs[0]);
		3 => return T.G(gs[1]);
		4 => return T.H(fs[0]);
		5 => return T.H(fs[1]);
		6 => return T.S(ss[0]);
		7 => return T.I(xs[0]);
		_ => return T.I(xs[1]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
