//@execute 0=true; 1=true; 2=true; 3=true; 4=true
// array_init02 for a double payload: a global constant array and a local one built
// from the same literals must lay out bit-for-bit the same.
type D(x: double) { }
def vals = [D(0d), D(1d), D(-2d), D(double.nan), D(double.infinity)];
def main(a: int) -> bool {
	def n = [D(0d), D(1d), D(-2d), D(double.nan), D(double.infinity)];
	return u64.view(vals[a].x) == u64.view(n[a].x);
}
