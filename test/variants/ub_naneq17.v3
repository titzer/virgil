//@execute 0=false; 1=true; 2=true
// The compared value arrives through a loop-carried phi rather than straight from
// the array load, so the comparison cannot be folded away by looking at one input.
type T #unboxed {
	case F(x: double);
	case I(y: int);
}
def CACHE: Array<T> = [T.F(double.nan), T.F(1d), T.I(3)];
def main(a: int) -> bool {
	var v = CACHE[2];
	for (i < 3) v = CACHE[a];
	return v == v;
}
