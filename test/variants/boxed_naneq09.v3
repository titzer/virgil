//@execute 0=false; 1=false
// The NaN is one level down, in a nested variant.
type Inner {
	case F(x: float);
	case I(x: int);
}
type Outer {
	case W(i: Inner);
	case N;
}
def CACHE: Array<Outer> = [Outer.W(Inner.F(float.nan)), Outer.W(Inner.F(float.nan))];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
