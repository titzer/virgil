//@execute 0=0; 1=3; 2=22; 3=-333333; 4=-23; 5=4444444
type T #unboxed #packed {
	case Obj(x: Array<int>);
	case A(x: i30);
	case B(x: i30);

	def val() -> int {
		match (this) {
			Obj(x) => return x.length;
			A(x) => return x;
			B(x) => return 0 - x;
		}
	}
}

def vs = [T.Obj([]), T.Obj([3, 4, 5]), T.A(22), T.A(-333333), T.B(23), T.B(-4444444)];

def main(a: int) -> int {
	return vs[a].val();
}
