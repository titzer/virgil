//@execute 0=69632; 1=2234441; 2=4399250; 3=6564059; 4=8728868; 5=10893677; 6=13042102; 7=14682623
type Reg { case A; case B; case C; case D; case E; case F; case G; case H; }
def REGS = [Reg.A, Reg.B, Reg.C, Reg.D, Reg.E, Reg.F, Reg.G, Reg.H];
def rtype(rs: Reg, rt: Reg, rd: Reg, sa: u5, funct: u6) -> int {
	return int.pack<(u6, u5, u5, u5, u5, u6)>((0, rs.tag, rt.tag, rd.tag, sa, funct));
}
def main(a: int) -> int {
	return rtype(REGS[a % 8], REGS[(a + 1) % 8], REGS[(a + 2) % 8], u5.view(a), u6.view(a * 9));
}
