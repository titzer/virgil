//@execute 0=10; 1=21; 2=8; 3=-2
type F #unboxed {
	case I(f: int -> int);
	case S(f: string -> int);

	def apply(v: int) -> int {
		match (this) {
			I(f) => return f(v);
			S(f) => return f("abc");
		}
	}
}

def add(x: int, y: int) => x + y;
def cat(s: string, n: int) => s.length + n;

def fs = [F.I(add(10, _)), F.I(add(_, 20)), F.S(cat(_, 5)), F.S(cat(_, -5))];

def main(a: int) -> int {
	return fs[a & 3].apply(a);
}
