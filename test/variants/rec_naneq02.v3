//@execute 0=false; 1=true
// Two mutually recursive variants; the double is only reachable by descending
// from A into B, so the cycle check must not cut the search short at A.
type A {
	case Wrap(b: B);
	case None;
}
type B {
	case Val(x: double, a: A);
	case Nil;
}
def CACHE: Array<A> = [
	A.Wrap(B.Val(double.nan, A.None)),
	A.Wrap(B.Val(1d, A.None))
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
