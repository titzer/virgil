//@execute 0=5; 1=5; 2=5; 16=5; 17=5; 18=5; 32=5; 33=5; 34=5; 48=5; 49=5; 50=5; 64=5; 65=5; 66=5; 67=5; 68=5; 69=5; 70=5; 71=5; 72=5; 73=5; 74=5; 75=5; 76=5; 80=!TypeCheckException
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: u31);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<u31> = [0, 1, 2, 2147483647, 2147483646, 1073741824, 1073741823, 1431655765, 715827882, 536870912, 1610612736, 19088743, 2023406814];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(2147483647), T.I0(2147483646), T.I0(1073741824), T.I0(1073741823), T.I0(1431655765), T.I0(715827882), T.I0(536870912), T.I0(1610612736), T.I0(19088743), T.I0(2023406814)
];
def idx = [0, 3, 6, 9, 12];
def main(a: int) -> int {
	var c = a / 16, k = a % 16, r = 0;
	if (c == 5) return int.view(T.I0.!(vs[0]).x);
	match (c) {
		0 => {
			var p = T.R0.!(vs[idx[c] + k]), q = T.R0(r0[k]), o = T.R0.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r0[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		1 => {
			var p = T.R1.!(vs[idx[c] + k]), q = T.R1(r1[k]), o = T.R1.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r1[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		2 => {
			var p = T.R2.!(vs[idx[c] + k]), q = T.R2(r2[k]), o = T.R2.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r2[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		3 => {
			var p = T.R3.!(vs[idx[c] + k]), q = T.R3(r3[k]), o = T.R3.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r3[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		_ => {
			var p = T.I0.!(vs[idx[c] + k]), q = T.I0(xs[k]), o = T.I0.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
	}
	return r;
}
