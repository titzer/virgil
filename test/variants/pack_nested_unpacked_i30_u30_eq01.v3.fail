//@execute 0=true; 1=true; 2=true; 3=true
// same, nested in a tuple
type P #unboxed {
	case X(a: i30);
	case Y(b: u30);
}
def xa: Array<i30> = [0, -1];
def xb: Array<u30> = [0, 7];
def vs = [(P.X(0), 0), (P.X(-1), 1), (P.Y(0), 2), (P.Y(7), 3)];
def main(a: int) -> bool {
	if (a < 2) return (P.X(xa[a]), a) == vs[a];
	return (P.Y(xb[a - 2]), a) == vs[a];
}
