//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096; 13=8192; 14=16384; 15=32768; 16=65536; 17=131072
class C0(v: int) { }
class C1(v: int) { }
type T #unboxed #packed {
	case R0(x: C0);
	case R1(x: C1);
	case I0(x: i30);
	case I1(x: i30);
}
def r0: Array<C0> = [C0.new(10), null];
def r1: Array<C1> = [C1.new(11), null];
def xs: Array<i30> = [0, 1, -1, 536870911, -536870912, 357913941, -357913942];
def vs = [
	T.R0(r0[0]),
	T.R0(r0[1]),
	T.R1(r1[0]),
	T.R1(r1[1]),
	T.I0(0),
	T.I0(1),
	T.I0(-1),
	T.I0(536870911),
	T.I0(-536870912),
	T.I0(357913941),
	T.I0(-357913942),
	T.I1(0),
	T.I1(1),
	T.I1(-1),
	T.I1(536870911),
	T.I1(-536870912),
	T.I1(357913941),
	T.I1(-357913942)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R0(r0[0]);
		1 => return T.R0(r0[1]);
		2 => return T.R1(r1[0]);
		3 => return T.R1(r1[1]);
		4 => return T.I0(xs[0]);
		5 => return T.I0(xs[1]);
		6 => return T.I0(xs[2]);
		7 => return T.I0(xs[3]);
		8 => return T.I0(xs[4]);
		9 => return T.I0(xs[5]);
		10 => return T.I0(xs[6]);
		11 => return T.I1(xs[0]);
		12 => return T.I1(xs[1]);
		13 => return T.I1(xs[2]);
		14 => return T.I1(xs[3]);
		15 => return T.I1(xs[4]);
		16 => return T.I1(xs[5]);
		_ => return T.I1(xs[6]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
