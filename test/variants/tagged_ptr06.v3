//@execute 0=3; 1=8275; 2=2097135; 3=5; 4=16
type T #unboxed #packed {
	case A(x: string);
	case B(a: u8, b: u8, c: bool, d: u4);
}

def ts = [T.A("abc"), T.B(1, 2, true, 3), T.B(255, 255, false, 15), T.A("defgh"), T.B(0, 0, true, 0)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(a, b, c, d) => return (int.!(a) << 13) | (int.!(b) << 5) | (if(c, 1, 0) << 4) | d;
	}
}
