//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096; 13=8192; 14=16384; 15=32768; 16=65536; 17=131072
type D #unboxed {
	case N;
	case S;
	case E;
	case W;
}
type T #unboxed #packed {
	case R(s: string);
	case M(d: D, x: i29);
}
def rs: Array<string> = ["r", null];
def ds = [D.N, D.S, D.E, D.W];
def xs: Array<i29> = [0, -1, 268435455, -268435456];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.M(D.N, 0),
	T.M(D.N, -1),
	T.M(D.N, 268435455),
	T.M(D.N, -268435456),
	T.M(D.S, 0),
	T.M(D.S, -1),
	T.M(D.S, 268435455),
	T.M(D.S, -268435456),
	T.M(D.E, 0),
	T.M(D.E, -1),
	T.M(D.E, 268435455),
	T.M(D.E, -268435456),
	T.M(D.W, 0),
	T.M(D.W, -1),
	T.M(D.W, 268435455),
	T.M(D.W, -268435456)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.M(ds[0], xs[0]);
		3 => return T.M(ds[0], xs[1]);
		4 => return T.M(ds[0], xs[2]);
		5 => return T.M(ds[0], xs[3]);
		6 => return T.M(ds[1], xs[0]);
		7 => return T.M(ds[1], xs[1]);
		8 => return T.M(ds[1], xs[2]);
		9 => return T.M(ds[1], xs[3]);
		10 => return T.M(ds[2], xs[0]);
		11 => return T.M(ds[2], xs[1]);
		12 => return T.M(ds[2], xs[2]);
		13 => return T.M(ds[2], xs[3]);
		14 => return T.M(ds[3], xs[0]);
		15 => return T.M(ds[3], xs[1]);
		16 => return T.M(ds[3], xs[2]);
		_ => return T.M(ds[3], xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
