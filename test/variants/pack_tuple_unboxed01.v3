//@execute 0=true; 1=true; 2=false; 3=true
type P #unboxed { case X(a: i30); case Y(b: u30); case Z; }
def xa: Array<i30> = [0, -1];
def xb: Array<u30> = [0, 7];
def vs = [(P.X(0), "a"), (P.Y(7), "b"), (P.Z, "c"), (P.Z, "c")];
def mk(a: int) -> (P, string) {
	match (a) {
		0 => return (P.X(xa[0]), vs[0].1);
		1 => return (P.Y(xb[1]), vs[1].1);
		2 => return (P.X(xa[1]), vs[2].1);
		_ => return (P.Z, vs[3].1);
	}
}
def main(a: int) -> bool {
	return mk(a) == vs[a];
}
