//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48; 6=64; 7=128
// ub_eq19's shape with the first type parameter instantiated to a tuple of a float and a double.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
	case IsBoth(x: A, y: B);
}

def ts: Array<T<(float, double), int>> = [
	T.IsBoth((0f, 0d), 0),
	T.IsBoth((-0f, -0d), 0),
	T.IsBoth((float.nan, 0d), 0),
	T.IsBoth((0f, double.nan), 0),
	T.IsBoth((float.view(0x00000001u), double.view(0x00000000_00000001uL)), 0),
	T.IsBoth((float.view(0x00000001u), double.view(0x00000000_00000001uL)), 0),
	T.IsA((0f, 0d)),
	T.IsB(0)
];

def cmp = T<(float, double), int>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
