//@execute 0=1; 1=5; 2=9
// Mirrors OpcodeVisitor: a field read of an unboxed variant dispatched to virtual methods.
type Op #unboxed {
	case A;
	case B(x: int);
	case C(x: int, y: int);
	case D(y: long);
}
class Operator(op: Op, k: int) { }
class Visitor {
	var result: int;
	def visit(o: Operator) {
		match (o.op) {
			x: Op.A => visitA(x, o.k);
			x: Op.B => visitB(x, o.k);
			x: Op.C => visitC(x, o.k);
			x: Op.D => visitD(x, o.k);
		}
	}
	def visitA(x: Op.A, k: int) { result = k; }
	def visitB(x: Op.B, k: int) { result = x.x + k; }
	def visitC(x: Op.C, k: int) { result = x.x + x.y + k; }
	def visitD(x: Op.D, k: int) { result = -1; }
}
class SubVisitor extends Visitor {
	def visitD(x: Op.D, k: int) { result = -2; }
}
def make(a: int) -> Operator {
	match (a) {
		0 => return Operator.new(Op.A, 1);
		1 => return Operator.new(Op.B(4), 1);
		_ => return Operator.new(Op.C(3, 5), 1);
	}
}
def main(a: int) -> int {
	var v: Visitor = if(a == 1, SubVisitor.new(), Visitor.new());
	v.visit(make(a));
	return v.result;
}
