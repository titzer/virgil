//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case X(a: A);
	case Y(b: B);
}
def ra: Array<A> = [A.new(11), A.new(12), null];
def rb: Array<B> = [B.new(21), B.new(22), null];
def vs = [
	T.X(ra[0]),
	T.X(ra[1]),
	T.X(ra[2]),
	T.Y(rb[0]),
	T.Y(rb[1]),
	T.Y(rb[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(ra[0]);
		1 => return T.X(ra[1]);
		2 => return T.X(ra[2]);
		3 => return T.Y(rb[0]);
		4 => return T.Y(rb[1]);
		_ => return T.Y(rb[2]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
