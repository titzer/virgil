//@execute 0=false; 1=false; 2=false; 3=false
// Float and double cases in one unboxed variant.
type T #unboxed {
	case F(x: float);
	case D(x: double);
	case B(x: float, y: double);
	case E;
}
def CACHE: Array<T> = [
	T.F(float.nan),
	T.D(double.nan),
	T.B(float.nan, 1d),
	T.B(1f, double.nan)
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
