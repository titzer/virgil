//@execute 0=false; 1=false; 2=false; 3=false
// The type parameter is instantiated to a tuple of a float and a double.
type Opt<X> {
	case Some(v: X);
	case None;
}
type UOpt<X> #unboxed {
	case Some(v: X);
	case None;
}
def BS: Array<Opt<(float, double)>> = [
	Opt<(float, double)>.Some((float.nan, 1d)),
	Opt<(float, double)>.Some((1f, double.nan))
];
def US: Array<UOpt<(float, double)>> = [
	UOpt<(float, double)>.Some((float.nan, 1d)),
	UOpt<(float, double)>.Some((1f, double.nan))
];
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, BS[i] == BS[i], US[i] == US[i]);
}
