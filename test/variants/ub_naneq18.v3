//@execute 0=false; 1=false
// Only `T.F` is ever constructed, so the variant is tagless, and its double payload
// is the same constant NaN everywhere, so the field is dropped from the
// representation entirely. The scalar-by-scalar comparison of what is left (the
// nonce) must not be allowed to answer `true`. ub_naneq00b with the NaN buried in a
// tuple field.
type T #unboxed {
	case F(nonce: int, v: (double, int));
	case I(x: int);
}
def CACHE: Array<T> = [T.F(11, (double.nan, 1)), T.F(22, (double.nan, 1))];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
