//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096; 13=8192; 14=16384; 15=32768
// fails on x86-64: nested tagged ref loses its tag bits
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type T #unboxed #packed {
	case A(p: P);
	case B(x: i31);
	case C(p: P);
}
def rs: Array<string> = ["r", null];
def xs: Array<i30> = [0, -1, 536870911, -536870912];
def ys: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.A(P.S(rs[0])),
	T.A(P.S(rs[1])),
	T.A(P.I(0)),
	T.A(P.I(-1)),
	T.A(P.I(536870911)),
	T.A(P.I(-536870912)),
	T.B(0),
	T.B(-1),
	T.B(1073741823),
	T.B(-1073741824),
	T.C(P.S(rs[0])),
	T.C(P.S(rs[1])),
	T.C(P.I(0)),
	T.C(P.I(-1)),
	T.C(P.I(536870911)),
	T.C(P.I(-536870912))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.A(P.S(rs[0]));
		1 => return T.A(P.S(rs[1]));
		2 => return T.A(P.I(xs[0]));
		3 => return T.A(P.I(xs[1]));
		4 => return T.A(P.I(xs[2]));
		5 => return T.A(P.I(xs[3]));
		6 => return T.B(ys[0]);
		7 => return T.B(ys[1]);
		8 => return T.B(ys[2]);
		9 => return T.B(ys[3]);
		10 => return T.C(P.S(rs[0]));
		11 => return T.C(P.S(rs[1]));
		12 => return T.C(P.I(xs[0]));
		13 => return T.C(P.I(xs[1]));
		14 => return T.C(P.I(xs[2]));
		_ => return T.C(P.I(xs[3]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
