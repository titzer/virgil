//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=0; 7=1; 8=2; 9=1073741823; 10=1073741822; 11=536870912; 12=536870911; 13=357913941; 14=715827882; 15=268435456; 16=805306368; 17=19088743; 18=949664990; 19=-1; 20=-2; 21=-3; 22=-1073741824; 23=-1073741823; 24=-536870913; 25=-536870912; 26=-357913942; 27=-715827883; 28=-268435457; 29=-805306369; 30=-19088744; 31=-949664991
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: u30);
	case I1(x: u30);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xs: Array<u30> = [0, 1, 2, 1073741823, 1073741822, 536870912, 536870911, 357913941, 715827882, 268435456, 805306368, 19088743, 949664990];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(1073741823), T.I0(1073741822), T.I0(536870912), T.I0(536870911), T.I0(357913941), T.I0(715827882), T.I0(268435456), T.I0(805306368), T.I0(19088743), T.I0(949664990),
	T.I1(0), T.I1(1), T.I1(2), T.I1(1073741823), T.I1(1073741822), T.I1(536870912), T.I1(536870911), T.I1(357913941), T.I1(715827882), T.I1(268435456), T.I1(805306368), T.I1(19088743), T.I1(949664990)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
