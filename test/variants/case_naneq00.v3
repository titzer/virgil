//@execute 0=false; 1=true; 2=true; 3=false
// Both operands are statically of the *case* type, so equality is lowered without
// any tag test; the payload comparison still has to be IEEE.
type T {
	case F(x: double, k: int);
	case I(y: int);
}
def CACHE: Array<T.F> = [
	T.F(double.nan, 1),
	T.F(0d, 1),
	T.F(-0d, 1),
	T.F(double.nan, 2)
];
def cmp(a: T.F, b: T.F) -> bool {
	return a == b;
}
def main(a: int) -> bool {
	var v = CACHE[a];
	return cmp(v, v);
}
