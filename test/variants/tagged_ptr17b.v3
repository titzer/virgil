//@execute 0=3; 1=1; 2=101; 3=2; 4=102; 5=3; 6=103; 7=4; 8=104; 9=5
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
	case C(x: u8);
	case D(x: u8);
	case E(x: u8);
}

def ts = [
	T.A("abc"),
	T.B(1),
	T.B(101),
	T.C(2),
	T.C(102),
	T.D(3),
	T.D(103),
	T.E(4),
	T.E(104),
	T.A("defgh")
];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(v) => return v;
		C(v) => return v;
		D(v) => return v;
		E(v) => return v;
	}
}
