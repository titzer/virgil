//@execute 0=3; 1=42; 2=5; 3=6
// A mutable global root holding a tagged variant, updated between collections.
type T #unboxed #packed {
	case A(s: string);
	case B(x: u8);
}

var g: T;

def get(t: T) -> int {
	match (t) {
		A(s) => return s.length;
		B(x) => return x;
	}
}

def main(a: int) -> int {
	g = T.A(Array<byte>.new(3));
	CiTest.forceGc();
	var r0 = get(g);
	g = T.B(42);
	CiTest.forceGc();
	var r1 = get(g);
	g = T.A(Array<byte>.new(5));
	CiTest.forceGc();
	CiTest.forceGc();
	var r2 = get(g);
	g = T.B(6);
	var r3 = get(g);
	match (a) {
		0 => return r0;
		1 => return r1;
		2 => return r2;
		_ => return r3;
	}
}
