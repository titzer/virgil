//@execute 0=1; 1=0; 2=0; 3=1; 4=!NullCheckException; 5=!NullCheckException
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f) => return u32.view(f(i32.view(v)));
			U(f) => return f(v);
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

var d: F;
def ns: Array<u32 -> u32> = [null];

def main(a: int) -> int {
	match (a) {
		0 => return if(d == F.S(null), 1, 0);
		1 => return if(d == F.U(ns[0]), 1, 0);
		2 => return d.tag;
		3 => return F.U(ns[0]).tag;
		4 => return int.view(F.U(ns[0]).apply(3));
		_ => return int.view(d.apply(4));
	}
}
