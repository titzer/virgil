//@execute 0=1; 1=2; 2=1; 3=3
// unequal_match00 for a boxed variant.
type T {
	case F(x: double);
	case I(y: int);
}
def CACHE: Array<T> = [T.F(double.nan), T.I(7), T.F(double.nan), T.F(1d)];
def main(a: int) -> int {
	var v = CACHE[a];
	match (v) {
		F(x) => {
			if (!T.F.?(v)) return -1;
			if (T.I.?(v)) return -2;
			return if(x != x, 1, 3);
		}
		I(y) => {
			if (!T.I.?(v)) return -3;
			return if(y == 7, 2, -4);
		}
	}
}
