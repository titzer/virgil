//@execute 0=true; 1=false; 2=true; 3=false
type E { case P; case Q; }
type B #unboxed {
	case None;
	case S(s: string);
	case IsE(e: E);
}
type A #unboxed {
	case IsB(b: B);
	case Pair(b: B, e: E);
}
def ss = ["x"];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.IsE(E.Q)) == A.IsB(B.IsE(E.Q));
		1 => return A.IsB(B.IsE(E.Q)) == A.IsB(B.S(ss[0]));
		2 => return A.Pair(B.None, E.P) == A.Pair(B.None, E.P);
		_ => return A.Pair(B.None, E.P) == A.Pair(B.S(ss[0]), E.P);
	}
}
