//@execute 0=3; 1=3; 2=0
// The full matrix at the case type: +0 and -0 agree, NaN agrees with nothing.
type T #unboxed {
	case F(x: double, k: int);
	case I(y: int);
}
def ts: Array<T.F> = [T.F(0d, 1), T.F(-0d, 1), T.F(double.nan, 1)];
def cmp(a: T.F, b: T.F) -> bool {
	return a == b;
}
def main(i: int) -> int {
	var l = ts[i], out = 0;
	for (j < ts.length) {
		if (cmp(l, ts[j])) out |= (1 << u5.view(j));
	}
	return out;
}
