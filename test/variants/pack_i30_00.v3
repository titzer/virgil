//@execute 0=2; -999=-42; 555=3; -222=4
type Val #unboxed #packed {
	case Str(s: string);
	case I30(x: i30);
}

def vs = [Val.Str("hello"), Val.Str("there"), Val.I30(0), Val.I30(555), Val.I30(-222)];

def main(a: i30) -> int {
	var e = Val.I30(a);
	for (i < vs.length) {
		if (e == vs[i]) return i;
	}
	return -42;
}
