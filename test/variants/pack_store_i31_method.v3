//@execute 0=2; 1=-1; 2=-1073741824; 3=-1; 4=-1073741824; 5=-1
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i31);
	case I1(x: i31);

	def val() -> int { return get(this); }
	def same(that: T) -> bool { return this == that; }
}
def vs = [T.R("s1"), T.R(null), T.I0(-1073741824), T.I0(-1), T.I1(1073741823), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	if (!vs[a].same(vs[a])) return -99;
	if (vs[a].same(vs[(a + 1) % vs.length])) return -98;
	return vs[a].val();
}
