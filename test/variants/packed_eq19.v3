//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false; 6=true
// Field-less cases of a packed variant, compared against constants and values built in code.
type T #unboxed #packed {
	case N;
	case M;
	case A(x: u8, y: u8);
}

def ts = [T.N, T.M, T.A(0, 0), T.A(1, 1)];

def mk(a: int) -> T {
	return if(a == 0, T.N, T.M);
}

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == T.N;
		1 => return ts[0] == T.M;
		2 => return ts[1] == T.M;
		3 => return ts[2] == T.N;
		4 => return ts[3] == T.A(1, 1);
		5 => return ts[1] == ts[2];
		_ => return mk(1) == ts[1];
	}
}
