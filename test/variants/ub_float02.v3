//@execute 0=0; 1=-2147483648; 2=2139095040; 3=-8388608; 4=1069547520; 5=-1077936128; 6=1; 7=-559038737
// Bit-exact round trip of the extreme float payloads through an unboxed case.
type T #unboxed {
	case I(val: u32);
	case F(val: float);
}

def ts = [
	T.F(0f), T.F(-0f),
	T.F(float.infinity), T.F(-float.infinity),
	T.F(1.5f), T.F(-1.5f),
	T.F(float.view(1u)),
	T.I(0xDEADBEEF)
];

def main(a: int) -> u32 {
	var v = ts[a & 7];
	match (v) {
		I(v) => return v;
		F(v) => return u32.view(v);
	}
}
