//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 32=6; 33=7; 34=8; 48=9; 49=10; 50=11; 64=12; 65=13; 66=14; 67=15; 68=16; 69=17; 70=18; 71=19; 72=20; 73=21; 74=22; 75=23; 76=24
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: i64);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<i64> = [0, 1, -1, 9223372036854775807, -9223372036854775808, 9223372036854775806, -9223372036854775807, 6148914691236517205, -6148914691236517206, 4611686018427387904, -4611686018427387904, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(9223372036854775807), T.I0(-9223372036854775808), T.I0(9223372036854775806), T.I0(-9223372036854775807), T.I0(6148914691236517205), T.I0(-6148914691236517206), T.I0(4611686018427387904), T.I0(-4611686018427387904), T.I0(19088743), T.I0(-124076833)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.R2(r2[k]);
		3 => return T.R3(r3[k]);
		_ => return T.I0(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
