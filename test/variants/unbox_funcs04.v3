//@execute 0=7; 1=3; 2=1009; 3=2
class C(k: int) {
	def add(x: int) => x + k;
	def big(x: long) => x + k;
}
class D(k: int) {
	def mul(x: int) => x * k;
}
type F #unboxed {
	case I(f: int -> int);
	case L(f: long -> long);

	def apply(v: int) -> int {
		match (this) {
			I(f) => return f(v);
			L(f) => return int.view(f(v)) + 1000;
		}
	}
}

def c = C.new(7), d = D.new(3);
def fs = [F.I(c.add), F.I(d.mul), F.L(c.big), F.I(C.new(-1).add)];

def main(a: int) -> int {
	return fs[a & 3].apply(a);
}
