//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=true; 6=!TypeCheckException
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
var dx: X;
var dy: Y;
def xy: X = X.IsY(Y.None);
def main(a: int) -> bool {
	match (a) {
		0 => return dx == X.None;
		1 => return dx == xy;
		2 => return X.None.?(dx);
		3 => return X.IsY.?(dx);
		4 => { var c = X.IsY.!(xy); return X.IsY.?(xy) && Y.None.?(c.y); }
		5 => return dy == Y.None && X.None.!(dx) == X.None;
		_ => return X.IsY.!(dx) == X.IsY.!(xy);
	}
}
