//@execute 0=3; 1=9; 2=5; 3=99
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
}
class Cell {
	var t: T;
}

def cell = Cell.new();

def get(t: T) -> int {
	match (t) {
		A(str) => return str.length;
		B(v) => return v;
	}
}

def main(a: int) -> int {
	cell.t = T.A("abc");
	var r0 = get(cell.t);
	cell.t = T.B(9);
	var r1 = get(cell.t);
	cell.t = T.A("defgh");
	var r2 = get(cell.t);
	cell.t = T.B(99);
	var r3 = get(cell.t);
	match (a) {
		0 => return r0;
		1 => return r1;
		2 => return r2;
		_ => return r3;
	}
}
