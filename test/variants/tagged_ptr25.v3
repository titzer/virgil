//@execute 0=3; 1=9; 2=5; 3=99
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
}
class Cell {
	var t: T;
}

def cell = Cell.new();

def get(t: T) -> int {
	match (t) {
		A(str) => return str.length;
		B(v) => return v;
	}
}

def set(t: T) -> Cell {
	cell.t = t;
	return cell;
}

def main(a: int) -> int {
	cell.t = T.A("abc");
	var r0 = get(cell.t);
	var c1 = set(T.B(9));
	var r1 = get(c1.t);
	var c2 = set(T.A("defgh"));
	var r2 = get(c2.t);
	var c3 = set(T.B(99));
	var r3 = get(c3.t);
	match (a) {
		0 => return r0;
		1 => return r1;
		2 => return r2;
		_ => return r3;
	}
}
