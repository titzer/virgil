//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 32=6; 33=7; 34=8; 35=9; 36=10; 37=11; 38=12; 39=13; 40=14; 41=15; 42=16; 43=17; 44=18; 48=19; 49=20; 50=21; 51=22; 52=23; 53=24; 54=25; 55=26; 56=27; 57=28; 58=29; 59=30; 60=31
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: i63);
	case I1(x: i63);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xs: Array<i63> = [0, 1, -1, 4611686018427387903, -4611686018427387904, 4611686018427387902, -4611686018427387903, 1537228672809129301, -1537228672809129302, 2305843009213693952, -2305843009213693952, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(4611686018427387903), T.I0(-4611686018427387904), T.I0(4611686018427387902), T.I0(-4611686018427387903), T.I0(1537228672809129301), T.I0(-1537228672809129302), T.I0(2305843009213693952), T.I0(-2305843009213693952), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(4611686018427387903), T.I1(-4611686018427387904), T.I1(4611686018427387902), T.I1(-4611686018427387903), T.I1(1537228672809129301), T.I1(-1537228672809129302), T.I1(2305843009213693952), T.I1(-2305843009213693952), T.I1(19088743), T.I1(-124076833)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.I0(xs[k]);
		_ => return T.I1(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
