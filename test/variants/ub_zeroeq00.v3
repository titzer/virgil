//@execute 0=true; 1=true; 2=true
// Signed zeros in an unboxed variant, in a float field, a double field and a tuple component.
type T #unboxed {
	case F(x: float);
	case D(x: double);
	case P(v: (float, double));
}
def POS: Array<T> = [T.F(0f), T.D(0d), T.P((0f, -0d))];
def NEG: Array<T> = [T.F(-0f), T.D(-0d), T.P((-0f, 0d))];
def main(a: int) -> bool {
	return POS[a] == NEG[a];
}
