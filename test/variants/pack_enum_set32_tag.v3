//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33
enum E { E0, E1, E2, E3, E4, E5, E6, E7, E8, E9, E10, E11, E12, E13, E14, E15, E16, E17, E18, E19, E20, E21, E22, E23, E24, E25, E26, E27, E28, E29, E30, E31 }
type T #unboxed #packed {
	case R(s: string);
	case S0(s: E.set);
}
def rs: Array<string> = ["r", null];
def ms = [0, 1, -1, -2147483648, 2147483647, 1431655765, -1431655766, -1985229329];
def set(m: int) -> E.set {
	var s: E.set;
	for (e in E.set.all) if (((m >> u6.view(e.tag)) & 1) != 0) s |= e;
	return s;
}
def bits(s: E.set) -> int {
	var r: int;
	for (e in s) r |= 1 << u6.view(e.tag);
	return r;
}
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.S0(set(ms[0])),
	T.S0(set(ms[1])),
	T.S0(set(ms[2])),
	T.S0(set(ms[3])),
	T.S0(set(ms[4])),
	T.S0(set(ms[5])),
	T.S0(set(ms[6])),
	T.S0(set(ms[7]))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.S0(set(ms[0]));
		3 => return T.S0(set(ms[1]));
		4 => return T.S0(set(ms[2]));
		5 => return T.S0(set(ms[3]));
		6 => return T.S0(set(ms[4]));
		7 => return T.S0(set(ms[5]));
		8 => return T.S0(set(ms[6]));
		_ => return T.S0(set(ms[7]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.S0.?(d)) r |= 32;
	return r;
}
