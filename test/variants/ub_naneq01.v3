//@execute 0=false; 1=false
// The same unboxed value written to two array slots and read back.
type T #unboxed {
	case F(x: float);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(float.nan), T.F(float.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	var arr = Array<T>.new(2);
	arr[0] = v;
	arr[1] = v;
	return arr[0] == arr[1];
}
