//@execute 0=true; 1=true; 2=true; 3=true; 4=true; 5=true
// array_init03 for a double payload.
type D(x: double) { }
def vals = [D(0d), D(-0d), D(1d), D(-1d), D(double.infinity), D(-double.infinity)];
def main(a: int) -> bool {
	def n = [D(0d), D(-0d), D(1d), D(-1d), D(double.infinity), D(-double.infinity)];
	return u64.view(vals[a].x) == u64.view(n[a].x);
}
