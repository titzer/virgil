//@execute 0=7; 1=-1; 2=8; 3=-2; 4=99; 5=-3; 6=2; 7=-4; 8=1; 9=-5
type T #unboxed #packed {
	case I(x: Array<int>);
	case L(x: Array<long>);
	case B(x: Array<byte>);
	case S(x: Array<string>);
	case Z(x: Array<bool>);
}
def ri: Array<Array<int>> = [[7], null];
def rl: Array<Array<long>> = [[8L], null];
def rb: Array<Array<byte>> = ["c", null];
def rs: Array<Array<string>> = [["dd"], null];
def rz: Array<Array<bool>> = [[true], null];
def vs = [
	T.I(ri[0]),
	T.I(ri[1]),
	T.L(rl[0]),
	T.L(rl[1]),
	T.B(rb[0]),
	T.B(rb[1]),
	T.S(rs[0]),
	T.S(rs[1]),
	T.Z(rz[0]),
	T.Z(rz[1])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.I(ri[0]);
		1 => return T.I(ri[1]);
		2 => return T.L(rl[0]);
		3 => return T.L(rl[1]);
		4 => return T.B(rb[0]);
		5 => return T.B(rb[1]);
		6 => return T.S(rs[0]);
		7 => return T.S(rs[1]);
		8 => return T.Z(rz[0]);
		_ => return T.Z(rz[1]);
	}
}
def get(v: T) -> int {
	match (v) {
		I(x) => return if(x == null, -1, x[0]);
		L(x) => return if(x == null, -2, int.view(x[0]));
		B(x) => return if(x == null, -3, int.view(x[0]));
		S(x) => return if(x == null, -4, x[0].length);
		Z(x) => return if(x == null, -5, if(x[0], 1, 0));
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
