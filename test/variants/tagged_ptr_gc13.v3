//@execute 0=12; 1=18; 2=24
// Two reference cases whose objects are allocated before, between, and after collections,
// stored into an array of arrays of variants.
class C(x: int) { }

type T #unboxed #packed {
	case A(s: string);
	case B(c: C);
	def get() -> int {
		match (this) {
			A(s) => return s.length;
			B(c) => return c.x;
		}
	}
}

def main(a: int) -> int {
	var outer = Array<Array<T>>.new(3);
	for (i < outer.length) {
		CiTest.forceGc();
		var inner = Array<T>.new(2);
		inner[0] = T.A(Array<byte>.new(a + 1));
		CiTest.forceGc();
		inner[1] = T.B(C.new(a + 3));
		outer[i] = inner;
	}
	CiTest.forceGc();
	var sum = 0;
	for (inner in outer) for (t in inner) sum += t.get();
	return sum;
}
