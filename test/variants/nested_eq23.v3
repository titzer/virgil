//@execute 0=true; 1=false; 2=false; 3=true; 4=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
def xs = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
type B #unboxed {
	case X(c: C);
	case Y(s: string);
}
type A #unboxed {
	case N(n: int);
	case IsB(b: B, n: int);
}
def ss = ["s"];
def ns = [5, 6];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.X(mkC(0)), ns[0]) == A.IsB(B.X(cs[0]), 5);
		1 => return A.IsB(B.X(mkC(0)), ns[0]) == A.IsB(B.X(cs[0]), 6);
		2 => return A.IsB(B.X(mkC(1)), ns[0]) == A.IsB(B.X(cs[0]), 5);
		3 => return A.N(ns[0]) == A.N(5);
		_ => return A.N(ns[0]) == A.IsB(B.Y(ss[0]), 5);
	}
}
