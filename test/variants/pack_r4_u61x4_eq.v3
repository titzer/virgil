//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 32=6; 33=7; 34=8; 48=9; 49=10; 50=11; 64=12; 65=13; 66=14; 67=15; 68=16; 69=17; 70=18; 71=19; 72=20; 73=21; 74=22; 75=23; 76=24; 80=25; 81=26; 82=27; 83=28; 84=29; 85=30; 86=31; 87=32; 88=33; 89=34; 90=35; 91=36; 92=37; 96=38; 97=39; 98=40; 99=41; 100=42; 101=43; 102=44; 103=45; 104=46; 105=47; 106=48; 107=49; 108=50; 112=51; 113=52; 114=53; 115=54; 116=55; 117=56; 118=57; 119=58; 120=59; 121=60; 122=61; 123=62; 124=63
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: u61);
	case I1(x: u61);
	case I2(x: u61);
	case I3(x: u61);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<u61> = [0, 1, 2, 2305843009213693951, 2305843009213693950, 1152921504606846976, 1152921504606846975, 1537228672809129301, 768614336404564650, 576460752303423488, 1729382256910270464, 19088743, 2305843009089617118];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(2305843009213693951), T.I0(2305843009213693950), T.I0(1152921504606846976), T.I0(1152921504606846975), T.I0(1537228672809129301), T.I0(768614336404564650), T.I0(576460752303423488), T.I0(1729382256910270464), T.I0(19088743), T.I0(2305843009089617118),
	T.I1(0), T.I1(1), T.I1(2), T.I1(2305843009213693951), T.I1(2305843009213693950), T.I1(1152921504606846976), T.I1(1152921504606846975), T.I1(1537228672809129301), T.I1(768614336404564650), T.I1(576460752303423488), T.I1(1729382256910270464), T.I1(19088743), T.I1(2305843009089617118),
	T.I2(0), T.I2(1), T.I2(2), T.I2(2305843009213693951), T.I2(2305843009213693950), T.I2(1152921504606846976), T.I2(1152921504606846975), T.I2(1537228672809129301), T.I2(768614336404564650), T.I2(576460752303423488), T.I2(1729382256910270464), T.I2(19088743), T.I2(2305843009089617118),
	T.I3(0), T.I3(1), T.I3(2), T.I3(2305843009213693951), T.I3(2305843009213693950), T.I3(1152921504606846976), T.I3(1152921504606846975), T.I3(1537228672809129301), T.I3(768614336404564650), T.I3(576460752303423488), T.I3(1729382256910270464), T.I3(19088743), T.I3(2305843009089617118)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.R2(r2[k]);
		3 => return T.R3(r3[k]);
		4 => return T.I0(xs[k]);
		5 => return T.I1(xs[k]);
		6 => return T.I2(xs[k]);
		_ => return T.I3(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
