//@execute 0=1; 1=6; 2=6; 3=8; 4=16; 5=0; 6=64; 7=128
// ub_eq19 for a 64-bit payload.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<long, double>> = [
	T.IsA(0L),
	T.IsB(0d),
	T.IsB(-0d),
	T.IsB(double.view(0x00000000_00000001uL)),	// smallest positive subnormal
	T.IsB(double.view(0x800FFFFF_FFFFFFFFuL)),	// largest negative subnormal
	T.IsB(double.nan),
	T.IsA(long.view(0x80000000_00000000uL)),
	T.IsB(1d)
];

def cmp = T<long, double>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
