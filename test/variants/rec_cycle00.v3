//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false; 6=true; 7=false
type A {
	case None;
	case IsB(v: B);
}
type B {
	case None;
	case IsC(v: C);
}
type C {
	case None;
	case IsD(v: D);
}
type D {
	case None;
	case IsA(v: A);
}
def an = A.None, bn = B.None, cn = C.None, dn = D.None;
def ab = A.IsB(bn), bc = B.IsC(cn), cd = C.IsD(dn), da = D.IsA(an);
def main(a: int) -> bool {
	match (a) {
		0 => return ab == A.IsB(B.None);
		1 => return ab == an;
		2 => return bc == B.IsC(C.None);
		3 => return bc == bn;
		4 => return cd == C.IsD(D.None);
		5 => return cd == cn;
		6 => return da == D.IsA(A.None);
		_ => return da == dn;
	}
}
