//@execute 0=1; 1=1; 2=1; 3=1; 4=!TypeCheckException
type T #unboxed #packed {
	case R(s: string);
	case P(a: i30, b: bool);
}
def fa: Array<i30> = [0, -536870912, 536870911, -1];
def fb = [false, true, false, true];
def vs = [T.P(0, false), T.P(-536870912, true), T.P(536870911, false), T.P(-1, true), T.R("r")];
def main(a: int) -> int {
	var p = T.P.!(vs[a]), n = (a + 1) & 3, r = 0;
	if (p == T.P(fa[a], fb[a])) r |= 1;
	if (p.a != fa[a]) r |= 2;
	if (p.a == fa[n]) r |= 4;
	if (p == T.P(fa[n], fb[a])) r |= 8;
	if (p.b != fb[a]) r |= 16;
	if (p == T.P(fa[a], fb[n])) r |= 32;
	return r;
}
