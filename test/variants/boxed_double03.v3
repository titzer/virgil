//@execute 8=0; 9=-2147483648; 10=2146435072; 11=-1048576; 12=1073217536; 13=-1074266112; 14=0; 15=-559038737
// Bit-exact round trip of the extreme double payloads through an unboxed case.
type T {
	case L(val: u64);
	case D(val: double);
}

def ts = [
	T.D(0d), T.D(-0d),
	T.D(double.infinity), T.D(-double.infinity),
	T.D(1.5d), T.D(-1.5d),
	T.D(double.view(1uL)),
	T.L(0xDEADBEEF_CAFEBABE)
];

def main(a: int) -> int {
	var v = ts[a & 7];
	var l: u64;
	match (v) {
		L(v) => l = u64.view(v);
		D(v) => l = u64.view(v);
	}
	return int.view(l >> 32);
}
