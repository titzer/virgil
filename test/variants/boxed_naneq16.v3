//@execute 0=false; 1=false; 2=false; 3=false
// NaNs that are not the canonical quiet NaN.
type T {
	case F(x: float);
	case I(x: int);
}
def CACHE: Array<T> = [
	T.F(float.view(0x7F800001u)),
	T.F(float.view(0xFFC00000u)),
	T.F(float.view(0x7FC00001u)),
	T.F(float.view(0xFFFFFFFFu))
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
