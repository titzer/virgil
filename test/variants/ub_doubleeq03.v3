//@execute 0=1; 1=2; 2=12; 3=12; 4=16; 5=32; 6=0; 7=128
// A u64 case beside a double case, with integer payloads aliasing the double bit patterns.
type T #unboxed {
	case L(v: u64);
	case D(v: double);
}

def ts = [
	T.L(0), T.L(0x80000000_00000000),
	T.D(0d), T.D(-0d),
	T.D(double.infinity), T.D(-double.infinity),
	T.D(double.nan), T.D(1d)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
