//@execute 0=0; 1=101; 2=2; 3=103
class A(v: int) { }
class B extends A {
	new(v: int) super(v) { }
}
type F #unboxed {
	case G(f: B -> int);
	case H(f: int -> A);

	def apply(v: int) -> int {
		match (this) {
			G(f) => return f(B.new(v));
			H(f) => return f(v).v + 100;
		}
	}
}

def getA(a: A) => a.v;
def mkB(v: int) -> B { return B.new(v); }

def fs = [F.G(getA), F.H(mkB)];

def main(a: int) -> int {
	return fs[a & 1].apply(a);
}
