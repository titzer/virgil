//@execute 0=true; 1=false; 2=true; 3=true; 4=true; 5=false
type X {
	case None;
	case IsY(y: Y);
	case Num(v: int);
}
type Y {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy = X.IsY(yn), yx = Y.IsX(xn);
def xs = [X.Num(7), X.Num(-7)];
def val(x: X) -> int {
	match (x) {
		Num(v) => return v;
		_ => return 0;
	}
}
def main(a: int) -> bool {
	match (a) {
		0 => return xy == X.IsY(Y.None);
		1 => return xy == xn;
		2 => return yx == Y.IsX(X.None);
		3 => return val(xs[0]) == 7;
		4 => return val(xs[1]) == -7;
		_ => return xs[0] == xs[1];
	}
}
