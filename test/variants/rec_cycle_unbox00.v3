//@execute =true
type A { case None; case IsB(v: B); }
type B { case None; case IsC(v: C); }
type C { case None; case IsA(v: A); }
def an = A.None, bn = B.None, cn = C.None;
def ab = A.IsB(bn), bc = B.IsC(cn), ca = C.IsA(an);
def main() -> bool {
	return ca == C.IsA(an) && bc == B.IsC(cn) && ab == A.IsB(bn);
}
