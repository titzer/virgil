//@execute 0=1; 1=2; 2=3
// Never-allocated cases matched by name, with unused bindings, and with a default.
type Op #unboxed {
	case A(x: int);
	case B(x: long);
	case C(x: int, y: int);
	case D(y: long);
}
def f(op: Op) -> int {
	match (op) {
		A(x) => return x;
		B(x) => return int.view(x);
		C(x, y) => return x + y;
		D(y) => return -1;
	}
}
def g(op: Op) -> int {
	match (op) {
		x: Op.D => return -1;
		x: Op.C => return -2;
		_ => return f(op);
	}
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A(1);
		1 => return Op.B(2);
		_ => return Op.A(3);
	}
}
def main(a: int) -> int {
	return g(make(a));
}
