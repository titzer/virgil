//@execute 0=1; 1=-1; 2=0; 3=-536870912; 4=536870911; 5=31; 6=536870942; 7=357913972; 8=-357913942
type T #unboxed #packed {
	case R(s: string);
	case P0(a: i30, b: bool);
}
def rs: Array<string> = ["r", null];
def f0a: Array<i30> = [0, -536870912, 536870911, 0, 536870911, 357913941, -357913942];
def f0b = [false, false, false, true, true, true, false];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, false),
	T.P0(-536870912, false),
	T.P0(536870911, false),
	T.P0(0, true),
	T.P0(536870911, true),
	T.P0(357913941, true),
	T.P0(-357913942, false)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0]);
		3 => return T.P0(f0a[1], f0b[1]);
		4 => return T.P0(f0a[2], f0b[2]);
		5 => return T.P0(f0a[3], f0b[3]);
		6 => return T.P0(f0a[4], f0b[4]);
		7 => return T.P0(f0a[5], f0b[5]);
		_ => return T.P0(f0a[6], f0b[6]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		P0(a, b) => return int.view(a) + 31 * if(b, 1, 0) + 0;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
