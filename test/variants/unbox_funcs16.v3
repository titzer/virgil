//@execute 0=-15; 1=-14; 2=-7; 3=2147483641
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f) => return u32.view(f(i32.view(v)));
			U(f) => return f(v);
		}
	}
}

def fs = [
	F.S(fun (x: i32) => x + 1),
	F.U(fun (x: u32) => x + 1),
	F.S(fun (x: i32) => x >> 1),
	F.U(fun (x: u32) => x >> 1)
];

def main(a: int) -> int {
	return int.view(fs[a & 3].apply(u32.view(a - 16)));
}
