//@execute 0=true; 1=true; 2=false; 3=true; 4=false; 5=true
type C {
	case None;
	case Val(x: int);
}
type B #unboxed {
	case X(c: C);
	case Y(s: string);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def cs = [C.Val(1), C.Val(2), C.None];
def ss = ["s", "t"];
def xs = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.X(mkC(0))) == A.IsB(B.X(cs[0]));
		1 => return A.IsB(B.X(mkC(2))) == A.IsB(B.X(C.None));
		2 => return A.IsB(B.X(mkC(1))) == A.IsB(B.X(cs[0]));
		3 => return A.IsB(B.Y(ss[0])) == A.IsB(B.Y(ss[0]));
		4 => return A.IsB(B.Y(ss[0])) == A.IsB(B.Y(ss[1]));
		_ => return (A.IsB(B.X(mkC(0))), 1) == (A.IsB(B.X(cs[0])), 1);
	}
}
