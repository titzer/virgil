//@execute 0=20; 1=11; 2=0; 3=23; 4=44; 5=3
type F #unboxed {
	case P(f: (int, int) -> (int, int));
	case Q(f: int -> (int, int));
	case R(f: (int, int) -> int);

	def apply(v: int) -> int {
		match (this) {
			P(f) => {
				var t = f(v, 2);
				return t.0 * 10 + t.1;
			}
			Q(f) => {
				var t = f(v);
				return t.0 * 10 + t.1;
			}
			R(f) => return f(v, 2);
		}
	}
}

def swap(a: int, b: int) => (b, a);
def dup(a: int) => (a, a);
def sub(a: int, b: int) => a - b;

def fs = [F.P(swap), F.Q(dup), F.R(sub)];

def main(a: int) -> int {
	return fs[a % 3].apply(a);
}
