//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128
enum E(v: int) { A(100), B(-200), C(300) }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E);
	case Y(e: E);
}
def rs: Array<string> = ["r", null];
def es = [E.A, E.B, E.C];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.A),
	T.X(E.B),
	T.X(E.C),
	T.Y(E.A),
	T.Y(E.B),
	T.Y(E.C)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0]);
		3 => return T.X(es[1]);
		4 => return T.X(es[2]);
		5 => return T.Y(es[0]);
		6 => return T.Y(es[1]);
		_ => return T.Y(es[2]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
