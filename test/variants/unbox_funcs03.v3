//@execute 0=1101; 1=1002102; 5=5006106
type F #unboxed {
	case V(f: void -> void);
	case G(f: void -> int);
	case S(f: int -> void);

	def run(v: int) -> int {
		match (this) {
			V(f) => f();
			G(f) => return f() + 100;
			S(f) => f(v);
		}
		return count;
	}
}

var count = 0;
def bump() { count++; }
def get() => count;
def set(x: int) { count = x; }

def fs = [F.S(set), F.V(bump), F.G(get)];

def main(a: int) -> int {
	count = 0;
	var r = 0;
	for (f in fs) r = r * 1000 + f.run(a);
	return r;
}
