//@execute 0=5; 1=5; 2=5; 16=5; 17=5; 18=5; 19=5; 20=5; 21=5; 22=5; 23=5; 24=5; 25=5; 26=5; 27=5; 28=5; 32=!TypeCheckException
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: i31);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<i31> = [0, 1, -1, 1073741823, -1073741824, 1073741822, -1073741823, 357913941, -357913942, 536870912, -536870912, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(1073741823), T.I0(-1073741824), T.I0(1073741822), T.I0(-1073741823), T.I0(357913941), T.I0(-357913942), T.I0(536870912), T.I0(-536870912), T.I0(19088743), T.I0(-124076833)
];
def idx = [0, 3];
def main(a: int) -> int {
	var c = a / 16, k = a % 16, r = 0;
	if (c == 2) return int.view(T.I0.!(vs[0]).x);
	match (c) {
		0 => {
			var p = T.R0.!(vs[idx[c] + k]), q = T.R0(r0[k]), o = T.R0.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r0[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		_ => {
			var p = T.I0.!(vs[idx[c] + k]), q = T.I0(xs[k]), o = T.I0.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
	}
	return r;
}
