//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33
type T #unboxed #packed {
	case R(s: string);
	case P0(a: i40, b: i23);
}
def rs: Array<string> = ["r", null];
def f0a: Array<i40> = [0, -549755813888, 549755813887, 0, 0, -549755813888, 549755813887, 366503875925, -366503875926];
def f0b: Array<i23> = [0, 0, 0, -4194304, 4194303, -4194304, 4194303, 2796202, -2796203];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.P0(0, 0),
	T.P0(-549755813888, 0),
	T.P0(549755813887, 0),
	T.P0(0, -4194304),
	T.P0(0, 4194303),
	T.P0(-549755813888, -4194304),
	T.P0(549755813887, 4194303),
	T.P0(366503875925, 2796202),
	T.P0(-366503875926, -2796203)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.P0(f0a[0], f0b[0]);
		3 => return T.P0(f0a[1], f0b[1]);
		4 => return T.P0(f0a[2], f0b[2]);
		5 => return T.P0(f0a[3], f0b[3]);
		6 => return T.P0(f0a[4], f0b[4]);
		7 => return T.P0(f0a[5], f0b[5]);
		8 => return T.P0(f0a[6], f0b[6]);
		9 => return T.P0(f0a[7], f0b[7]);
		_ => return T.P0(f0a[8], f0b[8]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.P0.?(d)) r |= 32;
	return r;
}
