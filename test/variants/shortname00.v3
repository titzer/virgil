//@execute 0=1; 1=7; 2=2
// A variant may declare its own shortName method or field.
type T {
	case A;
	def shortName() -> int { return 1; }
}
type V {
	case B(shortName: int);
}
type U(shortName: int) #unboxed { }
def main(a: int) -> int {
	match (a) {
		0 => return T.A.shortName();
		1 => return V.B(7).shortName;
	}
	return U(2).shortName;
}
