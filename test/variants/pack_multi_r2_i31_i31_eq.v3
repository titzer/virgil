//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096
type T #unboxed #packed {
	case R(s: string);
	case Q(q: Array<int>);
	case P0(a: i31, b: i31);
}
def rs: Array<string> = ["r", null];
def rq: Array<Array<int>> = [[1, 2], null];
def f0a: Array<i31> = [0, -1073741824, 1073741823, 0, 0, -1073741824, 1073741823, -715827883, 715827882];
def f0b: Array<i31> = [0, 0, 0, -1073741824, 1073741823, -1073741824, 1073741823, 715827882, -715827883];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.Q(rq[0]),
	T.Q(rq[1]),
	T.P0(0, 0),
	T.P0(-1073741824, 0),
	T.P0(1073741823, 0),
	T.P0(0, -1073741824),
	T.P0(0, 1073741823),
	T.P0(-1073741824, -1073741824),
	T.P0(1073741823, 1073741823),
	T.P0(-715827883, 715827882),
	T.P0(715827882, -715827883)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.Q(rq[0]);
		3 => return T.Q(rq[1]);
		4 => return T.P0(f0a[0], f0b[0]);
		5 => return T.P0(f0a[1], f0b[1]);
		6 => return T.P0(f0a[2], f0b[2]);
		7 => return T.P0(f0a[3], f0b[3]);
		8 => return T.P0(f0a[4], f0b[4]);
		9 => return T.P0(f0a[5], f0b[5]);
		10 => return T.P0(f0a[6], f0b[6]);
		11 => return T.P0(f0a[7], f0b[7]);
		_ => return T.P0(f0a[8], f0b[8]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
