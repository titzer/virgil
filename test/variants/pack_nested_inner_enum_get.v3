//@execute 0=1; 1=-1; 2=0; 3=-49155; 4=2147423574; 5=-2147472725; 6=2147483647; 7=2147418112; 8=-73728; 9=8191
enum E { A, B, C, D }
type P #unboxed #packed {
	case X(e: E, a: u12);
	case Y(b: i14);
}
type T #unboxed #packed {
	case R(s: string);
	case N(p: P, z: i16);
}
def rs: Array<string> = ["r", null];
def es = [E.A, E.B, E.C, E.D];
def xa: Array<u12> = [0, 4095, 1365, 2730];
def xb: Array<i14> = [0, -1, 8191, -8192];
def xz: Array<i16> = [0, -1, 32767, -32768];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N(P.X(E.A, 0), 0),
	T.N(P.X(E.B, 4095), -1),
	T.N(P.X(E.C, 1365), 32767),
	T.N(P.X(E.D, 2730), -32768),
	T.N(P.Y(0), -32768),
	T.N(P.Y(-1), 32767),
	T.N(P.Y(8191), -1),
	T.N(P.Y(-8192), 0)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N(P.X(es[0], xa[0]), xz[0]);
		3 => return T.N(P.X(es[1], xa[1]), xz[1]);
		4 => return T.N(P.X(es[2], xa[2]), xz[2]);
		5 => return T.N(P.X(es[3], xa[3]), xz[3]);
		6 => return T.N(P.Y(xb[0]), xz[3]);
		7 => return T.N(P.Y(xb[1]), xz[2]);
		8 => return T.N(P.Y(xb[2]), xz[1]);
		_ => return T.N(P.Y(xb[3]), xz[0]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N(p, z) => match (p) {
			X(e, a) => return a * 4 + e.tag + 65536 * z;
			Y(b) => return ~int.view(b) + 65536 * z;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
