//@execute 0=5; 1=5; 2=5; 16=5; 17=5; 18=5; 19=5; 20=5; 21=5; 22=5; 23=5; 24=5; 25=5; 26=5; 27=5; 28=5; 32=5; 33=5; 34=5; 35=5; 36=5; 37=5; 38=5; 39=5; 40=5; 41=5; 42=5; 43=5; 44=5; 48=5; 49=5; 50=5; 51=5; 52=5; 53=5; 54=5; 55=5; 56=5; 57=5; 58=5; 59=5; 60=5; 64=!TypeCheckException
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: i29);
	case I1(x: i29);
	case I2(x: i29);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<i29> = [0, 1, -1, 268435455, -268435456, 268435454, -268435455, 89478485, -89478486, 134217728, -134217728, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(268435455), T.I0(-268435456), T.I0(268435454), T.I0(-268435455), T.I0(89478485), T.I0(-89478486), T.I0(134217728), T.I0(-134217728), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(268435455), T.I1(-268435456), T.I1(268435454), T.I1(-268435455), T.I1(89478485), T.I1(-89478486), T.I1(134217728), T.I1(-134217728), T.I1(19088743), T.I1(-124076833),
	T.I2(0), T.I2(1), T.I2(-1), T.I2(268435455), T.I2(-268435456), T.I2(268435454), T.I2(-268435455), T.I2(89478485), T.I2(-89478486), T.I2(134217728), T.I2(-134217728), T.I2(19088743), T.I2(-124076833)
];
def idx = [0, 3, 16, 29];
def main(a: int) -> int {
	var c = a / 16, k = a % 16, r = 0;
	if (c == 4) return int.view(T.I0.!(vs[0]).x);
	match (c) {
		0 => {
			var p = T.R0.!(vs[idx[c] + k]), q = T.R0(r0[k]), o = T.R0.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r0[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		1 => {
			var p = T.I0.!(vs[idx[c] + k]), q = T.I0(xs[k]), o = T.I0.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		2 => {
			var p = T.I1.!(vs[idx[c] + k]), q = T.I1(xs[k]), o = T.I1.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		_ => {
			var p = T.I2.!(vs[idx[c] + k]), q = T.I2(xs[k]), o = T.I2.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
	}
	return r;
}
