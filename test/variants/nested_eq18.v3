//@execute 0=false; 1=true; 2=true; 3=true; 4=true; 5=false; 6=false
type B #unboxed {
	case F(f: float);
	case I(x: int);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def fs = [float.nan, 0f, -0f];
def is = [0, 1];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.F(fs[0])) == A.IsB(B.F(fs[0]));
		1 => return A.IsB(B.F(fs[1])) == A.IsB(B.F(fs[2]));
		2 => return A.IsB(B.F(fs[1])) == A.IsB(B.F(fs[1]));
		3 => return A.IsB(B.I(is[0])) == A.IsB(B.I(is[0]));
		4 => return A.None == A.None;
		5 => return A.IsB(B.I(is[0])) == A.IsB(B.F(fs[1]));
		_ => return A.IsB(B.I(is[1])) == A.IsB(B.I(is[0]));
	}
}
