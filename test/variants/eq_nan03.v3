//@execute 0=false; 1=false
// eq_nan00 for double: the payload is a runtime value, not a constant, so the two
// freshly built variants hold identical bits and still must not be equal.
type F {
	case M(x: double);
}
def NANS: Array<double> = [double.nan, double.nan];
def main(a: int) -> bool {
	var x = NANS[a];			// runtime value, not a constant
	return F.M(x) == F.M(x);
}
