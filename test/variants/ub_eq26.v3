//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128
// A walk across the whole float range at the boundaries.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<int, float>> = [
	T.IsB(float.infinity),
	T.IsB(-float.infinity),
	T.IsB(float.view(0x7F7FFFFFu)),		// largest normal
	T.IsB(float.view(0x00800000u)),		// smallest normal
	T.IsB(float.view(0x007FFFFFu)),		// largest subnormal
	T.IsB(float.view(0x00000001u)),		// smallest subnormal
	T.IsB(0f),
	T.IsA(0)
];

def cmp = T<int, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
