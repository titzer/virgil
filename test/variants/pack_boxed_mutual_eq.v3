//@execute 0=1; 1=2; 2=4; 3=8; 4=48; 5=48; 6=64; 7=128
type N {
	case Leaf(t: T);
	case Node(l: N, r: N);
}
type T #unboxed #packed {
	case I(x: i31);
	case Sub(n: N);
}
def dn = Array<N>.new(1);
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824),
	T.Sub(dn[0]),
	T.Sub(N.Leaf(T.I(0))),
	T.Sub(N.Leaf(T.I(-1))),
	T.Sub(N.Node(N.Leaf(T.I(-1)), N.Leaf(T.Sub(N.Leaf(T.I(1073741823))))))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.I(xs[0]);
		1 => return T.I(xs[1]);
		2 => return T.I(xs[2]);
		3 => return T.I(xs[3]);
		4 => return T.Sub(dn[0]);
		5 => return T.Sub(N.Leaf(T.I(xs[0])));
		6 => return T.Sub(N.Leaf(T.I(xs[1])));
		_ => return T.Sub(N.Node(N.Leaf(T.I(xs[1])), N.Leaf(T.Sub(N.Leaf(T.I(xs[2]))))));
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
