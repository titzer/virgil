//@execute 0=false; 1=false
// boxed_naneq10 for double: two distinct objects holding identical NaN bits, one a
// compile-time constant and one built from a runtime load.
type T {
	case D(x: double);
	case L(x: long);
}
def NANS: Array<double> = [double.nan, double.nan];
def CACHE: Array<T> = [T.D(double.nan), T.D(double.nan)];
def main(a: int) -> bool {
	return CACHE[a] == T.D(NANS[a]);
}
