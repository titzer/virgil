//@execute 0=1; 1=-1; 2=0; 3=1; 4=8191; 5=5461; 6=100000; 7=99999; 8=104095; 9=95904; 10=200000; 11=200001; 12=216383; 13=210922; 14=-1; 15=0; 16=-268435456; 17=268435455
type Q #unboxed #packed {
	case U(a: u13);
	case V(b: i13);
}
type P #unboxed #packed {
	case X(q: Q);
	case Y(c: u14);
}
type T #unboxed #packed {
	case R(s: string);
	case N(p: P);
	case M(x: i29);
}
def rs: Array<string> = ["r", null];
def xa: Array<u13> = [0, 1, 8191, 5461];
def xb: Array<i13> = [0, -1, 4095, -4096];
def xc: Array<u14> = [0, 1, 16383, 10922];
def xs: Array<i29> = [0, -1, 268435455, -268435456];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N(P.X(Q.U(0))),
	T.N(P.X(Q.U(1))),
	T.N(P.X(Q.U(8191))),
	T.N(P.X(Q.U(5461))),
	T.N(P.X(Q.V(0))),
	T.N(P.X(Q.V(-1))),
	T.N(P.X(Q.V(4095))),
	T.N(P.X(Q.V(-4096))),
	T.N(P.Y(0)),
	T.N(P.Y(1)),
	T.N(P.Y(16383)),
	T.N(P.Y(10922)),
	T.M(0),
	T.M(-1),
	T.M(268435455),
	T.M(-268435456)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N(P.X(Q.U(xa[0])));
		3 => return T.N(P.X(Q.U(xa[1])));
		4 => return T.N(P.X(Q.U(xa[2])));
		5 => return T.N(P.X(Q.U(xa[3])));
		6 => return T.N(P.X(Q.V(xb[0])));
		7 => return T.N(P.X(Q.V(xb[1])));
		8 => return T.N(P.X(Q.V(xb[2])));
		9 => return T.N(P.X(Q.V(xb[3])));
		10 => return T.N(P.Y(xc[0]));
		11 => return T.N(P.Y(xc[1]));
		12 => return T.N(P.Y(xc[2]));
		13 => return T.N(P.Y(xc[3]));
		14 => return T.M(xs[0]);
		15 => return T.M(xs[1]);
		16 => return T.M(xs[2]);
		_ => return T.M(xs[3]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N(p) => match (p) {
			X(q) => match (q) {
				U(a) => return a;
				V(b) => return 100000 + b;
			}
			Y(c) => return 200000 + c;
		}
		M(x) => return ~x;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
