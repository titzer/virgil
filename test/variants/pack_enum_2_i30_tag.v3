//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33; 9=33; 10=33
enum E { E0, E1 }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E, x: i30);
}
def rs: Array<string> = ["r", null];
def es = [E.E0, E.E1];
def xs: Array<i30> = [0, 1, -1, 536870911, -536870912, 357913941, -357913942, 0, 536870911];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.E0, 0),
	T.X(E.E1, 1),
	T.X(E.E0, -1),
	T.X(E.E1, 536870911),
	T.X(E.E0, -536870912),
	T.X(E.E1, 357913941),
	T.X(E.E0, -357913942),
	T.X(E.E1, 0),
	T.X(E.E0, 536870911)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0], xs[0]);
		3 => return T.X(es[1], xs[1]);
		4 => return T.X(es[0], xs[2]);
		5 => return T.X(es[1], xs[3]);
		6 => return T.X(es[0], xs[4]);
		7 => return T.X(es[1], xs[5]);
		8 => return T.X(es[0], xs[6]);
		9 => return T.X(es[1], xs[7]);
		_ => return T.X(es[0], xs[8]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.X.?(d)) r |= 32;
	return r;
}
