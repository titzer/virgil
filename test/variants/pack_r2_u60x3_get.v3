//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=0; 7=1; 8=2; 9=-268435456; 10=-268435455; 11=134217728; 12=-134217728; 13=1342177280; 14=-1610612736; 15=67108864; 16=201326592; 17=19088743; 18=-144358623; 19=-1; 20=-2; 21=-3; 22=268435455; 23=268435454; 24=-134217729; 25=134217727; 26=-1342177281; 27=1610612735; 28=-67108865; 29=-201326593; 30=-19088744; 31=144358622; 32=7; 33=8; 34=9; 35=-268435449; 36=-268435448; 37=134217735; 38=-134217721; 39=1342177287; 40=-1610612729; 41=67108871; 42=201326599; 43=19088750; 44=-144358616
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case I0(x: u60);
	case I1(x: u60);
	case I2(x: u60);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def xs: Array<u60> = [0, 1, 2, 1152921504606846975, 1152921504606846974, 576460752303423488, 576460752303423487, 384307168202282325, 768614336404564650, 288230376151711744, 864691128455135232, 19088743, 1152921504482770142];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(1152921504606846975), T.I0(1152921504606846974), T.I0(576460752303423488), T.I0(576460752303423487), T.I0(384307168202282325), T.I0(768614336404564650), T.I0(288230376151711744), T.I0(864691128455135232), T.I0(19088743), T.I0(1152921504482770142),
	T.I1(0), T.I1(1), T.I1(2), T.I1(1152921504606846975), T.I1(1152921504606846974), T.I1(576460752303423488), T.I1(576460752303423487), T.I1(384307168202282325), T.I1(768614336404564650), T.I1(288230376151711744), T.I1(864691128455135232), T.I1(19088743), T.I1(1152921504482770142),
	T.I2(0), T.I2(1), T.I2(2), T.I2(1152921504606846975), T.I2(1152921504606846974), T.I2(576460752303423488), T.I2(576460752303423487), T.I2(384307168202282325), T.I2(768614336404564650), T.I2(288230376151711744), T.I2(864691128455135232), T.I2(19088743), T.I2(1152921504482770142)
