//@execute 0=1; 1=-1; 2=0; 3=-12345; 4=-1071644672; 5=2139095040; 6=-2147483648; 7=-12345; 8=-266631570; 9=0; 10=-2013235812; 11=-12345; 12=1074340345; 13=-2147483648; 14=2117592124; 15=-12345
// A nested tuple of int, float and double scalarized into three slot widths.
type T #unboxed {
	case W(v: (int, (float, double)));
	case N;
}

def ts = [
	T.W((1, (-2.5f, 3.14159d))),
	T.W((-1, (float.infinity, -0d))),
	T.W((0, (-0f, 1.0e300d))),
	T.N
];

def main(a: int) -> int {
	match (ts[a & 3]) {
		W(v) => {
			var d = u64.view(v.1.1);
			match ((a >> 2) & 3) {
				0 => return v.0;
				1 => return int.view(u32.view(v.1.0));
				2 => return int.view(d);
				_ => return int.view(d >> 32);
			}
		}
		N => return -12345;
	}
}
