//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
def xs = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
type B #unboxed {
	case X(c: C);
	case Y(s: string);
}
type A #unboxed {
	case Two(b1: B, b2: B);
}
def ss = ["s", "t"];
def main(a: int) -> bool {
	match (a) {
		0 => return (B.X(mkC(0)), 7) == (B.X(cs[0]), 7);
		1 => return (B.X(mkC(0)), 7) == (B.X(cs[1]), 7);
		2 => return A.Two(B.X(mkC(0)), B.Y(ss[0])) == A.Two(B.X(cs[0]), B.Y(ss[0]));
		3 => return A.Two(B.X(mkC(0)), B.Y(ss[0])) == A.Two(B.X(cs[0]), B.Y(ss[1]));
		4 => return A.Two(B.Y(ss[1]), B.X(mkC(2))) == A.Two(B.Y(ss[1]), B.X(cs[2]));
		_ => return A.Two(B.Y(ss[1]), B.X(mkC(2))) == A.Two(B.X(cs[2]), B.Y(ss[1]));
	}
}
