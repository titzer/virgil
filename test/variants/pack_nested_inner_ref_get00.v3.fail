//@execute 0=3; 1=2; 2=5; 3=-1; 4=6; 5=-2
// fails on x86-64: nested tagged ref loses its tag bits
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type T #unboxed #packed {
	case A(p: P);
	case B(x: i31);
}
def vs = [T.A(P.S("abc")), T.A(P.S("de")), T.A(P.I(5)), T.A(P.I(-1)), T.B(6), T.B(-2)];
def main(a: int) -> int {
	match (vs[a]) {
		A(p) => match (p) {
			S(s) => return s.length;
			I(x) => return x;
		}
		B(x) => return x;
	}
}
