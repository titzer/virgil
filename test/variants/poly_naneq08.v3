//@execute 0=false; 1=false; 2=false; 3=false
// poly_naneq05 for double: a polymorphic variant instantiated at itself, boxed and
// unboxed, with two different NaN bit patterns.
type Opt<X> {
	case Some(v: X);
	case None;
}
type UOpt<X> #unboxed {
	case Some(v: X);
	case None;
}
def BS: Array<Opt<Opt<double>>> = [
	Opt<Opt<double>>.Some(Opt<double>.Some(double.nan)),
	Opt<Opt<double>>.Some(Opt<double>.Some(double.view(0xFFF80000_00000000uL)))
];
def US: Array<UOpt<UOpt<double>>> = [
	UOpt<UOpt<double>>.Some(UOpt<double>.Some(double.nan)),
	UOpt<UOpt<double>>.Some(UOpt<double>.Some(double.view(0xFFF80000_00000000uL)))
];
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, BS[i] == BS[i], US[i] == US[i]);
}
