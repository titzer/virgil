//@execute 0=3; 1=7; 2=5; 3=9
type T #unboxed #packed {
	case B(x: u8);
	case A(x: string);
}
class Cell {
	var t: T;
	new(t) { }
}

def c1 = Cell.new(T.A("abc"));
def c2 = Cell.new(T.B(7));

def get(t: T) -> int {
	match (t) {
		B(v) => return v;
		A(str) => return str.length;
	}
}

def main(a: int) -> int {
	match (a) {
		0 => return get(c1.t);
		1 => return get(c2.t);
		2 => { c1.t = T.A("defgh"); return get(c1.t); }
		_ => { c2.t = T.B(9); return get(c2.t); }
	}
}
