//@execute 0=5; 1=6; 2=7; 3=-1; 4=105; 5=106; 6=-2
class P(v: int) { }
class Q extends P {
	new(v: int) super(v) { }
}
type T #unboxed #packed {
	case X(p: P);
	case Y(q: Q);
}
def q0 = Q.new(5), q1 = Q.new(6);
def rp: Array<P> = [q0, q1, P.new(7), null];
def rq: Array<Q> = [q0, q1, null];
def vs = [
	T.X(rp[0]),
	T.X(rp[1]),
	T.X(rp[2]),
	T.X(rp[3]),
	T.Y(rq[0]),
	T.Y(rq[1]),
	T.Y(rq[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(rp[0]);
		1 => return T.X(rp[1]);
		2 => return T.X(rp[2]);
		3 => return T.X(rp[3]);
		4 => return T.Y(rq[0]);
		5 => return T.Y(rq[1]);
		_ => return T.Y(rq[2]);
	}
}
def get(v: T) -> int {
	match (v) {
		X(p) => return if(p == null, -1, p.v);
		Y(q) => return if(q == null, -2, 100 + q.v);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
