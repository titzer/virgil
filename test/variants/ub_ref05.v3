//@execute 0=0; 1=1
type A #unboxed #packed { 
	case X(a: Array<int>) #unboxed #packed;
}
def main(a: int) -> int {
	def a1 = Array<int>.new(1);
	def a2 = Array<int>.new(1);
	def one = A.X(a1);
	def thr = A.X(a2);
	def arr = [one, thr];

	match(a) {
		0 => return int.view<bool>(A.X.!(arr[0]) == A.X.!(arr[1]));
		1 => return int.view<bool>(A.X.!(arr[1]) == A.X.!(arr[1]));
		_ => return 42;
	}
}
