//@execute 0=1; 1=2; 2=3
// A never-allocated case with an enum field, like Opcode.CallKernel(kernel: Kernel).
enum K { X, Y, Z }
type Op #unboxed {
	case A(a: int);
	case B(b: long, c: bool);
	case Kern(k: K);
}
def visitKern(x: Op.Kern) -> int { return 100 + x.k.tag; }
def visit(op: Op) -> int {
	match (op) {
		x: Op.A => return x.a;
		x: Op.B => return int.view(x.b) + if(x.c, 1);
		x: Op.Kern => return visitKern(x);
	}
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A(1);
		1 => return Op.B(2, false);
		_ => return Op.B(2, true);
	}
}
def main(a: int) -> int {
	return visit(make(a));
}
