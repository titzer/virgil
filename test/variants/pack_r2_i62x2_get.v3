def xs: Array<i62> = [0, 1, -1, 2305843009213693951, -2305843009213693952, 2305843009213693950, -2305843009213693951, 1537228672809129301, -1537228672809129302, 1152921504606846976, -1152921504606846976, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(2305843009213693951), T.I0(-2305843009213693952), T.I0(2305843009213693950), T.I0(-2305843009213693951), T.I0(1537228672809129301), T.I0(-1537228672809129302), T.I0(1152921504606846976), T.I0(-1152921504606846976), T.I0(19088743), T.I0(-124076833),
