//@execute 0=16; 1=16; 2=33; 3=33; 4=66; 5=66; 6=66; 7=66
type B {
	case X(a: int);
	case Y(s: string);
}
type T #unboxed #packed {
	case RX(b: B.X);
	case RY(b: B.Y);
	case I(x: i31);
}
def ks = [5, 0];
def ss = ["hey", "you"];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.RX(B.X(5)),
	T.RX(B.X(0)),
	T.RY(B.Y(ss[0])),
	T.RY(B.Y(null)),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.RX(B.X(ks[0]));
		1 => return T.RX(B.X(ks[1]));
		2 => return T.RY(B.Y(ss[0]));
		3 => return T.RY(B.Y(null));
		4 => return T.I(xs[0]);
		5 => return T.I(xs[1]);
		6 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.RX.?(d)) r |= 16;
	if (T.RY.?(d)) r |= 32;
	if (T.I.?(d)) r |= 64;
	return r;
}
