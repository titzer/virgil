//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128; 8=256; 9=512; 10=1024; 11=2048; 12=4096; 13=8192; 14=16384; 15=32768; 16=65536; 17=131072; 18=262144; 19=524288; 20=1048576; 21=2097152; 22=4194304; 23=8388608; 24=16777216; 25=33554432
type P #unboxed #packed {
	case X(a: i28);
	case Y(b: u28);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
	case N1(p: P);
	case N2(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i28> = [0, 1, -1, 134217727];
def xb: Array<u28> = [0, 1, 268435455, 134217728];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(134217727)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(268435455)),
	T.N0(P.Y(134217728)),
	T.N1(P.X(0)),
	T.N1(P.X(1)),
	T.N1(P.X(-1)),
	T.N1(P.X(134217727)),
	T.N1(P.Y(0)),
	T.N1(P.Y(1)),
	T.N1(P.Y(268435455)),
	T.N1(P.Y(134217728)),
	T.N2(P.X(0)),
	T.N2(P.X(1)),
	T.N2(P.X(-1)),
	T.N2(P.X(134217727)),
	T.N2(P.Y(0)),
	T.N2(P.Y(1)),
	T.N2(P.Y(268435455)),
	T.N2(P.Y(134217728))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.Y(xb[0]));
		7 => return T.N0(P.Y(xb[1]));
		8 => return T.N0(P.Y(xb[2]));
		9 => return T.N0(P.Y(xb[3]));
		10 => return T.N1(P.X(xa[0]));
		11 => return T.N1(P.X(xa[1]));
		12 => return T.N1(P.X(xa[2]));
		13 => return T.N1(P.X(xa[3]));
		14 => return T.N1(P.Y(xb[0]));
		15 => return T.N1(P.Y(xb[1]));
		16 => return T.N1(P.Y(xb[2]));
		17 => return T.N1(P.Y(xb[3]));
		18 => return T.N2(P.X(xa[0]));
		19 => return T.N2(P.X(xa[1]));
		20 => return T.N2(P.X(xa[2]));
		21 => return T.N2(P.X(xa[3]));
		22 => return T.N2(P.Y(xb[0]));
		23 => return T.N2(P.Y(xb[1]));
		24 => return T.N2(P.Y(xb[2]));
		_ => return T.N2(P.Y(xb[3]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
