//@execute 0=3; 1=3; 2=0; 3=8; 4=16; 5=0; 6=0; 7=128
// ub_eq19's shape with the integer component holding the bits of a quiet NaN.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
	case IsBoth(x: A, y: B);
}

def ts: Array<T<u32, float>> = [
	T.IsBoth(0x7FC00000u, 0f),
	T.IsBoth(0x7FC00000u, -0f),
	T.IsBoth(0x7FC00000u, float.nan),
	T.IsBoth(0x00000000u, 0f),
	T.IsA(0x7FC00000u),
	T.IsB(float.nan),
	T.IsB(float.view(0x7FC00000u)),
	T.IsBoth(0x80000000u, 0f)
];

def cmp = T<u32, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
