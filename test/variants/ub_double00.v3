//@execute 0=-1719109786; 1=-481036337; 2=-1430532899; 3=1075780517
type T #unboxed {
	case L(val: u64);
	case D(val: double);
}

def ts = [T.L(0xAABBCCDD_99887766), T.D(7.777d)];

def main(a: int) -> int {
	var v = ts[a & 1];
	var low = (a & 2) == 0;
	var l: u64;
	match (v) {
		L(v) => l = u64.view(v);
		D(v) => l = u64.view(v);
	}
	return if(low, int.view(l), int.view(l >> 32));
}
