//@execute 0=5; 1=5; 2=5; 16=5; 17=5; 18=5; 32=5; 33=5; 34=5; 48=5; 49=5; 50=5; 64=5; 65=5; 66=5; 67=5; 68=5; 69=5; 70=5; 71=5; 72=5; 73=5; 74=5; 75=5; 76=5; 80=5; 81=5; 82=5; 83=5; 84=5; 85=5; 86=5; 87=5; 88=5; 89=5; 90=5; 91=5; 92=5; 96=5; 97=5; 98=5; 99=5; 100=5; 101=5; 102=5; 103=5; 104=5; 105=5; 106=5; 107=5; 108=5; 112=5; 113=5; 114=5; 115=5; 116=5; 117=5; 118=5; 119=5; 120=5; 121=5; 122=5; 123=5; 124=5; 128=!TypeCheckException
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: i61);
	case I1(x: i61);
	case I2(x: i61);
	case I3(x: i61);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<i61> = [0, 1, -1, 1152921504606846975, -1152921504606846976, 1152921504606846974, -1152921504606846975, 384307168202282325, -384307168202282326, 576460752303423488, -576460752303423488, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(1152921504606846975), T.I0(-1152921504606846976), T.I0(1152921504606846974), T.I0(-1152921504606846975), T.I0(384307168202282325), T.I0(-384307168202282326), T.I0(576460752303423488), T.I0(-576460752303423488), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(1152921504606846975), T.I1(-1152921504606846976), T.I1(1152921504606846974), T.I1(-1152921504606846975), T.I1(384307168202282325), T.I1(-384307168202282326), T.I1(576460752303423488), T.I1(-576460752303423488), T.I1(19088743), T.I1(-124076833),
	T.I2(0), T.I2(1), T.I2(-1), T.I2(1152921504606846975), T.I2(-1152921504606846976), T.I2(1152921504606846974), T.I2(-1152921504606846975), T.I2(384307168202282325), T.I2(-384307168202282326), T.I2(576460752303423488), T.I2(-576460752303423488), T.I2(19088743), T.I2(-124076833),
	T.I3(0), T.I3(1), T.I3(-1), T.I3(1152921504606846975), T.I3(-1152921504606846976), T.I3(1152921504606846974), T.I3(-1152921504606846975), T.I3(384307168202282325), T.I3(-384307168202282326), T.I3(576460752303423488), T.I3(-576460752303423488), T.I3(19088743), T.I3(-124076833)
];
def idx = [0, 3, 6, 9, 12, 25, 38, 51];
def main(a: int) -> int {
	var c = a / 16, k = a % 16, r = 0;
	if (c == 8) return int.view(T.I0.!(vs[0]).x);
	match (c) {
		0 => {
			var p = T.R0.!(vs[idx[c] + k]), q = T.R0(r0[k]), o = T.R0.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r0[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		1 => {
			var p = T.R1.!(vs[idx[c] + k]), q = T.R1(r1[k]), o = T.R1.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r1[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		2 => {
			var p = T.R2.!(vs[idx[c] + k]), q = T.R2(r2[k]), o = T.R2.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r2[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		3 => {
			var p = T.R3.!(vs[idx[c] + k]), q = T.R3(r3[k]), o = T.R3.!(vs[idx[c] + (k + 1) % 3]);
			if (p.x == r3[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		4 => {
			var p = T.I0.!(vs[idx[c] + k]), q = T.I0(xs[k]), o = T.I0.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		5 => {
			var p = T.I1.!(vs[idx[c] + k]), q = T.I1(xs[k]), o = T.I1.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		6 => {
			var p = T.I2.!(vs[idx[c] + k]), q = T.I2(xs[k]), o = T.I2.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
		_ => {
			var p = T.I3.!(vs[idx[c] + k]), q = T.I3(xs[k]), o = T.I3.!(vs[idx[c] + (k + 1) % 13]);
			if (p.x == xs[k]) r |= 1;
			if (p.x == o.x) r |= 2;
			if (p == q) r |= 4;
			if (p == o) r |= 8;
		}
	}
	return r;
}
