//@execute 0=1; 1=1; 2=1; 3=1; 4=!TypeCheckException
type T #unboxed #packed {
	case R(s: string);
	case P(a: u10, b: i11, c: u10);
}
def fa: Array<u10> = [0, 1023, 341, 1];
def fb: Array<i11> = [0, -1024, 1023, -1];
def fc: Array<u10> = [1023, 0, 682, 2];
def vs = [T.P(0, 0, 1023), T.P(1023, -1024, 0), T.P(341, 1023, 682), T.P(1, -1, 2), T.R("r")];
def main(a: int) -> int {
	var p = T.P.!(vs[a]), n = (a + 1) & 3, r = 0;
	if (p == T.P(fa[a], fb[a], fc[a])) r |= 1;
	if (p.a != fa[a]) r |= 2;
	if (p.a == fa[n]) r |= 4;
	if (p == T.P(fa[n], fb[a], fc[a])) r |= 8;
	if (p.b != fb[a]) r |= 16;
	if (p.b == fb[n]) r |= 32;
	if (p == T.P(fa[a], fb[n], fc[a])) r |= 64;
	if (p.c != fc[a]) r |= 128;
	if (p.c == fc[n]) r |= 256;
	if (p == T.P(fa[a], fb[a], fc[n])) r |= 512;
	return r;
}
