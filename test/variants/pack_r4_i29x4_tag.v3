//@execute 0=16; 1=16; 2=16; 16=33; 17=33; 18=33; 32=66; 33=66; 34=66; 48=131; 49=131; 50=131; 64=260; 65=260; 66=260; 67=260; 68=260; 69=260; 70=260; 71=260; 72=260; 73=260; 74=260; 75=260; 76=260; 80=517; 81=517; 82=517; 83=517; 84=517; 85=517; 86=517; 87=517; 88=517; 89=517; 90=517; 91=517; 92=517; 96=1030; 97=1030; 98=1030; 99=1030; 100=1030; 101=1030; 102=1030; 103=1030; 104=1030; 105=1030; 106=1030; 107=1030; 108=1030; 112=2055; 113=2055; 114=2055; 115=2055; 116=2055; 117=2055; 118=2055; 119=2055; 120=2055; 121=2055; 122=2055; 123=2055; 124=2055
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: i29);
	case I1(x: i29);
	case I2(x: i29);
	case I3(x: i29);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<i29> = [0, 1, -1, 268435455, -268435456, 268435454, -268435455, 89478485, -89478486, 134217728, -134217728, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(268435455), T.I0(-268435456), T.I0(268435454), T.I0(-268435455), T.I0(89478485), T.I0(-89478486), T.I0(134217728), T.I0(-134217728), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(268435455), T.I1(-268435456), T.I1(268435454), T.I1(-268435455), T.I1(89478485), T.I1(-89478486), T.I1(134217728), T.I1(-134217728), T.I1(19088743), T.I1(-124076833),
	T.I2(0), T.I2(1), T.I2(-1), T.I2(268435455), T.I2(-268435456), T.I2(268435454), T.I2(-268435455), T.I2(89478485), T.I2(-89478486), T.I2(134217728), T.I2(-134217728), T.I2(19088743), T.I2(-124076833),
	T.I3(0), T.I3(1), T.I3(-1), T.I3(268435455), T.I3(-268435456), T.I3(268435454), T.I3(-268435455), T.I3(89478485), T.I3(-89478486), T.I3(134217728), T.I3(-134217728), T.I3(19088743), T.I3(-124076833)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		1 => return T.R1(r1[k]);
		2 => return T.R2(r2[k]);
		3 => return T.R3(r3[k]);
		4 => return T.I0(xs[k]);
		5 => return T.I1(xs[k]);
		6 => return T.I2(xs[k]);
		_ => return T.I3(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r: int = d.tag;
	if (T.R0.?(d)) r |= 16;
	if (T.R1.?(d)) r |= 32;
	if (T.R2.?(d)) r |= 64;
	if (T.R3.?(d)) r |= 128;
	if (T.I0.?(d)) r |= 256;
	if (T.I1.?(d)) r |= 512;
	if (T.I2.?(d)) r |= 1024;
	if (T.I3.?(d)) r |= 2048;
	return r;
}
