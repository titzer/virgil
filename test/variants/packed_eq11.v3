//@execute 0=true; 1=false; 2=true; 3=false; 4=true
// Default values and an empty case in a packed variant.
type T #unboxed #packed {
	case N;
	case A(x: u8, y: u8);
}

var t: T;
def ts = [T.A(0, 0), T.A(0, 1), T.N];

def main(a: int) -> bool {
	match (a) {
		0 => return t == T.N;
		1 => return t == ts[0];
		2 => return ts[2] == T.N;
		3 => return ts[0] == ts[1];
		_ => return ts[0] == T.A(0, 0);
	}
}
