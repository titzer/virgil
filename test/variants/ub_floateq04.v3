//@execute 0=1; 1=2; 2=4; 3=0; 4=48; 5=48; 6=64; 7=0; 8=0; 9=512; 10=0; 11=2048
// A six-case unboxed variant: empty, int, float, double, float pair, int and double.
type T #unboxed {
	case A;
	case B(v: int);
	case C(v: float);
	case D(v: double);
	case E(x: float, y: float);
	case F(k: int, v: double);
}

def ts = [
	T.A,
	T.B(3),
	T.C(2.5f), T.C(float.nan), T.C(-0f), T.C(0f),
	T.D(2.5d), T.D(double.nan),
	T.E(1f, float.nan), T.E(1f, 2f),
	T.F(5, double.nan), T.F(5, -double.infinity)
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
