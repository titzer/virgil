//@execute 0=16; 1=16; 2=33; 3=33; 4=33; 5=33; 6=33; 7=33; 8=33
type X(a: u16, b: i15) #unboxed #packed { }
type T #unboxed #packed {
	case R(s: string);
	case N(x: X);
}
def rs: Array<string> = ["r", null];
def fa: Array<u16> = [0, 65535, 65535, 0, 1, 21845, 43690];
def fb: Array<i15> = [0, -16384, 16383, -1, 0, 10922, -10923];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N(X(0, 0)),
	T.N(X(65535, -16384)),
	T.N(X(65535, 16383)),
	T.N(X(0, -1)),
	T.N(X(1, 0)),
	T.N(X(21845, 10922)),
	T.N(X(43690, -10923))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N(X(fa[0], fb[0]));
		3 => return T.N(X(fa[1], fb[1]));
		4 => return T.N(X(fa[2], fb[2]));
		5 => return T.N(X(fa[3], fb[3]));
		6 => return T.N(X(fa[4], fb[4]));
		7 => return T.N(X(fa[5], fb[5]));
		_ => return T.N(X(fa[6], fb[6]));
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.R.?(d)) r |= 16;
	if (T.N.?(d)) r |= 32;
	return r;
}
