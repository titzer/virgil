//@execute 0=0; 1=1; 2=2; 16=3; 17=4; 18=5; 19=6; 20=7; 21=8; 22=9; 23=10; 24=11; 25=12; 26=13; 27=14; 28=15
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: i64);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<i64> = [0, 1, -1, 9223372036854775807, -9223372036854775808, 9223372036854775806, -9223372036854775807, 6148914691236517205, -6148914691236517206, 4611686018427387904, -4611686018427387904, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(9223372036854775807), T.I0(-9223372036854775808), T.I0(9223372036854775806), T.I0(-9223372036854775807), T.I0(6148914691236517205), T.I0(-6148914691236517206), T.I0(4611686018427387904), T.I0(-4611686018427387904), T.I0(19088743), T.I0(-124076833)
];
def mk(c: int, k: int) -> T {
	match (c) {
		0 => return T.R0(r0[k]);
		_ => return T.I0(xs[k]);
	}
}
def main(a: int) -> int {
	var d = mk(a / 16, a % 16), r = -1;
	for (i < vs.length) {
		if (d != vs[i]) continue;
		if (r >= 0) return -2;
		r = i;
	}
	return r;
}
