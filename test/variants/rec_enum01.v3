//@execute 0=0; 1=1; 2=0; 3=1; 4=10; 5=11; 6=10; 7=11
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xs = [X.None, X.IsY(Y.None), X.None, X.IsY(Y.IsX(X.None))];
def ys = [Y.None, Y.IsX(X.None), Y.None, Y.IsX(X.IsY(Y.None))];
def main(a: int) -> int {
	if (a < 4) return xs[a].tag;
	return 10 + ys[a - 4].tag;
}
