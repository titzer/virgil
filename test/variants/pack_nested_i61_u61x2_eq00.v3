//@execute 0=true; 1=true; 2=true; 3=true
type P #unboxed #packed {
	case X(a: i61);
	case Y(b: u61);
}
type T #unboxed #packed {
	case N0(p: P);
	case N1(p: P);
}
def xa: Array<i61> = [0, -1];
def xb: Array<u61> = [0, 7];
def vs = [T.N0(P.X(0)), T.N1(P.X(-1)), T.N0(P.Y(0)), T.N1(P.Y(7))];
def main(a: int) -> bool {
	match (a) {
		0 => return T.N0(P.X(xa[0])) == vs[a];
		1 => return T.N1(P.X(xa[1])) == vs[a];
		2 => return T.N0(P.Y(xb[0])) == vs[a];
		_ => return T.N1(P.Y(xb[1])) == vs[a];
	}
}
