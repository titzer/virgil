//@execute 0=0; 1=2; 2=1; 3=2
class C(i: int) {}
type A (i: byte, c: C) #unboxed #packed { }
def main(a: int) -> int {
	def C1 = C.new(1);
	def C2 = C.new(2);
	def one = A(0, C1);
	def thr = A(2, C2);
	def arr = [one, thr];

	match(a) {
		0 => return arr[0].i;
		1 => return arr[1].i;
		2 => return arr[0].c.i;
		3 => return arr[1].c.i;
		_ => return 42;
	}
}
