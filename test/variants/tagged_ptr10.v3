//@execute 0=3; 1=258; 2=5; 3=65535
type P(x: u8, y: u8) #unboxed { }
type T #unboxed #packed {
	case A(x: string);
	case B(p: P);
}

def ts = [T.A("abc"), T.B(P(1, 2)), T.A("defgh"), T.B(P(255, 255))];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(p) => return (int.!(p.x) << 8) | p.y;
	}
}
