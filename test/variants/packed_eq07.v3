//@execute 0=true; 1=false; 2=false; 3=true; 4=false; 5=true
// Packed enum and enum set fields.
enum E { X, Y, Z }
type T #unboxed #packed {
	case A(e: E, s: E.set, n: u3);
	case B(w: u8);
}

def ts = [T.A(E.Y, E.X | E.Z, 5), T.A(E.Y, E.X | E.Z, 5), T.A(E.Z, E.X | E.Z, 5), T.A(E.Y, E.X, 5), T.A(E.Y, E.X | E.Z, 4)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == ts[1];
		1 => return ts[0] == ts[2];
		2 => return ts[0] == ts[3];
		3 => return ts[0] != ts[4];
		4 => return ts[0] == ts[4];
		_ => return ts[3] == T.A(E.Y, E.X, 5);
	}
}
