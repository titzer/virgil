//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
}

def s = "abc";
def ts = [T.A(s), T.A("abc"), T.B(5), T.B(6), T.A(null)];

def main(a: int) -> bool {
	match (a) {
		0 => return ts[0] == T.A(s);
		1 => return ts[0] == ts[1];
		2 => return ts[2] == T.B(5);
		3 => return ts[2] == ts[3];
		4 => return ts[4] == T.A(null);
		_ => return ts[0] == ts[2];
	}
}
