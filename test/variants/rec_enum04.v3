//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsZ(z: Z);
}
type Z {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None, zn = Z.None;
def xy = X.IsY(yn), yz = Y.IsZ(zn), zx = Z.IsX(xn);
def main(a: int) -> bool {
	match (a) {
		0 => return xy == X.IsY(Y.None);
		1 => return xy == xn;
		2 => return yz == Y.IsZ(Z.None);
		3 => return yz == yn;
		4 => return zx == Z.IsX(X.None);
		_ => return zx == zn;
	}
}
