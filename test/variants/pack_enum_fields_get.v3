//@execute 0=1; 1=-1; 2=100; 3=-200; 4=300; 5=-100; 6=200; 7=-300
enum E(v: int) { A(100), B(-200), C(300) }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E);
	case Y(e: E);
}
def rs: Array<string> = ["r", null];
def es = [E.A, E.B, E.C];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.A),
	T.X(E.B),
	T.X(E.C),
	T.Y(E.A),
	T.Y(E.B),
	T.Y(E.C)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0]);
		3 => return T.X(es[1]);
		4 => return T.X(es[2]);
		5 => return T.Y(es[0]);
		6 => return T.Y(es[1]);
		_ => return T.Y(es[2]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		X(e) => return e.v;
		Y(e) => return 0 - e.v;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
