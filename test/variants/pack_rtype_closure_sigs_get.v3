//@execute 0=8; 1=6; 2=5; 3=-1; 4=1; 5=-1; 6=3; 7=1073741823; 8=-1073741824
type T #unboxed #packed {
	case F(f: int -> int);
	case G(g: (int, int) -> int);
	case H(h: int -> int);
	case S(s: string);
	case I(x: i31);
}
def inc(x: int) -> int { return x + 1; }
def dec(x: int) -> int { return x - 1; }
def add(x: int, y: int) -> int { return x + y; }
def sub(x: int, y: int) -> int { return x - y; }
def fs = [inc, dec];
def gs = [add, sub];
def ss = ["abc"];
def xs: Array<i31> = [1073741823, -1073741824];
def vs = [T.F(inc), T.F(dec), T.G(add), T.G(sub), T.H(inc), T.H(dec), T.S(ss[0]), T.I(1073741823), T.I(-1073741824)];
def mk(i: int) -> T {
	match (i) {
		0 => return T.F(fs[0]);
		1 => return T.F(fs[1]);
		2 => return T.G(gs[0]);
		3 => return T.G(gs[1]);
		4 => return T.H(fs[0]);
		5 => return T.H(fs[1]);
		6 => return T.S(ss[0]);
		7 => return T.I(xs[0]);
		_ => return T.I(xs[1]);
	}
}
def get(v: T) -> int {
	match (v) {
		F(f) => return f(7);
		G(g) => return g(2, 3);
		H(h) => return h(0);
		S(s) => return s.length;
		I(x) => return x;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
