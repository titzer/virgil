//@execute 0=1; 1=-1; 2=0; 3=-1073676289; 4=1073741823; 5=-65536; 6=1; 7=715806037; 8=-715806038
type X(a: u16, b: i15) #unboxed #packed { }
type T #unboxed #packed {
	case R(s: string);
	case N(x: X);
}
def rs: Array<string> = ["r", null];
def fa: Array<u16> = [0, 65535, 65535, 0, 1, 21845, 43690];
def fb: Array<i15> = [0, -16384, 16383, -1, 0, 10922, -10923];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N(X(0, 0)),
	T.N(X(65535, -16384)),
	T.N(X(65535, 16383)),
	T.N(X(0, -1)),
	T.N(X(1, 0)),
	T.N(X(21845, 10922)),
	T.N(X(43690, -10923))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N(X(fa[0], fb[0]));
		3 => return T.N(X(fa[1], fb[1]));
		4 => return T.N(X(fa[2], fb[2]));
		5 => return T.N(X(fa[3], fb[3]));
		6 => return T.N(X(fa[4], fb[4]));
		7 => return T.N(X(fa[5], fb[5]));
		_ => return T.N(X(fa[6], fb[6]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N(x) => return int.view(x.a) + 65536 * int.view(x.b);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
