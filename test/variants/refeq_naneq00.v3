//@execute 0=true; 1=true; 2=false
// An `Array<double>` field compares by reference, so the NaNs it holds are invisible
// to variant equality and the variant stays reflexive. The bare double field beside
// it is what makes case B non-reflexive.
type T {
	case A(a: Array<double>);
	case B(x: double);
}
def NANS: Array<double> = [double.nan, double.nan];
def ONES: Array<double> = [1d, 1d];
def CACHE: Array<T> = [T.A(NANS), T.A(ONES), T.B(double.nan)];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
