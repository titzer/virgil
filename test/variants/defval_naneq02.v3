//@execute 0=3; 1=3; 2=3; 3=0; 4=0
// The default value of a data type, against every signed-zero combination of its
// float and double fields, and against a NaN in either of them.
type D(x: double, y: float) { }
def Z: D;
def CACHE = [
	D(0d, 0f),
	D(-0d, -0f),
	D(0d, -0f),
	D(double.nan, 0f),
	D(0d, float.nan)
];
def main(a: int) -> int {
	var l = Z, r = CACHE[a];
	return if(l == r, 1) | if(r == l, 2);
}
