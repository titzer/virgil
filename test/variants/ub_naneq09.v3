//@execute 0=11; 1=11
// The unboxed form of boxed_naneq19.
type T #unboxed {
	case F(x: float);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(float.nan), T.F(float.nan)];
def main(a: int) -> int {
	var v = CACHE[a];
	var live = if(v != v, 1, 0);
	var folded = if(T.F(float.nan) != T.F(float.nan), 1, 0);
	return live * 10 + folded;
}
