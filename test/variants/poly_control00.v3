//@execute 0=true; 1=true; 2=true; 3=true; 4=true; 5=true
// Control for the polymorphic tests.
type Opt<X> {
	case Some(v: X);
	case None;
}
type UOpt<X> #unboxed {
	case Some(v: X);
	case None;
}
type Pair<X>(x: X, y: X) { }
def IS: Array<Opt<int>> = [Opt<int>.Some(-1)];
def LS: Array<UOpt<long>> = [UOpt<long>.Some(-1)];
def PS: Array<Pair<int>> = [Pair(3, 4)];
def FS: Array<Opt<float>> = [Opt<float>.Some(-0f)];
def DS: Array<UOpt<double>> = [UOpt<double>.Some(-double.infinity)];
def TS: Array<Pair<(float, double)>> = [Pair((1.5f, 2.5d), (-0f, 0d))];
def main(a: int) -> bool {
	match (a) {
		0 => return IS[0] == IS[0];
		1 => return LS[0] == LS[0];
		2 => return PS[0] == PS[0];
		3 => return FS[0] == FS[0];
		4 => return DS[0] == DS[0];
		_ => return TS[0] == TS[0];
	}
}
