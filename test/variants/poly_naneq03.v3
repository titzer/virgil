//@execute 0=false; 1=false; 2=false; 3=false
// A polymorphic data type.
type Pair<X>(x: X, y: X) { }
def FS: Array<Pair<float>> = [Pair(float.nan, 1f), Pair(1f, float.nan)];
def DS: Array<Pair<double>> = [Pair(double.nan, 1d), Pair(1d, double.nan)];
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, FS[i] == FS[i], DS[i] == DS[i]);
}
