//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=0; 10=1; 11=2; 12=-1073741824; 13=-1073741823; 14=536870912; 15=-536870912; 16=1073741824; 17=-2147483648; 18=268435456; 19=805306368; 20=19088743; 21=-949664991; 22=-1; 23=-2; 24=-3; 25=1073741823; 26=1073741822; 27=-536870913; 28=536870911; 29=-1073741825; 30=2147483647; 31=-268435457; 32=-805306369; 33=-19088744; 34=949664990
class A(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case I0(x: u62);
	case I1(x: u62);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def xs: Array<u62> = [0, 1, 2, 4611686018427387903, 4611686018427387902, 2305843009213693952, 2305843009213693951, 1537228672809129301, 3074457345618258602, 1152921504606846976, 3458764513820540928, 19088743, 4611686018303311070];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(4611686018427387903), T.I0(4611686018427387902), T.I0(2305843009213693952), T.I0(2305843009213693951), T.I0(1537228672809129301), T.I0(3074457345618258602), T.I0(1152921504606846976), T.I0(3458764513820540928), T.I0(19088743), T.I0(4611686018303311070),
	T.I1(0), T.I1(1), T.I1(2), T.I1(4611686018427387903), T.I1(4611686018427387902), T.I1(2305843009213693952), T.I1(2305843009213693951), T.I1(1537228672809129301), T.I1(3074457345618258602), T.I1(1152921504606846976), T.I1(3458764513820540928), T.I1(19088743), T.I1(4611686018303311070)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		I0(x) => return (int.view(x) ^ int.view(x >> 32));
		I1(x) => return ~(int.view(x) ^ int.view(x >> 32));
	}
}
def main(a: int) -> int {
