//@execute 0=true; 1=false; 2=true; 3=true; 4=false
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy = X.IsY(yn), yx = Y.IsX(xn);
def yOf(x: X) -> Y {
	match (x) {
		None => return Y.None;
		IsY(y) => return y;
	}
}
def xOf(y: Y) -> X {
	match (y) {
		None => return X.None;
		IsX(x) => return x;
	}
}
def main(a: int) -> bool {
	match (a) {
		0 => return yOf(xy) == yn;
		1 => return yOf(xy) == yx;
		2 => return xOf(yx) == xn;
		3 => return xOf(yOf(xy)) == X.None;
		_ => return xOf(yx) == xy;
	}
}
