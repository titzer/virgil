//@execute 0=11; 1=12; 2=-1; 3=0; 4=1; 5=-1; 6=1073741823; 7=-1073741824; 8=1073741822; 9=-1073741823; 10=357913941; 11=-357913942; 12=536870912; 13=-536870912; 14=19088743; 15=-124076833; 16=-1; 17=-2; 18=0; 19=-1073741824; 20=1073741823; 21=-1073741823; 22=1073741822; 23=-357913942; 24=357913941; 25=-536870913; 26=536870911; 27=-19088744; 28=124076832
type T #unboxed #packed {
	case R0(x: Array<int>);
	case I0(x: i31);
	case I1(x: i31);
}
def r0: Array<Array<int>> = [[11], [12], null];
def xs: Array<i31> = [0, 1, -1, 1073741823, -1073741824, 1073741822, -1073741823, 357913941, -357913942, 536870912, -536870912, 19088743, -124076833];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.I0(0), T.I0(1), T.I0(-1), T.I0(1073741823), T.I0(-1073741824), T.I0(1073741822), T.I0(-1073741823), T.I0(357913941), T.I0(-357913942), T.I0(536870912), T.I0(-536870912), T.I0(19088743), T.I0(-124076833),
	T.I1(0), T.I1(1), T.I1(-1), T.I1(1073741823), T.I1(-1073741824), T.I1(1073741822), T.I1(-1073741823), T.I1(357913941), T.I1(-357913942), T.I1(536870912), T.I1(-536870912), T.I1(19088743), T.I1(-124076833)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
