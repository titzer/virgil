//@execute 0=3; 1=5; 2=7; 3=3; 4=5; 5=-1
type T #unboxed #packed {
	case B(x: u8);
	case A(x: string);
}

def s = "abc";

def get(t: T) -> int {
	match (t) {
		B(v) => return v;
		A(str) => return str.length;
	}
}

def main(a: int) -> int {
	match (a) {
		0 => return get(T.A(s));
		1 => return get(T.A("defgh"));
		2 => return get(T.B(7));
		3 => return if(T.A(s) == T.A(s), 3, -1);
		4 => return get(T.A(Array<byte>.new(5)));
		_ => return if(T.A(s) == T.B(7), 1, -1);
	}
}
