//@execute 0=1; 1=-1; 2=10; 3=11; 4=12; 5=13
enum E { A, B, C, D }
type T #unboxed #packed {
	case R(s: string);
	case X(e: E);
}
def rs: Array<string> = ["r", null];
def es = [E.A, E.B, E.C, E.D];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.X(E.A),
	T.X(E.B),
	T.X(E.C),
	T.X(E.D)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.X(es[0]);
		3 => return T.X(es[1]);
		4 => return T.X(es[2]);
		_ => return T.X(es[3]);
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		X(e) => return 10 + e.tag;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
