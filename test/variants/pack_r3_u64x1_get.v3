//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=0; 10=1; 11=2; 12=0; 13=1; 14=-2147483648; 15=-2147483648; 16=0; 17=0; 18=1073741824; 19=-1073741824; 20=19088743; 21=124076833
class A(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case I0(x: u64);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def xs: Array<u64> = [0, 1, 2, 18446744073709551615uL, 18446744073709551614uL, 9223372036854775808uL, 9223372036854775807, 6148914691236517205, 12297829382473034410uL, 4611686018427387904, 13835058055282163712uL, 19088743, 18446744073585474782uL];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(18446744073709551615uL), T.I0(18446744073709551614uL), T.I0(9223372036854775808uL), T.I0(9223372036854775807), T.I0(6148914691236517205), T.I0(12297829382473034410uL), T.I0(4611686018427387904), T.I0(13835058055282163712uL), T.I0(19088743), T.I0(18446744073585474782uL)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		I0(x) => return (int.view(x) ^ int.view(x >> 32));
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
