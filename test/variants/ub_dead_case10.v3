//@execute 0=1; 1=2; 2=6
// Never-allocated cases stored in and loaded from fields and arrays of the case type.
type Op #unboxed {
	case A(x: int);
	case B(x: int, y: long);
	case D(y: long);
}
class Box {
	var d: Op.D;
	var ds: Array<Op.D>;
}
def visit(op: Op, box: Box) -> int {
	match (op) {
		x: Op.A => return x.x;
		x: Op.B => return x.x + int.view(x.y);
		x: Op.D => {
			box.d = x;
			box.ds = [x];
			return -1;
		}
	}
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A(1);
		1 => return Op.A(2);
		_ => return Op.B(2, 4);
	}
}
def main(a: int) -> int {
	var box = Box.new();
	var r = visit(make(a), box);
	if (box.ds != null) return -2;
	return r;
}
