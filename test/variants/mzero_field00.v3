//@execute 0=-2147483648; 1=0; 2=2146959360
// A statically initialized variant field holding -0.0 must keep its sign bit: the
// initializing store is not a store of the default value.
type T {
	case F(x: double, k: int);
	case I(y: int);
}
def CACHE: Array<T> = [T.F(-0d, 1), T.F(0d, 2), T.F(double.nan, 3)];
def main(a: int) -> int {
	match (CACHE[a]) {
		F(x, k) => return int.view(u64.view(x) >> 32);
		I(y) => return -1;
	}
}
