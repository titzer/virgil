//@execute 0=11; 1=12; 2=-1; 3=97; 4=98; 5=-2; 6=31; 7=32; 8=-3; 9=41; 10=42; 11=-4; 12=0; 13=1; 14=2; 15=536870911; 16=536870910; 17=268435456; 18=268435455; 19=357913941; 20=178956970; 21=134217728; 22=402653184; 23=19088743; 24=412794078; 25=-1; 26=-2; 27=-3; 28=-536870912; 29=-536870911; 30=-268435457; 31=-268435456; 32=-357913942; 33=-178956971; 34=-134217729; 35=-402653185; 36=-19088744; 37=-412794079; 38=7; 39=8; 40=9; 41=536870918; 42=536870917; 43=268435463; 44=268435462; 45=357913948; 46=178956977; 47=134217735; 48=402653191; 49=19088750; 50=412794085; 51=0; 52=-1; 53=-2; 54=-536870911; 55=-536870910; 56=-268435456; 57=-268435455; 58=-357913941; 59=-178956970; 60=-134217728; 61=-402653184; 62=-19088743; 63=-412794078
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case R0(x: Array<int>);
	case R1(x: string);
	case R2(x: A);
	case R3(x: B);
	case I0(x: u29);
	case I1(x: u29);
	case I2(x: u29);
	case I3(x: u29);
}
def r0: Array<Array<int>> = [[11], [12], null];
def r1: Array<string> = ["a", "b", null];
def r2: Array<A> = [A.new(31), A.new(32), null];
def r3: Array<B> = [B.new(41), B.new(42), null];
def xs: Array<u29> = [0, 1, 2, 536870911, 536870910, 268435456, 268435455, 357913941, 178956970, 134217728, 402653184, 19088743, 412794078];
def vs = [
	T.R0(r0[0]), T.R0(r0[1]), T.R0(r0[2]),
	T.R1(r1[0]), T.R1(r1[1]), T.R1(r1[2]),
	T.R2(r2[0]), T.R2(r2[1]), T.R2(r2[2]),
	T.R3(r3[0]), T.R3(r3[1]), T.R3(r3[2]),
	T.I0(0), T.I0(1), T.I0(2), T.I0(536870911), T.I0(536870910), T.I0(268435456), T.I0(268435455), T.I0(357913941), T.I0(178956970), T.I0(134217728), T.I0(402653184), T.I0(19088743), T.I0(412794078),
	T.I1(0), T.I1(1), T.I1(2), T.I1(536870911), T.I1(536870910), T.I1(268435456), T.I1(268435455), T.I1(357913941), T.I1(178956970), T.I1(134217728), T.I1(402653184), T.I1(19088743), T.I1(412794078),
	T.I2(0), T.I2(1), T.I2(2), T.I2(536870911), T.I2(536870910), T.I2(268435456), T.I2(268435455), T.I2(357913941), T.I2(178956970), T.I2(134217728), T.I2(402653184), T.I2(19088743), T.I2(412794078),
	T.I3(0), T.I3(1), T.I3(2), T.I3(536870911), T.I3(536870910), T.I3(268435456), T.I3(268435455), T.I3(357913941), T.I3(178956970), T.I3(134217728), T.I3(402653184), T.I3(19088743), T.I3(412794078)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
		I3(x) => return 0 - int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
