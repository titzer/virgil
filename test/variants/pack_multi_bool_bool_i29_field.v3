//@execute 0=1; 1=1; 2=1; 3=1; 4=!TypeCheckException
type T #unboxed #packed {
	case R(s: string);
	case P(a: bool, b: bool, c: i29);
}
def fa = [false, true, false, true];
def fb = [true, false, true, false];
def fc: Array<i29> = [0, -268435456, 268435455, -1];
def vs = [T.P(false, true, 0), T.P(true, false, -268435456), T.P(false, true, 268435455), T.P(true, false, -1), T.R("r")];
def main(a: int) -> int {
	var p = T.P.!(vs[a]), n = (a + 1) & 3, r = 0;
	if (p == T.P(fa[a], fb[a], fc[a])) r |= 1;
	if (p.a != fa[a]) r |= 2;
	if (p == T.P(fa[n], fb[a], fc[a])) r |= 4;
	if (p.b != fb[a]) r |= 8;
	if (p == T.P(fa[a], fb[n], fc[a])) r |= 16;
	if (p.c != fc[a]) r |= 32;
	if (p.c == fc[n]) r |= 64;
	if (p == T.P(fa[a], fb[a], fc[n])) r |= 128;
	return r;
}
