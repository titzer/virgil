//@execute 0=true; 1=false; 2=true; 3=false; 4=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
type B #unboxed {
	case Box(c: C);
	case Two(c: C, d: C);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def c1 = cs[0], c2 = cs[2];
def vals = [A.IsB(B.Box(c1)), A.IsB(B.Two(c1, c2))];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.Box(c1)) == vals[0];
		1 => return A.IsB(B.Box(c2)) == vals[0];
		2 => return A.IsB(B.Two(c1, c2)) == vals[1];
		3 => return A.IsB(B.Two(c2, c1)) == vals[1];
		_ => return A.IsB(B.Two(cs[1], c2)) == vals[1];
	}
}
