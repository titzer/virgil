//@execute 0=1; 1=-1; 2=13; 3=7
type F #unboxed {
	case A(f: int -> int);
	case B(f: int -> int);

	def apply(v: int) -> int {
		match (this) {
			A(f) => return f(v);
			B(f) => return 10 + f(v);
		}
	}
}

def inc(x: int) => x + 1;
def neg(x: int) => 0 - x;

def fs = [F.A(inc), F.A(neg), F.B(inc), F.B(neg)];

def main(a: int) -> int {
	return fs[a & 3].apply(a);
}
