//@execute 0=3; 1=2; 2=77; 3=60000; 4=5; 5=0; 6=255; 7=65535
type T #unboxed #packed {
	case A(x: string);
	case B(x: Array<int>);
	case C(x: u8);
	case D(x: u16);
}

def ts = [T.A("abc"), T.B([1, 2]), T.C(77), T.D(60000), T.A("defgh"), T.B([]), T.C(255), T.D(65535)];

def main(a: int) -> int {
	match (ts[a]) {
		A(str) => return str.length;
		B(arr) => return arr.length;
		C(v) => return v;
		D(v) => return v;
	}
}
