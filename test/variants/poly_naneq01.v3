//@execute 0=false; 1=false; 2=false; 3=false
// poly_naneq00 for an unboxed polymorphic variant.
type UOpt<X> #unboxed {
	case Some(v: X);
	case None;
}
def FS: Array<UOpt<float>> = [UOpt<float>.Some(float.nan), UOpt<float>.Some(float.view(0x7F800001u))];
def DS: Array<UOpt<double>> = [UOpt<double>.Some(double.nan), UOpt<double>.Some(double.view(0xFFF80000_00000000uL))];
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, FS[i] == FS[i], DS[i] == DS[i]);
}
