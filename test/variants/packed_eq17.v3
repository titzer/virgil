//@execute 0=true; 1=false; 2=true; 3=false; 4=true
// Tagged-reference variants built at runtime and stored in class fields.
type T #unboxed #packed {
	case A(s: string);
	case B(x: u16);
}
class Cell {
	var t: T;
	new(t) { }
}

def mk(i: int) -> T {
	if (i < 0) return T.A(Array<byte>.new(0 - i));
	return T.B(u16.view(i));
}

def main(a: int) -> bool {
	var c = Cell.new(mk(5)), d = Cell.new(mk(5));
	match (a) {
		0 => return c.t == d.t;
		1 => { d.t = mk(6); return c.t == d.t; }
		2 => { d.t = mk(6); return c.t != d.t; }
		3 => { c.t = mk(-3); d.t = mk(-3); return c.t == d.t; }
		_ => { c.t = mk(-3); d.t = c.t; return c.t == d.t; }
	}
}
