//@execute 0=true; 1=true; 2=false; 3=true
// The same polymorphic variant instantiated at int and at float in one program.
type Opt<X> {
	case Some(v: X);
	case None;
}
def IS: Array<Opt<int>> = [Opt<int>.Some(0), Opt<int>.Some(-1)];
def FS: Array<Opt<float>> = [Opt<float>.Some(float.nan), Opt<float>.Some(1f)];
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, IS[i] == IS[i], FS[i] == FS[i]);
}
