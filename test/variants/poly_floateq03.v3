//@execute 0=3; 1=3; 2=0; 3=8; 4=16
// The smallest polymorphic matrix.
type Opt<X> {
	case Some(v: X);
	case None;
}

def ts: Array<Opt<float>> = [
	Opt<float>.Some(0f),
	Opt<float>.Some(-0f),
	Opt<float>.Some(float.nan),
	Opt<float>.Some(1f),
	Opt<float>.None
];

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (l == r) out |= (1 << u5.!(i));
	}
	return out;
}
