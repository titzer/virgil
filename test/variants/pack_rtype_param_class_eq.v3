//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=64; 7=128
class A(v: int) { }
type T<X> #unboxed #packed {
	case One(x: X);
	case Many(x: Array<X>);
	case I(n: i31);
}
def r1: Array<A> = [A.new(2), null];
def rn: Array<Array<A>> = [[A.new(2)], null];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T<A>.One(r1[0]),
	T<A>.One(r1[1]),
	T<A>.Many(rn[0]),
	T<A>.Many(rn[1]),
	T<A>.I(0),
	T<A>.I(-1),
	T<A>.I(1073741823),
	T<A>.I(-1073741824)
];
def mk(i: int) -> T<A> {
	match (i) {
		0 => return T<A>.One(r1[0]);
		1 => return T<A>.One(r1[1]);
		2 => return T<A>.Many(rn[0]);
		3 => return T<A>.Many(rn[1]);
		4 => return T<A>.I(xs[0]);
		5 => return T<A>.I(xs[1]);
		6 => return T<A>.I(xs[2]);
		_ => return T<A>.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
