//@execute 0=1; 1=1; 2=1; 3=1; 4=!TypeCheckException
type T #unboxed #packed {
	case R(s: string);
	case P(a: u32, b: u31);
}
def fa: Array<u32> = [0, 4294967295u, 2147483648u, 1];
def fb: Array<u31> = [2147483647, 0, 1431655765, 2];
def vs = [T.P(0, 2147483647), T.P(4294967295u, 0), T.P(2147483648u, 1431655765), T.P(1, 2), T.R("r")];
def main(a: int) -> int {
	var p = T.P.!(vs[a]), n = (a + 1) & 3, r = 0;
	if (p == T.P(fa[a], fb[a])) r |= 1;
	if (p.a != fa[a]) r |= 2;
	if (p.a == fa[n]) r |= 4;
	if (p == T.P(fa[n], fb[a])) r |= 8;
	if (p.b != fb[a]) r |= 16;
	if (p.b == fb[n]) r |= 32;
	if (p == T.P(fa[a], fb[n])) r |= 64;
	return r;
}
