//@execute =7
// The default elements of a freshly allocated array of variants are equal to each
// other, to a hand-built zero value and to a hand-built negative-zero value, but
// not to a NaN.
type T {
	case F(x: double);
	case I(y: int);
}
def main() -> int {
	var arr = Array<T>.new(2);
	var l = arr[0], r = arr[1];
	var out = if(l == r, 1);
	out |= if(l == T.F(0d), 2);
	out |= if(l == T.F(-0d), 4);
	out |= if(l == T.F(double.nan), 8);
	return out;
}
