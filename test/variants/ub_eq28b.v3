//@execute 0=3; 1=3; 2=0; 3=8; 4=16; 5=32; 6=64; 7=128
// ub_eq28 with the two-field case replaced by a single tuple field, as in ub_eq19b.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
	case IsBoth(x: (A, B));
}

def ts: Array<T<int, float>> = [
	T.IsBoth(0, 0f),
	T.IsBoth(0, -0f),
	T.IsBoth(0, float.nan),
	T.IsBoth(0, float.view(0x00000001u)),
	T.IsBoth(0, float.view(0x80000001u)),
	T.IsA(0),
	T.IsB(0f),
	T.IsBoth(1, 0f)
];

def cmp = T<int, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
