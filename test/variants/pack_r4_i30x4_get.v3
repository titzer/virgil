	T.I2(0), T.I2(1), T.I2(-1), T.I2(536870911), T.I2(-536870912), T.I2(536870910), T.I2(-536870911), T.I2(357913941), T.I2(-357913942), T.I2(268435456), T.I2(-268435456), T.I2(19088743), T.I2(-124076833),
	T.I3(0), T.I3(1), T.I3(-1), T.I3(536870911), T.I3(-536870912), T.I3(536870910), T.I3(-536870911), T.I3(357913941), T.I3(-357913942), T.I3(268435456), T.I3(-268435456), T.I3(19088743), T.I3(-124076833)
];
def get(v: T) -> int {
	match (v) {
		R0(x) => return if(x == null, -1, x[0]);
		R1(x) => return if(x == null, -2, int.view(x[0]));
		R2(x) => return if(x == null, -3, x.v);
		R3(x) => return if(x == null, -4, x.v);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
		I2(x) => return int.view(x) + 7;
		I3(x) => return 0 - int.view(x);
	}
}
def main(a: int) -> int {
	return get(vs[a]);
}
