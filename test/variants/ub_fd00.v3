//@execute 0=1069547520; 1=-2147483648; 2=0; 3=0; 4=0; 5=0; 6=1; 7=-1985229329; 8=-268435456; 9=-268435456; 10=1074003968; 11=-2147483648; 12=-3407872; 13=-2140143616; 14=1; 15=19088743
// Float and double cases in one unboxed variant, sharing a widened scalar slot.
type FD #unboxed {
	case F(x: float);
	case D(x: double);
	case B(x: float, y: double);
	case E;
}

def fds = [
	FD.F(1.5f), FD.F(-0f),
	FD.D(2.5d), FD.D(-0d),
	FD.B(-1.5f, 3.5d),
	FD.B(float.infinity, -double.infinity),
	FD.B(float.view(1u), double.view(1uL)),
	FD.E
];

def sig(v: FD) -> u64 {
	match (v) {
		F(x) => return 0xF0000000_00000000uL ^ u64.!(u32.view(x));
		D(x) => return u64.view(x);
		B(x, y) => return u64.view(y) ^ (u64.!(u32.view(x)) << 32);
		E => return 0x01234567_89ABCDEFuL;
	}
}

def main(a: int) -> int {
	var s = sig(fds[a & 7]);
	return if((a & 8) == 0, int.view(s), int.view(s >> 32));
}
