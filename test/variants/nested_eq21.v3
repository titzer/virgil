//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false
type C {
	case None;
	case Val(x: int);
}
def cs = [C.Val(1), C.Val(2), C.None];
def xs = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
class K(v: int) { }
type B #unboxed {
	case X(c: C);
	case Obj(k: K);
	case Arr(a: Array<int>);
}
type A #unboxed {
	case None;
	case IsB(b: B);
}
def ks = [K.new(1), K.new(1)];
def arrs = [[1], [1]];
def main(a: int) -> bool {
	match (a) {
		0 => return A.IsB(B.X(mkC(0))) == A.IsB(B.X(cs[0]));
		1 => return A.IsB(B.Obj(ks[0])) == A.IsB(B.Obj(ks[1]));
		2 => return A.IsB(B.Obj(ks[0])) == A.IsB(B.Obj(ks[0]));
		3 => return A.IsB(B.Arr(arrs[0])) == A.IsB(B.Arr(arrs[1]));
		4 => return A.IsB(B.Arr(arrs[1])) == A.IsB(B.Arr(arrs[1]));
		_ => return A.IsB(B.X(mkC(0))) == A.IsB(B.Obj(ks[0]));
	}
}
