//@execute 0=16; 1=16; 2=16; 3=33; 4=33; 5=66; 6=66; 7=66; 8=66
type T #unboxed #packed {
	case F(f: int -> int);
	case S(s: string);
	case I(x: i31);
}
def inc(x: int) -> int { return x + 1; }
def dec(x: int) -> int { return x - 1; }
def rf: Array<int -> int> = [inc, dec, null];
def rs: Array<string> = ["abc", null];
def xs: Array<i31> = [0, -1, 1073741823, -1073741824];
def vs = [
	T.F(rf[0]),
	T.F(rf[1]),
	T.F(rf[2]),
	T.S(rs[0]),
	T.S(rs[1]),
	T.I(0),
	T.I(-1),
	T.I(1073741823),
	T.I(-1073741824)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.F(rf[0]);
		1 => return T.F(rf[1]);
		2 => return T.F(rf[2]);
		3 => return T.S(rs[0]);
		4 => return T.S(rs[1]);
		5 => return T.I(xs[0]);
		6 => return T.I(xs[1]);
		7 => return T.I(xs[2]);
		_ => return T.I(xs[3]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r: int = d.tag;
	if (d.tag != vs[a].tag) return -1;
	if (T.F.?(d)) r |= 16;
	if (T.S.?(d)) r |= 32;
	if (T.I.?(d)) r |= 64;
	return r;
}
