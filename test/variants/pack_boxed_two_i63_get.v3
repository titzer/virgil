//@execute 0=9; 1=0; 2=109; 3=209; 4=200; 5=301; 6=0; 7=0; 8=-1073741824; 9=-1073741824; 10=-2147483648
type P {
	case U(a: int);
	case V(b: long);
}
type Q {
	case U(a: int);
	case W(s: string);
}
type T #unboxed #packed {
	case X(p: P);
	case Y(q: Q);
	case I(x: i63);
}
def ks = [9, 0];
def xs: Array<i63> = [0, -1, 4611686018427387903, -4611686018427387904, 3074457345618258602];
def vs = [
	T.X(P.U(9)),
	T.X(P.U(0)),
	T.X(P.V(9)),
	T.Y(Q.U(9)),
	T.Y(Q.U(0)),
	T.Y(Q.W("w")),
	T.I(0),
	T.I(-1),
	T.I(4611686018427387903),
	T.I(-4611686018427387904),
	T.I(3074457345618258602)
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(P.U(ks[0]));
		1 => return T.X(P.U(ks[1]));
		2 => return T.X(P.V(ks[0]));
		3 => return T.Y(Q.U(ks[0]));
		4 => return T.Y(Q.U(ks[1]));
		5 => return T.Y(Q.W("w"));
		6 => return T.I(xs[0]);
		7 => return T.I(xs[1]);
		8 => return T.I(xs[2]);
		9 => return T.I(xs[3]);
		_ => return T.I(xs[4]);
	}
}
def get(v: T) -> int {
	match (v) {
		X(p) => match (p) {
			U(a) => return a;
			V(b) => return 100 + int.view(b);
		}
		Y(q) => match (q) {
			U(a) => return 200 + a;
			W(s) => return 300 + s.length;
		}
		I(x) => return int.view(x) ^ int.view(x >> 32);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
