//@execute 0=1; 1=0; 2=0; 3=1; 4=2; 5=0
type X {
	case None;
	case IsY(y: Y);
}
type Y {
	case None;
	case IsX(x: X);
}
def xn = X.None, yn = Y.None;
def xy1 = X.IsY(yn), xy2 = X.IsY(Y.IsX(xn));
def depth(x: X) -> int {
	match (x) {
		None => return 0;
		IsY(y) => match (y) {
			None => return 1;
			IsX(x) => return 2 + depth(x);
		}
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return if(xy1 == X.IsY(Y.None), 1, 0);
		1 => return if(xy1 == xy2, 1, 0);
		2 => return if(xy2 == xn, 1, 0);
		3 => return if(xy2 == X.IsY(Y.IsX(X.None)), 1, 0);
		4 => return depth(xy2);
		_ => return depth(xn);
	}
}
