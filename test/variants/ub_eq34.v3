//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32; 6=192; 7=192
// ub_eq19's shape walking the float range at its boundaries.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
	case IsBoth(x: A, y: B);
}

def ts: Array<T<int, float>> = [
	T.IsBoth(0, float.infinity),
	T.IsBoth(0, -float.infinity),
	T.IsBoth(0, float.view(0x7F7FFFFFu)),	// largest normal
	T.IsBoth(0, float.view(0x00800000u)),	// smallest normal
	T.IsBoth(0, float.view(0x007FFFFFu)),	// largest subnormal
	T.IsBoth(0, float.view(0x00000001u)),	// smallest subnormal
	T.IsBoth(0, 0f),
	T.IsBoth(0, -0f)
];

def cmp = T<int, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
