//@execute 0=false; 1=false; 2=false; 3=false
// A polymorphic variant instantiated at float and at double.
type Opt<X> {
	case Some(v: X);
	case None;
}
def FS: Array<Opt<float>> = [Opt<float>.Some(float.nan), Opt<float>.Some(float.view(0x7F800001u))];
def DS: Array<Opt<double>> = [Opt<double>.Some(double.nan), Opt<double>.Some(double.view(0xFFF80000_00000000uL))];
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, FS[i] == FS[i], DS[i] == DS[i]);
}
