//@execute 0=3; 1=2; 2=7; 3=6; 4=5; 5=10
type F #unboxed {
	case H(f: (int -> int) -> int);
	case I(f: int -> int);
	case M(f: int -> (int -> int));

	def apply(v: int) -> int {
		match (this) {
			H(f) => return f(add(v, _));
			I(f) => return f(v);
			M(f) => return f(v)(5);
		}
	}
}

def add(x: int, y: int) => x + y;
def at3(f: int -> int) => f(3);
def adder(x: int) => add(x, _);
def inc(x: int) => x + 1;

def fs = [F.H(at3), F.I(inc), F.M(adder)];

def main(a: int) -> int {
	return fs[a % 3].apply(a);
}
