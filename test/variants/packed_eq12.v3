//@execute 0=true; 1=false; 2=true; 3=true
// Packed variants stored in mutable class fields.
type T #unboxed #packed {
	case A(x: u8, y: u8);
	case B(z: u4);
}
class Cell {
	var t: T;
	new(t) { }
}

def main(a: int) -> bool {
	var c = Cell.new(T.A(1, 2)), d = Cell.new(T.A(1, 2));
	match (a) {
		0 => return c.t == d.t;
		1 => { d.t = T.A(1, 3); return c.t == d.t; }
		2 => { d.t = T.A(1, 3); return c.t != d.t; }
		_ => { c.t = T.B(3); d.t = T.B(3); return c.t == d.t; }
	}
}
