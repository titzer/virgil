//@execute 0=6; 1=5; 2=-1; 3=3; 4=2; 5=0
type F<T> #unboxed {
	case M(f: T -> T);
	case P(f: T -> bool);

	def apply(v: T, d: T) -> T {
		match (this) {
			M(f) => return f(v);
			P(f) => return if(f(v), v, d);
		}
	}
}

def inc(x: int) => x + 1;
def pos(x: int) => x > 0;
def same(s: string) => s;
def empty(s: string) => s.length == 0;

def fi = [F<int>.M(inc), F<int>.P(pos)];
def fs = [F<string>.M(same), F<string>.P(empty)];

def main(a: int) -> int {
	match (a) {
		0 => return fi[0].apply(5, -1);
		1 => return fi[1].apply(5, -1);
		2 => return fi[1].apply(-5, -1);
		3 => return fs[0].apply("abc", "z").length;
		4 => return fs[1].apply("abc", "zz").length;
		_ => return fs[1].apply("", "zz").length;
	}
}
