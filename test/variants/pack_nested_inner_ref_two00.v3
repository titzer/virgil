//@execute 0=3; 1=5; 2=-1; 3=12; 4=7; 5=-7; 6=2; 7=9
type P #unboxed #packed {
	case S(s: string);
	case I(x: i30);
}
type Q #unboxed #packed {
	case A(a: Array<int>);
	case J(x: u30);
}
type T #unboxed #packed {
	case P(p: P);
	case Q(q: Q);
	case R(s: string);
	case K(x: i31);
}
def vs = [T.P(P.S("abc")), T.P(P.I(5)), T.P(P.I(-1)), T.Q(Q.A([12])), T.Q(Q.J(7)), T.K(-7), T.R("de"), T.Q(Q.A([9]))];
def get(t: T) -> int {
	match (t) {
		P(p) => match (p) {
			S(s) => return s.length;
			I(x) => return x;
		}
		Q(q) => match (q) {
			A(a) => return a[0];
			J(x) => return x;
		}
		R(s) => return s.length;
		K(x) => return x;
	}
}
def main(a: int) -> int {
	var w = Array<T>.new(2);
	w[a & 1] = vs[a];
	for (i < vs.length) if ((i != a) == (w[a & 1] == vs[i])) return -99;
	return get(w[a & 1]);
}
