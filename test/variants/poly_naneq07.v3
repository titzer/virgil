//@execute 0=false; 1=false; 2=false; 3=false
// A generic equality applied to a polymorphic variant.
type Opt<X> {
	case Some(v: X);
	case None;
}
def FS: Array<Opt<float>> = [Opt<float>.Some(float.nan), Opt<float>.Some(float.nan)];
def DS: Array<Opt<double>> = [Opt<double>.Some(double.nan), Opt<double>.Some(double.nan)];
def eq<X>(x: X) -> bool {
	return x == x;
}
def main(a: int) -> bool {
	var i = a & 1;
	return if((a & 2) == 0, eq(FS[i]), eq(DS[i]));
}
