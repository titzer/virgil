//@execute 0=false; 1=false; 2=true
// The recursive case is declared second and the double last, so the search for a
// non-reflexive member has to look past the first case and the first field.
type L {
	case Nil;
	case Cons(tail: L, head: double);
}
def CACHE: Array<L> = [
	L.Cons(L.Nil, double.nan),
	L.Cons(L.Cons(L.Nil, double.nan), 1d),
	L.Cons(L.Cons(L.Nil, 2d), 1d)
];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
