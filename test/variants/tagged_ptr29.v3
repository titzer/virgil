//@execute 0=3; 1=-1; 2=-2; 3=42; 4=-1; 5=-2; 6=5
// Field-less cases of a variant packed into a tagged reference, as constants and built in code.
type T #unboxed #packed {
	case A(s: string);
	case N;
	case M;
	case B(x: u8);
}

def ts = [T.A("abc"), T.N, T.M, T.B(42)];

def pick(a: int) -> T {
	if (a == 4) return T.N;
	if (a == 5) return T.M;
	if (a == 6) return T.A("defgh");
	return ts[a];
}

def main(a: int) -> int {
	match (pick(a)) {
		A(s) => return s.length;
		N => return -1;
		M => return -2;
		B(x) => return x;
	}
}
