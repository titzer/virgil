//@execute 0=false; 1=false
// ub_naneq00 for a double payload, whose scalar slot is a full 64 bits.
type T #unboxed {
	case D(x: double);
	case L(x: long);
}
def CACHE: Array<T> = [T.D(double.nan), T.D(double.view(0xFFF8000000000001uL))];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
