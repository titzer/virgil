//@execute 0=11; 1=12; 2=-1; 3=21; 4=22; 5=-2
class A(v: int) { }
class B(v: int) { }
type T #unboxed #packed {
	case X(a: A);
	case Y(b: B);
}
def ra: Array<A> = [A.new(11), A.new(12), null];
def rb: Array<B> = [B.new(21), B.new(22), null];
def vs = [
	T.X(ra[0]),
	T.X(ra[1]),
	T.X(ra[2]),
	T.Y(rb[0]),
	T.Y(rb[1]),
	T.Y(rb[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.X(ra[0]);
		1 => return T.X(ra[1]);
		2 => return T.X(ra[2]);
		3 => return T.Y(rb[0]);
		4 => return T.Y(rb[1]);
		_ => return T.Y(rb[2]);
	}
}
def get(v: T) -> int {
	match (v) {
		X(a) => return if(a == null, -1, a.v);
		Y(b) => return if(b == null, -2, b.v);
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
