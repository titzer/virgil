//@execute 0=false; 1=false; 2=true; 3=true
// The same cached boxed value, loaded twice.
type T #unboxed {
	case F(nonce: int, x: float);
	case I(x: int);
}
def CACHE: Array<T> = [T.F(11, float.nan), T.F(22, float.nan), T.I(11), T.I(12)];
def main(a: int) -> bool {
	var l = CACHE[a], r = CACHE[a];
	return l == r;
}
