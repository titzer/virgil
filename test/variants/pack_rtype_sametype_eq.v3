//@execute 0=1; 1=2; 2=4; 3=8; 4=16; 5=32
type T #unboxed #packed {
	case S(x: string);
	case B(x: Array<byte>);
}
def rs: Array<string> = ["ab", "cd", null];
def vs = [
	T.S(rs[0]),
	T.S(rs[1]),
	T.S(rs[2]),
	T.B(rs[0]),
	T.B(rs[1]),
	T.B(rs[2])
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.S(rs[0]);
		1 => return T.S(rs[1]);
		2 => return T.S(rs[2]);
		3 => return T.B(rs[0]);
		4 => return T.B(rs[1]);
		_ => return T.B(rs[2]);
	}
}
def main(a: int) -> int {
	var d = mk(a), r = 0;
	for (i < vs.length) if (d == vs[i]) r |= 1 << u5.view(i);
	return r;
}
