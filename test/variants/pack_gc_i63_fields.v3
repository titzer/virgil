//@execute 0=-1; 1=1073741823; 2=-1073741824; 3=-1073741827; 4=1073741820; 5=5
//@heap-size=20000
type T #unboxed #packed {
	case R(s: string);
	case I0(x: i63);
	case I1(x: i63);
}
def vs = [T.R("s1"), T.R(null), T.I0(-4611686018427387904), T.I0(-1), T.I1(4611686018427387903), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return (int.view(x) ^ int.view(x >> 32));
		I1(x) => return ~(int.view(x) ^ int.view(x >> 32));
	}
}
class N(t: T, next: N) {
	var u: T;
}
def main(a: int) -> int {
	var l: N;
	for (i < vs.length) {
		l = N.new(vs[(a + i) % vs.length], l);
		l.u = T.R(Array<byte>.new(i));
		if ((i & 1) == 1) CiTest.forceGc();
	}
	CiTest.forceGc();
	var i = vs.length - 1;
	for (n = l; n != null; n = n.next) {
		if (get(n.u) != i) return -99;
		if (n.t != vs[(a + i) % vs.length]) return -98;
		i--;
	}
	return get(l.next.next.next.next.next.t) + 3 * get(l.next.next.next.next.t);
}
