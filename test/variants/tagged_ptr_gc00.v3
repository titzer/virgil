//@execute 0=3; 1=9; 2=15; 3=21; 4=27; 5=33
class C(x: int) { }

type T #unboxed #packed {
	case A(x: u14);
	case C(c: C);
	def get() -> int {
		match (this) {
			A(x) => return x;
			C(c) => return c.x;
		}
	}
}

var roots = Array<T>.new(6);

def main(a: int) -> int {
	// fill in the roots array with values, forcing GC each time
	for (i < roots.length) {
		CiTest.forceGc();
		roots[i] = if ((i % 2) == 0, T.A(u14.!(a + 1)), T.C(C.new(a)));
	}

	// sum the values in the roots array
	var sum = 0;
	for (r in roots) {
		CiTest.forceGc();
		sum += r.get();
	}
	return sum;
}
