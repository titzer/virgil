//@execute 0=false; 1=false; 2=false; 3=false
// ub_naneq10 and ub_naneq11 for double: an unboxed variant nested in a boxed one,
// and a boxed variant nested in an unboxed one.
type UInner #unboxed {
	case D(x: double);
	case L(x: long);
}
type BOuter {
	case W(i: UInner);
	case N;
}
type BInner {
	case D(x: double);
	case L(x: long);
}
type UOuter #unboxed {
	case W(i: BInner);
	case N;
}
def BS: Array<BOuter> = [BOuter.W(UInner.D(double.nan)), BOuter.W(UInner.D(1d))];
def US: Array<UOuter> = [UOuter.W(BInner.D(double.nan)), UOuter.W(BInner.D(1d))];
def main(a: int) -> bool {
	if ((a & 2) == 0) {
		var v = BS[a & 1];
		return if((a & 1) == 0, v == v, !(v == v));
	}
	var v = US[a & 1];
	return if((a & 1) == 0, v == v, !(v == v));
}
