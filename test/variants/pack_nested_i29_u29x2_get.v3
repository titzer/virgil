//@execute 0=1; 1=-1; 2=0; 3=1; 4=-1; 5=268435455; 6=-268435456; 7=89478485; 8=-1; 9=-2; 10=-536870912; 11=-268435457; 12=-268435456; 13=-357913942; 14=1; 15=2; 16=0; 17=268435456; 18=-268435455; 19=89478486; 20=0; 21=-1; 22=-536870911; 23=-268435456; 24=-268435455; 25=-357913941
type P #unboxed #packed {
	case X(a: i29);
	case Y(b: u29);
}
type T #unboxed #packed {
	case R(s: string);
	case N0(p: P);
	case N1(p: P);
}
def rs: Array<string> = ["r", null];
def xa: Array<i29> = [0, 1, -1, 268435455, -268435456, 89478485];
def xb: Array<u29> = [0, 1, 536870911, 268435456, 268435455, 357913941];
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.N0(P.X(0)),
	T.N0(P.X(1)),
	T.N0(P.X(-1)),
	T.N0(P.X(268435455)),
	T.N0(P.X(-268435456)),
	T.N0(P.X(89478485)),
	T.N0(P.Y(0)),
	T.N0(P.Y(1)),
	T.N0(P.Y(536870911)),
	T.N0(P.Y(268435456)),
	T.N0(P.Y(268435455)),
	T.N0(P.Y(357913941)),
	T.N1(P.X(0)),
	T.N1(P.X(1)),
	T.N1(P.X(-1)),
	T.N1(P.X(268435455)),
	T.N1(P.X(-268435456)),
	T.N1(P.X(89478485)),
	T.N1(P.Y(0)),
	T.N1(P.Y(1)),
	T.N1(P.Y(536870911)),
	T.N1(P.Y(268435456)),
	T.N1(P.Y(268435455)),
	T.N1(P.Y(357913941))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.N0(P.X(xa[0]));
		3 => return T.N0(P.X(xa[1]));
		4 => return T.N0(P.X(xa[2]));
		5 => return T.N0(P.X(xa[3]));
		6 => return T.N0(P.X(xa[4]));
		7 => return T.N0(P.X(xa[5]));
		8 => return T.N0(P.Y(xb[0]));
		9 => return T.N0(P.Y(xb[1]));
		10 => return T.N0(P.Y(xb[2]));
		11 => return T.N0(P.Y(xb[3]));
		12 => return T.N0(P.Y(xb[4]));
		13 => return T.N0(P.Y(xb[5]));
		14 => return T.N1(P.X(xa[0]));
		15 => return T.N1(P.X(xa[1]));
		16 => return T.N1(P.X(xa[2]));
		17 => return T.N1(P.X(xa[3]));
		18 => return T.N1(P.X(xa[4]));
		19 => return T.N1(P.X(xa[5]));
		20 => return T.N1(P.Y(xb[0]));
		21 => return T.N1(P.Y(xb[1]));
		22 => return T.N1(P.Y(xb[2]));
		23 => return T.N1(P.Y(xb[3]));
		24 => return T.N1(P.Y(xb[4]));
		_ => return T.N1(P.Y(xb[5]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		N0(p) => match (p) {
			X(a) => return (int.view(a)) + 0;
			Y(b) => return ~(int.view(b)) + 0;
		}
		N1(p) => match (p) {
			X(a) => return (int.view(a)) + 1;
			Y(b) => return ~(int.view(b)) + 1;
		}
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
