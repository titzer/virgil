//@execute 0=true; 1=false; 2=false; 3=true; 4=false; 5=true
// Equality in conditions and results of packed variants passed through parameters.
type T #unboxed #packed {
	case A(x: u8, y: u8);
	case B(z: u4);
}

def same(a: T, b: T) -> bool { return a == b; }
def diff(a: T, b: T) -> bool { return a != b; }
def pick(a: int) -> T {
	return if(a == 1, T.A(3, 4), if(a == 2, T.A(3, 5), T.B(7)));
}

def main(a: int) -> bool {
	match (a) {
		0 => return same(pick(1), T.A(3, 4));
		1 => return same(pick(1), pick(2));
		2 => return same(pick(1), pick(3));
		3 => return diff(pick(1), pick(2));
		4 => return diff(pick(3), T.B(7));
		_ => return same(pick(3), T.B(7));
	}
}
