//@execute 0=true; 1=true; 2=true; 3=true; 4=true
// boxed_zeroeq00 for double, over every position a signed zero can occupy: a bare
// field, one of two fields, and each component of a tuple field.
type T {
	case A(x: double);
	case B(x: double, y: double);
	case C(v: (double, double));
}
def POS: Array<T> = [T.A(0d), T.B(0d, 1d), T.B(1d, 0d), T.C((0d, 1d)), T.C((1d, 0d))];
def NEG: Array<T> = [T.A(-0d), T.B(-0d, 1d), T.B(1d, -0d), T.C((-0d, 1d)), T.C((1d, -0d))];
def main(a: int) -> bool {
	return POS[a] == NEG[a];
}
