//@execute 0=-1430532899; 1=1090051375; 2=287454020; 3=-1036936806
type T #unboxed {
	case I(val: u32);
	case F(val: float);
}

def ts = [T.I(0xAABBCCDD), T.F(7.777f), T.I(0x11223344), T.F(-44.4f)];

def main(a: int) -> u32 {
	var v = ts[a & 3];
	match (v) {
		I(v) => return v;
		F(v) => return u32.view(v);
	}
}
