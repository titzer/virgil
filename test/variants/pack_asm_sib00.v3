//@execute 0=13; 1=77; 2=141; 3=205; 4=255; 5=0
class Reg(regnum: byte) {
	def low3 = u3.view(regnum);
}
def RCX = Reg.new(1), RBP = Reg.new(5), R15 = Reg.new(15), RAX = Reg.new(0);
def log2(scale: byte) -> int { var r = 0; while (scale > 1) { scale = scale >> 1; r++; } return r; }
def sib(scale: byte, index: Reg, base: Reg) -> byte {
	return byte.pack<(u2, u3, u3)>((u2.view(log2(scale)), index.low3, if(base != null, base, RBP).low3));
}
def main(a: int) -> int {
	match (a) {
		0 => return sib(1, RCX, null);
		1 => return sib(2, RCX, RBP);
		2 => return sib(4, RCX, null);
		3 => return sib(8, RCX, RBP);
		4 => return sib(8, R15, R15);
		_ => return sib(1, RAX, RAX);
	}
}
