//@execute 0=0; 1=1; 2=1; 3=0; 4=0; 5=-1
type T #unboxed #packed {
	case R(s: string);
	case I0(x: u31);
	case I1(x: u31);
}
def vs = [T.R("s1"), T.R(null), T.I0(1073741824), T.I0(1), T.I1(2147483647), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return int.view(x);
		I1(x) => return ~int.view(x);
	}
}
var d: T;
def ds = Array<T>.new(2);
def main(a: int) -> int {
	match (a) {
		0 => return d.tag;
		1 => return if(d == vs[1], 1, 0);
		2 => return if(ds[1] == T.R(null), 1, 0);
		3 => return if(d == vs[5], 1, 0);
		4 => return if(T.I0.?(ds[0]), 1, 0);
		_ => return get(ds[0]);
	}
}
