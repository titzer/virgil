//@execute 0=1; 1=3; 2=4
// A never-allocated case in the middle of an exhaustive match.
class R(v: int) { }
type Op #unboxed {
	case A;
	case D(y: long, z: int);
	case B(x: int);
	case C(r: R);
}
def visitD(x: Op.D) -> int { return int.view(x.y) + x.z; }
def visit(op: Op) -> int {
	match (op) {
		x: Op.A => return 1;
		x: Op.D => return visitD(x);
		x: Op.B => return x.x;
		x: Op.C => return x.r.v;
	}
}
def make(a: int) -> Op {
	match (a) {
		0 => return Op.A;
		1 => return Op.B(3);
		_ => return Op.C(R.new(4));
	}
}
def main(a: int) -> int {
	return visit(make(a));
}
