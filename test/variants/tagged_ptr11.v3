//@execute 0=3; 1=9; 2=5; 3=99
type T #unboxed #packed {
	case A(x: string);
	case B(x: u8);
}

def make(a: int) -> T {
	if (a == 0) return T.A("abc");
	if (a == 1) return T.B(9);
	if (a == 2) return T.A(Array<byte>.new(5));
	return T.B(99);
}

def main(a: int) -> int {
	var arr = Array<T>.new(4);
	for (i < 4) arr[i] = make(i);
	match (arr[a]) {
		A(str) => return str.length;
		B(v) => return v;
	}
}
