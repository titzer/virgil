//@execute 0=2; 1=-1; 2=1073741824; 3=1; 4=2147483647; 5=-1
type T #unboxed #packed {
	case R(s: string);
	case I0(x: u63);
	case I1(x: u63);
}
def vs = [T.R("s1"), T.R(null), T.I0(4611686018427387904), T.I0(1), T.I1(9223372036854775807), T.I1(0)];
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		I0(x) => return (int.view(x) ^ int.view(x >> 32));
		I1(x) => return ~(int.view(x) ^ int.view(x >> 32));
	}
}
class K(t: T) {
	def run() -> int { return get(t); }
}
def main(a: int) -> int {
	var f = K.new(vs[a]).run;
	return f();
}
