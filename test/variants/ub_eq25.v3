//@execute 0=1; 1=6; 2=6; 3=8; 4=16; 5=0; 6=64; 7=128
// The sharpest statement of the difference.
type T<A, B> #unboxed {
	case IsA(x: A);
	case IsB(x: B);
}

def ts: Array<T<u32, float>> = [
	T.IsA(0x00000000u),
	T.IsB(0f),
	T.IsB(-0f),
	T.IsA(0x80000000u),
	T.IsA(0x7FC00000u),
	T.IsB(float.nan),
	T.IsA(0x00000001u),
	T.IsB(float.view(0x00000001u))
];

def cmp = T<u32, float>.==;

def main(a: int) -> int {
	var l = ts[a];
	var out = 0;
	for (i < ts.length) {
		var r = ts[i];
		if (cmp(l, r)) out |= (1 << u5.view(i));
	}
	return out;
}
