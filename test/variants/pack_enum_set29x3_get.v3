//@execute 0=1; 1=-1; 2=0; 3=1; 4=536870911; 5=268435456; 6=268435455; 7=357913941; 8=178956970; 9=162254319; 10=-1; 11=-2; 12=-536870912; 13=-268435457; 14=-268435456; 15=-357913942; 16=-178956971; 17=-162254320; 18=7; 19=8; 20=536870918; 21=268435463; 22=268435462; 23=357913948; 24=178956977; 25=162254326
enum E { E0, E1, E2, E3, E4, E5, E6, E7, E8, E9, E10, E11, E12, E13, E14, E15, E16, E17, E18, E19, E20, E21, E22, E23, E24, E25, E26, E27, E28 }
type T #unboxed #packed {
	case R(s: string);
	case S0(s: E.set);
	case S1(s: E.set);
	case S2(s: E.set);
}
def rs: Array<string> = ["r", null];
def ms = [0, 1, 536870911, 268435456, 268435455, 357913941, 178956970, 162254319];
def set(m: int) -> E.set {
	var s: E.set;
	for (e in E.set.all) if (((m >> u6.view(e.tag)) & 1) != 0) s |= e;
	return s;
}
def bits(s: E.set) -> int {
	var r: int;
	for (e in s) r |= 1 << u6.view(e.tag);
	return r;
}
def vs = [
	T.R(rs[0]),
	T.R(rs[1]),
	T.S0(set(ms[0])),
	T.S0(set(ms[1])),
	T.S0(set(ms[2])),
	T.S0(set(ms[3])),
	T.S0(set(ms[4])),
	T.S0(set(ms[5])),
	T.S0(set(ms[6])),
	T.S0(set(ms[7])),
	T.S1(set(ms[0])),
	T.S1(set(ms[1])),
	T.S1(set(ms[2])),
	T.S1(set(ms[3])),
	T.S1(set(ms[4])),
	T.S1(set(ms[5])),
	T.S1(set(ms[6])),
	T.S1(set(ms[7])),
	T.S2(set(ms[0])),
	T.S2(set(ms[1])),
	T.S2(set(ms[2])),
	T.S2(set(ms[3])),
	T.S2(set(ms[4])),
	T.S2(set(ms[5])),
	T.S2(set(ms[6])),
	T.S2(set(ms[7]))
];
def mk(i: int) -> T {
	match (i) {
		0 => return T.R(rs[0]);
		1 => return T.R(rs[1]);
		2 => return T.S0(set(ms[0]));
		3 => return T.S0(set(ms[1]));
		4 => return T.S0(set(ms[2]));
		5 => return T.S0(set(ms[3]));
		6 => return T.S0(set(ms[4]));
		7 => return T.S0(set(ms[5]));
		8 => return T.S0(set(ms[6]));
		9 => return T.S0(set(ms[7]));
		10 => return T.S1(set(ms[0]));
		11 => return T.S1(set(ms[1]));
		12 => return T.S1(set(ms[2]));
		13 => return T.S1(set(ms[3]));
		14 => return T.S1(set(ms[4]));
		15 => return T.S1(set(ms[5]));
		16 => return T.S1(set(ms[6]));
		17 => return T.S1(set(ms[7]));
		18 => return T.S2(set(ms[0]));
		19 => return T.S2(set(ms[1]));
		20 => return T.S2(set(ms[2]));
		21 => return T.S2(set(ms[3]));
		22 => return T.S2(set(ms[4]));
		23 => return T.S2(set(ms[5]));
		24 => return T.S2(set(ms[6]));
		_ => return T.S2(set(ms[7]));
	}
}
def get(v: T) -> int {
	match (v) {
		R(s) => return if(s == null, -1, s.length);
		S0(s) => return bits(s);
		S1(s) => return ~bits(s);
		S2(s) => return bits(s) + 7;
	}
}
def main(a: int) -> int {
	var x = get(vs[a]);
	return if(x == get(mk(a)), x, -99);
}
