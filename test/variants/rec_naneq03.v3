//@execute 0=true; 1=true; 2=true
// Control for rec_naneq02: mutually recursive variants with no float member.
type A {
	case Wrap(b: B);
	case None;
}
type B {
	case Val(x: int, a: A);
	case Nil;
}
def CACHE: Array<A> = [A.Wrap(B.Val(0, A.None)), A.Wrap(B.Val(1, A.None)), A.None];
def main(a: int) -> bool {
	var v = CACHE[a];
	return v == v;
}
