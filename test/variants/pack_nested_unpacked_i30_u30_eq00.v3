//@execute 0=true; 1=true; 2=true; 3=true
type P #unboxed {
	case X(a: i30);
	case Y(b: u30);
}
type T #unboxed {
	case N(p: P);
}
def xa: Array<i30> = [0, -1];
def xb: Array<u30> = [0, 7];
def vs = [T.N(P.X(0)), T.N(P.X(-1)), T.N(P.Y(0)), T.N(P.Y(7))];
def main(a: int) -> bool {
	if (a < 2) return T.N(P.X(xa[a])) == vs[a];
	return T.N(P.Y(xb[a - 2])) == vs[a];
}
