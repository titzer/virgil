//@execute 0=1; 1=2; 2=4; 3=8
type F #unboxed {
	case S(f: i32 -> i32);
	case U(f: u32 -> u32);

	def apply(v: u32) -> u32 {
		match (this) {
			S(f) => return u32.view(f(i32.view(v)));
			U(f) => return f(v);
		}
	}
}

def id_s(x: i32) => x;
def id_u(x: u32) => x;

def flip_s(x: i32) => ~x;
def flip_u(x: u32) => ~x;

def fs = [
	F.S(id_s),
	F.S(flip_s),
	F.U(id_u),
	F.U(flip_u)
];

def gs = [id_s, flip_s];
def hs = [id_u, flip_u];

def mk(i: int) -> F {
	if (i < 2) return F.S(gs[i]);
	return F.U(hs[i - 2]);
}

def main(a: int) -> int {
	var d = mk(a & 3), r = 0;
	for (i < fs.length) if (d == fs[i]) r |= 1 << u5.view(i);
	return r;
}
