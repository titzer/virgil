#!/usr/bin/env bash
# Runs the C compiler for x86-64-linux inside a linux/amd64 container, for hosts
# that cannot compile and link programs for that target themselves.
#
# Usage: cc-x86-64-linux@docker <cc arguments>
#
# The files named in the arguments must be in the current directory or in the
# test output directory, which are the two directories the container can see.

IMAGE=virgil-cc-x86-64-linux

# Build the image on first use; subsequent builds hit the docker layer cache.
if ! docker image inspect $IMAGE >/dev/null 2>&1; then
    docker build --platform linux/amd64 -q -t $IMAGE - >/dev/null 2>&1 <<'EOF'
FROM alpine:3.20
RUN apk add --no-cache gcc musl-dev
EOF
    if [ $? != 0 ]; then
	echo "cc-x86-64-linux@docker: could not build $IMAGE image" 1>&2
	exit 1
    fi
fi

exec docker run --rm --platform linux/amd64 \
     -v "$PWD:$PWD" ${VIRGIL_TEST_OUT:+-v "$VIRGIL_TEST_OUT:$VIRGIL_TEST_OUT"} \
     --workdir "$PWD" \
     $IMAGE \
     cc "$@"
