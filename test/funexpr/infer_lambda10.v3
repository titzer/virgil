//@execute 0=2; 1=5; 4=14; -3=-7
// Mutable inferred fields holding lambdas, reassigned after first use.
def main(a: int) -> int {
	var f = Accs.F, g = Accs.G;
	var r = Accs.F(a) + Accs.G(a);
	Accs.F = Accs.G;
	Accs.G = fun (x: int) => x - 1;
	r = r + Accs.F(a) - Accs.G(a) - a;
	Accs.F = f;
	Accs.G = g;
	return r;
}
component Accs {
	var F = fun (x: int) => x + 1;
	var G = fun (x: int) => x * 2;
}
