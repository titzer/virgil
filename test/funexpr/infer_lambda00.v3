//@execute 0=52; 1=4660
// Two component fields with inferred types, each initialized with lambdas, are referenced
// before the component is verified, so each initializer is type-checked on demand.
def main(a: int) -> int {
	var v = I32.new(0x1234);
	var x = I32.!(Accs.U8.roundtrip(v)).val;
	var y = I32.!(Accs.U16.roundtrip(v)).val;
	return if(a == 0, int.view(x), int.view(y));
}
class Value { }
class I32(val: u32) extends Value { }
class Acc<T> {
	def box: T -> Value;
	def unbox: Value -> T;
	new(box, unbox) { }
	def roundtrip(v: Value) -> Value { return box(unbox(v)); }
}
component Accs {
	def U8 = Acc.new(fun (d: u8) => I32.new(d), fun (v: Value) => u8.view(I32.!(v).val));
	def U16 = Acc.new(fun (d: u16) => I32.new(d), fun (v: Value) => u16.view(I32.!(v).val));
}
