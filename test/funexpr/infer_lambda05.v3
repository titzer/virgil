//@execute 0=180; 1=63156; 2=-76; 3=-2380; 4=305460916
// Several inferred fields with lambdas over integer types that share JVM representations.
def main(a: int) -> int {
	var v = I32.new(0x1234F6B4);
	match (a) {
		0 => return int.view(I32.!(Accs.U8.roundtrip(v)).val);
		1 => return int.view(I32.!(Accs.U16.roundtrip(v)).val);
		2 => return int.view(I32.!(Accs.I8.roundtrip(v)).val);
		3 => return int.view(I32.!(Accs.I16.roundtrip(v)).val);
		_ => return int.view(I32.!(Accs.U32.roundtrip(v)).val);
	}
}
class Value { }
class I32(val: u32) extends Value { }
class Acc<T> {
	def box: T -> Value;
	def unbox: Value -> T;
	new(box, unbox) { }
	def roundtrip(v: Value) -> Value { return box(unbox(v)); }
}
component Accs {
	def U8 = Acc.new(fun (d: u8) => I32.new(d), fun (v: Value) => u8.view(I32.!(v).val));
	def U16 = Acc.new(fun (d: u16) => I32.new(d), fun (v: Value) => u16.view(I32.!(v).val));
	def I8 = Acc.new(fun (d: i8) => I32.new(u32.view(d)), fun (v: Value) => i8.view(I32.!(v).val));
	def I16 = Acc.new(fun (d: i16) => I32.new(u32.view(d)), fun (v: Value) => i16.view(I32.!(v).val));
	def U32 = Acc.new(fun (d: u32) => I32.new(d), fun (v: Value) => I32.!(v).val);
}
