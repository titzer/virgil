//@execute 0=0; 1=6; 3=30; 10=240
// Only the first class field is inferred on demand; the second is checked in the normal
// constructor path, which also has no enclosing method name.
def main(a: int) => C.new(a).f(a) + Later.use(a);
class C(k: int) {
	def f = fun (x: int) => x + k;
	def g = fun (x: int) => x * k;
}
component Later {
	def use(a: int) -> int {
		var c = C.new(a);
		return c.g(a) + c.f(a) + c.g(a);
	}
}
