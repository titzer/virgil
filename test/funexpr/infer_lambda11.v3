//@execute 0=3; 1=5; 4=11; -3=-3
// Inferred fields whose lambdas are wrapped to a supertype-returning function type.
def main(a: int) -> int {
	var p = Pair.new(Accs.mk1, Accs.mk2);
	return B.!(p.a(a)).n + B.!(p.b(a)).n;
}
class A { }
class B(n: int) extends A { }
class Pair(a: int -> A, b: int -> A) { }
component Accs {
	def mk1 = fun (x: int) => B.new(x + 1);
	def mk2 = fun (x: int) => B.new(x + 2);
}
