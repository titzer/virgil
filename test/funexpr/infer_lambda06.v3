//@execute 0=1; 1=4; 5=16; -2=-5
// One inferred initializer references another inferred field of the same component, so
// inference nests and both initializers are checked in separate nameless environments.
def main(a: int) => Accs.x(a);
component Accs {
	def x = fun (a: int) => y(a) + 1;
	def y = fun (a: int) => a * 3;
}
