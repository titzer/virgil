//@execute 0=3; 1=6; 5=18; -1=0
// The inferred component fields are first referenced from a class field initializer.
def main(a: int) => Early.new(a).v + Accs.G(a);
class Early(a: int) {
	def v = Accs.F(a) + Accs.G(1);
}
component Accs {
	def F = fun (x: int) => x + 1;
	def G = fun (x: int) => x * 2;
}
