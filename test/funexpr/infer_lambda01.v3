//@execute 0=2; 5=12; 10=22; -3=-4
// Lambdas with identical signatures but different bodies; a name collision here silently
// runs the wrong body instead of failing verification.
def main(a: int) => Accs.G(Accs.F(a));
component Accs {
	def F = fun (x: int) => x + 1;
	def G = fun (x: int) => x * 2;
}
