//@execute 0=1; 1=5; 3=19; 10=131
// Void-returning lambdas with the same signature that mutate component state.
def main(a: int) -> int {
	Accs.count = 1;
	Accs.add(a);
	Accs.mul(a + 1);
	Accs.add(a);
	return Accs.count;
}
component Accs {
	var count = 0;
	def add = fun (x: int) { count = count + x; };
	def mul = fun (x: int) { count = count * x; };
}
