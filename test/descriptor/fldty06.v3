//@execute 0=7; 1=0
type Opt { case None; case Some(v: int); }
class D(o: Opt) describes A { }
class A descriptor D { }
def some = A.new(D.new(Opt.Some(7)));
def none = A.new(D.new(Opt.None));

def main(x: int) -> int {
	var a = if(x == 0, some, none);
	match (a.descriptor.o) {
		None => return 0;
		Some(v) => return v;
	}
}
