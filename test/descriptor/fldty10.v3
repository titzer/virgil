//@execute 0=6; 1=1
class D(t: (int, (int, int)), u: ((bool, int), int)) describes A { }
class A descriptor D { }
def a = A.new(D.new((1, (2, 3)), ((true, 4), 5)));

def main(x: int) -> int {
	match (x) {
		0 => return a.descriptor.t.0 + a.descriptor.t.1.0 + a.descriptor.t.1.1;
		1 => return if(a.descriptor.u.0.0 && a.descriptor.u.0.1 == 4 && a.descriptor.u.1 == 5, 1, 0);
	}
	return -1;
}
