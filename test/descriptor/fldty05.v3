//@execute 0=1; 1=1
enum Color { RED, GREEN, BLUE }
class D(c: Color, s: Color.set) describes A { }
class A descriptor D { }
def a = A.new(D.new(Color.GREEN, Color.RED | Color.BLUE));

def main(x: int) -> int {
	match (x) {
		0 => return if(a.descriptor.c == Color.GREEN, 1, 0);
		1 => return if(a.descriptor.s.RED && !a.descriptor.s.GREEN, 1, 0);
	}
	return -1;
}
