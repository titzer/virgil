//@execute 0=1; 1=1; 2=1
class D(f: float, d: double, nan: double, inf: float) describes A { }
class A descriptor D { }
def desc = D.new(1.5f, 2.25d, double.nan, float.infinity);
def a = A.new(desc);

def main(x: int) -> int {
	match (x) {
		0 => return if(a.descriptor.f == 1.5f && a.descriptor.d == 2.25d, 1, 0);
		1 => return if(a.descriptor.nan != a.descriptor.nan, 1, 0);
		2 => return if(a.descriptor.inf == float.infinity, 1, 0);
	}
	return -1;
}
