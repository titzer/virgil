//@execute 0=1; 1=12
class E(v: int) { }
class D(t: (int, E, int, E)) describes A { }
class A descriptor D { }
def e1 = E.new(5), e2 = E.new(7);
def a = A.new(D.new((1, e1, 2, e2)));

def main(x: int) -> int {
	match (x) {
		0 => return if(a.descriptor.t.1 == e1 && a.descriptor.t.3 == e2, 1, 0);
		1 => return a.descriptor.t.1.v + a.descriptor.t.3.v;
	}
	return -1;
}
