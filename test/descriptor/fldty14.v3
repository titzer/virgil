//@execute 0=8; 1=1
class D(op: A -> int) describes A { }
class A(n: int) descriptor D { def twice() -> int { return n * 2; } }
def a = A.new(D.new(A.twice), 4);
def main(x: int) -> int {
	match (x) {
		0 => return a.descriptor.op(a);
		1 => {
			var c = a.twice;      // bound closure over a described receiver
			return if(c() == 8, 1, 0);
		}
	}
	return -1;
}
