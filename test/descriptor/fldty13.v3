//@execute 0=11; 1=1; 2=20
class D(f: int -> int, g: int -> int, h: int -> int) describes A { }
class A descriptor D { }
def bump(x: int) -> int { return x + 1; }
def cap = 10;
def lambda(x: int) => x + cap;
def a = A.new(D.new(bump, lambda, null));
def main(x: int) -> int {
	match (x) {
		0 => return a.descriptor.f(10);
		1 => return if(a.descriptor.h == null, 1, 0);
		2 => return a.descriptor.g(10);
	}
	return -1;
}
