//@execute 0=3; 1=9
class SA<T>(t: (int, T, int)) { }
class D<T>(n: int) describes A<T> { }
class A<T> extends SA<T> descriptor D<T> { new(t: (int, T, int)) super(t.0, t.1, t.2) { } }
def a = A<bool>.new(D<bool>.new(9), 1, true, 2);
def main(x: int) -> int {
	match (x) {
		0 => return a.t.0 + a.t.2;
		1 => return a.descriptor.n;
	}
	return -1;
}
