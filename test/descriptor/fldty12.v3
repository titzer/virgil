//@execute 0=1; 1=5
class D<T>(n: int) describes A<T> { }
class A<T>(u: T) descriptor D<T> { }
def a = A<(int, bool)>.new(D<(int, bool)>.new(5), 3, true); // tuple type arg flattens too
def main(x: int) -> int {
	match (x) {
		0 => return if(a.u.0 == 3 && a.u.1, 1, 0);
		1 => return a.descriptor.n;
	}
	return -1;
}
