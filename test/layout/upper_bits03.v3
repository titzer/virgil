//@execute = 0
// Each write touches exactly its own bytes; canary bytes in between must survive.
layout S { +1 a: u8; +3 b: u16; +6 c: u23; +10 d: u32 #big-endian; +15 e: u48; +22 f: double; =31; }

def data = Array<byte>.new(31);
def r = Ref<S>.of(data);

def expected: Array<byte> = [
	0xAA, 0x11, 0xAA,
	0x33, 0x22, 0xAA,
	0x56, 0x34, 0x12, 0xAA,
	0x11, 0x22, 0x33, 0x44, 0xAA,
	0x66, 0x55, 0x44, 0x33, 0x22, 0x11, 0xAA,
	0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0xAA
];

def main() -> int {
	for (i < data.length) data[i] = 0xAA;
	r.a = 0x11;
	r.b = 0x2233;
	r.c = 0x123456;
	r.d = 0x11223344;
	r.e = 0x112233445566;
	r.f = double.view(0x0102030405060708uL);
	for (i < expected.length) if (data[i] != expected[i]) return i + 1;
	return 0;
}
