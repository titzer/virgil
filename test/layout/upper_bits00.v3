//@execute = 0
// Narrow-width writes overwrite trailing upper bits with zero/sign extension bits.
layout S { +0 a: u17; +3 b: u23; +6 c: u28; +10 d: i23; +13 e: u33; +18 f: u41; =24; }

def data = Array<byte>.new(24);
def r = Ref<S>.of(data);

def expected: Array<byte> = [
	0x55, 0x55, 0x01,
	0x56, 0x34, 0x12,
	0x67, 0x45, 0x23, 0x01,
	0xFF, 0xFF, 0xFF,
	0x89, 0x67, 0x45, 0x23, 0x01,
	0xAB, 0x89, 0x67, 0x45, 0x23, 0x01
];

def main() -> int {
	for (i < data.length) data[i] = 0xFF;
	r.a = 0x15555;
	r.b = 0x123456;
	r.c = 0x1234567;
	r.d = -1;
	r.e = 0x123456789;
	r.f = 0x123456789AB;
	for (i < expected.length) if (data[i] != expected[i]) return i + 1;
	return 0;
}
