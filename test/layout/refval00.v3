//@execute = 0
// Refs as first-class values: returned, stored in arrays and tuples, compared.
layout S { +0 x: u16; =2; }

def data = Array<byte>.new(8);
def get(i: int) -> Ref<S> { return Ref<S>.at(data, i); }

def main() -> int {
	var a = get(2);
	var arr: Array<Ref<S>> = [get(0), get(2)];
	var t = (get(0), get(2));
	if (a != arr[1]) return 1;
	if (t.1 != a) return 2;
	a.x = 0x1234;
	if (arr[1].x != 0x1234) return 3;
	if (get(2).x != 0x1234) return 4;
	var n: Ref<S>;
	if (n == a) return 5;
	return 0;
}
