//@execute 0=255; 1=0; 2=255; 3=0
layout R {
	+0	x:	i1[4];
	=4;
}

// Storing -1 writes the sign-extended byte 0xFF, not 0x01.
def main(a: int) -> byte {
	var data: Array<byte> = [0x55, 0x55, 0x55, 0x55];
	var ref = Ref<R>.at(data, 0);
	ref.x[0] = -1;
	ref.x[1] = 0;
	ref.x[2] = -1;
	ref.x[3] = 0;
	return data[a];
}
