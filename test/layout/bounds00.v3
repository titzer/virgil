//@execute 0=17; 1=34; 2=!BoundsCheckException; -1=!BoundsCheckException
// The declared repeat count bounds the index even when the backing array is larger.
layout T { +0 x: byte; =1; }
layout S { +0 t: T[2]; =2; }

def data = Array<byte>.new(100);
def r = Ref<S>.at(data, 0);

def main(i: int) -> int {
	data[0] = 17; data[1] = 34;
	return r.t[i].x;
}
