//@execute 0=8721; 1=17459; 2=!BoundsCheckException
// Non-zero offsets both for the repeated layout field and within the element layout.
layout T {
	+1	x:	u16;
	=4;
}
layout S {
	+2	t:	T[2];
	=10;
}

def data: Array<byte> = [0, 0, 0, 0x11, 0x22, 0, 0, 0x33, 0x44, 0];
def ref = Ref<S>.at(data, 0);

def main(a: int) -> int {
	var r = ref.t[a];
	return r.x;
}
