//@execute =170
layout R {
	+0	x:	u1[8];
	=8;
}

// Only the lowest bit of each byte contributes to a u1 element.
def data = [0x00u8, 0x01u8, 0x02u8, 0x03u8, 0xFEu8, 0xFFu8, 0x80u8, 0x81u8];
def ref = Ref<R>.at(data, 0);

def main() -> int {
	var m = 0;
	for (i < 8) if (ref.x[i] != 0) m |= 1 << byte.view(i);
	return m;
}
