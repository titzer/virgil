//@execute 0=110; 1=121; 2=132; 3=!BoundsCheckException
// Writes through a repeated field of layout type.
layout T {
	+0	x:	u16;
	=2;
}
layout S {
	+1	t:	T[3];
	=7;
}

def data = Array<byte>.new(7);
def ref = Ref<S>.at(data, 0);

def main(a: int) -> int {
	ref.t[a].x = u16.view(110 + 11 * a);
	return ref.t[a].x;
}
