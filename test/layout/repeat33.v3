//@execute 0=0; 1=1; 2=2; 3=3; 4=3; 5=2; 6=1
layout T {
	+0	v:	u2[3];
	=3;
}
layout S {
	+1	t:	T;
	+4	u:	T;
	=7;
}

def main(a: int) -> byte {
	var data = Array<byte>.new(7);
	var ref = Ref<S>.at(data, 0);
	ref.t.v[0] = 1;
	ref.t.v[1] = 2;
	ref.t.v[2] = 3;
	ref.u.v[0] = 3;
	ref.u.v[1] = 2;
	ref.u.v[2] = 1;
	return data[a];
}
