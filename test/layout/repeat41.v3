//@execute 0=1; 1=0; 2=3; 3=1; 4=-1; 5=0; 6=1; 7=-2
layout R {
	+0	a:	u1[2];
	+2	b:	u2[2];
	+4	c:	i1[2];
	+6	d:	i2[2];
	=8;
}

// No load may observe the bits poked above each field below.
def main(i: int) -> int {
	var data = Array<byte>.new(8);
	var ref = Ref<R>.at(data, 0);
	ref.a[0] = 1;
	ref.a[1] = 0;
	ref.b[0] = 3;
	ref.b[1] = 1;
	ref.c[0] = -1;
	ref.c[1] = 0;
	ref.d[0] = 1;
	ref.d[1] = -2;

	data[0] |= 0xFE;
	data[1] |= 0xFE;
	data[2] |= 0xFC;
	data[3] |= 0xFC;
	data[4] |= 0xFE;
	data[5] |= 0xFE;
	data[6] |= 0xFC;
	data[7] |= 0xFC;

	if (i < 2) return ref.a[i];
	if (i < 4) return ref.b[i - 2];
	if (i < 6) return ref.c[i - 4];
	return ref.d[i - 6];
}
