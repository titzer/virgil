//@execute 0=1; 1=0; 2=1; 3=0
layout R {
	+0	x:	bool[4]	#big-endian;
	=4;
}

// Endianness has no effect on byte-sized bool elements.
def main(a: int) -> byte {
	var data: Array<byte> = [0xFF, 0xFF, 0xFF, 0xFF];
	var ref = Ref<R>.at(data, 0);
	ref.x[0] = true;
	ref.x[1] = false;
	ref.x[2] = true;
	ref.x[3] = false;
	return data[a];
}
