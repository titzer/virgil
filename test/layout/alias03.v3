//@execute = 0
layout S { +0 x: u32 #big-endian; =4; }

def data = Array<byte>.new(8);

def main() -> int {
	var r = Ref<S>.of(data[3 ...]);
	r.x = 0x01020304;
	if (data[3] != 0x01 || data[4] != 0x02 || data[5] != 0x03 || data[6] != 0x04) return 1;
	if (data[0] != 0 || data[7] != 0) return 2;
	if (Ref<S>.at(data, 3).x != 0x01020304) return 3;
	return 0;
}
