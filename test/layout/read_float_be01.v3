//@execute 0=true; 1=true; 2=!BoundsCheckException
// Reads of a repeated `float #big-endian` field at a non-zero offset.
layout F {
	+1	f:	float[2]	#big-endian;
	=9;
}

def bytes: Array<byte> = [
	0xAA,
	0x11, 0x22, 0x33, 0x44,
	0x55, 0x66, 0x77, 0x88
];
def ref = Ref<F>.at(bytes, 0);

def main(a: int) -> bool {
	var want = if(a == 0, float.view(0x11223344), float.view(0x55667788));
	return ref.f[a] == want;
}
