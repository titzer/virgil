//@execute 0=1; 1=2; 2=3
// A side-effecting index in a compound assignment is evaluated exactly once.
layout S { +0 x: u32[3]; =12; }

def data = Array<byte>.new(12);
def r = Ref<S>.of(data);
var calls = 0;
def idx(i: int) -> int { calls++; return i; }

def main(a: int) -> int {
	calls = 0;
	r.x[a] = 5;
	r.x[idx(a)]++;
	if (calls != 1) return -1;
	if (r.x[a] != 6) return -2;
	return a + 1;
}
