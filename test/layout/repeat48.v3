//@execute 0=9; 1=!BoundsCheckException; 2=!BoundsCheckException
// Bounds checks apply to both the outer and inner repeated indices.
layout T {
	+0	b:	byte[1];
	=1;
}
layout S {
	+0	t:	T[1];
	=1;
}

def data: Array<byte> = [9];
def ref = Ref<S>.at(data, 0);

def main(a: int) -> byte {
	if (a == 1) return ref.t[0].b[1];
	if (a == 2) return ref.t[1].b[0];
	return ref.t[0].b[0];
}
