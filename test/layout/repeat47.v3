//@execute 0=true; 1=true; 2=true; 3=true; 4=true; 5=true; 6=!BoundsCheckException
// Writes of bool elements through a repeated field of layout type.
layout T {
	+0	b:	bool[3];
	=3;
}
layout S {
	+1	t:	T[2];
	=7;
}

def data = Array<byte>.new(7);
def ref = Ref<S>.at(data, 0);

def main(a: int) -> bool {
	ref.t[a / 3].b[a % 3] = true;
	return ref.t[a / 3].b[a % 3];
}
