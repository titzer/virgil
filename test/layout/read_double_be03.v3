//@execute = true
// Read of a `double #big-endian` field inside a nested layout-typed field.
layout In {
	+0	g:	double	#big-endian;
	=8;
}
layout Out {
	+2	n:	In;
	=10;
}

def bytes: Array<byte> = [ 0xAA, 0xBB, 0x3F, 0xF8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 ];
def ref = Ref<Out>.at(bytes, 0);

def main() -> bool {
	return ref.n.g == 1.5d;
}
