//@execute 0=!BoundsCheckException; 1=!BoundsCheckException; 2=!BoundsCheckException; 3=0
// Extreme offsets must not wrap the offset+size bounds computation.
layout S { +0 x: u32; =4; }

def data = Array<byte>.new(8);

def main(i: int) -> u32 {
	if (i == 0) return Ref<S>.at(data, int.max).x;
	if (i == 1) return Ref<S>.at(data, int.min).x;
	if (i == 2) return Ref<S>.at(data, 2147483645).x;
	return Ref<S>.at(data, 4).x;
}
