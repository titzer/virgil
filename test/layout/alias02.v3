//@execute = 0
// Overlapping refs one byte apart.
layout S { +0 x: u32; =4; }

def data = Array<byte>.new(5);
def r0 = Ref<S>.at(data, 0);
def r1 = Ref<S>.at(data, 1);

def main() -> int {
	r0.x = 0x11223344;
	if (r1.x != 0x00112233) return 1;
	r1.x = 0xAABBCCDDu;
	if (r0.x != 0xBBCCDD44u) return 2;
	return 0;
}
