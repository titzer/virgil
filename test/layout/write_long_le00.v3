//@execute = 0
// Writes of u40/u48/u56/u64 little-endian fields, checked against the byte image.
layout R {
	+0	a:	u40;
	+5	b:	u48;
	+11	c:	u56;
	+18	d:	u64;
	=26;
}

def bytes = Array<byte>.new(26);
def ref = Ref<R>.at(bytes, 0);

def expected: Array<byte> = [
	0x05, 0x04, 0x03, 0x02, 0x01,
	0x16, 0x15, 0x14, 0x13, 0x12, 0x11,
	0x27, 0x26, 0x25, 0x24, 0x23, 0x22, 0x21,
	0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x81
];

def main() -> int {
	ref.a = 0x0102030405;
	ref.b = 0x111213141516;
	ref.c = 0x21222324252627;
	ref.d = 0x8102030405060708uL;
	for (i < expected.length) if (bytes[i] != expected[i]) return i + 1;
	return 0;
}
