//@execute 0=true; 1=true; 2=!BoundsCheckException
// Reads of a repeated `double #big-endian` field at a non-zero offset.
layout D {
	+1	g:	double[2]	#big-endian;
	=17;
}

def bytes: Array<byte> = [
	0xAA,
	0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
	0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18
];
def ref = Ref<D>.at(bytes, 0);

def main(a: int) -> bool {
	var want = if(a == 0, double.view(0x0102030405060708uL), double.view(0x1112131415161718uL));
	return ref.g[a] == want;
}
