//@execute 0=1; 1=0; 2=1; 3=0; 4=305419896; 5=-2023406815
layout R {
	+0	f:	bool[4];
	+4	g:	int[2];
	=12;
}

def data = [
	0x01u8, 0x00u8, 0x01u8, 0x00u8,
	0x78u8, 0x56u8, 0x34u8, 0x12u8,
	0x21u8, 0x43u8, 0x65u8, 0x87u8
];
def ref = Ref<R>.at(data, 0);

def main(a: int) -> int {
	if (a < 4) return if(ref.f[a], 1, 0);
	return ref.g[a - 4];
}
