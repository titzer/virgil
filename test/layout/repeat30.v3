//@execute 0=254; 1=255; 2=0; 3=1
layout R {
	+0	x:	i2[4];
	=4;
}

// Negative values are stored sign-extended into the whole byte.
def main(a: int) -> byte {
	var data: Array<byte> = [0x55, 0x55, 0x55, 0x55];
	var ref = Ref<R>.at(data, 0);
	ref.x[0] = -2;
	ref.x[1] = -1;
	ref.x[2] = 0;
	ref.x[3] = 1;
	return data[a];
}
