//@execute 0=1; 1=0; 2=1; 3=34; 4=17; 5=68; 6=51; 7=0; 8=1
layout R {
	+0	f:	bool[3];
	+3	g:	u16[2];
	+7	h:	bool[2];
	=9;
}

def main(a: int) -> byte {
	var data = Array<byte>.new(9);
	var ref = Ref<R>.at(data, 0);
	ref.f[0] = true;
	ref.f[1] = false;
	ref.f[2] = true;
	ref.g[0] = 0x1122;
	ref.g[1] = 0x3344;
	ref.h[0] = false;
	ref.h[1] = true;
	return data[a];
}
