//@execute 0=287454020; 1=1432778632; 2=!BoundsCheckException
// Reads of a u32 #big-endian field inside a repeated layout-typed field.
layout T {
	+0	x:	u32	#big-endian;
	=4;
}
layout S {
	+1	t:	T[2];
	=9;
}

def data: Array<byte> = [ 0xAA, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88 ];
def ref = Ref<S>.at(data, 0);

def main(a: int) -> u32 {
	return ref.t[a].x;
}
