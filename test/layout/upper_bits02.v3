//@execute 0=true; 1=true; 2=true; 3=true
// Reads ignore dirty bits above the field width; the sign bit is the field's own top bit.
layout S { +0 a: i23; +3 b: i23; +6 c: i17 #big-endian; +9 d: i33; =14; }

def bytes: Array<byte> = [
	0x01, 0x00, 0x7F,
	0x01, 0x00, 0xFF,
	0xFF, 0x00, 0x03,
	0x01, 0x00, 0x00, 0x00, 0xFF
];
def r = Ref<S>.at(bytes, 0);

def main(i: int) -> bool {
	if (i == 0) return u23.view(r.a) == 0x7F0001 && r.a < 0;
	if (i == 1) return r.b == r.a;
	if (i == 2) return u17.view(r.c) == 0x10003 && r.c < 0;
	return u33.view(r.d) == 0x100000001 && r.d < 0;
}
