//@execute 0=110; 1=210
layout T { +0 x: u16; =2; }
layout S { +1 t: T[2]; =5; }

def data = Array<byte>.new(5);
def r = Ref<S>.of(data);
var calls = 0;
def idx(i: int) -> int { calls++; return i; }

def main(a: int) -> int {
	calls = 0;
	r.t[a].x = u16.view(100 * (a + 1));
	r.t[idx(a)].x += 10;
	if (calls != 1) return -1;
	return r.t[a].x;
}
