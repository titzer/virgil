//@execute 0=3; 1=1; 2=2; 3=0
layout R {
	+0	x:	u2[4]	#big-endian;
	=4;
}

// Endianness has no effect on byte-sized elements.
def main(a: int) -> byte {
	var data: Array<byte> = [0xFF, 0xFF, 0xFF, 0xFF];
	var ref = Ref<R>.at(data, 0);
	ref.x[0] = 3;
	ref.x[1] = 1;
	ref.x[2] = 2;
	ref.x[3] = 0;
	return data[a];
}
