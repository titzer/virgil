//@execute = 0
layout D { +0 g: double; =8; }
layout Q { +0 q: u64; =8; }

def data = Array<byte>.new(8);
def d = Ref<D>.of(data);
def q = Ref<Q>.of(data);

def main() -> int {
	d.g = 1.5d;
	if (q.q != 0x3FF8000000000000uL) return 1;
	if (data[7] != 0x3F) return 2;
	q.q = 0xC000000000000000uL;
	if (d.g != -2d) return 3;
	return 0;
}
