//@execute 0=0; 1=1; 2=1; 3=0
layout R {
	+0	x:	bool[4];
	=4;
}

def main(a: int) -> byte {
	var data: Array<byte> = [0x01, 0x00, 0x00, 0x01];
	var ref = Ref<R>.at(data, 0);
	ref.x[0] = !ref.x[0];	// true -> false
	ref.x[1] = !ref.x[1];	// false -> true
	ref.x[2] |= true;	// false -> true
	ref.x[3] &= false;	// true -> false
	return data[a];
}
