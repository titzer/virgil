//@execute 0=true; 1=true; 2=!BoundsCheckException
// Reads of a u64 #big-endian field at unaligned base offsets.
layout U {
	+0	x:	u64	#big-endian;
	=8;
}

def bytes: Array<byte> = [ 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09 ];

def main(a: int) -> bool {
	var r = Ref<U>.at(bytes, a);
	var want = if(a == 0, 0x0102030405060708uL, 0x0203040506070809uL);
	return r.x == want;
}
