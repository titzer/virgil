//@execute =170
layout R {
	+0	x:	u1[8];
	=8;
}

// Poking every bit above the field must not be observed by a later load.
def main() -> int {
	var data = Array<byte>.new(8);
	var ref = Ref<R>.at(data, 0);
	for (i < 8) if ((i & 1) == 1) ref.x[i] = 1; else ref.x[i] = 0;
	for (i < 8) data[i] |= 0xFE;
	var m = 0;
	for (i < 8) if (ref.x[i] != 0) m |= 1 << byte.view(i);
	return m;
}
