//@execute = 0
layout S {
	+0	a:	u17	#big-endian;
	+3	b:	u23	#big-endian;
	+6	c:	u28	#big-endian;
	+10	d:	i23	#big-endian;
	+13	e:	u33	#big-endian;
	+18	f:	u41	#big-endian;
	=24;
}

def data = Array<byte>.new(24);
def r = Ref<S>.of(data);

def expected: Array<byte> = [
	0x01, 0x55, 0x55,
	0x12, 0x34, 0x56,
	0x01, 0x23, 0x45, 0x67,
	0xFF, 0xFF, 0xFF,
	0x01, 0x23, 0x45, 0x67, 0x89,
	0x01, 0x23, 0x45, 0x67, 0x89, 0xAB
];

def main() -> int {
	for (i < data.length) data[i] = 0xFF;
	r.a = 0x15555;
	r.b = 0x123456;
	r.c = 0x1234567;
	r.d = -1;
	r.e = 0x123456789;
	r.f = 0x123456789AB;
	for (i < expected.length) if (data[i] != expected[i]) return i + 1;
	return 0;
}
