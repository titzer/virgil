//@execute 0=false; 1=true; 2=false; 3=true; 4=false; 5=true; 6=!BoundsCheckException
layout T {
	+0	b:	bool[3];
	=3;
}
layout S {
	+1	t:	T[2];
	=7;
}

def data = [0x00u8, 0x00u8, 0x01u8, 0x00u8, 0x01u8, 0x00u8, 0x01u8];
def ref = Ref<S>.at(data, 0);

def main(a: int) -> bool {
	return ref.t[a / 3].b[a % 3];
}
