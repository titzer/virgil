//@execute = 0
// Writes of negative i16/i24/i40/i64 #big-endian values, checked against the byte image.
layout R {
	+0	a:	i16	#big-endian;
	+2	b:	i24	#big-endian;
	+5	c:	i40	#big-endian;
	+10	d:	i64	#big-endian;
	=18;
}

def bytes = Array<byte>.new(18);
def ref = Ref<R>.at(bytes, 0);

def expected: Array<byte> = [
	0x80, 0x01,
	0xFF, 0x00, 0x01,
	0xFF, 0x00, 0x00, 0x00, 0x01,
	0xFF, 0xFE, 0xFD, 0xFC, 0xFB, 0xFA, 0xF9, 0xF8
];

def main() -> int {
	ref.a = i16.view(0x8001);
	ref.b = i24.view(0xFF0001);
	ref.c = i40.view(0xFF00000001);
	ref.d = i64.view(0xFFFEFDFCFBFAF9F8uL);
	for (i < expected.length) if (bytes[i] != expected[i]) return i + 1;
	return 0;
}
