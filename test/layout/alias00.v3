//@execute = 0
// Two layouts over the same bytes: LE u32 vs two BE u16s.
layout A { +0 x: u32; =4; }
layout B { +0 h: u16 #big-endian; +2 l: u16 #big-endian; =4; }

def data = Array<byte>.new(4);
def a = Ref<A>.of(data);
def b = Ref<B>.of(data);

def main() -> int {
	a.x = 0x11223344;
	if (b.h != 0x4433) return 1;
	if (b.l != 0x2211) return 2;
	b.h = 0xAABB;
	if (a.x != 0x1122BBAA) return 3;
	return 0;
}
