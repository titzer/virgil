//@execute = true
// Read of a `double #big-endian` field through a Ref obtained from a range.
layout D {
	+0	g:	double	#big-endian;
	=8;
}

def bytes: Array<byte> = [ 0xAA, 0x3F, 0xF8, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 ];

def main() -> bool {
	var r = Ref<D>.of(bytes[1 ...]);
	return r.g == 1.5d;
}
