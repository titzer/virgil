//@execute 0=true; 1=true; 2=true
// Reads of u40/u48/u56 #big-endian fields.
layout R {
	+0	a:	u40	#big-endian;
	+5	b:	u48	#big-endian;
	+11	c:	u56	#big-endian;
	=18;
}

def bytes: Array<byte> = [
	0x01, 0x02, 0x03, 0x04, 0x05,
	0x11, 0x12, 0x13, 0x14, 0x15, 0x16,
	0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27
];
def ref = Ref<R>.at(bytes, 0);

def main(x: int) -> bool {
	if (x == 0) return ref.a == 0x0102030405;
	if (x == 1) return ref.b == 0x111213141516;
	return ref.c == 0x21222324252627;
}
