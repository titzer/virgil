//@execute 0=true; 1=true; 2=true; 3=true
// Reads of non-byte-width u23/u28 #big-endian fields, including width masking.
layout R {
	+0	a:	u23	#big-endian;
	+3	b:	u28	#big-endian;
	+7	c:	u23	#big-endian;
	+10	d:	u28	#big-endian;
	=14;
}

def bytes: Array<byte> = [
	0x12, 0x34, 0x56,
	0x01, 0x23, 0x45, 0x67,
	0xFF, 0xFF, 0xFF,
	0xFF, 0xFF, 0xFF, 0xFF
];
def ref = Ref<R>.at(bytes, 0);

def main(x: int) -> bool {
	if (x == 0) return ref.a == 0x123456;
	if (x == 1) return ref.b == 0x1234567;
	if (x == 2) return ref.c == 0x7FFFFF;
	return ref.d == 0xFFFFFFF;
}
