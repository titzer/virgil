//@execute =170
// Poked-upper-bits version of bool_low_bit00.v3.fail (cf. repeat37.v3 for u1); the backends return 255.
layout R {
	+0	x:	bool[8];
	=8;
}

def main() -> int {
	var data = Array<byte>.new(8);
	var ref = Ref<R>.at(data, 0);
	for (i < 8) ref.x[i] = (i & 1) == 1;
	for (i < 8) data[i] |= 0xFE;
	var m = 0;
	for (i < 8) if (ref.x[i]) m |= 1 << byte.view(i);
	return m;
}
