//@execute =10
// A bool field is the lowest bit of its byte, but the backends load the byte unmasked and return 15.
layout R {
	+0	b:	bool;
	+1	c:	bool;
	+2	d:	bool;
	+3	e:	bool;
	=4;
}

def data = [0x02u8, 0x03u8, 0xFEu8, 0xFFu8];
def ref = Ref<R>.at(data, 0);

def main() -> int {
	var m = 0;
	if (ref.b) m |= 1;
	if (ref.c) m |= 2;
	if (ref.d) m |= 4;
	if (ref.e) m |= 8;
	return m;
}
