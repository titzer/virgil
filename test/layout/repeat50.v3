//@execute = 0
// Writes of a u32 #big-endian field inside a repeated layout-typed field.
layout T {
	+0	x:	u32	#big-endian;
	=4;
}
layout S {
	+1	t:	T[2];
	=9;
}

def data = Array<byte>.new(9);
def ref = Ref<S>.at(data, 0);

def expected: Array<byte> = [ 0x00, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88 ];

def main() -> int {
	ref.t[0].x = 0x11223344u;
	ref.t[1].x = 0x55667788u;
	for (i < expected.length) if (data[i] != expected[i]) return i + 1;
	if (ref.t[0].x != 0x11223344u) return 100;
	if (ref.t[1].x != 0x55667788u) return 101;
	return 0;
}
