//@execute 0=true; 1=true; 2=true; 3=true
// Sign-extension of i16/i24/i40/i56 little-endian reads.
layout R {
	+0	a:	i16;
	+2	b:	i24;
	+5	c:	i40;
	+10	d:	i56;
	=17;
}

def bytes: Array<byte> = [
	0x01, 0x80,
	0x01, 0x00, 0xFF,
	0x01, 0x00, 0x00, 0x00, 0xFF,
	0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0xFF
];
def ref = Ref<R>.at(bytes, 0);

def main(x: int) -> bool {
	if (x == 0) return u16.view(ref.a) == 0x8001 && ref.a < 0;
	if (x == 1) return u24.view(ref.b) == 0xFF0001 && ref.b < 0;
	if (x == 2) return u40.view(ref.c) == 0xFF00000001 && ref.c < 0;
	return u56.view(ref.d) == 0xFF010203040506 && ref.d < 0;
}
