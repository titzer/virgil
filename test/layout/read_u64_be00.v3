//@execute 0=true; 1=true
// Reads of u64/i64 #big-endian fields, with the high bit set.
layout R {
	+0	a:	u64	#big-endian;
	+8	b:	i64	#big-endian;
	=16;
}

def bytes: Array<byte> = [
	0x81, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
	0xFF, 0xFE, 0xFD, 0xFC, 0xFB, 0xFA, 0xF9, 0xF8
];
def ref = Ref<R>.at(bytes, 0);

def main(x: int) -> bool {
	if (x == 0) return ref.a == 0x8102030405060708uL;
	return ref.b == i64.view(0xFFFEFDFCFBFAF9F8uL);
}
