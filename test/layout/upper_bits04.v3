//@execute = 0
// A bool write replaces the whole byte with exactly 0 or 1.
layout S { +0 a: bool; +1 b: bool; =2; }

def data: Array<byte> = [0xFE, 0xFF];
def r = Ref<S>.of(data);

def main() -> int {
	r.a = true;
	r.b = false;
	if (data[0] != 0x01) return 1;
	if (data[1] != 0x00) return 2;
	return 0;
}
