//@execute 0=true; 1=true; 2=true
// Sign-extension of i16/i24/i32 #big-endian reads.
layout R {
	+0	a:	i16	#big-endian;
	+2	b:	i24	#big-endian;
	+5	c:	i32	#big-endian;
	=9;
}

def bytes: Array<byte> = [
	0x80, 0x01,
	0xFF, 0x00, 0x01,
	0x80, 0x00, 0x00, 0x01
];
def ref = Ref<R>.at(bytes, 0);

def main(x: int) -> bool {
	if (x == 0) return u16.view(ref.a) == 0x8001 && ref.a < 0;
	if (x == 1) return u24.view(ref.b) == 0xFF0001 && ref.b < 0;
	return u32.view(ref.c) == 0x80000001u && ref.c < 0;
}
