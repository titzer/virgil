//@execute 0=!BoundsCheckException; 1=42
// The repeated index bounds check fires before the null check; forming a nested ref off null does not throw.
layout T { +0 x: u32; =4; }
layout S { +1 t: T[2]; +9 n: T; =13; }

def r: Ref<S>;

def main(i: int) -> int {
	if (i == 0) return int.view(r.t[5].x);
	var q = r.n;
	return 42;
}
