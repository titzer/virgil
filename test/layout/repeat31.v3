//@execute 0=0; 1=1; 2=1; 3=2; 4=0; 5=-1; 6=-2; 7=-1; 8=!BoundsCheckException
layout R {
	+0	a:	u1[2];
	+2	b:	u2[2];
	+4	c:	i1[2];
	+6	d:	i2[2];
	=8;
}

def data = [
	0xFEu8, 0xFFu8,
	0x05u8, 0x06u8,
	0x10u8, 0x11u8,
	0x92u8, 0x93u8
];
def ref = Ref<R>.at(data, 0);

def main(i: int) -> int {
	if (i < 2) return ref.a[i];
	if (i < 4) return ref.b[i - 2];
	if (i < 6) return ref.c[i - 4];
	return ref.d[i - 6];
}
