//@execute 0=1; 1=0; 2=3; 3=1; 4=255; 5=0; 6=1; 7=254
layout R {
	+0	a:	u1[2];
	+2	b:	u2[2];
	+4	c:	i1[2];
	+6	d:	i2[2];
	=8;
}

def main(i: int) -> byte {
	var data: Array<byte> = [0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA, 0xAA];
	var ref = Ref<R>.at(data, 0);
	ref.a[0] = 1;
	ref.a[1] = 0;
	ref.b[0] = 3;
	ref.b[1] = 1;
	ref.c[0] = -1;
	ref.c[1] = 0;
	ref.d[0] = 1;
	ref.d[1] = -2;
	return data[i];
}
