//@execute 0=1; 1=1; 2=!BoundsCheckException; 3=1; 4=!BoundsCheckException
// A zero-size layout ref may sit exactly at the end of the array.
layout L { =0; }

def data = Array<byte>.new(4);

def main(i: int) -> int {
	if (i == 0) return if(Ref<L>.at(data, 4) == Ref<L>.at(data, 4), 1, 0);
	if (i == 1) return if(Ref<L>.at(data, 0) == Ref<L>.at(data, 0), 1, 0);
	if (i == 2) return if(Ref<L>.at(data, 5) == Ref<L>.at(data, 5), 1, 0);
	if (i == 3) return if(Ref<L>.of(data[4 ...]) == Ref<L>.of(data[4 ...]), 1, 0);
	return if(Ref<L>.at(data, -1) == Ref<L>.at(data, 0), 1, 0);
}
