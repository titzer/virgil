//@execute = 0
// Write-then-read of a repeated u64 #big-endian field, checked against the byte image.
layout R {
	+0	x:	u64[2]	#big-endian;
	=16;
}

def bytes = Array<byte>.new(16);
def ref = Ref<R>.at(bytes, 0);

def expected: Array<byte> = [
	0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08,
	0x81, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08
];

def main() -> int {
	ref.x[0] = 0x0102030405060708uL;
	ref.x[1] = 0x8102030405060708uL;
	for (i < expected.length) if (bytes[i] != expected[i]) return i + 1;
	if (ref.x[0] != 0x0102030405060708uL) return 100;
	if (ref.x[1] != 0x8102030405060708uL) return 101;
	return 0;
}
