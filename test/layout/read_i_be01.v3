//@execute 0=true; 1=true; 2=true; 3=true
// Sign-extension of i40/i48/i56/i64 #big-endian reads.
layout R {
	+0	a:	i40	#big-endian;
	+5	b:	i48	#big-endian;
	+11	c:	i56	#big-endian;
	+18	d:	i64	#big-endian;
	=26;
}

def bytes: Array<byte> = [
	0xFF, 0x00, 0x00, 0x00, 0x01,
	0x80, 0x00, 0x00, 0x00, 0x00, 0x02,
	0xFF, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06,
	0xFF, 0xFE, 0xFD, 0xFC, 0xFB, 0xFA, 0xF9, 0xF8
];
def ref = Ref<R>.at(bytes, 0);

def main(x: int) -> bool {
	if (x == 0) return u40.view(ref.a) == 0xFF00000001 && ref.a < 0;
	if (x == 1) return u48.view(ref.b) == 0x800000000002 && ref.b < 0;
	if (x == 2) return u56.view(ref.c) == 0xFF010203040506 && ref.c < 0;
	return u64.view(ref.d) == 0xFFFEFDFCFBFAF9F8uL && ref.d < 0;
}
