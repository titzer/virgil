//@execute 0=!NullCheckException; 1=!NullCheckException; 2=!NullCheckException; 3=!NullCheckException; 4=!NullCheckException
// On wasm and wasm-gc, repeated/nested access folds the offset into the range start, so a null ref's base is nonzero and escapes the explicit null check.
layout T { +0 x: u32; =4; }
layout S { +1 t: T[2]; +9 n: T; =13; }

def r: Ref<S>;

def main(i: int) -> int {
	if (i == 0) return int.view(r.t[0].x);
	if (i == 1) return int.view(r.t[1].x);
	if (i == 2) { r.t[1].x = 3; return 99; }
	if (i == 3) return int.view(r.n.x);
	var q = r.n;
	return int.view(q.x);
}
