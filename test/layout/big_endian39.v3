//@execute = 0
// Writes of u40/u48/u56/u64 #big-endian fields, checked against the byte image.
layout R {
	+0	a:	u40	#big-endian;
	+5	b:	u48	#big-endian;
	+11	c:	u56	#big-endian;
	+18	d:	u64	#big-endian;
	=26;
}

def bytes = Array<byte>.new(26);
def ref = Ref<R>.at(bytes, 0);

def expected: Array<byte> = [
	0x01, 0x02, 0x03, 0x04, 0x05,
	0x11, 0x12, 0x13, 0x14, 0x15, 0x16,
	0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27,
	0x81, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08
];

def main() -> int {
	ref.a = 0x0102030405;
	ref.b = 0x111213141516;
	ref.c = 0x21222324252627;
	ref.d = 0x8102030405060708uL;
	for (i < expected.length) if (bytes[i] != expected[i]) return i + 1;
	return 0;
}
