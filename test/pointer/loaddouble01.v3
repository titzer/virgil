//@execute 0=0; 1=8; 2=12; 3=14; 4=15
// Loop of double loads at negative offsets from the last element (static Pointer.load form),
// plus a bit-pattern check assembled from two u32 loads (little-endian).
def sumd(p: Pointer, n: int) -> double #no-inline {
	var s = 0.0;
	for (i < n) s += Pointer.load<double>(p + (-8 * i));
	return s;
}
def load32(p: Pointer) -> u32 #no-inline { return p.load<u32>(); }
var arr: Array<double> = [1.0, 2.0, 4.0, 8.0];
def main(a: int) -> int {
	var end = Pointer.atElement(arr, 3);
	var s = sumd(end, a);
	var bits = (u64.view(load32(end + 4)) << 32) | load32(end);
	if (bits != u64.view(8.0)) return -1;
	return int.truncd(s);
}
