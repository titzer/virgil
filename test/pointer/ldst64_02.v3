//@execute 0=2222; 1=1222; 2=1122; 3=1112; 4=1111
// Read-modify-write of 64-bit words; the increment must carry from the low half into the high half.
def incr64(p: Pointer, n: int, d: u64) #no-inline {
	for (i < n) {
		var q = p + i * 8;
		q.store<u64>(q.load<u64>() + d);
	}
}
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < 4) arr[i] = 0xFFFFFFFFuL;
	incr64(Pointer.atContents(arr), a, 1);
	var r = 0;
	for (i < 4) {
		if (arr[i] == 0x100000000uL) r = r * 10 + 1;
		else if (arr[i] == 0xFFFFFFFFuL) r = r * 10 + 2;
		else return -1;
	}
	return r;
}
