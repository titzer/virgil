//@execute = 42
class Cell(n: int) { }
class Holder {
	var f: Cell;
	new(f) { }
}
def A = Cell.new(1), C = Cell.new(3);
def h = Holder.new(A);
def main() -> int {
	if (!Pointer.atField(h.f).cmpswp(A, C)) return 1;
	if (h.f.n != 3) return 2;
	if (Pointer.atField(h.f).cmpswp(A, C)) return 3;
	return 42;
}
