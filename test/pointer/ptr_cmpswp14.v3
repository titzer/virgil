//@execute = 42
// The expected operand of a reference CAS is a record constant whose only use
// in this method is the CAS itself. Nothing else in the method forces it into
// the data region, so the backend must materialize its address on its own.
class Cell(n: int) { }
def A = Cell.new(1), B = Cell.new(2), C = Cell.new(3);
def refs: Array<Cell> = [A, B];
def main() -> int {
	if (!Pointer.atContents(refs).cmpswp(A, C)) return 1;
	if (refs[0] != C) return 2;   // C is used again here; A is not
	if (refs[1].n != 2) return 3;
	return 42;
}
