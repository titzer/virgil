//@execute = 42
// Null as the expected value and as the new value of a reference CAS, paired
// with a record constant that appears only in the CAS.
class Cell(n: int) { }
def A = Cell.new(1), B = Cell.new(2);
def refs: Array<Cell> = [null, B];
def main() -> int {
	if (!Pointer.atContents(refs).cmpswp(null, A)) return 1;
	if (refs[0].n != 1) return 2;
	if ((Pointer.atContents(refs) + Pointer.SIZE).cmpswp(null, A)) return 3;
	if (refs[1].n != 2) return 4;
	if (!(Pointer.atContents(refs) + Pointer.SIZE).cmpswp(B, null)) return 5;
	if (refs[1] != null) return 6;
	return 42;
}
