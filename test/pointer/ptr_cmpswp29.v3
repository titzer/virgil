//@execute = 42
class Cell(n: int) { }
def A = Cell.new(1), C = Cell.new(3);
def refs: Array<Cell> = [A];
def main() -> int {
	var s = Pointer.atContents(refs).cmpswp(A, C);
	var t = Pointer.atContents(refs).cmpswp(A, C);
	var count = (if(s, 1, 0)) + (if(t, 10, 0));
	if (count != 1) return 1;
	var sum = 0;
	for (c in refs) sum += c.n;
	if (sum != 3) return 2;
	return 42;
}
