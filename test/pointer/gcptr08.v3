//@execute 0=0; 5=10; 50=100
// A loop-carried object-derived pointer live across a forced GC in each iteration.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int, var count: int) { }
var c: C;

def main(n: int) -> int {
	c = C.new(BOGUS, HUGE, 0);
	var p = Pointer.atField(c.a);
	for (i < n) {
		c.count = c.count + 2;
		saved = p;
		CiTest.forceGc();
		if (p != saved) return -1;
		p = Pointer.atField(c.a);
	}
	saved = p;
	CiTest.forceGc();
	if (p != saved) return -2;
	return c.count;
}
