//@execute 0=100; 1=100
// Pointers with constant offsets (which backends may fold into addressing modes, leaving the
// object-derived base live) across a forced GC.
// Object-derived pointers must not be treated as reference roots by the shadow stack spiller.
// Each pointer is saved to a global before a GC and checked to be unchanged afterwards; a GC
// that (wrongly) scans the pointer as a root would relocate it. The word an interior pointer
// targets is 5 (decodes as a primitive array header, scale 1) followed by 0x10000000 (decodes
// as the length), so such a GC would more likely trap while copying the bogus object.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
var arr: Array<int>;

def main(i: int) -> int {
	arr = [0, 0, BOGUS, HUGE];
	var p = Pointer.atElement(arr, 0) + 8;   // address of arr[2]
	var q = Pointer.atElement(arr, 1) + 4;   // address of arr[2]
	if (p.load<int>() != BOGUS) return 1;
	if (q.load<int>() != BOGUS) return 2;
	saved = p;
	saved2 = q;
	CiTest.forceGc();
	if (p != saved) return -1;
	if (q != saved2) return -2;
	if (arr[2] != BOGUS) return 3;
	if (arr[3] != HUGE) return 4;
	return 100;
}
