//@execute 0=1234; 1=1234; 2=1134; 3=1124; 4=1123
// Shift 64-bit words up by one slot, walking backward over overlapping source/destination.
def shiftUp(p: Pointer, n: int) #no-inline {
	var i = n - 2;
	while (i >= 0) {
		(p + (i + 1) * 8).store<u64>((p + i * 8).load<u64>());
		i--;
	}
}
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < 4) arr[i] = (u64.view(i + 1) << 32) | u64.view(i + 1);
	shiftUp(Pointer.atContents(arr), a);
	var r = 0;
	for (i < 4) {
		var v = arr[i];
		if (int.view(v >> 32) != int.view(v)) return -1;
		r = r * 10 + int.view(v);
	}
	return r;
}
