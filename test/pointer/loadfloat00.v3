//@execute 0=6; 1=-10; 2=401; 3=16384
// float load at a runtime-computed offset from the start of an array.
def loadAt(p: Pointer, i: int) -> float #no-inline { return (p + i * 4).load<float>(); }
var arr: Array<float> = [1.5f, -2.5f, 100.25f, 4096.0f];
def main(a: int) -> int {
	var f = loadAt(Pointer.atContents(arr), a);
	return int.truncf(f * 4.0f);
}
