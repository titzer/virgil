//@execute 0=1; 1=1002; 2=2003; -1=-1000; 5=5006
// A 64-bit store followed by a 32-bit store that overwrites only the low half.
def store64(p: Pointer, v: u64) #no-inline { p.store<u64>(v); }
def store32(p: Pointer, v: u32) #no-inline { p.store<u32>(v); }
var arr = Array<u64>.new(1);
def main(a: int) -> int {
	var p = Pointer.atContents(arr);
	store64(p, (u64.view(u32.view(a)) << 32) | u64.view(0x11223344));
	store32(p, u32.view(a + 1));
	var v = arr[0];
	return int.view(v >> 32) * 1000 + int.view(v);
}
