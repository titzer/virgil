//@execute 0=0; 1=1007; 2=3014; 3=6021; 4=10028
// Copy 64-bit words between arrays by stepping two pointers.
def copy64(dst: Pointer, src: Pointer, n: int) #no-inline {
	for (i < n) {
		dst.store<u64>(src.load<u64>());
		dst = dst + 8;
		src = src + 8;
	}
}
var src = Array<u64>.new(4);
var dst = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < 4) {
		src[i] = (u64.view(i + 1) << 32) | u64.view(7);
		dst[i] = 0;
	}
	copy64(Pointer.atContents(dst), Pointer.atContents(src), a);
	var s: u64 = 0;
	for (i < 4) s += dst[i];
	return int.view(s >> 32) * 1000 + int.view(s);
}
