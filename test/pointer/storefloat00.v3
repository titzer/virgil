//@execute 0=1; 1=3; 2=5; 3=7
// float store at a runtime-computed offset; neighboring elements must be untouched.
def storeAt(p: Pointer, i: int, v: float) #no-inline { (p + i * 4).store<float>(v); }
var arr = Array<float>.new(4);
def main(a: int) -> int {
	for (i < 4) arr[i] = -1.0f;
	storeAt(Pointer.atContents(arr), a, float.!(a) + 0.5f);
	var r = 0;
	for (i < 4) {
		if (i == a) r += int.truncf(arr[i] * 2.0f);
		else if (arr[i] != -1.0f) r += 1000;
	}
	return r;
}
