//@execute = 42
// The result of a reference CAS with constant operands is discarded.
class Cell(n: int) { }
def A = Cell.new(1), C = Cell.new(3);
def refs: Array<Cell> = [A];
def main() -> int {
	Pointer.atContents(refs).cmpswp(A, C);
	if (refs[0].n != 3) return 1;
	Pointer.atContents(refs).cmpswp(A, C);
	if (refs[0].n != 3) return 2;
	return 42;
}
