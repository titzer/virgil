//@execute = 42
// A reference CAS with constant operands inside a loop; the result is counted
// rather than branched on. Only the first iteration can succeed.
class Cell(n: int) { }
def A = Cell.new(1), C = Cell.new(3);
def refs: Array<Cell> = [A];
def main() -> int {
	var hits = 0;
	for (i < 4) {
		if (Pointer.atContents(refs).cmpswp(A, C)) hits++;
	}
	if (hits != 1) return 1;
	if (refs[0].n != 3) return 2;
	return 42;
}
