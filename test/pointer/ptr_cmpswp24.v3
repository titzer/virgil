//@execute = 42
// A generic CAS helper applied to record constants at the call site. The helper
// is not inlined, so the constants reach the CAS through argument registers
// rather than as immediates; this is the control case for the other tests.
class Cell(n: int) { }
def A = Cell.new(1), B = Cell.new(2), C = Cell.new(3);
def refs: Array<Cell> = [A, B];
def cas<T>(arr: Array<T>, i: int, e: T, n: T) -> bool {
	return (Pointer.atContents(arr) + i * Pointer.SIZE).cmpswp(e, n);
}
def main() -> int {
	if (!cas(refs, 0, A, C)) return 1;
	if (cas(refs, 1, A, C)) return 2;
	if (!cas(refs, 1, B, C)) return 3;
	if (refs[0].n != 3) return 4;
	if (refs[1].n != 3) return 5;
	return 42;
}
