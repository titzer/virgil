//@execute 0=100; 1=100
// An object-derived pointer chosen by a conditional (phi of pointers) live across a forced GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
var x: C;
var arr: Array<int>;

def main(i: int) -> int {
	x = C.new(BOGUS, HUGE);
	arr = [BOGUS, HUGE];
	var p = if(i == 0, Pointer.atField(x.a), Pointer.atElement(arr, 0));
	saved = p;
	CiTest.forceGc();
	if (p != saved) return -1;
	if (x.a != BOGUS || x.b != HUGE) return 1;
	if (arr[0] != BOGUS || arr[1] != HUGE) return 2;
	return 100;
}
