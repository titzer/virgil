//@execute 0=100; 1=100
// Pointers into arrays of references and a long array, live across a forced GC.
// Object-derived pointers must not be treated as reference roots by the shadow stack spiller.
// Each pointer is saved to a global before a GC and checked to be unchanged afterwards; a GC
// that (wrongly) scans the pointer as a root would relocate it. The word an interior pointer
// targets is 5 (decodes as a primitive array header, scale 1) followed by 0x10000000 (decodes
// as the length), so such a GC would more likely trap while copying the bogus object.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class E(v: int) { }
var refs: Array<E>;
var longs: Array<long>;
var s: Array<Pointer> = Array.new(3);

def main(i: int) -> int {
	refs = [E.new(1), E.new(2), E.new(3), E.new(4)];
	longs = [(long.!(HUGE) << 32) | u32.view(BOGUS), 0L];
	var p0 = Pointer.atElement(refs, 0);
	var p3 = Pointer.atElement(refs, 3);
	var pl = Pointer.atElement(longs, 0); // little-endian: BOGUS then HUGE
	s[0] = p0; s[1] = p3; s[2] = pl;
	CiTest.forceGc();
	if (p0 != s[0]) return 10;
	if (p3 != s[1]) return 11;
	if (pl != s[2]) return 12;
	for (j < refs.length) if (refs[j].v != j + 1) return j;
	if (longs[0] != ((long.!(HUGE) << 32) | u32.view(BOGUS))) return 20;
	return 100;
}
