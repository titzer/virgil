//@execute 0=100; 1=100
// Object-derived pointers from a method's receiver (this) live across a forced GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) {
	def test() -> int {
		var p = Pointer.atField(this.a);
		var q = Pointer.atEnd(this);
		saved = p;
		saved2 = q;
		CiTest.forceGc();
		if (p != saved) return -1;
		if (q != saved2) return -2;
		if (a != BOGUS) return 1;
		if (b != HUGE) return 2;
		return 100;
	}
}
var c: C;

def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	return c.test();
}
