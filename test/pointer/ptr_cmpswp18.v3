//@execute = 42
def X: Array<int> = [1, 2];
def Y: Array<int> = [3, 4, 5];
def refs: Array<Array<int>> = [X];
def main() -> int {
	if (!Pointer.atContents(refs).cmpswp(X, Y)) return 1;
	if (refs[0].length != 3) return 2;
	if (refs[0][2] != 5) return 3;
	if (Pointer.atContents(refs).cmpswp(X, Y)) return 4;
	return 42;
}
