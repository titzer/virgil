//@execute = 42
class Cell(n: int) { }
def A = Cell.new(1), B = Cell.new(2), C = Cell.new(3);
def refs: Array<Cell> = [A, B];
def main() -> int {
	if (!Pointer.atContents(refs).cmpswp(A, C)) return 1;        // refs[0] is A
	if ((Pointer.atContents(refs) + Pointer.SIZE).cmpswp(A, C)) return 2; // refs[1] is B
	if (refs[0].n != 3) return 3;
	if (refs[1].n != 2) return 4;
	return 42;
}
