//@execute 0=100
//@heap-size=24576
// Object-derived pointers live across allocation-triggered GCs (many small allocations).
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
class E(v: int) { }
var c: C;
var arr: Array<int>;
var keep: E;

def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	arr = [BOGUS, HUGE];
	var p = Pointer.atField(c.a);
	var q = Pointer.atElement(arr, 0);
	saved = p;
	saved2 = q;
	for (j < 2000) {
		keep = E.new(j);
		if (keep.v != j) return 1;
	}
	if (p != saved) return -1;
	if (q != saved2) return -2;
	if (c.a != BOGUS) return 2;
	if (c.b != HUGE) return 3;
	if (keep.v != 1999) return 4;
	return 100;
}
