//@execute 0=4000; 1=3001; 2=2002; 3=1003
// 64-bit loads at negative offsets from a pointer to the last element.
def loadBack(p: Pointer, i: int) -> u64 #no-inline { return (p + (-8 * i)).load<u64>(); }
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < arr.length) arr[i] = (u64.view(i + 1) << 32) | u64.view(3 - i);
	var end = Pointer.atElement(arr, 3);
	var v = loadBack(end, a);
	return int.view(v >> 32) * 1000 + int.view(v);
}
