//@execute 0=1000; 1=2001; 2=3002; 3=4003
// Load a pointer from memory, then do a 64-bit load through it.
def loadPtr(p: Pointer) -> Pointer #no-inline { return p.load<Pointer>(); }
def load64(p: Pointer) -> u64 #no-inline { return p.load<u64>(); }
var data = Array<u64>.new(4);
var ptrs = Array<Pointer>.new(4);
def main(a: int) -> int {
	for (i < data.length) {
		data[i] = (u64.view(i + 1) << 32) | u64.view(i);
		ptrs[3 - i] = Pointer.atElement(data, i);
	}
	var pp = Pointer.atElement(ptrs, 3 - a);
	var v = load64(loadPtr(pp));
	return int.view(v >> 32) * 1000 + int.view(v);
}
