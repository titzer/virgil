//@execute 0=0; 1=1; 2=-2; 3=3000000
// Load the bits of a double with a 64-bit integer load and reinterpret them.
def loadBits(p: Pointer, i: int) -> u64 #no-inline { return (p + i * 8).load<u64>(); }
var arr: Array<double> = [0.0, 1.0, -2.0, 3000000.0];
def main(a: int) -> int {
	var bits = loadBits(Pointer.atContents(arr), a);
	var d = double.view(bits);
	if (u64.view(d) != bits) return -999;
	if (u64.view(arr[a]) != bits) return -998;
	return int.truncd(d);
}
