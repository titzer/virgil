//@execute 0=111; 1=222
// Pointer.atObject(obj) and Pointer.atEnd(obj) live across a forced GC. Both point at real
// object headers (the object itself and the next object), so scanning them as roots is benign;
// the GC must not crash or corrupt anything, and atEnd must be unchanged by the GC.
class C(var a: int, var b: int) { }
var saved: Pointer;
var c: C;
var d: C;

def main(i: int) -> int {
	c = C.new(111, 222);
	d = C.new(333, 444);
	var p = Pointer.atObject(c);
	var q = Pointer.atEnd(c);
	saved = q;
	CiTest.forceGc();
	if (q != saved) return -2;
	if (p == Pointer.NULL) return -3;
	if (d.a != 333 || d.b != 444) return -4;
	return if(i == 0, c.a, c.b);
}
