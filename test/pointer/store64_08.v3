//@execute 0=1; 1=203; 2=405; 3=607
// A 64-bit store spanning two adjacent int elements (little-endian).
def storePair(a: Array<int>, i: int, v: u64) #no-inline { Pointer.atElement(a, 2 * i).store<u64>(v); }
var arr = Array<int>.new(8);
def main(a: int) -> int {
	for (i < 4) storePair(arr, i, (u64.view(2 * i) << 32) | u64.view(2 * i + 1));
	var lo = arr[2 * a], hi = arr[2 * a + 1];
	return hi * 100 + lo;
}
