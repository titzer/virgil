//@execute 0=-1000; 1=-1999; 2=-2998; 3=-3997
// Signed 64-bit stores of negative values at negative offsets from the last element.
def storeBack(p: Pointer, i: int, v: long) #no-inline { (p + (-8 * i)).store<long>(v); }
var arr = Array<long>.new(4);
def main(a: int) -> int {
	var end = Pointer.atElement(arr, 3);
	for (i < 4) storeBack(end, i, (0L - (i + 1)) * 4294967296L + i);
	var v = arr[3 - a];
	if (v >= 0) return 999999;
	return int.view(v >> 32) * 1000 + int.view(v);
}
