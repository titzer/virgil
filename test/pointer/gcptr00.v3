//@execute 0=5; 1=268435456
// Pointer.atField(obj.f) live across a forced GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
var c: C;

def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	var p = Pointer.atField(c.a);
	saved = p;
	CiTest.forceGc();
	if (p != saved) return -1;
	return if(i == 0, c.a, c.b);
}
