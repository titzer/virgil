//@execute = 42
class Cell(n: int) { }
def A = Cell.new(1), B = Cell.new(2), C = Cell.new(3);
def refs: Array<Cell> = [A, B];
def main() -> int {
	if (refs[0] != A) return 1;
	if (!Pointer.atContents(refs).cmpswp(A, C)) return 2;
	if (refs[0].n != 3) return 3;
	if (!(Pointer.atContents(refs) + Pointer.SIZE).cmpswp(B, A)) return 4;
	if (refs[1] != A) return 5;
	return 42;
}
