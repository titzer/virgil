//@execute 0=1007; 1=2107; 2=3207; 3=4307
// 64-bit load at a runtime-computed offset from the start of an array.
def loadAt(p: Pointer, i: int) -> u64 #no-inline { return (p + i * 8).load<u64>(); }
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < arr.length) arr[i] = (u64.view(i + 1) << 32) | u64.view(i * 100 + 7);
	var v = loadAt(Pointer.atContents(arr), a);
	return int.view(v >> 32) * 1000 + int.view(v);
}
