//@execute 0=4231; 1=1324; 2=1324; 3=4231
// Swap two 64-bit words in place through pointers.
def swap64(p: Pointer, q: Pointer) #no-inline {
	var t = p.load<u64>();
	p.store<u64>(q.load<u64>());
	q.store<u64>(t);
}
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < 4) arr[i] = (u64.view(i + 1) << 32) | u64.view(10 * (i + 1));
	swap64(Pointer.atElement(arr, a), Pointer.atElement(arr, 3 - a));
	var r = 0;
	for (i < 4) {
		var hi = int.view(arr[i] >> 32), lo = int.view(arr[i]);
		if (lo != 10 * hi) return -1;
		r = r * 10 + hi;
	}
	return r;
}
