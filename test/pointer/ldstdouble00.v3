//@execute 0=1020304; 1=10020304; 2=10200304; 3=10203004; 4=10203040
// Read-modify-write of doubles at runtime-computed offsets.
def scaled(p: Pointer, n: int, k: double) #no-inline {
	for (i < n) {
		var q = p + i * 8;
		q.store<double>(q.load<double>() * k);
	}
}
var arr = Array<double>.new(4);
def main(a: int) -> int {
	for (i < 4) arr[i] = double.!(i + 1);
	scaled(Pointer.atContents(arr), a, 10.0);
	var r = 0;
	for (i < 4) r = r * 100 + int.truncd(arr[i]);
	return r;
}
