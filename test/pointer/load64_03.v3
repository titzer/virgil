//@execute 0=2; 1=998; 2=996; 3=2147483639
// Signed 64-bit loads of negative values via Pointer.atElement; the sign must survive.
def loadAt(a: Array<long>, i: int) -> long #no-inline { return Pointer.atElement(a, i).load<long>(); }
var arr: Array<long> = [0x0000000100000001L, -1L, -4L << 32, 0x7FFFFFF000000007L];
def main(a: int) -> int {
	var v = loadAt(arr, a);
	var r = int.view(v >> 32) + int.view(v);
	if (v < 0) r += 1000;
	return r;
}
