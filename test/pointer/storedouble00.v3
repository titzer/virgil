//@execute 0=0; 1=1; 2=6; 3=15; 4=28
// Loop that steps a pointer by 8 and fills an array with double stores.
def filld(p: Pointer, n: int) #no-inline {
	for (i < n) {
		p.store<double>(double.!(i) + 0.25);
		p = p + 8;
	}
}
var arr = Array<double>.new(4);
def main(a: int) -> int {
	for (i < 4) arr[i] = 0.0;
	filld(Pointer.atContents(arr), a);
	var s = 0.0;
	for (i < 4) s += arr[i];
	return int.truncd(s * 4.0);
}
