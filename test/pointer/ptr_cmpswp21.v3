//@execute = 42
// Boxed variant constants as the operands of a reference CAS.
type V {
	case Leaf;
	case Node(x: int, next: V);
}
def N1 = V.Node(1, V.Leaf), N2 = V.Node(2, N1);
def refs: Array<V> = [N1];
def main() -> int {
	if (!Pointer.atContents(refs).cmpswp(N1, N2)) return 1;
	match (refs[0]) {
		Leaf => return 2;
		Node(x, next) => if (x != 2) return 3;
	}
	if (Pointer.atContents(refs).cmpswp(N1, N2)) return 4;
	return 42;
}
