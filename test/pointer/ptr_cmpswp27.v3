//@execute = 42
// A reference CAS on a component field, with record constant operands.
class Cell(n: int) { }
def A = Cell.new(1), C = Cell.new(3);
var slot: Cell = A;
def main() -> int {
	if (!Pointer.atField(slot).cmpswp(A, C)) return 1;
	if (slot.n != 3) return 2;
	if (Pointer.atField(slot).cmpswp(A, C)) return 3;
	return 42;
}
