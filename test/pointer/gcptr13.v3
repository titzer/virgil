//@execute 0=100; 1=100
// Object-derived pointers in a tuple live across a forced GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
var c: C;
var arr: Array<int>;

def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	arr = [BOGUS, HUGE];
	var t = (Pointer.atField(c.a), Pointer.atElement(arr, 0));
	saved = t.0;
	saved2 = t.1;
	CiTest.forceGc();
	if (t.0 != saved) return -1;
	if (t.1 != saved2) return -2;
	if (c.a != BOGUS) return 1;
	if (c.b != HUGE) return 2;
	return 100;
}
