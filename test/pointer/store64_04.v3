//@execute 0=0; 3=0; -5=0; 77777=0
// A 64-bit store must be observable as two 32-bit loads of its halves (little-endian).
def store64(p: Pointer, v: u64) #no-inline { p.store<u64>(v); }
def load32(p: Pointer) -> u32 #no-inline { return p.load<u32>(); }
var arr = Array<u64>.new(2);
def main(a: int) -> int {
	var p = Pointer.atElement(arr, 1);
	var v = (u64.view(u32.view(a)) << 32) | u32.view(a ^ 0x5A5A5A5A);
	store64(p, v);
	var lo = load32(p), hi = load32(p + 4);
	var r = 0;
	if (int.view(v) != int.view(lo)) r |= 1;
	if (int.view(v >> 32) != int.view(hi)) r |= 2;
	if (arr[1] != v) r |= 4;
	if (arr[0] != 0) r |= 8;
	return r;
}
