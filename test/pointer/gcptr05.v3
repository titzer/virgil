//@execute 0=100; 1=100
// Several object-derived pointers live across a forced GC at once.
// Object-derived pointers must not be treated as reference roots by the shadow stack spiller.
// Each pointer is saved to a global before a GC and checked to be unchanged afterwards; a GC
// that (wrongly) scans the pointer as a root would relocate it. The word an interior pointer
// targets is 5 (decodes as a primitive array header, scale 1) followed by 0x10000000 (decodes
// as the length), so such a GC would more likely trap while copying the bogus object.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
class E(v: int) { }
var c: C;
var arr: Array<int>;
var refs: Array<E>;
var s: Array<Pointer> = Array.new(7);

def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	arr = [BOGUS, HUGE, BOGUS, HUGE];
	refs = [E.new(1), E.new(2), E.new(3)];
	var p0 = Pointer.atObject(c);
	var p1 = Pointer.atField(c.a);
	var p2 = Pointer.atEnd(c);
	var p3 = Pointer.atElement(arr, 2);
	var p4 = Pointer.atElement(refs, 1);
	var p5 = Pointer.atLength(refs);
	var p6 = Pointer.atElement(arr, 0);
	s[0] = p0; s[1] = p1; s[2] = p2; s[3] = p3; s[4] = p4; s[5] = p5; s[6] = p6;
	CiTest.forceGc();
	if (p0 == Pointer.NULL) return 10; // atObject is the reference itself; may be relocated
	if (p1 != s[1]) return 11;
	if (p2 != s[2]) return 12;
	if (p3 != s[3]) return 13;
	if (p4 != s[4]) return 14;
	if (p5 != s[5]) return 15;
	if (p6 != s[6]) return 16;
	if (c.a != BOGUS) return 1;
	if (c.b != HUGE) return 2;
	if (arr.length != 4) return 3;
	if (arr[3] != HUGE) return 4;
	if (refs.length != 3) return 5;
	if (refs[0].v != 1) return 6;
	if (refs[1].v != 2) return 7;
	if (refs[2].v != 3) return 8;
	return 100;
}
