//@execute 0=0; 1=1007; 2=3014; 3=6021; 4=10028
// Loop that steps a pointer by 8 and fills an array with 64-bit stores.
def fill64(p: Pointer, n: int) #no-inline {
	for (i < n) {
		p.store<u64>((u64.view(i + 1) << 32) | u64.view(7));
		p = p + 8;
	}
}
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < arr.length) arr[i] = 0;
	fill64(Pointer.atContents(arr), a);
	var s: u64 = 0;
	for (i < arr.length) s += arr[i];
	return int.view(s >> 32) * 1000 + int.view(s);
}
