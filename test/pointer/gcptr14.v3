//@execute 0=100; 1=100
// Pointers derived from objects reachable only from the stack, live across another allocation
// and a forced GC.
// Object-derived pointers must not be treated as reference roots by the shadow stack spiller.
// Each pointer is saved to a global before a GC and checked to be unchanged afterwards; a GC
// that (wrongly) scans the pointer as a root would relocate it. The word an interior pointer
// targets is 5 (decodes as a primitive array header, scale 1) followed by 0x10000000 (decodes
// as the length), so such a GC would more likely trap while copying the bogus object.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }

def main(i: int) -> int {
	var x = C.new(BOGUS, HUGE);
	var p = Pointer.atField(x.a);
	saved = p;
	var y = C.new(BOGUS, HUGE);
	var q = Pointer.atField(y.a);
	saved2 = q;
	CiTest.forceGc();
	if (p != saved) return -1;
	if (q != saved2) return -2;
	if (x.a != BOGUS) return 1;
	if (x.b != HUGE) return 2;
	if (y.a != BOGUS) return 3;
	if (y.b != HUGE) return 4;
	return 100;
}
