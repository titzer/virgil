//@execute 0=1; 1=203; 2=405; 3=607
// A 64-bit load spanning two adjacent int elements (little-endian), using the static Pointer.load form.
def loadPair(a: Array<int>, i: int) -> u64 #no-inline { return Pointer.load<u64>(Pointer.atElement(a, 2 * i)); }
var arr: Array<int> = [1, 0, 3, 2, 5, 4, 7, 6];
def main(a: int) -> int {
	var v = loadPair(arr, a);
	return int.view(v >> 32) * 100 + int.view(v);
}
