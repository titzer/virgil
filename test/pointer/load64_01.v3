//@execute 0=1; 5=16; -7=-20; 1000000=3000001
// 64-bit load through a non-inlined helper, so the load cannot be folded against the field.
def load64(p: Pointer) -> u64 #no-inline { return p.load<u64>(); }
def pack(a: int) -> u64 { return (u64.view(u32.view(a)) << 32) | u32.view(a + 1); }
def unpack(v: u64) -> int { return int.view(v >> 32) * 2 + int.view(v); }
var g: u64 = 99;
def main(a: int) -> int {
	g = pack(a);
	return unpack(load64(Pointer.atField(g)));
}
