//@execute 0=5; 2=5; 4=5; 1=268435456
// Pointer.atElement(array, i) live across a forced GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
var arr: Array<int>;

def main(i: int) -> int {
	arr = [BOGUS, HUGE, BOGUS, HUGE, BOGUS, HUGE];
	var p = Pointer.atElement(arr, i);
	saved = p;
	CiTest.forceGc();
	if (p != saved) return -1;
	return arr[i];
}
