//@execute 0=0; 1=1007; 2=3014; 3=6021; 4=10028
// Loop that steps a pointer by 8 and accumulates 64-bit loads.
def sum64(p: Pointer, n: int) -> u64 #no-inline {
	var s: u64 = 0;
	for (i < n) {
		s += p.load<u64>();
		p = p + 8;
	}
	return s;
}
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < arr.length) arr[i] = (u64.view(i + 1) << 32) | u64.view(7);
	var v = sum64(Pointer.atContents(arr), a);
	return int.view(v >> 32) * 1000 + int.view(v);
}
