//@execute 0=0; 1=1; 2=-2; 3=3000000
// Store the bits of a double with a 64-bit integer store, then read it back as a double.
def storeBits(p: Pointer, i: int, bits: u64) #no-inline { (p + i * 8).store<u64>(bits); }
var vals: Array<double> = [0.0, 1.0, -2.0, 3000000.0];
var arr = Array<double>.new(4);
def main(a: int) -> int {
	for (i < 4) storeBits(Pointer.atContents(arr), i, u64.view(vals[i]));
	for (i < 4) if (arr[i] != vals[i]) return -999;
	return int.truncd(arr[a]);
}
