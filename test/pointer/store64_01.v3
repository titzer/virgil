//@execute 0=1; 5=16; -7=-20; 1000000=3000001
// 64-bit store through a non-inlined helper, so the store cannot be folded into the field.
def store64(p: Pointer, v: u64) #no-inline { p.store<u64>(v); }
def pack(a: int) -> u64 { return (u64.view(u32.view(a)) << 32) | u32.view(a + 1); }
def unpack(v: u64) -> int { return int.view(v >> 32) * 2 + int.view(v); }
var g: u64 = 99;
def main(a: int) -> int {
	g = 0xDEADBEEFCAFEBABEuL;
	store64(Pointer.atField(g), pack(a));
	return unpack(g);
}
