//@execute 0=100
//@heap-size=24576
// Pointers to elements of a byte array and an int array, and atLength, live across
// allocation-triggered GCs.
// Object-derived pointers must not be treated as reference roots by the shadow stack spiller.
// Each pointer is saved to a global before a GC and checked to be unchanged afterwards; a GC
// that (wrongly) scans the pointer as a root would relocate it. The word an interior pointer
// targets is 5 (decodes as a primitive array header, scale 1) followed by 0x10000000 (decodes
// as the length), so such a GC would more likely trap while copying the bogus object.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class E(v: int) { }
var bytes: Array<byte>;
var ints: Array<int>;
var lens: Array<int>;
var keep: E;
var s: Array<Pointer> = Array.new(3);

def main(i: int) -> int {
	bytes = [0, 0, 0, 0, 5, 0, 0, 0, 0, 0, 0, 0x10];
	ints = [BOGUS, HUGE, 300];
	lens = Array<int>.new(BOGUS);
	lens[0] = HUGE;
	var pb = Pointer.atElement(bytes, 4);
	var pi = Pointer.atElement(ints, 0);
	var pl = Pointer.atLength(lens);
	s[0] = pb; s[1] = pi; s[2] = pl;
	for (j < 2000) keep = E.new(j);
	if (pb != s[0]) return 10;
	if (pi != s[1]) return 11;
	if (pl != s[2]) return 12;
	if (bytes[4] != 5) return 1;
	if (ints[2] != 300) return 2;
	if (lens.length != BOGUS) return 3;
	if (keep.v != 1999) return 4;
	return 100;
}
