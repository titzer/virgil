//@execute 0=4231; 1=1324; 2=1324; 3=4231
// Copy floats between arrays by stepping two pointers, then swap two in place.
def copyf(dst: Pointer, src: Pointer, n: int) #no-inline {
	for (i < n) {
		dst.store<float>(src.load<float>());
		dst = dst + 4;
		src = src + 4;
	}
}
def swapf(p: Pointer, q: Pointer) #no-inline {
	var t = p.load<float>();
	p.store<float>(q.load<float>());
	q.store<float>(t);
}
var src: Array<float> = [1.0f, 2.0f, 3.0f, 4.0f];
var dst = Array<float>.new(4);
def main(a: int) -> int {
	for (i < 4) dst[i] = 0.0f;
	copyf(Pointer.atContents(dst), Pointer.atContents(src), 4);
	swapf(Pointer.atElement(dst, a), Pointer.atElement(dst, 3 - a));
	var r = 0;
	for (i < 4) r = r * 10 + int.truncf(dst[i]);
	return r;
}
