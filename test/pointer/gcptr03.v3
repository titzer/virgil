//@execute 0=5; 1=5
// Pointer.atLength(array) live across a forced GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
var arr: Array<int>;

def main(i: int) -> int {
	arr = Array<int>.new(BOGUS);
	arr[0] = HUGE;
	var p = Pointer.atLength(arr);
	saved = p;
	CiTest.forceGc();
	if (p != saved) return -1;
	return arr.length;
}
