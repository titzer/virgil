//@execute = 42
class Cell(n: int) { }
def A = Cell.new(1), B = Cell.new(2), C = Cell.new(3);
var refs: Array<Cell> = [A, B];
def main() -> int {
	var e = refs[0];
	if (!Pointer.atContents(refs).cmpswp(e, C)) return 1;
	if (refs[0].n != 3) return 2;
	if (refs[1].n != 2) return 3;
	if (e.n != 1) return 4;
	return 42;
}
