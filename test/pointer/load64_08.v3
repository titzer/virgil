//@execute 0=11; 1=47; -1=-1; 100000=3200015
// The loaded 64-bit value feeds 64-bit arithmetic and comparisons.
def load64(p: Pointer) -> u64 #no-inline { return p.load<u64>(); }
var g: u64;
def main(a: int) -> int {
	g = u64.view(u32.view(a)) * 0x100000001uL; // both halves == u32.view(a)
	var v = load64(Pointer.atField(g));
	var w = v + v;
	var r = 0;
	if (v == g) r += 1;
	if (w == g + g) r += 2;
	if (v > 0xFFFFFFFFuL) r += 4;
	if ((v >> 32) == (v & 0xFFFFFFFFuL)) r += 8;
	return r + int.view(w >> 32) * 16;
}
