//@execute 0=1010; 1=2011; 2=3012; 3=4013
// 64-bit store at a runtime-computed offset; neighboring elements must be untouched.
def storeAt(p: Pointer, i: int, v: u64) #no-inline { (p + i * 8).store<u64>(v); }
var arr = Array<u64>.new(4);
def main(a: int) -> int {
	for (i < arr.length) arr[i] = 0xFFFFFFFFFFFFFFFFuL;
	storeAt(Pointer.atContents(arr), a, (u64.view(u32.view(a + 1)) << 32) | u64.view(a + 10));
	var r = 0;
	for (i < arr.length) {
		var v = arr[i];
		if (i == a) r += int.view(v >> 32) * 1000 + int.view(v);
		else if (v != 0xFFFFFFFFFFFFFFFFuL) r += 1000000;
	}
	return r;
}
