//@execute 0=5; 1=268435456
// An object-derived pointer in the caller's frame while a (recursive) callee forces a GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
var c: C;

def doGc(depth: int) -> int {
	if (depth > 0) return doGc(depth - 1) + 1;
	CiTest.forceGc();
	return 0;
}
def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	var p = Pointer.atField(c.a);
	saved = p;
	var d = doGc(3);
	if (p != saved) return -1;
	if (d != 3) return -2;
	return if(i == 0, c.a, c.b);
}
