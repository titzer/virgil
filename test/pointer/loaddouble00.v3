//@execute 0=6; 1=-10; 2=401; 3=400000000
// double load at a runtime-computed offset from the start of an array.
def loadAt(p: Pointer, i: int) -> double #no-inline { return (p + i * 8).load<double>(); }
var arr: Array<double> = [1.5, -2.5, 100.25, 1e8];
def main(a: int) -> int {
	var d = loadAt(Pointer.atContents(arr), a);
	return int.truncd(d * 4.0);
}
