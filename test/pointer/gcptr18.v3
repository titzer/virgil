//@execute 0=100; 1=100
// An object-derived pointer live across a GC performed through an indirect call.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
var c: C;

def apply(f: Pointer -> Pointer, p: Pointer) -> Pointer {
	return f(p);
}
def gc(p: Pointer) -> Pointer {
	CiTest.forceGc();
	return p;
}
def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	var p = Pointer.atField(c.a);
	saved = p;
	var q = apply(if(i == 0, gc, gc), p);
	if (p != saved) return -1;
	if (q != saved) return -2;
	if (c.a != BOGUS) return 1;
	if (c.b != HUGE) return 2;
	return 100;
}
