//@execute = 42
class Cell(n: int) { }
def A1 = Cell.new(1), A2 = Cell.new(2), A3 = Cell.new(3), A4 = Cell.new(4);
def B1 = Cell.new(11), B2 = Cell.new(12), B3 = Cell.new(13), B4 = Cell.new(14);
def refs: Array<Cell> = [A1, A2, A3, A4];
def main() -> int {
	var p = Pointer.atContents(refs), s = Pointer.SIZE;
	if (!p.cmpswp(A1, B1)) return 1;
	if (!(p + s).cmpswp(A2, B2)) return 2;
	if (!(p + 2 * s).cmpswp(A3, B3)) return 3;
	if (!(p + 3 * s).cmpswp(A4, B4)) return 4;
	if (refs[0].n != 11) return 5;
	if (refs[1].n != 12) return 6;
	if (refs[2].n != 13) return 7;
	if (refs[3].n != 14) return 8;
	return 42;
}
