//@execute 0=true; 1=true; 2=true
def main(a: int) -> bool {
	match (a) {
		0 => { var p = Pointer.NULL + 0x1_0000_0000L; return (p - Pointer.NULL) == 0x1_0000_0000L; }
		1 => { var p = Pointer.NULL + 0x1_0000_0001L; return (p - Pointer.NULL) == 0x1_0000_0001L; }
		_ => { var p = Pointer.NULL + -1L; return (p - Pointer.NULL) == -1L; }
	}
}
