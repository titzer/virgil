//@execute 0=0; 3=0; -5=0; 77777=0
// A 64-bit load must agree with two 32-bit loads of its halves (little-endian).
def load64(p: Pointer) -> u64 #no-inline { return p.load<u64>(); }
def load32(p: Pointer) -> u32 #no-inline { return p.load<u32>(); }
var arr = Array<u64>.new(2);
def main(a: int) -> int {
	arr[1] = (u64.view(u32.view(a)) << 32) | u32.view(a ^ 0x5A5A5A5A);
	var p = Pointer.atElement(arr, 1);
	var v = load64(p);
	var lo = load32(p), hi = load32(p + 4);
	var r = 0;
	if (int.view(v) != int.view(lo)) r |= 1;
	if (int.view(v >> 32) != int.view(hi)) r |= 2;
	if (v != ((u64.view(hi) << 32) | lo)) r |= 4;
	return r;
}
