//@execute 0=111; 1=5; 2=268435456
// Pointer.atField(obj.f) of a middle field, live across an allocation and a forced GC.
// Object-derived pointers must not be treated as reference roots by the shadow stack spiller.
// Each pointer is saved to a global before a GC and checked to be unchanged afterwards; a GC
// that (wrongly) scans the pointer as a root would relocate it. The word an interior pointer
// targets is 5 (decodes as a primitive array header, scale 1) followed by 0x10000000 (decodes
// as the length), so such a GC would more likely trap while copying the bogus object.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int, var c: int) { }
var x: C;

def main(i: int) -> int {
	x = C.new(111, BOGUS, HUGE);
	var p = Pointer.atField(x.b);
	saved = p;
	var y = C.new(i, i, i);
	CiTest.forceGc();
	if (p != saved) return -1;
	if (y.a != i) return -2;
	return if(i == 0, x.a, if(i == 1, x.b, x.c));
}
