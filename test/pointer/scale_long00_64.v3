//@execute 0=0; 1=31; 2=1023; 3=4095
var sink: int;
var a = Array<u32>.new(4096);
def load(p: Pointer, x: int, i: long) -> u32 {
	var r = (p + ((i >> 5) << 2)).load<u32>();
	sink = x << 3;
	return r;
}
def main(n: int) -> int {
	if (sink == -1) return 0;
	for (i < a.length) a[i] = u32.view(i);
	var p = Pointer.atContents(a);
	var idx = [0L, 31L * 32, 1023L * 32 + 7, 4095L * 32 + 31];
	return int.view(load(p, n, idx[n]));
}
