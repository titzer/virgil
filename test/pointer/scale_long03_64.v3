//@execute 0=5; 1=6; 2=7; 3=8
var sink: int;
var a = Array<long>.new(4);
def store(p: Pointer, x: int, i: long, v: long) {
	sink = x << 2;
	(p + (i << 3)).store<long>(v);
}
def main(n: int) -> long {
	if (sink == -1) return 0;
	var p = Pointer.atContents(a);
	for (i < a.length) store(p, n, i, 5L + i);
	return a[n];
}
