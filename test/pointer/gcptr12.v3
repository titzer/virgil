//@execute 0=100; 1=100
// An object-derived pointer returned from a recursive method and live across a GC.
def BOGUS = 5;
def HUGE = 0x10000000;
var saved: Pointer;
var saved2: Pointer;
class C(var a: int, var b: int) { }
var c: C;

def getPtr(depth: int) -> Pointer {
	if (depth > 0) return getPtr(depth - 1);
	return Pointer.atField(c.a);
}
def main(i: int) -> int {
	c = C.new(BOGUS, HUGE);
	var p = getPtr(2);
	saved = p;
	CiTest.forceGc();
	if (p != saved) return -1;
	if (c.a != BOGUS) return 1;
	if (c.b != HUGE) return 2;
	return 100;
}
