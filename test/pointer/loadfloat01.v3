//@execute 0=0; 1=8; 2=12; 3=14; 4=15
// Loop of float loads at negative offsets from the last element, plus a bit-pattern check via a u32 load.
def sumf(p: Pointer, n: int) -> float #no-inline {
	var s = 0.0f;
	for (i < n) s += (p + (-4 * i)).load<float>();
	return s;
}
def loadBits(p: Pointer) -> u32 #no-inline { return p.load<u32>(); }
var arr: Array<float> = [1.0f, 2.0f, 4.0f, 8.0f];
def main(a: int) -> int {
	var end = Pointer.atElement(arr, 3);
	var s = sumf(end, a);
	if (loadBits(end) != u32.view(8.0f)) return -1;
	return int.truncf(s);
}
