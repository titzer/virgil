//@execute 0=402653180; 1=305419896; 2=-33554433; 3=33554432; 4=-4; 5=5
def enc(op: u6, imm: i26, lo: u32) -> long {
	return long.pack<(u6, i26, u32)>((op, imm, lo));
}
def main(a: int) -> int {
	match (a) {
		0 => return int.view(enc(5, -4, 0) >> 32);
		1 => return int.view(enc(5, -4, 0x12345678));
		2 => return int.view(enc(63, 0x1FFFFFF, 0) >> 32);
		3 => return int.view(enc(0, -0x2000000, 0) >> 32);
		4 => return long.unpack<(u6, i26, u32)>(enc(5, -4, 0x12345678)).1;
		_ => return long.unpack<(u6, i26, u32)>(enc(5, -4, 0x12345678)).0;
	}
}
