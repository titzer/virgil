//@execute 0=5; 1=2; 2=-1; 3=-2147483648; 4=1
def r_info(index: u32, rtype: u8) -> u64 {
	return u64.pack<(u32, u32)>((index, rtype));
}
def main(a: int) -> int {
	match (a) {
		0 => return int.view(r_info(5, 2) >> 32);
		1 => return int.view(r_info(5, 2));
		2 => return int.view(r_info(0xFFFFFFFFu, 0xFF) >> 32);
		3 => return int.view(r_info(0x80000000u, 0) >> 32);
		_ => return if(u64.unpack<(u32, u32)>(r_info(0x12345678u, 0xAB)) == (0x12345678u, 0xABu), 1, 0);
	}
}
