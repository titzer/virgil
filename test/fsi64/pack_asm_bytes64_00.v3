//@execute 0=1; 1=128; 2=0; 3=16909060; 4=-2; 5=1; 6=-559038737
def W: u64 = 0x0102030480FF7F00;
def main(a: int) -> int {
	var b = u64.unpack<(byte, byte, byte, byte, byte, byte, byte, byte)>(W);
	match (a) {
		0 => return b.0;
		1 => return b.4;
		2 => return b.7;
		3 => return int.view(u64.pack<(byte, byte, byte, byte, byte, byte, byte, byte)>(b) >> 32);
		4 => return int.view(long.pack<(i32, u32)>((-2, 0xDEADBEEFu)) >> 32);
		5 => return if(long.pack<(i32, u32)>((-2, 0xDEADBEEFu)) == 0xFFFFFFFEDEADBEEFL, 1, 0);
		_ => return int.view(long.pack<(i32, u32)>((-2, 0xDEADBEEFu)));
	}
}
