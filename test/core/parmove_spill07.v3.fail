//@execute 0=238495519; 1=441102456; 3=-1263513864
// The shape of an MD5 round: four state words rotate, one of them is replaced
// by a fresh value computed through a call, and ten accumulators stay live.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def rot(x: int, n: byte) -> int { return (x << n) | (x >>> byte.view(32 - int.!(n))); }
def K: Array<int> = [11, 13, 17, 19, 23, 29, 31, 37];
def S: Array<byte> = [7, 12, 17, 22, 5, 9, 14, 20];
def main(n: int) -> int {
	var a = n + 1, b = n + 2, c = n + 3, d = n + 4;
	var s0 = n * 2, s1 = n * 3, s2 = n * 4, s3 = n * 5, s4 = n * 6, s5 = n * 7, s6 = n * 8, s7 = n * 9, s8 = n * 10, s9 = n * 11;
	for (i < 8) {
		var g = (b & c) | (~b & d);
		var sum = a + g + K[i] + i;
		s0 = s0 * 5 + a + 0;
		s1 = s1 * 5 + b + 1;
		s2 = s2 * 5 + c + 2;
		s3 = s3 * 5 + d + 3;
		s4 = s4 * 5 + g + 4;
		s5 = s5 * 5 + a + 5;
		s6 = s6 * 5 + b + 6;
		s7 = s7 * 5 + c + 7;
		s8 = s8 * 5 + d + 8;
		s9 = s9 * 5 + g + 9;
		var t = d;
		d = c;
		c = b;
		b = b + rot(sum, S[i]);
		a = t;
	}
	return s0 * 3 ^ s1 * 4 ^ s2 * 5 ^ s3 * 6 ^ s4 * 7 ^ s5 * 8 ^ s6 * 9 ^ s7 * 10 ^ s8 * 11 ^ s9 * 12 ^ a ^ (b * 3) ^ (c * 5) ^ (d * 7);
}
