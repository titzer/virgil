//@execute 0=547471; 1=1413718; 4=22703619
// Four values rotate while twelve accumulators stay live, so the rotating
// values are pushed into spill slots and their cycle runs through the stack.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def main(n: int) -> int {
	var a = n + 1, b = n + 2, c = n + 3, d = n + 4;
	var s0 = n * 2, s1 = n * 3, s2 = n * 4, s3 = n * 5, s4 = n * 6, s5 = n * 7, s6 = n * 8, s7 = n * 9, s8 = n * 10, s9 = n * 11, s10 = n * 12, s11 = n * 13;
	for (i < 9) {
		s0 = s0 * 3 + a + 0;
		s1 = s1 * 3 + b + 1;
		s2 = s2 * 3 + c + 2;
		s3 = s3 * 3 + d + 3;
		s4 = s4 * 3 + a + 4;
		s5 = s5 * 3 + b + 5;
		s6 = s6 * 3 + c + 6;
		s7 = s7 * 3 + d + 7;
		s8 = s8 * 3 + a + 8;
		s9 = s9 * 3 + b + 9;
		s10 = s10 * 3 + c + 10;
		s11 = s11 * 3 + d + 11;
		var t = d;
		d = c;
		c = b;
		b = a;
		a = t;
	}
	return s0 * 3 ^ s1 * 4 ^ s2 * 5 ^ s3 * 6 ^ s4 * 7 ^ s5 * 8 ^ s6 * 9 ^ s7 * 10 ^ s8 * 11 ^ s9 * 12 ^ s10 * 13 ^ s11 * 14 ^ (a * 1000 + b * 100 + c * 10 + d);
}
