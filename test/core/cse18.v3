//@execute 0=105; 1=143; 2=104; 3=104
type T {
	case A(x: int);
	case B(x: int, y: int);
	case C;
}
def make(a: int) -> T {
	if (a == 0) return T.A(5);
	if (a == 1) return T.B(6, 7);
	return T.C;
}
def main(a: int) -> int {
	var t = make(a), u = make(a);
	var r = if(t == u, 100);
	match (t) {
		A(x) => r += x;
		B(x, y) => r += x * y;
		C => r += t.tag;
	}
	return r + t.tag;
}
