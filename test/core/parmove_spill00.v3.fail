//@execute 0=-690368784; 1=1033999576; 5=-658461576
// Sixteen values rotate around a loop: more than there are registers, so the
// phi moves at the back-edge form a cycle that passes through spill slots.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def main(n: int) -> int {
	var v0 = n + 1, v1 = n + 2, v2 = n + 3, v3 = n + 4, v4 = n + 5, v5 = n + 6, v6 = n + 7, v7 = n + 8, v8 = n + 9, v9 = n + 10, v10 = n + 11, v11 = n + 12, v12 = n + 13, v13 = n + 14, v14 = n + 15, v15 = n + 16;
	var sum = 0;
	for (i < 19) {
		sum = sum * 3 + v0 * 1 + v1 * 2 + v2 * 3 + v3 * 4 + v4 * 5 + v5 * 6 + v6 * 7 + v7 * 8 + v8 * 9 + v9 * 10 + v10 * 11 + v11 * 12 + v12 * 13 + v13 * 14 + v14 * 15 + v15 * 16;
		var t = v0;
		v0 = v1;
		v1 = v2;
		v2 = v3;
		v3 = v4;
		v4 = v5;
		v5 = v6;
		v6 = v7;
		v7 = v8;
		v8 = v9;
		v9 = v10;
		v10 = v11;
		v11 = v12;
		v12 = v13;
		v13 = v14;
		v14 = v15;
		v15 = t;
	}
	return sum;
}
