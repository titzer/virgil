//@execute 0=-1837669940; 1=1719385425; 2=1431171673; 3=727597017
// Extracted from test/smoke/work03.v3: an MD5-style compression whose four
// rotating state words live in spill slots across the calls in the loop.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def rotl32(x: u32, n: byte) -> u32 {
	if (n == 0) return x;
	return (x << n) | (x >> byte.view(32 - int.!(n)));
}
def fF(x: u32, y: u32, z: u32) -> u32 { return (x & y) | (~x & z); }
def fG(x: u32, y: u32, z: u32) -> u32 { return (x & z) | (y & ~z); }
def fH(x: u32, y: u32, z: u32) -> u32 { return x ^ y ^ z; }
def fI(x: u32, y: u32, z: u32) -> u32 { return y ^ (x | ~z); }
def SHIFTS: Array<byte> = [7, 12, 17, 22, 5, 9, 14, 20, 4, 11, 16, 23, 6, 10, 15, 21];
def KVALS: Array<u32> = [
	0xD76AA478u, 0xE8C7B756u, 0x242070DBu, 0xC1BDCEEEu,
	0xF57C0FAFu, 0x4787C62Au, 0xA8304613u, 0xFD469501u,
	0x698098D8u, 0x8B44F7AFu, 0xFFFF5BB1u, 0x895CD7BEu,
	0x6B901122u, 0xFD987193u, 0xA679438Eu, 0x49B40821u
];
class Digest {
	var a = 0x67452301u;
	var b = 0xEFCDAB89u;
	var c = 0x98BADCFEu;
	var d = 0x10325476u;
	def block(m: Array<u32>) {
		var aa = a, bb = b, cc = c, dd = d;
		for (i < 16) {
			var f: u32;
			var g: int;
			var round = i / 4;
			if (round == 0) { f = fF(bb, cc, dd); g = i; }
			else if (round == 1) { f = fG(bb, cc, dd); g = (5 * i + 1) & 15; }
			else if (round == 2) { f = fH(bb, cc, dd); g = (3 * i + 5) & 15; }
			else { f = fI(bb, cc, dd); g = (7 * i) & 15; }
			var tmp = dd;
			dd = cc;
			cc = bb;
			var sum = aa + f + KVALS[i] + m[g];
			bb = bb + rotl32(sum, SHIFTS[i]);
			aa = tmp;
		}
		a = a + aa;
		b = b + bb;
		c = c + cc;
		d = d + dd;
	}
	def fold() -> int { return int.view(a ^ (b * 3u) ^ (c * 5u) ^ (d * 7u)); }
}
def digestOf(data: Array<byte>) -> Digest {
	var dg = Digest.new();
	var m = Array<u32>.new(16);
	for (k < data.length) {
		var w = k / 4, s = byte.view((k % 4) * 8);
		m[w] = m[w] | (u32.!(data[k]) << s);
	}
	m[15] = u32.view(data.length);
	dg.block(m);
	return dg;
}
def INPUTS: Array<string> = ["hello world", "hello worle", "", "a"];
def main(n: int) -> int {
	return digestOf(INPUTS[n]).fold();
}
