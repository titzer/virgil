//@execute 0=0; 1=33825
// tuple_eq16 with a NaN: every tuple contains one, so nothing matches, not even a
// tuple against itself.
def main(a: int) -> int {
	var x = if(a == 0, 0d / 0d, 1d);
	var y = 0d - x;
	var vals = [
		(x, x),
		(x, y),
		(y, x),
		(y, y)
	];

	var res = 0;
	for (i < vals.length) {
		for (j < vals.length) {
			if (vals[i] == vals[j]) {
				res |= 1 << u5.!((i*4) + j);
			}
		}
	}
	return res;
}
