//@execute (0,0)=65535; (0,1)=42405; (1,0)=52275; (1,1)=33825; (2,1)=33825; (1,2)=33825; (5,1)=33825
def vals = Array<(int, int)>.new(4);
def main(a: int, b: int) -> int {
	vals[0] = (a, a+b);
	vals[1] = (a, a-b);
	vals[2] = (-a, a+b);
	vals[3] = (-a, a-b);

	var res = 0;
	for (i < vals.length) {
		for (j < vals.length) {
			if (vals[i] == vals[j]) {
				res |= 1 << u5.!((i*4) + j);
			}
		}
	}
	return res;
}
