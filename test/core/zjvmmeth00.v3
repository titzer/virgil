//@execute 0=11; 1=22; 2=33; 3=44; 4=!BoundsCheckException
// Base object model
class Decl(id: int) { }
class StructDecl extends Decl { new(id: int) super(id) {} }
class ArrayDecl extends Decl { new(id: int) super(id) {} }

class BaseObject {
	def decl() -> Decl;
}
class BaseStruct extends BaseObject {
	def decl() -> StructDecl;
}
class BaseArray extends BaseObject {
	def decl() -> ArrayDecl;
}
// Extended object model
class MyStruct(decl_: StructDecl) extends BaseStruct {
	def decl() -> StructDecl { return decl_; }
}
class MyArray(decl_: ArrayDecl) extends BaseArray {
	def decl() -> ArrayDecl { return decl_; }
}

component ObjectModel {
	def newStruct = MyStruct.new;
	def newArray = MyArray.new;
}

// Pre-allocated struct and array declarations
def STRUCT11 = StructDecl.new(11);
def STRUCT22 = StructDecl.new(22);

def ARRAY33 = ArrayDecl.new(33);
def ARRAY44 = ArrayDecl.new(44);

def main(a: int) -> int {
	def objs = [
		ObjectModel.newStruct(STRUCT11),
		ObjectModel.newStruct(STRUCT22),
		ObjectModel.newArray(ARRAY33),
		ObjectModel.newArray(ARRAY44)
	];
	return objs[a].decl().id;
}
