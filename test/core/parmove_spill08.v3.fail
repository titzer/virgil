//@execute 0=-1211280858; 1=-518722747; 2=173835364
// A sixteen-value rotation at the back-edge of an inner loop, with the outer
// loop keeping its own values live across it.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def main(n: int) -> int {
	var outer = n, acc = 0;
	for (j < 3) {
		var v0 = n + j + 1, v1 = n + j + 2, v2 = n + j + 3, v3 = n + j + 4, v4 = n + j + 5, v5 = n + j + 6, v6 = n + j + 7, v7 = n + j + 8, v8 = n + j + 9, v9 = n + j + 10, v10 = n + j + 11, v11 = n + j + 12, v12 = n + j + 13, v13 = n + j + 14, v14 = n + j + 15, v15 = n + j + 16;
		var sum = 0;
		for (i < 11) {
			sum = sum * 3 + v0 * 1 + v1 * 2 + v2 * 3 + v3 * 4 + v4 * 5 + v5 * 6 + v6 * 7 + v7 * 8 + v8 * 9 + v9 * 10 + v10 * 11 + v11 * 12 + v12 * 13 + v13 * 14 + v14 * 15 + v15 * 16 + outer;
			var t = v0;
			v0 = v1;
			v1 = v2;
			v2 = v3;
			v3 = v4;
			v4 = v5;
			v5 = v6;
			v6 = v7;
			v7 = v8;
			v8 = v9;
			v9 = v10;
			v10 = v11;
			v11 = v12;
			v12 = v13;
			v13 = v14;
			v14 = v15;
			v15 = t;
		}
		acc = acc * 7 + sum + v0 * 100 + v15 + outer;
		outer = outer * 2 + j;
	}
	return acc;
}
