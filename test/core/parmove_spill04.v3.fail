//@execute 0=-690368784; 1=1033999576; 5=-658461576
// Sixteen object references rotate around a loop, so the cycle of spill slots
// carries references (and the GC's stack maps must agree).
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
class Box(val: int) { }
def main(n: int) -> int {
	var v0 = Box.new(n + 1), v1 = Box.new(n + 2), v2 = Box.new(n + 3), v3 = Box.new(n + 4), v4 = Box.new(n + 5), v5 = Box.new(n + 6), v6 = Box.new(n + 7), v7 = Box.new(n + 8), v8 = Box.new(n + 9), v9 = Box.new(n + 10), v10 = Box.new(n + 11), v11 = Box.new(n + 12), v12 = Box.new(n + 13), v13 = Box.new(n + 14), v14 = Box.new(n + 15), v15 = Box.new(n + 16);
	var sum = 0;
	for (i < 19) {
		sum = sum * 3 + v0.val * 1 + v1.val * 2 + v2.val * 3 + v3.val * 4 + v4.val * 5 + v5.val * 6 + v6.val * 7 + v7.val * 8 + v8.val * 9 + v9.val * 10 + v10.val * 11 + v11.val * 12 + v12.val * 13 + v13.val * 14 + v14.val * 15 + v15.val * 16;
		var t = v0;
		v0 = v1;
		v1 = v2;
		v2 = v3;
		v3 = v4;
		v4 = v5;
		v5 = v6;
		v6 = v7;
		v7 = v8;
		v8 = v9;
		v9 = v10;
		v10 = v11;
		v11 = v12;
		v12 = v13;
		v13 = v14;
		v14 = v15;
		v15 = t;
	}
	return sum;
}
