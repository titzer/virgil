//@execute 0=65535; 1=33825; 2=33825
// tuple_eq12 over doubles built from the argument, so nothing is constant-folded.
// At a=0 the two operands are +0.0 and -0.0, which compare equal, so every pair
// matches; elsewhere the four tuples are pairwise distinct.
def main(a: int) -> int {
	var x = double.!(a);
	var y = 0d - x;
	var vals = [
		(x, x),
		(x, y),
		(y, x),
		(y, y)
	];

	var res = 0;
	for (i < vals.length) {
		for (j < vals.length) {
			if (vals[i] == vals[j]) {
				res |= 1 << u5.!((i*4) + j);
			}
		}
	}
	return res;
}
