//@execute 0=10; 1=21; 2=200; 3=90; 4=100
// Match arms of different depths that merge, with dead values in some arms.
def main(a: int) -> int {
	var r = 100, dead = 0;
	match (a) {
		0 => r = 10;
		1 => if (a > 0) { r = a + 20; dead = r * 2; }
		2, 3 => {
			dead = a;
			if (a == 3) r = a * 30;
			else r = 200;
		}
		_ => dead = a * a;
	}
	return r;
}
