//@execute 0=65535; 1=33825
def vals = Array<(int, int)>.new(4);
def main(a: int) -> int {
	vals[0] = (a, a);
	vals[1] = (a, -a);
	vals[2] = (-a, a);
	vals[3] = (-a, -a);

	var res = 0;
	for (i < vals.length) {
		for (j < vals.length) {
			if (vals[i] == vals[j]) {
				res |= 1 << u5.!((i*4) + j);
			}
		}
	}
	return res;
}
