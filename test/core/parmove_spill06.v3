//@execute 0=5409; 1=5829; 5=7509
// Twenty doubles rotate around a loop: more than there are XMM registers.
def main(n: int) -> int {
	var d0 = n + 1.5, d1 = n + 2.5, d2 = n + 3.5, d3 = n + 4.5, d4 = n + 5.5, d5 = n + 6.5, d6 = n + 7.5, d7 = n + 8.5, d8 = n + 9.5, d9 = n + 10.5, d10 = n + 11.5, d11 = n + 12.5, d12 = n + 13.5, d13 = n + 14.5, d14 = n + 15.5, d15 = n + 16.5, d16 = n + 17.5, d17 = n + 18.5, d18 = n + 19.5, d19 = n + 20.5;
	var sum = 0.0;
	for (i < 23) {
		sum = sum * 0.5 + d0 * 1.0 + d1 * 2.0 + d2 * 3.0 + d3 * 4.0 + d4 * 5.0 + d5 * 6.0 + d6 * 7.0 + d7 * 8.0 + d8 * 9.0 + d9 * 10.0 + d10 * 11.0 + d11 * 12.0 + d12 * 13.0 + d13 * 14.0 + d14 * 15.0 + d15 * 16.0 + d16 * 17.0 + d17 * 18.0 + d18 * 19.0 + d19 * 20.0;
		var t = d0;
		d0 = d1;
		d1 = d2;
		d2 = d3;
		d3 = d4;
		d4 = d5;
		d5 = d6;
		d6 = d7;
		d7 = d8;
		d8 = d9;
		d9 = d10;
		d10 = d11;
		d11 = d12;
		d12 = d13;
		d13 = d14;
		d14 = d15;
		d15 = d16;
		d16 = d17;
		d17 = d18;
		d18 = d19;
		d19 = t;
	}
	return int.truncd(sum);
}
