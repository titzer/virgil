//@execute 0=1006069678; 1=-1564528669; 5=1037979738
// Sixteen 64-bit values rotate around a loop.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def main(n: int) -> int {
	var v0 = n + 0x100000001L, v1 = n + 0x200000002L, v2 = n + 0x300000003L, v3 = n + 0x400000004L, v4 = n + 0x500000005L, v5 = n + 0x600000006L, v6 = n + 0x700000007L, v7 = n + 0x800000008L, v8 = n + 0x900000009L, v9 = n + 0xA0000000AL, v10 = n + 0xB0000000BL, v11 = n + 0xC0000000CL, v12 = n + 0xD0000000DL, v13 = n + 0xE0000000EL, v14 = n + 0xF0000000FL, v15 = n + 0x10000000010L;
	var sum = 0L;
	for (i < 19) {
		sum = sum * 3 + v0 * 1 + v1 * 2 + v2 * 3 + v3 * 4 + v4 * 5 + v5 * 6 + v6 * 7 + v7 * 8 + v8 * 9 + v9 * 10 + v10 * 11 + v11 * 12 + v12 * 13 + v13 * 14 + v14 * 15 + v15 * 16;
		var t = v0;
		v0 = v1;
		v1 = v2;
		v2 = v3;
		v3 = v4;
		v4 = v5;
		v5 = v6;
		v6 = v7;
		v7 = v8;
		v8 = v9;
		v9 = v10;
		v10 = v11;
		v11 = v12;
		v12 = v13;
		v13 = v14;
		v14 = v15;
		v15 = t;
	}
	return int.view(sum) + int.view(sum >> 32) * 31;
}
