//@execute 0=0; 1=0; 3=-1; 4=-2; 6=4; 8=6
// A loop-carried value whose backedge comes from a nested merge in the loop body.
def main(n: int) -> int {
	var acc = 0;
	for (i < n) {
		if ((i & 1) == 0) {
			if ((i & 2) == 0) acc = acc + i;
			else acc = acc - 1;
		} else {
			acc = acc * 2;
		}
	}
	return acc;
}
