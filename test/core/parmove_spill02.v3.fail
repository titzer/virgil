//@execute 0=244353; 1=843641; 9=2074121
// Two values swap while fourteen accumulators stay live: a two-cycle of spill
// slots, the smallest possible cycle.
// Miscompiled at -O2 on x86-64 (global register allocation): the temp that
// breaks the move cycle is the scratch register r15, which every
// stack-to-stack move also uses, so the saved value is clobbered.
// See GlobalRegAlloc.allocMoveTmp and SsaX86_64Gen.genMoveLocLoc.
def main(n: int) -> int {
	var a = n + 1, b = n + 2;
	var s0 = n * 2, s1 = n * 3, s2 = n * 4, s3 = n * 5, s4 = n * 6, s5 = n * 7, s6 = n * 8, s7 = n * 9, s8 = n * 10, s9 = n * 11, s10 = n * 12, s11 = n * 13, s12 = n * 14, s13 = n * 15;
	for (i < 7) {
		s0 = s0 * 3 + a + 0;
		s1 = s1 * 3 + b + 1;
		s2 = s2 * 3 + a + 2;
		s3 = s3 * 3 + b + 3;
		s4 = s4 * 3 + a + 4;
		s5 = s5 * 3 + b + 5;
		s6 = s6 * 3 + a + 6;
		s7 = s7 * 3 + b + 7;
		s8 = s8 * 3 + a + 8;
		s9 = s9 * 3 + b + 9;
		s10 = s10 * 3 + a + 10;
		s11 = s11 * 3 + b + 11;
		s12 = s12 * 3 + a + 12;
		s13 = s13 * 3 + b + 13;
		var t = a;
		a = b;
		b = t;
	}
	return s0 * 3 ^ s1 * 4 ^ s2 * 5 ^ s3 * 6 ^ s4 * 7 ^ s5 * 8 ^ s6 * 9 ^ s7 * 10 ^ s8 * 11 ^ s9 * 12 ^ s10 * 13 ^ s11 * 14 ^ s12 * 15 ^ s13 * 16 ^ (a * 10 + b);
}
