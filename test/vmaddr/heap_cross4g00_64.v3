//@execute 0=42
// Allocate large arrays until the allocation pointer has moved more than 4GB into the
// heap, then check that the objects on both sides of that boundary still work. Only a
// couple of pages of each large array are ever touched, so the amount of physical
// memory actually used stays small. Does nothing if the heap is too small to reach the
// boundary, so that this test can be run with any heap size.
def MAX_LONGS = 268435454;		// largest allocatable Array<long>
def GOAL = 4L * 1024 * 1024 * 1024;	// move this far into the heap
def SLACK = 4L * 1024 * 1024 * 1024;	// room for one more chunk plus change

def main(a: int) -> int {
	var start = CiRuntime.heapCurLoc.load<Pointer>();
	var limit = CiRuntime.heapEndLoc.load<Pointer>(); // where allocation actually stops
	if (limit - start < GOAL + SLACK) return 42; // heap too small to test
	var arrays = Array<Array<long>>.new(8);
	var count = 0;
	while (count < arrays.length && CiRuntime.heapCurLoc.load<Pointer>() - start < GOAL) {
		var x = Array<long>.new(MAX_LONGS);
		x[0] = count;
		x[MAX_LONGS - 1] = 1000 + count;
		arrays[count] = x;
		count++;
	}
	if (count == 0) return -1;
	if (CiRuntime.heapCurLoc.load<Pointer>() - start < GOAL) return -2;

	// everything below is allocated more than 4GB above the start of the heap
	var tail = Array<int>.new(5);
	for (i < tail.length) tail[i] = i * 11;
	var alias = Array<Array<long>>.new(1);
	alias[0] = arrays[0];

	for (i < count) {
		var x = arrays[i];
		if (x == null) return -3;
		if (x.length != MAX_LONGS) return -4;
		if (x[0] != i) return -5;
		if (x[MAX_LONGS - 1] != 1000 + i) return -6;
	}
	for (i < tail.length) if (tail[i] != i * 11) return -7;
	if (alias[0] != arrays[0]) return -8;
	return 42;
}
