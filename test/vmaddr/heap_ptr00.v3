//@execute 0=42
// Pointers into a large heap must compare and subtract correctly, even when the heap
// lies (partly) above the 32-bit boundary.
def main(a: int) -> int {
	var x = Array<int>.new(64);
	for (i < x.length) x[i] = i * 3;
	var r: Range<int> = x;
	var p = Pointer.atContents(r);
	if (p < CiRuntime.HEAP_START) return -1;
	if (p >= CiRuntime.HEAP_END) return -2;
	for (i < x.length) {
		if ((p + i * 4).load<int>() != i * 3) return -3;
	}
	(p + 4).store<int>(99);
	if (x[1] != 99) return -4;
	var q = p + x.length * 4;
	if (q <= p) return -5;
	if (q - p != x.length * 4) return -6;
	return 42;
}
