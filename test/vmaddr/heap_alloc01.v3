//@execute 0=42
// Arrays of every scalar width must round-trip through a large heap.
def N = 500;
def main(a: int) -> int {
	var b = Array<byte>.new(N);
	var s = Array<i16>.new(N);
	var i32 = Array<int>.new(N);
	var i64 = Array<long>.new(N);
	for (k < N) {
		b[k] = byte.view(k);
		s[k] = i16.view(k);
		i32[k] = k * 7;
		i64[k] = long.view(k) << 40;
	}
	for (k < N) {
		if (b[k] != byte.view(k)) return -1;
		if (s[k] != i16.view(k)) return -2;
		if (i32[k] != k * 7) return -3;
		if (i64[k] != long.view(k) << 40) return -4;
	}
	if (b.length != N) return -5;
	if (i64.length != N) return -6;
	return 42;
}
