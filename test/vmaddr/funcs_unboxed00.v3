//@execute 0=8; 1=6; 2=10; 3=4; 4=3; 5=99
// Different function types in one unboxed variant share a scalar of type #anyfunc.
// Regression test for that scalar being given a 32-bit register class, which
// truncated code pointers once the image was loaded above 4GB.
type T #unboxed {
	case F(f: int -> int);
	case G(g: (int, int) -> int);
	case S(s: string);
	case I(x: int);

	def apply(v: int) -> int {
		match (this) {
			F(f) => return f(v);
			G(g) => return g(v, 3);
			S(s) => return s.length;
			I(x) => return x;
		}
	}
}

def inc(x: int) => x + 1;
def dec(x: int) => x - 1;
def add(x: int, y: int) => x + y;
def sub(x: int, y: int) => x - y;

def fs = [inc, dec];
def gs = [add, sub];

def mk(a: int) -> T {
	match (a) {
		0 => return T.F(fs[0]);
		1 => return T.F(fs[1]);
		2 => return T.G(gs[0]);
		3 => return T.G(gs[1]);
		4 => return T.S("abc");
		_ => return T.I(99);
	}
}

def main(a: int) -> int {
	var v = mk(a);
	var w = Array<T>.new(1);
	w[0] = v;
	return w[0].apply(7) + if(w[0] != v, 1000, 0);
}
