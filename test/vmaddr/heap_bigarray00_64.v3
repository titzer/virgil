//@execute 0=42
// An array whose total size does not fit in a 32-bit integer cannot be allocated, no
// matter how big the heap is. The limit must be enforced rather than silently wrapping
// around and handing back an object that is far too small. Does nothing if the heap is
// too small to hold the largest allowed array.
def MAX_LONGS = 268435454;	// (int.max - 8 - 7) / 8
def NEEDED = 3L * 1024 * 1024 * 1024;

def main(a: int) -> int {
	var cur = CiRuntime.heapCurLoc.load<Pointer>();
	if (CiRuntime.heapEndLoc.load<Pointer>() - cur < NEEDED) return 42; // heap too small
	var n = MAX_LONGS + a; // opaque to the optimizer
	var x = Array<long>.new(n);
	if (x.length != MAX_LONGS) return -1;
	x[0] = 5;
	x[MAX_LONGS - 1] = 6;
	// the next object must not overlap the one just allocated
	var y = Array<long>.new(2);
	y[0] = 7;
	y[1] = 8;
	if (x[0] != 5) return -2;
	if (x[MAX_LONGS - 1] != 6) return -3;
	if (y[0] != 7) return -4;
	if (y[1] != 8) return -5;
	var rx: Range<long> = x;
	var ry: Range<long> = y;
	if (Pointer.atContents(ry) - Pointer.atContents(rx) < 8L * MAX_LONGS) return -6;
	return 42;
}
