//@execute 0=42
// Objects allocated in a large heap must keep their contents and their identity.
class Node(id: int) {
	var next: Node;
	var payload: long;
}
def COUNT = 200;
def main(a: int) -> int {
	var nodes = Array<Node>.new(COUNT);
	for (i < COUNT) {
		var n = Node.new(i);
		n.payload = long.view(i) * 0x123456789L;
		if (i > 0) n.next = nodes[i - 1];
		nodes[i] = n;
	}
	for (i < COUNT) {
		var n = nodes[i];
		if (n.id != i) return -1;
		if (n.payload != long.view(i) * 0x123456789L) return -2;
		if (i > 0 && n.next != nodes[i - 1]) return -3;
		if (i == 0 && n.next != null) return -4;
	}
	for (i < COUNT) {
		if (nodes[i] != nodes[i]) return -5;
		if (nodes[i] == nodes[(i + 1) % COUNT]) return -6;
	}
	return 42;
}
