//@execute 0=42
// The runtime's view of the heap region must be self-consistent. With a large heap the
// heap end lies far above the data segment, well outside the range of a 32-bit address.
def use<T>(x: T) -> T #no-inline { return x; }

def main(a: int) -> int {
	// Allocate, since some targets only emit heap pointers for allocating programs.
	if (use(Array<int>.new(4)).length != 4) return -8;
	if (CiRuntime.HEAP_START >= CiRuntime.HEAP_END) return -1;
	if (CiRuntime.HEAP_END - CiRuntime.HEAP_START <= 0) return -2;
	var cur = CiRuntime.heapCurLoc.load<Pointer>();
	if (cur < CiRuntime.HEAP_START) return -3;
	if (cur > CiRuntime.HEAP_END) return -4;
	var end = CiRuntime.heapEndLoc.load<Pointer>();
	if (end <= CiRuntime.HEAP_START) return -5;
	if (end > CiRuntime.HEAP_END) return -6;
	if (cur > end) return -7;
	return 42;
}
