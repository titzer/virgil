//@execute 0=!HeapOverflow
// An array bigger than the largest representable object size must be rejected, even
// when the heap has room for it, rather than wrapping around to a tiny allocation.
def main(a: int) -> int {
	var n = 268435455 + a; // one more than the largest allocatable Array<long>
	return Array<long>.new(n).length;
}
