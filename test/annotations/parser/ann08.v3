//@parse
@type bare;
@type withField(why: string);
@type withDefault(why: string = "");
@type several(a: int, b: string = "x", c: bool = true);
@target(TargetKind.Class)
@repeatable
@type metaAnnotated(v: int);
@type withMethods(value: int) {
	def ok() -> bool { return value != 0; }
	private def helper() { }
}
@type withRequiredField(@required since: int, why: string = "");
