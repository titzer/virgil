//@seman
// The root is named "@Annotation", which is unforgeable, so a user may define their own
// "Annotation" and it does not collide. This used to report TypeRedefined against the
// synthetic <annotations> file, which the user never wrote.
@type repeatable;
class Annotation { var x: int; }
component M {
	var mine: Annotation;
	def main(a: int) -> int { return 0; }
}
