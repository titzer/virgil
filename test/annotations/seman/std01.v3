//@seman
// TargetKind, Retention and the groupings come from lib/annotations/TargetKind.v3 and are
// ordinary declarations, usable directly.
component M {
	def d: TargetKind.set = TargetKinds.Declaration;
	def r: Retention = Retention.Source;
	def main(a: int) -> bool { return d.Field && r == Retention.Source; }
}
