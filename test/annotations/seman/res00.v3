//@seman
// A declared annotation resolves at every supported site.
@type cold;
@cold class C { }
@cold component D { }
@cold enum E { @cold X }
@cold type T { @cold case A; }
@cold class G<@cold P> {
	@cold var x: int;
	@cold def m() { }
	@cold new() { }
	var y: @cold Array<int>;
	def n() -> @cold int { return 0; }
}
@file(@cold);
component M {
	def run() { @cold { var z = 1; } }
	def main(a: int) -> int { return 0; }
}
