//@seman
// @target constrains where an annotation may go, in all three spellings.
@target(TargetKind.Class) @type onClass;
@target(TargetKind.Class | TargetKind.Enum) @type onEither;
@target(TargetKinds.Container) @type onContainer;
@type anywhere;
@onClass class A { }
@onEither class B { }
@onEither enum E { X }
@onContainer component D { }
@anywhere class F { @anywhere def m() { } }
component M { def main(a: int) -> int { return 0; } }
