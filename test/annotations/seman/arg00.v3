//@seman
// Positional, keyword, mixed, defaults, and an annotation used as a value.
@type t(v: int, w: string = "d");
@t(1) class A { }
@t(1, "x") class B { }
@t(w = "x", 1) class C { }
@t(v = 1, w = "x") class D { }
@type holds(v: Annotation);
@holds(@t(2)) class E { }
component M { def main(a: int) -> int { return 0; } }
