//@seman
// Everything the design note admits as an annotation value.
@type ints(v: int);
@type str(v: string);
@type set(v: TargetKind.set);
@type arr(v: Array<int>);
@type nested(v: Annotation);
component K { def k: int = 40 + 2; }
@ints(7) class A { }
@ints(1 + 2 * 3) class B { }
@ints(K.k) class C { }
@str("hi") class D { }
@set(TargetKind.Class | TargetKind.Enum) class E { }
@set(TargetKinds.Container) class F { }
@arr([1, 2, 3]) class G { }
@nested(@ints(5)) class H { }
component M { def main(a: int) -> int { return 0; } }
