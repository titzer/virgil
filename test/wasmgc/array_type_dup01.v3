//@execute 0=0; 5=5; 7=7
// Like array_type_dup00, but the array only joins a recursion group when all
// classes share a root type (-wasm-gc-use-ref-test).
class Cell(id: int) { }
class Holder(cells: Array<Cell>) { }
var g: Array<Cell>;
def main(a: int) -> int {
	var outer = Array<Array<Cell>>.new(1);
	outer[0] = Array<Cell>.new(1);
	outer[0][0] = Cell.new(a);
	var hs = Array<Holder>.new(2);
	hs[a & 1] = Holder.new(outer[0]);
	g = null;
	return hs[a & 1].cells[0].id;
}
