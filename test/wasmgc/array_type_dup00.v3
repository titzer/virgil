//@execute 0=0; 5=5; 7=7
// A null constant of an array type must not create a second Wasm array type
// once the type is already in a recursion group via a class field.
class Node(id: int) { var kids: Array<Node>; }
var g: Array<Node>;
def main(a: int) -> int {
	var outer = Array<Array<Node>>.new(1);
	outer[0] = Array<Node>.new(1);
	outer[0][0] = Node.new(a);
	var ns = Array<Node>.new(2);
	ns[a & 1] = Node.new(a);
	ns[a & 1].kids = outer[0];
	g = null;
	return ns[a & 1].kids[0].id;
}
