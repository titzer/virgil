//@execute 0=true; 1=false
// A recursive variant that is also polymorphic breaks its generated equality method.
// Compiles clean, then segfaults at runtime on x86-64-linux; under -ra the compiler
// itself allocates without bound and dies with !HeapOverflow in getClosedIrSpec().
//
// All three ingredients are required; dropping any one of them passes:
//   - polymorphism:  the same variant over a concrete int is fine
//   - recursion:     "case A(a: E)" is fine
//   - equality:      reading the fields with a match instead of == is fine
//
// Not caused by the recursive-unboxing fix in VariantNormalizer.unboxUsingTaglessVariantNorm;
// it reproduces the same way before that change. Boxing T explicitly (#boxed), or writing
// it as a single-case "type T<E>(a: E, b: T<E>) #unboxed", hits the -ra HeapOverflow too,
// though those forms happen to run correctly when compiled.
type T<E> {
	case A(a: E, b: T<E>);
	case B;
}

def main(a: int) -> bool {
	var d: T<int>;
	var v = T<int>.A(a, d);
	return d == v;
}
