// -dwarf spills every value, so a stale upper half corrupts a slice's base address.
def dirty(n: int) -> long {
	if (n <= 0) return -1;
	var x = (-1L << 32) | long.view(n);
	var a = x|1, b = x|2, c = x|4, d = x|8, e = x|16, f = x|32, g = x|64, h = x|128;
	return a | b | c | d | e | f | g | h | dirty(n - 1);
}
def probe(off: int) -> int {
	var buf: Array<byte> = [10, 11, 12];
	var sum = 0;
	for (b in buf[off ... off + 3]) sum += b;
	return sum;
}
def main() -> int {
	System.puts("spills\n");
	dirty(4);
	return probe(0) - 33;
}
