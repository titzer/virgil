def main() -> int {
	def sig = CiWasmTarget.functionTypeId<int, int>();
	def wasm_bytes: Array<byte> = [0x00, 0x41, 0x2A, 0x0B];
	def fid = wave.new_func(sig, Pointer.atContents(wasm_bytes), wasm_bytes.length);
	def f = CiRuntime.forgeClosure<void, void, int>(Pointer.NULL + fid, void);
	return f();
}
