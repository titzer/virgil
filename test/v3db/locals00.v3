def f(a: int) -> int {
	var x = a + 1;
	return x;
}
def g(b: int) -> int {
	return b;
}
def pick(c: int) -> int {
	if (c > 0) {
		var a = 1;
		a = a + c;
		return a;
	} else {
		var b = 2;
		b = b + c;
		return b;
	}
}
def main() -> int {
	var t = (1, true, 2);
	t = (2, false, 4);
	var r = f(1);
	r = r + g(2) + pick(0) + pick(1);
	return r + t.0;
}
