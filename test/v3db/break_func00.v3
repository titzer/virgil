class Point(x: int, y: int) {
	def sum() -> int {
		return x + y;
	}
}
class Point3 extends Point {
	def z: int;
	new(x: int, y: int, z) super(x, y) { }
	def sum() -> int {
		return x + y + z;
	}
}
component Util {
	def twice(a: int) -> int {
		return a * 2;
	}
}
type Shape {
	case Circle(r: int) {
		def area() -> int { return 3 * r * r; }
	}
	case Square(s: int) {
		def area() -> int { return s * s; }
	}
	def area() -> int;
}
def main() -> int {
	var p: Point = Point3.new(1, 2, 3);
	var s: Shape = Shape.Square(4);
	return Util.twice(p.sum()) + s.area();
}
