		t.check("pshufb", m, X86_64Assembler.pshufb_s_s(q, a, b));
		t.check("unpcklps", m, X86_64Assembler.unpcklps_s_s(q, a, b));
		t.check("ptest", m, X86_64Assembler.ptest_s_s(q, a, b));
		t.check("ucomisd", m, X86_64Assembler.ucomisd_s_s(q, a, b));
		t.check("ucomiss", m, X86_64Assembler.ucomiss_s_s(q, a, b));
		t.check("cvtss2sd", m, X86_64Assembler.cvtss2sd_s_s(q, a, b));
