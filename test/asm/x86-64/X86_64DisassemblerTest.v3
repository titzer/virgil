		t.check("pmuludq", m, X86_64Assembler.pmuludq_s_s(q, a, b));
		t.check("pmuldq", m, X86_64Assembler.pmuldq_s_s(q, a, b));
		t.check("pmulld", m, X86_64Assembler.pmulld_s_s(q, a, b));
		t.check("pmaddwd", m, X86_64Assembler.pmaddwd_s_s(q, a, b));
