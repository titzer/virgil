		t.check("cvtdq2pd", m, X86_64Assembler.cvtdq2pd_s_s(q, a, b));
		t.check("cvttpd2dq", m, X86_64Assembler.cvttpd2dq_s_s(q, a, b));
		t.check("pmovsxbw", m, X86_64Assembler.pmovsxbw_s_s(q, a, b));
		t.check("psllw", m, X86_64Assembler.psllw_s_s(q, a, b));
		t.check("psrad", m, X86_64Assembler.psrad_s_s(q, a, b));
	}
}

def test_sse_s_m(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	def O = X86_64Size.OWORD;
	for (a in XMMS) for (m in ADDRS) {
		t.check("movdqu", X86_64AddrMode.s_m(O, a, m), X86_64Assembler.movdqu_s_m(q, a, m));
		t.check("movdqu", X86_64AddrMode.m_s(O, m, a), X86_64Assembler.movdqu_m_s(q, m, a));
		t.check("movaps", X86_64AddrMode.s_m(O, a, m), X86_64Assembler.movaps_s_m(q, a, m));
		t.check("movss", X86_64AddrMode.s_m(D, a, m), X86_64Assembler.movss_s_m(q, a, m));
		t.check("movss", X86_64AddrMode.m_s(D, m, a), X86_64Assembler.movss_m_s(q, m, a));
		t.check("movsd", X86_64AddrMode.s_m(Q, a, m), X86_64Assembler.movsd_s_m(q, a, m));
		t.check("movsd", X86_64AddrMode.m_s(Q, m, a), X86_64Assembler.movsd_m_s(q, m, a));
		t.check("addsd", X86_64AddrMode.s_m(Q, a, m), X86_64Assembler.addsd_s_m(q, a, m));
		t.check("mulss", X86_64AddrMode.s_m(D, a, m), X86_64Assembler.mulss_s_m(q, a, m));
		t.check("pminsb", X86_64AddrMode.s_m(O, a, m), X86_64Assembler.pminsb_s_m(q, a, m));
		t.check("pabsb", X86_64AddrMode.s_m(O, a, m), X86_64Assembler.pabsb_s_m(q, a, m));
		t.check("xorps", X86_64AddrMode.s_m(O, a, m), X86_64Assembler.xorps_s_m(q, a, m));
		t.check("ucomisd", X86_64AddrMode.s_m(Q, a, m), X86_64Assembler.ucomisd_s_m(q, a, m));
		t.check("pmovsxbw", X86_64AddrMode.s_m(Q, a, m), X86_64Assembler.pmovsxbw_s_m(q, a, m));
	}
}

def test_sse_mixed(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	for (a in XMMS) for (b in GPRS) {
		t.check("movd", X86_64AddrMode.s_r(D, a, b), X86_64Assembler.movd_s_r(q, a, b));
		t.check("movd", X86_64AddrMode.r_s(D, b, a), X86_64Assembler.movd_r_s(q, b, a));
		t.check("movq", X86_64AddrMode.s_r(Q, a, b), X86_64Assembler.movq_s_r(q, a, b));
		t.check("movq", X86_64AddrMode.r_s(Q, b, a), X86_64Assembler.movq_r_s(q, b, a));
		t.check("movmskps", X86_64AddrMode.r_s(D, b, a), X86_64Assembler.movmskps_r_s(q, b, a));
		t.check("movmskpd", X86_64AddrMode.r_s(D, b, a), X86_64Assembler.movmskpd_r_s(q, b, a));
		t.check("pmovmskb", X86_64AddrMode.r_s(D, b, a), X86_64Assembler.pmovmskb_r_s(q, b, a));
		t.check("cvtsd2si", X86_64AddrMode.r_s(Q, b, a), X86_64Assembler.cvtsd2si_r_s(q, b, a));
		t.check("cvttsd2si", X86_64AddrMode.r_s(Q, b, a), X86_64Assembler.cvttsd2si_r_s(q, b, a));
		t.check("cvtsi2sd", X86_64AddrMode.s_r(Q, a, b), X86_64Assembler.cvtsi2sd_s_r(q, a, b));
		t.check("cvtsi2ss", X86_64AddrMode.s_r(Q, a, b), X86_64Assembler.cvtsi2ss_s_r(q, a, b));
	}
}

def test_sse_imm(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	for (a in XMMS) {
		for (i in [0, 1, 5, 31]) {
			t.check("psllw", X86_64AddrMode.s_i(a, byte.view(i)), X86_64Assembler.psllw_i(q, a, u5.view(i)));
			t.check("psrld", X86_64AddrMode.s_i(a, byte.view(i)), X86_64Assembler.psrld_i(q, a, u5.view(i)));
			t.check("psllq", X86_64AddrMode.s_i(a, byte.view(i)), X86_64Assembler.psllq_i(q, a, u6.view(i)));
			t.check("psraw", X86_64AddrMode.s_i(a, byte.view(i)), X86_64Assembler.psraw_i(q, a, u6.view(i)));
		}
		for (b in XMMS) {
			t.check("shufps", X86_64AddrMode.s_s_i(a, b, 0x1B), X86_64Assembler.shufps_s_s_i(q, a, b, 0x1B));
			t.check("pshufd", X86_64AddrMode.s_s_i(a, b, 0xE4), X86_64Assembler.pshufd_s_s_i(q, a, b, 0xE4));
			t.check("pshuflw", X86_64AddrMode.s_s_i(a, b, 0x27), X86_64Assembler.pshuflw_s_s_i(q, a, b, 0x27));
			t.check("pblendw", X86_64AddrMode.s_s_i(a, b, 0x5A), X86_64Assembler.pblendw_s_s_i(q, a, b, 0x5A));
			// only bits 0 and 4 of the immediate are defined, and each combination
			// has its own mnemonic
			t.check("pclmulhqhqdq", X86_64AddrMode.s_s(a, b), X86_64Assembler.pclmulqdq_s_s_imm(q, a, b, 0x11));
			t.check("pclmullqlqdq", X86_64AddrMode.s_s(a, b), X86_64Assembler.pclmulqdq_s_s_imm(q, a, b, 0x00));
			t.check("pclmulqdq", X86_64AddrMode.s_s_i(a, b, 0x77), X86_64Assembler.pclmulqdq_s_s_imm(q, a, b, 0x77));
			t.check("insertps", X86_64AddrMode.s_s_i(a, b, 0x10), X86_64Assembler.insertps_s_s_i(q, a, b, 0x10));
			t.check("roundsd", X86_64AddrMode.s_s_i(a, b, 3),
				X86_64Assembler.roundsd_s_s(q, a, b, X86_64Rounding.TO_ZERO));
			// the predicates of cmpps/cmpsd have their own mnemonics
			t.check("cmpltss", X86_64AddrMode.s_s(a, b), X86_64Assembler.cmpss_s_s(q, SSECmps.LT, a, b));
			t.check("cmpordpd", X86_64AddrMode.s_s(a, b), X86_64Assembler.cmppd_s_s(q, SSECmps.ORD, a, b));
		}
		for (b in GPRS) {
			t.check("pinsrb", X86_64AddrMode.s_r_i(D, a, b, 2), X86_64Assembler.pinsrb_s_r_i(q, a, b, 2));
			t.check("pinsrw", X86_64AddrMode.s_r_i(D, a, b, 3), X86_64Assembler.pinsrw_s_r_i(q, a, b, 3));
			t.check("pinsrd", X86_64AddrMode.s_r_i(D, a, b, 1), X86_64Assembler.pinsrd_s_r_i(q, a, b, 1));
			t.check("pinsrq", X86_64AddrMode.s_r_i(Q, a, b, 0), X86_64Assembler.pinsrq_s_r_i(q, a, b, 0));
			t.check("pextrb", X86_64AddrMode.r_s_i(D, b, a, 4), X86_64Assembler.pextrb_r_s_i(q, b, a, 4));
			t.check("pextrw", X86_64AddrMode.r_s_i(D, b, a, 5), X86_64Assembler.pextrw_r_s_i(q, b, a, 5));
			t.check("pextrd", X86_64AddrMode.r_s_i(D, b, a, 2), X86_64Assembler.pextrd_r_s_i(q, b, a, 2));
			t.check("pextrq", X86_64AddrMode.r_s_i(Q, b, a, 1), X86_64Assembler.pextrq_r_s_i(q, b, a, 1));
		}
		for (m in ADDRS) {
			t.check("pinsrq", X86_64AddrMode.s_m_i(Q, a, m, 1), X86_64Assembler.pinsrq_s_m_i(q, a, m, 1));
			t.check("pextrq", X86_64AddrMode.m_s_i(Q, m, a, 1), X86_64Assembler.pextrq_m_s_i(q, m, a, 1));
		}
	}
}

