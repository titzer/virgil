// Round-trip tests: every instruction is assembled with X86_64Assembler and then
// decoded with X86_64Disassembler, and the recovered mnemonic and operands are
// compared against what was requested. This checks that the two agree on the
// binary format. Agreement with the wider world is checked separately, by
// disasm-diff.py, which compares against binutils and NASM.

def data = DataWriter.new();

def T = UnitTests.registerT("disass:", _, X86_64DisassemblerTester.new, _);
def X_ = [
	T("nullary", test_nullary),
	T("intK", test_intK),
	T("alu_r_r", test_alu_r_r),
	T("alu_r_m", test_alu_r_m),
	T("alu_r_i", test_alu_r_i),
	T("mov_r_r", test_mov_r_r),
	T("mov_r_i", test_mov_r_i),
	T("mov_m", test_mov_m),
	T("movx", test_movx),
	T("unary", test_unary),
	T("shift", test_shift),
	T("addrmodes", test_addrmodes),
	T("cond", test_cond),
	T("branch", test_branch),
	T("sse_s_s", test_sse_s_s),
	T("sse_s_m", test_sse_s_m),
	T("sse_mixed", test_sse_mixed),
	T("sse_imm", test_sse_imm),
	T("x87", test_x87),
	T("prefixes", test_prefixes),
	()
];

def B = X86_64Size.BYTE;
def W = X86_64Size.WORD;
def D = X86_64Size.DWORD;
def Q = X86_64Size.QWORD;

def GPRS = X86_64Regs.GPRs;
def XMMS = X86_64Regs.XMMs;

class X86_64DisassemblerTester(t: Tester) extends X86_64DisVisitor {
	def asm = X86_64Assemblers.create64(data);
	var dis: X86_64Disassembler;
	var pos: int;

	var expected_name: string;
	var expected_mode: X86_64AddrMode;
	var visited: bool;

	new() {
		dis = X86_64Disassembler.new(this);
		// keep the canonical encoding of "mov reg, 0", which is otherwise
		// shortened to "xor reg, reg"
		asm.d.shorten = false;
		asm.q.shorten = false;
		pos = asm.pos();
	}

	// Decodes the instruction that the caller's argument just assembled and
	// compares it against the expected mnemonic and operands. The instruction is
	// passed as an already-evaluated argument, since Virgil evaluates arguments
	// before the call; its value is discarded.
	def check<R>(name: string, mode: X86_64AddrMode, assembled: R) {
		var bytes = asm.w.data[pos ... asm.pos()];
		pos = asm.pos();
		if (!t.ok || bytes.length == 0) return;
		expected_name = name;
		expected_mode = mode;
		visited = false;
		dis.reset(bytes);
		var ok = dis.disassemble();
		if (!ok) {
			t.fail(render_expected().puts("disassembler reported an error").toString());
			return;
		}
		if (!visited) {
			t.fail(render_expected().puts("disassembler reported nothing").toString());
			return;
		}
		if (dis.r.pos != bytes.length) {
			var buf = render_expected();
			buf.put2("consumed %d of %d bytes", dis.r.pos, bytes.length);
			t.fail(buf.toString());
		}
	}
	def visit(prefixes: X86_64Prefix.set, name: string, got: X86_64AddrMode) {
		visited = true;
		if (!Strings.equal(expected_name, name)) {
			t.fail(render_expected().put1("got instruction %s", name).toString());
			return;
		}
		// {X86_64Addr} is a class, so operands are compared by their rendering
		// rather than by identity.
		if (!Strings.equal(render(got), render(expected_mode))) {
			t.fail(render_expected().put1("got operands %q", got.render).toString());
		}
	}
	def unsupported(msg: string) {
		visited = true;
		t.fail(render_expected().put1("unsupported: %s", msg).toString());
	}
	def illegal(bytes: Range<byte>) {
		visited = true;
		t.fail(render_expected().puts("reported illegal").toString());
	}
	private def render(mode: X86_64AddrMode) -> string {
		return mode.render(StringBuilder.new()).toString();
	}
	def render_expected() -> StringBuilder {
		var buf = StringBuilder.new();
		buf.puts("expected ");
		for (b in dis.r.data) buf.putx_8(b).sp();
		buf.put2(" => %s %q, ", expected_name, expected_mode.render);
		return buf;
	}
}

//========================================================================================
// Instructions with no operands
//========================================================================================

def test_nullary(t: X86_64DisassemblerTester) {
	def none = X86_64AddrMode.none;
	def asm = t.asm;
	t.check("cdq", none, asm.cdq());
	t.check("cqo", none, asm.cqo());
	t.check("iret", none, asm.iret());
	t.check("pushfq", none, asm.pushfq());
	t.check("nop", none, asm.nop1());
	t.check("ret", none, asm.ret());
	t.check("scasb", none, asm.scasb());
	t.check("movsb", none, asm.movsb());
	t.check("syscall", none, asm.syscall());
	t.check("sysenter", none, asm.sysenter());
	t.check("sysexit", none, asm.sysexit());
	t.check("rdtsc", none, asm.rdtsc());
	t.check("mfence", none, asm.mfence());
	t.check("ud2", none, asm.invalid());
	t.check("nop", X86_64AddrMode.m(D, X86_64Regs.RAX.indirect()), asm.nop3());
}

def test_intK(t: X86_64DisassemblerTester) {
	for (i < 256) {
		var b = byte.view(i);
		t.check("int", X86_64AddrMode.imm_b(b), t.asm.intK(i));
	}
}

//========================================================================================
// Integer ALU
//========================================================================================

def test_alu_r_r(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) for (b in GPRS) {
		t.check("add", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.add_r_r(q, a, b));
		t.check("sub", X86_64AddrMode.r_r(D, a, b), X86_64Assembler.sub_r_r(d, a, b));
		t.check("cmp", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.cmp_r_r(q, a, b));
		t.check("test", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.test_r_r(q, a, b));
		t.check("xor", X86_64AddrMode.r_r(D, a, b), X86_64Assembler.xor_r_r(d, a, b));
		t.check("imul", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.imul_r_r(q, a, b));
		t.check("bsf", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.bsf_r_r(q, a, b));
		t.check("popcnt", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.popcnt_r_r(q, a, b));
		t.check("xadd", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.xadd_r_r(q, a, b));
	}
}

def test_alu_r_m(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) for (m in ADDRS) {
		t.check("add", X86_64AddrMode.r_m(Q, a, m), X86_64Assembler.add_r_m(q, a, m));
		t.check("or", X86_64AddrMode.m_r(D, m, a), X86_64Assembler.or_m_r(d, m, a));
		t.check("lea", X86_64AddrMode.r_m(Q, a, m), X86_64Assembler.lea(q, a, m));
		t.check("imul", X86_64AddrMode.r_m(Q, a, m), X86_64Assembler.imul_r_m(q, a, m));
		t.check("cmpxchg", X86_64AddrMode.m_r(Q, m, a), X86_64Assembler.cmpxchg_m_r(q, m, a));
	}
}

def test_alu_r_i(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) for (i in IMMS) {
		t.check("add", X86_64AddrMode.r_i(Q, a, i), X86_64Assembler.add_r_i(q, a, i));
		t.check("and", X86_64AddrMode.r_i(D, a, i), X86_64Assembler.and_r_i(d, a, i));
		t.check("cmp", X86_64AddrMode.r_i(Q, a, i), X86_64Assembler.cmp_r_i(q, a, i));
		t.check("test", X86_64AddrMode.r_i(Q, a, i), X86_64Assembler.test_r_i(q, a, i));
		t.check("imul", X86_64AddrMode.r_r_i(Q, a, a, i), X86_64Assembler.imul_r_i(q, a, i));
	}
	for (m in ADDRS) for (i in IMMS) {
		t.check("add", X86_64AddrMode.m_i(Q, m, i), X86_64Assembler.add_m_i(t.asm.q, m, i));
		t.check("xor", X86_64AddrMode.m_i(D, m, i), X86_64Assembler.xor_m_i(t.asm.d, m, i));
	}
}

def test_unary(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) {
		t.check("push", X86_64AddrMode.r(Q, a), X86_64Assembler.pushq_r(q, a));
		t.check("pop", X86_64AddrMode.r(Q, a), X86_64Assembler.popq_r(q, a));
		t.check("bswap", X86_64AddrMode.r(Q, a), X86_64Assembler.bswap_r(q, a));
		t.check("bswap", X86_64AddrMode.r(D, a), X86_64Assembler.bswap_r(d, a));
		t.check("inc", X86_64AddrMode.r(Q, a), X86_64Assembler.inc_r(q, a));
		t.check("dec", X86_64AddrMode.r(D, a), X86_64Assembler.dec_r(d, a));
		t.check("neg", X86_64AddrMode.r(Q, a), X86_64Assembler.neg_r(q, a));
		t.check("not", X86_64AddrMode.r(D, a), X86_64Assembler.not_r(d, a));
		t.check("mul", X86_64AddrMode.r(Q, a), X86_64Assembler.mul_r(q, a));
		t.check("imul", X86_64AddrMode.r(D, a), X86_64Assembler.imul_r(d, a));
		t.check("div", X86_64AddrMode.r(Q, a), X86_64Assembler.div_r(q, a));
		t.check("idiv", X86_64AddrMode.r(D, a), X86_64Assembler.idiv_r(d, a));
		t.check("jmp", X86_64AddrMode.r(Q, a), X86_64Assembler.ijmp_r(q, a));
		t.check("call", X86_64AddrMode.r(Q, a), X86_64Assembler.icall_r(q, a));
		t.check("rdfsbase", X86_64AddrMode.r(Q, a), X86_64Assembler.rdfsbase(q, a));
		t.check("wrgsbase", X86_64AddrMode.r(Q, a), X86_64Assembler.wrgsbase(q, a));
	}
	for (m in ADDRS) {
		t.check("inc", X86_64AddrMode.m(Q, m), X86_64Assembler.inc_m(q, m));
		t.check("dec", X86_64AddrMode.m(D, m), X86_64Assembler.dec_m(d, m));
		t.check("neg", X86_64AddrMode.m(B, m), X86_64Assembler.negb_m(q, m));
		t.check("neg", X86_64AddrMode.m(W, m), X86_64Assembler.negw_m(q, m));
		t.check("push", X86_64AddrMode.m(Q, m), X86_64Assembler.pushq_m(q, m));
		t.check("pop", X86_64AddrMode.m(Q, m), X86_64Assembler.popq_m(q, m));
		t.check("jmp", X86_64AddrMode.m(Q, m), X86_64Assembler.ijmp_m(q, m));
		t.check("call", X86_64AddrMode.m(Q, m), X86_64Assembler.icall_m(q, m));
		t.check("ldmxcsr", X86_64AddrMode.m(D, m), X86_64Assembler.ldmxcsr_m(q, m));
		t.check("stmxcsr", X86_64AddrMode.m(D, m), X86_64Assembler.stmxcsr_m(q, m));
	}
}

def test_shift(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) {
		t.check("shl", X86_64AddrMode.r_cl(Q, a), X86_64Assembler.shl_r_cl(q, a));
		t.check("sar", X86_64AddrMode.r_cl(D, a), X86_64Assembler.sar_r_cl(d, a));
		t.check("rol", X86_64AddrMode.r_cl(Q, a), X86_64Assembler.rol_r_cl(q, a));
		t.check("ror", X86_64AddrMode.r_cl(Q, a), X86_64Assembler.ror_r_cl(q, a));
		for (i in SHIFTS) {
			t.check("rol", X86_64AddrMode.r_i(Q, a, i), X86_64Assembler.rol_r_i(q, a, u6.view(i)));
			t.check("shr", X86_64AddrMode.r_i(D, a, i), X86_64Assembler.shr_r_i(d, a, u6.view(i)));
			t.check("sar", X86_64AddrMode.r_i(Q, a, i), X86_64Assembler.sar_r_i(q, a, u6.view(i)));
			t.check("btr", X86_64AddrMode.r_i(Q, a, i), X86_64Assembler.btr_r_i(q, a, u6.view(i)));
		}
	}
	for (m in ADDRS) {
		t.check("shl", X86_64AddrMode.m_cl(Q, m), X86_64Assembler.shl_m_cl(q, m));
		t.check("sar", X86_64AddrMode.m_i(Q, m, 5), X86_64Assembler.sar_m_i(q, m, 5));
		t.check("btr", X86_64AddrMode.m_i(Q, m, 33), X86_64Assembler.btr_m_i(q, m, 33));
	}
}

//========================================================================================
// Moves
//========================================================================================

def test_mov_r_r(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) for (b in GPRS) {
		t.check("mov", X86_64AddrMode.r_r(Q, a, b), X86_64Assembler.movq_r_r(q, a, b));
		t.check("mov", X86_64AddrMode.r_r(D, a, b), X86_64Assembler.movd_r_r(d, a, b));
		t.check("mov", X86_64AddrMode.r_r(W, a, b), X86_64Assembler.movw_r_r(q, a, b));
		t.check("mov", X86_64AddrMode.r_r(B, a, b), X86_64Assembler.movb_r_r(q, a, b));
		// xchg is symmetric, and its two encodings order the operands
		// differently: the one-byte 0x90+r form names rax first, while the
		// 0x87 form is "xchg r/m, r".
		var RAX = X86_64Regs.RAX;
		var xchg = if(a == RAX || b == RAX,
			X86_64AddrMode.r_r(Q, RAX, if(a == RAX, b, a)),
			X86_64AddrMode.r_r(Q, b, a));
		t.check("xchg", xchg, X86_64Assembler.xchg_r_r(q, a, b));
	}
}

def test_mov_r_i(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) {
		for (i in IMMS) {
			// a non-negative imm32 is emitted as the zero-extending B8+r form
			var mode = if(i >= 0, X86_64AddrMode.r_i(D, a, i), X86_64AddrMode.r_i(Q, a, i));
			t.check("mov", mode, X86_64Assembler.movq_r_i(q, a, i));
			t.check("mov", X86_64AddrMode.r_i(D, a, i), X86_64Assembler.movd_r_i(d, a, i));
			// an 8-bit immediate decodes sign-extended
			t.check("mov", X86_64AddrMode.r_i(B, a, i8.view(i)), X86_64Assembler.movb_r_i(q, a, i & 0xFF));
			t.check("mov", X86_64AddrMode.r_i(W, a, i16.view(i)), X86_64Assembler.movw_r_i(q, a, i & 0xFFFF));
		}
		t.check("movabs", X86_64AddrMode.r_l(Q, a, 0x1122334455667788),
			X86_64Assembler.movq_r_l(q, a, 0x1122334455667788));
	}
}

def test_mov_m(t: X86_64DisassemblerTester) {
	def q = t.asm.q, d = t.asm.d;
	for (a in GPRS) for (m in ADDRS) {
		t.check("mov", X86_64AddrMode.r_m(Q, a, m), X86_64Assembler.movq_r_m(q, a, m));
		t.check("mov", X86_64AddrMode.m_r(Q, m, a), X86_64Assembler.movq_m_r(q, m, a));
		t.check("mov", X86_64AddrMode.r_m(D, a, m), X86_64Assembler.movd_r_m(d, a, m));
		t.check("mov", X86_64AddrMode.m_r(B, m, a), X86_64Assembler.movb_m_r(q, m, a));
		t.check("mov", X86_64AddrMode.r_m(W, a, m), X86_64Assembler.movw_r_m(q, a, m));
	}
	for (m in ADDRS) {
		t.check("mov", X86_64AddrMode.m_i(Q, m, -3), X86_64Assembler.movq_m_i(q, m, -3));
		t.check("mov", X86_64AddrMode.m_i(D, m, 77), X86_64Assembler.movd_m_i(d, m, 77));
		t.check("mov", X86_64AddrMode.m_i(B, m, 7), X86_64Assembler.movb_m_i(q, m, 7));
		t.check("mov", X86_64AddrMode.m_i(W, m, 300), X86_64Assembler.movw_m_i(q, m, 300));
	}
}

def test_movx(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	for (a in GPRS) for (b in GPRS) {
		t.check("movsx", X86_64AddrMode.r_r2(Q, a, B, b), X86_64Assembler.movbsx_r_r(q, a, b));
		t.check("movzx", X86_64AddrMode.r_r2(Q, a, B, b), X86_64Assembler.movbzx_r_r(q, a, b));
		t.check("movsx", X86_64AddrMode.r_r2(Q, a, W, b), X86_64Assembler.movwsx_r_r(q, a, b));
		t.check("movzx", X86_64AddrMode.r_r2(Q, a, W, b), X86_64Assembler.movwzx_r_r(q, a, b));
	}
	for (a in GPRS) for (m in ADDRS) {
		t.check("movsx", X86_64AddrMode.r_m2(Q, a, B, m), X86_64Assembler.movbsx_r_m(q, a, m));
		t.check("movzx", X86_64AddrMode.r_m2(Q, a, W, m), X86_64Assembler.movwzx_r_m(q, a, m));
	}
}

//========================================================================================
// Addressing modes
//========================================================================================

def test_addrmodes(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	// Every base register, including the ones that force a SIB byte or a disp8.
	for (base in GPRS) {
		for (disp in DISPS) {
			var m = base.plus(disp);
			t.check("mov", X86_64AddrMode.r_m(Q, X86_64Regs.RAX, m),
				X86_64Assembler.movq_r_m(q, X86_64Regs.RAX, m));
		}
		// Every index register and scale.
		for (index in GPRS) {
			if (index == X86_64Regs.RSP) continue;	// rsp cannot be an index
			for (scale in SCALES) {
				var m = base.plusR(index, scale, 0x40);
				t.check("mov", X86_64AddrMode.r_m(Q, X86_64Regs.RCX, m),
					X86_64Assembler.movq_r_m(q, X86_64Regs.RCX, m));
			}
		}
	}
	// An absolute address, which the assembler encodes with a SIB byte and no base.
	var abs = X86_64Addr.new(null, null, 1, 0x4000);
	t.check("mov", X86_64AddrMode.r_m(Q, X86_64Regs.RAX, abs),
		X86_64Assembler.movq_r_m(q, X86_64Regs.RAX, abs));
}

//========================================================================================
// Conditionals and branches
//========================================================================================

def test_cond(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	for (i < X86_64Conds.all.length) {
		var c = X86_64Conds.all[i];
		for (a in GPRS) {
			t.check(SETCC_NAMES[i], X86_64AddrMode.r(B, a), X86_64Assembler.set_r(q, c, a));
			for (b in GPRS) {
				t.check(CMOVCC_NAMES[i], X86_64AddrMode.r_r(Q, a, b),
					X86_64Assembler.cmov_r(q, c, a, b));
			}
		}
		for (m in ADDRS) {
			t.check(SETCC_NAMES[i], X86_64AddrMode.m(B, m), X86_64Assembler.set_m(q, c, m));
			t.check(CMOVCC_NAMES[i], X86_64AddrMode.r_m(Q, X86_64Regs.RAX, m),
				X86_64Assembler.cmov_m(q, c, X86_64Regs.RAX, m));
		}
	}
}

def test_branch(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	// {jc_rel} and {jmp_rel_raw} take an offset relative to the start of the
	// instruction; the encoding, and therefore the disassembler, is relative to
	// the end. Only the far forms have a predictable length.
	for (off in [1000, -1000, 0x40000, -0x40000]) {
		t.check("call", X86_64AddrMode.rel(off), X86_64Assembler.callr(q, off));
		t.check("jmp", X86_64AddrMode.rel(off - 5), X86_64Assembler.jmp_rel_raw(q, off));
		for (i < X86_64Conds.all.length) {
			t.check(JCC_NAMES[i], X86_64AddrMode.rel(off - 6),
				X86_64Assembler.jc_rel(q, X86_64Conds.all[i], off));
		}
	}
	for (i in [0, 1, -1, 1000, -1000]) {
		t.check("push", X86_64AddrMode.imm_i(i), X86_64Assembler.pushq_i(q, i));
	}
}

//========================================================================================
// SSE
//========================================================================================

def test_sse_s_s(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	for (a in XMMS) for (b in XMMS) {
		var m = X86_64AddrMode.s_s(a, b);
		t.check("movaps", m, X86_64Assembler.movaps_s_s(q, a, b));
		t.check("movss", m, X86_64Assembler.movss_s_s(q, a, b));
		t.check("movsd", m, X86_64Assembler.movsd_s_s(q, a, b));
		t.check("movhlps", m, X86_64Assembler.movhlps_s_s(q, a, b));
		t.check("movlhps", m, X86_64Assembler.movlhps_s_s(q, a, b));
		t.check("movddup", m, X86_64Assembler.movddup_s_s(q, a, b));
		t.check("movshdup", m, X86_64Assembler.movshdup_s_s(q, a, b));
		t.check("addss", m, X86_64Assembler.addss_s_s(q, a, b));
		t.check("addsd", m, X86_64Assembler.addsd_s_s(q, a, b));
		t.check("addps", m, X86_64Assembler.addps_s_s(q, a, b));
		t.check("addpd", m, X86_64Assembler.addpd_s_s(q, a, b));
		t.check("subss", m, X86_64Assembler.subss_s_s(q, a, b));
		t.check("mulsd", m, X86_64Assembler.mulsd_s_s(q, a, b));
		t.check("divps", m, X86_64Assembler.divps_s_s(q, a, b));
		t.check("minsd", m, X86_64Assembler.minsd_s_s(q, a, b));
		t.check("maxps", m, X86_64Assembler.maxps_s_s(q, a, b));
		t.check("sqrtsd", m, X86_64Assembler.sqrtsd_s_s(q, a, b));
		t.check("andps", m, X86_64Assembler.andps_s_s(q, a, b));
		t.check("andnpd", m, X86_64Assembler.andnpd_s_s(q, a, b));
		t.check("orps", m, X86_64Assembler.orps_s_s(q, a, b));
		t.check("xorpd", m, X86_64Assembler.xorpd_s_s(q, a, b));
