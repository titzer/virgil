		t.check("pmaxud", m, X86_64Assembler.pmaxud_s_s(q, a, b));
		t.check("pavgb", m, X86_64Assembler.pavgb_s_s(q, a, b));
		t.check("pabsd", m, X86_64Assembler.pabsd_s_s(q, a, b));
		t.check("packuswb", m, X86_64Assembler.packuswb_s_s(q, a, b));
		t.check("packusdw", m, X86_64Assembler.packusdw_s_s(q, a, b));
