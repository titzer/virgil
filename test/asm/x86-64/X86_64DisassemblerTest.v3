def test_x87(t: X86_64DisassemblerTester) {
	def q = t.asm.q;
	for (m in ADDRS) {
		t.check("fadd", X86_64AddrMode.m(D, m), X86_64Assembler.faddd(q, m));
		t.check("fld", X86_64AddrMode.m(D, m), X86_64Assembler.fldd(q, m));
		t.check("fld", X86_64AddrMode.m(Q, m), X86_64Assembler.fldq(q, m));
		t.check("fild", X86_64AddrMode.m(Q, m), X86_64Assembler.fildq(q, m));
		t.check("fstp", X86_64AddrMode.m(D, m), X86_64Assembler.fstpd(q, m));
		t.check("fstp", X86_64AddrMode.m(Q, m), X86_64Assembler.fstpq(q, m));
		t.check("fisttp", X86_64AddrMode.m(Q, m), X86_64Assembler.fisttpq(q, m));
	}
}

//========================================================================================
// Prefixes
//========================================================================================

def test_prefixes(t: X86_64DisassemblerTester) {
	// A lock prefix is reported alongside the instruction it applies to.
	var before = t.asm.pos();
	t.asm.lock();
	X86_64Assembler.add_m_r(t.asm.q, ADDRS[0], X86_64Regs.RAX);
	var bytes = t.asm.w.data[before ... t.asm.pos()];
	t.pos = t.asm.pos();

	var saw = PrefixChecker.new();
	var d = X86_64Disassembler.new(saw);
	d.reset(bytes);
	if (!d.disassemble()) {
		t.t.fail("lock-prefixed instruction failed to decode");
	} else if (!saw.prefixes.LOCK) {
		t.t.fail("expected a LOCK prefix");
	} else if (!Strings.equal(saw.name, "add")) {
		t.t.fail("expected a lock-prefixed add");
	}
}

class PrefixChecker extends X86_64DisVisitor {
	var prefixes: X86_64Prefix.set;
	var name: string;
	def visit(p: X86_64Prefix.set, n: string, mode: X86_64AddrMode) {
		prefixes = p;
		name = n;
	}
}

//========================================================================================
// Shared operand pools
//========================================================================================

def ADDRS = [
	X86_64Regs.RAX.indirect(),
	X86_64Regs.RSP.indirect(),			// requires a SIB byte
	X86_64Regs.RBP.indirect(),			// requires a disp8 of zero
	X86_64Regs.R12.indirect(),			// requires a SIB byte
	X86_64Regs.R13.indirect(),			// requires a disp8 of zero
	X86_64Regs.RCX.plus(0x10),
	X86_64Regs.RDI.plus(-1),
	X86_64Regs.RBX.plus(0x12345),
	X86_64Regs.RCX.plusR(X86_64Regs.RDX, 4, 0x20),
	X86_64Regs.RBP.plusR(X86_64Regs.R13, 8, -0x100),
	X86_64Regs.R12.plusR(X86_64Regs.R15, 2, 0)
];
def IMMS = [0, 1, -1, 127, -128, 128, -129, 0x1234, -0x12345678, 0x7FFFFFFF];
def SHIFTS = [0, 1, 2, 31, 63];
def DISPS = [0, 1, -1, 127, -128, 128, -129, 0x12345678];
def SCALES: Array<byte> = [1, 2, 4, 8];

def SETCC_NAMES = [
	"seto", "setno", "setb", "setae", "sete", "setne", "setbe", "seta",
	"sets", "setns", "setp", "setnp", "setl", "setge", "setle", "setg"
];
def CMOVCC_NAMES = [
	"cmovo", "cmovno", "cmovb", "cmovae", "cmove", "cmovne", "cmovbe", "cmova",
	"cmovs", "cmovns", "cmovp", "cmovnp", "cmovl", "cmovge", "cmovle", "cmovg"
];
def JCC_NAMES = [
	"jo", "jno", "jb", "jae", "je", "jne", "jbe", "ja",
	"js", "jns", "jp", "jnp", "jl", "jge", "jle", "jg"
];

def main(args: Array<string>) -> int {
	return UnitTests.run(args);
}
