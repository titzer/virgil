def test_fp_cvt() {
	gen_xy_rm("fcvt.s.d", asm.fcvt_s_d, FPRS, FPRS, fprName, fprName);
	gen_xy("fcvt.d.s", asm.fcvt_d_s, FPRS, FPRS, fprName, fprName);
	gen_xy_rm("fcvt.w.s", asm.fcvt_w_s, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.wu.s", asm.fcvt_wu_s, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.l.s", asm.fcvt_l_s, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.lu.s", asm.fcvt_lu_s, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.w.d", asm.fcvt_w_d, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.wu.d", asm.fcvt_wu_d, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.l.d", asm.fcvt_l_d, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.lu.d", asm.fcvt_lu_d, GPRS, FPRS, gprName, fprName);
	gen_xy_rm("fcvt.s.w", asm.fcvt_s_w, FPRS, GPRS, fprName, gprName);
	gen_xy_rm("fcvt.s.wu", asm.fcvt_s_wu, FPRS, GPRS, fprName, gprName);
	gen_xy_rm("fcvt.s.l", asm.fcvt_s_l, FPRS, GPRS, fprName, gprName);
	gen_xy_rm("fcvt.s.lu", asm.fcvt_s_lu, FPRS, GPRS, fprName, gprName);
	gen_xy("fcvt.d.w", asm.fcvt_d_w, FPRS, GPRS, fprName, gprName);
	gen_xy("fcvt.d.wu", asm.fcvt_d_wu, FPRS, GPRS, fprName, gprName);
	gen_xy_rm("fcvt.d.l", asm.fcvt_d_l, FPRS, GPRS, fprName, gprName);
	gen_xy_rm("fcvt.d.lu", asm.fcvt_d_lu, FPRS, GPRS, fprName, gprName);
}
def test_pseudo() {
	gen_xy("mv", asm.mv, GPRS, GPRS, gprName, gprName);
	gen_xy("not", asm.not, GPRS, GPRS, gprName, gprName);
	gen_xy("neg", asm.neg, GPRS, GPRS, gprName, gprName);
	gen_xy("negw", asm.negw, GPRS, GPRS, gprName, gprName);
	gen_xy("sext.w", asm.sext_w, GPRS, GPRS, gprName, gprName);
	gen_xy("seqz", asm.seqz, GPRS, GPRS, gprName, gprName);
	gen_xy("snez", asm.snez, GPRS, GPRS, gprName, gprName);
	gen_xy("sltz", asm.sltz, GPRS, GPRS, gprName, gprName);
	gen_xy("sgtz", asm.sgtz, GPRS, GPRS, gprName, gprName);
	gen_xy("fmv.s", asm.fmv_s, FPRS, FPRS, fprName, fprName);
	gen_xy("fmv.d", asm.fmv_d, FPRS, FPRS, fprName, fprName);
	gen_xy("fneg.s", asm.fneg_s, FPRS, FPRS, fprName, fprName);
	gen_xy("fneg.d", asm.fneg_d, FPRS, FPRS, fprName, fprName);
	gen_xy("fabs.s", asm.fabs_s, FPRS, FPRS, fprName, fprName);
	gen_xy("fabs.d", asm.fabs_d, FPRS, FPRS, fprName, fprName);
	gen_bz("beqz", asm.beqz);	gen_bz("bnez", asm.bnez);
	gen_bz("blez", asm.blez);	gen_bz("bgez", asm.bgez);
	gen_bz("bltz", asm.bltz);	gen_bz("bgtz", asm.bgtz);
	if (!skip("j")) for (imm in IMM21) { asm.j(imm); buf.puts("j "); pcrel(int.view(imm)); line(); }
	if (!skip("jr")) for (rs in GPRS) { asm.jr(rs); buf.puts("jr ").puts(rs.name); line(); }
	if (!skip("ret")) { asm.ret(); buf.puts("ret"); line(); }
	if (!skip("nop")) { asm.nop(); buf.puts("nop"); line(); }
	gen_r1("frflags", asm.frflags);	gen_r1("fsflags", asm.fsflags);
	gen_r1("frrm", asm.frrm);	gen_r1("fsrm", asm.fsrm);
}
def gen_bz(name: string, f: (RiscV64Gpr, i13) -> RiscV64Assembler) {
	if (skip(name)) return;
	for (rs in GPRS) { f(rs, IMM13[1]); buf.puts(name).puts(" ").puts(rs.name).puts(", "); pcrel(int.view(IMM13[1])); line(); }
	for (imm in IMM13) { f(R.A0, imm); buf.puts(name).puts(" a0, "); pcrel(int.view(imm)); line(); }
}
def gen_r1(name: string, f: RiscV64Gpr -> RiscV64Assembler) {
	if (skip(name)) return;
	for (r in GPRS) { f(r); buf.puts(name).puts(" ").puts(r.name); line(); }
}
