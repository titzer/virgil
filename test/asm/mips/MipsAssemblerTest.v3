	T(0x39281234u, asm.xori(R8, R9, 0x1234));
	T(0x383F0000u, asm.xori(R31, R1, 0x0000));
	T(0x383F0001u, asm.xori(R31, R1, 0x0001));
	T(0x383FFFFFu, asm.xori(R31, R1, 0xFFFF));
	T(0x383F8000u, asm.xori(R31, R1, 0x8000));
	T(0x383F1234u, asm.xori(R31, R1, 0x1234));
	T(0x3BE10000u, asm.xori(R1, R31, 0x0000));
	T(0x3BE10001u, asm.xori(R1, R31, 0x0001));
	T(0x3BE1FFFFu, asm.xori(R1, R31, 0xFFFF));
	T(0x3BE18000u, asm.xori(R1, R31, 0x8000));
	T(0x3BE11234u, asm.xori(R1, R31, 0x1234));
	T(0x2C000000u, asm.sltiu(R0, R0, 0x0000));
	T(0x2C000001u, asm.sltiu(R0, R0, 0x0001));
	T(0x2C00FFFFu, asm.sltiu(R0, R0, 0xFFFF));
	T(0x2C008000u, asm.sltiu(R0, R0, 0x8000));
	T(0x2C001234u, asm.sltiu(R0, R0, 0x1234));
	T(0x2D280000u, asm.sltiu(R8, R9, 0x0000));
	T(0x2D280001u, asm.sltiu(R8, R9, 0x0001));
	T(0x2D28FFFFu, asm.sltiu(R8, R9, 0xFFFF));
	T(0x2D288000u, asm.sltiu(R8, R9, 0x8000));
	T(0x2D281234u, asm.sltiu(R8, R9, 0x1234));
	T(0x2C3F0000u, asm.sltiu(R31, R1, 0x0000));
	T(0x2C3F0001u, asm.sltiu(R31, R1, 0x0001));
	T(0x2C3FFFFFu, asm.sltiu(R31, R1, 0xFFFF));
	T(0x2C3F8000u, asm.sltiu(R31, R1, 0x8000));
	T(0x2C3F1234u, asm.sltiu(R31, R1, 0x1234));
	T(0x2FE10000u, asm.sltiu(R1, R31, 0x0000));
	T(0x2FE10001u, asm.sltiu(R1, R31, 0x0001));
	T(0x2FE1FFFFu, asm.sltiu(R1, R31, 0xFFFF));
	T(0x2FE18000u, asm.sltiu(R1, R31, 0x8000));
	T(0x2FE11234u, asm.sltiu(R1, R31, 0x1234));
}

def test_imm_s(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x20000000u, asm.addi(R0, R0, 0));
	T(0x20000001u, asm.addi(R0, R0, 1));
	T(0x20007FFFu, asm.addi(R0, R0, 32767));
	T(0x2000FFFFu, asm.addi(R0, R0, -1));
	T(0x20008000u, asm.addi(R0, R0, -32768));
	T(0x20001234u, asm.addi(R0, R0, 4660));
	T(0x21280000u, asm.addi(R8, R9, 0));
	T(0x21280001u, asm.addi(R8, R9, 1));
	T(0x21287FFFu, asm.addi(R8, R9, 32767));
	T(0x2128FFFFu, asm.addi(R8, R9, -1));
	T(0x21288000u, asm.addi(R8, R9, -32768));
	T(0x21281234u, asm.addi(R8, R9, 4660));
	T(0x203F0000u, asm.addi(R31, R1, 0));
	T(0x203F0001u, asm.addi(R31, R1, 1));
	T(0x203F7FFFu, asm.addi(R31, R1, 32767));
	T(0x203FFFFFu, asm.addi(R31, R1, -1));
	T(0x203F8000u, asm.addi(R31, R1, -32768));
	T(0x203F1234u, asm.addi(R31, R1, 4660));
	T(0x23E10000u, asm.addi(R1, R31, 0));
	T(0x23E10001u, asm.addi(R1, R31, 1));
	T(0x23E17FFFu, asm.addi(R1, R31, 32767));
	T(0x23E1FFFFu, asm.addi(R1, R31, -1));
	T(0x23E18000u, asm.addi(R1, R31, -32768));
	T(0x23E11234u, asm.addi(R1, R31, 4660));
	T(0x28000000u, asm.slti(R0, R0, 0));
	T(0x28000001u, asm.slti(R0, R0, 1));
	T(0x28007FFFu, asm.slti(R0, R0, 32767));
	T(0x2800FFFFu, asm.slti(R0, R0, -1));
	T(0x28008000u, asm.slti(R0, R0, -32768));
	T(0x28001234u, asm.slti(R0, R0, 4660));
	T(0x29280000u, asm.slti(R8, R9, 0));
	T(0x29280001u, asm.slti(R8, R9, 1));
	T(0x29287FFFu, asm.slti(R8, R9, 32767));
	T(0x2928FFFFu, asm.slti(R8, R9, -1));
	T(0x29288000u, asm.slti(R8, R9, -32768));
	T(0x29281234u, asm.slti(R8, R9, 4660));
	T(0x283F0000u, asm.slti(R31, R1, 0));
	T(0x283F0001u, asm.slti(R31, R1, 1));
	T(0x283F7FFFu, asm.slti(R31, R1, 32767));
	T(0x283FFFFFu, asm.slti(R31, R1, -1));
	T(0x283F8000u, asm.slti(R31, R1, -32768));
	T(0x283F1234u, asm.slti(R31, R1, 4660));
	T(0x2BE10000u, asm.slti(R1, R31, 0));
	T(0x2BE10001u, asm.slti(R1, R31, 1));
	T(0x2BE17FFFu, asm.slti(R1, R31, 32767));
	T(0x2BE1FFFFu, asm.slti(R1, R31, -1));
	T(0x2BE18000u, asm.slti(R1, R31, -32768));
	T(0x2BE11234u, asm.slti(R1, R31, 4660));
	T(0x3C000000u, asm.lui(R0, 0x0000));
	T(0x3C000001u, asm.lui(R0, 0x0001));
	T(0x3C00FFFFu, asm.lui(R0, 0xFFFF));
	T(0x3C008000u, asm.lui(R0, 0x8000));
	T(0x3C001234u, asm.lui(R0, 0x1234));
	T(0x3C010000u, asm.lui(R1, 0x0000));
	T(0x3C010001u, asm.lui(R1, 0x0001));
	T(0x3C01FFFFu, asm.lui(R1, 0xFFFF));
	T(0x3C018000u, asm.lui(R1, 0x8000));
	T(0x3C011234u, asm.lui(R1, 0x1234));
	T(0x3C080000u, asm.lui(R8, 0x0000));
	T(0x3C080001u, asm.lui(R8, 0x0001));
	T(0x3C08FFFFu, asm.lui(R8, 0xFFFF));
	T(0x3C088000u, asm.lui(R8, 0x8000));
	T(0x3C081234u, asm.lui(R8, 0x1234));
	T(0x3C0F0000u, asm.lui(R15, 0x0000));
	T(0x3C0F0001u, asm.lui(R15, 0x0001));
	T(0x3C0FFFFFu, asm.lui(R15, 0xFFFF));
	T(0x3C0F8000u, asm.lui(R15, 0x8000));
	T(0x3C0F1234u, asm.lui(R15, 0x1234));
	T(0x3C100000u, asm.lui(R16, 0x0000));
	T(0x3C100001u, asm.lui(R16, 0x0001));
	T(0x3C10FFFFu, asm.lui(R16, 0xFFFF));
	T(0x3C108000u, asm.lui(R16, 0x8000));
	T(0x3C101234u, asm.lui(R16, 0x1234));
	T(0x3C1F0000u, asm.lui(R31, 0x0000));
	T(0x3C1F0001u, asm.lui(R31, 0x0001));
	T(0x3C1FFFFFu, asm.lui(R31, 0xFFFF));
	T(0x3C1F8000u, asm.lui(R31, 0x8000));
	T(0x3C1F1234u, asm.lui(R31, 0x1234));
}

def test_shift(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x00000000u, asm.sll(R0, R0, 0));
	T(0x00000040u, asm.sll(R0, R0, 1));
	T(0x000001C0u, asm.sll(R0, R0, 7));
	T(0x000007C0u, asm.sll(R0, R0, 31));
	T(0x00094000u, asm.sll(R8, R9, 0));
	T(0x00094040u, asm.sll(R8, R9, 1));
	T(0x000941C0u, asm.sll(R8, R9, 7));
	T(0x000947C0u, asm.sll(R8, R9, 31));
	T(0x0001F800u, asm.sll(R31, R1, 0));
	T(0x0001F840u, asm.sll(R31, R1, 1));
	T(0x0001F9C0u, asm.sll(R31, R1, 7));
	T(0x0001FFC0u, asm.sll(R31, R1, 31));
	T(0x001F0800u, asm.sll(R1, R31, 0));
	T(0x001F0840u, asm.sll(R1, R31, 1));
	T(0x001F09C0u, asm.sll(R1, R31, 7));
