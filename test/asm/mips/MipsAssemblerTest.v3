// Checks every MipsAssembler instruction against encodings from the MIPS32 manual.
def T = UnitTests.registerT("mips:", _, MipsTester.new, _);
def X_ = void(
	T("r3", test_r3),
	T("imm_u", test_imm_u),
	T("imm_s", test_imm_s),
	T("shift", test_shift),
	T("muldiv", test_muldiv),
	T("jump", test_jump),
	T("branch2", test_branch2),
	T("branch1", test_branch1),
	T("regimm", test_regimm),
	T("trap", test_trap),
	T("ldst", test_ldst),
	T("move", test_move),

	()
);

class MipsTester(t: Tester) {
	def w = DataWriter.new();
	def asm = MipsAssembler.new(w);
	// {v} is the (void) result of an assembler call that wrote one instruction at offset 0.
	def check(expected: u32, v: void) {
		var d = w.data;
		t.assert_eq(expected, u32.pack<(byte, byte, byte, byte)>((d[0], d[1], d[2], d[3])));
		w.at(0);
	}
}

def R0 = MipsReg.R0;
def R1 = MipsReg.R1;
def R2 = MipsReg.R2;
def R3 = MipsReg.R3;
def R4 = MipsReg.R4;
def R5 = MipsReg.R5;
def R6 = MipsReg.R6;
def R7 = MipsReg.R7;
def R8 = MipsReg.R8;
def R9 = MipsReg.R9;
def R10 = MipsReg.R10;
def R11 = MipsReg.R11;
def R12 = MipsReg.R12;
def R13 = MipsReg.R13;
def R14 = MipsReg.R14;
def R15 = MipsReg.R15;
def R16 = MipsReg.R16;
def R17 = MipsReg.R17;
def R18 = MipsReg.R18;
def R19 = MipsReg.R19;
def R20 = MipsReg.R20;
def R21 = MipsReg.R21;
def R22 = MipsReg.R22;
def R23 = MipsReg.R23;
def R24 = MipsReg.R24;
def R25 = MipsReg.R25;
def R26 = MipsReg.R26;
def R27 = MipsReg.R27;
def R28 = MipsReg.R28;
def R29 = MipsReg.R29;
def R30 = MipsReg.R30;
def R31 = MipsReg.R31;

def test_r3(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x00000020u, asm.add(R0, R0, R0));
	T(0x00430820u, asm.add(R1, R2, R3));
	T(0x012A4020u, asm.add(R8, R9, R10));
	T(0x03FFF820u, asm.add(R31, R31, R31));
	T(0x02017820u, asm.add(R15, R16, R1));
	T(0x01FF8020u, asm.add(R16, R15, R31));
	T(0x00000021u, asm.addu(R0, R0, R0));
	T(0x00430821u, asm.addu(R1, R2, R3));
	T(0x012A4021u, asm.addu(R8, R9, R10));
	T(0x03FFF821u, asm.addu(R31, R31, R31));
	T(0x02017821u, asm.addu(R15, R16, R1));
	T(0x01FF8021u, asm.addu(R16, R15, R31));
	T(0x00000024u, asm.and(R0, R0, R0));
	T(0x00430824u, asm.and(R1, R2, R3));
	T(0x012A4024u, asm.and(R8, R9, R10));
	T(0x03FFF824u, asm.and(R31, R31, R31));
	T(0x02017824u, asm.and(R15, R16, R1));
	T(0x01FF8024u, asm.and(R16, R15, R31));
	T(0x00000025u, asm.or(R0, R0, R0));
	T(0x00430825u, asm.or(R1, R2, R3));
	T(0x012A4025u, asm.or(R8, R9, R10));
	T(0x03FFF825u, asm.or(R31, R31, R31));
	T(0x02017825u, asm.or(R15, R16, R1));
	T(0x01FF8025u, asm.or(R16, R15, R31));
	T(0x00000026u, asm.xor(R0, R0, R0));
	T(0x00430826u, asm.xor(R1, R2, R3));
	T(0x012A4026u, asm.xor(R8, R9, R10));
	T(0x03FFF826u, asm.xor(R31, R31, R31));
	T(0x02017826u, asm.xor(R15, R16, R1));
	T(0x01FF8026u, asm.xor(R16, R15, R31));
	T(0x00000022u, asm.sub(R0, R0, R0));
	T(0x00430822u, asm.sub(R1, R2, R3));
	T(0x012A4022u, asm.sub(R8, R9, R10));
	T(0x03FFF822u, asm.sub(R31, R31, R31));
	T(0x02017822u, asm.sub(R15, R16, R1));
	T(0x01FF8022u, asm.sub(R16, R15, R31));
	T(0x00000023u, asm.subu(R0, R0, R0));
	T(0x00430823u, asm.subu(R1, R2, R3));
	T(0x012A4023u, asm.subu(R8, R9, R10));
	T(0x03FFF823u, asm.subu(R31, R31, R31));
	T(0x02017823u, asm.subu(R15, R16, R1));
	T(0x01FF8023u, asm.subu(R16, R15, R31));
	T(0x0000002Au, asm.slt(R0, R0, R0));
	T(0x0043082Au, asm.slt(R1, R2, R3));
	T(0x012A402Au, asm.slt(R8, R9, R10));
	T(0x03FFF82Au, asm.slt(R31, R31, R31));
	T(0x0201782Au, asm.slt(R15, R16, R1));
	T(0x01FF802Au, asm.slt(R16, R15, R31));
	T(0x0000002Bu, asm.sltu(R0, R0, R0));
	T(0x0043082Bu, asm.sltu(R1, R2, R3));
	T(0x012A402Bu, asm.sltu(R8, R9, R10));
	T(0x03FFF82Bu, asm.sltu(R31, R31, R31));
	T(0x0201782Bu, asm.sltu(R15, R16, R1));
	T(0x01FF802Bu, asm.sltu(R16, R15, R31));
	T(0x00000004u, asm.sllv(R0, R0, R0));
	T(0x00430804u, asm.sllv(R1, R2, R3));
	T(0x012A4004u, asm.sllv(R8, R9, R10));
	T(0x03FFF804u, asm.sllv(R31, R31, R31));
	T(0x02017804u, asm.sllv(R15, R16, R1));
	T(0x01FF8004u, asm.sllv(R16, R15, R31));
	T(0x00000006u, asm.srlv(R0, R0, R0));
	T(0x00430806u, asm.srlv(R1, R2, R3));
	T(0x012A4006u, asm.srlv(R8, R9, R10));
	T(0x03FFF806u, asm.srlv(R31, R31, R31));
	T(0x02017806u, asm.srlv(R15, R16, R1));
	T(0x01FF8006u, asm.srlv(R16, R15, R31));
	T(0x00000007u, asm.srav(R0, R0, R0));
	T(0x00430807u, asm.srav(R1, R2, R3));
	T(0x012A4007u, asm.srav(R8, R9, R10));
	T(0x03FFF807u, asm.srav(R31, R31, R31));
	T(0x02017807u, asm.srav(R15, R16, R1));
	T(0x01FF8007u, asm.srav(R16, R15, R31));
}

def test_imm_u(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x24000000u, asm.addiu(R0, R0, 0x0000));
	T(0x24000001u, asm.addiu(R0, R0, 0x0001));
	T(0x2400FFFFu, asm.addiu(R0, R0, 0xFFFF));
	T(0x24008000u, asm.addiu(R0, R0, 0x8000));
	T(0x24001234u, asm.addiu(R0, R0, 0x1234));
	T(0x25280000u, asm.addiu(R8, R9, 0x0000));
	T(0x25280001u, asm.addiu(R8, R9, 0x0001));
	T(0x2528FFFFu, asm.addiu(R8, R9, 0xFFFF));
	T(0x25288000u, asm.addiu(R8, R9, 0x8000));
	T(0x25281234u, asm.addiu(R8, R9, 0x1234));
	T(0x243F0000u, asm.addiu(R31, R1, 0x0000));
	T(0x243F0001u, asm.addiu(R31, R1, 0x0001));
	T(0x243FFFFFu, asm.addiu(R31, R1, 0xFFFF));
	T(0x243F8000u, asm.addiu(R31, R1, 0x8000));
	T(0x243F1234u, asm.addiu(R31, R1, 0x1234));
	T(0x27E10000u, asm.addiu(R1, R31, 0x0000));
	T(0x27E10001u, asm.addiu(R1, R31, 0x0001));
	T(0x27E1FFFFu, asm.addiu(R1, R31, 0xFFFF));
	T(0x27E18000u, asm.addiu(R1, R31, 0x8000));
	T(0x27E11234u, asm.addiu(R1, R31, 0x1234));
	T(0x30000000u, asm.andi(R0, R0, 0x0000));
	T(0x30000001u, asm.andi(R0, R0, 0x0001));
	T(0x3000FFFFu, asm.andi(R0, R0, 0xFFFF));
	T(0x30008000u, asm.andi(R0, R0, 0x8000));
	T(0x30001234u, asm.andi(R0, R0, 0x1234));
	T(0x31280000u, asm.andi(R8, R9, 0x0000));
	T(0x31280001u, asm.andi(R8, R9, 0x0001));
	T(0x3128FFFFu, asm.andi(R8, R9, 0xFFFF));
	T(0x31288000u, asm.andi(R8, R9, 0x8000));
	T(0x31281234u, asm.andi(R8, R9, 0x1234));
	T(0x303F0000u, asm.andi(R31, R1, 0x0000));
	T(0x303F0001u, asm.andi(R31, R1, 0x0001));
	T(0x303FFFFFu, asm.andi(R31, R1, 0xFFFF));
	T(0x303F8000u, asm.andi(R31, R1, 0x8000));
	T(0x303F1234u, asm.andi(R31, R1, 0x1234));
	T(0x33E10000u, asm.andi(R1, R31, 0x0000));
	T(0x33E10001u, asm.andi(R1, R31, 0x0001));
	T(0x33E1FFFFu, asm.andi(R1, R31, 0xFFFF));
	T(0x33E18000u, asm.andi(R1, R31, 0x8000));
	T(0x33E11234u, asm.andi(R1, R31, 0x1234));
	T(0x34000000u, asm.ori(R0, R0, 0x0000));
	T(0x34000001u, asm.ori(R0, R0, 0x0001));
	T(0x3400FFFFu, asm.ori(R0, R0, 0xFFFF));
	T(0x34008000u, asm.ori(R0, R0, 0x8000));
	T(0x34001234u, asm.ori(R0, R0, 0x1234));
	T(0x35280000u, asm.ori(R8, R9, 0x0000));
	T(0x35280001u, asm.ori(R8, R9, 0x0001));
	T(0x3528FFFFu, asm.ori(R8, R9, 0xFFFF));
	T(0x35288000u, asm.ori(R8, R9, 0x8000));
	T(0x35281234u, asm.ori(R8, R9, 0x1234));
	T(0x343F0000u, asm.ori(R31, R1, 0x0000));
