def test_muldiv(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x0000001Au, asm.div(R0, R0));
	T(0x0109001Au, asm.div(R8, R9));
	T(0x03E1001Au, asm.div(R31, R1));
	T(0x003F001Au, asm.div(R1, R31));
	T(0x0000001Bu, asm.divu(R0, R0));
	T(0x0109001Bu, asm.divu(R8, R9));
	T(0x03E1001Bu, asm.divu(R31, R1));
	T(0x003F001Bu, asm.divu(R1, R31));
	T(0x00000018u, asm.mult(R0, R0));
	T(0x01090018u, asm.mult(R8, R9));
	T(0x03E10018u, asm.mult(R31, R1));
	T(0x003F0018u, asm.mult(R1, R31));
	T(0x00000019u, asm.multu(R0, R0));
	T(0x01090019u, asm.multu(R8, R9));
	T(0x03E10019u, asm.multu(R31, R1));
	T(0x003F0019u, asm.multu(R1, R31));
	T(0x00000010u, asm.mfhi(R0));
	T(0x00000012u, asm.mflo(R0));
	T(0x00000810u, asm.mfhi(R1));
	T(0x00000812u, asm.mflo(R1));
	T(0x00004010u, asm.mfhi(R8));
	T(0x00004012u, asm.mflo(R8));
	T(0x00007810u, asm.mfhi(R15));
	T(0x00007812u, asm.mflo(R15));
	T(0x00008010u, asm.mfhi(R16));
	T(0x00008012u, asm.mflo(R16));
	T(0x0000F810u, asm.mfhi(R31));
	T(0x0000F812u, asm.mflo(R31));
}

def test_jump(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x08000000u, asm.j(0x0));
	T(0x0C000000u, asm.jal(0x0));
	T(0x08000001u, asm.j(0x1));
	T(0x0C000001u, asm.jal(0x1));
	T(0x08000100u, asm.j(0x100));
	T(0x0C000100u, asm.jal(0x100));
	T(0x0BFFFFFFu, asm.j(0x3FFFFFF));
	T(0x0FFFFFFFu, asm.jal(0x3FFFFFF));
	T(0x0AAAAAAAu, asm.j(0x2AAAAAA));
	T(0x0EAAAAAAu, asm.jal(0x2AAAAAA));
	T(0x00000008u, asm.jr(R0));
	T(0x00000009u, asm.jalr(R0, R0));
	T(0x0000F809u, asm.jalr(R31, R0));
	T(0x00004009u, asm.jalr(R8, R0));
	T(0x00200008u, asm.jr(R1));
	T(0x00200009u, asm.jalr(R0, R1));
	T(0x0020F809u, asm.jalr(R31, R1));
	T(0x00204009u, asm.jalr(R8, R1));
	T(0x01000008u, asm.jr(R8));
	T(0x01000009u, asm.jalr(R0, R8));
	T(0x0100F809u, asm.jalr(R31, R8));
	T(0x01004009u, asm.jalr(R8, R8));
	T(0x01E00008u, asm.jr(R15));
	T(0x01E00009u, asm.jalr(R0, R15));
	T(0x01E0F809u, asm.jalr(R31, R15));
	T(0x01E04009u, asm.jalr(R8, R15));
	T(0x02000008u, asm.jr(R16));
	T(0x02000009u, asm.jalr(R0, R16));
	T(0x0200F809u, asm.jalr(R31, R16));
	T(0x02004009u, asm.jalr(R8, R16));
	T(0x03E00008u, asm.jr(R31));
	T(0x03E00009u, asm.jalr(R0, R31));
	T(0x03E0F809u, asm.jalr(R31, R31));
	T(0x03E04009u, asm.jalr(R8, R31));
}

