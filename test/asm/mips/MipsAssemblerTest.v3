def test_move(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x00000025u, asm.move(R0, R0));
	T(0x01204025u, asm.move(R8, R9));
	T(0x0020F825u, asm.move(R31, R1));
	T(0x03E00825u, asm.move(R1, R31));
}

def main(args: Array<string>) -> int {
	return UnitTests.run(args);
}
