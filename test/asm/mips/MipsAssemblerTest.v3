def test_trap(t: MipsTester) {
	def T = t.check, asm = t.asm;
	T(0x00000034u, asm.teq(R0, R0, 0));
	T(0x00000074u, asm.teq(R0, R0, 1));
	T(0x0000FFF4u, asm.teq(R0, R0, 1023));
	T(0x00005574u, asm.teq(R0, R0, 341));
	T(0x01090034u, asm.teq(R8, R9, 0));
	T(0x01090074u, asm.teq(R8, R9, 1));
	T(0x0109FFF4u, asm.teq(R8, R9, 1023));
	T(0x01095574u, asm.teq(R8, R9, 341));
