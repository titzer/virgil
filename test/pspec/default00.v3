//@execute 0=1; 1=1; 2=1; 3=0; 4=1
class X(v: int) { }
class Y(v: int) { }
type V { case A(x: int); case B; }
type W { case C; case D(x: int); }
def d<T>() -> T { var t: T; return t; }
def main(a: int) -> int {
	match (a) {
		0 => return if(d<X>() == null, 1);
		1 => return if(d<Y>() == null, 1);
		2 => return if(d<V>() == V.A(0), 1);
		3 => return d<int>();
	}
	return if(d<W>() == W.C, 1);
}
