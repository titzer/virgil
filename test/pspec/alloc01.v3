//@execute 0=1; 1=2; 2=3
class X { }
class Y { }
class Obj { }
class Box<T>(v: T) extends Obj { }
def make<T>(v: T) -> Obj { return Box<T>.new(v); }
def kind(o: Obj) -> int {
	if (Box<X>.?(o)) return 1;
	if (Box<Y>.?(o)) return 2;
	if (Box<int>.?(o)) return 3;
	return 0;
}
def main(a: int) -> int {
	match (a) {
		0 => return kind(make(X.new()));
		1 => return kind(make(Y.new()));
	}
	return kind(make(4));
}
