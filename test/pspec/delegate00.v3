//@execute 0=0; 1=0; 2=0; 3=0; 4=1
class X { }
class Y { }
class A {
	def m<T>() -> int { return 1; }
}
class B extends A {
	def m<T>() -> int { return 3; }
}
class C<T> {
	def get() -> int { return 4; }
}
def f<T>() -> int { return 5; }
def main(a: int) -> int {
	var o = A.new(), b: A = B.new();
	match (a) {
		0 => return if(o.m<X> == o.m<Y>, 1);
		1 => return if(b.m<X> == b.m<Y>, 1);
		2 => return if(f<X> == f<Y>, 1);
		3 => return if(C<X>.new().get == C<Y>.new().get, 1);
	}
	return if(f<X> == f<X>, 1);
}
