//@execute 0=110; 1=110; 2=101; 3=102
class X(v: int) { }
class Y(v: int) { }
class A {
	def m<T>(o: X) -> int { return 10; }
}
class B extends A {
	def m<T>(o: X) -> int { return if(T.?(o), 1, 2); }
}
def call<T>(a: A, o: X) -> int { return a.m<T>(o); }
def outer<T>(a: A, o: X) -> int { return call<T>(a, o) + 100; }
def main(a: int) -> int {
	var x = X.new(3), o = if((a & 2) == 0, A.new(), B.new());
	return if((a & 1) == 0, outer<X>(o, x), outer<Y>(o, x));
}
