//@execute 0=1; 1=1; 2=0; 3=0
type Opt<X> {
	case Some(v: X);
	case None;
}
def FP: Array<Opt<float>> = [Opt<float>.Some(0f)];
def FN: Array<Opt<float>> = [Opt<float>.Some(-0f)];
def DP: Array<Opt<double>> = [Opt<double>.Some(0d)];
def DN: Array<Opt<double>> = [Opt<double>.Some(-0d)];
def FX: Array<Opt<float>> = [Opt<float>.Some(float.nan)];
def DX: Array<Opt<double>> = [Opt<double>.Some(double.nan)];
def main(a: int) -> int {
	match (a) {
		0 => return if(FP[0] == FN[0], 1);
		1 => return if(DP[0] == DN[0], 1);
		2 => return if(FX[0] == FX[0], 1);
	}
	return if(DX[0] == DX[0], 1);
}
