//@execute 0=5010000
//@heap-size=2000000
class X(v: int) { }
class Y(v: int) { }
class Node<T>(val: T, next: Node<T>) { }
def build<T>(n: int, f: int -> T) -> Node<T> {
	var l: Node<T>;
	for (i < n) l = Node<T>.new(f(i), l);
	return l;
}
def count<T>(l: Node<T>) -> int { var c = 0; for (n = l; n != null; n = n.next) c++; return c; }
def sumx(l: Node<X>) -> int { var c = 0; for (n = l; n != null; n = n.next) c += n.val.v; return c; }
def sumy(l: Node<Y>) -> int { var c = 0; for (n = l; n != null; n = n.next) c += n.val.v; return c; }
def main(a: int) -> int {
	var total = 0;
	for (k < 5) {
		var x = build(1000, X.new), y = build(1000, Y.new), z = build(1000, int.!<int>);
		total += count(x) + count(y) + count(z) + sumx(x) + sumy(y);
	}
	return total;
}
