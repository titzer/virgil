//@execute 0=1; 1=102; 2=1003; 3=-1
class X(v: int) { }
class Y(v: int) { }
class Addr {
	def get<T>() -> T { return Address<T>.!(this).val; }
	def is<T>() -> bool { return Address<T>.?(this); }
}
class Address<T>(val: T) extends Addr { }
def show(a: Addr) -> int {
	if (a.is<X>()) return a.get<X>().v;
	if (a.is<Y>()) return a.get<Y>().v + 100;
	if (a.is<long>()) return int.view(a.get<long>()) + 1000;
	return -1;
}
def main(a: int) -> int {
	match (a) {
		0 => return show(Address<X>.new(X.new(1)));
		1 => return show(Address<Y>.new(Y.new(2)));
		2 => return show(Address<long>.new(3));
	}
	return show(Addr.new());
}
