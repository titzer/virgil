//@execute 0=1; 1=2; 2=99; 3=7; 4=9
class X(v: int) { }
class Y(v: int) { }
def mk<T>(n: int, t: T) -> Array<T> { var a = Array<T>.new(n); for (i < n) a[i] = t; return a; }
def sub<T>(a: Array<T>, s: int) -> Range<T> { return a[s ...]; }
def first<T>(r: Range<T>) -> T { return r[0]; }
def main(a: int) -> int {
	match (a) {
		0 => return first(sub(mk(3, X.new(1)), 1)).v;
		1 => return first(sub(mk(4, Y.new(2)), 2)).v;
		2 => return first(sub(mk(5, 99), 3));
		3 => return int.view(first(sub(mk(6, 7L), 4)));
	}
	return first(sub(mk(2, (1, X.new(9))), 1)).1.v;
}
