//@execute 0=7; 1=11; 2=11
class P<T> {
	var a: T;
	var b: int;
	new(a, b) { }
	def setB(v: int) -> this { b = v; }
	def getA() -> T { return a; }
	def getB() -> int { return b; }
}
def main(a: int) -> int {
	match (a) {
		0 => { var p = P<int>.new(3, 1).setB(4); return p.getA() + p.getB(); }
		1 => { var p = P<long>.new(5, 1).setB(6); return int.view(p.getA()) + p.getB(); }
	}
	var p = P<(long, byte)>.new((1, 2), 1).setB(8);
	return int.view(p.getA().0) + p.getA().1 + p.getB();
}
