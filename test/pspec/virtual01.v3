//@execute 0=101; 1=102; 2=101; 3=102; 4=101
class X(v: int) { }
class Y(v: int) { }
class L<T> {
	def m() -> int { return n() + 100; }
	def n() -> int { return 1; }
}
class M<T> extends L<T> {
	def n() -> int { return 2; }
}
def main(a: int) -> int {
	match (a) {
		0 => return L<X>.new().m();
		1 => return M<X>.new().m();
		2 => return L<Y>.new().m();
		3 => return M<Y>.new().m();
	}
	return L<int>.new().m();
}
