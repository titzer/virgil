//@execute 0=7; 1=11; 2=15; 3=13
class P<T> {
	var a: T;
	var b: int;
	new(a, b) { }
	def getA() -> T { return a; }
	def getB() -> int { return b; }
}
def main(a: int) -> int {
	match (a) {
		0 => { var p = P<int>.new(3, 4); return p.getA() + p.getB(); }
		1 => { var p = P<long>.new(5, 6); return int.view(p.getA()) + p.getB(); }
		2 => { var p = P<byte>.new(7, 8); return p.getA() + p.getB(); }
	}
	var p = P<(int, int)>.new((1, 2), 10);
	return p.getA().0 + p.getA().1 + p.getB();
}
