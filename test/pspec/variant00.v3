//@execute 0=1; 1=2; 2=0; 3=5; 4=11; 5=14; 6=15
class X(v: int) { }
class Y(v: int) { }
type Opt<T> {
	case None;
	case Some(x: T);
	def get(d: T) -> T { match (this) { None => return d; Some(x) => return x; } }
}
type U<T> #unboxed {
	case A(x: T, y: int);
	case B(z: int);
	def num() -> int { match (this) { A(x, y) => return y; B(z) => return z; } }
}
def main(a: int) -> int {
	match (a) {
		0 => return Opt<X>.Some(X.new(1)).get(null).v;
		1 => return Opt<Y>.Some(Y.new(2)).get(null).v;
		2 => return if(Opt<X>.None.get(null) == null, 0, 1);
		3 => return Opt<int>.Some(5).get(0);
		4 => return U<X>.A(X.new(1), 11).num();
		5 => return U<Y>.B(14).num();
	}
	return U<long>.A(3, 15).num();
}
