//@execute 0=1; 1=2; 2=7; 3=7
class X(v: int) { }
class Y(v: int) { }
def even<T>(n: int, o: X) -> int { return if(n == 0, leaf<T>(o), odd<T>(n - 1, o)); }
def odd<T>(n: int, o: X) -> int { return if(n == 0, 7, even<T>(n - 1, o)); }
def leaf<T>(o: X) -> int { return if(T.?(o), 1, 2); }
def main(a: int) -> int {
	var x = X.new(3), n = if(a < 2, 4, 3);
	return if((a & 1) == 0, even<X>(n, x), even<Y>(n, x));
}
