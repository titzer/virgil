//@execute 0=1; 1=0; 2=1; 3=0
type Pair<X>(x: X, y: X) { }
def main(a: int) -> int {
	match (a) {
		0 => return if(Pair<int>(1, 2) == Pair<int>(1, 2), 1);
		1 => return if(Pair<long>(1, 0x100000002L) == Pair<long>(1, 2), 1);
		2 => return if(Pair<byte>(1, 2) == Pair<byte>(1, 2), 1);
	}
	return if(Pair<(int, long)>((1, 2), (1, 0x100000002L)) == Pair<(int, long)>((1, 2), (1, 2)), 1);
}
