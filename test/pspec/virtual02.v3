//@execute 0=10; 1=20; 2=7; 3=10; 4=20; 5=7
class A<T> {
	def m() -> int { return 10; }
	def k<U>() -> int { return 1; }
}
class B extends A<int> {
	def m() -> int { return 20; }
	def k<U>() -> int { return 2; }
}
class C extends A<byte> {
	def m() -> int { return 7; }
}
def call<T>(o: A<T>) -> int { return o.m() + 0 * o.k<T>() + 0 * o.k<bool>(); }
def main(a: int) -> int {
	match (a) {
		0 => return call(A<int>.new());
		1 => return call(B.new());
		2 => return call(C.new());
		3 => return A<int>.new().m();
		4 => return B.new().m();
	}
	return C.new().m();
}
