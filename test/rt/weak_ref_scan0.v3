//@execute 0=42
// Accessing a weak reference from a user scanner during GC upgrades it to a strong reference.
def BASE = 3000;

class C(x: int) {
	def children = [Box.new(x + 1), Box.new(x + 2)];
}
class Box(x: int) {}

// An object whose scanner reads a weak reference, but only while {upgrade} is set.
class S {
	var w: WeakRef<C>;
	var upgrade = true;
	var scans = 0;
	var seen = 0;
	new(w) { RiGc.registerScanner(this, S.scan); }
	def scan() {
		scans++;
		if (!upgrade) return;
		var c = w.get();
		seen = if(c == null, -1, c.x);
	}
}

// Allocate a {C} reachable only through a weak reference.
def makeWeak(i: int) -> WeakRef<C> {
	return WeakRef<C>.new().set(C.new(BASE + i));
}
def checkLive(s: S, i: int) -> int {
	var c = s.w.get();
	if (c == null) return -100 - i;
	if (c.x != BASE + i) return -200 - i;
	if (s.seen != BASE + i) return -300 - i;
	if (c.children[0].x != BASE + i + 1) return -400 - i;
	if (c.children[1].x != BASE + i + 2) return -500 - i;
	return 42;
}

def test(weakFirst: bool) -> int {
	def GC_COUNT = 5;
	// The registration order of the scanners determines whether the weak reference's own
	// scanner runs before or after the upgrade.
	var s: S;
	if (weakFirst) {
		s = S.new(makeWeak(0));
	} else {
		s = S.new(null);
		s.w = makeWeak(0);
	}
	for (i < GC_COUNT) {
		RiGc.forceGC();
		if (s.scans != i + 1) return -1000 - i;
		var r = checkLive(s, 0);
		if (r != 42) return r;
	}
	// Stop accessing the weak reference in the scanner; the referent is collected.
	s.upgrade = false;
	RiGc.forceGC();
	if (s.w.get() != null) return -2000;

	// Retarget to a strongly-held object; scanner access is then a no-op.
	var c = C.new(BASE + 7);
	s.w.set(c);
	s.upgrade = true;
	for (i < GC_COUNT) {
		RiGc.forceGC();
		if (s.w.get() != c) return -3000 - i;
		var r = checkLive(s, 7);
		if (r != 42) return r;
	}
	return 42;
}

// A scanner that upgrades a referent which itself holds a weak reference to another
// object that is only reachable via a second scanner upgrade.
class T {
	var w: WeakRef<T>;
	var x: int;
	new(x) { RiGc.registerScanner(this, T.scan); }
	def scan() {
		if (w != null) void(w.get());
	}
}

def testChain() -> int {
	def LEN = 6;
	var head = T.new(0), t = head;
	for (i = 1; i < LEN; i++) {
		var n = T.new(i);
		t.w = WeakRef<T>.new().set(n);
		t = n;
	}
	t = null;
	for (k < 3) {
		RiGc.forceGC();
		var x = head;
		for (i < LEN) {
			if (x == null) return -4000 - i;
			if (x.x != i) return -5000 - i;
			x = if(x.w == null, null, x.w.get());
		}
	}
	return 42;
}

def test_weakFirst() -> int { return test(true); }
def test_scannerFirst() -> int { return test(false); }

def main() -> int {
	var tests = [test_weakFirst, test_scannerFirst, testChain];
	for (i < tests.length) {
		System.puts("##+test");
		System.puti(i);
		System.ln();
		var r = tests[i]();
		if (r == 42) {
			System.puts("##-ok\n");
		} else {
			System.puts("##-fail: ");
			System.puti(r);
			System.ln();
		}
	}
	return 42;
}
