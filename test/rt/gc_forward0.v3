// Objects whose first word looks like a forwarded pointer (an array, whose header holds its length
// in the upper half on 64-bit targets, or an object with an int field at offset 4) must still be
// copied by the GC. Run with -vm-start-addr (see .flags-32 and .flags-64) to place the heap high.
class Box(x: int, y: int) { }
// The junk is reached first, so that the other objects are copied across an address boundary.
var junk: Array<byte>;
var boxes: Array<Box>;
var arrays: Array<Array<int>>;
var high: int; // the upper 32 bits of heap addresses when built, or 0 on 32-bit targets
def N = 50000;

def main() -> int {
	build();
	for (gc < 4) {
		RiGc.forceGC();
		var r = check();
		if (r != 0) return r + gc * 10;
	}
	return 0;
}
// Distance from {p} to the next 4GB boundary (2GB on 32-bit targets).
def boundaryGap(p: Pointer) -> long {
	var bits = p - Pointer.NULL;
	if (Pointer.SIZE == 4) return 0x8000_0000L - (bits & 0x7FFF_FFFF);
	return 0x1_0000_0000L - (bits & 0xFFFF_FFFFL);
}
// Box fields and array lengths cover small upper halves as well as those of the heap itself.
def xval(i: int, high: int) -> int {
	return if((i & 1) == 0, i & 15, high + (i & 3) - 1);
}
def len(i: int, high: int) -> int {
	if (i % 1000 == 1) return 1 + high + (i & 3);
	return 1 + (i & 15);
}
def build() #no-inline {
	var gap = boundaryGap(CiRuntime.heapCurLoc.load<Pointer>());
	var semi = (CiRuntime.HEAP_END - CiRuntime.HEAP_START) / 2;
	junk = Array<byte>.new(if(gap < semi / 2, int.!(gap), 0));
	boxes = Array<Box>.new(N);
	arrays = Array<Array<int>>.new(N);
	high = int.view((Pointer.atObject(boxes) - Pointer.NULL) >> 32);
	for (i < N) {
		boxes[i] = Box.new(xval(i, high), i);
		var a = Array<int>.new(len(i, high));
		a[a.length - 1] = i;
		arrays[i] = a;
		if ((i & 7) == 0) Array<int>.new(3); // garbage between live objects
	}
}
def check() -> int #no-inline {
	if (junk == null) return 3;
	for (i < N) {
		var b = boxes[i];
		if (b.x != xval(i, high) || b.y != i) return 1;
		var a = arrays[i];
		if (a.length != len(i, high) || a[a.length - 1] != i) return 2;
	}
	return 0;
}
