// Stores that initialize new objects call the write barrier.
component WB {
	var count: int;
	var obj: Pointer;
	var val: Pointer;
	new() { RiRuntime.writeBarrierAfter = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		count++;
		obj = o;
		val = v;
	}
}
class C { }
class D(var r: C) { }
class F(x: int, y: C) {
	var z: C = y;
}
class I(x: int) { }
type V #boxed {
	case A(c: C);
	case B(i: int);
}
var fail = 0;
def expect(code: int, n: int, o: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || WB.obj != o || WB.val != v)) fail = code;
	WB.count = 0;
}
def count(code: int, n: int) #no-inline {
	if (fail == 0 && WB.count != n) fail = code;
	WB.count = 0;
}
def fields(x: D, f: F, a: Array<C>, t: Array<(C, int)>, i: I, e: C) -> bool #no-inline {
	return x.r == e && f.z == e && f.y == e && a[1] == e && t[1].0 == e && i.x == 7;
}
def main() -> int {
	var d = C.new(), e = C.new();
	WB.count = 0;
	var x = D.new(d);
	expect(1, 1, Pointer.atObject(x), Pointer.atObject(d));
	var f = F.new(3, e);
	expect(2, 2, Pointer.atObject(f), Pointer.atObject(e));
	var a = [d, e];
	expect(3, 2, Pointer.atObject(a), Pointer.atObject(e));
	var t = [(d, 1), (e, 2)];
	expect(4, 2, Pointer.atObject(t), Pointer.atObject(e));
	var v = V.A(d);
	count(5, 1);
	var i = I.new(7);
	count(6, 0);
	x.r = e;
	expect(7, 1, Pointer.atObject(x), Pointer.atObject(e));
	if (!fields(x, f, a, t, i, e) || v != V.A(d)) return -1;
	return if(fail == 0, 42, fail);
}
