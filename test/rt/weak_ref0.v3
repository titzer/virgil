//@execute 0=42
// A single weak reference observes its referent while it is strongly held and is cleared after it is dropped.
class C(x: int) {}

var strong: C;

def main() -> int {
	strong = C.new(42);
	var w = WeakRef<C>.new().set(strong);

	RiGc.forceGC();
	if (w.get() != strong) return -1;
	if (w.get().x != 42) return -2;

	strong = null;
	RiGc.forceGC();
	if (w.get() != null) return -3;

	return 42;
}
