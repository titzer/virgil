//@execute 0=42

def BASE = 1000;

class C(x: int) {}

class Container(n: int) {
	def a = Array<(C, WeakRef<C>)>.new(n);
	new() {
		for (i < n) {
			var c = C.new(BASE + i);
			var r = WeakRef<C>.new().set(c);
			a[i] = (c, r);
		}
	}
	def clear(i: int) -> this {
		a[i] = (null, a[i].1);
	}
	def set(i: int, c: C) -> this {
		a[i] = (c, a[i].1.set(c));
	}
	def extract() -> Array<WeakRef<C>> {
		var r = Array<WeakRef<C>>.new(a.length);
		for (i < r.length) r[i] = a[i].1;
		return r;
	}
	def check() -> int {
		for (i < a.length) {
			System.puts("  - ");
			System.puti(i);
			var t = a[i];
			var c = t.0, d = t.1.get();
			if (c != null) {
				System.puts(" = ");
				System.puti(BASE + i);
				if (c.x != BASE + i) return -1000 - i;
				if (c != d) return -2000 - i;
				System.puts(", ok");
			} else {
				System.puts(" null");
				if (d != null) return -3000 - i;
				System.puts(", ok");
			}
			System.ln();
		}
		return 42;
	}
}

def test(x: int) -> int {
	var a = Container.new(x), r = 42;
	if ((r = a.check()) < 0) return r;

	for (i < x) {
		a.clear(i);
		RiGc.forceGC();
		if ((r = a.check()) < 0) return r;
	}

	return 42;
}


def main() -> int {
	for (count in [1, 2, 7]) {
		System.puts("##+count=");
		System.puti(count);
		System.ln();
		var r = test(count);
		if (r == 42) {
			System.puts("##-ok\n");
		} else {
			System.puts("##-fail: ");
			System.puti(r);
			System.ln();
		}
	}
	return 42;
}
