// A barrier before a store into a null object runs with the null object; the store then throws.
component WB {
	new() { RiRuntime.writeBarrierBefore = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		System.puts(if(o == Pointer.NULL, "barrier null\n", "barrier\n"));
	}
}
class C {
	var r: C;
}
def make(b: bool) -> C #no-inline {
	return if(b, C.new());
}
def main() -> int {
	System.puts("start\n");
	var c = make(false);
	c.r = C.new();
	System.puts("end\n");
	return if(c.r != null, 0, 1);
}
