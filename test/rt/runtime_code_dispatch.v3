class Shape {
	def area() -> int;
	def name() -> string { return "shape"; }
}
class Square(s: int) extends Shape {
	def area() -> int { return s * s; }
	def name() -> string { return "square"; }
}
class Rect(w: int, h: int) extends Shape {
	def area() -> int { return w * h; }
	def name() -> string { return "rect"; }
}
class Cube(c: int) extends Square {
	new() super(c) { }
	def area() -> int { return 6 * c * c; }
}
class Box<T>(val: T) {
	def get() -> T { return val; }
}
class SubBox<T> extends Box<T> {
	new(val: T) super(val) { }
	def get() -> T { return val; }
}

def main() -> int {
	var shapes: Array<Shape> = [Square.new(3), Rect.new(2, 5), Cube.new(2)];
	var sum = 0;
	for (s in shapes) {
		System.puts(s.name());
		System.puts(" ");
		System.puti(s.area());
		System.ln();
		sum += s.area();
	}
	var boxes: Array<Box<int>> = [Box.new(11), SubBox.new(22)];
	for (b in boxes) sum += b.get();
	System.puti(sum);
	System.ln();
	return sum;
}
