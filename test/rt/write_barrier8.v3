// A store into a null object throws before a barrier that replaces the store runs.
component WB {
	new() { RiRuntime.writeBarrierReplace = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		System.puts("barrier\n");
		s.store<Pointer>(v);
	}
}
class C {
	var r: C;
}
def make(b: bool) -> C #no-inline {
	return if(b, C.new());
}
def main() -> int {
	System.puts("start\n");
	var c = make(false);
	c.r = C.new();
	System.puts("end\n");
	return if(c.r != null, 0, 1);
}
