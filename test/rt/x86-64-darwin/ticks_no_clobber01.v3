//@execute = 0
// Companion to ticks_no_clobber00, showing that it is the object's data being
// overwritten rather than a type query going wrong.
//
// {n.arity} is 0 and nothing ever writes it. Before the fix it read back after
// the indirect call as the high half of mach_absolute_time in nanoseconds -- a
// value that steps by one roughly every 4.3 seconds of uptime, which is what
// made it look like a random clobber. The reference itself survives: g[0] is
// still == n afterwards.
//
// Expected 0, the arity the object was constructed with.

type Value #unboxed {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native extends Obj {
	def arity: int;
	def invoke: Array<Value> -> Value;
	new(arity, invoke) { }
}

def g = Array<Value>.new(1);

class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		var e: double = System.ticksUs();
		return Value.Num(e);
	}
}

def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def main() -> int {
	var n = Native.new(0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return n.arity;
}
