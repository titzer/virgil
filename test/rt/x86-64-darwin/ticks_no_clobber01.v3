//@execute = 0
// Companion to ticks_no_clobber00, showing the object data itself. Nothing ever
// writes {n.arity}, so it must read back as the 0 it was constructed with.

type Value #unboxed {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native extends Obj {
	def arity: int;
	def invoke: Array<Value> -> Value;
	new(arity, invoke) { }
}

def g = Array<Value>.new(1);

class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		var e: double = System.ticksUs();
		return Value.Num(e);
	}
}

def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def main() -> int {
	var n = Native.new(0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return n.arity;
}
