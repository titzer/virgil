//@execute = 11
// A live object must survive System.ticksUs(). The type query on the object in
// g[0] holds before the indirect call and must still hold after it: expected 11.
// See test/darwin/x86-64-darwin/gettimeofday10.v3 for what used to break it.

type Value #unboxed {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native extends Obj {
	def arity: int;
	def invoke: Array<Value> -> Value;
	new(arity, invoke) { }
}

def g = Array<Value>.new(1);

class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		var e: double = System.ticksUs();
		return Value.Num(e);
	}
}

// 1 if g[0] still holds a Native, 0 if the query fails, -1 if it is not a Ref.
def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def main() -> int {
	var n = Native.new(0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return before * 10 + after;
}
