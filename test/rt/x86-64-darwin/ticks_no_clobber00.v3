//@execute = 11
// Regression test: System.ticksUs() must not corrupt the heap.
//
// {g[0]} holds Value.Ref(n) where {n} is a Native. Before the call to
// {n.invoke}, the type query Native.?(o) on the object read back out of {g}
// succeeds; it must still succeed afterwards. Expected 11, i.e. the query holds
// both before and after; the bug yielded 10.
//
// Reduced from a Lox interpreter, where every program calling the `clock`
// builtin corrupted the heap. The cause was in the darwin runtime: XNU's
// gettimeofday takes three arguments and the third is a {uint64*} the kernel
// copies mach_absolute_time out through, but System.gettimeofday() passed only
// two. The kernel then wrote 8 bytes of timestamp through whatever the caller
// had last left in the third kernel argument register -- here the object read
// out of {g} -- clobbering its meta word and first field. The reference itself
// survived, so this presents as data corruption rather than a crash.
//
// The shape matters only in that it is what leaves a live pointer in that
// register: {check()} returns with the object in RDX, and the indirect call
// through {n.invoke} reaches a callee that neither sets nor needs RDX.
//
// In test/darwin/x86-64-darwin/, gettimeofday10.v3 pins down the ABI contract
// and syscall_clobber02.v3 shows the same failure without the runtime.

type Value #unboxed {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native extends Obj {
	def arity: int;
	def invoke: Array<Value> -> Value;
	new(arity, invoke) { }
}

def g = Array<Value>.new(1);

class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		var e: double = System.ticksUs();
		return Value.Num(e);
	}
}

// 1 if g[0] still holds a Native, 0 if the query fails, -1 if it is not a Ref.
def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def main() -> int {
	var n = Native.new(0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return before * 10 + after;
}
