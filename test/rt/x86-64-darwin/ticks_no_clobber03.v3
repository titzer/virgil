//@execute = 0
// ticks_no_clobber00..02 exercise System.ticksUs(). This runs the same shape
// against all three tick functions, since each issues gettimeofday separately
// and any of them could regress on its own. A non-zero result names the
// function: 1x for ticksMs, 2x for ticksUs, 3x for ticksNs.

type Value #unboxed {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native extends Obj {
	def arity: int;
	def invoke: Array<Value> -> Value;
	new(arity, invoke) { }
}

def g = Array<Value>.new(1);

class Ticker(which: int) {
	def tick(args: Array<Value>) -> Value {
		var e: double;
		if (which == 0) e = System.ticksMs();
		else if (which == 1) e = System.ticksUs();
		else e = System.ticksNs();
		return Value.Num(e);
	}
}

def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def run(which: int) -> int {
	var n = Native.new(0, Ticker.new(which).tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	if (before != 1) return 1;	// the object was already not a Native
	if (after != 1) return 2;	// the type query stopped holding
	if (n.arity != 0) return 3;	// the field was overwritten
	return 0;
}

def main() -> int {
	for (i < 3) {
		var e = run(i);
		if (e != 0) return 10 * (i + 1) + e;
	}
	return 0;
}
