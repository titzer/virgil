//@execute = 11
// Companion to ticks_no_clobber00 with {Value} an ordinary *boxed* variant, so
// the failure never depended on #unboxed. It does need slightly more program
// than the unboxed version does: at the smallest reduction the boxed form
// happens to leave something harmless in the third kernel argument register.
//
// Expected 11, i.e. the type query on the object in g[0] holds both before and
// after the indirect call; the bug yielded 10.

type Value {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native(name: string, arity: int, invoke: Array<Value> -> Value) extends Obj { }

def g = Array<Value>.new(1);

class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		var e: double = System.ticksUs() - start;
		return Value.Num(e);
	}
}

def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def main() -> int {
	var n = Native.new("clock", 0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return before * 10 + after;
}
