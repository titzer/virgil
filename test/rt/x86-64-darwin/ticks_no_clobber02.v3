//@execute = 11
// Same as ticks_no_clobber00 with {Value} an ordinary *boxed* variant, and a
// little more program: at the smallest reduction the boxed form happens to
// survive. Expected 11.

type Value {
	case Num(v: double);
	case Ref(obj: Obj);
}

class Obj { }

class Native(name: string, arity: int, invoke: Array<Value> -> Value) extends Obj { }

def g = Array<Value>.new(1);

class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		var e: double = System.ticksUs() - start;
		return Value.Num(e);
	}
}

def check() -> int {
	match (g[0]) {
		Ref(o) => return if(Native.?(o), 1, 0);
		_ => return -1;
	}
}

def main() -> int {
	var n = Native.new("clock", 0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return before * 10 + after;
}
