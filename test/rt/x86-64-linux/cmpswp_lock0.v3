// Checks that each Pointer.cmpswp compiles to a lock-prefixed cmpxchg.
def main() -> int {
	var r = 0;
	if (!locked(CiRuntime.unpackClosure<void, (Pointer, byte, byte), bool>(cas8).0)) r |= 1;
	if (!locked(CiRuntime.unpackClosure<void, (Pointer, u16, u16), bool>(cas16).0)) r |= 2;
	if (!locked(CiRuntime.unpackClosure<void, (Pointer, int, int), bool>(cas32).0)) r |= 4;
	if (!locked(CiRuntime.unpackClosure<void, (Pointer, long, long), bool>(cas64).0)) r |= 8;
	return r;
}
def cas8(p: Pointer, e: byte, v: byte) -> bool { return p.cmpswp(e, v); }
def cas16(p: Pointer, e: u16, v: u16) -> bool { return p.cmpswp(e, v); }
def cas32(p: Pointer, e: int, v: int) -> bool { return p.cmpswp(e, v); }
def cas64(p: Pointer, e: long, v: long) -> bool { return p.cmpswp(e, v); }
def locked(code: Pointer) -> bool {
	var found = 0;
	for (i = 3; i < 64; i++) {
		var p = code + i;
		if (p.load<byte>() != 0x0F) continue;
		var op = (p + 1).load<byte>();
		if (op != 0xB0 && op != 0xB1) continue;
		var pre = false;
		for (j = 1; j <= 3; j++) if ((code + (i - j)).load<byte>() == 0xF0) pre = true;
		if (!pre) return false;
		found++;
	}
	return found > 0;
}
