// Threads increment a shared counter with Pointer.cmpswp; no increment may be lost.
def THREADS = 4;
def ITERS = 250000;
def STACK_SIZE = 65536;
def PAGE_SIZE = 4096;
def CLONE_FLAGS = 0x50F00; // CLONE_VM | CLONE_FS | CLONE_FILES | CLONE_SIGHAND | CLONE_THREAD | CLONE_SYSVSEM
def SYS_sched_yield = 24;
def SYS_clone = 56;
class X { }
var counter: Pointer;

def main() -> int {
	var size = PAGE_SIZE * 2 + THREADS * STACK_SIZE;
	var prot = LinuxConst.PROT_READ | LinuxConst.PROT_WRITE | LinuxConst.PROT_EXEC;
	var flags = LinuxConst.MAP_PRIVATE | LinuxConst.MAP_ANONYMOUS;
	var r = Linux.syscall(LinuxConst.SYS_mmap, (Pointer.NULL, size, prot, flags, -1, 0));
	if (r.0 < 0) return 1;
	var code = Pointer.NULL + r.0, data = code + PAGE_SIZE, stacks = data + PAGE_SIZE;
	var spawn = emitSpawn(code);
	counter = data;
	for (t < THREADS) {
		var stackTop = stacks + (t + 1) * STACK_SIZE;
		if (spawn(work, stackTop, data + 64 + 8 * t) <= 0) return 2;
	}
	for (t < THREADS) {
		while ((data + 64 + 8 * t).load<int>() == 0) Linux.syscall(SYS_sched_yield, ());
	}
	var total = counter.load<long>();
	if (total != long.!(THREADS) * ITERS) {
		System.puts("expected ");
		System.puti(THREADS * ITERS);
		System.puts(", got ");
		System.puti(int.!(total));
		System.ln();
		return 3;
	}
	return 0;
}
def work(done: Pointer) {
	for (i < ITERS) {
		while (true) {
			var v = counter.load<long>();
			if (counter.cmpswp(v, v + 1)) break;
		}
	}
	done.store<int>(1);
}
// spawn(func, stackTop, arg): clone a thread that runs func(arg) on stackTop, then exits.
// in: rdi = receiver, rsi = func.code, rdx = func.receiver, rcx = stackTop, r8 = arg
def emitSpawn(start: Pointer) -> (Pointer -> void, Pointer, Pointer) -> long {
	var p = start;
	p = put(p, [0x49, 0x89, 0xF4], []);			// mov r12, rsi
	p = put(p, [0x49, 0x89, 0xD5], []);			// mov r13, rdx
	p = put(p, [0x4D, 0x89, 0xC6], []);			// mov r14, r8
	p = put(p, [0x48, 0x89, 0xCE], []);			// mov rsi, rcx
	p = put(p, [0xBF], le(CLONE_FLAGS, 4));			// mov edi, CLONE_FLAGS
	p = put(p, [0x31, 0xD2], []);				// xor edx, edx
	p = put(p, [0x45, 0x31, 0xD2], []);			// xor r10d, r10d
	p = put(p, [0x45, 0x31, 0xC0], []);			// xor r8d, r8d
	p = put(p, [0xB8], le(SYS_clone, 4));			// mov eax, SYS_clone
	p = put(p, [0x0F, 0x05], []);				// syscall
	p = put(p, [0x48, 0x85, 0xC0], []);			// test rax, rax
	p = put(p, [0x74, 0x01], []);				// jz child
	p = put(p, [0xC3], []);					// ret
	p = put(p, [0x4C, 0x89, 0xEF], []);			// child: mov rdi, r13
	p = put(p, [0x4C, 0x89, 0xF6], []);			// mov rsi, r14
	p = put(p, [0x41, 0xFF, 0xD4], []);			// call r12
	p = put(p, [0xB8], le(LinuxConst.SYS_exit, 4));		// mov eax, SYS_exit
	p = put(p, [0x31, 0xFF], []);				// xor edi, edi
	p = put(p, [0x0F, 0x05], []);				// syscall
	return CiRuntime.forgeClosure<X, (Pointer -> void, Pointer, Pointer), long>(start, null);
}
def put(p: Pointer, op: Array<byte>, imm: Array<byte>) -> Pointer {
	for (b in op) { p.store<byte>(b); p = p + 1; }
	for (b in imm) { p.store<byte>(b); p = p + 1; }
	return p;
}
def le(v: long, n: int) -> Array<byte> {
	var r = Array<byte>.new(n);
	for (i < n) r[i] = byte.view(v >> u6.view(8 * i));
	return r;
}
