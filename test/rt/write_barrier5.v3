// A write barrier before the store sees the old value in the slot.
component WB {
	var count: int;
	var old: Pointer;
	var val: Pointer;
	new() { RiRuntime.writeBarrierBefore = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		count++;
		old = s.load<Pointer>();
		val = v;
	}
}
class C {
	var r: C;
	var i: int;
}
var fail = 0;
def expect(code: int, old: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != 1 || WB.old != old || WB.val != v)) fail = code;
	WB.count = 0;
}
def none(code: int) #no-inline {
	if (fail == 0 && WB.count != 0) fail = code;
	WB.count = 0;
}
def main() -> int {
	var c = C.new(), d = C.new(), e = C.new(), a = Array<C>.new(2);
	WB.count = 0;
	c.r = d;
	expect(1, Pointer.NULL, Pointer.atObject(d));
	c.r = e;
	expect(2, Pointer.atObject(d), Pointer.atObject(e));
	a[1] = d;
	expect(3, Pointer.NULL, Pointer.atObject(d));
	a[1] = null;
	expect(4, Pointer.atObject(d), Pointer.NULL);
	c.i = 3;
	none(5);
	if (c.r != e || a[1] != null || c.i != 3) return -1;
	return if(fail == 0, 42, fail);
}
