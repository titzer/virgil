// Stores of references into class fields call the write barrier with (object, slot, value).
component WB {
	var count: int;
	var obj: Pointer;
	var slot: Pointer;
	var val: Pointer;
	new() { RiRuntime.writeBarrierAfter = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		count++;
		obj = o;
		slot = s;
		val = v;
	}
}
class C {
	var r: C;
	var i: int;
	var b: bool;
	var l: long;
	var a: Array<int>;
	var t: (int, C);
}
var g: C;
var fail = 0;
def expect(code: int, n: int, o: Pointer, s: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || (n > 0 && (WB.obj != o || WB.slot != s || WB.val != v)))) fail = code;
	WB.count = 0;
}
def within(code: int, n: int, o: Pointer, lo: Pointer, hi: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || WB.obj != o || WB.slot < lo || WB.slot >= hi || WB.val != v)) fail = code;
	WB.count = 0;
}
def none(code: int) #no-inline {
	if (fail == 0 && WB.count != 0) fail = code;
	WB.count = 0;
}
def main() -> int {
	var c = C.new(), d = C.new(), a = Array<int>.new(2);
	WB.count = 0;
	c.r = d;
	expect(1, 1, Pointer.atObject(c), Pointer.atField(c.r), Pointer.atObject(d));
	c.r = null;
	expect(2, 1, Pointer.atObject(c), Pointer.atField(c.r), Pointer.NULL);
	c.a = a;
	expect(3, 1, Pointer.atObject(c), Pointer.atField(c.a), Pointer.atObject(a));
	c.t = (7, d);
	within(4, 1, Pointer.atObject(c), Pointer.atObject(c) + 8, Pointer.atObject(c) + 64, Pointer.atObject(d));
	c.i = 5;
	none(5);
	c.b = true;
	none(6);
	c.l = -1L;
	none(7);
	g = d;
	none(8);
	if (c.r != null || c.a != a || c.t.1 != d || c.i != 5 || !c.b || c.l != -1 || g != d) return -1;
	return if(fail == 0, 42, fail);
}
