class Entry(key: string, val: int) {
	def weight() -> int { return val; }
}
class Heavy extends Entry {
	new(key: string, val: int) super(key, val) { }
	def weight() -> int { return val * 10; }
}
component Table {
	def entries: Array<Entry> = [Entry.new("a", 1), Heavy.new("b", 2), Entry.new("c", 3)];
	var total = sumWeights(entries);
	var mutated: Array<int> = [5, 6, 7];
}
component Lazy {
	var calls = 0;
	def get() -> int { return calls++ + Table.total; }
}

def sumWeights(a: Array<Entry>) -> int {
	var sum = 0;
	for (e in a) sum += e.weight();
	return sum;
}

def main() -> int {
	for (e in Table.entries) {
		System.puts(e.key);
		System.puts("=");
		System.puti(e.weight());
		System.ln();
	}
	Table.mutated[1] = Table.total;
	var sum = Table.total + sumWeights(Table.entries) + Lazy.get() + Lazy.get();
	for (x in Table.mutated) sum += x;
	System.puti(sum);
	System.ln();
	return sum;
}
