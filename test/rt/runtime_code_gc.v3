class Cell(val: int, next: Cell) {
	def sum() -> int { return val; }
}
class DoubleCell extends Cell {
	new(val: int, next: Cell) super(val, next) { }
	def sum() -> int { return 2 * val; }
}

def build(n: int) -> Cell {
	var list: Cell;
	for (i < n) list = if(i % 2 == 0, Cell.new(i, list), DoubleCell.new(i, list));
	return list;
}
def total(c: Cell) -> int {
	var sum = 0;
	for (l = c; l != null; l = l.next) sum += l.sum();
	return sum;
}

def main() -> int {
	var keep = build(100);
	var expect = total(keep);
	for (i < 2000) {
		var tmp = build(50);
		if (total(tmp) != 1850) return 1;
		var garbage = Array<int>.new(64);
	}
	if (total(keep) != expect) return 2;
	System.puti(expect);
	System.ln();
	return 0;
}
