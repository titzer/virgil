class Op {
	def apply(a: int, b: int) -> int { return a + b; }
}
class MulOp extends Op {
	def apply(a: int, b: int) -> int { return a * b; }
}
class SubOp extends Op {
	def apply(a: int, b: int) -> int { return a - b; }
}
class Counter {
	var count: int;
	def add(x: int) { count += x; }
}

def twice(f: int -> int, x: int) -> int { return f(f(x)); }
def add3(a: int, b: int, c: int) -> int { return a + b + c; }

def main() -> int {
	var ops: Array<Op> = [Op.new(), MulOp.new(), SubOp.new()];
	var funcs = Array<(int, int) -> int>.new(ops.length);
	for (i < ops.length) funcs[i] = ops[i].apply;
	var sum = 0;
	for (f in funcs) {
		var r = f(7, 3);
		System.puti(r);
		System.ln();
		sum += r;
	}
	var c = Counter.new();
	var add = c.add;
	for (i < 5) add(i);
	sum += c.count;
	sum += twice(add3(1, _, 2), 10);
	var mul = MulOp.new().apply(2, _);
	sum += twice(mul, 3);
	System.puti(sum);
	System.ln();
	return sum;
}
