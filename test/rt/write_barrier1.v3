// Stores of references into array and range elements call an inlined write barrier.
component WB {
	var count: int;
	var obj: Pointer;
	var slot: Pointer;
	var val: Pointer;
	new() { RiRuntime.writeBarrierAfter = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) #inline {
		count++;
		obj = o;
		slot = s;
		val = v;
	}
}
class C { }
var fail = 0;
def expect(code: int, n: int, o: Pointer, s: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || (n > 0 && (WB.obj != o || WB.slot != s || WB.val != v)))) fail = code;
	WB.count = 0;
}
def within(code: int, n: int, o: Pointer, lo: Pointer, hi: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || WB.obj != o || WB.slot < lo || WB.slot >= hi || WB.val != v)) fail = code;
	WB.count = 0;
}
def none(code: int) #no-inline {
	if (fail == 0 && WB.count != 0) fail = code;
	WB.count = 0;
}
def main() -> int {
	var d = C.new(), e = C.new();
	var a = Array<C>.new(3), ai = Array<int>.new(3), az = Array<bool>.new(3);
	var at = Array<(int, C)>.new(3), ac = Array<(C, C)>.new(3), aa = Array<Array<C>>.new(3);
	WB.count = 0;
	a[1] = d;
	expect(1, 1, Pointer.atObject(a), Pointer.atElement(a, 1), Pointer.atObject(d));
	a[2] = null;
	expect(2, 1, Pointer.atObject(a), Pointer.atElement(a, 2), Pointer.NULL);
	aa[0] = a;
	expect(3, 1, Pointer.atObject(aa), Pointer.atElement(aa, 0), Pointer.atObject(a));
	at[1] = (9, d);
	within(4, 1, Pointer.atObject(at), Pointer.atElement(at, 1), Pointer.atElement(at, 2), Pointer.atObject(d));
	ac[1] = (d, e);
	within(5, 2, Pointer.atObject(ac), Pointer.atElement(ac, 1), Pointer.atElement(ac, 2), Pointer.atObject(e));
	var r = a[1 ...];
	r[1] = e;
	expect(6, 1, Pointer.atObject(a), Pointer.atElement(a, 2), Pointer.atObject(e));
	ai[1] = 3;
	none(7);
	az[1] = true;
	none(8);
	var ri = ai[1 ...];
	ri[0] = 4;
	none(9);
	if (a[1] != d || a[2] != e || aa[0] != a || at[1].1 != d || ac[1].0 != d || ai[1] != 4 || !az[1]) return -1;
	return if(fail == 0, 42, fail);
}
