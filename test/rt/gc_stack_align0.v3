// The collector must find roots in callers' frames when frames are padded for stack alignment.
class Box(v: int) { var next: Box; }
def churn() -> int {
	var head: Box;
	for (i < 300000) { var b = Box.new(i); if ((i & 1023) == 0) { b.next = head; head = b; } }	// forces collections
	var count = 0;
	for (b = head; b != null; b = b.next) count++;
	return count;
}
def main() -> int {
	var keep = Box.new(12345), arr = Array<int>.new(100);
	arr[7] = 77;
	var count = churn();
	if (GcStats.gc_count == 0) return 1;
	if (count != 293) return 2;
	if (keep.v != 12345 || arr[7] != 77 || arr.length != 100) return 3;
	return 0;
}
