// Write barriers before and after the same store both run, in order.
component WB {
	var log: int;
	var beforeOld: Pointer;
	var afterNew: Pointer;
	new() {
		RiRuntime.writeBarrierBefore = before;
		RiRuntime.writeBarrierAfter = after;
	}
	def before(o: Pointer, s: Pointer, v: Pointer) #inline {
		log = log * 10 + 1;
		beforeOld = s.load<Pointer>();
	}
	def after(o: Pointer, s: Pointer, v: Pointer) {
		log = log * 10 + 2;
		afterNew = s.load<Pointer>();
	}
}
class C {
	var r: C;
	var i: int;
}
var fail = 0;
def expect(code: int, log: int, old: Pointer, now: Pointer) #no-inline {
	if (fail == 0 && (WB.log != log || WB.beforeOld != old || WB.afterNew != now)) fail = code;
	WB.log = 0;
}
def main() -> int {
	var c = C.new(), d = C.new(), e = C.new();
	WB.log = 0;
	c.r = d;
	expect(1, 12, Pointer.NULL, Pointer.atObject(d));
	c.r = e;
	expect(2, 12, Pointer.atObject(d), Pointer.atObject(e));
	c.i = 1;
	expect(3, 0, Pointer.atObject(d), Pointer.atObject(e));
	if (c.r != e || c.i != 1) return -1;
	return if(fail == 0, 42, fail);
}
