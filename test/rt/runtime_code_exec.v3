class Gen {
	def code() -> Array<byte>;
}
class X86Gen extends Gen {
	def code() -> Array<byte> { return [
		0xB8, 0x2B, 0x00, 0x00, 0x00,	// mov eax, 43
		0xC3				// ret
	]; }
}
class Arm64Gen extends Gen {
	def code() -> Array<byte> { return [
		0x60, 0x05, 0x80, 0x52,		// mov w0, #43
		0xC0, 0x03, 0x5F, 0xD6		// ret
	]; }
}
class RiscV64Gen extends Gen {
	def code() -> Array<byte> { return [
		0x13, 0x05, 0xB0, 0x02,		// li a0, 43
		0x67, 0x80, 0x00, 0x00		// ret
	]; }
}
class Holder(f: void -> int) { }

def main() -> int {
	var start = CiRuntime.RUNTIME_CODE_START, end = CiRuntime.RUNTIME_CODE_END;
	var size = int.!(end - start);
	if (size != 32 * 1024) return 1;
	if (start < CiRuntime.CODE_END && end > CiRuntime.CODE_START) return 2;
	var region = CiRuntime.forgeRange<byte>(start, size);
	for (i < size) region[i] = 0xCC;
	for (i < size) if (region[i] != 0xCC) return 3;
	var gen = getGen();
	var code = gen.code();
	var offset = size - 16;
	for (i < code.length) region[offset + i] = code[i];
	var h = Holder.new(CiRuntime.forgeClosure<void, void, int>(start + offset, ()));
	var r = h.f();
	System.puti(r);
	System.ln();
	return if(r == 43, 0, 4);
}

def getGen() -> Gen {
	var gens: Array<Gen> = [X86Gen.new(), Arm64Gen.new(), RiscV64Gen.new()];
	if (TARGET_x86 || TARGET_x86_64) return gens[0];
	if (TARGET_arm64_linux) return gens[1];
	if (TARGET_riscv64_linux) return gens[2];
	return null;
}

def TARGET_x86_linux = false;
def TARGET_x86_darwin = false;
def TARGET_x86_64_linux = false;
def TARGET_x86_64_darwin = false;
def TARGET_arm64_linux = false;
def TARGET_riscv64_linux = false;

def TARGET_x86 = TARGET_x86_linux || TARGET_x86_darwin;
def TARGET_x86_64 = TARGET_x86_64_linux || TARGET_x86_64_darwin;
