// The GC copies objects with RiGc.memCopy and zeroes the reused part of to-space with
// RiGc.memClear, both of which work on blocks of words and then on the remaining words.
// Live arrays of every length up to 24 words must survive copying intact, and memory
// that held garbage must read as zero when it is allocated again, whatever the number
// of words left over after the last block.
var live: Array<Array<byte>>;
def MAX = 24 * Pointer.SIZE;

def main() -> int {
	live = Array.new(MAX + 1);
	for (i < live.length) {
		var a = Array<byte>.new(i);
		for (j < i) a[j] = byte.view(i + j + 1);
		live[i] = a;
	}
	for (k < 2 * 8 * Pointer.SIZE) {
		var r = clear(k);
		if (r != 0) return r + 100 * k;
		r = check();
		if (r != 0) return r + 100 * k;
	}
	return 0;
}
// Fill memory with nonzero garbage whose end moves by {k} words, collect twice so that
// the space it filled is cleared, and check that an array allocated over it is zero.
def clear(k: int) -> int #no-inline {
	RiGc.forceGC();
	var size = fill(k);
	RiGc.forceGC();
	RiGc.forceGC();
	var a = Array<byte>.new(size);
	for (b in a) if (b != 0) return 1;
	return 0;
}
def fill(k: int) -> int #no-inline {
	var size = 0;
	for (i < 17) {
		var g = Array<byte>.new(if(i == 16, k * Pointer.SIZE, 200));
		for (j < g.length) g[j] = 0xFF;
		size += g.length + 16;
	}
	return size;
}
def check() -> int #no-inline {
	for (i < live.length) {
		var a = live[i];
		if (a.length != i) return 2;
		for (j < i) if (a[j] != byte.view(i + j + 1)) return 3;
	}
	return 0;
}
