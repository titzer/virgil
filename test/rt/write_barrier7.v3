// A write barrier that replaces the store decides whether and what to store.
component WB {
	var count: int;
	var skip: bool;
	new() { RiRuntime.writeBarrierReplace = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		count++;
		if (!skip) s.store<Pointer>(v);
	}
}
class C {
	var r: C;
	var i: int;
}
class D(r: C) { }
var fail = 0;
def expect(code: int, n: int) #no-inline {
	if (fail == 0 && WB.count != n) fail = code;
	WB.count = 0;
}
def check(c: C, r: C, a: Array<C>, ar: C) -> bool #no-inline {
	return c.r == r && a[0] == ar;
}
def unset(x: D, l: Array<C>) -> bool #no-inline {
	return x.r == null && l[0] == null;
}
def main() -> int {
	var c = C.new(), d = C.new(), e = C.new(), a = Array<C>.new(1);
	WB.count = 0;
	c.r = d;
	a[0] = d;
	expect(1, 2);
	if (!check(c, d, a, d)) return 2;
	WB.skip = true;
	c.r = e;
	a[0] = e;
	expect(3, 2);
	if (!check(c, d, a, d)) return 4;
	var x = D.new(d), l = [d];
	expect(7, 2);
	if (!unset(x, l)) return 8;
	WB.skip = false;
	c.i = 5;
	expect(5, 0);
	if (c.i != 5) return 6;
	return if(fail == 0, 42, fail);
}
