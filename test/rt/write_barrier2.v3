// Fields whose types normalize to references (variants, closures, ranges, tuples, type parameters)
// call the write barrier for each reference; fields that normalize to non-references do not.
component WB {
	var count: int;
	var obj: Pointer;
	var slot: Pointer;
	var val: Pointer;
	new() { RiRuntime.writeBarrierAfter = barrier; }
	def barrier(o: Pointer, s: Pointer, v: Pointer) {
		count++;
		obj = o;
		slot = s;
		val = v;
	}
}
class C {
	def m(x: int) -> int { return x + 1; }
}
type V {
	case A(c: C);
	case B(i: int);
}
type U #unboxed {
	case X(c: C);
	case Y(i: int);
}
type W(c: C, i: int) #unboxed;
enum E { P, Q }
class H {
	var v: V;
	var u: U;
	var w: W;
	var f: int -> int;
	var r: Range<C>;
	var n: ((C, int), C);
	var e: E;
	var p: Pointer;
}
class Box<T> {
	var x: T;
}
def top(x: int) -> int { return x; }
var fail = 0;
def expect(code: int, n: int, o: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || (n > 0 && (WB.obj != o || WB.val != v)))) fail = code;
	WB.count = 0;
}
def objs(code: int, n: int, o: Pointer) #no-inline {
	if (fail == 0 && (WB.count != n || WB.obj != o)) fail = code;
	WB.count = 0;
}
def exact(code: int, o: Pointer, s: Pointer, v: Pointer) #no-inline {
	if (fail == 0 && (WB.count != 1 || WB.obj != o || WB.slot != s || WB.val != v)) fail = code;
	WB.count = 0;
}
def count(code: int, n: int) #no-inline {
	if (fail == 0 && WB.count != n) fail = code;
	WB.count = 0;
}
def main() -> int {
	var h = H.new(), d = C.new(), e = C.new(), a = Array<C>.new(4);
	var va = V.A(d), bc = Box<C>.new(), bi = Box<int>.new(), bt = Box<(C, C)>.new(), bv = Box<void>.new();
	var ho = Pointer.atObject(h);
	WB.count = 0;
	h.v = va;
	objs(1, 1, ho);
	h.u = U.X(d);
	expect(2, 1, ho, Pointer.atObject(d));
	h.u = U.Y(3);
	expect(3, 1, ho, Pointer.NULL);
	h.w = W(e, 4);
	exact(14, ho, Pointer.atField(h.w.c), Pointer.atObject(e));
	h.f = d.m;
	expect(4, 1, ho, Pointer.atObject(d));
	h.r = a[1 ... 3];
	expect(5, 1, ho, Pointer.atObject(a));
	h.n = ((d, 1), e);
	expect(6, 2, ho, Pointer.atObject(e));
	h.f = top;
	count(7, 1);
	bc.x = d;
	expect(8, 1, Pointer.atObject(bc), Pointer.atObject(d));
	bt.x = (d, e);
	count(9, 2);
	h.e = E.Q;
	count(10, 0);
	h.p = Pointer.atObject(d);
	count(11, 0);
	bi.x = 5;
	count(12, 0);
	bv.x = ();
	count(13, 0);
	if (h.v != va || h.f(1) != 1 || h.r.length != 2 || h.n.1 != e || h.e != E.Q || bc.x != d || bi.x != 5) return -1;
	if (h.u != U.Y(3) || h.w.c != e || h.w.i != 4 || h.p != Pointer.atObject(d) || bt.x.1 != e || bv.x != ()) return -2;
	return if(fail == 0, 42, fail);
}
