//@execute 0=42
// Registering scanners and finalizers when the link allocation itself triggers a GC must not resurrect stale links.
def MAGIC = 0x5CA77E;

var errors = 0;
var scans = 0;

// An object whose scanner checks that it is scanned at most once per GC and only while valid.
class S(id: int) {
	var magic = MAGIC;
	var lastGc = -1;
	var count = 0;
	new() { RiGc.registerScanner(this, S.scan); }
	def scan() {
		scans++;
		if (magic != MAGIC) errors++;			// scanned a dead or bogus object
		if (lastGc == GcStats.gc_count) errors++;	// scanned twice in the same GC
		lastGc = GcStats.gc_count;
		count++;
	}
}

def test_scanners() -> int {
	def N = 64, ROUNDS = 2000;
	errors = 0;
	var live = Array<S>.new(N);
	var gcs = GcStats.gc_count;
	for (r < ROUNDS) {
		// Small objects make the scanner link a large fraction of each allocation.
		for (j < 32) void(S.new(-1));
		live[r % N] = S.new(r);
	}
	gcs = GcStats.gc_count - gcs;
	if (gcs < 10) return -1000 - gcs; // expected allocation to trigger GCs
	for (k < 3) RiGc.forceGC();
	if (errors != 0) return -2000 - errors;
	for (i < N) {
		if (live[i].magic != MAGIC) return -3000 - i;
		if (live[i].count < 3) return -4000 - i;
	}
	return 42;
}

var finalized: Array<int>;

def install(id: int) #no-inline {
	RiGc.registerFinalizer(Array<int>.new(1), count(id, _));
}
def count(id: int, v: void) {
	finalized[id]++;
}
def test_finalizers() -> int {
	def N = 20000;
	finalized = Array<int>.new(N);
	var gcs = GcStats.gc_count;
	for (i < N) install(i);
	gcs = GcStats.gc_count - gcs;
	if (gcs < 10) return -1000 - gcs; // expected allocation to trigger GCs
	for (k < 3) RiGc.forceGC();
	for (i < N) {
		if (finalized[i] != 1) return -2000 - i;	// each finalizer runs exactly once
	}
	return 42;
}

def main() -> int {
	var tests = [("scanners", test_scanners), ("finalizers", test_finalizers)];
	for (t in tests) {
		System.puts("##+");
		System.puts(t.0);
		System.ln();
		var r = t.1();
		if (r == 42) {
			System.puts("##-ok\n");
		} else {
			System.puts("##-fail: ");
			System.puti(r);
			System.ln();
		}
	}
	return 42;
}
