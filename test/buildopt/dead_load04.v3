//@execute 0=!NullCheckException; 1=!NullCheckException; 2=2
// An unused chain of field reads must still check every receiver for null.
class A { var b: B; new(b) { } }
class B { var f: int; new(f) { } }
def x = A.new(null), y = A.new(B.new(3));
def main(i: int) -> int {
	var o = if(i == 0, null, if(i == 1, x, y));
	var g = o.b.f;
	return i;
}
