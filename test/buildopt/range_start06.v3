//@execute 0=1027; 1=1541; 2=2055; 3=!BoundsCheckException
// Reads a layout from a subrange of a range with a constant start, at a dynamic offset.
layout S { +0 x: u16; =2; }
def data: Array<byte> = [1, 2, 3, 4, 5, 6, 7, 8];
def main(i: int) -> u16 {
	var r = data[1 ...];
	return Ref<S>.of(r[i * 2 + 1 ...]).x;
}
