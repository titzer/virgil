//@execute 0=false; 1=true; 2=false
// Compares packed variants of different cases, one of which holds a boxed variant.
type C { case None; case Val(x: int); }
type P #unboxed #packed { case I(x: i30); case Q(c: C); }
def is: Array<i30> = [1, 2];
def main(a: int) -> bool {
	match (a) {
		0 => return P.I(is[0]) == P.Q(C.Val(1));
		1 => return P.I(is[1]) == P.I(2);
		_ => return P.Q(C.None) == P.I(is[0]);
	}
}
