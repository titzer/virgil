//@execute 0=!NullCheckException; 1=1
// An unused virtual method closure of a value that may be null must still check for null.
class A { def m() -> int { return 3; } }
class B extends A { def m() -> int { return 4; } }
def b: A = B.new();
def main(i: int) -> int {
	var o = if(i == 0, null, b);
	var f = o.m;
	return 1;
}
