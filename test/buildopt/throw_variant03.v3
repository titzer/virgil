//@execute 0=!NullCheckException; 1=11
type H {
	case One(a: int);
	case Two(b: int);
}
class A {
	def m() -> H { return H.Two(11); }
}
def a = A.new();
def get(h: H) -> int {
	match (h) {
		One(x) => return x;
		Two(y) => return y;
	}
}
def main(i: int) -> int {
	if (i == 0) {
		match (A.m(null)) {
			One(x) => return x;
			Two(y) => return y;
		}
	}
	return get(A.m(a));
}
