//@execute 0=0; 1=1; 2=2; 3=!NullCheckException; 4=!NullCheckException
// An unused field read in a loop whose receiver becomes null on a later iteration.
class A { var f: int; new(f) { } }
def a = A.new(4);
def main(n: int) -> int {
	var o = a;
	for (i < n) {
		var g = o.f;
		if (i > 0) o = null;
	}
	return n;
}
