//@execute 0=false; 1=true; 2=false
// Compares an unboxed variant whose case is not a constant with a constant holding a boxed variant.
type C { case None; case Val(x: int); }
type U #unboxed { case I(x: int); case Q(c: C); }
def us = [U.I(3), U.Q(C.Val(3)), U.Q(C.None)];
def main(a: int) -> bool {
	return us[a] == U.Q(C.Val(3));
}
