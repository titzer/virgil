//@execute 0=true; 1=false; 2=false
// Compares an unboxed variant whose case is not a constant with constants of other cases.
type C { case None; case Val(x: int); }
type U #unboxed { case I(x: int); case Q(c: C); }
def us = [U.I(3), U.Q(C.Val(3)), U.Q(C.None)];
def main(a: int) -> bool {
	return us[a] == U.I(3);
}
