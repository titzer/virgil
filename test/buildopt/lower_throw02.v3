//@execute 0=!DivideByZeroException; 1=!DivideByZeroException; 2=!DivideByZeroException; 3=!DivideByZeroException; 4=5
def main(i: int) -> int {
	var z = 0, zl = 0L;
	if (i == 0) return i / z;
	if (i == 1) return i % z;
	if (i == 2) return int.view(long.view(i) / zl);
	if (i == 3) return int.view(long.view(i) % zl);
	return 5;
}
