//@execute 0=1144201745; 1=1144201745
// Writes every byte of a layout at the start of a byte array, then reads them back.
layout S { +0 x: u32; =4; }
def data = Array<byte>.new(8);
def main(i: int) -> int {
	Ref<S>.at(data, 0).x = 0x44332211;
	return int.view(data[0]) | int.view(data[1]) << 8 | int.view(data[2]) << 16 | int.view(data[3]) << 24;
}
