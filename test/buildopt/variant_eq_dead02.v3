//@execute 0=false; 1=true; 2=false; 3=false
// Compares nested unboxed variants where only one side holds a boxed variant.
type C { case None; case Val(x: int); }
type P #unboxed { case S(s: string); case Q(c: C); }
type T #unboxed { case None; case IsP(p: P); }
def ss = ["s"];
def main(a: int) -> bool {
	match (a) {
		0 => return T.IsP(P.S(ss[0])) == T.IsP(P.Q(C.None));
		1 => return T.IsP(P.Q(C.None)) == T.IsP(P.Q(C.None));
		2 => return T.IsP(P.Q(C.Val(a))) == T.None;
		_ => return T.None == T.IsP(P.S(ss[0]));
	}
}
