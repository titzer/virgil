//@execute 0=false; 1=true; 2=false
// Compares unboxed variants of different cases, one of which holds a boxed variant.
type C { case None; case Val(x: int); }
type U #unboxed { case I(x: int); case Q(c: C); }
def xs = [1, 2];
def main(a: int) -> bool {
	match (a) {
		0 => return U.I(xs[0]) == U.Q(C.Val(1));
		1 => return U.Q(C.Val(xs[0])) == U.Q(C.Val(1));
		_ => return U.Q(C.None) == U.I(xs[1]);
	}
}
