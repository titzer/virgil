//@execute 0=false; 1=false; 2=true
// Compares boxed variants nested two deep in unboxed variants of different cases.
type D { case A; case B(x: int); }
type C { case None; case Val(d: D); }
type U #unboxed { case I(x: int); case Q(c: C); }
def xs = [7, 8];
def main(a: int) -> bool {
	match (a) {
		0 => return U.I(xs[0]) == U.Q(C.Val(D.B(7)));
		1 => return U.Q(C.Val(D.A)) == U.Q(C.Val(D.B(xs[1])));
		_ => return U.Q(C.Val(D.B(xs[1]))) == U.Q(C.Val(D.B(8)));
	}
}
