//@execute 0=false; 4=false; 5=true; 6=false
type C {
	case None;
	case Val(x: int);
}
type P #unboxed #packed {
	case S(s: string);
	case Q(c: C);
	case I(x: i30);
}
type T #unboxed {
	case None;
	case IsP(p: P);
}
def ss = ["s", "t"];
def xs = [1, 2];
def is: Array<i30> = [1, 2];
def mkC(i: int) -> C { return if(i == 2, C.None, C.Val(xs[i])); }
def main(a: int) -> bool {
	var r = false; if (a == 4) r = T.IsP(P.S(ss[0])) == T.IsP(P.I(is[0])); else if (a == 5) r = T.IsP(P.I(is[1])) == T.IsP(P.I(2)); else r = T.IsP(P.Q(mkC(0))) == T.None; return r;
}
