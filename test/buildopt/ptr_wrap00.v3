//@execute 0=!BoundsCheckException; 1=!BoundsCheckException; 2=0
// A folded pointer with an extreme offset wraps on 32-bit targets.
layout S { +0 x: u32; =4; }
def data = Array<byte>.new(8);
def main(i: int) -> u32 {
	if (i == 0) return Ref<S>.at(data, int.max).x;
	if (i == 1) return Ref<S>.at(data, int.min).x;
	return Ref<S>.at(data, 4).x;
}
