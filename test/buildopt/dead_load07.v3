//@execute 0=!NullCheckException; 1=!NullCheckException; 2=2; 3=3
// Unused field reads in both arms of an if, with different receivers.
class A { var f: int; new(f) { } }
def a = A.new(1);
def main(i: int) -> int {
	var p = if(i == 0, null, a), q = if(i == 1, null, a);
	if ((i & 1) == 0) { var g = p.f; }
	else { var h = q.f; }
	return i;
}
