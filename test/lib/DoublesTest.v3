def T = LibTests.register("Doubles", _, _);
def X = [
	T("render", test_render),
	T("renderDecimalDigits", test_renderDecimalDigits),
	T("parse", test_parse),
	T("roundTrip", test_roundTrip),
	()
];

def assertRender(t: LibTest, bits: u64, expected: string) {
	var a = Array<byte>.new(32);
	var l = Doubles.renderDouble(double.view(bits), a, 0);
	t.assert_string(expected, Arrays.range(a, 0, l));
}

def assertRenderDecimalDigits(t: LibTest, bits: u64, dd: u32, expected: string) {
	var a = Array<byte>.new(400);
	var l = Doubles.renderDoubleDecimalDigits(double.view(bits), dd, a, 0);
	t.assert_string(expected, Arrays.range(a, 0, l));
}

def assertParse(t: LibTest, str: string, bits: u64) {
	var r = Doubles.parseDouble(str, 0);
	if (r.0 != str.length) return t.fail3("parse \"%s\": expected length %d, got %d", str, str.length, r.0);
	if (u64.view(r.1) != bits) return t.fail3("parse \"%s\": expected 0x%x, got 0x%x", str, bits, u64.view(r.1));
}

def assertParseFail(t: LibTest, str: string) {
	var r = Doubles.parseDouble(str, 0);
	if (r.0 > 0) t.fail1("parse \"%s\": expected failure", str);
}

def test_render(t: LibTest) {
	def ok = assertRender(t, _, _);
	ok(0x7ff8000000000000uL, "NaN");
	ok(0xfff8000000000000uL, "-NaN");
	ok(0x7ff0000000000000uL, "Infinity");
	ok(0xfff0000000000000uL, "-Infinity");
	ok(0x0000000000000000uL, "0");
	ok(0x3ff0000000000000uL, "1.0"); // 1.0
	ok(0x3fb999999999999auL, "0.1"); // 0.1
	ok(0x3fd3333333333333uL, "0.3"); // 0.3
	ok(0x3fd5555555555555uL, "0.3333333333333333"); // 0.3333333333333333
	ok(0x3fe5555555555555uL, "0.6666666666666666"); // 0.6666666666666666
	ok(0x4059000000000000uL, "100.0"); // 100.0
	ok(0x40934a0000000000uL, "1234.5"); // 1234.5
	ok(0x416312d000000000uL, "1E7"); // 10000000.0
	ok(0x416312cfe0000000uL, "9999999.0"); // 9999999.0
	ok(0x3f50624dd2f1a9fcuL, "0.001"); // 0.001
	ok(0x3f50385c67dfe32auL, "9.9E-4"); // 0.00099
	ok(0x44b52d02c7e14af6uL, "1E23"); // 1e+23
	ok(0x4480f0cf064dd592uL, "1E22"); // 1e+22
	ok(0x444b1ae4d6e2ef50uL, "1E21"); // 1e+21
	ok(0x437b69b4ba630f35uL, "1.2345678901234568E17"); // 1.2345678901234568e+17
	ok(0x0000000000000001uL, "5E-324"); // 5e-324
	ok(0x0000000000000002uL, "1E-323"); // 1e-323
	ok(0x0010000000000000uL, "2.2250738585072014E-308"); // 2.2250738585072014e-308
	ok(0x000fffffffffffffuL, "2.225073858507201E-308"); // 2.225073858507201e-308
	ok(0x7fefffffffffffffuL, "1.7976931348623157E308"); // 1.7976931348623157e+308
	ok(0x0028000000000000uL, "6.675221575521604E-308"); // 6.675221575521604e-308
	ok(0x43e0000000000000uL, "9.223372036854776E18"); // 9.223372036854776e+18
	ok(0x3e10000000000000uL, "9.313225746154785E-10"); // 9.313225746154785e-10
	ok(0x4340000000000000uL, "9.007199254740992E15"); // 9007199254740992.0
	ok(0x4011666666666666uL, "4.35"); // 4.35
	ok(0x3fe0000000000000uL, "0.5"); // 0.5
	ok(0x4004000000000000uL, "2.5"); // 2.5
	ok(0x8000000000000000uL, "-0"); // -0.0
	ok(0xbde49da7e361ce4cuL, "-1.5E-10"); // -1.5e-10
	ok(0x400921fb54442d18uL, "3.141592653589793"); // 3.141592653589793
	ok(0x4005bf0a8b145769uL, "2.718281828459045"); // 2.718281828459045
	ok(0x3ee4f8b588e368f1uL, "1E-5"); // 1e-05
	ok(0x41b1de784a000000uL, "2.99792458E8"); // 299792458.0
}

def test_renderDecimalDigits(t: LibTest) {
	def ok = assertRenderDecimalDigits(t, _, _, _);
	ok(0x7ff8000000000000uL, 2, "NaN");
	ok(0xfff0000000000000uL, 2, "-Infinity");
	ok(0x3fe0000000000000uL, 0, "0"); // 0.5
	ok(0x3ff8000000000000uL, 0, "2"); // 1.5
	ok(0x4004000000000000uL, 0, "2"); // 2.5
	ok(0x3fc0000000000000uL, 2, "0.12"); // 0.125
	ok(0x3fd8000000000000uL, 2, "0.38"); // 0.375
	ok(0x3ff0147ae147ae14uL, 2, "1.00"); // 1.005
	ok(0x4005666666666666uL, 2, "2.67"); // 2.675
	ok(0x0000000000000000uL, 3, "0.000"); // 0.0
	ok(0x8000000000000000uL, 1, "-0.0"); // -0.0
	ok(0x3ddb7cdfd9d7bdbbuL, 3, "0.000"); // 1e-10
	ok(0x3f40624dd2f1a9fcuL, 3, "0.001"); // 0.0005
	ok(0x3f3a36e2eb1c432duL, 3, "0.000"); // 0.0004
	ok(0x3f40b630a91537a0uL, 3, "0.001"); // 0.00051
	ok(0x3f70624dd2f1a9fcuL, 2, "0.00"); // 0.004
	ok(0x3f789374bc6a7efauL, 2, "0.01"); // 0.006
	ok(0x3faeb851eb851eb8uL, 1, "0.1"); // 0.06
	ok(0x4023eb851eb851ecuL, 1, "10.0"); // 9.96
	ok(0x408f3ffdf3b645a2uL, 2, "1000.00"); // 999.999
	ok(0x405edd2f1a9fbe77uL, 1, "123.5"); // 123.456
	ok(0x4415af1d78b58c40uL, 2, "100000000000000000000.00"); // 1e+20
	ok(0x46293e5939a08ceauL, 0, "1000000000000000000000000000000"); // 1e+30
	ok(0x4450000000000000uL, 1, "1180591620717411300000.0"); // 1.1805916207174113e+21
	ok(0x400921fb54442d18uL, 10, "3.1415926536"); // 3.141592653589793
	ok(0x400921fb54442d18uL, 20, "3.14159265358979310000"); // 3.141592653589793
	ok(0x0000000000000001uL, 5, "0.00000"); // 5e-324
	ok(0xc045000000000000uL, 3, "-42.000"); // -42.0
}

def test_parse(t: LibTest) {
	def ok = assertParse(t, _, _);
	ok("NaN", 0x7ff8000000000000uL);
	ok("Infinity", 0x7ff0000000000000uL);
	ok("-Infinity", 0xfff0000000000000uL);
	ok("0", 0x0000000000000000uL);
	ok("-0", 0x8000000000000000uL);
	ok("1", 0x3ff0000000000000uL);
	ok("1.5", 0x3ff8000000000000uL);
	ok("0.1", 0x3fb999999999999auL);
	ok(".5", 0x3fe0000000000000uL);
	ok("5.", 0x4014000000000000uL);
	ok("3.14159", 0x400921f9f01b866euL);
	ok("1e10", 0x4202a05f20000000uL);
	ok("1E+10", 0x4202a05f20000000uL);
	ok("1e-10", 0x3ddb7cdfd9d7bdbbuL);
	ok("-2.5e-3", 0xbf647ae147ae147buL);
	ok("123456789012345678901234567890", 0x45f8ee90ff6c373euL);
	ok("9007199254740993", 0x4340000000000000uL);
	ok("9007199254740993.00000000000000000001", 0x4340000000000001uL);
	ok("1.00000000000000011102230246251565404236316680908203125", 0x3ff0000000000000uL);
	ok("1.000000000000000111022302462515654042363166809082031251", 0x3ff0000000000001uL);
	ok("1.00000005960464477539062500001", 0x3ff0000010000000uL);
	ok("1.000000059604644775390625", 0x3ff0000010000000uL);
	ok("1.0000000596046447753906251", 0x3ff0000010000000uL);
	ok("1.7976931348623157e308", 0x7fefffffffffffffuL);
	ok("1.7976931348623159e308", 0x7ff0000000000000uL);
	ok("1e309", 0x7ff0000000000000uL);
	ok("2.4703282292062327e-324", 0x0000000000000000uL);
	ok("2.4703282292062328e-324", 0x0000000000000001uL);
	ok("5e-324", 0x0000000000000001uL);
	ok("1e-400", 0x0000000000000000uL);
	ok("1e-46", 0x366244ce242c5561uL);
	ok("7e-46", 0x368ff868bf4d956auL);
	ok("3.4028235e38", 0x47efffffe54daff8uL);
	ok("3.4028236e38", 0x47effffff514a7bcuL);
	ok("0.000000000000000000000000000001", 0x39b4484bfeebc2a0uL);
	ok("00000000000000000000000000001.5", 0x3ff8000000000000uL);

	def fail = assertParseFail(t, _);
	fail("");
	fail("-");
	fail(".");
	fail("e5");
	fail("1e");
	fail("1e+");
	fail("Inf");
}

def test_roundTrip(t: LibTest) {
	var a = Array<byte>.new(32), x = 0x9E3779B97F4A7C15uL;
	for (i < 2000) {
		x = x * 6364136223846793005uL + 1442695040888963407uL;
		if ((x & 0x7ff0000000000000uL) == 0x7ff0000000000000uL) continue;
		var l = Doubles.renderDouble(double.view(x), a, 0);
		var r = Doubles.parseDouble(Arrays.range(a, 0, l), 0);
		if (r.0 != l || u64.view(r.1) != x) return t.fail2("round trip 0x%x via \"%s\"", x, Arrays.range(a, 0, l));
	}
}
