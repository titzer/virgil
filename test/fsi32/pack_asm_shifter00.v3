//@execute 0=33558527; 1=4015; 2=3934; 3=33554432; 4=0
def BIT25 = 1u << 25;
def shifter(kind: int, x: int, y: int) -> u32 {
	match (kind) {
		0 => return BIT25 | u32.pack<(u4, u8)>((u4.view(y), byte.view(x)));
		1 => return u32.pack<(u5, u2, u1, u4)>((u5.view(x), 1, 0, u4.view(y)));
		_ => return u32.pack<(u4, u1, u2, u1, u4)>((u4.view(x), 0, 2, 1, u4.view(y)));
	}
}
def main(a: int) -> int {
	match (a) {
		0 => return int.view(shifter(0, 0xFF, 0xF));
		1 => return int.view(shifter(1, 31, 15));
		2 => return int.view(shifter(2, 15, 14));
		3 => return int.view(shifter(0, 0, 0));
		_ => return int.view(shifter(2, 0xFF, 0xFF) & 0xFFFFF000u); // high bits must be clear
	}
}
