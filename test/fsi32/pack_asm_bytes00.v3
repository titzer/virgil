//@execute 0=1633837952; 1=16744320; 2=1650688000; 3=25185; 4=128; 5=-32641; 6=32767
def data: Array<byte> = [0x61, 0x62, 0x63, 0x80, 0x00, 0xFF, 0x7F, 0x80];
def word_be(i: int) -> int {
	return int.pack<(byte, byte, byte, byte)>((data[i], data[i + 1], data[i + 2], data[i + 3]));
}
def i16_le(i: int) -> int {
	return i16.pack<(byte, byte)>((data[i + 1], data[i]));
}
def main(a: int) -> int {
	match (a) {
		0 => return word_be(0);
		1 => return word_be(4);
		2 => return word_be(1);
		3 => return i16_le(0);
		4 => return i16_le(3);
		5 => return i16_le(6);
		_ => return i16_le(5);
	}
}
