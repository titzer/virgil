//@execute 0=0; 1=234; 2=5; 3=3; 4=2
def main(a: int) -> int {
	match (a) {
		0 => {
			var mismatches = 0;
			for (b < 256) {
				var f = byte.unpack<(u2, u3, u3)>(byte.view(b));
				if (byte.pack<(u2, u3, u3)>(f) != b) mismatches++;
			}
			return mismatches;
		}
		1 => return byte.pack<(u2, u3, u3)>((0b11, 5, 2));
		2 => return byte.unpack<(u2, u3, u3)>(0xEA).1;
		3 => return byte.unpack<(u2, u3, u3)>(0xEA).0;
		_ => return byte.unpack<(u2, u3, u3)>(0xEA).2;
	}
}
