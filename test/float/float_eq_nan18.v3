//@execute 0=true; 1=false; 2=true; 3=true; 4=true; 5=false
// double_eq_nan18 for float.
def MINSUB = float.view(0x00000001u);		// smallest subnormal
def NEGSUB = float.view(0x80000001u);		// its negation
def MAXSUB = float.view(0x007FFFFFu);		// largest subnormal
def MINNORM = float.view(0x00800000u);		// smallest normal
def SNAN = float.view(0x7F800001u);		// signaling NaN
def main(i: int) -> bool {
	match (i) {
		0 => return (MINSUB, MINSUB) == (MINSUB, MINSUB);
		1 => return (MINSUB, 0f) == (NEGSUB, 0f);
		2 => return (0f, MINSUB) == (-0f, MINSUB);
		3 => return (float.infinity, 0f - float.infinity) == (float.infinity, 0f - float.infinity);
		4 => return (MAXSUB, MINNORM) == (MAXSUB, MINNORM);
		5 => return (SNAN, 1f) == (SNAN, 1f);
	}
	return false;
}
