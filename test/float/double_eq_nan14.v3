//@execute 0=3; 1=3; 2=4; 3=8; 4=16; 5=32; 6=0; 7=0
// float_eq_nan14 for double.
def a = [
	(0d, 0d),
	(-0d, -0d),
	(double.view(0x00000000_00000001uL), double.view(0x00000000_00000001uL)),
	(double.view(0x80000000_00000001uL), double.view(0x80000000_00000001uL)),
	(double.infinity, 0d - double.infinity),
	(double.view(0x000FFFFF_FFFFFFFFuL), double.view(0x00100000_00000000uL)),
	(double.nan, 0d),
	(0d, double.nan)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
