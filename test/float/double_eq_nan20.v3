//@execute = 111
// Init-time, folded and runtime comparisons of the same tuple must all agree.
def PAIR: (double, double) = (double.nan, 1d);
def A: Array<(double, double)> = [(double.nan, 1d)];
def INIT = if(PAIR != PAIR, 1, 0);
def main() -> int {
	var folded = if((double.nan, 1d) != (double.nan, 1d), 1, 0);
	var live = if(A[0] != A[0], 1, 0);
	return INIT * 100 + folded * 10 + live;
}
