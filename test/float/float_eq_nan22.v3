//@execute 0=3; 1=3; 2=0; 3=8
// A float bracketed by void components on both sides.
def a = [
	((), 0f, ()),
	((), -0f, ()),
	((), float.nan, ()),
	((), 1f, ())
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
