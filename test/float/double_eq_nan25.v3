//@execute 0=3; 1=3; 2=0
// The default of a nested tuple type, so the zero comparison has to recurse.
def D: ((double, float), (int, double));
def a = [
	((0d, 0f), (0, 0d)),
	((-0d, -0f), (0, -0d)),
	((-0d, -0f), (0, double.nan))
];
def main(i: int) -> int {
	var l = D, r = a[i];
	return if(l == r, 1) | if(r == l, 2);
}
