//@execute 0=true; 1=true; 2=true; 3=false; 4=false; 5=false
// double_eq_nan05 for float: a NaN component makes the tuple unequal to itself.
def a = [
	(1.0f, 0.0f),
	(-1.25f, 1.25f),
	(float.infinity, 0f - float.infinity),
	(1f, float.nan),
	(float.nan, 4f),
	(float.nan, float.nan)
];
def main(i: int) -> bool {
	var x = a[i];
	return x == x;
}
