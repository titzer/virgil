//@execute 0=true; 1=true; 2=false; 3=false
// The tuple is loaded from a class field rather than an array.
class Box(t: (double, double)) { }
def a = [
	Box.new((0d, 0d)),
	Box.new((double.infinity, 1d)),
	Box.new((double.nan, 1d)),
	Box.new((1d, double.nan))
];
def main(i: int) -> bool {
	var b = a[i];
	return b.t == b.t;
}
