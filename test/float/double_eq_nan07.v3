//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=0; 6=192; 7=192
// Every pair of tuples against every other.
def a = [
	(0d, 0d),
	(-0d, -0d),
	(0d, -0d),
	(double.nan, 1d),
	(1d, double.nan),
	(double.nan, double.nan),
	(1d, 2d),
	(1d, 2d)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
