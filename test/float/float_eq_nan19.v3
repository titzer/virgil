//@execute 0=true; 1=true; 2=false; 3=false; 4=false; 5=true
// double_eq_nan19 for float.
def ZP: (float, float) = (0f, 0f);
def ZN: (float, float) = (-0f, -0f);
def NP: (float, float) = (float.nan, 1f);
def NQ: (float, float) = (1f, float.nan);
def IP: (float, float) = (float.infinity, 1f);

def R = [
	ZP == ZP,
	ZP == ZN,
	NP == NP,
	NQ == NQ,
	NP == NQ,
	IP == IP
];

def main(i: int) -> bool {
	return R[i];
}
