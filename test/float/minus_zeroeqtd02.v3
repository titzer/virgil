//@execute 0=true; 1=true; 2=true; 3=true
def main(a: int) -> bool {
	var v = (0d, 0d);
	match (a) {
		0 => return eq(v, (0d, 0d));
		1 => return eq(v, (0d, -0d));
		2 => return eq(v, (-0d, 0d));
		3 => return eq(v, (-0d, -0d));
	}
	return false;
}
def eq(a: (double, double), b: (double, double)) -> bool {
	return a == b;
}