//@execute 0=0; 1=0; 2=0; 3=0
// Loaded, returned and rebuilt tuples must all compare the same way.
def a = [(0d, 0d), (-0d, -0d), (double.nan, 1d), (1d, 2d)];
def mk(i: int) -> (double, double) {
	return a[i];
}
def main(i: int) -> int {
	var loaded = a[i];
	var returned = mk(i);
	var built = (a[i].0, a[i].1);
	var out = 0;
	if ((loaded == loaded) != (returned == returned)) out |= 1;
	if ((loaded == loaded) != (built == built)) out |= 2;
	if ((loaded == returned) != (loaded == built)) out |= 4;
	if ((returned == built) != (loaded == loaded)) out |= 8;
	return out;
}
