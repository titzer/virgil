//@execute 0=0; 1=0; 2=0; 3=8; 4=16; 5=96; 6=96
// A three-component tuple of doubles: every pair against every other, over the
// signed zeros, both infinities and a NaN.
def a = [
	(0d, 0d, double.nan),
	(0d, double.nan, 0d),
	(double.nan, 0d, 0d),
	(double.infinity, 1d, 2d),
	(-double.infinity, 1d, 2d),
	(0d, -0d, 1d),
	(-0d, 0d, 1d)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
