//@execute = 11
// The folded and the runtime comparison of the same tuple must agree.
def PAIRS: Array<(double, double)> = [(double.nan, 1d)];
def main() -> int {
	var folded = if((double.nan, 1d) != (double.nan, 1d), 1, 0);
	var live = if(PAIRS[0] != PAIRS[0], 1, 0);
	return folded * 10 + live;		// 11 or 00, never 10
}
