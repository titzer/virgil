//@execute 0=true; 1=true; 2=false; 3=false; 4=false; 5=true; 6=false; 7=false
// Every operand is a literal, so the constant folder decides all of these.
def main(i: int) -> bool {
	match (i) {
		0 => return (0d, 0d) == (0d, 0d);
		1 => return (0d, 0d) == (-0d, -0d);
		2 => return (double.nan, 1d) == (double.nan, 1d);
		3 => return (1d, double.nan) == (1d, double.nan);
		4 => return (double.nan, double.nan) == (double.nan, double.nan);
		5 => return (double.infinity, 1d) == (double.infinity, 1d);
		6 => return (double.nan, 1d) == (1d, double.nan);
		7 => return (0d, 0d) == (0d, 1d);
	}
	return false;
}
