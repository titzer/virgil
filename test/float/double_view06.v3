//@execute 0=0; 1=-2147483648; 2=2146435072; 3=-1048576; 4=1073217536; 5=-1074266112; 6=0
def get(a: int) -> double {
	match (a) {
		0 => return 0d;
		1 => return -0d;
		2 => return double.infinity;
		3 => return -double.infinity;
		4 => return 1.5d;
		5 => return -1.5d;
		6 => return double.view(1uL);
	}
	return 0;
}

def main(a: int) -> int {
	var v = get(a);
	var l = u64.view(v);
	return int.view(l >> 32);
}
