//@execute 0=true; 1=true; 2=true; 3=true; 4=false
def pred1() -> bool #no-inline {
	return true;
}
def pred2() -> bool #inline {
	return true;
}
class C {
	def mz1 = if(pred1(), -0f, 1f);
	def mz2 = if(pred2(), -0f, 1f);
}

def kc = C.new();

def main(a: int) -> bool {
	match (a) {
		0 => return -0f == kc.mz1;
		1 => return -0f == kc.mz2;
		2 => return -0f == C.new().mz1;
		3 => return -0f == C.new().mz2;
	}
	return false;
}