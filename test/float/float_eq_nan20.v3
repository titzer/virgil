//@execute = 111
// double_eq_nan20 for float.
def PAIR: (float, float) = (float.nan, 1f);
def A: Array<(float, float)> = [(float.nan, 1f)];
def INIT = if(PAIR != PAIR, 1, 0);
def main() -> int {
	var folded = if((float.nan, 1f) != (float.nan, 1f), 1, 0);
	var live = if(A[0] != A[0], 1, 0);
	return INIT * 100 + folded * 10 + live;
}
