//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48
// A void component between a float and a double, so erasure shifts both slots.
def a = [
	(0f, (), 0d),
	(-0f, (), -0d),
	(float.nan, (), 0d),
	(0f, (), double.nan),
	(1f, (), 2d),
	(1f, (), 2d)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
