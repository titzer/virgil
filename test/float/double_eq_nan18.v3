//@execute 0=true; 1=false; 2=true; 3=true; 4=true; 5=false
// Constant-folded comparisons over the boundaries of the double range.
def MINSUB = double.view(0x00000000_00000001uL);	// smallest subnormal
def NEGSUB = double.view(0x80000000_00000001uL);	// its negation
def MAXSUB = double.view(0x000FFFFF_FFFFFFFFuL);	// largest subnormal
def MINNORM = double.view(0x00100000_00000000uL);	// smallest normal
def SNAN = double.view(0x7FF00000_00000001uL);		// signaling NaN
def main(i: int) -> bool {
	match (i) {
		0 => return (MINSUB, MINSUB) == (MINSUB, MINSUB);
		1 => return (MINSUB, 0d) == (NEGSUB, 0d);
		2 => return (0d, MINSUB) == (-0d, MINSUB);
		3 => return (double.infinity, 0d - double.infinity) == (double.infinity, 0d - double.infinity);
		4 => return (MAXSUB, MINNORM) == (MAXSUB, MINNORM);
		5 => return (SNAN, 1d) == (SNAN, 1d);
	}
	return false;
}
