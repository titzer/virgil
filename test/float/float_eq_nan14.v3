//@execute 0=3; 1=3; 2=4; 3=8; 4=16; 5=32; 6=0; 7=0
// Tuples over the boundaries of the float range.
def a = [
	(0f, 0f),
	(-0f, -0f),
	(float.view(0x00000001u), float.view(0x00000001u)),	// smallest subnormal
	(float.view(0x80000001u), float.view(0x80000001u)),	// its negation
	(float.infinity, 0f - float.infinity),
	(float.view(0x007FFFFFu), float.view(0x00800000u)),	// largest subnormal, smallest normal
	(float.nan, 0f),
	(0f, float.nan)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
