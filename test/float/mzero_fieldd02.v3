//@execute 0=-2147483648; 1=2146959360; 2=0
// The same, for a component field rather than an object field.
def X: double = -0d;
def Y: double = double.nan;
def Z: double = 0d;
def main(a: int) -> int {
	var d: double;
	match (a) {
		0 => d = X;
		1 => d = Y;
		_ => d = Z;
	}
	return int.view(u64.view(d) >> 32);
}
