//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48
// A four-component tuple, wider than a register pair, mixing all three widths.
def a = [
	(0f, 0d, 7, 0f),
	(-0f, -0d, 7, -0f),
	(float.nan, 0d, 7, 0f),
	(0f, 0d, 7, float.nan),
	(1f, 2d, 7, 3f),
	(1f, 2d, 7, 3f)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
