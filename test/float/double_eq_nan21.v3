//@execute 0=3; 1=3; 2=0; 3=8; 4=16
// A void component is erased by normalization; the double one must still compare by IEEE.
def a = [
	((), 0d),
	((), -0d),
	((), double.nan),
	((), double.infinity),
	((), 1d)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
