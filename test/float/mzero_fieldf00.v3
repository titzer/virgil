//@execute 0=-2147483648; 1=0; 2=2143289344
// A statically initialized object field holding -0.0 must keep its sign bit: the
// initializing store is not a store of the default value and must not be elided.
class C(x: float) { }
def OBJS = [C.new(-0f), C.new(0f), C.new(float.nan)];
def main(a: int) -> int {
	return int.view(OBJS[a].x);
}
