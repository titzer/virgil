//@execute 0=true; 1=true; 2=false; 3=false; 4=false; 5=true; 6=false; 7=false
// double_eq_nan17 for float.
def main(i: int) -> bool {
	match (i) {
		0 => return (0f, 0f) == (0f, 0f);
		1 => return (0f, 0f) == (-0f, -0f);
		2 => return (float.nan, 1f) == (float.nan, 1f);
		3 => return (1f, float.nan) == (1f, float.nan);
		4 => return (float.nan, float.nan) == (float.nan, float.nan);
		5 => return (float.infinity, 1f) == (float.infinity, 1f);
		6 => return (float.nan, 1f) == (1f, float.nan);
		7 => return (0f, 0f) == (0f, 1f);
	}
	return false;
}
