def main() -> int {
	if (u64.view(0e400) != 0uL) return 1;
	if (u64.view(-0e400) != 0x8000000000000000uL) return 2;
	if (u64.view(0.0e-400) != 0uL) return 3;
	if (u64.view(1e-400) != 0uL) return 4;
	if (u64.view(-1e-400) != 0x8000000000000000uL) return 5;
	if (u32.view(0e400f) != 0u) return 6;
	if (u32.view(1e-400f) != 0u) return 7;
	return 0;
}
