//@execute 0=true; 1=true; 2=true; 3=true; 4=false
def pred1() -> bool #no-inline {
	return true;
}
def pred2() -> bool #inline {
	return true;
}
class C<T> {
	def mz1 = if(pred1(), -0d, 1d);
	def mz2 = if(pred2(), -0d, 1d);
	def eq(a: T, b: T) -> bool {
		return a == b;
	}
}

def kc = C<double>.new();

def main(a: int) -> bool {
	match (a) {
		0 => return kc.eq(0d, kc.mz1);
		1 => return kc.eq(0d, kc.mz2);
		2 => return kc.eq(0d, C<double>.new().mz1);
		3 => return kc.eq(0d, C<double>.new().mz2);
	}
	return false;
}