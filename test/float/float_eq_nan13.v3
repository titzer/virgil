//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=0; 6=192; 7=192
// double_eq_nan13 for float.
def a = [
	(0f, 0f),
	(-0f, -0f),
	(0f, -0f),
	(float.nan, 1f),
	(1f, float.nan),
	(float.nan, float.nan),
	(1f, 2f),
	(1f, 2f)
];
def eq<X>(x: X, y: X) -> bool {
	return x == y;
}
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (eq(l, a[j])) out |= (1 << u5.view(j));
	}
	return out;
}
