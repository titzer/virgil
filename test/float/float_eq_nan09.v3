//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48
// double_eq_nan09 for float.
def a = [
	((0f, 0f), (0f, 0f)),
	((-0f, -0f), (-0f, -0f)),
	((float.nan, 0f), (0f, 0f)),
	((0f, 0f), (float.nan, 0f)),
	((1f, 2f), (3f, 4f)),
	((1f, 2f), (3f, 4f))
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
