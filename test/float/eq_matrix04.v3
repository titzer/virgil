//@execute 0=3; 1=3; 2=4; 3=8; 4=0; 5=32; 6=64; 7=!BoundsCheckException
def vals = [0d, -0d, 1d, -1d, double.nan, double.infinity, 0d - double.infinity];

def results = compute();

def compute() -> Array<int> {
	var res = Array<int>.new(vals.length);
	for (i < res.length) res[i] = one(i);
	return res;
}

def one(a: int) -> int {
	var v = vals[a];
	var res = 0;
	for (i < vals.length) {
		if (v == vals[i]) res |= (1 << u5.view(i));
	}
	return res;
}

def main(a: int) -> int {
	return results[a];
}
