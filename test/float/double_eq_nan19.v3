//@execute 0=true; 1=true; 2=false; 3=false; 4=false; 5=true
// The comparisons run during component initialization, not in main.
def ZP: (double, double) = (0d, 0d);
def ZN: (double, double) = (-0d, -0d);
def NP: (double, double) = (double.nan, 1d);
def NQ: (double, double) = (1d, double.nan);
def IP: (double, double) = (double.infinity, 1d);

def R = [
	ZP == ZP,
	ZP == ZN,
	NP == NP,
	NQ == NQ,
	NP == NQ,
	IP == IP
];

def main(i: int) -> bool {
	return R[i];
}
