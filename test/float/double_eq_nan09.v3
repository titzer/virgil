//@execute 0=3; 1=3; 2=0; 3=0; 4=48; 5=48
// Tuples of tuples: the comparison must recurse to a float compare at each leaf.
def a = [
	((0f, 0f), (0d, 0d)),
	((-0f, -0f), (-0d, -0d)),
	((float.nan, 0f), (0d, 0d)),
	((0f, 0f), (double.nan, 0d)),
	((1f, 2f), (3d, 4d)),
	((1f, 2f), (3d, 4d))
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
