//@execute 0=true; 1=true; 2=true; 3=true; 4=false
def pred1() -> bool #no-inline {
	return true;
}
def pred2() -> bool #inline {
	return true;
}
class C<T> {
	def mz1 = if(pred1(), -0f, 1f);
	def mz2 = if(pred2(), -0f, 1f);
	def eq(a: T, b: T) -> bool {
		return a == b;
	}
}

def kc = C<float>.new();

def main(a: int) -> bool {
	match (a) {
		0 => return kc.eq(0f, kc.mz1);
		1 => return kc.eq(0f, kc.mz2);
		2 => return kc.eq(0f, C<float>.new().mz1);
		3 => return kc.eq(0f, C<float>.new().mz2);
	}
	return false;
}