//@execute 0=7; 1=7; 2=7; 3=0; 4=0; 5=0; 6=192; 7=192
// double_eq_nan07 reached through a generic equality.
def a = [
	(0d, 0d),
	(-0d, -0d),
	(0d, -0d),
	(double.nan, 1d),
	(1d, double.nan),
	(double.nan, double.nan),
	(1d, 2d),
	(1d, 2d)
];
def eq<X>(x: X, y: X) -> bool {
	return x == y;
}
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (eq(l, a[j])) out |= (1 << u5.view(j));
	}
	return out;
}
