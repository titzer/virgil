//@execute 0=true; 1=false; 2=false; 3=false
def main(a: int) -> bool {
	var v = (0d, 0d);
	match (a) {
		0 => return eq(v, (0d, 0d));
		1 => return eq(v, (0d, -0d));
		2 => return eq(v, (-0d, 0d));
		3 => return eq(v, (-0d, -0d));
	}
	return false;
}
def eq(a: (double, double), b: (double, double)) -> bool {
	return (u64.view(a.0), u64.view(a.1)) == (u64.view(b.0), u64.view(b.1));
}
