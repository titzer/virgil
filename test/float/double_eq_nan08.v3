//@execute 0=3; 1=3; 2=0; 3=0; 4=144; 5=96; 6=96; 7=144
// A tuple mixing widths: an int, a float and a double.
def a = [
	(7, 0f, 0d),
	(7, -0f, -0d),
	(7, float.nan, 0d),
	(7, 0f, double.nan),
	(8, 0f, 0d),
	(7, 1f, 2d),
	(7, 1f, 2d),
	(8, -0f, -0d)
];
def main(i: int) -> int {
	var l = a[i];
	var out = 0;
	for (j < a.length) {
		if (l == a[j]) out |= (1 << u5.view(j));
	}
	return out;
}
