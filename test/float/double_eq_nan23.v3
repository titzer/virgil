//@execute 0=3; 1=3; 2=0; 3=0
// The default value of a tuple type is all-zero; -0.0 compares equal to it, a NaN
// does not, and both directions of the comparison must agree.
def D: (double, int);
def a = [(0d, 0), (-0d, 0), (double.nan, 0), (0d, 1)];
def main(i: int) -> int {
	var l = D, r = a[i];
	return if(l == r, 1) | if(r == l, 2);
}
