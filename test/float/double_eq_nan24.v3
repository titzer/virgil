//@execute =7
// The default elements of a freshly allocated array of tuples are equal to each
// other, to a hand-built zero tuple and to a negative-zero one, but not to a NaN.
def main() -> int {
	var arr = Array<(double, double)>.new(2);
	var l = arr[0], r = arr[1];
	var out = if(l == r, 1);
	out |= if(l == (0d, 0d), 2);
	out |= if(l == (-0d, -0d), 4);
	out |= if(l == (double.nan, 0d), 8);
	return out;
}
