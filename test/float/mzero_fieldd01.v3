//@execute 0=-2147483648; 1=0; 2=0; 3=-2147483648
// The field is a tuple, so it is normalized into two slots and each one is stored
// separately at initialization time.
class C(v: (double, double)) { }
def OBJS = [C.new((-0d, 0d)), C.new((0d, -0d))];
def main(a: int) -> int {
	var v = OBJS[a & 1].v;
	var d = if((a & 2) == 0, v.0, v.1);
	return int.view(u64.view(d) >> 32);
}
