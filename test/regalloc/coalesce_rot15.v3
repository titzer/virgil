//@execute 0=1120; 1=2150; 3=4420; -1=-120; 7=8960
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: an if-expression whose arms rotate 15 values, producing a merge where
// each phi's two inputs are different live values.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	var v12 = a * 13 + 12;
	var v13 = a * 14 + 13;
	var v14 = a * 15 + 14;
	var t = if((a & 1) == 0, (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14), (v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v0));
	return t.0 * 1 + t.1 * 2 + t.2 * 3 + t.3 * 4 + t.4 * 5 + t.5 * 6 + t.6 * 7 + t.7 * 8 + t.8 * 9 + t.9 * 10 + t.10 * 11 + t.11 * 12 + t.12 * 13 + t.13 * 14 + t.14 * 15;
}
