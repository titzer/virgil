//@execute 0=30
def dirty(n: int) -> long {
	if (n <= 0) return -1;
	var x = (-1L << 32) | long.view(n);
	var a = x|1, b = x|2, c = x|4, d = x|8, e = x|16, f = x|32, g = x|64, h = x|128;
	return a | b | c | d | e | f | g | h | dirty(n - 1);
}
def probe(off: int) -> int {
	var buf: Array<byte> = [10, 20, 30];
	var sum = 0;
	for (b in buf[off ... off + 2]) sum += b;
	return sum;
}
def main(a: int) -> int {
	dirty(4);
	return probe(0);
}
