//@execute 0=120; 1=391; 3=1683; -1=-16; 7=7687
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: a loop where several of the 16 carried values are updated from the same
// source, so the loop header's parallel move has repeated sources.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	var v12 = a * 13 + 12;
	var v13 = a * 14 + 13;
	var v14 = a * 15 + 14;
	var v15 = a * 16 + 15;
	while (a > 0) {
		v0 = v0 + 0;
		v1 = v1 + v2;
		v2 = v2 + v3;
		v3 = v0 + 3;
		v4 = v4 + v5;
		v5 = v5 + v6;
		v6 = v0 + 6;
		v7 = v7 + v8;
		v8 = v8 + v9;
		v9 = v0 + 9;
		v10 = v10 + v11;
		v11 = v11 + v12;
		v12 = v0 + 12;
		v13 = v13 + v14;
		v14 = v14 + v15;
		v15 = v0 + 15;
		a--;
	}
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14 + v15;
}
