//@execute 0=1496; 1=1633; 5=2183; -3=1084
// Sixteen objects live into a loop body that uses a double constant.
class Box(v: int) { }
def main(n: int) -> int {
	var b0 = Box.new(n + 1), b1 = Box.new(n + 2), b2 = Box.new(n + 3), b3 = Box.new(n + 4);
	var b4 = Box.new(n + 5), b5 = Box.new(n + 6), b6 = Box.new(n + 7), b7 = Box.new(n + 8);
	var b8 = Box.new(n + 9), b9 = Box.new(n + 10), b10 = Box.new(n + 11), b11 = Box.new(n + 12);
	var b12 = Box.new(n + 13), b13 = Box.new(n + 14), b14 = Box.new(n + 15), b15 = Box.new(n + 16);
	var r = 0;
	for (i < 1) {
		var d = double.!(n) * 1.5;
		var s = b0.v * 1 + b1.v * 2 + b2.v * 3 + b3.v * 4 + b4.v * 5 + b5.v * 6 + b6.v * 7 + b7.v * 8 + b8.v * 9 + b9.v * 10 + b10.v * 11 + b11.v * 12 + b12.v * 13 + b13.v * 14 + b14.v * 15 + b15.v * 16;
		r = s + int.truncd(d);
	}
	return r;
}
