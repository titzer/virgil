//@execute 0=153; 1=324; 3=666; -1=-18; 7=1350
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 18 values merged through phis and then held live across
// CiTest.killRegisters(), which forces the coalesced ranges to be spilled.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	var v12 = a * 13 + 12;
	var v13 = a * 14 + 13;
	var v14 = a * 15 + 14;
	var v15 = a * 16 + 15;
	var v16 = a * 17 + 16;
	var v17 = a * 18 + 17;
	var t = if(a < 0, (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15, v16, v17), (v17, v16, v15, v14, v13, v12, v11, v10, v9, v8, v7, v6, v5, v4, v3, v2, v1, v0));
	CiTest.killRegisters();
	return t.0 + t.1 + t.2 + t.3 + t.4 + t.5 + t.6 + t.7 + t.8 + t.9 + t.10 + t.11 + t.12 + t.13 + t.14 + t.15 + t.16 + t.17;
}
