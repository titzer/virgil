//@execute 0=91; 1=105; 3=133; -1=77; 7=189
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 14 object references merged through phis; reference moves and the GC
// reference map both depend on the coalesced assignment being consistent.
class C(x: int) { }
def main(a: int) -> int {
	var o0 = C.new(a + 0);
	var o1 = C.new(a + 1);
	var o2 = C.new(a + 2);
	var o3 = C.new(a + 3);
	var o4 = C.new(a + 4);
	var o5 = C.new(a + 5);
	var o6 = C.new(a + 6);
	var o7 = C.new(a + 7);
	var o8 = C.new(a + 8);
	var o9 = C.new(a + 9);
	var o10 = C.new(a + 10);
	var o11 = C.new(a + 11);
	var o12 = C.new(a + 12);
	var o13 = C.new(a + 13);
	var t = if(a < 0, (o0, o1, o2, o3, o4, o5, o6, o7, o8, o9, o10, o11, o12, o13), (o13, o12, o11, o10, o9, o8, o7, o6, o5, o4, o3, o2, o1, o0));
	return t.0.x + t.1.x + t.2.x + t.3.x + t.4.x + t.5.x + t.6.x + t.7.x + t.8.x + t.9.x + t.10.x + t.11.x + t.12.x + t.13.x;
}
