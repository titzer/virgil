//@execute 0=66; 1=156; 3=336; -1=-12; 7=696
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: a loop whose 12 carried values are rotated through a call each iteration,
// mixing loop-header phis with precolored argument and result moves.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	while (a > 0) {
		var t = rot(v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11);
		v0 = t.0;
		v1 = t.1;
		v2 = t.2;
		v3 = t.3;
		v4 = t.4;
		v5 = t.5;
		v6 = t.6;
		v7 = t.7;
		v8 = t.8;
		v9 = t.9;
		v10 = t.10;
		v11 = t.11;
		a--;
	}
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11;
}
def rot(p0: int, p1: int, p2: int, p3: int, p4: int, p5: int, p6: int, p7: int, p8: int, p9: int, p10: int, p11: int) -> (int, int, int, int, int, int, int, int, int, int, int, int) {
	return (p1 + 1, p2 + 1, p3 + 1, p4 + 1, p5 + 1, p6 + 1, p7 + 1, p8 + 1, p9 + 1, p10 + 1, p11 + 1, p0 + 1);
}
