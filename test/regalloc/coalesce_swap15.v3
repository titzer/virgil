//@execute 0=105; 1=330; 3=780; -1=-15; 7=1680
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: a loop that rotates 15 values across the back edge. The phis form one
// long move cycle, so nearly every move is a coalescing candidate.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	var v12 = a * 13 + 12;
	var v13 = a * 14 + 13;
	var v14 = a * 15 + 14;
	while (a > 0) {
		var t0 = v0 + 0;
		var t1 = v1 + 1;
		var t2 = v2 + 2;
		var t3 = v3 + 3;
		var t4 = v4 + 4;
		var t5 = v5 + 5;
		var t6 = v6 + 6;
		var t7 = v7 + 7;
		var t8 = v8 + 8;
		var t9 = v9 + 9;
		var t10 = v10 + 10;
		var t11 = v11 + 11;
		var t12 = v12 + 12;
		var t13 = v13 + 13;
		var t14 = v14 + 14;
		v0 = t1;
		v1 = t2;
		v2 = t3;
		v3 = t4;
		v4 = t5;
		v5 = t6;
		v6 = t7;
		v7 = t8;
		v8 = t9;
		v9 = t10;
		v10 = t11;
		v11 = t12;
		v12 = t13;
		v13 = t14;
		v14 = t0;
		a--;
	}
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13 + v14;
}
