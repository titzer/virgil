//@execute 0=91; 1=105; 3=133; -1=333; 7=189
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 14 byte-sized values through a merge; byte operands carry narrower
// register constraints than the full class.
def main(a: int) -> int {
	var b0 = byte.view(a + 0);
	var b1 = byte.view(a + 1);
	var b2 = byte.view(a + 2);
	var b3 = byte.view(a + 3);
	var b4 = byte.view(a + 4);
	var b5 = byte.view(a + 5);
	var b6 = byte.view(a + 6);
	var b7 = byte.view(a + 7);
	var b8 = byte.view(a + 8);
	var b9 = byte.view(a + 9);
	var b10 = byte.view(a + 10);
	var b11 = byte.view(a + 11);
	var b12 = byte.view(a + 12);
	var b13 = byte.view(a + 13);
	var t = if(a < 0, (b0, b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13), (b13, b12, b11, b10, b9, b8, b7, b6, b5, b4, b3, b2, b1, b0));
	return int.view(t.0) + int.view(t.1) + int.view(t.2) + int.view(t.3) + int.view(t.4) + int.view(t.5) + int.view(t.6) + int.view(t.7) + int.view(t.8) + int.view(t.9) + int.view(t.10) + int.view(t.11) + int.view(t.12) + int.view(t.13);
}
