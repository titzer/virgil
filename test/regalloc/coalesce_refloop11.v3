//@execute 0=55; 1=55; 3=67; -1=55; 7=117
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 11 object references conditionally reassigned in a loop, with
// CiTest.killRegisters() inside, so coalesced reference ranges must spill.
class C(x: int) { }
def main(a: int) -> int {
	var o0: C = C.new(0);
	var o1: C = C.new(1);
	var o2: C = C.new(2);
	var o3: C = C.new(3);
	var o4: C = C.new(4);
	var o5: C = C.new(5);
	var o6: C = C.new(6);
	var o7: C = C.new(7);
	var o8: C = C.new(8);
	var o9: C = C.new(9);
	var o10: C = C.new(10);
	for (i < a) {
		o0 = if((i & 1) != 0, C.new(i + 0), o0);
		o1 = if((i & 2) != 0, C.new(i + 1), o1);
		o2 = if((i & 4) != 0, C.new(i + 2), o2);
		o3 = if((i & 1) != 0, C.new(i + 3), o3);
		o4 = if((i & 2) != 0, C.new(i + 4), o4);
		o5 = if((i & 4) != 0, C.new(i + 5), o5);
		o6 = if((i & 1) != 0, C.new(i + 6), o6);
		o7 = if((i & 2) != 0, C.new(i + 7), o7);
		o8 = if((i & 4) != 0, C.new(i + 8), o8);
		o9 = if((i & 1) != 0, C.new(i + 9), o9);
		o10 = if((i & 2) != 0, C.new(i + 10), o10);
		CiTest.killRegisters();
	}
	return o0.x + o1.x + o2.x + o3.x + o4.x + o5.x + o6.x + o7.x + o8.x + o9.x + o10.x;
}
