//@execute 0=9; 1=9
// Function value live across an allocation, then called indirectly.
class B {
	var len: int;
	def putk(s: string, start: int, end: int) -> B { len += end - start; return this; }
	def put2(s: string, x: int) -> B { len += x; return this; }
}
def apply<T>(f: (B, T) -> B, val: T) -> int {
	var b = B.new();
	f(b, val);
	return b.len;
}
def main(a: int) -> int {
	var r = 0;
	r += apply(B.put2(_, _, 7), "x");
	r += apply(B.putk(_, _, 1, 3), "here");
	return r;
}
