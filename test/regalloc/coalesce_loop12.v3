//@execute 0=66; 1=66; 3=222; -1=-12; 7=534
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: a loop carrying 12 values across the back edge, with a branch inside,
// so the loop header holds 12 phis whose parallel moves are all coalescible.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	while (a > 0) {
		if ((a & 1) == 0) {
			v0 = v0 + 1;
			v1 = v1 + 2;
			v2 = v2 + 3;
			v3 = v3 + 4;
			v4 = v4 + 5;
			v5 = v5 + 6;
			v6 = v6 + 7;
			v7 = v7 + 8;
			v8 = v8 + 9;
			v9 = v9 + 10;
			v10 = v10 + 11;
			v11 = v11 + 12;
		} else {
			v0 = v0 - 1;
			v1 = v1 - 2;
			v2 = v2 - 3;
			v3 = v3 - 4;
			v4 = v4 - 5;
			v5 = v5 - 6;
			v6 = v6 - 7;
			v7 = v7 - 8;
			v8 = v8 - 9;
			v9 = v9 - 10;
			v10 = v10 - 11;
			v11 = v11 - 12;
		}
		a--;
	}
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11;
}
