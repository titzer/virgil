//@execute 0=276; 1=1131; 3=4551; -1=0; 7=18231
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 9 pairs merged through an if-expression, so each phi is over a tuple
// that has been flattened into two values.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var t = if(a < 0, ((v0, v0+1), (v1, v1+1), (v2, v2+1), (v3, v3+1), (v4, v4+1), (v5, v5+1), (v6, v6+1), (v7, v7+1), (v8, v8+1)), ((v8+2, v8), (v7+2, v7), (v6+2, v6), (v5+2, v5), (v4+2, v4), (v3+2, v3), (v2+2, v2), (v1+2, v1), (v0+2, v0)));
	return t.0.0 * t.0.1 + t.1.0 * t.1.1 + t.2.0 * t.2.1 + t.3.0 * t.3.1 + t.4.0 * t.4.1 + t.5.0 * t.5.1 + t.6.0 * t.6.1 + t.7.0 * t.7.1 + t.8.0 * t.8.1;
}
