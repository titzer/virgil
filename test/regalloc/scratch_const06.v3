//@execute 0=1608; 1=1759; 5=2363; -3=1155
// Sixteen ints live into a loop body that sums sixteen doubles, two of them scaled by a double constant.
def main(n: int) -> int {
	var v0 = n + 1, v1 = n + 2, v2 = n + 3, v3 = n + 4, v4 = n + 5, v5 = n + 6, v6 = n + 7, v7 = n + 8;
	var v8 = n + 9, v9 = n + 10, v10 = n + 11, v11 = n + 12, v12 = n + 13, v13 = n + 14, v14 = n + 15, v15 = n + 16;
	var r = 0;
	for (i < 1) {
		var d0 = double.!(n), d1 = d0 + 1d, d2 = d1 + 1d, d3 = d2 + 1d, d4 = d3 + 1d, d5 = d4 + 1d, d6 = d5 + 1d, d7 = d6 + 1d;
		var d8 = d7 + 1d, d9 = d8 + 1d, d10 = d9 + 1d, d11 = d10 + 1d, d12 = d11 + 1d, d13 = d12 + 1d, d14 = d13 + 1d, d15 = d14 + 1d;
		var x = d0 * 0.5 + d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8 + d9 + d10 + d11 + d12 + d13 + d14 + d15 * 0.5;
		var s = v0 * 1 + v1 * 2 + v2 * 3 + v3 * 4 + v4 * 5 + v5 * 6 + v6 * 7 + v7 * 8 + v8 * 9 + v9 * 10 + v10 * 11 + v11 * 12 + v12 * 13 + v13 * 14 + v14 * 15 + v15 * 16;
		r = s + int.truncd(x);
	}
	return r;
}
