//@execute 0=1498; 1=1636; 5=2190; -3=1084
// Sixteen ints live into a loop body that uses two double constants.
def main(n: int) -> int {
	var v0 = n + 1, v1 = n + 2, v2 = n + 3, v3 = n + 4, v4 = n + 5, v5 = n + 6, v6 = n + 7, v7 = n + 8;
	var v8 = n + 9, v9 = n + 10, v10 = n + 11, v11 = n + 12, v12 = n + 13, v13 = n + 14, v14 = n + 15, v15 = n + 16;
	var r = 0;
	for (i < 1) {
		var x = double.!(n) * 1.5;
		var s1 = v0 * 1 + v1 * 2 + v2 * 3 + v3 * 4 + v4 * 5 + v5 * 6 + v6 * 7 + v7 * 8;
		var y = double.!(n) + 2.25;
		var s2 = v8 * 9 + v9 * 10 + v10 * 11 + v11 * 12 + v12 * 13 + v13 * 14 + v14 * 15 + v15 * 16;
		r = s1 + s2 + int.truncd(x) + int.truncd(y);
	}
	return r;
}
