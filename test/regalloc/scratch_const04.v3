//@execute 0=33; 1=453; 5=1493; -3=501
// Sixteen longs live into a loop body that adds a double constant.
def main(n: int) -> int {
	var b = long.!(n) << 33;
	var v0 = b + 1, v1 = b + 2, v2 = b + 3, v3 = b + 4, v4 = b + 5, v5 = b + 6, v6 = b + 7, v7 = b + 8;
	var v8 = b + 9, v9 = b + 10, v10 = b + 11, v11 = b + 12, v12 = b + 13, v13 = b + 14, v14 = b + 15, v15 = b + 16;
	var r = 0L;
	for (i < 1) {
		var d = double.!(n) + 0.75;
		var s = v0 ^ v1 ^ (v2 * 3) ^ (v3 * 5) ^ (v4 * 7) ^ (v5 * 9) ^ (v6 * 11) ^ (v7 * 13) ^ (v8 * 15) ^ (v9 * 17) ^ (v10 * 19) ^ (v11 * 21) ^ (v12 * 23) ^ (v13 * 25) ^ (v14 * 27) ^ (v15 * 29);
		r = s + long.truncd(d * 4d);
	}
	return int.view(r ^ (r >> 29));
}
