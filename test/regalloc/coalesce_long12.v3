//@execute 0=66; 1=144; 3=300; -1=-12; 7=612
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 12 64-bit values through a merge.
def main(a: int) -> int {
	var v0 = long.view(a) * 1 + 0;
	var v1 = long.view(a) * 2 + 1;
	var v2 = long.view(a) * 3 + 2;
	var v3 = long.view(a) * 4 + 3;
	var v4 = long.view(a) * 5 + 4;
	var v5 = long.view(a) * 6 + 5;
	var v6 = long.view(a) * 7 + 6;
	var v7 = long.view(a) * 8 + 7;
	var v8 = long.view(a) * 9 + 8;
	var v9 = long.view(a) * 10 + 9;
	var v10 = long.view(a) * 11 + 10;
	var v11 = long.view(a) * 12 + 11;
	var t = if(a < 0, (v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11), (v11, v10, v9, v8, v7, v6, v5, v4, v3, v2, v1, v0));
	return int.view(t.0 + t.1 + t.2 + t.3 + t.4 + t.5 + t.6 + t.7 + t.8 + t.9 + t.10 + t.11);
}
