//@execute 0=67; 1=138; 3=324; -1=-12; 7=644
// Regression for register coalescing. With coalescing enabled, the interference
// graph is the only place where a node's degree can go back *up* (merging a node
// into another adds its edges), so a node can cross the "trivially colorable"
// threshold downward more than once. When the worklists were plain vectors rather
// than sets, such a node was enqueued and simplified twice, decrementing every
// neighbor's degree twice, and the coloring then ran out of registers.
// Shape: 12 chained self-assigning phis, v = if(c, v, w), the exact pattern that
// coalescing is meant to remove entirely.
def main(a: int) -> int {
	var v0 = a * 1 + 0;
	var v1 = a * 2 + 1;
	var v2 = a * 3 + 2;
	var v3 = a * 4 + 3;
	var v4 = a * 5 + 4;
	var v5 = a * 6 + 5;
	var v6 = a * 7 + 6;
	var v7 = a * 8 + 7;
	var v8 = a * 9 + 8;
	var v9 = a * 10 + 9;
	var v10 = a * 11 + 10;
	var v11 = a * 12 + 11;
	v0 = if((a & 1) != 0, v0, v1);
	v1 = if((a & 2) != 0, v1, v2);
	v2 = if((a & 4) != 0, v2, v3);
	v3 = if((a & 8) != 0, v3, v4);
	v4 = if((a & 16) != 0, v4, v5);
	v5 = if((a & 1) != 0, v5, v6);
	v6 = if((a & 2) != 0, v6, v7);
	v7 = if((a & 4) != 0, v7, v8);
	v8 = if((a & 8) != 0, v8, v9);
	v9 = if((a & 16) != 0, v9, v10);
	v10 = if((a & 1) != 0, v10, v11);
	v11 = if((a & 2) != 0, v11, v0);
	return v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11;
}
