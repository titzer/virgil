//@execute 0=0; 1=1; 2=1; 3=2; 4=1; 7=3; 8=0; 12=1; 255=3; -1=3
enum E { A, B, C }
def main(a: int) -> int {
	var sum = 0, count = 0;
	for (e in E.set.view(a)) { sum += e.tag; count++; }
	var expected = 0;
	for (i < 3) if ((a & (1 << byte.view(i))) != 0) expected += i;
	if (sum != expected) return -100;
	return count;
}
