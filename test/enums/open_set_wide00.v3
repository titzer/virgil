//@execute 0=1; 1=1; 2=32; 3=1; 4=-1
// A set of an enum hierarchy with 32 tags (a 32-bit set).
enum E {
	A0, A1, A2, A3, A4, A5, A6, A7, A8, A9, A10, A11, A12, A13, A14, A15,
	_
}
enum E.M {
	B0, B1, B2, B3, B4, B5, B6, B7, B8, B9, B10, B11, B12, B13, B14, B15
}
def main(a: int) -> int {
	var s: E.set;
	match (a) {
		0 => { s = E.A0 | E.M.B15; return if(s < E.set.all, 1, 0); }
		1 => { for (e in E) s |= e; return if(s == E.set.all, 1, 0); }
		2 => { var n = 0; for (e in E.set.all) n++; return n; }
		3 => { var m: E.M.set = E.M.B15; return if(E.M.B15.tag == 31 && m == (E.set.all & E.M.B15), 1, 0); }
	}
	return -1;
}
