//@execute = 3063
enum E {
	C00,C01,C02,C03,C04,C05,C06,C07,C08,C09,C10,C11,C12,C13,C14,C15,
	C16,C17,C18,C19,C20,C21,C22,C23,C24,C25,C26,C27,C28,C29,C30,C31,
	C32
}
def main() -> int {
	// a 33-case enum uses a wider-than-32-bit set representation
	var s = E.C00 | E.C31 | E.C32;
	var count = 0, sum = 0;
	for (e in s) {
		count++;
		sum += e.tag;
	}
	return count * 1000 + sum;
}
