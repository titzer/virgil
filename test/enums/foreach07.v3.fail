//@execute 0=-110; 1=-110; 2=-111; 3=-112
// A type-case in a match over an enum value never matches; the default arm is taken
// instead, even though the equivalent type query (E.?<E>) returns true.
enum E { A, B, C }

def sets: Array<E.set> = [
	E.A,
	E.A | E.B,
	E.B | E.C,
	E.C
];

def main(a: int) -> int {
	var set = sets[a];
	var sum = 0;
	for (e in set) {
		match (e) {
			x: E => return -110 - x.tag;
			_ => sum += 1;
		}
	}
	return sum;
}