//@execute 0=42; 1=42; 2=42; 3=42; 4=42; 5=42; 6=42; 7=42; 8=42; 15=42; -1=42; 256=42
enum E { A, B, C }

def vals = [E.A, E.B, E.C];

def main(a: int) -> int {
	var expected: E.set;
	for (i < vals.length) {
		var e = vals[i];
		if ((a & (1 << e.tag)) != 0) expected |= e;
	}
	var got = E.set.view(a);
	if (got != expected) return -44;
	return 42;
}
