//@execute 0=1; 1=1; 2=1; 3=1; 4=1; 5=1; 6=1; 7=1; 8=-1
enum E3 { A, B, C }
enum E8 { A, B, C, D, E, F, G, H }
enum E16 { A, B, C, D, E, F, G, H, I, J, K, L, M, N, O, P }
def main(a: int) -> int {
	var m1: i8 = -1, m128: i8 = -128, p127: i8 = 127;
	match (a) {
		0 => return if(E3.set.view(m1) == E3.set.all, 1);
		1 => return if(E8.set.view(m1) == E8.set.all, 1);
		2 => return if(E16.set.view(m1) == E16.set.all, 1); // sign-extended, then viewed
		3 => return if(int.view(E8.set.view(m128)) == 128, 1);
		4 => return if(int.view(E16.set.view(m128)) == 0xFF80, 1);
		5 => return if(int.view(E3.set.view(m128)) == 0, 1);
		6 => return if(int.view(E16.set.view(p127)) == 127, 1);
		7 => return if(E3.set.view(p127) == E3.set.all, 1);
	}
	return -1;
}
