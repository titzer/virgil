//@execute 0=12; 1=34; 2=304; 3=-1
// Subtype enums are named through their parent: two roots may each have a More.
enum E { A, _; def f(x: E.More) -> int { return 10 + x.tag; } }
enum E.More { C, D, _ }
enum E.More.Sub { G }
enum F { X, Y, _; def f(x: F.More) -> int { return 30 + x.tag; } }
enum F.More { Z, W, _ }
enum F.More.Sub { H }
def main(a: int) -> int {
	match (a) {
		0 => return E.A.f(E.More.D) + 0 * E.More.Sub.G.tag;
		1 => return F.X.f(F.More.Z) + 0 * F.More.Sub.H.tag + 2;
		2 => return E.More.Sub.G.tag * 100 + F.More.Sub.H.tag;
	}
	return -1;
}
