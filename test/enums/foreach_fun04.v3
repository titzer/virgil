//@execute 0=0; 1=1063; 2=1032; 3=2095; 4=1000; 5=2063; 6=2032; 7=3095
enum E {
	C00,C01,C02,C03,C04,C05,C06,C07,C08,C09,C10,C11,C12,C13,C14,C15,
	C16,C17,C18,C19,C20,C21,C22,C23,C24,C25,C26,C27,C28,C29,C30,C31,
	C32,C33,C34,C35,C36,C37,C38,C39,C40,C41,C42,C43,C44,C45,C46,C47,
	C48,C49,C50,C51,C52,C53,C54,C55,C56,C57,C58,C59,C60,C61,C62,C63
}
def mk(a: int) -> E.set {
	// build a sparse 64-bit set dynamically, including the highest bit
	var s: E.set;
	if ((a & 1) != 0) s |= E.C63;
	if ((a & 2) != 0) s |= E.C32;
	if ((a & 4) != 0) s |= E.C00;
	return s;
}
def summarize(s: E.set) -> int {
	var count = 0, sum = 0;
	for (e in s) {
		count++;
		sum += e.tag;
	}
	return count * 1000 + sum;
}
def main(a: int) -> int {
	return summarize(mk(a));
}
