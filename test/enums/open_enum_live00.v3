//@execute 0=20; 1=20; 2=40; 3=30; 4=47; 5=99
// A case reached only from the heap (a component field, an array, a class field,
// or an enum set) dispatches to its own override; no constant of it is in code.
enum E { A { def m() -> int { return 10; } }, B { def m() -> int { return 20; } }, _;
	def m() -> int { return 1; } }
enum E.More { C { def m() -> int { return 30; } }, D { def m() -> int { return 40; } };
	def m() -> int { return 2; } }
component C { var x = E.B; }
def arr: Array<E> = [E.B, E.More.D];
class K(e: E) { }
def k = K.new(E.More.C);
def set: E.set = E.A | E.More.D;
def main(a: int) -> int {
	match (a) {
		0 => return C.x.m();
		1 => return arr[0].m();
		2 => return arr[1].m();
		3 => return k.e.m();
		4 => { var sum = 0; for (e in set) sum += e.m() - e.tag; return sum; }
	}
	return 99;
}
