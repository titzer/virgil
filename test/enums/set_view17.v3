//@execute (0,0)=1; (1,3)=1; (3,1)=0; (7,7)=1; (15,7)=1; (8,0)=1; (2,5)=0; (-1,7)=1; (6,7)=1
enum E { A, B, C }
def main(a: int, b: int) -> int {
	var x = E.set.view(a), y = E.set.view(b);
	var sub = (a & 7 & ~(b & 7)) == 0;
	var strict = sub && (a & 7) != (b & 7);
	if ((x <= y) != sub) return -100;
	if ((x < y) != strict) return -101;
	if ((y >= x) != sub) return -102;
	if ((y > x) != strict) return -103;
	return if(sub, 1, 0);
}
