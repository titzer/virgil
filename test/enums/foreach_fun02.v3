//@execute 0=0; 1=100; 2=20; 3=120; 4=3; 5=103; 6=23; 7=123
enum E { A, B, C }
def mk(a: int) -> E.set {
	var s: E.set;
	if ((a & 1) != 0) s |= E.A;
	if ((a & 2) != 0) s |= E.B;
	if ((a & 4) != 0) s |= E.C;
	return s;
}
def sum(s: E.set) -> int {
	// match over the loop variable with full case coverage
	var r = 0;
	for (e in s) {
		match (e) {
			A => r += 100;
			B => r += 20;
			C => r += 3;
		}
	}
	return r;
}
def main(a: int) -> int {
	return sum(mk(a));
}
