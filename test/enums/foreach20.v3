//@execute 0=0; 1=1; 2=2; 3=3
enum E { A, B, C }
def none: E.set;
def sets: Array<E.set> = [
	none,
	E.B,
	E.A | E.C,
	E.A | E.B | E.C
];
def main(a: int) -> int {
	// a same-type cast and type query on the loop variable both succeed
	var count = 0;
	for (e in sets[a]) {
		if (!E.?<E>(e)) return -1;
		if (E.!<E>(e) != e) return -2;
		count++;
	}
	return count;
}
