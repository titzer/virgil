//@execute 0=0; 1=1; 5=5; 7=7; 8=0; 255=7; 256=0
enum E { A, B, C }
def toSet = E.set.view<int>;
def toByteSet: byte -> E.set = E.set.view;
def toInt = int.view<E.set>;
def apply<A, B>(f: A -> B, x: A) -> B { return f(x); }
def main(a: int) -> int {
	var s1 = toSet(a);
	var s2 = toByteSet(byte.view(a));
	var s3 = apply(E.set.view<int>, a);
	if (s1 != s2 || s2 != s3) return -100;
	if (apply(toInt, s1) != int.view(s1)) return -101;
	return toInt(s3);
}
