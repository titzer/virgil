//@execute 0=true; 1=false; 2=true; 3=false; 4=true; 5=false
enum E { A, B, C }
def S = E.set.view(5);
def T = E.set.view(-1);
def U = E.set.view(8);
def main(a: int) -> bool {
	match (a) {
		0 => return S.A && !S.B && S.C;
		1 => return S == E.set.all;
		2 => return T == E.set.all;
		3 => return U.A || U.B || U.C;
		4 => return E.set.view(6) == (E.B | E.C);
		5 => return E.set.view(7) != E.set.all;
	}
	return false;
}
