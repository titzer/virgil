//@execute 0=0; 1=100; 2=20; 3=120; 4=3; 5=123
enum E { A, B, C }
def none: E.set;
def sets: Array<E.set> = [
	none,
	E.A,
	E.B,
	E.A | E.B,
	E.C,
	E.A | E.B | E.C
];
def main(a: int) -> int {
	// match over the loop variable with full case coverage
	var sum = 0;
	for (e in sets[a]) {
		match (e) {
			A => sum += 100;
			B => sum += 20;
			C => sum += 3;
		}
	}
	return sum;
}
