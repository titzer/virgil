//@execute 0=1; 1=30; 2=-3; 3=50; 4=-3; 5=50
// A top-level extension on a subtype enum, named through its parent, overrides the
// root's method, and a case of the subtype overrides the extension.
enum E { A, _; def m() -> int { return 1; } }
enum E.More { C, D { def m() -> int { return 30; } }, _ }
enum E.More.Deep { F, G { def m() -> int { return 50; } } }
def E.More.Deep.m() -> int { return -3; }
def values: Array<E> = [E.A, E.More.D, E.More.Deep.F, E.More.Deep.G];
def main(a: int) -> int {
	if (a < 4) return values[a].m();
	var d: E.More.Deep = if(a == 4, E.More.Deep.F, E.More.Deep.G);
	return d.m();
}
