//@execute 0=30; 1=40; 2=0; 3=50; 4=1; 5=1; 6=2; 7=5; 8=-1
// A method declared by a subtype enum, overridden per case, called through the
// subtype; the root's method still dispatches correctly on the same cases.
enum E { A, B, _; def m() -> int { return 1; } }
enum E.More {
	C { def n() -> int { return 30; } },
	D { def n() -> int { return 40; } },
	F { def m() -> int { return 2; } },
	G { def m() -> int { return 5; } def n() -> int { return 50; } };
	def n() -> int { return 0; }
}
def subs = [E.More.C, E.More.D, E.More.F, E.More.G];
def main(a: int) -> int {
	match (a) {
		0, 1, 2, 3 => return subs[a].n();
		4, 5, 6, 7 => { var x: E = subs[a - 4]; return x.m(); }
	}
	return -1;
}
