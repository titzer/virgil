//@execute 0=0; 1=1; 2=2; 3=4; 4=5; 5=7; 6=0; 7=6
enum E { A, B, C }
def sets: Array<E.set> = [
	E.set.view(0),
	E.A,
	E.B,
	E.C,
	E.A | E.C,
	E.set.all,
	E.set.all - E.set.all,
	(E.A | E.B | E.C) - E.A
];
def main(a: int) -> int {
	var s = sets[a];
	var i = int.view(s), b = byte.view(s), l = long.view(s), ul = u64.view(s), u3 = u3.view(s);
	if (b != i) return -100;
	if (l != i) return -101;
	if (ul != u64.view(i)) return -102;
	if (u3 != i) return -103;
	return i;
}
