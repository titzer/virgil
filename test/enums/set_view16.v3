//@execute 0=0; 1=1; 2=0; 3=1; 4=0; 5=1
enum E { A, B, C }
def main(a: int) -> int {
	var one = u1.view(a);
	var s = E.set.view(one);
	if (s.B || s.C) return -100;
	var i1 = i1.view(a);
	var t = E.set.view(i1); // i1 -1 sign-extends to all bits set
	if (t != if(i1 == 0, E.set.view(0), E.set.all)) return -101;
	return int.view(s);
}
