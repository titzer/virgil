//@execute 0=1; 1=0; 2=0; 31=0; 32=2; 33=0; 34=0; 63=0
enum Big {
	C00, C01, C02, C03, C04, C05, C06, C07, C08, C09,
	C10, C11, C12, C13, C14, C15, C16, C17, C18, C19,
	C20, C21, C22, C23, C24, C25, C26, C27, C28, C29,
	C30, C31, C32
}
def main(a: int) -> int {
	var l = 1L << u6.view(a);
	var s = Big.set.view(l);
	var r = 0;
	if (s.C00) r |= 1;
	if (s.C32) r |= 2;
	for (c in s) if (c.tag != a) return -100;
	return r;
}
