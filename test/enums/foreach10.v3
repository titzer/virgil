//@execute 0=0; 1=1; 2=13; 3=134; 4=2; 5=24; 6=1234
enum E { A, B, C, D }
def none: E.set;
def sets: Array<E.set> = [
	none,
	E.A,
	E.A | E.C,
	E.A | E.C | E.D,
	E.B,
	E.B | E.D,
	E.A | E.B | E.C | E.D
];
def main(a: int) -> int {
	// checks that iteration proceeds in ascending tag order
	var digits = 0;
	for (e in sets[a]) digits = digits * 10 + e.tag + 1;
	return digits;
}
