//@execute 0=0; 1=3; 2=7; 3=10; 4=11; 5=14; 6=18; 7=21
enum E(v: int) { A(3), B(7), C(11) }
def mk(a: int) -> E.set {
	var s: E.set;
	if ((a & 1) != 0) s |= E.A;
	if ((a & 2) != 0) s |= E.B;
	if ((a & 4) != 0) s |= E.C;
	return s;
}
def sum(s: E.set) -> int {
	// access an enum parameter through the loop variable
	var r = 0;
	for (e in s) r += e.v;
	return r;
}
def main(a: int) -> int {
	return sum(mk(a));
}
