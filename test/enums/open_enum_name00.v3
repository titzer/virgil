//@execute 0=1; 1=1; 2=1; 3=1; 4=1; 5=1; 6=1; 7=1; 8=1; 9=-1
// A case's name is qualified from the root of its hierarchy whatever the static
// type it is read through; its shortName is the case name alone.
enum E { A, _ }
enum E.More { C { def m() -> int { return 1; } }, _; def m() -> int { return 0; } }
enum E.More.Deeper { X }
def eq(a: string, b: string) -> int {
	if (a.length != b.length) return 0;
	for (i < a.length) if (a[i] != b[i]) return 0;
	return 1;
}
def main(a: int) -> int {
	var c: E.More = E.More.C, x: E.More.Deeper = E.More.Deeper.X;
	var ec: E = c, ex: E = x, mx: E.More = x;
	match (a) {
		0 => return eq(E.More.C.name, "More.C");
		1 => return eq(c.name, "More.C");
		2 => return eq(ec.name, "More.C");
		3 => return eq(E.More.Deeper.X.name, "More.Deeper.X");
		4 => return eq(x.name, "More.Deeper.X") & eq(mx.name, "More.Deeper.X");
		5 => return eq(ex.name, "More.Deeper.X");
		6 => return eq(E.More.C.shortName, "C") & eq(c.shortName, "C") & eq(ec.shortName, "C");
		7 => return eq(x.shortName, "X") & eq(mx.shortName, "X") & eq(ex.shortName, "X");
		8 => return eq(E.A.name, "A");
	}
	return -1;
}
