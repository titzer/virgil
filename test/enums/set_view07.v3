//@execute 0=64; 1=1; 2=2; 3=64; 4=63; 5=1; 6=0
enum Bits {
	B00, B01, B02, B03, B04, B05, B06, B07, B08, B09, B10, B11, B12, B13, B14, B15,
	B16, B17, B18, B19, B20, B21, B22, B23, B24, B25, B26, B27, B28, B29, B30, B31,
	B32, B33, B34, B35, B36, B37, B38, B39, B40, B41, B42, B43, B44, B45, B46, B47,
	B48, B49, B50, B51, B52, B53, B54, B55, B56, B57, B58, B59, B60, B61, B62, B63
}
def count(s: Bits.set) -> int {
	var r = 0;
	for (b in s) r++;
	return r;
}
def main(a: int) -> int {
	match (a) {
		0 => { var s = Bits.set.view(-1L); if (s != Bits.set.all) return -100; return count(s); }
		1 => { var s = Bits.set.view(0x8000000000000000uL); if (!s.B63) return -101; return count(s); }
		2 => { var s = Bits.set.view(0x8000000000000001uL); if (!s.B63 || !s.B00) return -102; return count(s); }
		3 => { var s = Bits.set.view(-1); return count(s); } // int -1 sign-extends to all 64 bits
		4 => { var s = Bits.set.view(0x7FFFFFFFFFFFFFFFL); return count(s); }
		5 => { var s = Bits.set.view(u8.view(1)); return count(s); }
		6 => { var s = Bits.set.view(0); return count(s); }
	}
	return -1;
}
