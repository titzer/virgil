//@execute 0=0; 1=1; 2=2; 3=12; 4=3; 5=13; 6=23; 7=123
enum E { A, B, C }
def mk(a: int) -> E.set {
	var s: E.set;
	if ((a & 1) != 0) s |= E.A;
	if ((a & 2) != 0) s |= E.B;
	if ((a & 4) != 0) s |= E.C;
	return s;
}
def digits(s: E.set) -> int {
	// checks that iteration proceeds in ascending tag order
	var d = 0;
	for (e in s) d = d * 10 + e.tag + 1;
	return d;
}
def main(a: int) -> int {
	return digits(mk(a));
}
