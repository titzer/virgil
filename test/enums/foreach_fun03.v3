//@execute 0=1; 1=1; 2=1; 3=1; 4=1; 5=1; 6=1; 7=1
enum E { A, B, C }
def mk(a: int) -> E.set {
	var s: E.set;
	if ((a & 1) != 0) s |= E.A;
	if ((a & 2) != 0) s |= E.B;
	if ((a & 4) != 0) s |= E.C;
	return s;
}
def check(s: E.set) -> int {
	// a set-typed loop variable receives singleton sets; their union is the original set
	var u: E.set;
	for (x: E.set in s) u = u | x;
	return if(u == s, 1, 0);
}
def main(a: int) -> int {
	return check(mk(a));
}
