//@execute 0=1; 1=1; 2=1; 3=1
enum E { A, B, C }
def none: E.set;
def sets: Array<E.set> = [
	none,
	E.A,
	E.B | E.C,
	E.A | E.B | E.C
];
def main(a: int) -> int {
	// a set-typed loop variable receives singleton sets; their union is the original set
	var s = sets[a];
	var u: E.set;
	for (x: E.set in s) u = u | x;
	return if(u == s, 1, 0);
}
