//@execute 0=0; 1=4; 2=7; 3=13; 4=5; 5=5; 6=-1
// The common supertype of enum values from different levels of a hierarchy is
// their nearest common ancestor, for if expressions and array literals.
enum E { A, B, _ }
enum E.More { C, _ }
enum E.More.Deeper { X, Y }
enum E.More.Other { Z }
def main(a: int) -> int {
	match (a) {
		0 => { var x = if(a == 0, E.A, E.More.C); return x.tag; }
		1 => { var x = if(a == 0, E.More.C, E.More.Deeper.Y); return x.tag; }
		2 => { var x = if(a == 0, E.More.Deeper.X, E.More.Other.Z); var y: E.More = x; return y.tag + 2; }
		3 => { var s = 0; for (e in [E.A, E.More.C, E.More.Deeper.X, E.More.Deeper.Y, E.More.Other.Z]) s += e.tag; return s - 1; }
		4 => { var arr = [E.More.Deeper.Y, E.More.Other.Z]; var m: Array<E.More> = arr; return arr.length + m[1].tag - 2; }
		5 => { var arr = [E.More.Deeper.X, E.B, E.More.C]; var e: Array<E> = arr; return arr.length + e[1].tag + 1; }
	}
	return -1;
}
