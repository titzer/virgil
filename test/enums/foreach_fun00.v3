//@execute 0=0; 1=1; 2=1; 3=2; 4=1; 5=2; 6=2; 7=3
enum E { A, B, C }
def mk(a: int) -> E.set {
	// build the set dynamically so the loop's internal operations cannot be folded
	var s: E.set;
	if ((a & 1) != 0) s |= E.A;
	if ((a & 2) != 0) s |= E.B;
	if ((a & 4) != 0) s |= E.C;
	return s;
}
def count(s: E.set) -> int {
	var n = 0;
	for (e in s) n++;
	return n;
}
def main(a: int) -> int {
	return count(mk(a));
}
