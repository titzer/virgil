//@execute 0=1; 1=20; 2=-2; 3=40; 4=7; 5=-2; 6=40; 7=1
// A method added to an open enum root by a top-level extension behaves as if declared
// in the root: cases and subtype enums override it, through the root and the subtype.
enum Op { NOP, ADD { def interpret(x: int) -> int { return 20; } }, _ }
enum Op.Ext {
	PLAIN,
	DOUBLE { def interpret(x: int) -> int { return x * 8; } };
	def interpret(x: int) -> int { return -2; }
}
enum Op.Other { SEVEN { def interpret(x: int) -> int { return 7; } } }
def Op.interpret(x: int) -> int { return 1; }
def ops: Array<Op> = [Op.NOP, Op.ADD, Op.Ext.PLAIN, Op.Ext.DOUBLE, Op.Other.SEVEN];
def main(a: int) -> int {
	if (a < 5) return ops[a].interpret(5);
	if (a < 7) {
		var e: Op.Ext = if(a == 5, Op.Ext.PLAIN, Op.Ext.DOUBLE);
		return e.interpret(5);
	}
	var f = Op.interpret;
	return f(Op.NOP, 5);
}
