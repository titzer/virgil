//@execute = 100
// Described objects that exist only as records, branded at runtime.
class D describes A { }
class SA { }
class A extends SA descriptor D { }
def d = D.new();
def objs: Array<SA> = [A.new(d), SA.new()];

def main() -> int {
	var ok = A.?(objs[0]) && !A.?(objs[1]);
	CiRuntime.setDescriptorExtension(d, 0, 2 * Pointer.SIZE);
	CiTest.forceGc();
	if (!A.?(objs[0])) return 2;
	if (A.?(objs[1])) return 3;
	return if(ok, 100, 1);
}
