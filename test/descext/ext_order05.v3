//@execute = 100
class DA(n: int) describes A { }
class DB extends DA describes B { new(n: int) super(n) { } }
class A descriptor DA { }
class B extends A descriptor DB { }
def da = DA.new(1);
def db = DB.new(2);
var objs: Array<A>;

def main() -> int {
	objs = [A.new(da), B.new(db)];
	var ok = !B.?(objs[0]) && B.?(objs[1]);
	CiRuntime.setDescriptorExtension(db, 0, 2 * Pointer.SIZE); // only the subclass descriptor
	if (objs[0].descriptor.n != 1) return 1;
	if (objs[1].descriptor.n != 2) return 2;
	return if(ok, 100, 3);
}
