//@execute = 100
class D describes A { }
class SA { }
class A extends SA descriptor D { }
def d = D.new();
var objs: Array<SA>;

def main() -> int {
	var ok = use();
	brand();
	return if(ok, 100, 1);
}
def use() -> bool {
	objs = [A.new(d), SA.new()];
	return A.?(objs[0]) && !A.?(objs[1]);
}
def brand() {
	CiRuntime.setDescriptorExtension(d, 0, 2 * Pointer.SIZE);
}
