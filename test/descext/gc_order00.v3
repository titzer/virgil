//@execute = 100
class E(v: int) { }
class D describes A { }
class SA { }
class A extends SA descriptor D { }
def d = D.new();
var objs: Array<SA>;

def main() -> int {
	objs = [A.new(d), SA.new()];
	var ok = A.?(objs[0]) && !A.?(objs[1]);
	CiRuntime.setDescriptorExtension(d, 0, 2 * Pointer.SIZE);
	CiTest.forceGc();
	if (!A.?(objs[0])) return 1;
	if (A.?(objs[1])) return 2;
	return if(ok, 100, 3);
}
