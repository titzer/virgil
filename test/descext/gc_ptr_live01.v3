//@execute = 100
//@heap-size=16384
// A Pointer derived from an object field (Pointer.atField) that is live across an allocation and a GC.
class E(v: int) { }
class C(var f: E) { }

var c: C;

def main() -> int {
	c = C.new(null);
	var p = Pointer.atField(c.f);
	p.store<E>(E.new(33));
	CiTest.forceGc();
	if (c.f == null) return 1;
	if (c.f.v != 33) return 2;
	return 100;
}
