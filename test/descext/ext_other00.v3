//@execute = 100
// Only the first hierarchy is branded; the second must still keep its descriptor field.
class D1 describes A1 { }
class A1 descriptor D1 { }
class D2 describes A2 { }
class SA2 { }
class A2 extends SA2 descriptor D2 { }
def d1 = D1.new();
def d2 = D2.new();
var objs: Array<SA2>;
var a1: A1;

def main() -> int {
	a1 = A1.new(d1);
	objs = [A2.new(d2), SA2.new()];
	var ok = A2.?(objs[0]) && !A2.?(objs[1]);
	CiRuntime.setDescriptorExtension(d1, 0, 2 * Pointer.SIZE);
	return if(ok, 100, 1);
}
