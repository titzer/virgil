//@execute = 100
class D<T> describes A<T> { }
class SA<T> { }
class A<T> extends SA<T> descriptor D<T> { }
def d = D<int>.new();
var objs: Array<SA<int>>;

def main() -> int {
	objs = [A<int>.new(d), SA<int>.new()];
	var ok = A<int>.?(objs[0]) && !A<int>.?(objs[1]);
	CiRuntime.setDescriptorExtension(d, 0, 2 * Pointer.SIZE);
	return if(ok, 100, 1);
}
