//@execute = 100
class D(n: int) describes A { }
class SA { }
class A extends SA descriptor D { }
def d = D.new(4);
var objs: Array<SA>;

def main() -> int {
	objs = [A.new(d)];
	var v = A.!(objs[0]).descriptor.n;
	CiRuntime.setDescriptorExtension(d, 0, 2 * Pointer.SIZE);
	return if(v == 4, 100, 1);
}
