//@execute = 100
class D describes A { }
class SA { }
class A extends SA descriptor D { }
def d = D.new();
var objs: Array<SA>;

def main() -> int {
	objs = [A.new(d), SA.new()];
	var ok = A.?(objs[0]) && !A.?(objs[1]);
	CiRuntime.setDescriptorExtension(d, 0, 2 * Pointer.SIZE); // branded last
	return if(ok, 100, 1);
}
