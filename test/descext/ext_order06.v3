//@execute = 100
// Only the subclass's descriptor is branded, and the descriptor field is never read by the
// program: the queries are its only use, so nothing else keeps it alive.
class DA describes A { }
class DB extends DA describes B { }
class A descriptor DA { }
class B extends A descriptor DB { }
def da = DA.new();
def db = DB.new();
var objs: Array<A>;

def main() -> int {
	objs = [A.new(da), B.new(db)];
	var ok = !B.?(objs[0]) && B.?(objs[1]);
	CiRuntime.setDescriptorExtension(db, 0, 2 * Pointer.SIZE);
	return if(ok, 100, 1);
}
