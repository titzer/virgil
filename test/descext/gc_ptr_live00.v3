//@execute = 100
//@heap-size=16384
// A Pointer derived from an object (Pointer.atEnd) that is live across allocations and a GC.
// Such an interior pointer must not be treated as a reference root by the shadow stack spiller,
// since scanning it as an object would corrupt the heap.
class E(v: int) { }
class D describes C { }
class C descriptor D { }

def d = D.new();
var c: C;

def main() -> int {
	// 1 header word + 2 extension words, both references: bits 1 and 2, terminator at bit 3.
	CiRuntime.setDescriptorExtension(d, 0xE, 3 * Pointer.SIZE);
	c = C.new(d);
	var p = Pointer.atEnd(c);
	var e1 = E.new(11);
	p.store<E>(e1);
	var e2 = E.new(22);
	(p + Pointer.SIZE).store<E>(e2);
	CiTest.forceGc();
	var q = Pointer.atEnd(c);
	if (q.load<E>().v != 11) return 1;
	if ((q + Pointer.SIZE).load<E>().v != 22) return 2;
	if (q.load<E>() != e1) return 3;
	return 100;
}
