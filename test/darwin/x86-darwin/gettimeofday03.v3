//@execute = true
// gettimeofday takes THREE arguments on darwin; the third is a {uint64*}
// the kernel copies mach_absolute_time out through. It has to be passed
// explicitly even when unwanted, or the kernel writes 8 bytes through
// whatever happens to occupy that argument slot. See gettimeofday10.
def SYS_GETTIMEOFDAY = 116;
def timeval: Array<int> = Array.new(2);
def timezone: Array<int> = Array.new(2);
def main() -> bool {
	var tv = Pointer.atContents(timeval), tz = Pointer.atContents(timezone);
	Darwin.syscall(SYS_GETTIMEOFDAY, (tv, tz, Pointer.NULL));
	var val = timeval[0];
	return val != 0;
}
