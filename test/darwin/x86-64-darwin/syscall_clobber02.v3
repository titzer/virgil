//@execute = 110
// Regression test for the gettimeofday third-argument bug.
//
// Reduced from a Lox interpreter, where every program calling the `clock`
// builtin corrupted the heap. The cause was not a register clobber, despite how
// it looks: XNU's gettimeofday takes three arguments, and the third is a
// {uint64*} the kernel copies mach_absolute_time out through. Calling it with
// two arguments leaves whatever the caller last put in the third kernel
// argument register (RDX) as the destination, and the kernel writes 8 bytes of
// timestamp through it.
//
// The shape below is what makes RDX hold something worth destroying: {check()}
// returns with the object read out of {g} still in RDX, then the indirect call
// through {n.invoke} reaches a callee that neither sets nor needs RDX, so the
// syscall inherits it. The kernel then overwrites the object's meta word and
// {arity} field. The reference survives -- g[0] is still == n -- which is why
// this presents as data corruption rather than a crash.
//
// Encoded as before*100 + after*10 + n.arity, so 110 is the correct answer:
// the type query on the object in g[0] holds both before and after the call and
// the arity is still the 0 it was constructed with. Before the fix this
// returned 110 plus the high half of mach_absolute_time in nanoseconds, a value
// that steps by one roughly every 4.3 seconds of uptime.
//
// See gettimeofday10 for the ABI contract, and the same failure through
// System.ticksUs() in test/rt/x86-64-darwin/ticks_no_clobber*.v3.
def SYS_GETTIMEOFDAY = 0x2000074;
def timeval = Array<long>.new(2);
type Value #unboxed { case Num(v: double); case Ref(obj: Obj); }
class Obj { }
class Native extends Obj {
	def arity: int;
	def invoke: Array<Value> -> Value;
	new(arity, invoke) { }
}
def g = Array<Value>.new(1);
class Ticker {
	var start = 3;
	def tick(args: Array<Value>) -> Value {
		Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.NULL));
		var e = double.roundi(timeval[1]);
		return Value.Num(e);
	}
}
def check() -> int {
	match (g[0]) { Ref(o) => return if(Native.?(o), 1, 0); _ => return -1; }
}
def main() -> int {
	var n = Native.new(0, Ticker.new().tick);
	g[0] = Value.Ref(n);
	var before = check();
	var r = n.invoke(Array<Value>.new(0));
	var after = check();
	return before * 100 + after * 10 + n.arity;
}
