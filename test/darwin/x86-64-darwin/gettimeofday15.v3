//@execute = true
// x86-64 version of gettimeofday07: tv_usec really is microseconds. On x86-64
// it is a 32-bit field followed by 4 bytes of padding, so reading it as the
// second long of the timeval gives the value with the padding zeroed.
def SYS_GETTIMEOFDAY = 0x2000074;	// BSD class bit | 116, required on x86-64
def timeval = Array<long>.new(2);
def main() -> bool {
	var tv = Pointer.atContents(timeval), n: Pointer;
	Darwin.syscall(SYS_GETTIMEOFDAY, (tv, n, n));
	var usecs = timeval[1];
	return usecs >= 0 && usecs <= 999999; // should be microseconds
}
