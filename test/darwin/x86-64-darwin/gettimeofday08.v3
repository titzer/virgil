//@execute = true
// x86-64 struct timeval is { i64 tv_sec; i32 tv_usec; }, i.e. 16 bytes with
// padding, so the buffer must be Array<long>.new(2). gettimeofday03..07 use
// Array<int>.new(2), which is correct for 32-bit darwin but only 8 bytes here.
//
// Two other things this form gets right, both easy to miss: the syscall number
// needs the BSD class bit (a bare 116 raises SIGSYS on x86-64), and
// gettimeofday takes THREE arguments -- see gettimeofday10.
def SYS_GETTIMEOFDAY = 0x2000074;	// BSD class bit | 116, required on x86-64
def timeval = Array<long>.new(2);
def main() -> bool {
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.NULL));
	return timeval[0] > 1000000000;	// seconds since 1970
}
