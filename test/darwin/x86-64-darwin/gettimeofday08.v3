//@execute = true
// Seconds since 1970, read with the 64-bit timeval layout: { i64; i32 }.
def SYS_GETTIMEOFDAY = 0x2000074;	// BSD class bit | 116, required on x86-64
def timeval = Array<long>.new(2);
def main() -> bool {
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.NULL));
	return timeval[0] > 1000000000;	// seconds since 1970
}
