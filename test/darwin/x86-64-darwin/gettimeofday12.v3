//@execute = true
// x86-64 version of gettimeofday03: the seconds field comes back non-zero when
// a timezone buffer is supplied. struct timezone is still two ints here, but
// struct timeval is not: it is { i64 tv_sec; i32 tv_usec; }.
def SYS_GETTIMEOFDAY = 0x2000074;	// BSD class bit | 116, required on x86-64
def timeval = Array<long>.new(2);
def timezone: Array<int> = Array.new(2);
def main() -> bool {
	var tv = Pointer.atContents(timeval), tz = Pointer.atContents(timezone);
	Darwin.syscall(SYS_GETTIMEOFDAY, (tv, tz, Pointer.NULL));
	var val = timeval[0];
	return val != 0;
}
