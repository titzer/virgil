//@execute = 46
def SYS_STAT = 0x20000BC;
def CF_FLAG = 1;
def stat: Array<long> = Array.new(18);
def main() -> int {
	if (doStat(Darwin.syscall(SYS_STAT, _)) != 0) return -1;
	return int.!(stat[9]);
}
def doStat(f: (Pointer, Pointer) -> (long, long, long)) -> long {
	var path = Pointer.atContents("test.txt\x00");
	return f(path, Pointer.atContents(stat)).2 & CF_FLAG;
}
