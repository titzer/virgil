//@execute = true
// The third argument is an 8-byte out-parameter: exactly one uint64 written,
// nothing on either side of it.
def SYS_GETTIMEOFDAY = 0x2000074;
def CANARY = 0x5A5A5A5A5A5A5A5A;
def timeval = Array<long>.new(2);
def buf = Array<long>.new(5);
def main() -> bool {
	for (i < buf.length) buf[i] = CANARY;
	// the out-parameter is buf[2]; buf[0..1] and buf[3..4] must survive.
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.atContents(buf) + 16));
	if (buf[2] == CANARY) return false;	// must have been written
	return buf[0] == CANARY && buf[1] == CANARY && buf[3] == CANARY && buf[4] == CANARY;
}
