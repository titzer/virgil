//@execute = true
// Same as syscall_clobber00, with live object references rather than scalars.
// Their fields are read back afterwards; a clobbered pointer register shows up
// as corrupted data.
def SYS_GETTIMEOFDAY = 0x2000074;
def timeval = Array<long>.new(2);
class Box(id: int) { }
def main() -> bool {
	var a = Box.new(1), b = Box.new(2), c = Box.new(3), d = Box.new(4);
	var e = Box.new(5), f = Box.new(6), g = Box.new(7), h = Box.new(8);
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.NULL));
	return a.id == 1 && b.id == 2 && c.id == 3 && d.id == 4
		&& e.id == 5 && f.id == 6 && g.id == 7 && h.id == 8;
}
