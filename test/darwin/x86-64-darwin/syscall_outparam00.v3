//@execute = 0
// Probe for hidden out-parameters: hand each syscall the runtime issues a
// canary pointer in every argument slot it is not supposed to read, and check
// the kernel wrote to none of them. gettimeofday, whose third argument must be
// written, is the positive control. A non-zero result names the failing case.
def CANARY = 0x5A5A5A5A5A5A5A5A;

def SYS_read		= 0x2000003;
def SYS_write		= 0x2000004;
def SYS_open		= 0x2000005;
def SYS_close		= 0x2000006;
def SYS_gettimeofday	= 0x2000074;
def SYS_stat		= 0x20000BC;
def SYS_lseek		= 0x20000C7;

def O_RDONLY = 0;
def O_WRONLY = 1;
def SEEK_END = 2;

def slots = Array<long>.new(5);		// canary destinations, one per spare arg
def iobuf = Array<byte>.new(64);
def statbuf = Array<long>.new(18);
def timeval = Array<long>.new(2);
def path = "test.txt\x00";
def devnull = "/dev/null\x00";

def reset() {
	for (i < slots.length) slots[i] = CANARY;
}
// address of the {i}th canary slot, to be handed to the kernel as a spare arg
def p(i: int) -> Pointer {
	return Pointer.atContents(slots) + (i * 8);
}
def intact() -> bool {
	for (i < slots.length) if (slots[i] != CANARY) return false;
	return true;
}

def main() -> int {
	// close(fd) reads 1 argument
	reset();
	Darwin.syscall(SYS_close, (101, p(0), p(1), p(2), p(3), p(4)));
	if (!intact()) return 1;

	// open(path, flags, mode) reads 3 arguments
	reset();
	var fd = Darwin.syscall(SYS_open, (Pointer.atContents(path), O_RDONLY, 0, p(0), p(1), p(2))).0;
	if (!intact()) return 2;
	if (fd < 0) return 3;

	// read(fd, buf, len) reads 3 arguments
	reset();
	var n = Darwin.syscall(SYS_read, (fd, Pointer.atContents(iobuf), 16, p(0), p(1), p(2))).0;
	if (!intact()) return 4;
	if (n != 16) return 5;

	// lseek(fd, offset, whence) reads 3 arguments
	reset();
	var end = Darwin.syscall(SYS_lseek, (fd, 0L, SEEK_END, p(0), p(1), p(2))).0;
	if (!intact()) return 6;
	if (end <= 0) return 7;

	Darwin.syscall(SYS_close, fd);

	// stat(path, buf) reads 2 arguments
	reset();
	var r = Darwin.syscall(SYS_stat, (Pointer.atContents(path), Pointer.atContents(statbuf), p(0), p(1), p(2), p(3))).0;
	if (!intact()) return 8;
	if (r != 0) return 9;

	// write(fd, buf, len) reads 3 arguments
	reset();
	fd = Darwin.syscall(SYS_open, (Pointer.atContents(devnull), O_WRONLY, 0)).0;
	if (fd < 0) return 10;
	var w = Darwin.syscall(SYS_write, (fd, Pointer.atContents(iobuf), 8, p(0), p(1), p(2))).0;
	if (!intact()) return 11;
	if (w != 8) return 12;
	Darwin.syscall(SYS_close, fd);

	// gettimeofday(tp, tzp, mach) reads 3 arguments and writes through the third
	reset();
	Darwin.syscall(SYS_gettimeofday, (Pointer.atContents(timeval), Pointer.NULL, p(0), p(1), p(2), p(3)));
	if (slots[0] == CANARY) return 13;	// mach_absolute_time must land here
	if (slots[1] != CANARY || slots[2] != CANARY || slots[3] != CANARY) return 14;

	return 0;
}
