//@execute = true
def SYS_getentropy = 0x20001F4;
def CF_FLAG = 1;
def main() -> bool {
	var len = 100;
	var array = Array<u8>.new(len);
	var t = Darwin.syscall(SYS_getentropy, (Pointer.atContents(array), len));
	if ((t.2 & CF_FLAG) != 0) return false;

	for (i = 0; i < array.length; i++) {
		if (array[i] != 0) return true;
	}
	return false;
}
