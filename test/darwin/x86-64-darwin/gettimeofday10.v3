//@execute = true
// XNU's gettimeofday takes THREE arguments, not two:
//
//   int gettimeofday(struct timeval *tp, struct timezone *tzp, uint64_t *mach);
//
// When {mach} is non-null the kernel copies mach_absolute_time out through it.
// This test pins that contract down, because it is the whole reason a caller
// must pass the third argument explicitly: leaving it off does not mean "no
// third argument", it means "use whatever the caller last left in the third
// kernel argument register as a destination pointer". See syscall_clobber02
// for what that costs, and gettimeofday11 for the size of the write.
def SYS_GETTIMEOFDAY = 0x2000074;
def timeval = Array<long>.new(2);
def mach = Array<long>.new(1);
def main() -> bool {
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.atContents(mach)));
	var first = mach[0];
	if (first <= 0) return false;	// kernel must have written it
	// mach_absolute_time is monotonic; it must advance within a few calls.
	for (i < 1000) {
		Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.atContents(mach)));
		if (mach[0] > first) return true;
	}
	return false;
}
