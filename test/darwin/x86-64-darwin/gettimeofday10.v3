//@execute = true
// XNU's gettimeofday takes THREE arguments:
//
//   int gettimeofday(struct timeval *tp, struct timezone *tzp, uint64_t *mach);
//
// The third is an out-parameter: when non-null the kernel copies
// mach_absolute_time out through it. Omitting it does not mean "no third
// argument", it means the kernel writes 8 bytes through whatever the caller
// last left in the third kernel argument register. That is how a two-argument
// call in the darwin runtime silently overwrote live heap objects.
def SYS_GETTIMEOFDAY = 0x2000074;
def timeval = Array<long>.new(2);
def mach = Array<long>.new(1);
def main() -> bool {
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.atContents(mach)));
	var first = mach[0];
	if (first <= 0) return false;	// kernel must have written it
	// mach_absolute_time is monotonic; it must advance within a few calls.
	for (i < 1000) {
		Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.atContents(mach)));
		if (mach[0] > first) return true;
	}
	return false;
}
