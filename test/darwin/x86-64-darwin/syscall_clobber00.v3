//@execute = true
// Many live scalars must survive a syscall.
def SYS_GETTIMEOFDAY = 0x2000074;
def timeval = Array<long>.new(2);
def main() -> bool {
	var a = 1L, b = 2L, c = 3L, d = 4L, e = 5L, f = 6L;
	var g = 7L, h = 8L, i = 9L, j = 10L, k = 11L, l = 12L;
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(timeval), Pointer.NULL, Pointer.NULL));
	return a == 1 && b == 2 && c == 3 && d == 4 && e == 5 && f == 6
		&& g == 7 && h == 8 && i == 9 && j == 10 && k == 11 && l == 12;
}
