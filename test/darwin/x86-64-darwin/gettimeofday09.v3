//@execute = true
// Check that SYS_GETTIMEOFDAY writes only the 16 bytes of the timeval it is
// handed. The canaries sit immediately before and after it in one array.
def SYS_GETTIMEOFDAY = 0x2000074;	// BSD class bit | 116, required on x86-64
def CANARY = 0x5A5A5A5A5A5A5A5A;
def buf = Array<long>.new(6);
def main() -> bool {
	for (i < buf.length) buf[i] = CANARY;
	// timeval occupies buf[2] and buf[3]; buf[0..1] and buf[4..5] must survive.
	Darwin.syscall(SYS_GETTIMEOFDAY, (Pointer.atContents(buf) + 16, Pointer.NULL, Pointer.NULL));
	return buf[0] == CANARY && buf[1] == CANARY && buf[4] == CANARY && buf[5] == CANARY;
}
