//@execute = 46
def SYS_LSEEK = 0x20000C7;
def SYS_OPEN = 0x2000005;
def CF_FLAG = 1;
def SEEK_CUR: int = 1;
def SEEK_END: int = 2;
def SEEK_SET: int = 0;
def main() -> int {
	return available(Darwin.syscall(SYS_OPEN, (Pointer.atContents("test.txt\x00"), 0, 0)).0);
}
def available(fd: long) -> int {
	var t = Darwin.syscall(SYS_LSEEK, (fd, 0L, SEEK_CUR)), current = t.0;
	if ((t.2 & CF_FLAG) != 0) return 0;
	var end = Darwin.syscall(SYS_LSEEK, (fd, 0L, SEEK_END)).0;
	Darwin.syscall(SYS_LSEEK, (fd, current, SEEK_SET));
	return int.!(end - current);
}
