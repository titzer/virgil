//@execute = 36
def SYS_OPEN = 0x2000005;
def SYS_READ = 0x2000003;
def SYS_LSEEK = 0x20000C7;
def SEEK_CUR: int = 1;
def SEEK_END: int = 2;
def SEEK_SET: int = 0;
def iobuf: Array<byte> = Array.new(10);
def main() -> int {
	var fd = Darwin.syscall(SYS_OPEN, (Pointer.atContents("test.txt\x00"), 0, 0)).0;
	if (Darwin.syscall(SYS_READ, (fd, Pointer.atContents(iobuf), 10)).0 != 10) return -2;
	return available(fd);
}
def available(fd: long) -> int {
	var current = Darwin.syscall(SYS_LSEEK, (fd, 0L, SEEK_CUR)).0;
	var end = Darwin.syscall(SYS_LSEEK, (fd, 0L, SEEK_END)).0;
	Darwin.syscall(SYS_LSEEK, (fd, current, SEEK_SET));
	return int.!(end - current);
}
