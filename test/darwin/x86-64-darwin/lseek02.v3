//@execute = 46
def SYS_OPEN = 0x2000005;
def SYS_LSEEK = 0x20000C7;
def CF_FLAG = 1;
def SEEK_END: int = 2;
def main() -> int {
	var t = Darwin.syscall(SYS_OPEN, (Pointer.atContents("test.txt\x00"), 0, 0));
	if ((t.2 & CF_FLAG) != 0) return -1;
	return int.!(Darwin.syscall(SYS_LSEEK, (t.0, 0L, SEEK_END)).0);
}
