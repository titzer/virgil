def T = UnitTests.registerT("dbgedit:", _, DbgLineEditorTester.new, _);
def X_ = void(
	T("cooked", testCooked),
	T("cookedEof", testCookedEof),
	T("insert", testInsert),
	T("backspace", testBackspace),
	T("cursor", testCursor),
	T("kill", testKill),
	T("history", testHistory),
	T("historyEdit", testHistoryEdit),
	T("eof", testEof),
	T("complete1", testComplete1),
	T("completePrefix", testCompletePrefix),
	T("completeList", testCompleteList),
	T("completeNone", testCompleteNone),
	()
);

def COMMANDS = ["break ", "backtrace ", "continue ", "delete "];

class DbgLineEditorTester(t: Tester) {
	var input: string;
	var pos: int;
	def output = StringBuilder.new();
	var editor: DbgLineEditor;

	def start(tty: bool, input: string) -> this {
		this.input = input;
		pos = 0;
		output.reset();
		editor = DbgLineEditor.new(tty, read, write);
		editor.completer = complete;
	}
	def read() -> int {
		return if(pos < input.length, input[pos++], -1);
	}
	def write(s: string) {
		output.puts(s);
	}
	// Completes the first word from {COMMANDS}.
	def complete(line: string, cursor: int) -> DbgCompletion {
		var start = cursor;
		while (start > 0 && line[start - 1] != ' ') start--;
		if (start > 0) return DbgCompletion(start, null);
		var word = Arrays.range(line, 0, cursor);
		var v = Vector<string>.new();
		for (c in COMMANDS) if (Strings.startsWith(c, word)) v.put(c);
		return DbgCompletion(start, v.extract());
	}
	def expect(lines: Array<string>) -> this {
		for (l in lines) {
			var got = editor.readLine(">");
			if (l == null) {
				if (got != null) t.fail1("expected end of input, got \"%s\"", got);
			} else if (got == null) {
				t.fail1("expected \"%s\", got end of input", l);
			} else if (!Strings.equal(l, got)) {
				t.fail2("expected \"%s\", got \"%s\"", l, got);
			}
		}
	}
	def expectOutputContains(s: string) -> this {
		var out = Arrays.range(output.buf, 0, output.length);
		for (i < out.length - s.length + 1) {
			if (Arrays.equal(Arrays.range(out, i, i + s.length), s)) return;
		}
		t.fail1("expected output to contain \"%s\"", s);
	}
}

def testCooked(t: DbgLineEditorTester) {
	t.start(false, "run\nb foo 3\r\n\nc\n").expect(["run", "b foo 3", "", "c", null]);
	// The terminal echoes input in cooked mode, so only the prompts are written.
	t.expectOutputContains(">>>>>");
}
def testCookedEof(t: DbgLineEditorTester) {
	t.start(false, "q").expect(["q", null]);
	t.start(false, "").expect([null]);
}
def testInsert(t: DbgLineEditorTester) {
	t.start(true, "abc\n").expect(["abc"]).expectOutputContains(">abc\n");
}
def testBackspace(t: DbgLineEditorTester) {
	t.start(true, "abx\x7Fc\n").expect(["abc"]);
	t.start(true, "abx\x08c\n").expect(["abc"]);
	t.start(true, "\x7F\x7Fa\n").expect(["a"]);
}
def testCursor(t: DbgLineEditorTester) {
	// left arrow, insert in the middle
	t.start(true, "ac\x1B[Db\n").expect(["abc"]);
	// ctrl-A, ctrl-E, ctrl-B, ctrl-F
	t.start(true, "bc\x01a\x05d\n").expect(["abcd"]);
	t.start(true, "ac\x02b\x06d\n").expect(["abcd"]);
	// home, end, and delete keys
	t.start(true, "bc\x1B[Ha\x1B[Fd\n").expect(["abcd"]);
	t.start(true, "abxc\x1B[D\x1B[D\x1B[3~\n").expect(["abc"]);
	// moving past either end has no effect
	t.start(true, "a\x1B[D\x1B[D\x1B[Db\x1B[C\x1B[C\x1B[Cc\n").expect(["bac"]);
	// ctrl-D deletes under the cursor
	t.start(true, "abxc\x02\x02\x04\n").expect(["abc"]);
}
def testKill(t: DbgLineEditorTester) {
	t.start(true, "abc def\x15x\n").expect(["x"]);
	t.start(true, "abc def\x17x\n").expect(["abc x"]);
	t.start(true, "abc def\x01\x06\x0B\n").expect(["a"]);
}
def testHistory(t: DbgLineEditorTester) {
	t.start(true, "one\ntwo\n\x1B[A\n\x1B[A\x1B[A\n\x10\x10\x10\x0E\n").expect(["one", "two", "two", "one", "two"]);
	// a line repeated immediately is recorded once
	t.start(true, "a\na\nb\n\x1B[A\x1B[A\x1B[A\n").expect(["a", "a", "b", "a"]);
	t.t.assertz(true, t.editor.history.length == 3);
}
def testHistoryEdit(t: DbgLineEditorTester) {
	// moving down past the newest entry restores the line being edited
	t.start(true, "one\ntw\x1B[A\x1B[Bo\n").expect(["one", "two"]);
}
def testEof(t: DbgLineEditorTester) {
	t.start(true, "\x04").expect([null]);
	t.start(true, "ab").expect(["ab", null]);
}
def testComplete1(t: DbgLineEditorTester) {
	t.start(true, "br\tfoo\n").expect(["break foo"]);
	t.start(true, "c\t\n").expect(["continue "]);
}
def testCompletePrefix(t: DbgLineEditorTester) {
	// "b" is a prefix of two candidates that share only "b"; nothing is inserted
	t.start(true, "b\ta\n").expect(["ba"]);
	t.start(true, "ba\t\n").expect(["backtrace "]);
}
def testCompleteList(t: DbgLineEditorTester) {
	// a second tab lists the candidates and redraws the line
	t.start(true, "b\t\t\n").expect(["b"]).expectOutputContains("\nbreak  backtrace\n\r>b");
}
def testCompleteNone(t: DbgLineEditorTester) {
	t.start(true, "x\t\t\n").expect(["x"]);
	t.start(true, "b \t\n").expect(["b "]);
}
