def T = UnitTests.registerT("val:", _, ValueTester.new, _);
def X_ = void(
	T("IntBox", testIntBox),
	T("LongBox", testLongBox),
	T("BoolBox", testBoolBox),
	T("BoxVal", testBoxVal),
	T("BoxValFloat", testBoxValFloat),
	T("BoxValRecord", testBoxValRecord),
	T("FloatVal32", testFloatVal32),
	T("FloatVal64", testFloatVal64),
	T("ArrayRecord", testArrayRecord),
	T("ClassRecord", testClassRecord),
	T("VariantRecord", testVariantRecord),
	T("VariantRecordFloat", testVariantRecordFloat),
	T("DefaultRecord", testDefaultRecord),
	T("DefaultRecordFloat", testDefaultRecordFloat),
	T("RecursiveRecord", testRecursiveRecord),
	T("RecursiveDefaultRecord", testRecursiveDefaultRecord),
	T("EquivalenceClasses", testEquivalenceClasses),
	()
);

def newVariantType = SsaGraphBuildingHelper.newVariantType;
def newClassType = SsaGraphBuildingHelper.newClassType;

def BOTTOM = Values.BOTTOM;
def INT_ONE = Int.box(1);
def INT_TWO = Int.box(2);
def INT_MIN = Int.box(int.min);
def LONG_ONE = Long.box(1);
def LONG_MAX = Long.box(long.max);
def BOOL_TRUE = Bool.box(true);

def box1(v: Val) -> Val {
	return BoxVal.new([v]);
}

def box2(a: Val) -> Val {
	return BoxVal.new([a, a]);
}

private class ValueTester(t: Tester) {
	def prog = Program.new();

	// Allocate a fresh record with the given values.
	def record(rtype: Type, vals: Array<Val>) -> Record {
		var r = prog.newRecord(rtype, vals.length);
		for (i < vals.length) r.values[i] = vals[i];
		return r;
	}
	// Allocate a fresh default (i.e. bottom) record.
	def defaultRecord(rtype: Type, len: int) -> Record {
		return prog.newDefaultRecord(rtype, len);
	}
	def assertIsDefault(expected: bool, r: Record) {
		if (r.isDefault() != expected) t.fail1("expected isDefault() == %z", expected);
	}
	def fail2v(fmt: string, a: Val, b: Val) {
		return t.fail(StringBuilder.new().put2(fmt, V3.renderResult(a, null, _), V3.renderResult(b, null, _)).toString());
	}
	def assertEq(a: Val, b: Val) {
		if (!Values.equal(a, b)) return fail2v("expected %q == %q", a, b);
		if (!Values.equal(b, a)) return fail2v("expected %q == %q (non-reflexive)", b, a);
		assertHash(a, b);
	}
	def assertNotEq(a: Val, b: Val) {
		if (Values.equal(a, b)) return fail2v("expected %q != %q", a, b);
		if (Values.equal(b, a)) return fail2v("expected %q != %q (non-reflexive)", b, a);
	}
	def assertId(a: Val, b: Val) {
		if (!Values.identical(a, b)) return fail2v("expected %q identical %q", a, b);
		if (!Values.identical(b, a)) return fail2v("expected %q identical %q (non-reflexive)", b, a);
	}
	def assertNotIdEq(a: Val, b: Val) {
		assertNotId(a, b);
		assertEq(a, b);
	}
	def assertIdEq(a: Val, b: Val) {
		assertId(a, b);
		assertEq(a, b);
	}
	def assertIdNotEq(a: Val, b: Val) {
		assertId(a, b);
		assertNotEq(a, b);
	}
	def assertNotId(a: Val, b: Val) {
		if (Values.identical(a, b)) return fail2v("expected %q !identical %q", a, b);
		if (Values.identical(b, a)) return fail2v("expected %q !identical %q (non-reflexive)", b, a);
	}
	def assertHash(a: Val, b: Val) {
		var ha = Values.hash(a), hb = Values.hash(b);
		if (ha != hb) return fail2v("expected hash(%q) == hash(%q)", a, b);
	}
	def assertAllPairs(a: Range<Val>, diag: (Val, Val) -> void, nondiag: (Val, Val) -> void) {
		for (i < a.length) for (j < a.length) {
			if (i == j) diag(a[i], a[j]);
			else nondiag(a[i], a[j]);
		}
	}
	def assertEqSet(a: Range<Val>) {
		assertAllPairs(a, assertEq, assertEq);
	}
	def assertIdSet(a: Range<Val>) {
		assertAllPairs(a, assertId, assertId);
	}
	def assertNeSet(a: Range<Val>) {
		assertAllPairs(a, assertEq, assertNotEq);
	}
}

def testIntBox(t: ValueTester) {
	def box = Int.box;

	t.assertIdSet([BOTTOM, Int.ZERO, box(0), box(0)]);
	t.assertIdSet([Int.ONE, box(1), box(1)]);
	t.assertIdSet([Int.TWO, box(2), box(2)]);
	t.assertIdSet([Int.FOUR, box(4), box(4)]);
	t.assertIdSet([Int.MINUS_1, box(-1), box(-1)]);

	t.assertNeSet([Int.ZERO, Int.ONE, Int.TWO, Int.FOUR, Int.MINUS_1]);

	for (i in [99, -87, 89734, 1239, int.min, int.max]) {
		t.assertIdSet([box(i), box(i)]);
	}
}

def testLongBox(t: ValueTester) {
	def box: long -> Val = Long.box;

	t.assertIdSet([BOTTOM, box(0), box(0)]);

	var longs: Array<long> = [97, -88, 89733, 12398, long.min, long.max];
	for (i in longs) t.assertIdSet([box(i), box(i)]);

	var vals = Arrays.map(longs, box);
	t.assertNeSet(vals);
}

def testBoolBox(t: ValueTester) {
	var T = Bool.TRUE, F = Bool.FALSE;
	def box = Bool.box;
	t.assertId(T, T);
	t.assertId(F, F);

	t.assertId(box(true), T);
	t.assertId(box(false), F);

	t.assertNotEq(T, F);

	t.assertNotEq(T, box(false));
	t.assertNotEq(F, box(true));

	t.assertIdSet([BOTTOM, Bool.FALSE, box(false), box(false)]);
}

def testBoxVal(t: ValueTester) {
	var box = BoxVal.new;

	t.assertIdSet([box([]), box([])]);

	var vals: Array<Val> = [BOTTOM, INT_ONE, INT_MIN, BOOL_TRUE, LONG_MAX];
	for (v in vals) {
		t.assertIdSet([box1(v), box1(v)]);
		t.assertIdSet([box2(v), box2(v)]);
	}

	t.assertNeSet(Arrays.map(vals, box1));
	t.assertNeSet(Arrays.map(vals, box2));

	var zeroes = [BOTTOM, Int.ZERO, Int.box(0), Long.box(0), Bool.FALSE, Bool.box(false)];
	for (v in zeroes) {
		t.assertIdSet([null, box1(v), box1(v)]);
		t.assertIdSet([null, box2(v), box2(v)]);
	}
	// TODO: more complex tests with closures
}

// A tuple of floats is compared element-by-element, so it inherits the tricky cases:
// +0 and -0 are equal but not identical, and NaNs are identical by bits but never equal.
def testBoxValFloat(t: ValueTester) {
	def box = BoxVal.new;
	def PZ = Float.F32_ZERO, MZ = Float.F32_MINUS_ZERO, NAN = Float.F32_NAN;
	def NAN2 = Float32Val.new(0x7fc00001);

	t.assertIdEq(box([PZ]), box([Float32Val.new(0)]));
	t.assertIdEq(box([MZ]), box([Float32Val.new(0x80000000u)]));
	t.assertNotIdEq(box([PZ]), box([MZ]));
	t.assertNotIdEq(box([MZ, PZ]), box([PZ, MZ]));

	t.assertIdNotEq(box([NAN]), box([Float32Val.new(0x7fc00000)]));
	t.assertNotId(box([NAN]), box([NAN2]));
	t.assertNotEq(box([NAN]), box([NAN2]));
	t.assertNotEq(box([INT_ONE, NAN]), box([INT_ONE, NAN]));

	// a tuple containing a NaN is identical to, but not equal to, itself
	var b = box([NAN]);
	t.assertId(b, b);
	t.assertNotEq(b, b);

	// a tuple of +0 is the bottom value; one of -0 is equal to it, but not identical
	t.assertIdEq(BOTTOM, box([PZ, PZ]));
	t.assertNotIdEq(BOTTOM, box([MZ]));
	t.assertNotEq(BOTTOM, box([NAN]));

	// same, for doubles
	def DPZ = Float.F64_ZERO, DMZ = Float.F64_MINUS_ZERO, DNAN = Float.F64_NAN;
	t.assertNotIdEq(box([DPZ]), box([DMZ]));
	t.assertIdNotEq(box([DNAN]), box([Float64Val.new(0x7ff8000000000000)]));
	t.assertIdEq(BOTTOM, box([DPZ]));
	t.assertNotIdEq(BOTTOM, box([DMZ]));
}

// Tuples containing records compare their elements with the records' own rules:
// structurally for variants, by reference for arrays and objects.
def testBoxValRecord(t: ValueTester) {
	def box = BoxVal.new;
	def VT = newVariantType("BoxedVar", 2);
	def AT = V3Array.newType(Int.TYPE);

	var v1 = t.record(VT, [INT_ONE]), v2 = t.record(VT, [INT_ONE]);
	t.assertIdEq(box([v1]), box([v2]));
	t.assertIdEq(box([v1, v2]), box([v2, v1]));
	t.assertNotEq(box([v1]), box([t.record(VT, [INT_TWO])]));
	t.assertNotId(box([v1]), box([t.record(VT, [INT_TWO])]));

	// a tuple of default variants is the bottom value, but holds an object reference
	t.assertNotIdEq(BOTTOM, box([t.record(VT, [Int.ZERO])]));
	t.assertNotIdEq(BOTTOM, box([t.defaultRecord(VT, 1)]));
	t.assertNotEq(BOTTOM, box([v1]));

	// arrays are compared by reference, so a tuple of them is too
	var a1 = t.record(AT, [INT_ONE]), a2 = t.record(AT, [INT_ONE]);
	t.assertIdEq(box([a1]), box([a1]));
	t.assertNotEq(box([a1]), box([a2]));
	t.assertNotId(box([a1]), box([a2]));
	t.assertNotEq(BOTTOM, box([a1]));
}

// Arrays are mutable and have reference identity; two distinct records are never equal,
// no matter their contents, and are never the bottom value.
def testArrayRecord(t: ValueTester) {
	def AT = V3Array.newType(Int.TYPE);
	var r1 = t.record(AT, [INT_ONE, INT_TWO]);
	var r2 = t.record(AT, [INT_ONE, INT_TWO]);

	t.assertIdEq(r1, r1);
	t.assertNotEq(r1, r2);
	t.assertNotId(r1, r2);
	t.assertHash(r1, r1);

	// an array is never the bottom value, even when empty or all-default
	t.assertNotEq(BOTTOM, r1);
	t.assertNotEq(BOTTOM, t.record(AT, [Int.ZERO, Int.ZERO]));
	t.assertNotId(BOTTOM, t.record(AT, [Int.ZERO, Int.ZERO]));
	t.assertNotEq(BOTTOM, t.record(AT, []));
	t.assertNotId(BOTTOM, t.record(AT, []));

	// arrays of different element types are distinct
	t.assertNotEq(r1, t.record(V3Array.newType(Bool.TYPE), [INT_ONE, INT_TWO]));
}

// Objects are mutable and have reference identity.
def testClassRecord(t: ValueTester) {
	def CT = newClassType("Klass", null);
	var c1 = t.record(CT, [INT_ONE]);
	var c2 = t.record(CT, [INT_ONE]);

	t.assertIdEq(c1, c1);
	t.assertNotEq(c1, c2);
	t.assertNotId(c1, c2);
	t.assertHash(c1, c1);

	// an object is never the bottom value, even with all-default fields
	t.assertNotEq(BOTTOM, c1);
	t.assertNotEq(BOTTOM, t.record(CT, [Int.ZERO]));
	t.assertNotId(BOTTOM, t.record(CT, [Int.ZERO]));
	t.assertNotEq(BOTTOM, t.record(CT, []));

	// records of different class types are distinct
	t.assertNotEq(c1, t.record(newClassType("Klass2", null), [INT_ONE]));
}

// Variants have value identity; two distinct records with the same type and equal fields
// are equal, and must therefore hash the same.
def testVariantRecord(t: ValueTester) {
	def VT = newVariantType("Var", 3);
	var v1 = t.record(VT, [INT_ONE]);
	var v2 = t.record(VT, [INT_ONE]);
	var v3 = t.record(VT, [INT_TWO]);

	t.assertIdEq(v1, v1);
	t.assertIdEq(v1, v2);
	t.assertEqSet([v1, v2, t.record(VT, [INT_ONE])]);
	t.assertNotEq(v1, v3);
	t.assertNotId(v1, v3);

	// records of different variant types are distinct
	def WT = newVariantType("Var2", 3);
	t.assertNotEq(v1, t.record(WT, [INT_ONE]));
	t.assertNotId(v1, t.record(WT, [INT_ONE]));

	// a variant with all-default fields is the bottom value, but is never identical to null
	var d = t.record(VT, [Int.ZERO]);
	t.assertNotIdEq(BOTTOM, d);
	t.assertNotEq(d, v1);
	t.assertNotId(d, v1);

	// nested variants compare structurally, all the way down
	def NT = newVariantType("Nested", 2);
	t.assertIdEq(t.record(NT, [v1]), t.record(NT, [v2]));
	t.assertNotEq(t.record(NT, [v1]), t.record(NT, [v3]));
	t.assertNotId(t.record(NT, [v1]), t.record(NT, [v3]));

	// a variant containing a tuple
	t.assertIdEq(t.record(NT, [box2(INT_ONE)]), t.record(NT, [box2(INT_ONE)]));
	t.assertNotEq(t.record(NT, [box2(INT_ONE)]), t.record(NT, [box2(INT_TWO)]));
}

// Variants containing floats inherit the +0/-0 and NaN cases.
def testVariantRecordFloat(t: ValueTester) {
	def VT = newVariantType("FloatVar", 1);
	var pz = t.record(VT, [Float.F64_ZERO]);
	var mz = t.record(VT, [Float.F64_MINUS_ZERO]);
	var nan1 = t.record(VT, [Float.F64_NAN]);
	var nan2 = t.record(VT, [Float64Val.new(0x7ff8000000000000)]);

	t.assertNotIdEq(pz, mz);
	t.assertIdNotEq(nan1, nan2);

	// a variant containing a NaN is identical to, but not equal to, itself
	t.assertId(nan1, nan1);
	t.assertNotEq(nan1, nan1);

	// +0 is the default value, so a variant containing it is the bottom value
	t.assertNotIdEq(BOTTOM, pz);
	t.assertNotIdEq(BOTTOM, mz);
	t.assertNotEq(BOTTOM, nan1);
	t.assertNotId(BOTTOM, nan1);
}

// A default record stands for the bottom value of a variant type.
def testDefaultRecord(t: ValueTester) {
	def VT = newVariantType("DefVar", 2);
	var d = t.defaultRecord(VT, 2);

	t.assertIsDefault(true, d);
	t.assertIdEq(d, d);
	t.assertNotIdEq(BOTTOM, d);
	t.assertHash(BOTTOM, d);

	// an ordinary record with all-default fields is the same value
	var z = t.record(VT, [Int.ZERO, Bool.FALSE]);
	t.assertIsDefault(false, z);
	t.assertIdEq(d, z);
	t.assertNotIdEq(BOTTOM, z);
	t.assertIdEq(d, t.defaultRecord(VT, 2));

	// a record with any non-default field is not
	var v = t.record(VT, [INT_ONE, Bool.FALSE]);
	t.assertNotEq(d, v);
	t.assertNotId(d, v);
	t.assertNotEq(BOTTOM, v);
}

// Records can be cyclic; equality, identity, and hashing must all terminate.
def testRecursiveRecord(t: ValueTester) {
	def CT = newClassType("SelfKlass", null);
	var c1 = t.record(CT, [BOTTOM]);
	c1.values[0] = c1;
	var c2 = t.record(CT, [BOTTOM]);
	c2.values[0] = c2;

	t.assertIdEq(c1, c1);
	t.assertHash(c1, c1);
	t.assertNotEq(c1, c2);
	t.assertNotId(c1, c2);
	t.assertNotEq(BOTTOM, c1);

	// mutually-recursive objects
	var m1 = t.record(CT, [BOTTOM]), m2 = t.record(CT, [BOTTOM]);
	m1.values[0] = m2;
	m2.values[0] = m1;
	t.assertIdEq(m1, m1);
	t.assertNotEq(m1, m2);

	// a recursive default record is still the bottom value
	def VT = newVariantType("SelfVar", 2);
	var d = t.defaultRecord(VT, 1);
	d.values[0] = d;
	t.assertIsDefault(true, d);
	t.assertIdEq(d, d);
	t.assertNotIdEq(BOTTOM, d);
	t.assertHash(BOTTOM, d);
}

// The bottom value of a variant with a float field is +0.0; -0.0 is equal to it but
// not identical to it, and a NaN is neither. Both directions must agree, since the
// default record and an ordinary record take different paths through {equals}.
def testDefaultRecordFloat(t: ValueTester) {
	def VT = newVariantType("DefFloatVar", 2);
	var d = t.defaultRecord(VT, 2);

	t.assertIdEq(d, t.record(VT, [Float.F64_ZERO, Int.ZERO]));		// +0 *is* the bottom value
	t.assertNotIdEq(d, t.record(VT, [Float.F64_MINUS_ZERO, Int.ZERO]));	// -0 is equal to it, but distinct
	t.assertNotIdEq(d, t.record(VT, [Float.F32_MINUS_ZERO, Int.ZERO]));
	t.assertNotEq(d, t.record(VT, [Float.F64_NAN, Int.ZERO]));
	t.assertNotEq(d, t.record(VT, [Float.F64_ZERO, INT_ONE]));

	// the same, one level down through a nested variant and through a tuple
	def NT = newVariantType("DefFloatNest", 1);
	t.assertNotIdEq(t.defaultRecord(NT, 1), t.record(NT, [t.record(VT, [Float.F64_MINUS_ZERO, Int.ZERO])]));
	t.assertNotEq(t.defaultRecord(NT, 1), t.record(NT, [t.record(VT, [Float.F64_NAN, Int.ZERO])]));
	t.assertNotIdEq(t.defaultRecord(NT, 1), t.record(NT, [BoxVal.new([Float.F32_MINUS_ZERO, Float.F64_MINUS_ZERO])]));
	t.assertNotEq(t.defaultRecord(NT, 1), t.record(NT, [BoxVal.new([Float.F32_ZERO, Float.F64_NAN])]));
}

// A recursive default record is reachable from ordinary records; comparing and hashing
// one from the outside in must terminate, in both directions.
def testRecursiveDefaultRecord(t: ValueTester) {
	def VT = newVariantType("OuterSelfVar", 2);
	var d = t.defaultRecord(VT, 2);
	d.values[0] = d;

	// an ordinary record whose field is the recursive default record
	var z = t.record(VT, [d, Int.ZERO]);
	t.assertIdEq(d, z);
	t.assertNotIdEq(BOTTOM, z);
	t.assertHash(BOTTOM, z);

	// and one level further out
	var z2 = t.record(VT, [z, Int.ZERO]);
	t.assertIdEq(d, z2);
	t.assertIdEq(z, z2);
	t.assertNotIdEq(BOTTOM, z2);

	// a non-default field anywhere on the chain breaks the equality
	var v = t.record(VT, [t.record(VT, [d, INT_ONE]), Int.ZERO]);
	t.assertNotEq(d, v);
	t.assertNotEq(BOTTOM, v);
	t.assertNotEq(z, v);
}

// Equality is memoized between {BoxVal}s, so an equal pair may end up sharing an id.
// The memo must not leak across a non-reflexive value, and equality must stay an
// equivalence relation over everything that is reflexive.
def testEquivalenceClasses(t: ValueTester) {
	def box = BoxVal.new;
	def PZ = Float.F64_ZERO, MZ = Float.F64_MINUS_ZERO, NAN = Float.F64_NAN;

	// three spellings of the same value, compared in every order
	t.assertEqSet([box([PZ, INT_ONE]), box([MZ, INT_ONE]), box([PZ, INT_ONE])]);

	// comparing against a NaN-bearing tuple first must not poison the later ones
	var a = box([PZ, INT_ONE]), b = box([MZ, INT_ONE]), n = box([NAN, INT_ONE]);
	t.assertNotEq(a, n);
	t.assertNotEq(b, n);
	t.assertNotEq(n, n);
	t.assertEq(a, b);

	// and in the other order: unify a and b first, then compare both against the NaN
	var c = box([PZ, INT_TWO]), e = box([MZ, INT_TWO]), m = box([NAN, INT_TWO]);
	t.assertEq(c, e);
	t.assertNotEq(c, m);
	t.assertNotEq(e, m);
	t.assertNotEq(m, m);

	// nesting: the outer tuple inherits non-reflexivity from the inner one
	t.assertEq(box([box([PZ]), INT_ONE]), box([box([MZ]), INT_ONE]));
	t.assertNotEq(box([box([NAN])]), box([box([NAN])]));
	var deep = box([box([box([NAN])])]);
	t.assertId(deep, deep);
	t.assertNotEq(deep, deep);
}

class FloatTestVals(
	zero: Val,
	one: Val,
	two: Val,
	nan: Val,
	minus_zero: Val,
	minus_infinity: Val,
	infinity: Val) { }

def testFloatVals(t: ValueTester, a: FloatTestVals, b: FloatTestVals) {
	t.assertIdEq(a.zero,		b.zero);
	t.assertIdEq(a.one,		b.one);
	t.assertIdEq(a.two,		b.two);
	t.assertIdNotEq(a.nan,		b.nan);
	t.assertIdEq(a.minus_zero,	b.minus_zero);
	t.assertIdEq(a.minus_infinity,	b.minus_infinity);
	t.assertIdEq(a.infinity,	b.infinity);

	t.assertNotIdEq(a.zero,	a.minus_zero);
	t.assertNotIdEq(a.zero,	b.minus_zero);
	t.assertNotIdEq(b.zero,	a.minus_zero);
	t.assertNotIdEq(b.zero,	b.minus_zero);

	t.assertEqSet([b.zero, a.zero, b.minus_zero, a.minus_zero]);

	t.assertIdSet([a.nan, b.nan]);

	t.assertNotEq(a.nan, a.nan);
	t.assertNotEq(a.nan, b.nan);
	t.assertNotEq(b.nan, a.nan);
	t.assertNotEq(b.nan, b.nan);
}

def testFloatVal32(t: ValueTester) {
	def box = Float32Val.new;

	def boxed = FloatTestVals.new(
		box(0),
		box(0x3f800000),
		box(0x40000000),
		box(0x7fc00000),
		box(0x80000000u),
		box(0xff800000u),
		box(0x7f800000u)
	);
	def canon = FloatTestVals.new(
		Float.F32_ZERO,
		Float.F32_ONE,
		Float.F32_TWO,
		Float.F32_NAN,
		Float.F32_MINUS_ZERO,
		Float.F32_MINUS_INFINITY,
		Float.F32_INFINITY
	);

	testFloatVals(t, boxed, canon);
}

def testFloatVal64(t: ValueTester) {
	def box = Float64Val.new;

	def boxed = FloatTestVals.new(
		box(0),
		box(0x3ff0000000000000),
		box(0x4000000000000000),
		box(0x7ff8000000000000),
		box(0x8000000000000000ul),
		box(0xfff0000000000000ul),
		box(0x7ff0000000000000ul)
	);

	def canon = FloatTestVals.new(
		Float.F64_ZERO,
		Float.F64_ONE,
		Float.F64_TWO,
		Float.F64_NAN,
		Float.F64_MINUS_ZERO,
		Float.F64_MINUS_INFINITY,
		Float.F64_INFINITY
	);

	testFloatVals(t, boxed, canon);
}
