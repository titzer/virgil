def T = UnitTests.registerT("val:", _, ValueTester.new, _);
def X_ = void(
	T("IntBox", testIntBox),
	T("LongBox", testLongBox),
	T("BoolBox", testBoolBox),
	T("BoxVal", testBoxVal),
	T("FloatVal32", testFloatVal32),
	T("FloatVal64", testFloatVal64),
	()
);

def BOTTOM = Values.BOTTOM;
def INT_ONE = Int.box(1);
def INT_TWO = Int.box(2);
def INT_MIN = Int.box(int.min);
def LONG_ONE = Long.box(1);
def LONG_MAX = Long.box(long.max);
def BOOL_TRUE = Bool.box(true);

def box1(v: Val) -> Val {
	return BoxVal.new(null, [v]);
}

def box2(a: Val) -> Val {
	return BoxVal.new(null, [a, a]);
}

private class ValueTester(t: Tester) {
	def fail2v(fmt: string, a: Val, b: Val) {
		return t.fail(StringBuilder.new().put2(fmt, V3.renderResult(a, null, _), V3.renderResult(b, null, _)).toString());
	}
	def assertEq(a: Val, b: Val) {
		if (!Values.equal(a, b)) return fail2v("expected %q == %q", a, b);
		if (!Values.equal(b, a)) return fail2v("expected %q == %q (non-reflexive)", b, a);
		assertHash(a, b);
	}
	def assertNotEq(a: Val, b: Val) {
		if (Values.equal(a, b)) return fail2v("expected %q != %q", a, b);
		if (Values.equal(b, a)) return fail2v("expected %q != %q (non-reflexive)", b, a);
	}
	def assertId(a: Val, b: Val) {
		if (!Values.identical(a, b)) return fail2v("expected %q identical %q", a, b);
		if (!Values.identical(b, a)) return fail2v("expected %q identical %q (non-reflexive)", b, a);
	}
	def assertNotIdEq(a: Val, b: Val) {
		assertNotId(a, b);
		assertEq(a, b);
	}
	def assertIdEq(a: Val, b: Val) {
		assertId(a, b);
		assertEq(a, b);
	}
	def assertIdNotEq(a: Val, b: Val) {
		assertId(a, b);
		assertNotEq(a, b);
	}
	def assertNotId(a: Val, b: Val) {
		if (Values.identical(a, b)) return fail2v("expected %q !identical %q", a, b);
		if (Values.identical(b, a)) return fail2v("expected %q !identical %q (non-reflexive)", b, a);
	}
	def assertHash(a: Val, b: Val) {
		var ha = Values.hash(a), hb = Values.hash(b);
		if (ha != hb) return fail2v("expected hash(%q) == hash(%q)", a, b);
	}
	def assertAllPairs(a: Range<Val>, diag: (Val, Val) -> void, nondiag: (Val, Val) -> void) {
		for (i < a.length) for (j < a.length) {
			if (i == j) diag(a[i], a[j]);
			else nondiag(a[i], a[j]);
		}
	}
	def assertEqSet(a: Range<Val>) {
		assertAllPairs(a, assertEq, assertEq);
	}
	def assertIdSet(a: Range<Val>) {
		assertAllPairs(a, assertId, assertId);
	}
	def assertNeSet(a: Range<Val>) {
		assertAllPairs(a, assertEq, assertNotEq);
	}
}

def testIntBox(t: ValueTester) {
	def box = Int.box;

	t.assertIdSet([BOTTOM, Int.ZERO, box(0), box(0)]);
	t.assertIdSet([Int.ONE, box(1), box(1)]);
	t.assertIdSet([Int.TWO, box(2), box(2)]);
	t.assertIdSet([Int.FOUR, box(4), box(4)]);
	t.assertIdSet([Int.MINUS_1, box(-1), box(-1)]);

	t.assertNeSet([Int.ZERO, Int.ONE, Int.TWO, Int.FOUR, Int.MINUS_1]);

	for (i in [99, -87, 89734, 1239, int.min, int.max]) {
		t.assertIdSet([box(i), box(i)]);
	}
}

def testLongBox(t: ValueTester) {
	def box: long -> Val = Long.box;

	t.assertIdSet([BOTTOM, box(0), box(0)]);

	var longs: Array<long> = [97, -88, 89733, 12398, long.min, long.max];
	for (i in longs) t.assertIdSet([box(i), box(i)]);

	var vals = Arrays.map(longs, box);
	t.assertNeSet(vals);
}

def testBoolBox(t: ValueTester) {
	var T = Bool.TRUE, F = Bool.FALSE;
	def box = Bool.box;
	t.assertId(T, T);
	t.assertId(F, F);

	t.assertId(box(true), T);
	t.assertId(box(false), F);

	t.assertNotEq(T, F);

	t.assertNotEq(T, box(false));
	t.assertNotEq(F, box(true));

	t.assertIdSet([BOTTOM, Bool.FALSE, box(false), box(false)]);
}

def testBoxVal(t: ValueTester) {
	var box = BoxVal.new(null, _);

	t.assertIdSet([box([]), box([])]);

	var vals: Array<Val> = [BOTTOM, INT_ONE, INT_MIN, BOOL_TRUE, LONG_MAX];
	for (v in vals) {
		t.assertIdSet([box1(v), box1(v)]);
		t.assertIdSet([box2(v), box2(v)]);
	}

	t.assertNeSet(Arrays.map(vals, box1));
	t.assertNeSet(Arrays.map(vals, box2));

	var zeroes = [BOTTOM, Int.ZERO, Int.box(0), Long.box(0), Bool.FALSE, Bool.box(false)];
	for (v in zeroes) {
		t.assertIdSet([null, box1(v), box2(v)]);
	}
	// TODO: more complex tests with records, closures, etc
}

class FloatTestVals(
	zero: Val,
	one: Val,
	two: Val,
	nan: Val,
	minus_zero: Val,
	minus_infinity: Val,
	infinity: Val) { }

def testFloatVals(t: ValueTester, a: FloatTestVals, b: FloatTestVals) {
	t.assertIdEq(a.zero,		b.zero);
	t.assertIdEq(a.one,		b.one);
	t.assertIdEq(a.two,		b.two);
	t.assertIdNotEq(a.nan,		b.nan);
	t.assertIdEq(a.minus_zero,	b.minus_zero);
	t.assertIdEq(a.minus_infinity,	b.minus_infinity);
	t.assertIdEq(a.infinity,	b.infinity);

	t.assertNotIdEq(a.zero,	a.minus_zero);
	t.assertNotIdEq(a.zero,	b.minus_zero);
	t.assertNotIdEq(b.zero,	a.minus_zero);
	t.assertNotIdEq(b.zero,	b.minus_zero);

	t.assertEqSet([b.zero, a.zero, b.minus_zero, a.minus_zero]);

	t.assertIdSet([a.nan, b.nan]);

	t.assertNotEq(a.nan, a.nan);
	t.assertNotEq(a.nan, b.nan);
	t.assertNotEq(b.nan, a.nan);
	t.assertNotEq(b.nan, b.nan);
}

def testFloatVal32(t: ValueTester) {
	def box = Float32Val.new;

	def boxed = FloatTestVals.new(
		box(0),
		box(0x3f800000),
		box(0x40000000),
		box(0x7fc00000),
		box(0x80000000u),
		box(0xff800000u),
		box(0x7f800000u)
	);
	def canon = FloatTestVals.new(
		Float.F32_ZERO,
		Float.F32_ONE,
		Float.F32_TWO,
		Float.F32_NAN,
		Float.F32_MINUS_ZERO,
		Float.F32_MINUS_INFINITY,
		Float.F32_INFINITY
	);

	testFloatVals(t, boxed, canon);
}

def testFloatVal64(t: ValueTester) {
	def box = Float64Val.new;

	def boxed = FloatTestVals.new(
		box(0),
		box(0x3ff0000000000000),
		box(0x4000000000000000),
		box(0x7ff8000000000000),
		box(0x8000000000000000ul),
		box(0xfff0000000000000ul),
		box(0x7ff0000000000000ul)
	);

	def canon = FloatTestVals.new(
		Float.F64_ZERO,
		Float.F64_ONE,
		Float.F64_TWO,
		Float.F64_NAN,
		Float.F64_MINUS_ZERO,
		Float.F64_MINUS_INFINITY,
		Float.F64_INFINITY
	);

	testFloatVals(t, boxed, canon);
}
