def T = UnitTests.registerT("const:", _, SsaConstTester.new, _);
def X_ = void(
	T("ints", testInts),
	T("longs", testLongs),
	T("prims", testPrims),
	T("floats", testFloats),
	T("tuples", testTuples),
	T("array_records", testArrayRecords),
	T("class_records", testClassRecords),
	T("variant_records", testVariantRecords),
	T("prim_defaults", testPrimDefaults),
	T("float_defaults", testFloatDefaults),
	T("array_defaults", testArrayDefaults),
	T("class_defaults", testClassDefaults),
	T("variant_defaults", testVariantDefaults),
	T("tuple_defaults", testTupleDefaults),
	()
);

def F32 = Float.FLOAT32;
def F64 = Float.FLOAT64;

def I = Int.box;			// int value
def L: long -> Val = Long.box;		// long value
def Z = Bool.box;			// bool value
def f32 = Float32Val.new;		// float value, from bits
def f64 = Float64Val.new;		// double value, from bits

def newVariantType = SsaGraphBuildingHelper.newVariantType;
def newClassType = SsaGraphBuildingHelper.newClassType;

def tupleType(types: Array<Type>) -> Type {
	return Tuple.newType(Lists.fromArray(types));
}

private class SsaConstTester(t: Tester) {
	def prog = Program.new();
	var graph = SsaGraph.new([], Void.TYPE);

	// Runs {f} twice, once against a fresh graph, which canonicalizes constants with a
	// linear search, and once against a graph that already has enough constants to force
	// the internal hashmap to be used. Both modes must agree, which requires {Values.hash}
	// to be consistent with {Values.identical}.
	def run(f: SsaConstTester -> void) {
		graph = SsaGraph.new([], Void.TYPE);
		f(this);
		graph = SsaGraph.new([], Void.TYPE);
		for (i < 32) graph.intConst(0x70000 + i); // force hashmap creation
		f(this);
	}
	def assertId(x: SsaConst, y: SsaConst) {
		if (x == null) return t.fail("expected equal, got null == ?");
		if (y == null) return t.fail1("expected equal, got @%d == ?", x.uid);
		if (x != y) return t.fail2("expected @%d == @%d", x.uid, y.uid);
	}
	def assertNotId(x: SsaConst, y: SsaConst) {
		if (x == null) return t.fail("expected distinct, got null != ?");
		if (y == null) return t.fail1("expected distinct, got @%d != ?", x.uid);
		if (x == y) return t.fail1("expected two distinct constants, got @%d", x.uid);
	}
	// Shorthand for a value constant.
	def K(vtype: Type, v: Val) -> SsaConst {
		return graph.valConst(vtype, v);
	}
	// Shorthand for the null (i.e. default value) constant of a type.
	def N(vtype: Type) -> SsaConst {
		return graph.nullConst(vtype);
	}
	// Shorthand for a constant of a freshly-allocated record.
	def KR(rtype: Type, vals: Array<Val>) -> SsaConst {
		return K(rtype, record(rtype, vals));
	}
	// Shorthand for a tuple constant.
	def KT(vtype: Type, vals: Array<Val>) -> SsaConst {
		return K(vtype, BoxVal.new(vals));
	}
	// Allocate a fresh record with the given values.
	def record(rtype: Type, vals: Array<Val>) -> Record {
		var r = prog.newRecord(rtype, vals.length);
		for (i < vals.length) r.values[i] = vals[i];
		return r;
	}
	// Allocate a fresh default (i.e. bottom) record.
	def defaultRecord(rtype: Type, len: int) -> Record {
		return prog.newDefaultRecord(rtype, len);
	}
}

def testInts(t: SsaConstTester) {
	t.run(checkInts);
}
def checkInts(t: SsaConstTester) {
	def K = t.graph.intConst;

	for (i = -10; i < 15; i++) t.assertId(K(i), K(i));
	for (i = -10; i < 15; i++) {
		for (j = -10; j < 15; j++) if (i != j) t.assertNotId(K(i), K(j));
	}
	for (i in [int.min, int.max, 0x7EEEEEEE, -0x7EEEEEEE]) {
		t.assertId(K(i), K(i));
		t.assertId(K(i), t.K(Int.TYPE, I(i)));
	}
}

def testLongs(t: SsaConstTester) {
	t.run(checkLongs);
}
def checkLongs(t: SsaConstTester) {
	def K = t.graph.longConst;

	for (i = -10; i < 15; i++) t.assertId(K(i), K(i));
	t.assertId(t.graph.intConst(0), K(0));

	var longs: Array<long> = [long.min, long.max, 0x100000000, -0x100000000, 33];
	for (i in longs) {
		t.assertId(K(i), K(i));
		for (j in longs) if (i != j) t.assertNotId(K(i), K(j));
	}
	// values too large for 32 bits are not shared with int constants
	t.assertNotId(t.graph.intConst(-1), K(0xFFFFFFFF));
}

def testPrims(t: SsaConstTester) {
	t.run(checkPrims);
}
def checkPrims(t: SsaConstTester) {
	// bool
	def B = t.K(Bool.TYPE, _);
	t.assertId(t.graph.boolConst(true), t.graph.trueConst());
	t.assertId(t.graph.boolConst(false), t.graph.falseConst());
	t.assertId(t.graph.trueConst(), B(Bool.TRUE));
	t.assertId(t.graph.falseConst(), B(Bool.FALSE));
	t.assertId(t.graph.trueConst(), B(Z(true)));
	t.assertId(t.graph.falseConst(), B(Z(false)));
	t.assertNotId(t.graph.trueConst(), t.graph.falseConst());

	// void
	t.assertId(t.graph.nop(), t.graph.nop());
	t.assertId(t.graph.nop(), t.N(Void.TYPE));
	t.assertId(t.graph.nop(), t.K(Void.TYPE, null));
	t.assertNotId(t.graph.nop(), t.graph.falseConst());

	// integer types up to 32 bits are represented with {Box<int>}
	for (width = 1; width <= 32; width++) {
		for (signed in [true, false]) {
			def K = t.K(Int.getType(signed, width), _);
			t.assertId(K(I(1)), K(I(1)));
			t.assertId(K(I(0)), K(null));
			t.assertNotId(K(I(0)), K(I(1)));
		}
	}
	// byte
	def BY = t.K(Byte.TYPE, _);
	t.assertId(BY(I(97)), BY(I(97)));
	t.assertNotId(BY(I(97)), BY(I(98)));

	// integer types wider than 32 bits are represented with {Box<long>}
	for (width = 33; width <= 64; width++) {
		for (signed in [true, false]) {
			def K = t.K(Int.getType(signed, width), _);
			t.assertId(K(L(7)), K(L(7)));
			t.assertId(K(L(0)), K(null));
			t.assertNotId(K(L(7)), K(L(9)));
		}
	}
	// constants of different types are not shared
	t.assertNotId(t.K(Int.getType(true, 33), L(7)), t.K(Int.getType(false, 33), L(7)));
	t.assertNotId(t.K(Long.TYPE, L(7)), t.K(Int.getType(false, 64), L(7)));
}

// Float constants are canonicalized by their bits; e.g. +0 and -0 are equal but distinct
// constants, while two NaNs with the same bits are the same constant, even though they
// are not equal to each other.
def testFloats(t: SsaConstTester) {
	t.run(checkFloats);
}
def checkFloats(t: SsaConstTester) {
	def K = t.K(F32, _), D = t.K(F64, _);

	var bits32: Array<u32> = [
		0u,			// +0
		0x80000000u,		// -0
		0x3f800000u,		// 1
		0xbf800000u,		// -1
		0x7f800000u,		// infinity
		0xff800000u,		// -infinity
		0x7fc00000u,		// nan
		0x7fc00001u,		// nan, different payload
		0xffc00000u		// nan, sign bit set
	];
	for (i < bits32.length) {
		for (j < bits32.length) {
			var x = K(f32(bits32[i])), y = K(f32(bits32[j]));
			if (i == j) t.assertId(x, y);
			else t.assertNotId(x, y);
		}
	}
	t.assertId(K(Float.F32_ZERO), K(f32(0)));
	t.assertId(K(Float.F32_MINUS_ZERO), K(f32(0x80000000u)));
	t.assertId(K(Float.F32_ONE), K(f32(0x3f800000u)));
	t.assertId(K(Float.F32_NAN), K(f32(0x7fc00000u)));
	t.assertId(K(Float.F32_INFINITY), K(f32(0x7f800000u)));

	var bits64: Array<u64> = [
		0ul,			// +0
		0x8000000000000000ul,	// -0
		0x3ff0000000000000ul,	// 1
		0xbff0000000000000ul,	// -1
		0x7ff0000000000000ul,	// infinity
		0xfff0000000000000ul,	// -infinity
		0x7ff8000000000000ul,	// nan
		0x7ff8000000000001ul,	// nan, different payload
		0xfff8000000000000ul	// nan, sign bit set
	];
	for (i < bits64.length) {
		for (j < bits64.length) {
			var x = D(f64(bits64[i])), y = D(f64(bits64[j]));
			if (i == j) t.assertId(x, y);
			else t.assertNotId(x, y);
		}
	}
	t.assertId(D(Float.F64_ZERO), D(f64(0)));
	t.assertId(D(Float.F64_MINUS_ZERO), D(f64(0x8000000000000000ul)));
	t.assertId(D(Float.F64_ONE), D(f64(0x3ff0000000000000ul)));
	t.assertId(D(Float.F64_NAN), D(f64(0x7ff8000000000000ul)));
	t.assertId(D(Float.F64_INFINITY), D(f64(0x7ff0000000000000ul)));

	// float and double constants are never shared
	t.assertNotId(K(f32(0)), D(f64(0)));
	t.assertNotId(K(f32(0x7fc00000u)), D(f64(0x7ff8000000000000ul)));
}

// Tuples are canonicalized structurally, element by element.
def testTuples(t: SsaConstTester) {
	t.run(checkTuples);
}
def checkTuples(t: SsaConstTester) {
	def II = tupleType([Int.TYPE, Int.TYPE]);
	def B = t.KT(II, _);

	t.assertId(B([I(3), I(4)]), B([I(3), I(4)]));
	t.assertNotId(B([I(3), I(4)]), B([I(4), I(3)]));
	t.assertNotId(B([I(3), I(4)]), B([I(3), I(5)]));
	t.assertId(B([]), B([]));  // the empty tuple

	def BL = tupleType([Bool.TYPE, Long.TYPE]);
	def C = t.KT(BL, _);
	t.assertId(C([Bool.TRUE, L(-9)]), C([Z(true), L(-9)]));
	t.assertNotId(C([Bool.TRUE, L(-9)]), C([Bool.FALSE, L(-9)]));

	// tuples of different types are not shared
	t.assertNotId(B([I(3), I(4)]), C([I(3), I(4)]));

	// nested tuples
	def NN = tupleType([II, Int.TYPE]);
	def D = t.KT(NN, _);
	def n = BoxVal.new;
	t.assertId(D([n([I(1), I(2)]), I(3)]), D([n([I(1), I(2)]), I(3)]));
	t.assertNotId(D([n([I(1), I(2)]), I(3)]), D([n([I(1), I(9)]), I(3)]));

	// tuples of floats are canonicalized by bits: +0 and -0 differ, and NaNs with the
	// same bits are the same constant
	def FF = tupleType([F32, F32]);
	def F = t.KT(FF, _);
	def PZ = f32(0), MZ = f32(0x80000000u), NAN = f32(0x7fc00000u), NAN2 = f32(0x7fc00001u);
	t.assertId(F([NAN, PZ]), F([f32(0x7fc00000u), f32(0)]));
	t.assertId(F([MZ, MZ]), F([f32(0x80000000u), MZ]));
	t.assertNotId(F([NAN, PZ]), F([NAN2, PZ]));
	t.assertNotId(F([PZ, PZ]), F([MZ, PZ]));
	t.assertNotId(F([PZ, PZ]), F([PZ, MZ]));

	def DD = tupleType([F64, F64]);
	def G = t.KT(DD, _);
	def DPZ = f64(0), DMZ = f64(0x8000000000000000ul);
	def DNAN = f64(0x7ff8000000000000ul), DNAN2 = f64(0x7ff8000000000001ul);
	t.assertId(G([DNAN, DPZ]), G([f64(0x7ff8000000000000ul), DPZ]));
	t.assertNotId(G([DNAN, DPZ]), G([DNAN2, DPZ]));
	t.assertNotId(G([DPZ, DPZ]), G([DMZ, DPZ]));
}

// Arrays are mutable and have reference identity; two distinct records are never
// canonicalized to the same constant, no matter their contents.
def testArrayRecords(t: SsaConstTester) {
	t.run(checkArrayRecords);
}
def checkArrayRecords(t: SsaConstTester) {
	def AT = V3Array.newType(Int.TYPE);
	def K = t.K(AT, _), R = t.KR(AT, _);

	var r1 = t.record(AT, [I(1), I(2)]);
	t.assertId(K(r1), K(r1));
	t.assertId(K(r1), t.graph.recordConst(r1));
	t.assertNotId(K(r1), R([I(1), I(2)]));
	t.assertNotId(R([I(1), I(2)]), R([I(1), I(2)]));

	// records with all-default contents are still distinct objects
	var z1 = t.record(AT, [I(0), I(0)]);
	t.assertId(K(z1), K(z1));
	t.assertNotId(K(z1), R([I(0), I(0)]));
	t.assertNotId(K(z1), K(r1));

	// the empty array is a distinct object as well
	var e1 = t.record(AT, []);
	t.assertId(K(e1), K(e1));
	t.assertNotId(K(e1), R([]));

	// null constants of different array types are distinct
	t.assertId(t.N(AT), t.N(V3Array.newType(Int.TYPE)));
	t.assertNotId(t.N(AT), t.N(V3Array.newType(Bool.TYPE)));
}
// Objects are mutable and have reference identity.
def testClassRecords(t: SsaConstTester) {
	t.run(checkClassRecords);
}
def checkClassRecords(t: SsaConstTester) {
	def CT = newClassType("Klass", null);
	def K = t.K(CT, _), R = t.KR(CT, _);

	var c1 = t.record(CT, [I(11)]);
	t.assertId(K(c1), K(c1));
	t.assertId(K(c1), t.graph.recordConst(c1));
	t.assertNotId(K(c1), R([I(11)]));

	// an object with all-default fields is a distinct object
	var z1 = t.record(CT, [I(0)]);
	t.assertId(K(z1), K(z1));
	t.assertNotId(K(z1), R([I(0)]));

	// records of different class types are distinct
	def DT = newClassType("Klass2", null);
	t.assertNotId(K(c1), t.KR(DT, [I(11)]));
	t.assertNotId(t.N(CT), t.N(DT));
}
// Variants have value identity; two distinct records with identical field values are
// canonicalized to the same constant.
def testVariantRecords(t: SsaConstTester) {
	t.run(checkVariantRecords);
}
def checkVariantRecords(t: SsaConstTester) {
	def VT = newVariantType("Var", 3);
	def R = t.KR(VT, _);

	var v1 = t.record(VT, [I(5)]);
	t.assertId(t.K(VT, v1), t.K(VT, v1));
	t.assertId(t.K(VT, v1), t.graph.recordConst(t.record(VT, [I(5)])));
	t.assertId(R([I(5)]), R([I(5)]));
	t.assertNotId(R([I(5)]), R([I(6)]));

	// records of different variant types are distinct
	def WT = newVariantType("Var2", 3);
	t.assertNotId(R([I(5)]), t.KR(WT, [I(5)]));

	// nested variants
	def NT = newVariantType("Nested", 2);
	def N = t.KR(NT, _);
	t.assertId(N([t.record(VT, [I(5)])]), N([t.record(VT, [I(5)])]));
	t.assertNotId(N([t.record(VT, [I(5)])]), N([t.record(VT, [I(6)])]));

	// variants containing tuples
	def TT = newVariantType("WithTuple", 1);
	def U = t.KR(TT, _);
	def n = BoxVal.new;
	t.assertId(U([n([I(1), I(2)])]), U([n([I(1), I(2)])]));
	t.assertNotId(U([n([I(1), I(2)])]), U([n([I(1), I(3)])]));

	// variants containing floats are canonicalized by bits
	def FT = newVariantType("WithFloat", 1);
	def F = t.KR(FT, _);
	def PZ = f64(0), MZ = f64(0x8000000000000000ul);
	def NAN = f64(0x7ff8000000000000ul), NAN2 = f64(0x7ff8000000000001ul);
	t.assertId(F([NAN]), F([f64(0x7ff8000000000000ul)]));
	t.assertId(F([MZ]), F([f64(0x8000000000000000ul)]));
	t.assertNotId(F([NAN]), F([NAN2]));
	t.assertNotId(F([PZ]), F([MZ]));
}

// The null constant of a type represents that type's default value, so a constant with
// the default value must be canonicalized to the null constant of that type, and only
// the default value.
def testPrimDefaults(t: SsaConstTester) {
	t.run(checkPrimDefaults);
}
def checkPrimDefaults(t: SsaConstTester) {
	t.assertId(t.N(Bool.TYPE), t.graph.falseConst());
	t.assertId(t.N(Bool.TYPE), t.K(Bool.TYPE, Z(false)));
	t.assertNotId(t.N(Bool.TYPE), t.K(Bool.TYPE, Z(true)));

	t.assertId(t.N(Void.TYPE), t.graph.nop());

	t.assertId(t.N(Int.TYPE), t.graph.intConst(0));
	t.assertId(t.N(Int.TYPE), t.K(Int.TYPE, I(0)));
	t.assertNotId(t.N(Int.TYPE), t.graph.intConst(1));

	t.assertId(t.N(Byte.TYPE), t.K(Byte.TYPE, I(0)));
	t.assertId(t.N(Long.TYPE), t.K(Long.TYPE, L(0)));
	t.assertNotId(t.N(Long.TYPE), t.K(Long.TYPE, L(1)));

	for (width = 1; width <= 64; width++) {
		for (signed in [true, false]) {
			def it = Int.getType(signed, width);
			t.assertId(t.N(it), t.K(it, if(width <= 32, I(0), L(0))));
		}
	}
}
// Floats: +0 is the default value; -0 and NaN are not.
def testFloatDefaults(t: SsaConstTester) {
	t.run(checkFloatDefaults);
}
def checkFloatDefaults(t: SsaConstTester) {
	def K = t.K(F32, _), D = t.K(F64, _);

	t.assertNotId(t.N(F32), K(Float.F32_MINUS_ZERO));
	t.assertNotId(t.N(F32), K(Float.F32_NAN));
	t.assertNotId(t.N(F32), K(Float.F32_ONE));
	t.assertNotId(t.N(F64), D(Float.F64_MINUS_ZERO));
	t.assertNotId(t.N(F64), D(Float.F64_NAN));
	t.assertNotId(t.N(F64), D(Float.F64_ONE));

	t.assertId(t.N(F32), K(Float.F32_ZERO));
	t.assertId(t.N(F64), D(Float.F64_ZERO));
}
// Arrays are never the default value, no matter their contents.
def testArrayDefaults(t: SsaConstTester) {
	t.run(checkArrayDefaults);
}
def checkArrayDefaults(t: SsaConstTester) {
	def AT = V3Array.newType(Int.TYPE);
	def R = t.KR(AT, _);

	t.assertNotId(t.N(AT), R([I(1)]));
	t.assertNotId(t.N(AT), R([I(0)]));
	t.assertNotId(t.N(AT), R([]));
}
// Objects are never the default value, no matter their fields.
def testClassDefaults(t: SsaConstTester) {
	t.run(checkClassDefaults);
}
def checkClassDefaults(t: SsaConstTester) {
	def CT = newClassType("DefKlass", null);
	def R = t.KR(CT, _);

	t.assertNotId(t.N(CT), R([I(1)]));
	t.assertNotId(t.N(CT), R([I(0)]));
	t.assertNotId(t.N(CT), R([]));
}
// A variant record with all-default fields is {Values.identical} to the default value, but
// it does not share an {SsaConst} with it: a record is materialized at a non-zero heap
// address, while the null constant lowers to a zero pointer, so the two cannot be
// substituted for each other in generated code.
def testVariantDefaults(t: SsaConstTester) {
	t.run(checkVariantDefaults);
}
def checkVariantDefaults(t: SsaConstTester) {
	def VT = newVariantType("DefVar", 2);
	def R = t.KR(VT, _);

	t.assertNotId(t.N(VT), R([I(1), Bool.FALSE]));
	t.assertNotId(t.N(VT), R([I(0), Bool.TRUE]));
	t.assertNotId(t.N(VT), R([I(0), Bool.FALSE]));
	t.assertNotId(t.N(VT), R([null, null]));
	t.assertNotId(t.N(VT), t.K(VT, t.defaultRecord(VT, 2)));

	// two records that are the default value still share a constant with each other
	t.assertId(R([I(0), Bool.FALSE]), R([null, null]));
	t.assertId(R([I(0), Bool.FALSE]), t.K(VT, t.defaultRecord(VT, 2)));

	// a variant containing +0 is the default value, but not one containing -0 or NaN
	def FT = newVariantType("DefFloatVar", 1);
	def F = t.KR(FT, _);
	t.assertNotId(t.N(FT), F([Float.F64_MINUS_ZERO]));
	t.assertNotId(t.N(FT), F([Float.F64_NAN]));
	t.assertId(F([Float.F64_ZERO]), F([null]));
}
// A tuple of default values is the default value.
def testTupleDefaults(t: SsaConstTester) {
	t.run(checkTupleDefaults);
}
def checkTupleDefaults(t: SsaConstTester) {
	def II = tupleType([Int.TYPE, Int.TYPE]);
	def B = t.KT(II, _);

	t.assertNotId(t.N(II), B([I(0), I(1)]));
	t.assertId(t.N(II), B([I(0), I(0)]));
	t.assertId(t.N(II), B([null, null]));

	// a tuple of +0s is the default value, but not one containing -0 or NaN
	def FF = tupleType([F32, F32]);
	def F = t.KT(FF, _);
	t.assertNotId(t.N(FF), F([Float.F32_MINUS_ZERO, Float.F32_ZERO]));
	t.assertNotId(t.N(FF), F([Float.F32_NAN, Float.F32_ZERO]));
	t.assertId(t.N(FF), F([Float.F32_ZERO, Float.F32_ZERO]));
}
