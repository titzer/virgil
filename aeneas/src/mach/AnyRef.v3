// The type constructor for a type representing any GC-tracked reference, handling both
// the internal "AnyRef" type used for targets with typed references, and the runtime-level
// type for targets with machine representations.
class AnyRef_TypeCon extends TypeCon {
	def width: byte;
	def size = byte.view((width + 7u) >>> 3);

	new(name: string, width) super(name, Kind.ANYREF, 0, TypeUtil.globalCache) {
		singleton = AnyRefType.new(this, width, null);
	}
}
// The (singleton) type for values that are GC-tracked references.
class AnyRefType extends Type {
	def width: byte;
	new(typeCon: AnyRef_TypeCon, width, nested: List<Type>) super(typeCon.uid, typeCon, null) { }
}
