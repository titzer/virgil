// Module which provides the "Pointer" and "AnyRef" types
component MachModule {
	def ptr = "Pointer";
	def PTR_16 = PointerType.!(Pointer_TypeCon.new(ptr, 16).singleton);
	def PTR_32 = PointerType.!(Pointer_TypeCon.new(ptr, 32).singleton);
	def PTR_64 = PointerType.!(Pointer_TypeCon.new(ptr, 64).singleton);

	def anyref = "AnyRef";
	def ANYREF_INTERNAL = AnyRefType.!(AnyRef_TypeCon.new(anyref, 0).singleton);
	def ANYREF_16 = AnyRefType.!(AnyRef_TypeCon.new(anyref, 16).singleton);
	def ANYREF_32 = AnyRefType.!(AnyRef_TypeCon.new(anyref, 32).singleton);
	def ANYREF_64 = AnyRefType.!(AnyRef_TypeCon.new(anyref, 64).singleton);

	// Installs machine-level types with the correct width into the type environment.
	def install(mach: MachProgram) -> (PointerType, AnyRefType) {
		var width = mach.data.addressWidth;
		if (width <= 16) return install0(mach, PTR_16, ANYREF_16);
		if (width <= 32) return install0(mach, PTR_32, ANYREF_32);
		else return install0(mach, PTR_64, ANYREF_64);
	}
	private def install0(mach: MachProgram, pt: PointerType, at: AnyRefType) -> (PointerType, AnyRefType) {
		mach.prog.typeEnv.add(pt.typeCon);
		mach.prog.typeEnv.add(at.typeCon);
		return (pt, at);
	}
	def getAnyRefType() -> AnyRefType {
		return ANYREF_INTERNAL;
	}
	def getPtrType(prog: Program) -> PointerType {
		return PointerType.!(prog.typeEnv.lookup(ptr).singleton);
	}
	// Returns the mach AnyRef type given the address width.
	def addrWidthToAnyRef(addressWidth: int) -> AnyRefType {
		if (addressWidth <= 16) return ANYREF_16;
		else if (addressWidth <= 32) return ANYREF_32;
		return ANYREF_64;
	}
}
