	def visitVariantGetField(opcode: Opcode.VariantGetField, vt: ClassType) {
		var rcvrType = app.input0().getType();
		var treatAsVariant = (
			!ClassType.?(rcvrType) ||
			!ClassType.!(rcvrType).classDecl.isUnboxed()
			);
		return genClassGetField(treatAsVariant, app, opcode.field);
	}
