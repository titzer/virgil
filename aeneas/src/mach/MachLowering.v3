		mapOrId(app, apply(i_add, [i_array, i_offset]));
	}
	def visitPtrAtObject(opcode: Opcode.PtrAtObject, t: Type)	{ mapOrId(app, normRef1(app.inputs[0])); }
	def visitPtrAtArrayElem(opcode: Opcode.PtrAtArrayElem, at: ArrayType, it: IntType) {
		genBoundsCheck(app, Fact.O_NO_NULL_CHECK); // XXX: propagate nullity
		if (ssa.end()) return;
		var i_array = normRef1(app.inputs[0]);
		var i_index = normRef1(app.inputs[1]);
		var hsize = mach.getArrayElemOffset(at, 0), scale = mach.getArrayElemScale(at);
		var i_offset = genArrayElemOffset(hsize, scale, i_index);
		mapOrId(app, ptrAddAs(op.sig.returnType(), i_array, i_offset));
	}
	def visitPtrAtEnd(opcode: Opcode.PtrAtEnd, t: Type) {
		var i_obj = normRef1(app.inputs[0]);
		var size = mach.getObjectSize(t, null);
		mapOrId(app, ptrAddAs(op.sig.returnType(), i_obj, context.graph.intConst(size)));
		// TODO: PtrAtEnd<Array<T>> should add array length
	}
	def visitPtrAtRef(opcode: Opcode.PtrAtRef, rt: RefType)	{ genPtrAtRef(app); }
	def visitPtrAtComponentField(opcode: Opcode.PtrAtComponentField, ct: ComponentType) {
		var fieldRef = V3Op.extractIrSpec(op, opcode.field);
		mapOrId(app, componentFieldPtr(fieldRef));
	}
	def visitPtrAtObjectField(opcode: Opcode.PtrAtObjectField, ct: ClassType) {
		var fieldRef = V3Op.extractIrSpec(op, opcode.field);
		var i_obj = normRef1(app.inputs[0]);
		var offset = context.graph.intConst(getClassFieldOffset(fieldRef));
		mapOrId(app, ptrAddAs(op.sig.returnType(), i_obj, offset));
	}
	def visitPtrAtRefLayoutField(opcode: Opcode.PtrAtRefLayoutField, rt: RefType)	{ genPtrAtRefLayoutField(app, opcode.offset); }
	def visitPtrCmpSwp(opcode: Opcode.PtrCmpSwp, pt: PointerType, vt: Type) {
		if (!config.NativeCmpSwp) {
			var ifc = ssa.splitForIfCascade(null);
			var i_ptr = app.input0(), i_expect = app.input1(), i_val = app.inputs[2].dest;
			var i_load: SsaInstr;
			var op_cmp: Operator;
			match (mach.machType(vt)) {
				x: FloatType => op_cmp = x.opcache().opEqual;
				x: IntType => op_cmp = x.opEq();
				x: BoolType => op_cmp = Int.getType(false, 8).opEq();
				x: ClassType,
				x: ArrayType,
				x: FuncType,
				x: PointerType => op_cmp = V3Op.newRefEq(vt);
// TODO						x: VoidType => ;
				_ => context.fail("unknown type for compare-swap");
			}
			if (!app.facts.O_NO_NULL_CHECK) i_load = ptrLoadT(vt, i_ptr, 0);
			else i_load = ptrLoad(vt, i_ptr, 0);
			var i_cmp = ssa.pure(op_cmp, [i_load, i_expect]);
			ifc.addCase(i_cmp);
			ptrStore(vt, i_ptr, 0, i_val);
			ifc.endCase(null);
			ifc.addElse();
			ifc.endCase(null);
			ifc.finish();
			id(i_cmp);
			app.replace(i_cmp);
			app.remove();
		} else {
			normInputs(app); // constants must be normalized to machine values
		}
		id(app);
	}
	def visitPtrLoad(opcode: Opcode.PtrLoad, pt: Type, vt: Type) {
		var tn = normType(vt);
		if (isZeroSize(vt, tn)) return genPtrAccessEmpty(app, tn);
		if (tn == null || tn.size == 1) return void(normId(app));
		var i_ptr = normRef1(app.inputs[0]);
		var nullCheck = !app.facts.O_NO_NULL_CHECK;
		var loads = Vector<SsaInstr>.new(), offset = 0;
		for (et in tn.sub) {
			var size = mach.sizeOf(et);
			if (size == 0) continue; // zero-size elements have no value
			loads.put(if(nullCheck, ptrLoadT(et, i_ptr, offset), ptrLoad(et, i_ptr, offset)));
			nullCheck = false;
			offset += size;
		}
		mapN(app, loads.extract());
	}
	def visitPtrStore(opcode: Opcode.PtrStore, pt: Type, vt: Type) {
		var tn = normType(vt);
		if (isZeroSize(vt, tn)) return genPtrAccessEmpty(app, tn);
		if (tn == null || tn.size == 1) return void(normId(app));
		var inputs = normRefs(app.inputs), i_ptr = inputs[0];
		var nullCheck = !app.facts.O_NO_NULL_CHECK;
		var offset = 0, index = 1;
		for (et in tn.sub) {
			var size = mach.sizeOf(et);
			if (size == 0) continue; // zero-size elements have no value
			var val = inputs[index++];
			if (nullCheck) ptrStoreT(et, i_ptr, offset, val);
			else ptrStore(et, i_ptr, offset, val);
			nullCheck = false;
			offset += size;
		}
		app.kill();
		app.remove();
	}
	def isZeroSize(vt: Type, tn: TypeNorm) -> bool {
		if (tn == null) return mach.sizeOf(vt) == 0;
		if (tn.size == 1) return mach.sizeOf(tn.newType) == 0;
		for (et in tn.sub) if (mach.sizeOf(et) != 0) return false;
		return true;
	}
	// A load or store of a zero-size type only checks the pointer for null.
	def genPtrAccessEmpty(i_old: SsaApplyOp, tn: TypeNorm) {
		var i_ptr = normRef1(i_old.inputs[0]);
		if (!i_old.facts.O_NO_NULL_CHECK) nullCheckT(i_ptr);
		if (tn == null || tn.size == 1) map1(i_old, context.graph.nop());
		else map0(i_old);
	}
	def visitPtrAddRangeStart(opcode: Opcode.PtrAddRangeStart, pt: PointerType) {
		var i_ptr = normRef1(app.inputs[0]), i_rs = normRef1(app.inputs[1]);
		mapOrId(app, ptrAddAs(op.sig.returnType(), i_ptr, i_rs));
	}
	def visitCallKernel(opcode: Opcode.CallKernel, typeArgs: Array<Type>)	{ genCallAsIs(app); }
	// Calls to the system or kernel are kept as-is, with normalized inputs and outputs.
	def genCallAsIs(i_old: SsaApplyOp) {
		var i_new = apply(i_old.op, normRefs(i_old.inputs));
		i_new.facts = i_new.facts | i_old.facts;
		mapMultiReturn(i_old, i_new, normType(i_old.op.sig.returnType()));
	}
	def unexpected(i_old: SsaApplyOp) {
		context.fail1("unexpected operator %q", i_old.op.render);
	}
	def normId(i_old: SsaApplyOp) -> SsaInstr {
		normInputs(i_old);
		id(i_old);
		return i_old;
	}
	def genIntCmp(i_old: SsaApplyOp, infixH: IntType -> Operator, infixL: IntType -> Operator) -> SsaInstr {
		var tn = normIntType(i_old.op.typeArgs[0]);
		if (tn == null || tn.size == 1) return normInputs(i_old);
		var ai_new = normRefs(i_old.inputs);
		return genIntCmpRec(i_old, tn, ai_new, tn.bigEndIndex(), infixH, infixL);
	}
	def genIntCmpRec(i_old: SsaApplyOp, tn: IntNorm, ai_new: Array<SsaInstr>, i: int, infixH: IntType -> Operator, infixL: IntType -> Operator) -> SsaInstr {
		var i_a = ai_new[i], i_b = ai_new[i + tn.size];
		var tt = IntType.!(tn.sub[i]);
		if (i == tn.littleEndIndex()) {
			var op = infixL(tt);
			return apply(op, [i_a, i_b]);
		}
		var op = if(i == tn.littleEndIndex(), infixL, infixH)(tt);
		var i_cmp = apply(op, [i_a, i_b]);
		var i_eq = apply(tt.opEq(), [i_a, i_b]);
		var next = i + if(false, 1, -1);
		var i_sub = genIntCmpRec(i_old, tn, ai_new, next, infixH, infixL);
		var i_and = apply(V3Op.opBoolAnd, [i_eq, i_sub]);
		return apply(V3Op.opBoolOr, [i_cmp, i_and]);
	}
	def genShiftOp(i_old: SsaApplyOp) {
		var op = i_old.op, tt = IntType.!(op.sig.returnType());
		// Introduce an explicit if-then-else for shift overflow.
		if (!i_old.facts.O_NO_SHIFT_CHECK) {
			// XXX: check the config for saturating shifts (e.g. arm32).
			var split = SsaBlockSplit.new(context, ssa);
			var lt = Byte.TYPE.opLtEq();
			var max = context.graph.intConst(tt.width - 1);
			var ok = ssa.add(lt, [normRef1(i_old.inputs[1]), max], Fact.O_PURE);
			// Split the block
			i_old.remove();
			var tblock = ssa = split.addIf(ok);
			// Move shift to true case
			ssa.append(i_old);
			i_old.facts |= Fact.O_NO_SHIFT_CHECK;
			// Construct false case
			var fval: SsaInstr;
			var fblock = ssa = split.addElse();
			if (Opcode.IntSar.?(op.opcode)) {
				fval = ssa.add(op, [i_old.input0(), max], Fact.O_PURE);
			} else {
				fval = context.graph.nullConst(tt);
			}
			// replace all uses with the phi
			var merge = split.finish();
			var phi = split.addPhi(tt, [fval, fval]);
			i_old.replace(phi);
			phi.inputs[0].update(i_old);
			// lower the original shift
			ssa = tblock;
			ssa.setPrev(i_old.prev);
			doShift(i_old, op, tt);
			// lower the false shift
			if (SsaApplyOp.?(fval)) {
				ssa = fblock;
				ssa.setPrev(fval.prev);
				doShift(SsaApplyOp.!(fval), op, tt);
			}
			// continue at the merge
			ssa = merge;
			getReplacements(phi);
		} else {
			doShift(i_old, op, tt);
		}
	}
	def doSimpleShift(i_old: SsaApplyOp, op: Operator, tt: IntType) {
		normInputs(i_old);
		var trunc = Opcode.IntShl.?(op.opcode);
		var arith = config.getArithWidth(tt);
		var diff = arith.width - tt.width;
		var i0 = i_old.input0();
		if (diff <= 0) return void(id(i_old));
		if (Opcode.IntShl.?(op.opcode)) {
			// shift left in subword
			genTruncateInPlace(i_old, tt);
		} else if (Opcode.IntShr.?(op.opcode) && tt.signed && !i0.facts.V_NON_NEGATIVE) {
			// If this is a signed subword type, the value has is already implicitly sign-extended,
			// so first shift the sign bit left to the word's sign bit position, and then shift right
			var at = Int.getType(false, arith.width);
			var i1 = i_old.input1();
			var cdiff = context.graph.intConst(diff);
			var left = apply(at.opShl(), [i0, cdiff]);
			var right = apply(Byte.TYPE.opAdd(), [i1, cdiff]);
			var i_new: SsaInstr = ssa.pure(at.opShr(), [left, right]);
			if (!i1.facts.V_NON_ZERO) i_new = ssa.opIntViewI0(at, tt, i_new);
			return map1(i_old, i_new);
		}
		return void(id(i_old));
	}
	def doShift(i_old: SsaApplyOp, op: Operator, tt: IntType) {
		// 2 -> 1 operation.
		if (tt.width <= mach.intNorm.width) return doSimpleShift(i_old, op, tt);
		var inputs = normRefs(i_old.inputs);
		// N*2 -> N operation.
		var tn = mach.intNorm.makeType(tt);
		var wordCount = getWordShiftCount(inputs, tt, tn);
		if (wordCount > 0) {
			// Recognize shifts by constants that are a multiple of the word size.
			var bigEnd = tn.bigEndIndex();
			inputs = Arrays.range(inputs, 0, tn.size);
			var zero = context.graph.nullConst(mach.intNorm.word);
			if (Opcode.IntShl.?(op.opcode)) {
				tn.shiftLeft(inputs, wordCount, zero);
				inputs[bigEnd] = ssa.opIntViewI0(mach.intNorm.word, tn.sub[bigEnd], inputs[bigEnd]);
			} else if (Opcode.IntSar.?(op.opcode)) {
				var sign = extendBigEnd(inputs[bigEnd], IntType.!(tn.sub[bigEnd]), true);
				tn.shiftRight(inputs, wordCount, sign);
			} else if (Opcode.IntShr.?(op.opcode)) {
				var upper = IntType.!(tn.sub[bigEnd]).unsigned();
				inputs[bigEnd] = ssa.opIntViewI0(mach.intNorm.word, upper, inputs[bigEnd]);
				tn.shiftRight(inputs, wordCount, zero);
			}
			return mapN(i_old, inputs);
		}
		var trunc = false;
		if (Opcode.IntShl.?(op.opcode)) trunc = !i_old.facts.O_NO_INT_TRUNC;
		else if (Opcode.IntShr.?(op.opcode)) {
			op = mach.intNorm.shrOp;
			var bigEnd = tn.bigEndIndex();
			if ((tt.width % mach.intNorm.width != 0) && !inputs[bigEnd].facts.V_NON_NEGATIVE) {
				// convert input big end to unsigned
				var big = tn.sub[bigEnd], unsigned = IntType.!(big).unsigned();
				var cop = V3Op.newIntViewI(big, unsigned);
				inputs[bigEnd] = ssa.opIntViewI(cop, inputs[bigEnd]);
				trunc = !inputs[tn.size].facts.V_NON_ZERO;
			}
		}
		var i_new = apply(V3Op.newIntWide(op, tn.sub, tn.newType), inputs);
		return mapWide(i_old, i_new, tn, trunc);
	}
	def getWordShiftCount(inputs: Array<SsaInstr>, tt: IntType, tn: IntNorm) -> int {
		for (i = tn.size + 1; i < inputs.length; i++) {
			if (!SsaConst.?(inputs[i]) || inputs[i].unbox<int>() != 0) return -1;
		}
		if (!SsaConst.?(inputs[tn.size])) return -1;
		var shift = inputs[tn.size].unbox<int>();
		if ((shift % mach.intNorm.width) != 0) return -1;
		return shift / mach.intNorm.width;
	}
	def genIntDivOrMod(i_old: SsaApplyOp) {
		if (i_old.checkFact(Fact.O_NO_DIV_CHECK)) return genTruncatingIntOp(i_old);
		if ((config.ExplicitDivChecks && Opcode.IntDiv.?(i_old.op.opcode)) ||
		    (config.ExplicitModChecks && Opcode.IntMod.?(i_old.op.opcode))) {
			var tt = IntType.!(i_old.op.sig.returnType());
			if (tt.signed) {
				var ifc = ssa.splitForIfCascade(tt);
				var x = i_old.input0(), y = i_old.input1();
				var minus1 = context.graph.valConst(tt, tt.box(-1));
				var cmp = ssa.add(tt.opEq(), [y, minus1], Facts.NONE);
				ifc.addCase(cmp);

				var tv: SsaInstr, zero = context.graph.nullConst(tt);
				if (Opcode.IntDiv.?(i_old.op.opcode)) {
					var neg = ssa.add(tt.opSub(), [zero, x], Facts.NONE);
					// XXX: weird to apply this to new instructions.
					tv = if(SsaApplyOp.?(neg), genTruncateInPlace(SsaApplyOp.!(neg), tt), neg);
				} else {
					tv = zero;  // x % -1 == #0
				}
				ifc.endCase(tv);
				ifc.addElse();
				var i_new = id(ssa.add(i_old.op, [x, y], i_old.facts | Fact.O_NO_DIV_CHECK));
				ifc.endCase(i_new);
				var phi = ifc.finish();
				i_old.replace(phi);
				i_old.remove();
				getReplacements(phi);  // XXX: side-effect of normalizing phi
				return;
			}
		}
		return genTruncatingIntOp(i_old);
	}
	def genTruncatingIntOp(i_old: SsaApplyOp) {
		var tt = IntType.!(i_old.op.sig.returnType());
		var tn = normIntType(tt);
		if (tn == null) {
			// normal width (i.e. 2 -> 1) operation.
			normInputs(i_old);
			genTruncateInPlace(i_old, tt);
		} else {
			// N*2 -> N operation.
			var i_new = apply(V3Op.newIntWide(i_old.op, tn.sub, tn.newType), normRefs(i_old.inputs));
			mapWide(i_old, i_new, tn, !i_old.facts.O_NO_INT_TRUNC);
		}
	}
	def genTruncateInPlace(i_old: SsaApplyOp, tt: IntType) -> SsaInstr {
		if (i_old.facts.O_NO_INT_TRUNC) return id(i_old);
		i_old.facts |= Fact.O_NO_INT_TRUNC; // {i_old} will not need truncation again
		var width = tt.width, arithWidth = mach.intNorm.width;
		if (width >= arithWidth) return id(i_old);
		if (config.Int8Arith && width <= 8) {
			if (width == 8) return id(i_old);
			arithWidth = 8;
		} else if (config.Int16Arith && width <= 16) {
			if (width == 16) return id(i_old);
			arithWidth = 16;
		} else if (config.Int32Arith && width <= 32) {
			if (width == 32) return id(i_old);
			arithWidth = 32;
		}

		ssa.setPrev(i_old);
		var arithType = if(arithWidth == mach.intNorm.width, mach.intNorm.word, Int.getType(false, arithWidth));
		var trunc = ssa.opIntViewI0(arithType, i_old.op.sig.returnType(), i_old);
		map1keep(i_old, trunc);
		trunc.inputs[0].update(i_old);
		return trunc;
	}
	def genParallelIntOp(i_old: SsaApplyOp, infix: IntType -> Operator) {
		var tt = IntType.!(i_old.op.sig.returnType());
		if (tt.width <= mach.intNorm.width) {
			// 2 -> 1 operation.
			normInputs(i_old);
			return void(id(i_old));
		}
		// N*2 -> N operation.
		var inputs = normRefs(i_old.inputs);
		var tn = mach.intNorm.makeType(tt);
		var vals = Array<SsaInstr>.new(tn.size);
		for (i < vals.length) {
			var op = infix(IntType.!(tn.sub[i]));
			vals[i] = apply(op, [inputs[i], inputs[i + tn.size]]);
		}
		return mapN(i_old, vals);
	}
	def extendBigEnd(bigEnd: SsaInstr, ft: IntType, signed: bool) -> SsaInstr {
		if (signed) {
			var shift = context.graph.intConst(mach.intNorm.width - 1);
			var i = apply(ft.opSar(), [bigEnd, shift]);
			i.facts |= Fact.O_NO_SHIFT_CHECK;
			return i;
		}
		return context.graph.nullConst(mach.intNorm.word);
	}
	def genIntViewI(i_old: SsaApplyOp) {
		var inputs = normRefs(i_old.inputs);
		var ft = IntType.!(i_old.op.sig.paramTypes[0]);
		var tt = IntType.!(i_old.op.sig.returnType());
		if (tt.width > mach.intNorm.width) {
			// M -> (N > 1) conversion.
			var ftn = mach.intNorm.makeType(ft);
			var ttn = mach.intNorm.makeType(tt);
			var fbig = ftn.bigEndIndex();
			if (ftn.size < ttn.size) {
				// M < N, so sign or zero extend the big end.
				var signed = ft.signed && !i_old.inputs[0].dest.facts.V_NON_NEGATIVE;
				var extend = extendBigEnd(inputs[fbig], ft, signed);
				var vals = ftn.growToN(inputs, ttn.size, extend);
				// truncate the target's big end only if it is actually narrower than a word
				var tbig = ttn.bigEndIndex(), tbt = IntType.!(ttn.sub[tbig]);
				if (tbt.width < mach.intNorm.width) vals[tbig] = ssa.opIntViewI0(mach.intNorm.word, tbt, vals[tbig]);
				return mapN(i_old, vals);
			}
			// M >= N, so select N values from inputs.
			var vals = ftn.getLowestN(inputs, ttn.size);
			// truncate the big end if necessary.
			var tbig = ttn.bigEndIndex(), tbt = ttn.sub[tbig];
			var fbt = if(tbig == fbig, ftn.sub[fbig], mach.intNorm.word);
			if (fbt != tbt) vals[tbig] = ssa.opIntViewI0(fbt, tbt, vals[tbig]);
			return mapN(i_old, vals);
		}
		var i_new: SsaInstr;
		if (ft.width > mach.intNorm.width) {
			// (N > 1) -> 1 conversion.
			var ftn = mach.intNorm.makeType(ft);
			var ttn = mach.intNorm.makeType(tt);
			var lt = ftn.sub[ftn.littleEndIndex()];
			var little = inputs[ftn.littleEndIndex()];
			if (lt == ttn.newType) i_new = little;
			else i_new = opIntViewINorm(IntType.!(lt), IntType.!(ttn.newType), little);
		} else {
			// 1 -> 1 conversion.
			i_new = opIntViewINorm(ft, tt, inputs[0]);
		}
		return map1(i_old, i_new);
	}
	def wideOutputs(op: Operator, tn: TypeNorm, inputs: Array<SsaInstr>, facts: Fact.set) -> Array<SsaInstr> {
		if (tn != null) {
			var i_new = apply(V3Op.newIntWide(op, op.sig.paramTypes, tn.newType), inputs);
			i_new.facts |= facts;
			var vals = Array<SsaInstr>.new(tn.sub.length);
			for (i < tn.size) vals[i] = apply(V3Op.newTupleGetElem(tn.newType, i), [i_new]);
			return vals;
		} else {
			var i_new = apply(op, inputs);
			i_new.facts |= facts;
			return [i_new];
		}
	}
	def wideInputs(op: Operator, tn: TypeNorm, inputs: Array<SsaInstr>, facts: Fact.set) -> SsaInstr {
		if (tn != null) op = V3Op.newIntWide(op, tn.sub, op.sig.returnType());
		var i_new = apply(op, inputs);
		i_new.facts |= facts;
		return i_new;
	}
	def mostlyRoundUpIntType(it: IntType) -> IntType {
		match (it.rank) {
			SUBU32, SUBI32 => return Int.getType(it.signed, 31);
			SUBU64, SUBI64 => return Int.getType(it.signed, 63);
			_ => return it;
		}
	}
	def genIntTruncFEqual(ft: Type, itt: IntType, x: SsaInstr) -> SsaInstr {
		var tn = normIntType(itt);
		var truncs = wideOutputs(V3Op.newIntTruncF(ft, itt), tn, [x], Fact.O_NO_BOUNDS_CHECK);
		var back = genFloatConvertI(V3Op.newFloatPromoteI(itt, ft), truncs);
		return ssa.opFloatBitEq(ft == Float.FLOAT64, x, back);
	}
	def wideConsts(tn: TypeNorm, v: SsaConst) -> Array<SsaInstr> {
		if (tn == null || tn.size == 1) return [v];
		return normConstAsArray(tn, v);
	}
	def addPhis(merge: SsaBuilder, t: Type, tn: TypeNorm, vals: Array<Array<SsaInstr>>) -> Array<SsaInstr> {
		var subs = if(tn == null, [t], tn.sub);
		var phis = Array<SsaInstr>.new(subs.length);
		for (i < subs.length) {
			var inputs = Array<SsaInstr>.new(vals.length);
			for (j < inputs.length) inputs[j] = vals[j][i];
			phis[i] = merge.addPhi(t, inputs);
		}
		return phis;
	}
	def genFloatConvertI(op: Operator, inputs: Array<SsaInstr>) -> SsaInstr {
		var itt = IntType.!(op.typeArgs[0]);
		var tn = normIntType(itt);
		var i_new: SsaInstr;

		if (!config.FloatConvertIUnsigned && itt.rank == IntRank.U32) {
			// zero-extend to i64 and convert
			var sit = Long.TYPE, ft = op.typeArgs[1];
			tn = normIntType(sit);
			match (op.opcode) {
				FloatPromoteI(is64) => op = V3Op.newFloatPromoteI(sit, op.typeArgs[1]);
				FloatRoundI(is64) => op = V3Op.newFloatRoundI(sit, op.typeArgs[1]);
				_ => context.fail("unexpected float conversion");
			}
			if (tn != null) {
				var p = inputs[0]; // TODO: assumes u32 not already normalized
				inputs = Array<SsaInstr>.new(tn.size);
				for (i < inputs.length) inputs[i] = context.graph.nullConst(tn.sub[0]);
				inputs[tn.littleEndIndex()] = p;
			}
			i_new = wideInputs(op, tn, inputs, Facts.NONE);
		} else if (!config.FloatConvertIUnsigned && itt.rank == IntRank.U64) {
			// if (x < 0) 2.0f * cvt((x & 1) | (x >> 1))
			var sit = Int.getType(true, itt.width), ft = FloatType.!(op.typeArgs[1]);
			tn = normIntType(itt);
			match (op.opcode) {
				FloatPromoteI(is64) => op = V3Op.newFloatPromoteI(sit, op.typeArgs[1]);
				FloatRoundI(is64) => op = V3Op.newFloatRoundI(sit, op.typeArgs[1]);
				_ => context.fail("unexpected float conversion");
			}
			var ifc = ssa.splitForIfCascade(ft);
			var i: SsaInstr;
			var littleEndIndex: int, littleEndType: IntType;
			if (tn != null && tn.size > 0) { // normalized; compare upper end
				i = inputs[tn.bigEndIndex()];
				sit = IntType.!(tn.sub[tn.bigEndIndex()]);
				littleEndIndex = tn.littleEndIndex();
				littleEndType = IntType.!(tn.sub[littleEndIndex]);
			} else {
				i = inputs[0];
				littleEndType = sit;
			}
			var zero = context.graph.nullConst(sit);
			var i_lteq = apply(sit.opLtEq(), [zero, i]);
			ifc.addCase(i_lteq); // true case; do conversion
			var cvt = wideInputs(op, tn, inputs, Facts.NONE);
			ifc.endCase(cvt);
			ifc.addElse(); // false case
			var littleEnd = inputs[littleEndIndex];
			var one = context.graph.valConst(littleEndType, Int.ONE);
			littleEnd =
				apply(littleEndType.opOr(),
					[apply(littleEndType.opShr(),
						[littleEnd, one]),
					apply(littleEndType.opAnd(),
						[littleEnd, one])]);
			var inputs2 = Arrays.dup(inputs);
			inputs2[littleEndIndex] = littleEnd;
			var cvt2 = wideInputs(op, tn, inputs2, Facts.NONE);
			var two = context.graph.valConst(ft, if(ft.is64, Float.f64(0, 1, 0), Float.f32(0, 1, 0)));
			var mul = apply(ft.opcache().opMul, [cvt2, two]);
			ifc.endCase(mul);
			i_new = ifc.finish();
		} else {
			i_new = wideInputs(op, tn, inputs, Facts.NONE);
		}
		return id(i_new); // TODO: is id() correct here?
	}
	def opIntViewINorm(ft: IntType, tt: IntType, x: SsaInstr) -> SsaInstr {
		if (ft.width == tt.width) {
			if (ft.width == mach.intNorm.width) return x;
			if (ft.width == 32 && config.Int32Arith) return x;
			if (ft.width == 16 && config.Int16Arith) return x;
			if (ft.width == 8 && config.Int8Arith) return x;
		}
		if (config.Int32Arith && TypeSystem.isIntToLong(ft, tt)) return ssa.opIntViewI0(ft, tt, x);
		if (TypeSystem.isIntPromotable(ft, tt)) return x;
		return ssa.opIntViewI0(ft, tt, x);
	}
	def mapWide(i_old: SsaApplyOp, i_new: SsaInstr, tn: IntNorm, truncate: bool) {
		if (tn == null) return map1(i_old, i_new);
		var vals = Array<SsaInstr>.new(tn.sub.length);
		for (i < tn.size) vals[i] = apply(V3Op.newTupleGetElem(tn.newType, i), [i_new]);
		if (truncate) {
			// truncate the big end of the result if necessary.
			var tbig = tn.bigEndIndex(), rem = tn.sub[tbig];
			if (IntType.!(rem).width < mach.intNorm.width) {
				vals[tbig] = apply(V3Op.newIntViewI(mach.intNorm.word, rem), [vals[tbig]]);
			}
		}
		mapN(i_old, vals);
	}
	def genClassCast(i_old: SsaApplyOp, ft: Type, tt: Type) -> SsaInstr {
		var i_new = normRef1(i_old.inputs[0]);
		var t = mach.runtime.classIdRange(tt), low = t.0, high = t.1;
		if (low == high) {
			// no live classes can match, only null
			if (!V3Op.needsNullCheck(i_old, i_new)) return addThrow(V3Exception.TypeCheck);
			var cmp = ssa.opNotEqual(ft, i_new, context.graph.nullConst(ft));
			apply(V3Op.newConditionalThrow(V3Exception.TypeCheck), [cmp]);
			i_new = context.graph.nullConst(tt);
		} else {
			i_new = genIfNull(i_old, mach.machType(tt), i_new, null, genClassIdCheck(i_old, tt, low, high, _));
		}
		return i_new;
	}
	def genVariantCast(i_old: SsaApplyOp, ft: Type, tt: Type) -> SsaInstr {
		var i_new = normRef1(i_old.inputs[0]);
		var t = mach.runtime.classIdRange(tt), low = t.0, high = t.1;
		if (low == high) {
			i_new = addThrow(V3Exception.TypeCheck); // no variant values can match
		} else {
			i_new = genClassIdCheck(i_old, tt, low, high, i_new);
		}
		return i_new;
	}
	def genClassIdCheck(i_old: SsaApplyOp, tt: Type, low: int, high: int, i_new: SsaInstr) -> SsaInstr {
		var i_tid = loadTypeId(i_new, tt);
		ssa.opIntRangeCheck(mach.code.addressSize, low, high, i_tid);
		return i_new;
	}
	def genTypeQuery(i_old: SsaApplyOp, query: TypeQuery) -> SsaInstr {
		var ft = i_old.op.typeArgs[0], tt = i_old.op.typeArgs[1];
		var i_new = normRef1(i_old.inputs[0]);
		match (query) {
			TRUE => return context.graph.trueConst();
			TRUE_IF_NOT_NULL => return ssa.opNotEqual(ft, i_new, context.graph.nullConst(ft));
			FALSE => return context.graph.trueConst();
			CLASS_QUERY => {
				var t = mach.runtime.classIdRange(tt), low = t.0, high = t.1;
				if (low == high) return context.graph.falseConst(); // no live classes match
				return genIfNull(i_old, Bool.TYPE, i_new, null, genClassIdQuery(i_old, tt, low, high, _));
			}
			VARIANT_QUERY => {
				var t = mach.runtime.classIdRange(tt), low = t.0, high = t.1;
				if (low == high) return context.graph.falseConst();
				return genClassIdQuery(i_old, tt, low, high, i_new);
			}
			_ => {
				context.fail1("unexpected type query: %s", query.name);
				return context.graph.falseConst();
			}
		}
	}
	def genClassIdQuery(i_old: SsaApplyOp, tt: Type, low: int, high: int, nobj: SsaInstr) -> SsaInstr {
		var tid = loadTypeId(nobj, tt);
		return genRangeQuery(i_old, low, high, tid);
	}
	def genRangeQuery(i_old: SsaApplyOp, low: int, high: int, val: SsaInstr) -> SsaInstr {
		if (high == low + mach.code.addressSize) { // XXX: better factoring of degenerate range checks
			return apply(V3Op.newEqual(Int.TYPE), [val, context.graph.intConst(low)]);
		} else {
			var cmp1 = ssa.opIntGteq(val, context.graph.intConst(low));
			var cmp2 = ssa.opIntLt(val, context.graph.intConst(high));
			return apply(V3Op.opBoolAnd, [cmp1, cmp2]);
		}
	}
	def genTypeSubsume(i_old: SsaApplyOp) {
		mapN(i_old, normRefs(i_old.inputs));  // always a no-op at the machine level
	}
	def genArrayAlloc(i_old: SsaApplyOp) -> SsaInstr {
		var olen = i_old.inputs[0], arrayType = i_old.op.typeArgs[0];
		var hsize = mach.getArrayElemOffset(arrayType, 0), scale = mach.getArrayElemScale(arrayType);
		if (SsaConst.?(olen.dest)) {
			// length is known statically
			var len = olen.dest.unbox<int>();
			if (len < 0) return addThrow(V3Exception.LengthCheck);
			return genArrayAllocWithSize(arrayType, hsize, len, scale);
		}
		var nlen = normRef1(olen);
		if (!i_old.facts.O_NO_NEGATIVE_CHECK && !context.compiler.DisableLengthChecks) {
			// add a check (length < 0)
			var check = ssa.opIntLt(nlen, context.graph.zeroConst());
			apply(V3Op.newConditionalThrow(V3Exception.LengthCheck), [check]);
		}
		if (scale > 0) {
			// Guard against lengths whose scaled size would overflow 32-bit.
			var check = ssa.opU32Lt(context.graph.intConst(maxArrayLength(hsize, scale)), nlen);
			apply(V3Op.newConditionalThrow(V3Exception.HeapOverflow), [check]);
		}
		var size: SsaInstr = context.graph.intConst(hsize);
		if (scale > 0) {
			// scale the length by the element scale
			var elemsize = nlen;
			if (scale > 1) elemsize = ssa.opIntMul(nlen, context.graph.intConst(scale));
			if (scale != mach.data.addrAlign.alignUp_i32(scale)) {
				// alignment is necessary
				size = ssa.opIntAdd(elemsize, context.graph.intConst(hsize + mach.data.addrAlign.add));
				size = ssa.opIntAnd(size, context.graph.intConst(int.view(mach.data.addrAlign.mask_u32)));
			} else {
				size = ssa.opIntAdd(elemsize, size);
			}
		}
		// allocate the array, store tag, and store length
		mach.allocates = true;
		var narr = genAlloc(mach.machType(arrayType), size);
		storeObjectTag(narr, arrayType);
		ptrStore(Int.TYPE, narr, mach.getArrayLengthOffset(arrayType), nlen);
		return narr;
	}
	def maxArrayLength(hsize: int, scale: int) -> int {
		if (scale <= 0) return int.max;
		return int.view((long.view(int.max) - hsize - mach.data.addrAlign.add) / scale);
	}
	def genArrayAllocWithSize(arrayType: Type, hsize: int, len: int, scale: int) -> SsaInstr {
		if (len > maxArrayLength(hsize, scale)) return addThrow(V3Exception.HeapOverflow);
		var totalSize = mach.data.addrAlign.alignUp_i32(hsize + len * scale);
		// allocate the array with the known size
		mach.allocates = true;
		var narr = genAlloc(mach.machType(arrayType), context.graph.intConst(totalSize));
		storeObjectTag(narr, arrayType); // store tag
		ptrStore(Int.TYPE, narr, mach.getArrayLengthOffset(arrayType), context.graph.intConst(len)); // store length
		return narr;
	}
	def genAlloc(mtype: Type, size: SsaInstr) -> SsaInstr {
		if (context.compiler.IrAlloc) {
			var m = genAllocMethod(Int.TYPE);
			var methodRef = IrSpec.new(m.receiver, TypeUtil.NO_TYPES, m);
			var funcRep = mach.funcRep(methodRef);
			var func = context.graph.valConst(funcRep.machType, getCodeAddress(methodRef));
			var op = V3Op.newCallAddress(funcRep); // XXX: cache
			def machReceiverType = mach.machType(MachModule.getAnyRefType());
			return apply(op, [func, context.graph.nullConst(machReceiverType), size]);
		} else {
			return apply(V3Op.newAlloc(mtype), [size]);
		}
	}
	def genArrayInit(i_old: SsaApplyOp) -> SsaInstr {
		var arrayType = i_old.op.typeArgs[0];
		var offset = mach.getArrayElemOffset(arrayType, 0), scale = mach.getArrayElemScale(arrayType);
		var narr = genArrayAllocWithSize(arrayType, offset, i_old.inputs.length, scale);
		var machType = mach.machType(V3Array.elementType(arrayType));
		var tn = normIntType(machType), stride = if(tn == null, 1, tn.size);
		var inputs = normRefs(i_old.inputs);
		for (i = 0; i < inputs.length; (i = i + stride, offset = offset + scale)) {
			// generate unchecked pointer stores to initialize the array
			// XXX: cache type normalization across calls to this method
			genNormTypedStores(Fact.O_NO_NULL_CHECK, true, machType, narr, offset, inputs, i);
		}
		return narr;
	}
	def genArrayTupleInit(i_old: SsaApplyOp, elems: int, length: int) -> SsaInstr {
		var arrayType = i_old.op.typeArgs[0];
		var arrayRep = mach.arrayRep(arrayType);
		var narr = genArrayAllocWithSize(arrayType, arrayRep.headerSize, length, arrayRep.elemScale);
		for (i < length) {
			for (j < elems) {
				var val = i_old.inputs[i * elems + j];
				var inputs = normRefN(val);
				var offset = arrayRep.headerSize + arrayRep.offsets[j] + i * arrayRep.elemScale;
				// XXX: cache type normalization across calls to this method
				genNormTypedStores(Fact.O_NO_NULL_CHECK, true, arrayRep.elemTypes[j], narr, offset, inputs, 0);
			}
		}
		return narr;
	}
	def genArrayGetElem(i_old: SsaApplyOp, elem: int) {
		var inputs = normRefs(i_old.inputs);
		var narr = inputs[0], nindex = inputs[1], arrayType = i_old.op.typeArgs[0];
		var nullity = context.compiler.nullity(i_old, narr);
		nullity = genBoundsCheck(i_old, nullity).1;
		var arrayRep = mach.arrayRep(arrayType);
		var offset = genArrayElemOffset(arrayRep.getElemElemOffset(elem), arrayRep.elemScale, nindex);
		// XXX: fold null check into pointer access if no bounds check
		var machType = mach.machType(arrayRep.getElemElemType(arrayType, elem));
		var loads = genNormTypedLoads(nullity, machType, ptrAdd(narr, offset), 0);
		mapN(i_old, loads);
	}
	def genArraySetElem(i_old: SsaApplyOp, elem: int) {
		var inputs = normRefs(i_old.inputs);
		var narr = inputs[0], nindex = inputs[1], arrayType = i_old.op.typeArgs[0];
		var nullity = context.compiler.nullity(i_old, narr);
		nullity = genBoundsCheck(i_old, nullity).1;
		var arrayRep = mach.arrayRep(arrayType);
		var offset = genArrayElemOffset(arrayRep.getElemElemOffset(elem), arrayRep.elemScale, nindex);
		// XXX: fold null check into pointer access if no bounds check
		var machType = mach.machType(arrayRep.getElemElemType(arrayType, elem));
		genNormTypedStores(nullity, false, machType, ptrAdd(narr, offset), 0, inputs, 2);
		i_old.kill();
		i_old.remove();
	}
	def genRangeStartPlusIndex(i_old: SsaApplyOp) -> SsaInstr {
		var arrayType = i_old.op.typeArgs[0];
		var inputs = normRefs(i_old.inputs);
		var rangeStart = inputs[1];
		var index = inputs[2]; // XXX: discarding upper words for normalized integers
		var offset = genArrayElemOffset(0, mach.getArrayElemScale(arrayType), index);
		return ptrAdd(rangeStart, offset);
	}
	def genNormRangeGetElem(i_old: SsaApplyOp, elem: int) {
		var inputs = normRefs(i_old.inputs);
		var narr = inputs[0], rangeStart = inputs[1], nindex = inputs[2], rangeType = i_old.op.typeArgs[0];
		var arrayRep = mach.arrayRep(rangeType);
		var offset = genArrayElemOffset(if(arrayRep.offsets != null, arrayRep.offsets[elem], 0), arrayRep.elemScale, nindex);
		var pos = ptrAdd(ptrAdd(narr, rangeStart), offset);
		var machType = mach.machType(arrayRep.getElemElemType(rangeType, elem));
		var loads = genNormTypedLoads(Fact.O_NO_NULL_CHECK, machType, pos, 0);
		mapN(i_old, loads);
	}
	def genNormRangeSetElem(i_old: SsaApplyOp, elem: int) {
		var inputs = normRefs(i_old.inputs);
		var narr = inputs[0], rangeStart = inputs[1], nindex = inputs[2], rangeType = i_old.op.typeArgs[0];
		var arrayRep = mach.arrayRep(rangeType);
		var offset = genArrayElemOffset(if(arrayRep.offsets != null, arrayRep.offsets[elem], 0), arrayRep.elemScale, nindex);
		var pos = ptrAdd(ptrAdd(narr, rangeStart), offset);
		var machType = mach.machType(arrayRep.getElemElemType(rangeType, elem));
		genNormTypedStores(Fact.O_NO_NULL_CHECK, false, machType, pos, 0, inputs, 3);
		i_old.kill();
		i_old.remove();
	}
	def genByteArrayGetField(i_old: SsaApplyOp, offset: int, order: ByteOrder) {
		var inputs = normRefs(i_old.inputs);
		var ni_arr = inputs[0], ni_start = inputs[1];
		var fieldType = i_old.op.typeArgs[0];
		var base = ptrAdd(ni_arr, ni_start);
		var nullity = context.compiler.nullity(i_old, base);
		if (!nullity.O_NO_NULL_CHECK && !config.ImplicitNullChecks) genNullCheck0(base);
		if (i_old.op.typeArgs[1] != V3Range.START_TYPE) offset += mach.arrayRep(V3.arrayByteType).getElemElemOffset(0);

		var memoryOrder = if(mach.data.bigEndian, ByteOrder.BIG_ENDIAN, ByteOrder.LITTLE_ENDIAN);
		var t = MachLowerings.decomposeByteArrayAccess(mach, config, fieldType, offset, order, memoryOrder, false), tn = t.0, accesses = t.1;

		var ai_results = Array<SsaInstr>.new(accesses.length);
		for (i < accesses.length) {
			var a = accesses[i];
			match (a) {
				Simple(t, offset) => {
					var d = ptrLoad(t, base, offset);
					ai_results[i] = d;
				}
				Compound(t, wordType, datums) => {
					var d: SsaInstr, or = wordType.opOr(), shl = wordType.opShl();
					for (datum in datums) {
						var l = ptrLoad(datum.t, base, datum.offset);
						if (datum.t != wordType) l = ssa.pure(V3Op.newIntViewI(datum.t, wordType), [l]);
						if (datum.shift > 0) l = ssa.pure(shl, [l, context.graph.intConst(datum.shift)]);
						if (d != null) d = ssa.pure(or, [d, l]);
						else d = l;
					}
					var op = getAccessViewOp(t, wordType);
					if (op != null) d = ssa.pure(op, [d]);
					ai_results[i] = d;
				}
			}
		}
		if (tn != null && tn.newType != fieldType) {
			if (IntType.?(fieldType) && tn.size > 1) {
				viewBigEndWord(IntNorm.!(tn), mach.intNorm.makeType(IntType.!(fieldType)), ai_results);
			} else {
				var op = getAccessViewOp(fieldType, tn.newType);
				if (op != null) ai_results = [wideInputs(op, if(tn.size > 1, tn), ai_results, Fact.O_PURE)];
			}
		}
		if (BoolType.?(fieldType)) {
			// a bool field's truth value is the lowest bit of its byte
			ai_results[0] = ssa.pure(Byte.TYPE.opAnd(), [ai_results[0], context.graph.intConst(1)]);
		}
		return mapN(i_old, ai_results);
	}
	def genByteArraySetField(i_old: SsaApplyOp, offset: int, order: ByteOrder) { // TODO: byte order
		var inputs = normRefs(i_old.inputs);
		var ni_arr = inputs[0], ni_start = inputs[1], vals = Arrays.range(inputs, 2, inputs.length);
		var fieldType = i_old.op.typeArgs[0];
		var base = ptrAdd(ni_arr, ni_start);
		var nullity = context.compiler.nullity(i_old, base);
		if (!nullity.O_NO_NULL_CHECK && !config.ImplicitNullChecks) genNullCheck0(base);
		if (i_old.op.typeArgs[1] != V3Range.START_TYPE) offset += mach.arrayRep(V3.arrayByteType).getElemElemOffset(0);

		var memoryOrder = if(mach.data.bigEndian, ByteOrder.BIG_ENDIAN, ByteOrder.LITTLE_ENDIAN);
		var t = MachLowerings.decomposeByteArrayAccess(mach, config, fieldType, offset, order, memoryOrder, false), tn = t.0, accesses = t.1;

		var ai_results = Array<SsaInstr>.new(accesses.length);
		if (tn != null && tn.newType != fieldType) {
			if (IntType.?(fieldType) && tn.size > 1) {
				viewBigEndWord(mach.intNorm.makeType(IntType.!(fieldType)), IntNorm.!(tn), vals);
			} else {
				var op = getAccessViewOp(tn.oldType, fieldType);
				var atn = if(tn.size > 1, tn);
				if (op != null) vals = wideOutputs(op, atn, vals, Fact.O_PURE);
			}
		}
		for (i < accesses.length) {
			var a = accesses[i], i_val = vals[i];
			match (a) {
				Simple(t, offset) => {
					ptrStore(t, base, offset, i_val);
				}
				Compound(t, wordType, datums) => {
					var shr = wordType.opShr();
					if (t != wordType) match (t) {
						x: FloatType => i_val = ssa.pure(if(x.is64, V3Op.opIntViewF64, V3Op.opIntViewF32), [i_val]);
					}
					for (datum in datums) {
						var v = if(datum.shift == 0, i_val, ssa.pure(shr, [i_val, context.graph.intConst(datum.shift)]));
						ptrStore(datum.t, base, datum.offset, v);
					}
				}
			}
		}
		i_old.kill();
		i_old.remove();
	}
	def viewBigEndWord(from: IntNorm, to: IntNorm, vals: Array<SsaInstr>) {
		var big = from.bigEndIndex();
		var fbt = IntType.!(from.sub[big]), tbt = IntType.!(to.sub[big]);
		if (fbt != tbt) vals[big] = opIntViewINorm(fbt, tbt, vals[big]);
	}
	def getAccessViewOp(fieldType: Type, wordType: Type) -> Operator {
		if (fieldType == wordType) return null;
		match (fieldType) {
			x: BoolType => return null; // bool loads are masked to bit 0 in genByteArrayGetField
			x: IntType => match (wordType) {
				y: IntType => return V3Op.newIntViewI(wordType, x);
				y: FloatType => return if(y.is64, V3Op.opIntViewF64, V3Op.opIntViewF32);
				_ => return null; // TODO
			}
			x: FloatType => return if(x.is64, V3Op.newFloat64ViewI(wordType), V3Op.newFloat32ViewI(wordType));
			_ => return null; // TODO
		}
	}
	def genArrayElemOffset(headerSize: int, scale: int, index: SsaInstr) -> SsaInstr {
		if (SsaConst.?(index)) {
			// fold the offset calculation
			return context.graph.intConst(headerSize + scale * index.unbox<int>());
		} else {
			var offset = index;
			if (scale > 1) offset = ssa.opIntMul(index, context.graph.intConst(scale));
			if (headerSize != 0) offset = ssa.opIntAdd(offset, context.graph.intConst(headerSize));
			return offset;
		}
	}
	def genArrayGetLength(i_old: SsaApplyOp) -> SsaInstr {
		var oarr = i_old.inputs[0], narr = normRef1(oarr);
		var nullity = context.compiler.nullity(i_old, null);
		return refLoad(nullity, Int.TYPE, i_old, oarr, narr, mach.getArrayLengthOffset(i_old.op.typeArgs[0]));
	}
	def genClassAlloc(i_old: SsaApplyOp, method: IrMethod) {
		var classType = i_old.getType();
		var ic = context.prog.ir.getIrClass(classType);
		mach.allocates = true;
		var size = mach.getObjectSize(classType, null);
		var nobj = genAlloc(mach.machType(classType), context.graph.intConst(size));
		storeObjectTag(nobj, classType);
		// A descriptor object needs its reserved metadata slots initialized.
		if (ic != null && ic.flags.C_IS_DESCRIPTOR) initDescriptorSlots(nobj, ClassType.!(classType));
		if (method != null) {
			var newRef = V3Op.extractIrSpec(i_old.op, method);
			var funcRep = mach.funcRep(newRef);
			// nontrivial constructor
			var func = context.graph.valConst(funcRep.machType, getCodeAddress(newRef));
			var args = Arrays.prepend(func, Arrays.prepend(nobj, normRefs(i_old.inputs)));
			call(i_old, funcRep, args);
			return;
		}
		return map1(i_old, nobj);
	}
	def initDescriptorSlots(nobj: SsaInstr, descType: ClassType) {
		var m = mach.descriptorMetadata(descType);
		ptrStore(mach.tagType, nobj, mach.runtime.descTidOffset, context.graph.intConst(m.0));
		ptrStore(mach.tagType, nobj, mach.runtime.descRefmapOffset, context.graph.intConst(m.1));
		ptrStore(mach.tagType, nobj, mach.runtime.descSizeOffset, context.graph.intConst(m.2));
	}
	def genDescriptorCheck(i_old: SsaApplyOp) -> SsaInstr {
		var i_desc = normRef1(i_old.inputs[0]);
		genNullCheck0(i_desc);
		var descType = ClassType.!(i_old.op.typeArgs[0]);
		var i_tid: SsaInstr, tag: int;
		var ic = context.prog.ir.getIrClass(descType);
		var described = if(ic != null && ic.flags.C_IS_DESCRIPTOR, descType.getDescribesType());
		if (described != null) {
			// Check the type id of the class the descriptor describes.
			i_tid = ptrLoad(mach.tagType, i_desc, mach.runtime.descTidOffset);
			tag = mach.runtime.getSimpleObjectTag(described);
		} else {
			// Without runtime extensions, check the descriptor's own object header.
			i_tid = ptrLoad(mach.tagType, i_desc, 0);
			tag = mach.runtime.getObjectTag(descType);
		}
		var i_neq = ssa.opBoolNot(ssa.pure2(mach.tagType.opEq(), i_tid, context.graph.intConst(tag)));
		ssa.opConditionalThrow(V3Exception.DescriptorCheck, i_neq);
		return i_desc;
	}
	def genVariantAlloc(i_old: SsaApplyOp) {
		var classType = i_old.getType();
		var size = mach.getObjectSize(classType, null);
		mach.allocates = true;
		var i_new = genAlloc(mach.machType(classType), context.graph.intConst(size));
		storeObjectTag(i_new, classType);
		var ic = context.prog.ir.getIrClass(classType);
		var ai_inputs = normRefs(i_old.inputs);
		var start = 0;
		for (i < ic.fields.length) {
			var f = ic.fields[i];
			var machType = mach.machType(f.fieldType);
			var tn = normIntType(machType);
			genNormTypedStores(Fact.O_NO_NULL_CHECK, true, machType, i_new, f.machOffset, ai_inputs, start);
			start += if(tn != null, tn.size, 1);
		}
		return map1(i_old, i_new);
	}
	def genClassGetField(isVariant: bool, i_old: SsaApplyOp, field: IrField) {
		var fieldRef = V3Op.extractIrSpec(i_old.op, field);
		var oobj = i_old.inputs[0], nobj = normRef1(oobj);
		var machType = mach.machType(fieldRef.getFieldType());
		var offset = getClassFieldOffset(fieldRef);
		var nullity = context.compiler.nullity(i_old, oobj.dest);
		if (isVariant) {
			var tblock: SsaBuilder, fblock: SsaBuilder, merge: SsaBuilder;
			var sub: Array<Type>;
			if (!nullity.O_NO_NULL_CHECK) {
				var t = addIfNull(nobj);
				tblock = t.0;
				fblock = t.1;
				merge = t.2;
				ssa = fblock;
				var tn = normIntType(machType);
				sub = if(tn == null, [machType], tn.sub);
			}
			var loads = genNormTypedLoads(Fact.O_NO_NULL_CHECK, machType, nobj, offset);
			if (!nullity.O_NO_NULL_CHECK) {
				fblock.addGoto(merge.block);
				tblock.addGoto(merge.block);
				ssa = merge;
				for (i < loads.length) {
					loads[i] = ssa.addPhi(sub[i], [loads[i], context.graph.nullConst(sub[i])]);
				}
			}
			mapN(i_old, loads);
		} else {
			var loads = genNormTypedLoads(nullity, machType, nobj, offset);
			mapN(i_old, loads);
		}
	}
	def genClassSetField(i_old: SsaApplyOp, field: IrField, init: bool) {
		var inputs = normRefs(i_old.inputs);
		var fieldRef = V3Op.extractIrSpec(i_old.op, field), nobj = inputs[0];
		var offset = getClassFieldOffset(fieldRef);
		var machType = mach.machType(fieldRef.getFieldType());
		var nullity = compiler.nullity(i_old, nobj);
		genNormTypedStores(nullity, init, machType, nobj, offset, inputs, 1);
		i_old.kill();
		i_old.remove();
	}
	def genClassGetMethod(i_old: SsaApplyOp, method: IrMethod) -> SsaInstr {
		var methodRef = V3Op.extractIrSpec(i_old.op, method);
		var funcRep = mach.funcRep(methodRef);
		genNullCheck(i_old);
		return context.graph.valConst(funcRep.machType, getCodeAddress(methodRef));
	}
	def genClassGetSelector(i_old: SsaApplyOp, selector: IrSelector) -> SsaInstr {
		var methodRef = V3Op.extractIrSpec(i_old.op, selector);
		var funcRep = mach.funcRep(methodRef);
		var oobj = i_old.inputs[0], nobj = normRef1(oobj);
		return genMtableLookup(i_old, oobj, nobj, funcRep, methodRef);
	}
	def genVariantGetMethod(i_old: SsaApplyOp, method: IrMethod) -> SsaInstr {
		var methodRef = V3Op.extractIrSpec(i_old.op, method);
		var funcRep = mach.funcRep(methodRef);
		return context.graph.valConst(funcRep.machType, getCodeAddress(methodRef));
	}
	def genVariantGetSelector(i_old: SsaApplyOp, selector: IrSelector) -> SsaInstr {
		var methodRef = V3Op.extractIrSpec(i_old.op, selector);
		var funcRep = mach.funcRep(methodRef);
		var oobj = i_old.inputs[0], nobj = normRef1(oobj);
		return genMtableLookup(i_old, oobj, nobj, funcRep, methodRef); // XXX: refLoad can assume non-null for variants
	}
	def genMtableLookup(i_old: SsaApplyOp, oobj: SsaDfEdge, nobj: SsaInstr, funcRep: Mach_FuncRep, methodRef: IrSpec) -> SsaInstr {
		// use method-table based dispatch
		var nullity = context.compiler.nullity(i_old, oobj.dest);
		var tid: SsaInstr;
		if (hasDescriptorHeader(methodRef.receiver)) {
			// The type id lives in the descriptor, which is the object header.
			var i_desc = refLoad(nullity, mach.data.ptrType, i_old, oobj, nobj, 0);
			tid = ptrLoad(mach.tagType, i_desc, mach.runtime.descTidOffset);
		} else {
			tid = refLoad(nullity, mach.tagType, i_old, oobj, nobj, 0);
		}
		var mtbl = context.graph.valConst(mach.data.ptrType, makeMethodTable(methodRef));
		return ptrLoad(funcRep.machType, ptrAdd(mtbl, tid), 0);
	}
	def genComponentGetField(i_old: SsaApplyOp, field: IrField) {
		var fieldRef = V3Op.extractIrSpec(i_old.op, field);
		var fieldType = mach.machType(fieldRef.getFieldType());
		var ptr = componentFieldPtr(fieldRef);
		var loads = genNormTypedLoads(Fact.O_NO_NULL_CHECK, fieldType, ptr, 0);
		mapN(i_old, loads);
	}
	def genComponentSetField(i_old: SsaApplyOp, field: IrField) {
		var fieldRef = V3Op.extractIrSpec(i_old.op, field);
		var inputs = normRefs(i_old.inputs);
		var machType = mach.machType(fieldRef.getFieldType());
		var ptr = componentFieldPtr(fieldRef);
		genNormTypedStores(Fact.O_NO_NULL_CHECK, false, machType, ptr, 0, inputs, 1);
		i_old.kill();
		i_old.remove();
	}
	def genNullCheck(i_old: SsaApplyOp) -> SsaInstr {
		var oobj = i_old.inputs[0], nobj = normRef1(oobj);
		i_old.facts = Facts.NONE;
		var nullity = context.compiler.nullity(i_old, oobj.dest);
		if (!nullity.O_NO_NULL_CHECK) genNullCheck0(nobj);
		return nobj;
	}
	def genNullCheck0(nobj: SsaInstr) {
		if (SsaConst.?(nobj)) {
			var oval = SsaConst.!(nobj).val;
			if (oval == null) addThrow(V3Exception.NullCheck);
			return; // constant is non-null
		}
		nullCheckT(nobj);
	}
	def nullCheckT(p: SsaInstr) -> SsaInstr {
		if (!config.ImplicitNullChecks) explicitNullCheck(p.getType(), p);
		else if (!context.compiler.DisableNullChecks) apply(V3Op.newNullCheck(p.getType()), [p]); // may trap
		return context.graph.nop();
	}
	def genBoundsCheck(i_old: SsaApplyOp, nullity: Fact.set) -> (SsaInstr, Fact.set) {
		var oarr = i_old.inputs[0], narr = normRef1(oarr);
		if (context.compiler.DisableBoundsChecks || i_old.facts.O_NO_BOUNDS_CHECK) {
			if (!nullity.O_NO_NULL_CHECK) genNullCheck0(narr);
			return (context.graph.nullConst(Void.TYPE), nullity | Fact.O_NO_NULL_CHECK);
		}
		return genBoundsCheck0(i_old, nullity, narr);
	}
	def genBoundsCheck0(i_old: SsaApplyOp, nullity: Fact.set, narr: SsaInstr) -> (SsaInstr, Fact.set) {
		var oarr = i_old.inputs[0];
		// XXX: CSE the array length if possible
		var len = refLoad(nullity, Int.TYPE, i_old, oarr, narr, mach.getArrayLengthOffset(i_old.op.typeArgs[0]));
		if (ssa.end()) return (len, nullity | Fact.O_NO_NULL_CHECK); // the load threw, killing {i_old}
		var index = normRef1(i_old.inputs[1]);
		var throwOp = V3Op.newConditionalThrow(V3Exception.BoundsCheck);
		var op = Int.getType(false, 32).opLtEq();
		apply(throwOp, [apply(op, [len, index])]);
		return (index, nullity | Fact.O_NO_NULL_CHECK);
	}
	def genCallMethod(i_old: SsaApplyOp, method: IrMethod) {
		var methodRef = V3Op.extractIrSpec(i_old.op, method);
		var funcRep = mach.funcRep(methodRef);
		var func = context.graph.valConst(funcRep.machType, getCodeAddress(methodRef));
		var args = Arrays.prepend(func, normRefs(i_old.inputs));
		call(i_old, funcRep, args);
	}
	def genCallClassMethod(i_old: SsaApplyOp, method: IrMethod) {
		var methodRef = V3Op.extractIrSpec(i_old.op, method);
		if (!i_old.facts.O_NO_NULL_CHECK) genNullCheck(i_old);
		if (ssa.end()) return;
		var funcRep = mach.funcRep(methodRef);
		var func = context.graph.valConst(funcRep.machType, getCodeAddress(methodRef));
		var args = Arrays.prepend(func, normRefs(i_old.inputs));
		call(i_old, funcRep, args);
	}
	def genCallClassSelector(i_old: SsaApplyOp, selector: IrSelector) {
		var func = genClassGetSelector(i_old, selector);
		if (ssa.end()) return;
		var methodRef = V3Op.extractIrSpec(i_old.op, selector);
		var args = Arrays.prepend(func, normRefs(i_old.inputs));
		call(i_old, mach.funcRep(methodRef), args);
	}
	def genCallVariantSelector(i_old: SsaApplyOp, selector: IrSelector) {
		var func = genVariantGetSelector(i_old, selector);
		if (ssa.end()) return;
		var methodRef = V3Op.extractIrSpec(i_old.op, selector);
		var args = Arrays.prepend(func, normRefs(i_old.inputs));
		call(i_old, mach.funcRep(methodRef), args);
	}
	def genCallFunction(i_old: SsaApplyOp) {
		var funcRep = mach.getFuncRep(i_old.op.typeArgs[0]);
		call(i_old, funcRep, normRefs(i_old.inputs));
		return;
	}
	def genVariantGetRepTag(i_old: SsaApplyOp, nobj: SsaInstr) -> SsaInstr {
		var val = ptrLoad(mach.tagType, nobj, 0);
		var root = V3.getRootType(i_old.op.typeArgs[0]);
		var min = mach.runtime.classIdRange(root).0;
		if (min != 0) {
			val = apply(mach.tagType.opSub(), [val, context.graph.intConst(min)]);
		}
		var shift = mach.code.addressSizeLog2;
		if (shift > 0) {
			val = apply(mach.tagType.opShr(), [val, context.graph.intConst(shift)]);
		}
		// TODO: perform source tag lookup via table
		var conv = V3Op.newIntViewI(mach.tagType, i_old.op.sig.returnType());
		return apply(conv, [val]);
	}
	def genPtrAtRef(i_old: SsaApplyOp) {
		var i_array = normRef1(i_old.inputs[0]), arrayType = V3.arrayByteType;
		var i_index = normRef1(i_old.inputs[1]);
		var hsize = mach.getArrayElemOffset(arrayType, 0), scale = 1;
		var i_offset = genArrayElemOffset(hsize, scale, i_index);
		var i_new = ptrAddAs(i_old.op.sig.returnType(), i_array, i_offset);
		map1(i_old, i_new);
	}
	def genPtrAtRefLayoutField(i_old: SsaApplyOp, offset1: int) {
		var i_array = normRef1(i_old.inputs[0]), arrayType = V3.arrayByteType;
		var i_index = normRef1(i_old.inputs[1]);
		var hsize = mach.getArrayElemOffset(arrayType, 0), scale = 1;
		var i_offset2 = genArrayElemOffset(hsize, scale, i_index);
		var i_offset = ssa.opIntAdd(i_offset2, context.graph.intConst(offset1));
		var i_new = ptrAddAs(i_old.op.sig.returnType(), i_array, i_offset);
		map1(i_old, i_new);
	}

	def explicitNullCheck(t: Type, nobj: SsaInstr) -> SsaInstr {
		if (context.compiler.DisableNullChecks) return nobj;
		var check = apply(V3Op.newRefEq(t), [nobj, context.graph.nullConst(t)]);
		apply(V3Op.newConditionalThrow(V3Exception.NullCheck), [check]);
		return nobj;
	}
	def storeObjectTag(nobj: SsaInstr, t: Type) {
		if (hasDescriptorHeader(t)) {
			var addr = mach.emptyDescriptorAddr(t);
			ptrStore(mach.data.ptrType, nobj, 0, context.graph.valConst(mach.data.ptrType, addr));
			return;
		}
		var tag = context.graph.intConst(mach.runtime.getObjectTag(t));
		ptrStore(mach.tagType, nobj, 0, tag);
	}
	def hasDescriptorHeader(t: Type) -> bool {
		var ic = context.prog.ir.getIrClass(t);
		return ic != null && ic.flags.C_HAS_DESCRIPTOR;
	}
	def loadTypeId(nobj: SsaInstr, t: Type) -> SsaInstr {
		if (!hasDescriptorHeader(t)) return ptrLoad(mach.tagType, nobj, 0);
		var i_desc = ptrLoad(mach.data.ptrType, nobj, 0);
		return ptrLoad(mach.tagType, i_desc, mach.runtime.descTidOffset);
	}
	def genIfNull(i_old: SsaApplyOp, resultType: Type, nobj: SsaInstr, nullVal: Val, gen: SsaInstr -> SsaInstr) -> SsaInstr {
		if (nobj.facts.V_ZERO) {
			return context.graph.valConst(resultType, nullVal);
		} else if (V3Op.needsNullCheck(i_old, nobj)) {
			var t = addIfNull(nobj);
			var tblock = t.0, fblock = t.1, merge = t.2;
			ssa = fblock;
			var nonNull = gen(nobj);
			fblock.addGoto(merge.block);
			tblock.addGoto(merge.block);
			ssa = merge;
			return ssa.addPhi(resultType, [nonNull, context.graph.valConst(resultType, nullVal)]);
		} else {
			return gen(nobj);
		}
	}

	def call(i_old: SsaApplyOp, funcRep: Mach_FuncRep, args: Array<SsaInstr>) {
		if (ssa.end()) return;
		var i_new = apply(V3Op.newCallAddress(funcRep), args);
		i_new.facts = i_new.facts | i_old.facts;
		var tn = normType(i_old.op.sig.returnType());
		mapMultiReturn(i_old, i_new, tn);
	}
	def apply(op: Operator, args: Array<SsaInstr>) -> SsaInstr {
		return ssa.addApply(ssa.source, op, args);
	}
	def ptrAdd(base: SsaInstr, offset: SsaInstr) -> SsaInstr {
		var pt = base.getType(), pd = pt;
		if (SsaConst.?(offset)) {
			var offsetVal = SsaConst.!(offset).val;
			// XXX: fold address calculation in optimizer, not here
			if (base.optag() == Opcode.PtrAdd.tag) {
				// match PtrAdd(PtrAdd(left, right), #offset)
				var left = base.inputs[0].dest, right = base.inputs[1].dest;
				if (SsaConst.?(left)) {
					// PtrAdd(PtrAdd(#left, right), #offset)
					var leftVal = SsaConst.!(left).val;
					match (SsaConst.!(left).val) {
						null => return ptrAdd(right, offset);
						x: Addr => left = context.graph.valConst(pd, x.add(V3.unboxI32(offsetVal)));
						_ => left = context.graph.valConst(pd, Int.box(V3.unboxI32(leftVal) + V3.unboxI32(offsetVal)));

					}
					return ptrAdd(left, right);
				}
				if (SsaConst.?(right)) {
					// PtrAdd(PtrAdd(left, #right), #offset)
					var rightVal = SsaConst.!(right).val;
					offset = context.graph.valConst(pd, Int.box(V3.unboxI32(rightVal) + V3.unboxI32(offsetVal)));
					base = left;
				}
			} else if (SsaConst.?(base)) {
				match (SsaConst.!(base).val) {
					null => if (Addr.?(offsetVal)) return offset;
					x: Addr => {
						// fold PtrAdd(#addr, #offset)
						var addr = context.graph.valConst(pd, x.add(V3.unboxI32(offsetVal)));
						addr.facts |= Fact.V_NON_ZERO;
						return addr;
					}
					_ => base = context.graph.valConst(pd, SsaConst.!(base).val);
				}
			}
		}
		return apply(newPtrAdd(pt), [base, offset]);
	}
	def ptrAddAs(rt: Type, base: SsaInstr, offset: SsaInstr) -> SsaInstr {
		if (!SsaConst.?(base) && mach.isRefType(base.getType())) return apply(newPtrAdd(rt), [base, offset]);
		return ptrAdd(base, offset);
	}
	def newPtrAdd(pt: Type) -> Operator { // XXX: cache Pointer add operator
		var it = Int.getType(true, mach.data.addressWidth);
		return V3Op.newPtrAdd(pt, it);
	}
	def ptrLoad(vt: Type, p: SsaInstr, offset: int) -> SsaInstr {
		if (offset != 0) p = ptrAdd(p, context.graph.intConst(offset));
		var i = apply(V3Op.newPtrLoad(p.getType(), vt), [p]);
		i.facts |= Fact.O_NO_NULL_CHECK; // this load won't trap
		return i;
	}
	def ptrLoadT(t: Type, p: SsaInstr, offset: int) -> SsaInstr {
		if (mach.sizeOf(t) == 0) return nullCheckT(p);
		if (!config.ImplicitNullChecks) explicitNullCheck(p.getType(), p);
		if (offset != 0) p = ptrAdd(p, context.graph.intConst(offset));
		return apply(V3Op.newPtrLoad(p.getType(), t), [p]); // this load may trap
	}
	def ptrStore(vt: Type, p: SsaInstr, offset: int, v: SsaInstr) -> SsaInstr {
		var i = ptrStoreCommon(vt, p, offset, v);
		i.facts |= Fact.O_NO_NULL_CHECK; // this store won't trap
		return i;
	}
	def ptrStoreT(vt: Type, p: SsaInstr, offset: int, v: SsaInstr) -> SsaInstr {
		if (mach.sizeOf(vt) == 0) return nullCheckT(p);
		if (!config.ImplicitNullChecks) explicitNullCheck(p.getType(), p);
		return ptrStoreCommon(vt, p, offset, v);
	}
	def ptrStoreCommon(vt: Type, p: SsaInstr, offset: int, v: SsaInstr) -> SsaInstr {
		if (offset != 0) p = ptrAdd(p, context.graph.intConst(offset));
		if (config.StoreNarrow && vt.typeCon.kind == Kind.INT) {
			v = eliminateStoreNarrow(IntType.!(vt), v);
		}
		var i = apply(V3Op.newPtrStore(p.getType(), vt), [p, v]);
		return i;
	}
	def eliminateStoreNarrow(tt: IntType, v: SsaInstr) -> SsaInstr {
		if (!SsaApplyOp.?(v)) return v;
		var apply = SsaApplyOp.!(v);
		if (apply.op.opcode != Opcode.IntViewI) return v;
		var ft = IntType.!(apply.op.typeArgs[0]);
		if (ft.width <= tt.width) return v;
		if (IntType.!(apply.op.typeArgs[1]).width < tt.width) return v;
		if (tt.width == 8 && config.Int8StoreNarrow) return getInputAndMaybeDead(apply);
		if (tt.width == 16 && config.Int16StoreNarrow) return getInputAndMaybeDead(apply);
		if (tt.width == 32 && config.Int32StoreNarrow) return getInputAndMaybeDead(apply);
		return v;
	}
	def getInputAndMaybeDead(v: SsaApplyOp) -> SsaInstr {
		var i = v.input0();
		maybeDeadCodeLater(v);
		return i;
	}
	def refLoad(nullity: Fact.set, vt: Type, i_old: SsaApplyOp, oobj: SsaDfEdge, nobj: SsaInstr, offset: int) -> SsaInstr {
		return if(nullity.O_NO_NULL_CHECK, ptrLoad(vt, nobj, offset), ptrLoadT(vt, nobj, offset));
	}
	def componentFieldPtr(f: IrSpec) -> SsaInstr {
		return context.graph.valConst(mach.data.ptrType, getComponentFieldPtr(f));
	}
	def addIfNull(x: SsaInstr) -> (SsaBuilder, SsaBuilder, SsaBuilder) {
		var tb = newBlock(), fb = newBlock();
		var merge = ssa.split();
		ssa.addIfNull(x, tb.block, fb.block);
		return (tb, fb, merge);
	}
	def newBlock() -> SsaBuilder {
		var b = SsaBuilder.new(context, context.graph, SsaBlock.new());
		b.source = ssa.source;
		return b;
	}
	def genNormTypedLoads(nullity: Fact.set, machType: Type, base: SsaInstr, offset: int) -> Array<SsaInstr> {
		var tn = normIntType(machType);
		if (tn == null) {
			var result = if(!nullity.O_NO_NULL_CHECK, ptrLoadT(machType, base, offset), ptrLoad(machType, base, offset));
			return [result];
		}
		var loads = Array<SsaInstr>.new(tn.size);
		var check = if(nullity.O_NO_NULL_CHECK, -1);
		for (i < loads.length) {
			var et = tn.sub[i];
			loads[i] = if(i == check, ptrLoadT(et, base, offset), ptrLoad(et, base, offset));
			offset = offset + mach.sizeOf(et);
		}
		return loads;
	}
	def genNormTypedStores(nullity: Fact.set, init: bool, machType: Type, base: SsaInstr, offset: int, vals: Array<SsaInstr>, start: int) {
		var tn = normIntType(machType), nullCheck = !nullity.O_NO_NULL_CHECK;
		if (tn == null) {
			var val = vals[start];
			if (nullCheck) ptrStoreT(machType, base, offset, val);
			else if (isNonTrivialStore(init, val)) ptrStore(machType, base, offset, val);
			return;
		}
		var check = if(nullCheck, 0, -1);
		for (i < tn.size) {
			var et = tn.sub[i], val = vals[start + i];
			if (i == check) ptrStoreT(et, base, offset, val);
			else if (isNonTrivialStore(init, val)) ptrStore(et, base, offset, val);
			offset = offset + mach.sizeOf(et);
		}
	}
	def isNonTrivialStore(init: bool, v: SsaInstr) -> bool {
		if (init) {
			if (SsaConst.?(v)) return !Values.identical(SsaConst.!(v).val, null);
		}
		return true;
	}
	def maybeDeadCodeLater(i: SsaInstr) {
		// XXX: this is a cheap way of dead code elimination
		maybeDead = List.new(i, maybeDead);
	}
	def addThrow(exception: string) -> SsaInstr {
		if (ssa.end()) return null;
		ssa.addThrow(ssa.source, exception);
		return context.graph.nop();
	}

	def genAllocMethod(size: IntType) -> IrMethod {
		if (mach.allocMethod != null) return mach.allocMethod;
		var receiverType = MachModule.getAnyRefType(), returnType = MachModule.getAnyRefType(), ptr = mach.data.ptrType;
		var vst = VstMethod.new(false, Token.new(null, ".alloc", 0, 0), null,
			VstFunc.new(null, ReturnType.Explicit(TypeUtil.typeRefOf(returnType)), null));
		var p_receiver = SsaParam.new(0, receiverType);
		var p_size = SsaParam.new(1, size);
		var graph = SsaGraph.new([p_receiver, p_size], returnType);
		var ssa = SsaBuilder.new(context, graph, graph.startBlock);

		if (CLOptions.RT_TEST_GC.get()) {
			// Always call RiRuntime.gc()
			var i_collect = genCallRiGc(ssa, p_size);
			ssa.addReturn([i_collect]);
		} else {
			// Allocation using CiRuntime.{heapCurLoc, heapEndLoc}
			var k_heapCur = graph.valConst(ptr, CiRuntimeModule.HEAP_CUR_LOC);
			var k_heapEnd = graph.valConst(ptr, CiRuntimeModule.HEAP_END_LOC);
			var i_cur = ssa.add(V3Op.newPtrLoad(ptr, ptr), [k_heapCur], Fact.O_NO_NULL_CHECK);
			var i_next = ssa.add(V3Op.newPtrAdd(ptr, size), [i_cur, p_size], Fact.O_PURE);

			if (!CLOptions.RT_GC.get()) {
				// runtime support for GC is turned off; no need to test against end. TODO: ugly
				ssa.add(V3Op.newPtrStore(ptr, ptr), [k_heapCur, i_next], Fact.O_NO_NULL_CHECK);
				ssa.addReturn([i_cur]);
			} else {
				var i_end = ssa.add(V3Op.newPtrLoad(ptr, ptr), [k_heapEnd], Fact.O_NO_NULL_CHECK);
				var i_lt = ssa.add(V3Op.newPtrLteq(ptr), [i_next, i_end], Fact.O_PURE);
				var split = SsaBlockSplit.new(context, ssa);
				ssa = split.addIf(i_lt);
				ssa.add(V3Op.newPtrStore(ptr, ptr), [k_heapCur, i_next], Fact.O_NO_NULL_CHECK);
				ssa.addReturn([i_cur]);
				ssa = split.addElse();
				var i_collect = genCallRiGc(ssa, p_size);
				if (i_collect != null) ssa.addReturn([i_collect]);
				else ssa.addThrow(null, V3Exception.HeapOverflow);
				split.finish();
			}
		}

		var meth = IrMethod.new(receiverType, null, Function.sig(size, returnType));
		meth.ssa = graph;
		context.prog.ir.methods.put(meth);
		mach.allocStub = mach.addrOfMethod(meth); // is implemented by IR
		return mach.allocMethod = meth;
	}
	def genCallRiGc(ssa: SsaBuilder, p_size: SsaInstr) -> SsaInstr {
		var rt_collect = mach.runtime.getRiGc();
		if (rt_collect == null) return null;
		// XXX: tail call RiRuntime.gc()
		var i_caller_ip = ssa.add(V3Op.newCallerIp(mach.code.ptrType), Ssa.NO_INSTRS, Fact.O_PURE);
		var i_caller_sp = ssa.add(V3Op.newCallerSp(mach.data.ptrType), Ssa.NO_INSTRS, Fact.O_PURE);
		var op = V3Op.newCallMethod(IrSpec.new(rt_collect.receiver, [rt_collect.receiver], rt_collect));
		def machReceiverType = mach.machType(MachModule.getAnyRefType());
		return ssa.add(op, [context.graph.nullConst(machReceiverType), p_size, i_caller_ip, i_caller_sp], Facts.NONE);
	}
	// Utility methods to shorten access to MachProgram
	def getCodeAddress(methodRef: IrSpec) -> Val {
		return mach.addrOfMethod(methodRef.asMethod());
	}
	def getComponentFieldPtr(f: IrSpec) -> Val {
		return mach.fieldMap[f.asField()];
	}
	def getClassFieldOffset(f: IrSpec) -> int {
		return f.asField().machOffset;
	}
	def makeMethodTable(spec: IrSpec) -> Addr {
		var mtable = IrSelector.!(spec.member).mtable;
		if (mtable == null) {
			context.fail1("mtable is null for %q", spec.render);
			return null;
		}
		var mtaddr = mach.mtableMap[mtable];
		if (mtaddr == null) { // allocate space in method region for mtable
			var size = mtable.table.length * mach.code.addressSize;
			mtaddr = mach.metaRegion.allocate(mtable, size);
			// return a pointer to a table indexed starting from 0, potentially with tag
			mtaddr = mach.runtime.mtableStartAddr(mtable, mtaddr);
			mach.mtableMap[mtable] = mtaddr;
		}
		return mtaddr;
	}
}

component MachLowerings {

	def decomposeByteArrayAccess(mach: MachProgram, config: MachLoweringConfig, fieldType: Type, offset: int, fieldOrder: ByteOrder, memoryOrder: ByteOrder, bytesOnly: bool) -> (TypeNorm, Array<Access>) {
		var machType = mach.machType(fieldType);

		if (fieldOrder == memoryOrder && !bytesOnly) {
			// Common case: byte order match.
			if (!IntType.?(machType)) return (null, [Access.Simple(fieldType, offset)]); // non-integer type

			var tn = mach.intNorm.makeType(IntType.!(machType)), sub = tn.sub;
			var accesses = Array<Access>.new(sub.length);
			// Generate full-word loads for all but the last word; TODO: little/big endian normalization
			var loads = Array<SsaInstr>.new(tn.size), last = sub.length - 1;
			for (i < last) {
				var et = sub[i];
				accesses[i] = Access.Simple(et, offset); // XXX: should not need recursive decomposition
				offset = offset + mach.packedSizeOf(et);
			}

			var et = IntType.!(sub[last]);
			if (et.width >= 8 && (et.width & et.width - 1) == 0) {
				// common case; last load is a power of two and at least a full byte
				accesses[last] = Access.Simple(et, offset);
			} else {
				// generate multiple power-of-2 accesses
				var vec = Vector<AccessDatum>.new();
				var wordType = config.getMinimumArithSize(et.width);
				var etWidth = et.packedByteSize * 8, bitPos = 0;
				for (curWidth = mach.intNorm.width; curWidth >= 8; curWidth >>= 1) {
					if ((etWidth & curWidth) != 0) {
						var curType = Int.getType(false, curWidth);
						vec.put(AccessDatum(curType, offset + (bitPos >> 3), byte.!(bitPos)));
						bitPos += curWidth;
					}
				}
				accesses[last] = Access.Compound(et, wordType, vec.extract());
			}
			return (null, accesses);
		} else {
			// Byte order mismatch. Generate individual byte loads and assemble scalars.
			var size = mach.packedSizeOf(machType), width = size * 8;
			var intType = Int.getType(false, width);
			var tn = mach.intNorm.makeType(intType), sub = tn.sub;
			var accesses = Array<Access>.new(sub.length);
			if (sub == null && false) {
				var compound = compoundAccess(mach, fieldType, fieldOrder, offset);
				accesses[0] = compound;
			} else if (fieldOrder == ByteOrder.BIG_ENDIAN) {
				for (i = sub.length - 1; i >= 0; i--) {
					var compound = compoundAccess(mach, sub[i], fieldOrder, offset);
					accesses[i] = compound;
					offset += compound.wordType.packedByteSize;
				}
			} else {
				for (i < sub.length) {
					var compound = compoundAccess(mach, sub[i], fieldOrder, offset);
					accesses[i] = compound;
					offset += compound.wordType.packedByteSize;
				}
			}
			return (tn, accesses);
		}
	}

	def compoundAccess(mach: MachProgram, et: Type, fieldOrder: ByteOrder, offset: int) -> Access.Compound {
		var size = mach.packedSizeOf(et), width = size * 8;
		var bytes = Array<AccessDatum>.new(size);
		var wordType = Int.getType(false, width);
		for (j < size) {
			var shift = if(fieldOrder == ByteOrder.LITTLE_ENDIAN, j * 8, width - 8 - j * 8);
			bytes[j] = AccessDatum(Byte.TYPE, j + offset, byte.!(shift));
		}
		return Access.Compound(et, wordType, bytes);
	}
}

type Access {
	case Simple(t: Type, offset: int) {
		def render(sb: StringBuilder) -> StringBuilder {
			return sb.put2("Simple(type %q, offset %d)", t.render, offset);
		}
	}
	case Compound(t: Type, wordType: IntType, datums: Array<AccessDatum>) {
		def render(sb: StringBuilder) -> StringBuilder {
			sb.put2("Compound(type %q, wordType %q, datums [", t.render, wordType.render);
			for (i < datums.length) {
				sb.put2("%s%q", if(i == 0, "", " "), datums[i].render);
			}
			return sb.puts("])");
		}
	}
	def render(sb: StringBuilder) -> StringBuilder;
}
type AccessDatum(t: Type, offset: int, shift: byte) {
	def render(sb: StringBuilder) -> StringBuilder {
		return sb.put3("(type %q, offset: %d, shift %d)", t.render, offset, shift);
	}
}
