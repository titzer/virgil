	def visitClassAlloc(opcode: Opcode.ClassAlloc, ct: ClassType)						{ genClassAlloc(app, null); }
	def visitClassAllocWithDescriptor(opcode: Opcode.ClassAllocWithDescriptor, ct: ClassType) {
		var classType = app.getType();
		mach.allocates = true;
		var i_desc = normRef1(app.inputs[0]);
		var i_size = ptrLoad(mach.tagType, i_desc, mach.runtime.descSizeOffset);
		var nobj = genAlloc(mach.machType(classType), i_size);
		var ic = context.prog.ir.getIrClass(classType);
		if (ic != null && ic.flags.C_IS_DESCRIPTOR) initDescriptorSlots(nobj, ClassType.!(classType));
		return map1(app, nobj);
	}
	def visitClassNew(opcode: Opcode.ClassNew, ct: ClassType)			{ genClassAlloc(app, opcode.method); }
	def visitClassGetField(opcode: Opcode.ClassGetField, ct: ClassType)		{ genClassGetField(false, app, opcode.field); }
	def visitClassInitField(opcode: Opcode.ClassInitField, ct: ClassType)		{ genClassSetField(app, opcode.field, true); }
	def visitClassSetField(opcode: Opcode.ClassSetField, ct: ClassType)		{ genClassSetField(app, opcode.field, false); }
