	def visitVariantGetSelector(opcode: Opcode.VariantGetSelector, spec: IrSpec)	{ mapOrId(app, genVariantGetSelector(app, opcode.selector)); }
	def visitNullCheck(opcode: Opcode.NullCheck, t: Type)				{ mapOrId(app, genNullCheck(app)); }
	def visitBoundsCheck(opcode: Opcode.BoundsCheck, t: Type)			{ mapOrId(app, genBoundsCheck(app, Facts.NONE).0); }
	def visitDescriptorCheck(opcode: Opcode.DescriptorCheck, dt: ClassType)		{ mapOrId(app, genDescriptorCheck(app)); }
	def visitTypeCast(opcode: Opcode.TypeCast, ft: Type, tt: Type) {
		var i_new: SsaInstr;
		match (opcode.cast) {
			TRUE, SUBSUME => i_new = normRef1(app.inputs[0]);
			CLASS_CAST => i_new = if(context.compiler.DisableTypeChecks, normRef1(app.inputs[0]), genClassCast(app, ft, tt));
			VARIANT_CAST => i_new = if(context.compiler.DisableTypeChecks, normRef1(app.inputs[0]), genVariantCast(app, ft, tt));
			THROW => i_new = addThrow(V3Exception.TypeCheck);
			INT_VIEW_I => return genIntViewI(app);
			_ => {
				// other kinds of casts should have been removed
				context.fail1("unexpected cast %s", opcode.cast.name);
				i_new = context.graph.nop();
			}
		}
		return map1(app, i_new);
	}
