	def visitSetDescriptorExtension(opcode: Opcode.SetDescriptorExtension, dt: Type) {
		var i_desc = normRef1(app.inputs[0]);
		var i_refmap = normRef1(app.inputs[1]);
		var i_size = normRef1(app.inputs[2]);
		genNullCheck0(i_desc);
		// Brand the descriptor with the given reference map and object size.
		ptrStore(mach.tagType, i_desc, mach.runtime.descRefmapOffset, i_refmap);
		ptrStore(mach.tagType, i_desc, mach.runtime.descSizeOffset, i_size);
		app.kill();
		app.remove();
	}
