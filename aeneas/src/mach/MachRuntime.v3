def CODE_DATA_ALLOWANCE = 512L * 1024 * 1024;
// Represents all runtime data structures exposed to the Virgil runtime code.
class MachRuntime(mach: MachProgram) {
	def codeRegion = mach.codeRegion;
	def addrs = Array<long>.new(CiRuntimeModule.max); // CiRuntime absolute addresses
	var typeCon: CiRuntime_TypeCon;

	// Indexes in the IrModule's roots vector
	var ri_init = -1;
	var ri_gc = -1;
	var ri_signal = -1;
	var ri_exit = -1;

	var src: MachRtSrcTables;
	var gc: MachRtGcTables;

	var heapSize = long.view(CLOptions.HEAP_SIZE.get());
	var shadowStackSize: long;

	// Object header tag encoding (low 2 bits). Depends on whether descriptors are enabled.
	var simpleObjectTag: u3	= 0b00;
	var primArrayTag: u3	= 0b01;
	var mixedArrayTag: u3	= 0b10;
	var refArrayTag: u3	= 0b11;
	var descriptors: bool;

	// Byte offsets of the reserved metadata slots inside a descriptor object. They follow a
	// reference-sized header, which is either a tag or, if the descriptor is itself described,
	// a descriptor pointer, so that the slots are always at the same offsets.
	// TODO: Use CiRuntime constant or intrinsic to reduce hardcoding in RiGc (rt/gc/RiGc.v3).
	def descTidOffset = mach.refSize;
	def descRefmapOffset = mach.refSize + 4;
	def descSizeOffset = mach.refSize + 8;

	new() {
		if (CLOptions.RT_STTABLES.get()) src = MachRtSrcTables.new(mach, this);
		if (CLOptions.RT_GCTABLES.get()) gc = MachRtGcTables.new(mach, this);
		MachModule.installPtr(mach); // installs "Pointer" typecon
		MachModule.installMachAnyRef(mach); // installs the mach AnyRef typecon
		def anyRefTC = AnyRef_TypeCon.!(mach.prog.typeEnv.lookup(MachModule.anyref));
		typeCon = CiRuntime_TypeCon.new(MachModule.getPtrType(mach.prog), AnyRefType.!(anyRefTC.singleton) , mach.prog.typeCache);
		typeCon.mixedArrays = CLOptions.MA.get(); // TODO: get mixed array config from compiler
		typeCon.taggedRefs = CLOptions.TR.get();
		typeCon.descriptors = descriptors = CLOptions.DESCRIPTORS.get();
			if (descriptors) {
				// Shift the array tags up to make room for the descriptor-pointer tag (00).
				simpleObjectTag = 0b01;
				primArrayTag = 0b10;
				mixedArrayTag = 0b11;
				refArrayTag = 0b11; // reference arrays use the mixed-array encoding
			}
		shadowStackSize = long.view(CLOptions.SHADOW_STACK_SIZE.get());
		if (shadowStackSize == 0) {
			var percent = CLOptions.SHADOW_STACK_PERCENT.get();
			if (percent > 100) percent = 100;
			if (percent > 0) shadowStackSize = (heapSize / 100) * percent;
		}
		checkSizes();
	}

	// Conservative upper bound on the highest virtual address used by the program image.
	def estimateMaxVmAddr(vaddr_start: long) -> long {
		var sum = vaddr_start;
		sum += long.view(CLOptions.STACK_SIZE.get());
		sum += long.view(CLOptions.RESERVED_CODE_SIZE.get());
		sum += long.view(CLOptions.RUNTIME_CODE_SIZE.get());
		sum += heapSize;
		sum += shadowStackSize;
		sum += CODE_DATA_ALLOWANCE;
		return sum;
	}
	def addressesFitInU32(vaddr_start: long) -> bool {
		var max = estimateMaxVmAddr(vaddr_start);
		return max > 0 && max < 0x8000_0000L;
	}
	// Report compile-time error if needed or requested section sizes cannot fit in the address width.
	def checkSizes() {
		var width = mach.data.addressWidth;
		var max = if(width >= 64, long.max, (1L << byte.!(width - 1)) - 1);
		if (heapSize < 0 || heapSize > max) {
			return sizeError("heap-size", heapSize, max);
		}
		if (shadowStackSize < 0 || shadowStackSize > max) {
			return sizeError("shadow-stack-size", shadowStackSize, max);
		}
		var total = heapSize + shadowStackSize;
		if (total < 0 || total > max) {
			return sizeError("heap-size + shadow-stack-size", total, max);
		}
		var stackSize = long.view(CLOptions.STACK_SIZE.get());
		if (stackSize < 0 || stackSize > max) {
			return sizeError("stack-size", stackSize, max);
		}
	}
	private def sizeError(what: string, size: long, max: long) {
		var msg = if(size < 0,
			Strings.format1("%s is far too large", what),
			Strings.format3("%s of %d bytes exceeds the maximum of %d bytes for this target",
				what, size, max));
		mach.prog.ERROR.addError(null, null, "Configuration error", msg);
	}
	def recordStackStart(addr: long) {
		setAddr(CiRuntimeModule.STACK_START, addr);
	}
	def recordStackEnd(addr: long) {
		setAddr(CiRuntimeModule.STACK_END, addr);
	}
	def recordCodeStart(addr: long) {
		setAddr(CiRuntimeModule.CODE_START, addr);
	}
	def recordReservedCode(startAddr: long, size: long, fileOffset: int) {
		setAddr(CiRuntimeModule.RESERVED_CODE_START, startAddr);
		setAddr(CiRuntimeModule.RESERVED_CODE_END, startAddr + size);
		setAddr(CiRuntimeModule.RESERVED_CODE_FILE_OFFSET, fileOffset);
	}
	def recordRuntimeCode(startAddr: long, size: long) {
		setAddr(CiRuntimeModule.RUNTIME_CODE_START, startAddr);
		setAddr(CiRuntimeModule.RUNTIME_CODE_END, startAddr + size);
	}
	def recordCodeEnd(addr: long) {
		setAddr(CiRuntimeModule.CODE_END, addr);
	}
	def recordDataStart(addr: long) {
		setAddr(CiRuntimeModule.DATA_START, addr);
	}
	def recordDataEnd(addr: long) {
		setAddr(CiRuntimeModule.DATA_END, addr);
	}
	def setAddr(c: CiRuntime_Address, addr: long) {
		if (CLOptions.PRINT_BIN.get()) Terminal.put2("CiRuntime.%s=%x\n", c.name, addr);
		addrs[c.index] = addr;
	}
	def getAddr(c: CiRuntime_Address) -> long {
		return addrs[c.index];
	}
	def bindAddr(c: CiRuntime_Address, w: DataWriter) -> long {
		var addr = w.addr_end();
		setAddr(c, addr);
		return addr;
	}
	def getExceptionDest(off: int, ex: string, source: Source) -> Addr {
		if (src != null) return src.newExceptionDest(ex, source);
		return getFatalAddress(ex);
	}
	def addHeapPointers(w: MachDataWriter) {
		def C: CiRuntimeModule;
		w.atEnd().align(mach.data.addressSize);

		addPtr(w, C.HEAP_CUR_LOC);
		addPtr(w, C.HEAP_END_LOC);
		var addr = w.addr_end();
		if (shadowStackSize > 0) {
			addPtr(w, C.SHADOW_STACK_START_PTR);
			addPtr(w, C.SHADOW_STACK_CUR_PTR);
			addPtr(w, C.SHADOW_STACK_END_PTR);
			addr = w.addr_end();
			setAddr(C.SHADOW_STACK_START, addr);
			setPtr(w, C.SHADOW_STACK_START_PTR, addr);
			setPtr(w, C.SHADOW_STACK_CUR_PTR, addr);
			setPtr(w, C.SHADOW_STACK_END_PTR, addr += shadowStackSize);
			setAddr(C.SHADOW_STACK_END, addr);
		}
		setAddr(C.HEAP_START, addr);
		setPtr(w, C.HEAP_CUR_LOC, addr);
		setPtr(w, C.HEAP_END_LOC, addr += heapSize);
		setAddr(C.HEAP_END, addr);
		w.atEnd();
	}
	def addPtr(w: MachDataWriter, ptr: CiRuntime_Address) {
		bindAddr(ptr, w);
		w.skipN(mach.data.addressSize);
	}
	def setPtr(w: MachDataWriter, ptr: CiRuntime_Address, addr: long) {
		var abs = addrs[ptr.index];
		if (CLOptions.PRINT_BIN.get()) {
			Terminal.put3("CiRuntime.%s @ %x = %x\n", ptr.name, abs, addr);
		}
		w.at(int.!(u64.view(abs) - w.startAddr)); // TODO(addr64)
		match (mach.data.addressSize) {
			1 => w.putb(u8.!(addr));
			2 => w.put_b16(u16.!(addr));
			4 => w.put_b32(int.!(addr));
			8 => w.put_b64(addr);
			_ => { return V3.fail("invalid data address size"); }
		}
	}
	def codePages() -> long { // TODO(addr64) int is probably sufficient
		var end = getAddr(CiRuntimeModule.CODE_END);
		if (end == 0) mach.prog.ERROR.fail("code end not set yet");
		var size = end - getAddr(CiRuntimeModule.CODE_START);
		return (size + ((1L << RTT_PAGE_SHIFT) - 1)) >> RTT_PAGE_SHIFT;
	}
	def encode(w: MachDataWriter) {
		if (gc != null) gc.encode(w);
		if (src != null) src.encode(w);
	}
	def getFatalAddress(ex: string) -> Addr {
		var addr = mach.stubMap[ex].0;
		if (addr == null) {
			addr = Address.new(codeRegion, Arrays.concat("fatal_", ex));
			mach.stubMap[ex] = (addr, null);
		}
		return addr;
	}
	def parseTestInputs(prog: Program, error: ErrorGen, expected: int) -> Array<Array<Val>> {
		var e = SpecParser.parseFile(error, prog.files[0], prog.inputs[0]);
		heapSize = e.heapSize;
		var runs = Lists.toArray(e.runs);
		var result = Array<Array<Val>>.new(runs.length);
		for (i < runs.length) {
			result[i] = Lists.toArray(runs[i].input);
		}
		return result;
	}
	def addRoots() {
		var typeCon = mach.prog.typeEnv.lookup("RiRuntime");
		if (V3Component_TypeCon.?(typeCon)) {
			// some RiRuntime methods are called by compiled code
			var ctype = V3Component_TypeCon.!(typeCon).componentDecl.getDeclaredType();
			var ic = mach.prog.ir.getIrClass(ctype);
			for (meth in ic.methods) {
				if (meth == null) continue;
				var name = meth.source.name();
				if (CLOptions.RT_GC.get() && Strings.equal(name, "gc")) ri_gc = addRoot(ctype, meth);
				else if (Strings.equal(name, "init")) ri_init = addRoot(ctype, meth);
				else if (Strings.equal(name, "signal")) ri_signal = addRoot(ctype, meth);
				else if (Strings.equal(name, "exit")) ri_exit = addRoot(ctype, meth);
			}
		}
	}
	def getRiGc() -> IrMethod {
		return getRoot(ri_gc);
	}
	def getRiInit() -> IrMethod {
		return getRoot(ri_init);
	}
	def getRiSignal() -> IrMethod {
		return getRoot(ri_signal);
	}
	def getRiExit() -> IrMethod {
		return getRoot(ri_exit);
	}
	def getObjectTag(t: Type) -> int {
		match (t) {
			x: ClassType => return getSimpleObjectTag(x);
			x: ArrayType => return mach.arrayRep(t).typeTag;
			_ => mach.prog.ERROR.unexpectedType(t, null);
		}
		return 0;
	}
	// Returns the range of header tags of a class and its subclasses, in the same tagged
	// encoding as {getSimpleObjectTag}, so that ranges can be compared against a loaded header.
	def classIdRange(t: Type) -> (int, int) {
		var r = mach.prog.ir.getIrClass(t);
		if (r == null) return (0, 0);
		var size = mach.code.addressSize;
		return (r.minClassId * size | simpleObjectTag, r.maxClassId * size | simpleObjectTag);
	}
	def mtableStartAddr(mtable: IrMtable, mtaddr: Addr) -> Addr {
		// The loaded header includes the simple object tag, which is subtracted out here.
		return mtaddr.add(0 - mtable.rootId * mach.code.addressSize - simpleObjectTag);
	}
	def getSimpleObjectTag(t: ClassType) -> int {
		var ic = mach.prog.ir.getIrClass(t);
		if (ic == null) return 0; // completely dead class
		return (ic.minClassId * mach.code.addressSize) | simpleObjectTag;
	}
	def getPrimArrayTag(t: ArrayType, elemscale: int) -> int {
		return (elemscale << 2) | primArrayTag;
	}
	def getMixedArrayTag(t: ArrayType, refmap: int) -> int {
		return (refmap << 2) | mixedArrayTag;
	}
	def getRefArrayTag(t: ArrayType) -> int {
		if (descriptors) return getMixedArrayTag(t, 0b11); // one ref word: bit0=ref, bit1=length
		return refArrayTag;
	}
	private def getRoot(index: int) -> IrMethod {
		return if(index >= 0, mach.prog.ir.roots[index].spec.asMethod());
	}
	private def addRoot(ctype: Type, meth: IrMethod) -> int {
		return mach.prog.ir.addRoot(null, IrSpec.new(ctype, [ctype], meth));
	}
}
// Encoding sizes for tables.
def RTT_PAGE_SHIFT: u5 = 12;
def RTT_PAGE_MASK = (1 << RTT_PAGE_SHIFT) - 1;
// A utility to encode sorted, page-indexed tables such as for stackmaps and sourcepoints.
class MachRtPageTable(
		pageTable: CiRuntime_Address,
		table: CiRuntime_Address,
		end: CiRuntime_Address,
		wide: bool) { // 8-byte entries

	def entries = Vector<(int, int, int)>.new();

	def encode(rt: MachRuntime, w: MachDataWriter) {
		var pageTableAddr = rt.bindAddr(pageTable, w);
		var maxPage = int.!(rt.codePages()), maxEntry = entries.length;
		var tableSize = 4 * (maxPage + 1);
		rt.setAddr(table, pageTableAddr + tableSize);
		// encode the page table offsets
		var lastPage = -1;
		for (i < maxEntry) {
			var page = entries[i].0 >> RTT_PAGE_SHIFT;
			if (page != lastPage) {
				// first entry on new page, fill intervening pages
				var entryOffset = tableSize + i * 4;
				for (j = lastPage; j < page; j++) w.put_b32(entryOffset);
				lastPage = page;
			}
		}
		// encode the last entries of the table
		for (j = lastPage; j < maxPage; j++) w.put_b32(tableSize + maxEntry * 4);
		// encode the table entries
		for (i < maxEntry) {
			var entry = entries[i];
			if (CLOptions.PRINT_STACKMAP.val) {
				var page = entry.0 >> RTT_PAGE_SHIFT;
				var offset = entry.0 & RTT_PAGE_MASK;
				Terminal.put3(" entry page=%d, offset=%d, val=%x(<< shift)\n", page, offset, entry.1);
			}
			w.put_b32((entry.0 & RTT_PAGE_MASK) | (entry.1 << RTT_PAGE_SHIFT));
		}
		if (!wide) return;
		// encode the wide part of the table
		if (end != null) rt.bindAddr(end, w);
		for (i < maxEntry) {
			w.put_b32(entries[i].2);
		}
	}
	def add(offset: int, e0: int, e1: int) {
		entries.put(offset, e0, e1);
	}
	def grow(len: int) -> this {
		entries.grow(len);
	}
}
