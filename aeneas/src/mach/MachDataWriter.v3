enum PatchKind {
	REL_32,
	RELA_32,
	ABS_32,
	ABS_64,
	ABS_SLEB32,
	ARM64_REL_IMM19,
	ARM64_ABS_IMM16,
	ARM64_REL_IMM26,
	ARM64_REL_ADR21,
	RISCV_ABS_HI20_LO12,	// lui at pos + I-type at pos+4: absolute 32-bit address
	RISCV_PCREL_HI20_LO12,	// auipc at pos + I-type at pos+4: pc-relative 32-bit offset
	RISCV_JAL,		// jal at pos: 21-bit pc-relative offset
	RISCV_BRANCH		// conditional branch at pos: 13-bit pc-relative offset
}

// A specialized DataWriter with machine-level properties, such as a start address
// and the ability to encode an address that is tracked for later patching.
class MachDataWriter extends DataWriter {
	def pageAlign: Alignment;
	var startPos: int; // start position from which offset() is calculated
	private var patches: List<(PatchKind, Addr, /*posAddr:*/long, /*pos:*/int)>;

	new(pageAlign, startAddr: long, initialSize: int) {
		this.startAddr = u64.!(startAddr);
		grow(initialSize);
	}

	def recordPatch(kind: PatchKind, addr: Addr, pos: int) {
		patches = List.new((kind, addr, addr_of(pos), pos), patches);
	}
	def patch(mach: MachProgram) {
		patchWithCallback(mach, null);
	}
	def patchWithCallback(mach: MachProgram, callback: (PatchKind, Addr, long, int) -> void) {
		for (l = patches; l != null; l = l.tail) {
			var t = l.head, kind = t.0, addr = t.1, posAddr = t.2, pos = t.3;
			if (CLOptions.PRINT_PATCH.val) {
				TerminalBuffer.new()
					.puts("patch-code @0x")
					.putx(posAddr)
					.puts(" <- ")
					.putcv(addr, null)
					.outt();
			}
			var absAddr = mach.absolute(addr);
			if (CLOptions.PRINT_PATCH.val) {
				TerminalBuffer.new()
					.puts(" = 0x")
					.putx(absAddr)
					.outln();
			}
			at(pos);
			match (t.0) {
				REL_32 => {
					put_b32(int.!(absAddr - posAddr));
				}
				RELA_32 => {
					var delta = i8.view(data[pos + 1]);
					put_b32(int.!(absAddr - (posAddr + delta)));
				}
				ABS_32 => {
					put_b32(int.!(absAddr));
				}
				ABS_64 => {
					put_b64(absAddr);
				}
				ABS_SLEB32 => {
					overwrite_sleb32(int.!(absAddr));
				}
				ARM64_REL_IMM19 => {
					var offset = int.!((absAddr - posAddr) / 4);
					var old = int.view(data[pos]) | (int.view(data[pos + 1]) << 8) |
					          (int.view(data[pos + 2]) << 16) | (int.view(data[pos + 3]) << 24);
					put_b32((old & 0xFF00001F) | ((offset & 0x7FFFF) << 5));
				}
				ARM64_REL_IMM26 => {
					var offset = int.!((absAddr - posAddr) / 4);
					var old = int.view(data[pos]) | (int.view(data[pos + 1]) << 8) |
					          (int.view(data[pos + 2]) << 16) | (int.view(data[pos + 3]) << 24);
					put_b32((old & 0xFC000000) | (offset & 0x03FFFFFF));
				}
				ARM64_ABS_IMM16 => {
					var imm = int.!(absAddr);
					var old = int.view(data[pos]) | (int.view(data[pos + 1]) << 8) |
					          (int.view(data[pos + 2]) << 16) | (int.view(data[pos + 3]) << 24);
					put_b32((old & 0xFFE0001F) | ((imm & 0xFFFF) << 5));
				}
				ARM64_REL_ADR21 => {
					// ADR takes an unscaled byte offset, split into immlo/immhi
					var offset = int.!(absAddr - posAddr);
					var old = int.view(data[pos]) | (int.view(data[pos + 1]) << 8) |
					          (int.view(data[pos + 2]) << 16) | (int.view(data[pos + 3]) << 24);
					put_b32((old & 0x9F00001F) | ((offset & 0x3) << 29) | (((offset >> 2) & 0x7FFFF) << 5));
				}
				RISCV_ABS_HI20_LO12 => patchRiscvHiLo(pos, int.!(absAddr));
				RISCV_PCREL_HI20_LO12 => patchRiscvHiLo(pos, int.!(absAddr - posAddr));
				RISCV_JAL => {
					var v = int.!(absAddr - posAddr);
					var enc = (((v >> 20) & 1) << 31) | (((v >> 1) & 0x3FF) << 21) | (((v >> 11) & 1) << 20) | (((v >> 12) & 0xFF) << 12);
					put_b32((get_b32(pos) & 0x00000FFF) | enc);
				}
				RISCV_BRANCH => {
					var v = int.!(absAddr - posAddr);
					var enc = (((v >> 12) & 1) << 31) | (((v >> 5) & 0x3F) << 25) | (((v >> 1) & 0xF) << 8) | (((v >> 11) & 1) << 7);
					put_b32((get_b32(pos) & 0x01FFF07F) | enc);
				}
			}
			if (callback != null && absAddr < 0) callback(kind, addr, posAddr, pos);
		}
	}
	// Read the 32-bit little-endian word at {pos}.
	private def get_b32(pos: int) -> int {
		return int.view(data[pos]) | (int.view(data[pos + 1]) << 8) |
			(int.view(data[pos + 2]) << 16) | (int.view(data[pos + 3]) << 24);
	}
	// Patch a RISC-V lui/auipc at {pos} and the I-type instruction at {pos + 4} so that
	// together they add the signed 32-bit {v} to their base. The low 12 bits are
	// sign-extended by the second instruction, so the upper 20 bits compensate.
	private def patchRiscvHiLo(pos: int, v: int) {
		var hi = ((v + 0x800) >> 12) & 0xFFFFF, lo = v & 0xFFF;
		at(pos);
		put_b32((get_b32(pos) & 0x00000FFF) | (hi << 12));
		put_b32((get_b32(pos + 4) & 0x000FFFFF) | (lo << 20));
	}
	def abs4(addr: Addr, encoding: int) {
		recordPatch(PatchKind.ABS_32, addr, pos);
		put_b32(encoding);
	}
	def skipPage() {
		skipAddr(pageAlign.size);
	}
	def endPageAddr() -> long {
		return pageAlign.alignDown_i64(addr_end());
	}
	def putmd(w: MachDataWriter) {
		var p = this.pos;
		putr(w.alias());
		for (l = w.patches; l != null; l = l.tail) {
			var t = l.head;
			patches = List.new((t.0, t.1, t.2 + p, t.3 + p), patches);
		}
		w.patches = null;
	}
	def offset() -> int {
		return pos - startPos;
	}
	def endOffset() -> int {
		return end() - startPos;
	}
	def bind(addr: Addr) {
		if (addr.absolute >= -1)
			addr.absolute = this.addr();
	}
	def bindSize(addr: Addr) {
		addr.size = this.addr() - addr.absolute;
	}
}
