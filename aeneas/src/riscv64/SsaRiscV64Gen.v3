// RiscV64 machine instructions are ints that look like <arg2><arg1><am><code>
// where each part of the instruction is a byte. For integer operations, {arg2}
// is the width: 0 = 32-bit ("W" forms), 1 = 64-bit.

// masks
def MASK_CODE = 0xff;
def MASK_AM = 0xff00;
def MASK_ARG1 = 0xff0000;
def MASK_ARG2 = 0xff000000;

// shifts
def SHIFT_CODE: byte = 0;
def SHIFT_AM: byte = 8;
def SHIFT_ARG1: byte = 16;
def SHIFT_ARG2: byte = 24;

// codes
def I_ADD: byte = 0x01;
def I_SUB: byte = 0x02;
def I_MUL: byte = 0x03;
def I_AND: byte = 0x04;
def I_OR: byte = 0x05;
def I_XOR: byte = 0x06;
def I_SLL: byte = 0x07;
def I_SRA: byte = 0x08;
def I_SRL: byte = 0x09;
def I_NEG: byte = 0x0A;
def I_DIV: byte = 0x0B;
def I_DIVU: byte = 0x0C;
def I_REM: byte = 0x0D;
def I_REMU: byte = 0x0E;
def I_BNOT: byte = 0x0F;	// BoolNot: xori rd, rs, 1
def I_CMP: byte = 0x10;		// comparison producing a bool; condition index in arg1
def I_LI: byte = 0x11;		// load constant into GPR
def I_MOV: byte = 0x12;		// move GPR<->GPR or stack<->GPR (always 64 bits)
def I_LB: byte = 0x20;		// signed byte load
def I_LH: byte = 0x21;		// signed halfword load
def I_LW: byte = 0x22;		// 32-bit load, sign-extended
def I_LD: byte = 0x23;		// 64-bit load
def I_LBU: byte = 0x24;		// unsigned byte load
def I_LHU: byte = 0x25;		// unsigned halfword load
def I_FLW: byte = 0x26;		// single-precision float load
def I_FLD: byte = 0x27;		// double-precision float load
def I_SB: byte = 0x28;		// byte store
def I_SH: byte = 0x29;		// halfword store
def I_SW: byte = 0x2A;		// 32-bit store
def I_SD: byte = 0x2B;		// 64-bit store
def I_FSW: byte = 0x2C;		// single-precision float store
def I_FSD: byte = 0x2D;		// double-precision float store
def I_NULLCHK: byte = 0x2E;	// lb zero, imm(base): touch memory to trigger a null check
def I_J: byte = 0x40;		// unconditional jump (jal zero)
def I_BEQZ: byte = 0x41;	// branch if zero
def I_BNEZ: byte = 0x42;	// branch if nonzero
def I_UNIMP: byte = 0x43;	// undefined instruction
def I_SWITCH: byte = 0x44;	// switch via jump table
def I_CALL: byte = 0x45;	// direct call (auipc + jalr)
def I_CALLR: byte = 0x46;	// indirect call (jalr reg)
def I_ALLOC: byte = 0x90;	// inline bump-pointer allocation
def I_THROW: byte = 0xA0;	// unconditional throw (jump to fatal stub)
def I_THROWC: byte = 0xA1;	// conditional throw (if reg != 0)
def I_THROWZ: byte = 0xA2;	// throw if zero (if reg == 0)
def I_INTVIEWI: byte = 0xB0;	// integer width conversion; subop in arg1
def I_INTTRUNCF: byte = 0xC0;	// float-to-integer truncation, dst GPR, src FP
def I_FLOATROUNDI: byte = 0xC1;	// integer-to-float conversion, dst FP, src GPR
def I_FLOATVIEWI: byte = 0xC2;	// fmv integer bits into an FP register
def I_INTVIEWF: byte = 0xC3;	// fmv float bits into a GPR
def I_FLOATCMP: byte = 0xC4;	// float comparison producing a bool
def I_FLOATBINOP: byte = 0xC5;	// float binary operation (fadd/fsub/fmul/fdiv)
def I_FLOATUNARY: byte = 0xC6;	// float unary operation (fsqrt/fabs/ceil/floor/round)
def I_FLOATCONV: byte = 0xC7;	// float-to-float conversion (fcvt single<->double)
def I_FLOATBITEQ: byte = 0xC8;	// bitwise float equality
def I_FMOV: byte = 0xC9;	// move FP<->FP or stack<->FP (always 64 bits)
def I_FCONST: byte = 0xCA;	// materialize a float constant into an FP register
def I_KILLREGS: byte = 0xD0;	// pseudo-instruction: zero all allocatable registers
def I_CALLERIP: byte = 0xD1;	// load return address (saved ra) into GPR
def I_CALLERSP: byte = 0xD2;	// compute caller's stack pointer into GPR
def I_CMPSWP: byte = 0xD3;	// compare-and-swap via lr/sc loop
def I_RETTO: byte = 0xD4;	// return-to: set sp and return to caller's caller
def I_SYSCALL: byte = 0xD5;	// syscall (ecall)

// addressing modes
def AM_NONE: byte = 0x00;
def AM_R_R_I: byte = 0x01;	// dst=GPR, src=GPR, immediate
def AM_R: byte = 0x04;		// first operand is a register
def AM_R_OP: byte = 0x05;	// dst=GPR, src=GPR or stack
def AM_OP_R: byte = 0x06;	// dst=GPR or stack, src=GPR
def AM_R_R_R: byte = 0x07;	// dst=GPR, src1=GPR, src2=GPR
def AM_R_R: byte = 0x08;	// dst=GPR, src=GPR
def AM_SWITCH: byte = 0x09;	// switch: [key, label_0, ..., label_n, label_default]
def AM_BASE_IMM12: byte = 0x0A;	// memory: imm12(base)
def AM_V_V_V: byte = 0x0B;	// dst=FP, src1=FP, src2=FP
def AM_V_V: byte = 0x0C;	// dst=FP, src=FP
def AM_R_V_V: byte = 0x0D;	// dst=GPR, src1=FP, src2=FP
def AM_R_V: byte = 0x0E;	// dst=GPR, src=FP
def AM_V_R: byte = 0x0F;	// dst=FP, src=GPR
def AM_V_OP: byte = 0x10;	// dst=FP, src=FP or stack
def AM_OP_V: byte = 0x11;	// dst=FP or stack, src=FP
def AM_V_IMM: byte = 0x12;	// dst=FP, src=immediate
def AM_CMPSWP: byte = 0x13;	// dst=GPR, ptr, expected, new, size

def ARG_NONE: byte = 0x00;
def W32: byte = 0;
def W64: byte = 1;

// IntViewI sub-operations (arg1); the immediate operand is the shift amount.
def IV_MOV: byte = 0;
def IV_SEXT32: byte = 1;	// sign-extend the low 32 bits
def IV_ZEXT32: byte = 2;	// zero-extend the low 32 bits
def IV_ZEXT: byte = 3;		// zero-extend the low (64 - imm) bits
def IV_SEXT: byte = 4;		// sign-extend the low (64 - imm) bits

// Float comparison conditions (arg1).
def FC_EQ: byte = 0;
def FC_LT: byte = 1;
def FC_LE: byte = 2;
def FC_NE: byte = 3;

def makeOpcode(code: byte, am: byte, arg1: byte, arg2: byte) -> int {
	return (int.view(code) << SHIFT_CODE) | (int.view(am) << SHIFT_AM)
		 | (int.view(arg1) << SHIFT_ARG1) | (int.view(arg2) << SHIFT_ARG2);
}
def getCode(opcode: int) -> byte {
	return byte.view((opcode & MASK_CODE) >> SHIFT_CODE);
}
def getAM(opcode: int) -> byte {
	return byte.view((opcode & MASK_AM) >> SHIFT_AM);
}
def getArg1(opcode: int) -> byte {
	return byte.view((opcode & MASK_ARG1) >> SHIFT_ARG1);
}
def getArg2(opcode: int) -> byte {
	return byte.view((opcode & MASK_ARG2) >> SHIFT_ARG2);
}

def MRegs: RiscV64RegSet;
def Regs: RiscV64Regs;
def Conds: RiscV64Conds;
def DYN = RiscV64Rm.DYN;

// Code generation for the riscv64 backend.
class SsaRiscV64Gen extends SsaMachGen {
	def asm: RiscV64Assembler;
	def m = SsaInstrMatcher.new();
	def dwarf: Dwarf; // TODO: riscv64 does not emit DWARF debug information yet
	// Jump tables and the 64-bit address pool, both emitted after the method body.
	var jumpTableAuipcPos = Vector<int>.new();
	var jumpTableCases = Vector<Array<Label>>.new();
	var poolSlots = Vector<Addr>.new();
	var poolTargets = Vector<Addr>.new();

	new(context: SsaContext, mach: MachProgram, asm, w: MachDataWriter, dwarf) super(context, mach, RiscV64RegSet.SET, w) {}

	// Overidden Architecture Specific Routines
	def visitApply(block: SsaBlock, i: SsaApplyOp) {
		match (i.op.opcode) {
			IntAdd => emitIntAddSub(i, false);
			IntSub => emitIntAddSub(i, true);
			IntMul => emitRegBinop(I_MUL, i);
			IntDiv => emitIntDivMod(i, false);
			IntMod => emitIntDivMod(i, true);
			IntAnd => emitImmBinop(I_AND, i);
			IntOr  => emitImmBinop(I_OR, i);
			IntXor => emitImmBinop(I_XOR, i);
			IntShl => emitShift(I_SLL, i);
			IntSar => emitShift(I_SRA, i);
			IntShr => emitShift(I_SRL, i);
			BoolAnd => emitBoolBinop(I_AND, i);
			BoolOr  => emitBoolBinop(I_OR, i);
			IntEq  => emitIntCmp(Conds.EQ, i);
			BoolEq => emitIntCmp(Conds.EQ, i);
			IntLt  => emitIntCmp(if(V3.isSigned(i.op.typeArgs[0]), Conds.LT, Conds.LTU), i);
			IntLteq => emitIntCmp(if(V3.isSigned(i.op.typeArgs[0]), Conds.LE, Conds.LEU), i);
			BoolNot => emitBoolNot(i);
			RefEq  => emitIntCmp(Conds.EQ, i);
			PtrAdd => emitPtrBinop(I_ADD, i);
			PtrSub => emitPtrBinop(I_SUB, i);
			PtrLt => emitIntCmp(Conds.LTU, i);
			PtrLteq => emitIntCmp(Conds.LEU, i);
			PtrCmpSwp => emitPtrCmpSwp(i);
			PtrLoad => emitPtrLoad(i);
			PtrStore => emitPtrStore(i);
			Alloc => emitAlloc(i);
			CallAddress(funcRep) => emitCall(i, funcRep);
			TupleGetElem => ; // handled by call's dfnFixed return values
			ConditionalThrow(exception) => emitConditionalThrow(exception, i);
			IntViewI => emitIntViewI(i);
			IntViewB => emitMov(i);
			IntTruncF(is64) => emitIntTruncF(i, is64);
			IntCastF(is64) => emitIntTruncF(i, is64);
			FloatRoundI(is64) => emitFloatRoundI(i, is64);
			FloatPromoteI(is64) => emitFloatRoundI(i, is64);
			FloatViewI(is64) => emitFloatViewI(i, is64);
			IntViewF(is64) => emitIntViewF(i, is64);
			FloatEq(is64) => emitFloatCmp(i, is64, FC_EQ);
			FloatLt(is64) => emitFloatCmp(i, is64, FC_LT);
			FloatLteq(is64) => emitFloatCmp(i, is64, FC_LE);
			FloatNe(is64) => emitFloatCmp(i, is64, FC_NE);
			FloatBitEq(is64) => emitFloatBitEq(i, is64);
			FloatAdd(is64) => emitFloatBinop(i, is64, 0);
			FloatSub(is64) => emitFloatBinop(i, is64, 1);
			FloatMul(is64) => emitFloatBinop(i, is64, 2);
			FloatDiv(is64) => emitFloatBinop(i, is64, 3);
			FloatSqrt(is64) => emitFloatUnaryOp(i, is64, 0);
			FloatAbs(is64) => emitFloatUnaryOp(i, is64, 1);
			FloatCeil(is64) => emitFloatUnaryOp(i, is64, 2);
			FloatFloor(is64) => emitFloatUnaryOp(i, is64, 3);
			FloatRound(is64) => emitFloatUnaryOp(i, is64, 4);
			FloatPromoteF => emitFloatConvert(i, true);
			FloatRoundD => emitFloatConvert(i, false);
			KillRegisters => {
				kill(MRegs.ALL);
				refmap(null);
				emitN(makeOpcode(I_KILLREGS, AM_NONE, ARG_NONE, ARG_NONE));
			}
			ForceGc => {
				if (mach.gcStub == null) return; // no runtime GC; nop
				kill(MRegs.ALL);
				kill(MRegs.SCRATCH);
				refmap(null);
				useExSource(null, i.source);
				useImm(mach.gcStub);
				emitN(makeOpcode(I_CALL, AM_NONE, ARG_NONE, ARG_NONE));
			}
			CallerIp => {
				emit1(makeOpcode(I_CALLERIP, AM_R, ARG_NONE, ARG_NONE), dfnReg(i));
			}
			CallerSp => {
				emit1(makeOpcode(I_CALLERSP, AM_R, ARG_NONE, ARG_NONE), dfnReg(i));
			}
			ReturnTo => emitReturnTo(i);
			CallKernel(kernel) => emitCallKernel(i, kernel);
			_ => return context.fail1("unexpected opcode %s", i.op.opcode.name);
		}
	}

	def visitThrow(block: SsaBlock, i: SsaThrow) {
		useExSource(i.exception, i.source);
		emitN(makeOpcode(I_THROW, AM_NONE, ARG_NONE, ARG_NONE));
	}
	def visitIf(block: SsaBlock, i: SsaIf) {
		var key = i.input0();
		var succ = i.block().succ;
		var s0 = succ(0).dest;  // true block
		var s1 = succ(1).dest;  // false block
		if (blocks.isImmediatelyAfter(context.block, s1)) {
			emit2(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_BNEZ, AM_R, ARG_NONE, ARG_NONE),
				useReg(key), useLabel(s0));
		} else if (blocks.isImmediatelyAfter(context.block, s0)) {
			emit2(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_BEQZ, AM_R, ARG_NONE, ARG_NONE),
				useReg(key), useLabel(s1));
		} else {
			emit2(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_BNEZ, AM_R, ARG_NONE, ARG_NONE),
				useReg(key), useLabel(s0));
			emit1(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_J, AM_NONE, ARG_NONE, ARG_NONE),
				useLabel(s1));
		}
	}
	def visitSwitch(block: SsaBlock, i: SsaSwitch) {
		useReg(i.input0());
		for (s in block.succs()) useLabel(s.dest);
		emitN(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_SWITCH, AM_SWITCH, ARG_NONE, ARG_NONE));
	}
	def visitGoto(block: SsaBlock, i: SsaGoto) {
		var target = i.target();
		if (!blocks.isImmediatelyAfter(context.block, target)) {
			emit1(makeOpcode(I_J, AM_NONE, ARG_NONE, ARG_NONE), useLabel(target));
		}
	}

	// Regalloc callbacks to add moves
	def genMoveLocLoc(src: Operand.Use, dst: Operand.Def, regClass: RegClass) {
		var isFloat = regClass == RegClass.F32 || regClass == RegClass.F64;
		if (isFloat) return genMoveLocLocFloat(src, dst, regClass);
		if (regSet.isStack(dst.constraint)) {
			if (regSet.isStack(src.constraint)) {
				var scratch = Operand.Def(null, MRegs.SCRATCH_GPR);
				emit2(makeOpcode(I_MOV, AM_R_OP, ARG_NONE, ARG_NONE), op(scratch), op(src));
				emit2(makeOpcode(I_MOV, AM_OP_R, ARG_NONE, ARG_NONE), op(dst), op(Operand.Use(null, MRegs.SCRATCH_GPR)));
			} else {
				emit2(makeOpcode(I_MOV, AM_OP_R, ARG_NONE, ARG_NONE), op(dst), op(src));
			}
		} else {
			emit2(makeOpcode(I_MOV, AM_R_OP, ARG_NONE, ARG_NONE), op(dst), op(src));
		}
	}
	def genMoveLocLocFloat(src: Operand.Use, dst: Operand.Def, regClass: RegClass) {
		if (regSet.isStack(dst.constraint)) {
			if (regSet.isStack(src.constraint)) {
				var tmp = MRegs.FLOAT_CONST_GPR;
				emit2(makeOpcode(I_MOV, AM_R_OP, ARG_NONE, ARG_NONE), op(Operand.Def(null, tmp)), op(src));
				emit2(makeOpcode(I_MOV, AM_OP_R, ARG_NONE, ARG_NONE), op(dst), op(Operand.Use(null, tmp)));
			} else {
				emit2(makeOpcode(I_FMOV, AM_OP_V, ARG_NONE, ARG_NONE), op(dst), op(src));
			}
		} else {
			emit2(makeOpcode(I_FMOV, AM_V_OP, ARG_NONE, ARG_NONE), op(dst), op(src));
		}
	}
	def genMoveConstReg(val: SsaConst, dst: Operand.Def, regClass: RegClass) {
		match (regClass) {
			F32 => emit2(makeOpcode(I_FCONST, AM_V_IMM, W32, ARG_NONE), op(dst), op(Operand.Immediate(val.val)));
			F64 => emit2(makeOpcode(I_FCONST, AM_V_IMM, W64, ARG_NONE), op(dst), op(Operand.Immediate(val.val)));
			_ => emit2(makeOpcode(I_LI, AM_R, ARG_NONE, ARG_NONE), op(dst), op(Operand.Immediate(val.val)));
		}
	}
	def genMoveConstStack(val: SsaConst, dst: Operand.Def, regClass: RegClass) {
		match (regClass) {
			F32, F64 => {
				var tmp = MRegs.FLOAT_CONST_GPR;
				emit2(makeOpcode(I_LI, AM_R, ARG_NONE, ARG_NONE),
					op(Operand.Def(null, tmp)), op(Operand.Immediate(val.val)));
				emit2(makeOpcode(I_MOV, AM_OP_R, ARG_NONE, ARG_NONE),
					op(dst), op(Operand.Use(null, tmp)));
			}
			_ => {
				var scratch = MRegs.SCRATCH_GPR;
				genMoveConstReg(val, Operand.Def(null, scratch), regClass);
				genMoveLocLoc(Operand.Use(null, scratch), dst, regClass);
			}
		}
	}
	def emitCall(i: SsaApplyOp, funcRep: Mach_FuncRep) {
		var func = i.input0();
		var conv = frame.allocCallerSpace(RiscV64VirgilCallConv.getForFunc(mach, funcRep));
		var rv = getProjections(i);
		for (j < rv.length) {
			var r = rv[j];
			if (r == null) continue;
			dfnFixed(r, conv.calleeRet(j));
		}
		kill(MRegs.ALL);
		kill(MRegs.SCRATCH);
		refmap(conv);
		var inputs = i.inputs;
		var isDirect = false;
		var target: Addr;
		if (SsaConst.?(func)) {
			target = Addr.!(SsaConst.!(func).val);
			if (target != null) isDirect = true;
		}
		if (!isDirect) useFixed(func, MRegs.JALR_GPR);
		for (j = 1; j < inputs.length; j++) {
			useFixed(inputs[j].dest, conv.calleeParam(j - 1));
		}
		useExSource(null, i.source);
		if (isDirect) useImm(target); // immediate last, after all other operands
		emitN(makeOpcode(if(isDirect, I_CALL, I_CALLR), AM_NONE, ARG_NONE, ARG_NONE));
	}
	def assemble_call(a: Array<Operand>) {
		var last = a[a.length - 1];
		match (last) {
			Immediate(val) => emitCallAddr(Addr.!(val));
			_ => context.fail("I_CALL: expected Immediate as last operand");
		}
		recordCallRefMap(a);
		recordReturnSource(a);
	}
	def assemble_callr(a: Array<Operand>) {
		for (o in a) {
			match (o) {
				Use(vreg, assignment) => {
					asm.jalr(Regs.RA, loc_r(assignment), 0);
					break;
				}
				_ => ;
			}
		}
		recordCallRefMap(a);
		recordReturnSource(a);
	}
	// Record GC stack reference map at the return point of a call.
	def recordCallRefMap(a: Array<Operand>) {
		if (mach.runtime.gc == null) return;
		for (o in a) {
			match (o) {
				RefMap(livepoint, outgoing) => {
					if (livepoint >= 0) {
						var off = w.offset();
						var entry = buildStackMap(off, outgoing, livepoint);
						if (entry >= 0) mach.runtime.gc.recordStackRefMap(off, getSource(a), entry);
					}
					return;
				}
				_ => ;
			}
		}
	}
	// Extract the source from the operand array of a call.
	def getSource(a: Array<Operand>) -> Source {
		for (i = a.length - 1; i >= 0; i--) {
			match (a[i]) {
				ExSource(ex, src) => return src;
				_ => ;
			}
		}
		return null;
	}

	//=={ Direct emission helpers, also used by the backend's stubs }=====================
	// Load {addr} with auipc + addi; code and data are always within 2GB of each other, but
	// runtime addresses such as the heap end may not be, so those go through the pool.
	def emitLoadAddr(reg: RiscV64Gpr, addr: Addr) {
		if (CiRuntime_Address.?(addr)) return emitPoolLoad(reg, addr);
		asm.auipc(reg, 0);
		asm.addi(reg, reg, 0);
		w.recordPatch(PatchKind.RISCV_PCREL_HI20_LO12, addr, w.pos - 8);
	}
	def emitPoolLoad(reg: RiscV64Gpr, target: Addr) {
		var slot = Addr.new(mach.codeRegion, null, 0);
		poolSlots.put(slot);
		poolTargets.put(target);
		asm.auipc(reg, 0);
		asm.ld(reg, reg, 0);
		w.recordPatch(PatchKind.RISCV_PCREL_HI20_LO12, slot, w.pos - 8);
	}
	// Emit the pool entries; the preceding code must not fall through into them.
	def flushPool() {
		if (poolSlots.length == 0) return;
		w.align(8);
		for (i < poolSlots.length) {
			var slot = poolSlots[i], target = poolTargets[i];
			w.bind(slot);
			w.recordPatch(PatchKind.ABS_64, target, w.pos);
			w.put_b64(0);
		}
		poolSlots.resize(0);
		poolTargets.resize(0);
	}
	def emitCallAddr(addr: Addr) {
		asm.auipc(Regs.RA, 0);
		asm.jalr(Regs.RA, Regs.RA, 0);
		w.recordPatch(PatchKind.RISCV_PCREL_HI20_LO12, addr, w.pos - 8);
	}
	// Jump to {addr}, clobbering the scratch register.
	def emitJumpAddr(addr: Addr) {
		asm.auipc(Regs.T4, 0);
		asm.jalr(Regs.ZERO, Regs.T4, 0);
		w.recordPatch(PatchKind.RISCV_PCREL_HI20_LO12, addr, w.pos - 8);
	}
	// dst = src + imm, for any 32-bit {imm}.
	def emitAddImm(dst: RiscV64Gpr, src: RiscV64Gpr, imm: int) {
		if (asm.fitsI12(imm)) {
			if (imm != 0 || dst != src) asm.addi(dst, src, i12.view(imm));
		} else {
			asm.li32(Regs.T3, imm);
			asm.add(dst, src, Regs.T3);
		}
	}
	// Returns (base, offset) for the stack slot at {offset} from sp, via t3 if out of range.
	def slotAddr(offset: int) -> (RiscV64Gpr, i12) {
		if (asm.fitsI12(offset)) return (Regs.SP, i12.view(offset));
		asm.li32(Regs.T3, offset);
		asm.add(Regs.T3, Regs.SP, Regs.T3);
		return (Regs.T3, 0);
	}
	def emitLoadSlot(rd: RiscV64Gpr, offset: int) {
		var t = slotAddr(offset);
		asm.ld(rd, t.0, t.1);
	}
	def emitStoreSlot(rs: RiscV64Gpr, offset: int) {
		var t = slotAddr(offset);
		asm.sd(rs, t.0, t.1);
	}
	def emitFLoadSlot(rd: RiscV64Fpr, offset: int) {
		var t = slotAddr(offset);
		asm.fld(rd, t.0, t.1);
	}
	def emitFStoreSlot(rs: RiscV64Fpr, offset: int) {
		var t = slotAddr(offset);
		asm.fsd(rs, t.0, t.1);
	}
	// Compute byte offset from SP for a spill slot loc.
	def loc_sp_offset(loc: int) -> int {
		loc = frame.un64(loc);
		var wordSize = mach.data.addressSize;
		if (loc >= regSet.calleeStart) {
			return wordSize * (loc - regSet.calleeStart);
		} else if (loc >= regSet.callerStart) {
			return frame.size() + wordSize * (loc - regSet.callerStart);
		} else if (loc >= regSet.spillStart) {
			return wordSize * (loc - regSet.spillStart + frame.spillArgs);
		} else {
			context.fail1("invalid spill location %s", regSet.identify(loc));
			return 0;
		}
	}
	def assemble(opcode: int, a: Array<Operand>) {
		if (opcode < 0) {
			match (opcode) {
				ArchInstrs.ARCH_ENTRY => {
					var size = frame.size();
					emitAddImm(Regs.SP, Regs.SP, 0 - size);
					emitStoreSlot(Regs.RA, size - 8);
				}
				ArchInstrs.ARCH_BLOCK => {
					var label = toLabel(a[0]);
					label.pos = asm.pos();
					for (l = label.near_uses; l != null; l = l.tail) {
						var pos = l.head, off = label.pos - pos;
						checkJalRange(off);
						asm.patch_j_imm(pos, i21.view(off));
					}
					label.near_uses = null;
					return;
				}
				ArchInstrs.ARCH_RET => {
					var size = frame.size();
					emitLoadSlot(Regs.RA, size - 8);
					emitAddImm(Regs.SP, Regs.SP, size);
					asm.ret();
					return;
				}
				ArchInstrs.ARCH_BLOCK_END => return;
				ArchInstrs.ARCH_SOURCELINE => { // TODO: DWARF debug information
					var label = toLabel(a[0]);
					label.pos = asm.pos();
					return;
				}
				ArchInstrs.ARCH_NEWVAR => return;
				ArchInstrs.ARCH_DELETEVAR => return;
				ArchInstrs.ARCH_UPDATEVAR => return;
				ArchInstrs.ARCH_END => {
					flushJumpTables();
					flushPool();
					return;
				}
				ArchInstrs.ARCH_SAVE => {
					var u = Operand.Use.!(a[0]);
					var offset = loc_sp_offset(u.vreg.spill);
					match (u.vreg.regClass) {
						F32,
						F64 => emitFStoreSlot(loc_f(u.constraint), offset);
						_ => emitStoreSlot(loc_r(u.constraint), offset);
					}
					return;
				}
				ArchInstrs.ARCH_RESTORE => {
					var d = Operand.Def.!(a[0]);
					var offset = loc_sp_offset(d.vreg.spill);
					match (d.vreg.regClass) {
						F32,
						F64 => emitFLoadSlot(loc_f(d.constraint), offset);
						_ => emitLoadSlot(loc_r(d.constraint), offset);
					}
					return;
				}
				_ => return;
			}
			return;
		}

		recordExSource(a);
		def am = getAM(opcode);
		match (am) {
			AM_NONE => {
				match (getCode(opcode)) {
					I_J => assemble_jump(toLabel(a[0]));
					I_UNIMP => asm.unimp();
					I_CALL => assemble_call(a);
					I_CALLR => assemble_callr(a);
					I_THROW => {
						var exSource = toExSource(a[0]);
						emitJumpAddr(mach.runtime.getExceptionDest(asm.pos(), exSource.0, exSource.1));
					}
					I_KILLREGS => {
						for (loc in RiscV64RegSet.SET.regSets[RiscV64RegSet.ALL]) {
							var r = MRegs.toGpr(loc);
							if (r != null) { asm.mv(r, Regs.ZERO); continue; }
							var f = MRegs.toFpr(loc);
							if (f != null) asm.fmv_d_x(f, Regs.ZERO);
						}
					}
					I_RETTO => {
						// t4 = target sp - 8, which points at the saved return address
						asm.ld(Regs.RA, Regs.T4, 0);
						asm.addi(Regs.SP, Regs.T4, 8);
						asm.ret();
					}
					I_ALLOC => {
						// inline bump-pointer allocation; reg holds the size, then the result
						var reg = toGpr(a[1]);
						emitLoadAddr(Regs.T4, CiRuntimeModule.HEAP_CUR_LOC);
						asm.ld(Regs.T6, Regs.T4, 0);
						asm.add(reg, Regs.T6, reg);
						asm.sd(reg, Regs.T4, 0);
						asm.mv(reg, Regs.T6);
					}
					I_SYSCALL => asm.ecall();
					_ => invalidOpcode(opcode);
				}
			}
			AM_R => assemble_r(opcode, a);
			AM_R_R_I => assemble_r_r_i(toGpr(a[0]), toGpr(a[1]), toB32(toImm(a[2])), opcode);
			AM_R_OP => {
				def rd = toGpr(a[0]);
				def loc = toLoc(a[1]);
				def rs = MRegs.toGpr(loc);
				if (rs != null) { if (rd != rs) asm.mv(rd, rs); }
				else emitLoadSlot(rd, loc_sp_offset(loc));
			}
			AM_OP_R => {
				def loc = toLoc(a[0]);
				def rs = toGpr(a[1]);
				def rd = MRegs.toGpr(loc);
				if (rd != null) { if (rd != rs) asm.mv(rd, rs); }
				else emitStoreSlot(rs, loc_sp_offset(loc));
			}
			AM_R_R_R => assemble_r_r_r(toGpr(a[0]), toGpr(a[1]), toGpr(a[2]), opcode);
			AM_R_R   => assemble_r_r(toGpr(a[0]), toGpr(a[1]), opcode);
			AM_V_V_V => assemble_v_v_v(toFpr(a[0]), toFpr(a[1]), toFpr(a[2]), opcode);
			AM_V_V   => assemble_v_v(toFpr(a[0]), toFpr(a[1]), opcode);
			AM_R_V_V => assemble_r_v_v(toGpr(a[0]), toFpr(a[1]), toFpr(a[2]), opcode);
			AM_R_V   => assemble_r_v(toGpr(a[0]), toFpr(a[1]), opcode);
			AM_V_R   => assemble_v_r(toFpr(a[0]), toGpr(a[1]), opcode);
			AM_V_OP  => {
				def rd = toFpr(a[0]);
				def loc = toLoc(a[1]);
				def rs = MRegs.toFpr(loc);
				if (rs != null) { if (rd != rs) asm.fmv_d(rd, rs); }
				else emitFLoadSlot(rd, loc_sp_offset(loc));
			}
			AM_OP_V  => {
				def loc = toLoc(a[0]);
				def rs = toFpr(a[1]);
				def rd = MRegs.toFpr(loc);
				if (rd != null) { if (rd != rs) asm.fmv_d(rd, rs); }
				else emitFStoreSlot(rs, loc_sp_offset(loc));
			}
			AM_V_IMM => assemble_fconst(toFpr(a[0]), toImm(a[1]), getArg1(opcode) != 0);
			AM_SWITCH => assemble_switch(a, opcode);
			AM_BASE_IMM12 => assemble_base_imm12(a, opcode);
			AM_CMPSWP => assemble_cmpswp(toGpr(a[0]), toGpr(a[1]), toGpr(a[2]), toGpr(a[3]), toB32(toImm(a[4])));
			_ => return context.fail1("unknown addressing mode %d", am);
		}
	}
	def checkJalRange(off: int) {
		if (off < -1048576 || off > 1048574) context.fail1("jump offset %d exceeds jal range", off);
	}
	def assemble_jump(label: Label) {
		if (label.pos >= 0) {
			var off = label.pos - asm.pos();
			checkJalRange(off);
			asm.jal(Regs.ZERO, i21.view(off));
		} else {
			label.near_uses = List.new(asm.pos(), label.near_uses);
			asm.jal(Regs.ZERO, 0);
		}
	}
	// Backward branches in range use the 13-bit form; others skip over a jal.
	def assemble_branch_zero(reg: RiscV64Gpr, label: Label, eqz: bool) {
		if (label.pos >= 0) {
			var off = label.pos - asm.pos();
			if (off >= -4096 && off <= 4094) {
				if (eqz) asm.beqz(reg, i13.view(off));
				else asm.bnez(reg, i13.view(off));
				return;
			}
		}
		if (eqz) asm.bnez(reg, 8);
		else asm.beqz(reg, 8);
		assemble_jump(label);
	}
	def assemble_r(opcode: int, a: Array<Operand>) {
		var reg = toGpr(a[0]);
		match (getCode(opcode)) {
			I_LI => {
				match (toImm(a[1])) {
					null          => asm.mv(reg, Regs.ZERO);
					x: Box<int>   => asm.li32(reg, x.val);
					x: Box<long>  => asm.li(reg, x.val);
					x: Box<bool>  => asm.li32(reg, if(x.val, 1, 0));
					x: Addr       => emitLoadAddr(reg, x);
					x: Record     => emitLoadAddr(reg, mach.addrOfRecord(x));
					x: Float32Val => asm.li32(reg, int.view(x.bits));
					x: Float64Val => asm.li(reg, long.view(x.bits));
					_ => context.fail("I_LI: unhandled Val type");
				}
			}
			I_BEQZ => assemble_branch_zero(reg, toLabel(a[1]), true);
			I_BNEZ => assemble_branch_zero(reg, toLabel(a[1]), false);
			I_NULLCHK => asm.lb(Regs.ZERO, reg, 0);
			I_THROWC => {
				var exSource = toExSource(a[1]);
				var addr = mach.runtime.getExceptionDest(asm.pos(), exSource.0, exSource.1);
				asm.beqz(reg, 12);
				emitJumpAddr(addr);
			}
			I_THROWZ => {
				var exSource = toExSource(a[1]);
				var addr = mach.runtime.getExceptionDest(asm.pos(), exSource.0, exSource.1);
				asm.bnez(reg, 12);
				emitJumpAddr(addr);
			}
			I_CALLERIP => emitLoadSlot(reg, frame.size() - 8);
			I_CALLERSP => emitAddImm(reg, Regs.SP, frame.size());
			_ => invalidOpcode(opcode);
		}
	}
	def assemble_r_r_i(rd: RiscV64Gpr, rs: RiscV64Gpr, imm: int, opcode: int) {
		var is64 = getArg2(opcode) != 0;
		match (getCode(opcode)) {
			I_ADD => if (is64) asm.addi(rd, rs, i12.view(imm)); else asm.addiw(rd, rs, i12.view(imm));
			I_AND => asm.andi(rd, rs, i12.view(imm));
			I_OR  => asm.ori(rd, rs, i12.view(imm));
			I_XOR => asm.xori(rd, rs, i12.view(imm));
			I_SLL => if (is64) asm.slli(rd, rs, u6.view(imm)); else asm.slliw(rd, rs, u5.view(imm));
			I_SRL => if (is64) asm.srli(rd, rs, u6.view(imm)); else asm.srliw(rd, rs, u5.view(imm));
			I_SRA => if (is64) asm.srai(rd, rs, u6.view(imm)); else asm.sraiw(rd, rs, u5.view(imm));
			I_INTVIEWI => assemble_intviewi(rd, rs, imm, getArg1(opcode));
			_ => invalidOpcode(opcode);
		}
	}
	def assemble_intviewi(rd: RiscV64Gpr, rs: RiscV64Gpr, imm: int, subop: byte) {
		match (subop) {
			IV_MOV => if (rd != rs) asm.mv(rd, rs);
			IV_SEXT32 => asm.sext_w(rd, rs);
			IV_ZEXT32 => {
				asm.slli(rd, rs, 32);
				asm.srli(rd, rd, 32);
			}
			IV_ZEXT => {
				asm.slli(rd, rs, u6.view(imm));
				asm.srli(rd, rd, u6.view(imm));
			}
			IV_SEXT => {
				asm.slli(rd, rs, u6.view(imm));
				asm.srai(rd, rd, u6.view(imm));
			}
			_ => context.fail1("invalid IntViewI subop: %d", subop);
		}
	}
	def assemble_r_r_r(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr, opcode: int) {
		var is64 = getArg2(opcode) != 0;
		match (getCode(opcode)) {
			I_ADD  => if (is64) asm.add(rd, rs1, rs2); else asm.addw(rd, rs1, rs2);
			I_SUB  => if (is64) asm.sub(rd, rs1, rs2); else asm.subw(rd, rs1, rs2);
			I_MUL  => if (is64) asm.mul(rd, rs1, rs2); else asm.mulw(rd, rs1, rs2);
			I_AND  => asm.and(rd, rs1, rs2);
			I_OR   => asm.or(rd, rs1, rs2);
			I_XOR  => asm.xor(rd, rs1, rs2);
			I_SLL  => if (is64) asm.sll(rd, rs1, rs2); else asm.sllw(rd, rs1, rs2);
			I_SRA  => if (is64) asm.sra(rd, rs1, rs2); else asm.sraw(rd, rs1, rs2);
			I_SRL  => if (is64) asm.srl(rd, rs1, rs2); else asm.srlw(rd, rs1, rs2);
			I_DIV  => if (is64) asm.div(rd, rs1, rs2); else asm.divw(rd, rs1, rs2);
			I_DIVU => if (is64) asm.divu(rd, rs1, rs2); else asm.divuw(rd, rs1, rs2);
			I_REM  => if (is64) asm.rem(rd, rs1, rs2); else asm.remw(rd, rs1, rs2);
			I_REMU => if (is64) asm.remu(rd, rs1, rs2); else asm.remuw(rd, rs1, rs2);
			I_CMP  => assemble_cmp(rd, rs1, rs2, Conds.all[getArg1(opcode)]);
			_ => invalidOpcode(opcode);
		}
	}
	// rd = (rs1 cond rs2) as 0 or 1; narrower values are sign-extended, so 64-bit compares suffice.
	def assemble_cmp(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr, cond: RiscV64Cond) {
		if (cond == Conds.EQ || cond == Conds.NE) {
			asm.xor(rd, rs1, rs2);
			if (cond == Conds.EQ) asm.seqz(rd, rd);
			else asm.snez(rd, rd);
			return;
		}
		// the rest are slt/sltu, with swapped operands for >, >= and an inverted result for >=, <=
		var a = rs1, b = rs2;
		if (cond.swap) { a = rs2; b = rs1; }
		var unsigned = cond == Conds.LTU || cond == Conds.GEU || cond == Conds.GTU || cond == Conds.LEU;
		if (unsigned) asm.sltu(rd, a, b);
		else asm.slt(rd, a, b);
		if (cond == Conds.GE || cond == Conds.GEU || cond == Conds.LE || cond == Conds.LEU) asm.xori(rd, rd, 1);
	}
	def assemble_r_r(rd: RiscV64Gpr, rs: RiscV64Gpr, opcode: int) {
		var is64 = getArg2(opcode) != 0;
		match (getCode(opcode)) {
			I_NEG  => if (is64) asm.neg(rd, rs); else asm.negw(rd, rs);
			I_BNOT => asm.xori(rd, rs, 1);
			_ => invalidOpcode(opcode);
		}
	}
	def assemble_v_v_v(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, opcode: int) {
		var op = getArg1(opcode);
		if (getArg2(opcode) != 0) {
			match (op) {
				0 => asm.fadd_d(rd, rs1, rs2, DYN);
				1 => asm.fsub_d(rd, rs1, rs2, DYN);
				2 => asm.fmul_d(rd, rs1, rs2, DYN);
				3 => asm.fdiv_d(rd, rs1, rs2, DYN);
				_ => context.fail1("invalid float binop: %d", op);
			}
		} else {
			match (op) {
				0 => asm.fadd_s(rd, rs1, rs2, DYN);
				1 => asm.fsub_s(rd, rs1, rs2, DYN);
				2 => asm.fmul_s(rd, rs1, rs2, DYN);
				3 => asm.fdiv_s(rd, rs1, rs2, DYN);
				_ => context.fail1("invalid float binop: %d", op);
			}
		}
	}
	def assemble_v_v(rd: RiscV64Fpr, rs: RiscV64Fpr, opcode: int) {
		var sub = getArg1(opcode), is64 = getArg2(opcode) != 0;
		match (getCode(opcode)) {
			I_FLOATUNARY => {
				match (sub) {
					0 => if (is64) asm.fsqrt_d(rd, rs, DYN); else asm.fsqrt_s(rd, rs, DYN);
					1 => if (is64) asm.fabs_d(rd, rs); else asm.fabs_s(rd, rs);
					2 => assemble_fround(rd, rs, is64, RiscV64Rm.RUP);
					3 => assemble_fround(rd, rs, is64, RiscV64Rm.RDN);
					4 => assemble_fround(rd, rs, is64, RiscV64Rm.RNE);
					_ => context.fail1("invalid float unary op: %d", sub);
				}
			}
			I_FLOATCONV => assemble_fconv(rd, rs, sub == 0);
			_ => invalidOpcode(opcode);
		}
	}
	// fcvt canonicalizes NaNs, but Virgil casts expect a NaN's sign and upper payload to
	// survive the round trip, so NaN inputs are converted by hand on a slow path.
	def assemble_fconv(rd: RiscV64Fpr, rs: RiscV64Fpr, toDouble: bool) {
		var t3 = Regs.T3, t4 = Regs.T4, t6 = Regs.T6;
		// read the bits and test for NaN before the conversion, since rd may alias rs
		if (toDouble) {
			asm.fmv_x_w(t4, rs);
			asm.feq_s(t6, rs, rs);
			asm.fcvt_d_s(rd, rs);
		} else {
			asm.fmv_x_d(t4, rs);
			asm.feq_d(t6, rs, rs);
			asm.fcvt_s_d(rd, rs, DYN);
		}
		var branchPos = asm.pos();
		asm.bnez(t6, 0);			// not NaN: done; patched below
		if (toDouble) {
			asm.slli(t6, t4, 41);		// t6 = payload (low 23 bits) << 29
			asm.srli(t6, t6, 12);
			asm.srai(t4, t4, 31);		// t4 = sign bit at 63
			asm.slli(t4, t4, 63);
			asm.li32(t3, 0xFFF);		// t3 = exponent all ones + quiet bit
			asm.slli(t3, t3, 51);
			asm.or(t4, t4, t3);
			asm.or(t4, t4, t6);
			asm.fmv_d_x(rd, t4);
		} else {
			asm.srli(t6, t4, 29);		// t6 = top 23 payload bits
			asm.slli(t6, t6, 41);
			asm.srli(t6, t6, 41);
			asm.srai(t4, t4, 63);		// t4 = sign bit at 31
			asm.slli(t4, t4, 31);
			asm.li32(t3, 0x7FC00000);	// exponent all ones + quiet bit
			asm.or(t4, t4, t3);
			asm.or(t4, t4, t6);
			asm.fmv_w_x(rd, t4);
		}
		asm.patch_b_imm(branchPos, i13.view(asm.pos() - branchPos));
	}
	// Round {rs} to an integral value according to {rm}: values below 2^52 (2^23 for single)
	// round-trip through an integer and take back the input's sign; the rest are already integral.
	def assemble_fround(rd: RiscV64Fpr, rs: RiscV64Fpr, is64: bool, rm: RiscV64Rm) {
		var ft = Regs.FT11, t4 = Regs.T4, t6 = Regs.T6;
		if (rd != rs) asm.fmv_d(rd, rs);
		if (is64) {
			asm.li(t4, 0x4330000000000000L);	// 2^52
			asm.fmv_d_x(ft, t4);
			asm.flt_d(t4, rs, ft);			// rs < 2^52 (false for NaN)
			asm.fneg_d(ft, ft);
			asm.flt_d(t6, ft, rs);			// -2^52 < rs
			asm.and(t4, t4, t6);
			asm.beqz(t4, 16);			// out of range or NaN: rd = rs
			asm.fcvt_l_d(t4, rs, rm);
			asm.fcvt_d_l(ft, t4, rm);		// via ft, since rd may alias rs
			asm.fsgnj_d(rd, ft, rs);
		} else {
			asm.li32(t4, 0x4B000000);		// 2^23
			asm.fmv_w_x(ft, t4);
			asm.flt_s(t4, rs, ft);
			asm.fneg_s(ft, ft);
			asm.flt_s(t6, ft, rs);
			asm.and(t4, t4, t6);
			asm.beqz(t4, 16);
			asm.fcvt_l_s(t4, rs, rm);
			asm.fcvt_s_l(ft, t4, rm);
			asm.fsgnj_s(rd, ft, rs);
		}
	}
	def assemble_r_v_v(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, opcode: int) {
		var is64 = getArg2(opcode) != 0;
		match (getCode(opcode)) {
			I_FLOATCMP => {
				var cond = getArg1(opcode);
				if (is64) {
					match (cond) {
						FC_EQ, FC_NE => asm.feq_d(rd, rs1, rs2);
						FC_LT => asm.flt_d(rd, rs1, rs2);
						FC_LE => asm.fle_d(rd, rs1, rs2);
						_ => context.fail1("invalid float cond: %d", cond);
					}
				} else {
					match (cond) {
						FC_EQ, FC_NE => asm.feq_s(rd, rs1, rs2);
						FC_LT => asm.flt_s(rd, rs1, rs2);
						FC_LE => asm.fle_s(rd, rs1, rs2);
						_ => context.fail1("invalid float cond: %d", cond);
					}
				}
				if (cond == FC_NE) asm.xori(rd, rd, 1);
			}
			I_FLOATBITEQ => {
				if (is64) {
					asm.fmv_x_d(Regs.T4, rs1);
					asm.fmv_x_d(Regs.T6, rs2);
				} else {
					asm.fmv_x_w(Regs.T4, rs1);
					asm.fmv_x_w(Regs.T6, rs2);
				}
				asm.xor(rd, Regs.T4, Regs.T6);
				asm.seqz(rd, rd);
			}
			_ => invalidOpcode(opcode);
		}
	}
	def assemble_r_v(rd: RiscV64Gpr, rs: RiscV64Fpr, opcode: int) {
		match (getCode(opcode)) {
			I_INTTRUNCF => assemble_inttruncf(rd, rs, getArg1(opcode));
			I_INTVIEWF => {
				if (getArg2(opcode) != 0) asm.fmv_x_d(rd, rs);
				else asm.fmv_x_w(rd, rs);
			}
			_ => invalidOpcode(opcode);
		}
	}
	def assemble_v_r(rd: RiscV64Fpr, rs: RiscV64Gpr, opcode: int) {
		match (getCode(opcode)) {
			I_FLOATROUNDI => assemble_floatroundi(rd, rs, getArg1(opcode));
			I_FLOATVIEWI => {
				if (getArg2(opcode) != 0) asm.fmv_d_x(rd, rs);
				else asm.fmv_w_x(rd, rs);
			}
			_ => invalidOpcode(opcode);
		}
	}
	// {subop} bit 0: unsigned; bit 1: 64-bit (double) source; bit 2: 64-bit destination.
	def assemble_inttruncf(rd: RiscV64Gpr, rs: RiscV64Fpr, subop: int) {
		var unsigned = (subop & 1) != 0;
		var is64src = (subop & 2) != 0;
		var is64dst = (subop & 4) != 0;
		var rtz = RiscV64Rm.RTZ;
		if (is64src) {
			if (is64dst) { if (unsigned) asm.fcvt_lu_d(rd, rs, rtz); else asm.fcvt_l_d(rd, rs, rtz); }
			else { if (unsigned) asm.fcvt_wu_d(rd, rs, rtz); else asm.fcvt_w_d(rd, rs, rtz); }
		} else {
			if (is64dst) { if (unsigned) asm.fcvt_lu_s(rd, rs, rtz); else asm.fcvt_l_s(rd, rs, rtz); }
			else { if (unsigned) asm.fcvt_wu_s(rd, rs, rtz); else asm.fcvt_w_s(rd, rs, rtz); }
		}
	}
	// {subop} bit 0: unsigned; bit 1: 64-bit (double) destination; bit 2: 64-bit source.
	def assemble_floatroundi(rd: RiscV64Fpr, rs: RiscV64Gpr, subop: int) {
		var unsigned = (subop & 1) != 0;
		var is64dst = (subop & 2) != 0;
		var is64src = (subop & 4) != 0;
		if (is64dst) {
			if (is64src) { if (unsigned) asm.fcvt_d_lu(rd, rs, DYN); else asm.fcvt_d_l(rd, rs, DYN); }
			else { if (unsigned) asm.fcvt_d_wu(rd, rs); else asm.fcvt_d_w(rd, rs); }
		} else {
			if (is64src) { if (unsigned) asm.fcvt_s_lu(rd, rs, DYN); else asm.fcvt_s_l(rd, rs, DYN); }
			else { if (unsigned) asm.fcvt_s_wu(rd, rs, DYN); else asm.fcvt_s_w(rd, rs, DYN); }
		}
	}
	def assemble_fconst(rd: RiscV64Fpr, val: Val, is64: bool) {
		var tmp = Regs.T6;
		if (is64) {
			var bits: long;
			match (val) {
				null => ;
				x: Float64Val => bits = long.view(x.bits);
				x: Box<long> => bits = x.val;
				_ => context.fail("I_FCONST: unhandled Val type");
			}
			if (bits == 0) { asm.fmv_d_x(rd, Regs.ZERO); return; }
			asm.li(tmp, bits);
			asm.fmv_d_x(rd, tmp);
		} else {
			var bits: int;
			match (val) {
				null => ;
				x: Float32Val => bits = int.view(x.bits);
				x: Box<int> => bits = x.val;
				_ => context.fail("I_FCONST: unhandled Val type");
			}
			if (bits == 0) { asm.fmv_w_x(rd, Regs.ZERO); return; }
			asm.li32(tmp, bits);
			asm.fmv_w_x(rd, tmp);
		}
	}
	// Compare-and-swap via an lr/sc loop; t4 holds the loaded value and t6 the sc status.
	def assemble_cmpswp(rd: RiscV64Gpr, ptr: RiscV64Gpr, expected: RiscV64Gpr, new_val: RiscV64Gpr, size: int) {
		match (size) {
			4 => asm.lr_w(Regs.T4, ptr, true, false);
			8 => asm.lr_d(Regs.T4, ptr, true, false);
			_ => context.fail1("unsupported size for cmpswp: %d", size);
		}
		asm.bne(Regs.T4, expected, 20);		// -> fail
		if (size == 4) asm.sc_w(Regs.T6, new_val, ptr, false, true);
		else asm.sc_d(Regs.T6, new_val, ptr, false, true);
		asm.bnez(Regs.T6, -12);			// -> retry
		asm.li32(rd, 1);
		asm.jal(Regs.ZERO, 8);			// -> done
		asm.li32(rd, 0);			// fail:
	}
	// Switch through a jump table of 32-bit offsets from the table base, emitted after the
	// method body. Operands: key, case labels, default label.
	def assemble_switch(a: Array<Operand>, opcode: int) {
		def rkey = toGpr(a[0]);
		def numCases = a.length - 2;
		def defaultLabel = toLabel(a[numCases + 1]);
		if (numCases <= 0) return assemble_jump(defaultLabel);

		// an unsigned compare sends out-of-range and negative keys to the default
		asm.li32(Regs.T4, numCases - 1);
		asm.bgeu(Regs.T4, rkey, 8);
		assemble_jump(defaultLabel);

		def cases = Array<Label>.new(numCases);
		for (k < numCases) cases[k] = toLabel(a[k + 1]);
		jumpTableAuipcPos.put(asm.pos());
		jumpTableCases.put(cases);
		asm.auipc(Regs.T4, 0);			// t4 = table base; patched at flushJumpTables
		asm.addi(Regs.T4, Regs.T4, 0);
		asm.slli(Regs.T6, rkey, 2);
		asm.add(Regs.T6, Regs.T4, Regs.T6);
		asm.lw(Regs.T6, Regs.T6, 0);
		asm.add(Regs.T4, Regs.T4, Regs.T6);
		asm.jr(Regs.T4);
	}
	def flushJumpTables() {
		for (i < jumpTableCases.length) {
			def auipcPos = jumpTableAuipcPos[i], cases = jumpTableCases[i];
			def base = asm.pos();
			asm.patch_hi20_lo12_i(auipcPos, base - auipcPos);
			for (k < cases.length) {
				def label = cases[k];
				if (label.pos < 0) return context.fail("unbound block label in switch jump table");
				w.put_b32(label.pos - base);
			}
		}
		jumpTableAuipcPos.resize(0);
		jumpTableCases.resize(0);
	}
	def assemble_base_imm12(a: Array<Operand>, opcode: int) {
		var imm = i12.view(toB32(toImm(a[2])));
		match (getCode(opcode)) {
			I_LB  => asm.lb(toGpr(a[0]), toGpr(a[1]), imm);
			I_LH  => asm.lh(toGpr(a[0]), toGpr(a[1]), imm);
			I_LW  => asm.lw(toGpr(a[0]), toGpr(a[1]), imm);
			I_LD  => asm.ld(toGpr(a[0]), toGpr(a[1]), imm);
			I_LBU => asm.lbu(toGpr(a[0]), toGpr(a[1]), imm);
			I_LHU => asm.lhu(toGpr(a[0]), toGpr(a[1]), imm);
			I_FLW => asm.flw(toFpr(a[0]), toGpr(a[1]), imm);
			I_FLD => asm.fld(toFpr(a[0]), toGpr(a[1]), imm);
			I_NULLCHK => asm.lb(Regs.ZERO, toGpr(a[1]), imm);
			I_SB  => asm.sb(toGpr(a[1]), toGpr(a[0]), imm);
			I_SH  => asm.sh(toGpr(a[1]), toGpr(a[0]), imm);
			I_SW  => asm.sw(toGpr(a[1]), toGpr(a[0]), imm);
			I_SD  => asm.sd(toGpr(a[1]), toGpr(a[0]), imm);
			I_FSW => asm.fsw(toFpr(a[1]), toGpr(a[0]), imm);
			I_FSD => asm.fsd(toFpr(a[1]), toGpr(a[0]), imm);
			_ => invalidOpcode(opcode);
		}
	}
	def widthOf(i: SsaApplyOp) -> byte {
		return if(PrimType.!(i.op.typeArgs[0]).width > 32, W64, W32);
	}
	// Emit add or sub, folding a constant right operand into addi when it fits.
	def emitIntAddSub(i: SsaApplyOp, sub: bool) {
		var width = widthOf(i);
		m.intbinop(i);
		dfnReg(i);
		useReg(m.x);
		var imm = constImm(m.y);
		if (!sub && fitsI12(imm)) {
			useInt(int.view(imm));
			emitN(makeOpcode(I_ADD, AM_R_R_I, ARG_NONE, width));
		} else if (sub && fitsI12(0 - imm) && imm != long.min) {
			useInt(int.view(0 - imm));
			emitN(makeOpcode(I_ADD, AM_R_R_I, ARG_NONE, width));
		} else {
			useReg(m.y);
			emitN(makeOpcode(if(sub, I_SUB, I_ADD), AM_R_R_R, ARG_NONE, width));
		}
	}
	def emitImmBinop(code: byte, i: SsaApplyOp) {
		var width = widthOf(i);
		m.intbinop(i);
		dfnReg(i);
		useReg(m.x);
		var imm = constImm(m.y);
		if (fitsI12(imm)) {
			useInt(int.view(imm));
			emitN(makeOpcode(code, AM_R_R_I, ARG_NONE, width));
		} else {
			useReg(m.y);
			emitN(makeOpcode(code, AM_R_R_R, ARG_NONE, width));
		}
	}
	def emitShift(code: byte, i: SsaApplyOp) {
		var width = widthOf(i);
		m.intbinop(i);
		dfnReg(i);
		useReg(m.x);
		var imm = constImm(m.y);
		if (imm != NOT_CONST && imm >= 0 && imm < (if(width == W64, 64, 32))) {
			useInt(int.view(imm));
			emitN(makeOpcode(code, AM_R_R_I, ARG_NONE, width));
		} else {
			useReg(m.y);
			emitN(makeOpcode(code, AM_R_R_R, ARG_NONE, width));
		}
	}
	def emitRegBinop(code: byte, i: SsaApplyOp) {
		var width = widthOf(i);
		m.intbinop(i);
		dfnReg(i);
		useReg(m.x);
		useReg(m.y);
		emitN(makeOpcode(code, AM_R_R_R, ARG_NONE, width));
	}
	def emitBoolBinop(code: byte, i: SsaApplyOp) {
		m.boolbinop(i);
		dfnReg(i);
		useReg(m.x);
		useReg(m.y);
		emitN(makeOpcode(code, AM_R_R_R, ARG_NONE, W64));
	}
	def emitIntDivMod(i: SsaApplyOp, isMod: bool) {
		var it = IntType.!(i.op.typeArgs[0]);
		if (!i.facts.O_NO_ZERO_CHECK) { // division by zero does not trap
			useReg(i.input1());
			useExSource(V3Exception.DivideByZero, i.source);
			emitN(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_THROWZ, AM_R, ARG_NONE, ARG_NONE));
		}
		var code: byte;
		if (it.signed) code = if(isMod, I_REM, I_DIV);
		else           code = if(isMod, I_REMU, I_DIVU);
		emitRegBinop(code, i);
	}
	def emitIntCmp(cond: RiscV64Cond, i: SsaApplyOp) {
		dfnReg(i);
		useReg(i.input0());
		useReg(i.input1());
		emitN(makeOpcode(I_CMP, AM_R_R_R, byte.view(condIndex(cond)), W64));
	}
	def condIndex(cond: RiscV64Cond) -> int {
		for (j < Conds.all.length) if (Conds.all[j] == cond) return j;
		context.fail("unknown condition");
		return 0;
	}
	def emitBoolNot(i: SsaApplyOp) {
		dfnReg(i);
		useReg(i.input0());
		emitN(makeOpcode(I_BNOT, AM_R_R, ARG_NONE, W64));
	}
	def emitPtrBinop(code: byte, i: SsaApplyOp) {
		m.binop(i);
		dfnReg(i);
		useReg(m.x);
		var imm = constImm(m.y);
		if (code == I_ADD && fitsI12(imm)) {
			useInt(int.view(imm));
			emitN(makeOpcode(I_ADD, AM_R_R_I, ARG_NONE, W64));
		} else if (code == I_SUB && fitsI12(0 - imm) && imm != long.min) {
			useInt(int.view(0 - imm));
			emitN(makeOpcode(I_ADD, AM_R_R_I, ARG_NONE, W64));
		} else {
			useReg(m.y);
			emitN(makeOpcode(code, AM_R_R_R, ARG_NONE, W64));
		}
	}
	def emitPtrCmpSwp(i: SsaApplyOp) {
		dfnReg(i);
		useReg(i.input0());       // ptr
		useReg(i.input1());       // expected
		useReg(i.inputs[2].dest); // new value
		var size = mach.sizeOf(i.op.typeArgs[1]);
		useInt(size);
		if (!i.facts.O_NO_NULL_CHECK) useExSource(V3Exception.NullCheck, i.source);
		emitN(makeOpcode(I_CMPSWP, AM_CMPSWP, ARG_NONE, ARG_NONE));
	}
	def emitReturnTo(i: SsaApplyOp) {
		var rtypes = Tuple.toTypeArray(i.op.typeArgs[0]);
		var conv = frame.allocCallerSpace(RiscV64VirgilCallConv.getForTypes(mach, TypeUtil.NO_TYPES, rtypes));
		for (j = 1; j < i.inputs.length; j++) {
			var r = i.inputs[j].dest;
			useFixed(r, conv.calleeRet(j - 1));
		}
		useFixed(i.inputs[0].dest, MRegs.SCRATCH_GPR);
		emitN(makeOpcode(I_RETTO, AM_NONE, ARG_NONE, ARG_NONE));
	}
	def emitCallKernel(call: SsaApplyOp, kernel: Kernel) {
		var rv = getProjections(call);
		for (i < rv.length) {
			var r = rv[i];
			if (r != null) dfnFixed(r, RiscV64Common.KERNEL_RETURN_REGS[i]);
		}
		kill(MRegs.ALL);
		kill(MRegs.SCRATCH);
		var inputs = call.inputs;
		for (i < inputs.length) {
			useFixed(inputs[i].dest, RiscV64Common.KERNEL_PARAM_REGS[i]);
		}
		emitN(makeOpcode(I_SYSCALL, AM_NONE, ARG_NONE, ARG_NONE));
	}
	// Fold PtrAdd(base, #const) into base + imm12 addressing when the constant fits.
	def matchBaseImm12(ptr: SsaInstr) -> (SsaInstr, int) {
		var t = matchAddImm(ptr, null);
		var base = t.0, disp = t.1;
		if (disp != null) {
			var offset = 0;
			match (disp) {
				x: Box<int> => offset = x.val;
				_ => return (ptr, 0);
			}
			if (asm.fitsI12(offset)) return (base, offset);
		}
		return (ptr, 0);
	}
	// 32-bit values are always loaded sign-extended, per the register representation.
	def loadOpcode(lt: Type) -> byte {
		if (FloatType.?(lt)) return if(FloatType.!(lt).is64, I_FLD, I_FLW);
		var size = mach.sizeOf(lt);
		match (size) {
			1 => return if(V3.isSigned(lt), I_LB, I_LBU);
			2 => return if(V3.isSigned(lt), I_LH, I_LHU);
			4 => return I_LW;
			8 => return I_LD;
			_ => { context.fail1("invalid size for load: %d", size); return I_LD; }
		}
	}
	def storeOpcode(lt: Type) -> byte {
		if (FloatType.?(lt)) return if(FloatType.!(lt).is64, I_FSD, I_FSW);
		var size = mach.sizeOf(lt);
		match (size) {
			1 => return I_SB;
			2 => return I_SH;
			4 => return I_SW;
			8 => return I_SD;
			_ => { context.fail1("invalid size for store: %d", size); return I_SD; }
		}
	}
	def emitPtrLoad(i: SsaApplyOp) {
		var lt = i.op.typeArgs[1];
		var size = mach.sizeOf(lt);
		var t = matchBaseImm12(i.input0());
		if (size == 0) { // null check only
			dfnFixed(i, MRegs.SCRATCH_GPR);
			useReg(t.0);
			useInt(t.1);
			if (!i.facts.O_NO_NULL_CHECK) useExSource(V3Exception.NullCheck, i.source);
			emitN(makeOpcode(I_NULLCHK, AM_BASE_IMM12, ARG_NONE, ARG_NONE));
			return;
		}
		var code = loadOpcode(lt);
		dfnReg(i);
		useReg(t.0);
		useInt(t.1);
		if (!i.facts.O_NO_NULL_CHECK) useExSource(V3Exception.NullCheck, i.source);
		emitN(makeOpcode(code, AM_BASE_IMM12, ARG_NONE, ARG_NONE));
	}
	def emitPtrStore(i: SsaApplyOp) {
		var lt = i.op.typeArgs[1];
		var size = mach.sizeOf(lt);
		if (size == 0) { // null check only
			useReg(i.input0());
			if (!i.facts.O_NO_NULL_CHECK) useExSource(V3Exception.NullCheck, i.source);
			emitN(makeOpcode(I_NULLCHK, AM_R, ARG_NONE, ARG_NONE));
			return;
		}
		var code = storeOpcode(lt);
		var t = matchBaseImm12(i.input0());
		useReg(t.0);
		useReg(i.input1());
		useInt(t.1);
		if (!i.facts.O_NO_NULL_CHECK) useExSource(V3Exception.NullCheck, i.source);
		emitN(makeOpcode(code, AM_BASE_IMM12, ARG_NONE, ARG_NONE));
	}
	def emitAlloc(i: SsaApplyOp) {
		if (mach.allocStub != null) {
			dfnFixed(i, MRegs.A0);
			kill(MRegs.ALL);
			kill(MRegs.SCRATCH);
			refmap(null);
			useFixed(i.input0(), MRegs.A1);
			useExSource(null, i.source);
			useImm(mach.allocStub);
			emitN(makeOpcode(I_CALL, AM_NONE, ARG_NONE, ARG_NONE));
		} else {
			kill(MRegs.SCRATCH);
			ovwReg(i, i.input0());
			emitN(makeOpcode(I_ALLOC, AM_NONE, ARG_NONE, ARG_NONE));
		}
	}
	def emitConditionalThrow(exception: string, i: SsaApplyOp) {
		useReg(i.input0());
		useExSource(exception, i.source);
		emitN(ArchInstrs.FLAG_NO_GAP | makeOpcode(I_THROWC, AM_R, ARG_NONE, ARG_NONE));
	}
	// Integer reinterpret/truncate/extend, keeping narrow values sign-extended from 32 bits.
	def emitIntViewI(i: SsaApplyOp) {
		var ft = IntType.!(i.op.typeArgs[0]);
		var tt = IntType.!(i.op.typeArgs[1]);
		var from64 = ft.width > 32;
		var fromU32 = ft.rank == IntRank.U32;
		match (tt.rank) {
			I32, U32 => {
				if (from64) emitIntView(i, IV_SEXT32, 0);
				else emitIntView(i, IV_MOV, 0);
			}
			SUBU32 => emitIntView(i, IV_ZEXT, 64 - tt.width);
			SUBI32 => emitIntView(i, IV_SEXT, 64 - tt.width);
			I64, U64 => {
				if (fromU32) emitIntView(i, IV_ZEXT32, 0);
				else emitIntView(i, IV_MOV, 0);
			}
			SUBU64 => {
				if (fromU32) emitIntView(i, IV_ZEXT32, 0);
				else emitIntView(i, IV_ZEXT, 64 - tt.width);
			}
			SUBI64 => {
				if (fromU32) emitIntView(i, IV_ZEXT32, 0);
				else if (from64) emitIntView(i, IV_SEXT, 64 - tt.width);
				else emitIntView(i, IV_MOV, 0);
			}
		}
	}
	def emitIntView(i: SsaApplyOp, subop: byte, shift: int) {
		dfnReg(i);
		useReg(i.input0());
		useInt(shift);
		emitN(makeOpcode(I_INTVIEWI, AM_R_R_I, subop, W64));
	}
	def emitIntTruncF(i: SsaApplyOp, is64: bool) {
		var it = IntType.!(i.op.typeArgs[1]);
		dfnReg(i);
		useReg(i.input0());
		// a u32 destination uses fcvt.wu, which saturates to u32 and sign-extends
		var subop = 0;
		if (!it.signed) subop = subop | 1;
		if (is64) subop = subop | 2;
		match (it.rank) {
			SUBI64, SUBU64, I64, U64 => subop = subop | 4;
			_ => ;
		}
		emitN(makeOpcode(I_INTTRUNCF, AM_R_V, byte.view(subop), ARG_NONE));
	}
	def emitFloatRoundI(i: SsaApplyOp, is64: bool) {
		var it = IntType.!(i.op.typeArgs[0]);
		dfnReg(i);
		useReg(i.input0());
		// a u32 source is held sign-extended, so it must be read with fcvt.*.wu
		var subop = 0;
		if (!it.signed) subop = subop | 1;
		if (is64) subop = subop | 2;
		match (it.rank) {
			SUBI64, SUBU64, I64, U64 => subop = subop | 4;
			_ => ;
		}
		emitN(makeOpcode(I_FLOATROUNDI, AM_V_R, byte.view(subop), ARG_NONE));
	}
	def emitFloatViewI(i: SsaApplyOp, is64: bool) {
		dfnReg(i);
		useReg(i.input0());
		emitN(makeOpcode(I_FLOATVIEWI, AM_V_R, ARG_NONE, wide(is64)));
	}
	def emitIntViewF(i: SsaApplyOp, is64: bool) {
		dfnReg(i);
		useReg(i.input0());
		emitN(makeOpcode(I_INTVIEWF, AM_R_V, ARG_NONE, wide(is64)));
	}
	def emitFloatCmp(i: SsaApplyOp, is64: bool, cond: byte) {
		dfnReg(i);
		useReg(i.input0());
		useReg(i.input1());
		emitN(makeOpcode(I_FLOATCMP, AM_R_V_V, cond, wide(is64)));
	}
	def emitFloatBitEq(i: SsaApplyOp, is64: bool) {
		dfnReg(i);
		useReg(i.input0());
		useReg(i.input1());
		emitN(makeOpcode(I_FLOATBITEQ, AM_R_V_V, ARG_NONE, wide(is64)));
	}
	def emitFloatBinop(i: SsaApplyOp, is64: bool, op: int) {
		dfnReg(i);
		useReg(i.input0());
		useReg(i.input1());
		emitN(makeOpcode(I_FLOATBINOP, AM_V_V_V, byte.view(op), wide(is64)));
	}
	def emitFloatUnaryOp(i: SsaApplyOp, is64: bool, op: int) {
		dfnReg(i);
		useReg(i.input0());
		emitN(makeOpcode(I_FLOATUNARY, AM_V_V, byte.view(op), wide(is64)));
	}
	def emitFloatConvert(i: SsaApplyOp, toDouble: bool) {
		dfnReg(i);
		useReg(i.input0());
		emitN(makeOpcode(I_FLOATCONV, AM_V_V, wide(!toDouble), ARG_NONE));
	}
	def wide(is64: bool) -> byte {
		return if(is64, W64, W32);
	}
	def emitMov(i: SsaApplyOp) {
		dfnReg(i);
		use(i.input0());
		emitN(makeOpcode(I_MOV, AM_R_OP, ARG_NONE, ARG_NONE));
	}
	def NOT_CONST = long.min; // sentinel for {constImm}
	// Returns the value of {i} if it is an integer constant, or {NOT_CONST} otherwise.
	def constImm(i: SsaInstr) -> long {
		if (!SsaConst.?(i)) return NOT_CONST;
		match (SsaConst.!(i).val) {
			null => return 0;
			x: Box<int> => return x.val;
			x: Box<long> => return x.val;
			x: Box<bool> => return if(x.val, 1, 0);
			_ => return NOT_CONST;
		}
	}
	def fitsI12(v: long) -> bool {
		return v != NOT_CONST && asm.fitsI12(v);
	}
	def recordReturnSource(a: Array<Operand>) {
		if (rtsrc == null) return;
		for (i = a.length - 1; i >= 0; i--) {
			match (a[i]) {
				ExSource(ex, src) => { rtsrc.recordReturnSource(w.offset(), src); return; }
				_ => ;
			}
		}
	}
	def recordExSource(a: Array<Operand>) {
		if (rtsrc == null) return;
		if (a.length == 0) return;
		for (i = a.length - 1; i >= 0; i--) {
			match (a[i]) {
				ExSource(ex, src) => { if (ex != null) rtsrc.recordSource(w.offset(), src); return; }
				_ => ;
			}
		}
	}
	def toLoc(o: Operand) -> int {
		match (o) {
			Overwrite(dst, src, assignment) => return assignment;
			Def(vreg, assignment) => return assignment;
			Use(vreg, assignment) => return assignment;
			_ => { context.fail("expected operand with assignment"); return 0; }
		}
	}
	def toGpr(o: Operand) -> RiscV64Gpr {
		return loc_r(toLoc(o));
	}
	def loc_r(loc: int) -> RiscV64Gpr {
		var gpr = MRegs.toGpr(loc);
		if (gpr == null) { context.fail1("expected GPR, got %s", regSet.identify(loc)); return Regs.A0; }
		return gpr;
	}
	def toFpr(o: Operand) -> RiscV64Fpr {
		return loc_f(toLoc(o));
	}
	def loc_f(loc: int) -> RiscV64Fpr {
		var fpr = MRegs.toFpr(loc);
		if (fpr == null) { context.fail1("expected FP register, got %s", regSet.identify(loc)); return Regs.FA0; }
		return fpr;
	}
	def toB32(val: Val) -> int {
		var b: int;
		match (val) {
			x: Box<int> 		=> b = x.val;
			x: Box<long> 		=> b = int.view(x.val);
			x: Box<bool> 		=> b = if(x.val, 1);
			x: Float32Val 		=> b = int.view(x.bits);
			x: Float64Val 		=> b = int.view(x.bits);
			x: ArrayRangeStart 	=> b = x.start;
			null 			=> b = 0;
			_ => ;
		}
		return b;
	}
	def invalidOpcode(opcode: int) {
		context.fail(Strings.format2("invalid opcode am=%x code=%x", getAM(opcode), getCode(opcode)));
	}
	def getOutput() -> ArchInstrBuffer {
		if (out != null) return out;
		return out = SsaRiscV64Buffer.new(this, context.prog, regSet);
	}
}

class SsaRiscV64Buffer extends ArchInstrBuffer {
	def riscv64codegen: SsaRiscV64Gen;
	new(riscv64codegen, prog: Program, regSet: MachRegSet) super(riscv64codegen, prog, regSet) { }
	def putArchInstr(indent: int, i: ArchInstr) -> int {
		var opcode = int.view(i.opcode()), a = i.operands;
		var name: string;

		match (opcode & 0xFF) {
			I_ADD		=> name = "add";
			I_SUB		=> name = "sub";
			I_MUL		=> name = "mul";
			I_AND		=> name = "and";
			I_OR		=> name = "or";
			I_XOR		=> name = "xor";
			I_SLL		=> name = "sll";
			I_SRA		=> name = "sra";
			I_SRL		=> name = "srl";
			I_NEG		=> name = "neg";
			I_DIV		=> name = "div";
			I_DIVU		=> name = "divu";
			I_REM		=> name = "rem";
			I_REMU		=> name = "remu";
			I_BNOT		=> name = "bnot";
			I_CMP		=> name = Strings.format1("cmp.%s", RiscV64Conds.all[getArg1(opcode)].name);
			I_LI		=> name = "li";
			I_MOV		=> name = "mv";
			I_LB		=> name = "lb";
			I_LH		=> name = "lh";
			I_LW		=> name = "lw";
			I_LD		=> name = "ld";
			I_LBU		=> name = "lbu";
			I_LHU		=> name = "lhu";
			I_FLW		=> name = "flw";
			I_FLD		=> name = "fld";
			I_SB		=> name = "sb";
			I_SH		=> name = "sh";
			I_SW		=> name = "sw";
			I_SD		=> name = "sd";
			I_FSW		=> name = "fsw";
			I_FSD		=> name = "fsd";
			I_NULLCHK	=> name = "nullchk";
			I_J		=> name = "j";
			I_BEQZ		=> name = "beqz";
			I_BNEZ		=> name = "bnez";
			I_UNIMP		=> name = "unimp";
			I_SWITCH	=> name = "switch";
			I_CALL		=> name = "call";
			I_CALLR		=> name = "jalr";
			I_ALLOC		=> name = "alloc";
			I_THROW		=> name = "throw";
			I_THROWC	=> name = "throwc";
			I_THROWZ	=> name = "throwz";
			I_INTVIEWI	=> name = "intviewi";
			I_INTTRUNCF	=> name = "inttruncf";
			I_FLOATROUNDI	=> name = "floatroundi";
			I_FLOATVIEWI	=> name = "floatviewi";
			I_INTVIEWF	=> name = "intviewf";
			I_FLOATCMP	=> name = "floatcmp";
			I_FLOATBINOP	=> name = "floatbinop";
			I_FLOATUNARY	=> name = "floatunary";
			I_FLOATCONV	=> name = "floatconv";
			I_FLOATBITEQ	=> name = "floatbiteq";
			I_FMOV		=> name = "fmv";
			I_FCONST	=> name = "fconst";
			I_KILLREGS	=> name = "killregs";
			I_CALLERIP	=> name = "callerip";
			I_CALLERSP	=> name = "callersp";
			I_CMPSWP	=> name = "cmpswp";
			I_RETTO		=> name = "retto";
			I_SYSCALL	=> name = "ecall";
		}
		putIndent(indent);
		puts(name);
		if (getArg2(opcode) == W32 && (opcode & 0xFF) <= I_REMU) puts("w");
		sp();
		putOperands(i.operands);
		return indent;
	}
}
