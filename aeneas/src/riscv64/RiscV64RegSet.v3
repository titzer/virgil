// Register allocator configuration for riscv64. Values narrower than 64 bits are held
// sign-extended from 32 bits (what the "W" instructions produce), so 64-bit comparisons
// order them correctly; single floats are NaN-boxed, so FPR moves and spills are 64-bit.
component RiscV64RegSet {
	private def gprCount = 32; // x0-x31
	private def fprCount = 32; // f0-f31
	private def allCount = 71; // GPRs + FPRs + register sets + spare

	private def regSets = Array<Array<byte>>.new(allCount);
	private def regNames = Array<string>.new(allCount);

	private def locToGprArr = Array<RiscV64Gpr>.new(gprCount);
	private def locToFprArr = Array<RiscV64Fpr>.new(fprCount);

	private var cursor = 1;
	private var gprStart = cursor;

	// All GPRs get a location so that {toGpr} works for any of them; only some are allocatable.
	def ZERO = gpr("zero", RiscV64Regs.ZERO);
	def RA = gpr("ra", RiscV64Regs.RA);
	def SP = gpr("sp", RiscV64Regs.SP);
	def GP = gpr("gp", RiscV64Regs.GP);
	def TP = gpr("tp", RiscV64Regs.TP);
	def T0 = gpr("t0", RiscV64Regs.T0), T1 = gpr("t1", RiscV64Regs.T1), T2 = gpr("t2", RiscV64Regs.T2);
	def S0 = gpr("s0", RiscV64Regs.S0), S1 = gpr("s1", RiscV64Regs.S1);
	def A0 = gpr("a0", RiscV64Regs.A0), A1 = gpr("a1", RiscV64Regs.A1), A2 = gpr("a2", RiscV64Regs.A2), A3 = gpr("a3", RiscV64Regs.A3);
	def A4 = gpr("a4", RiscV64Regs.A4), A5 = gpr("a5", RiscV64Regs.A5), A6 = gpr("a6", RiscV64Regs.A6), A7 = gpr("a7", RiscV64Regs.A7);
	def S2 = gpr("s2", RiscV64Regs.S2), S3 = gpr("s3", RiscV64Regs.S3), S4 = gpr("s4", RiscV64Regs.S4), S5 = gpr("s5", RiscV64Regs.S5);
	def S6 = gpr("s6", RiscV64Regs.S6), S7 = gpr("s7", RiscV64Regs.S7), S8 = gpr("s8", RiscV64Regs.S8), S9 = gpr("s9", RiscV64Regs.S9);
	def S10 = gpr("s10", RiscV64Regs.S10), S11 = gpr("s11", RiscV64Regs.S11);
	def T3 = gpr("t3", RiscV64Regs.T3), T4 = gpr("t4", RiscV64Regs.T4), T5 = gpr("t5", RiscV64Regs.T5), T6 = gpr("t6", RiscV64Regs.T6);

	private var fprStart = cursor;

	def FT0 = fpr("ft0", RiscV64Regs.FT0), FT1 = fpr("ft1", RiscV64Regs.FT1), FT2 = fpr("ft2", RiscV64Regs.FT2), FT3 = fpr("ft3", RiscV64Regs.FT3);
	def FT4 = fpr("ft4", RiscV64Regs.FT4), FT5 = fpr("ft5", RiscV64Regs.FT5), FT6 = fpr("ft6", RiscV64Regs.FT6), FT7 = fpr("ft7", RiscV64Regs.FT7);
	def FS0 = fpr("fs0", RiscV64Regs.FS0), FS1 = fpr("fs1", RiscV64Regs.FS1);
	def FA0 = fpr("fa0", RiscV64Regs.FA0), FA1 = fpr("fa1", RiscV64Regs.FA1), FA2 = fpr("fa2", RiscV64Regs.FA2), FA3 = fpr("fa3", RiscV64Regs.FA3);
	def FA4 = fpr("fa4", RiscV64Regs.FA4), FA5 = fpr("fa5", RiscV64Regs.FA5), FA6 = fpr("fa6", RiscV64Regs.FA6), FA7 = fpr("fa7", RiscV64Regs.FA7);
	def FS2 = fpr("fs2", RiscV64Regs.FS2), FS3 = fpr("fs3", RiscV64Regs.FS3), FS4 = fpr("fs4", RiscV64Regs.FS4), FS5 = fpr("fs5", RiscV64Regs.FS5);
	def FS6 = fpr("fs6", RiscV64Regs.FS6), FS7 = fpr("fs7", RiscV64Regs.FS7), FS8 = fpr("fs8", RiscV64Regs.FS8), FS9 = fpr("fs9", RiscV64Regs.FS9);
	def FS10 = fpr("fs10", RiscV64Regs.FS10), FS11 = fpr("fs11", RiscV64Regs.FS11);
	def FT8 = fpr("ft8", RiscV64Regs.FT8), FT9 = fpr("ft9", RiscV64Regs.FT9), FT10 = fpr("ft10", RiscV64Regs.FT10), FT11 = fpr("ft11", RiscV64Regs.FT11);

	def physRegs = cursor;

	def RESERVED = unalloc("{reserved}");

	// Argument registers come last so they are not preferentially allocated.
	def GPR_CLASS = set("{gpr}", [
		S0, S1, S2, S3, S4, S5, S6, S7, S8, S9, S10, S11,
		T0, T1, T2,
		A0, A1, A2, A3, A4, A5, A6, A7
	]);
	def FPR_CLASS = set("{fpr}", [
		FS0, FS1, FS2, FS3, FS4, FS5, FS6, FS7, FS8, FS9, FS10, FS11,
		FT0, FT1, FT2, FT3, FT4, FT5, FT6, FT7, FT8, FT9, FT10,
		FA0, FA1, FA2, FA3, FA4, FA5, FA6, FA7
	]);

	def ALL = set("{all}", Arrays.concat(regSets[GPR_CLASS], regSets[FPR_CLASS]));

	// Scratch registers, with distinct roles so their uses never overlap in one sequence.
	def ADDR_GPR = T3;		// stack slot addresses beyond the 12-bit offset range
	def SCRATCH_GPR = T4;		// general scratch, parallel-move temporary
	def JALR_GPR = T5;		// indirect call target, live from argument setup until the jalr
	def FLOAT_CONST_GPR = T6;	// bits of float constants, float stack-to-stack moves
	def SCRATCH_FPR = FT11;		// float parallel-move temporary, float rounding
	def SCRATCH = set("{scratch}", [T3, T4, T5, T6]);

	def CALLER_SPILL_START = 100000000;
	def CALLEE_SPILL_START = 200000000;

	private var regClasses = mapRegClasses([
		(RegClass.REF, GPR_CLASS),
		(RegClass.I32, GPR_CLASS),
		(RegClass.I64, GPR_CLASS),
		(RegClass.F32, FPR_CLASS),
		(RegClass.F64, FPR_CLASS)
	]);

	private var scratch = mapRegClasses([
		(RegClass.REF, T4),
		(RegClass.I32, T4),
		(RegClass.I64, T4),
		(RegClass.F32, FT11),
		(RegClass.F64, FT11)
	]);

	def SET = MachRegSet.new(physRegs, regSets, regNames, regClasses, scratch,
		CALLER_SPILL_START, CALLEE_SPILL_START);

	private def gpr(name: string, r: RiscV64Gpr) -> byte {
		def loc = byte.view(cursor++), i = loc - gprStart;
		locToGprArr[i] = r;
		regSets[loc] = [loc];
		regNames[loc] = name;
		return loc;
	}
	private def fpr(name: string, r: RiscV64Fpr) -> byte {
		def loc = byte.view(cursor++), i = loc - fprStart;
		locToFprArr[i] = r;
		regSets[loc] = [loc];
		regNames[loc] = name;
		return loc;
	}
	private def unalloc(name: string) -> byte {
		def loc = byte.view(cursor++);
		regSets[loc] = [loc];
		regNames[loc] = name;
		return loc;
	}
	private def set(name: string, a: Array<byte>) -> byte {
		def loc = byte.view(cursor++);
		regSets[loc] = a;
		regNames[loc] = name;
		return loc;
	}
	private def mapRegClasses(v: Array<(RegClass, byte)>) -> Array<byte> {
		def result = Array<byte>.new(5); // XXX: number of reg classes
		for (t in v) result[t.0.tag] = t.1;
		return result;
	}
	def toGpr(loc: int) -> RiscV64Gpr {
		def rel = loc - ZERO;
		return if(u32.view(rel) < locToGprArr.length, locToGprArr[rel]);
	}
	def toFpr(loc: int) -> RiscV64Fpr {
		def rel = loc - FT0;
		return if(u32.view(rel) < locToFprArr.length, locToFprArr[rel]);
	}
}

// Defines the standard parameter and return registers for calls between Virgil methods.
component RiscV64VirgilCallConv {
	def R: RiscV64RegSet;
	def PARAM_GPRS = [RiscV64RegSet.A0, RiscV64RegSet.A1, RiscV64RegSet.A2, RiscV64RegSet.A3,
		RiscV64RegSet.A4, RiscV64RegSet.A5, RiscV64RegSet.A6, RiscV64RegSet.A7];
	def PARAM_FPRS = [RiscV64RegSet.FA0, RiscV64RegSet.FA1, RiscV64RegSet.FA2, RiscV64RegSet.FA3,
		RiscV64RegSet.FA4, RiscV64RegSet.FA5, RiscV64RegSet.FA6, RiscV64RegSet.FA7];
	def RET_GPRS = [RiscV64RegSet.A0, RiscV64RegSet.A1, RiscV64RegSet.A2, RiscV64RegSet.A3];
	def RET_FPRS = [RiscV64RegSet.FA0, RiscV64RegSet.FA1];

	private def compute(mach: MachProgram, paramTypes: Array<Type>, returnTypes: Array<Type>) -> MachCallConv {
		def pt = alloc(mach, paramTypes, PARAM_GPRS, PARAM_FPRS);
		def ploc = pt.0, pspill = pt.1;
		def rt = alloc(mach, returnTypes, RET_GPRS, RET_FPRS);
		var rloc = rt.0, rspill = rt.1;
		if (returnTypes.length == 0) rloc = [RET_GPRS[0]]; // TODO: workaround for 0-length returns
		if (pspill > rspill) rspill = pspill;
		return MachCallConv.new(R.SET, paramTypes, ploc, returnTypes, rloc, rspill);
	}
	def alloc(mach: MachProgram, types: Array<Type>, gpr: Array<byte>, fpr: Array<byte>) -> (Array<int>, int) {
		def S = R.SET.spillStart;
		def loc = Array<int>.new(types.length);
		var pspill = 0, iprm = 0, fprm = 0;
		for (i < loc.length) {
			match (mach.toRegClass(types[i])) {
				I32, REF, I64 => {
					if (iprm < gpr.length) loc[i] = gpr[iprm++];
					else loc[i] = S + pspill++;
				}
				F32, F64 => {
					if (fprm < fpr.length) loc[i] = fpr[fprm++];
					else loc[i] = S + pspill++;
				}
			}
		}
		return (loc, pspill);
	}
	def getForGraph(mach: MachProgram, graph: SsaGraph) -> MachCallConv { // XXX: put Signature in SsaGraph
		return compute(mach, Arrays.map(graph.params, SsaParam.vtype), Tuple.toTypeArray(graph.returnType));
	}
	def getForFunc(mach: MachProgram, funcRep: Mach_FuncRep) -> MachCallConv {
		if (funcRep.callConv != null) return funcRep.callConv;
		return funcRep.callConv = compute(mach, funcRep.paramTypes, funcRep.returnTypes);
	}
	def getForTypes(mach: MachProgram, paramTypes: Array<Type>, returnTypes: Array<Type>) -> MachCallConv {
		return compute(mach, paramTypes, returnTypes);
	}
}
