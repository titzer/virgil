// Optimizes SSA graphs, blocks, and individual instructions, performing such optimizations
// as const folding, strength reduction, load elimination, bounds check elimination, and
// control flow optimizations. Individual instructions can be optimized either in a pass over
// a graph or as an {SsaBuilder} adds them.
class SsaOptimizer(context: SsaContext) extends SsaInstrVisitor {
	var optimize_loads = true;		// activates load elimination
	var optimize_nullchecks = true;		// activates null check elimination
	var optimize_inits = false;		// activates init elimination
	var optimize_bounds = true;
	var remove_pure_ops = true;
	var fold_pure_ops = true;
	var fold_foldable_ops = true;
	var ssa: SsaBuilder;			// inserts new instructions before the current instruction
	var state: SsaBlockState;		// flow-sensitive state, managed by the user; {null} if none
	var foldingArgs: FoldingArguments;
	var result: SsaInstr;			// replacement for the current instruction
	var m: SsaInstrMatcher;			// matcher for reductions, allocated on demand
	var marker = SsaInternalMarker.new();
	var mark: int;				// mark for control flow optimization
	def queue = Vector<SsaBlock>.new();	// queue for control flow optimization

	def reset(graph: SsaGraph) {
		useGraph(graph);
		marker.reset(graph);
		context.graph = graph;
		context.block = null;
	}
	def optGraph() {
		useGraph(context.graph);
		marker.reset(context.graph);
		def queue = Vector<(SsaBlock, SsaBlockState)>.new();
		queue.put(context.graph.startBlock, SsaBlockState.new());
		var mark = marker.allocMark(context.graph.startBlock);
		for (i < queue.length) {
			var t = queue[i], block = t.0;
			state = t.1;
			if (block.facts.O_KILLED) continue;
			reduceBlock(block);
			var succs = block.succs();
			for (s in succs) {
				var d = s.dest;
				if (marker.getMark(d) < 0) {
					var dstate: SsaBlockState;
					if (succs.length == 1) dstate = if(s.dest.preds.length == 1, state, state.clear());
					else dstate = if(s.dest.preds.length == 1, state.copy(), SsaBlockState.new());
					queue.put(d, dstate);
					marker.setMark(d, mark);
				}
			}
		}
		checkAndPruneGraph();

		if (context.compiler.LoopInvariantCodeMotion) { 
			def l = SsaLoopOptimizer.new(context.graph, null, null, null, context);
			l.licm(); 
		}
	}
	def checkAndPruneGraph() {
		var print = context.shouldPrintOpt();
		marker.reset(context.graph);
		def reachable = Vector<SsaBlock>.new();
		reachable.put(context.graph.startBlock);
		marker.setMark(context.graph.startBlock, 0);
		// Mark everything reachable from start, numbering blocks in breadth-first order.
		for (i < reachable.length) {
			var block = reachable[i];
			if (print) Terminal.put1("block #%d\n", block.uid);
			var succs = block.succs();
			var end = block.end();
			if (end == null) {
				context.fail1("block #%d has no end", block.uid);
				continue;
			}
			marker.setMark(end, 0);
			for (s in succs) {
				var d = s.dest;
				if (marker.getMark(d) < 0) {
					if (print) Terminal.put1(" succ #%d\n", d.uid);
					marker.setMark(d, u31.!(reachable.length));
					reachable.put(d);
				}
			}
		}
		// Prune off unreachable predecessors and uses.
		for (i < reachable.length) {
			var block = reachable[i], j = 0;
			while (j < block.preds.length) {
				var pred = block.preds[j];
				if (marker.getMark(pred.src) < 0) {
					if (context.shouldPrintOpt()) Terminal.put2("  remove edge #%d -> #%d\n", pred.src.uid, pred.dest.uid);
					Ssa.removeEdge(pred, true);
				}
				else j++;
			}
		}
		if (remove_pure_ops) eliminateDeadCode(reachable);
	}
	// Remove or reduce instructions with no live uses.
	def eliminateDeadCode(blocks: Vector<SsaBlock>) {
		for (k < blocks.length) {
			var block = blocks[k], preds = block.preds;
			for (j < preds.length) {
				var e = preds[j];
				if (e == null || marker.getMark(e.src.block()) < k) continue;
				// Conservatively mark the inputs to loop phi's backedges live.
				for (x = block.next; SsaPhi.?(x); x = x.next) {
					var i = (SsaPhi.!(x).inputs[j].dest);
					marker.setMark(i, 0);
				}
			}
		}
		for (k = blocks.length - 1; k >= 0; k--) {
			var block = blocks[k];
			for (x = block.prev; x != block; ) {
				var p = x.prev;
				sweep(x);
				x = p;
			}
		}
	}
	// Removes or reduces {i} if no live instruction uses it; otherwise marks its inputs as live.
	def sweep(i: SsaLink) {
		var inputs: Array<SsaDfEdge>;
		match (i) {
			x: SsaPhi => {
				inputs = x.inputs;
				if (marker.getMark(x) < 0) return void(killDead(x));
			}
			x: SsaApplyOp => {
				inputs = x.inputs;
				if (marker.getMark(x) < 0) {
					if (x.facts.O_PURE) return void(killDead(x));
					if (x.facts.O_FOLDABLE) {
						var r = reduceUnused(x);
						if (r == null) return;
						inputs = r.inputs; // replacement was inserted behind the sweep
					}
				}
			}
			// Debug uses don't keep inputs alive.
			x: SsaCheckpoint => 	return;
			x: SsaNewVar => 	return;
			x: SsaUpdateVar => 	return;
			// Otherwise, all inputs are live.
			x: SsaInstr => 		inputs = x.inputs;
		}
		for (e in inputs) marker.setMark(e.dest, 0);
	}
	// Reduces {i}, a foldable instruction whose value is unused, to only the checks it performs.
	// Returns {i} if it must be kept, {null} if it was removed, or the instruction that replaces it.
	def reduceUnused(i: SsaApplyOp) -> SsaInstr {
		match (i.op.opcode) {
			NullCheck => {
				if (nullCheckNeeded(i)) return i;
				killDead(i);
				return null;
			}
			ClassGetField(field) => return reduceToNullCheck(i);
			ClassGetMethod(method) => return reduceToNullCheck(i);
			ClassGetVirtual(method) => return reduceToNullCheck(i);
			ClassGetSelector(selector) => return reduceToNullCheck(i);
			ArrayGetLength => return reduceToNullCheck(i);
			_ => return i;
		}
	}
	def nullCheckNeeded(i: SsaApplyOp) -> bool {
		return !context.compiler.nullity(i, i.input0()).O_NO_NULL_CHECK;
	}
	// Replaces {i} with a null check of its receiver, if needed.
	def reduceToNullCheck(i: SsaApplyOp) -> SsaInstr {
		var check: SsaInstr;
		if (nullCheckNeeded(i)) {
			ssa.setPrev(i.prev);
			check = add(i.source, V3Op.newNullCheck(i.op.sig.paramTypes[0]), [i.input0()]);
		}
		killDead(i);
		return check;
	}
	// Kills {i}, which the sweep found dead. All non-debug uses must already have been swept away.
	def killDead(i: SsaInstr) -> SsaInstr {
		if (i.hasNonDebugUses()) context.fail1("dead instruction #%d has live uses", i.uid);
		return killUnused(i);
	}
	// Uses a new builder for insertions during a pass over {g}.
	def useGraph(g: SsaGraph) {
		ssa = SsaBuilder.new(context, g, null);
		ssa.opt = this;
	}
	// Returns {true} if a reduction has ended the current block with a throw.
	def end() -> bool {
		return ssa.end();
	}
	def reduceBlock(block: SsaBlock) {
		context.block = block;
		ssa.block = block;
		for (i = block.next; SsaInstr.?(i); ()) {
			var n = i.next;
			reduceInstr(SsaInstr.!(i));
			if (end()) break;
			// Optimizing a block end may have merged a successor block into this one.
			i = if(SsaEnd.?(i) && i.next == null, ssa.prev.next, n);
		}
	}
	def reduceInstr(i: SsaInstr) -> SsaInstr {
		ssa.setPrev(i.prev);
		result = i;
		visit(i);
		return result;
	}
	// Optimizes {i}, which {b} has just appended, and leaves {b} positioned after the result.
	def optAppended(b: SsaBuilder, i: SsaApplyOp) -> SsaInstr {
		ssa = b;
		b.setPrev(i.prev); // insert any new instructions before {i}
		var res = tryOptInstr(i);
		if (b.end()) return b.unreachable(i.getType()); // a throw killed {i}
		if (res == i && i.prev != null) {
			b.setPrev(i);
		} else { // replaced or killed
			i.kill();
			i.remove();
			if (res == null) res = ssa.graph.nop(); // e.g. a redundant Init
		}
		return res;
	}
	def visitApplyOp(i: SsaApplyOp) {
		var res = tryOptInstr(i);
		if (res != i) {
			i.replace(res);
			i.kill();
			i.remove();
		}
		result = res;
	}
	def visitPhi(i: SsaPhi) {
		var i0 = i.input0();
		if (!reducePhi(i)) result = i0;
	}
	def visitIf(i: SsaIf)	{ result = reduceIf(i); }
	def visitGoto(i: SsaGoto) {
		optEdge(i.block().succ(0));
	}
	def visitSwitch(i: SsaSwitch) {
		var val = i.input0();
		if (SsaConst.?(val)) {
			var block = i.block(), succ = i.findSucc(SsaConst.!(val).val);
			replaceWithGoto(block, i, succ);
			optEdge(block.succ(0));
		}
	}
	def reduceIf(ifi: SsaIf) -> SsaInstr {
		var cond = ifi.input0(), block = ifi.block();
		if (SsaConst.?(cond)) {
			replaceWithGoto(block, ifi, block.succ(if(cond.unbox<bool>(), 0, 1)));
			optEdge(block.succ(0));
		} else if (SsaApplyOp.?(cond)) {
			if (SsaApplyOp.!(cond).op.opcode == Opcode.BoolNot) {
				var cc = cond.input0();
				ifi.succs = [ifi.succs[1], ifi.succs[0]];
				ifi.inputs[0].update(cc);
				return ifi;
			}
			// XXX: optimize if(x == true|false) and if(x != true|false)
		}
		return ifi;
	}
	// Tries to optimize {i}, first by constant folding, then by reduction, and then by CSE.
	// Returns {i} or the instruction that replaces it.
	def tryOptInstr(i: SsaApplyOp) -> SsaInstr {
		var r = tryFold(i);
		if (r != null) return r;
		if (remove_pure_ops && i.facts.O_PURE && !i.hasNonDebugUses()) return killUnused(i);
		r = tryReduce(i);
		if (r != i) return r;
		return tryCSE(i);
	}
	// Tries to evaluate {i} if its inputs are constants. Returns {null} on failure.
	def tryFold(i: SsaApplyOp) -> SsaInstr {
		if (i.facts.O_PURE) {
			if (fold_pure_ops) return tryEval(i);
		} else if (i.facts.O_FOLDABLE) {
			if (fold_foldable_ops) return tryEval(i);
		}
		return null;
	}
	// Tries to reduce {i} to a simpler form through its opcode's visit method.
	def tryReduce(i: SsaApplyOp) -> SsaInstr {
		if (m == null) m = SsaInstrMatcher.new();
		result = app = i;
		visitOp(i.op);
		return result;
	}
	// Tries to replace {i} with an equivalent instruction that dominates it.
	def tryCSE(i: SsaApplyOp) -> SsaInstr {
		return i; // TODO: common subexpression elimination
	}
	// Replaces the current instruction with {i}.
	def reduceTo(i: SsaInstr) { result = i; }
	def visitBoolEq(opcode: Opcode.BoolEq)	{ reduceEq(); }
	def visitBoolAnd(opcode: Opcode.BoolAnd) {
		norm_binop(app);
		if (m.fold) return reduceTo(ssa.graph.boolConst(Bool.unbox(m.xval) && Bool.unbox(m.yval))); // K && K => K
		if (m.yconst) return reduceTo(if(Bool.unbox(m.yval), m.x, ssa.graph.falseConst())); // x && K => x
	}
	def visitBoolOr(opcode: Opcode.BoolOr) {
		norm_binop(app);
		if (m.fold) return reduceTo(ssa.graph.boolConst(Bool.unbox(m.xval) || Bool.unbox(m.yval))); // K || K => K
		if (m.yconst) return reduceTo(if(Bool.unbox(m.yval), ssa.graph.trueConst(), m.x));  // x || K => x
	}
	def visitBoolNot(opcode: Opcode.BoolNot) {
		var xval = m.unop(app);
		if (m.xconst) return reduceTo(ssa.graph.boolConst(!Bool.unbox(xval)));  // !K  => K
		if (m.x.optag() == Opcode.BoolNot.tag) return reduceTo(m.x.input0());  // !!x => x
	}
	def visitIntEq(opcode: Opcode.IntEq, t: Type)	{ reduceEq(); }
	def visitIntAdd(opcode: Opcode.IntAdd, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.fold) return reduceTo(fold2i(int.+, long.+)); // K + K == K
		if (m.yzero) return reduceTo(m.x);                    // x + 0 == x
	}
	def visitIntSub(opcode: Opcode.IntSub, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.fold) return reduceTo(fold2i(int.-, long.-)); // K - K == K
		if (m.yzero) return reduceTo(m.x);                    // x - 0 == x
	}
	def visitIntMul(opcode: Opcode.IntMul, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.yzero) return reduceTo(m.y);                    // x * 0 == 0
		if (m.fold) return reduceTo(fold2i(int.*, long.*)); // K * K == K
		if (m.yconst) {
			if (m.yis(1)) return reduceTo(m.x);           // x * 1 == 1
			if (m.yis(-1)) return reduceTo(addBinop(m.inttype.opSub(), ssa.graph.nullConst(m.inttype), m.x));  // x * -1 == 0 - x
			if (m.yis(2)) return reduceTo(addBinop(m.inttype.opAdd(), m.x, m.x));
			if (m.yisPowerOf2()) {
				// x * 2^k == x << k
				return reduceTo(addBinop(m.inttype.opShl(), m.x, ssa.graph.intConst(m.ylog2())).setFact(Fact.O_NO_SHIFT_CHECK));
			}
		}
	}
	def visitIntDiv(opcode: Opcode.IntDiv, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.yzero) return reduceTo(addThrow(app.source, V3Exception.DivideByZero)); // fold x / 0
		if (m.fold) return reduceTo(fold4i(int./, u32./, long./, u64./));
		if (m.yconst) {
			app.facts |= Facts.O_SAFE_DIVIDE;
			if (m.yis(1)) return reduceTo(m.x);           // x / 1 == x
			if (m.yis(-1) && m.inttype.signed) return reduceTo(addBinop(m.inttype.opSub(), ssa.graph.nullConst(m.inttype), m.x)); // x / -1 == 0 - x
			if (m.yisPowerOf2() && m.x.facts.V_NON_NEGATIVE) {
				// x / 2^k == x >> k
				return reduceTo(addBinop(m.inttype.opShr(), m.x, ssa.graph.intConst(m.ylog2())).setFact(Fact.O_NO_SHIFT_CHECK));
			}
		}
	}
	def visitIntMod(opcode: Opcode.IntMod, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.yzero) return reduceTo(addThrow(app.source, V3Exception.DivideByZero)); // fold x % 0
		if (m.fold) return reduceTo(fold4i(int.%, u32.%, long.%, u64.%));
		if (m.yconst) {
			app.facts |= Facts.O_SAFE_DIVIDE;
			if (m.yis(1) || (m.yis(-1) && m.inttype.signed)) {
				// x % +/-1 == 0
				return reduceTo(if(m.wide, l_const(0), i_const(0)));
			}
			if (m.yisPowerOf2() && m.x.facts.V_NON_NEGATIVE) {
				// x % 2^k == x & (2^k - 1)
				var mask = if(m.wide, l_const(m.ylong - 1), i_const(yint - 1));
				return reduceTo(addBinop(m.inttype.opAnd(), m.x, mask).setFact(Fact.V_NON_NEGATIVE));
			}
		}
		if ((m.x.facts & m.y.facts & Fact.V_NON_NEGATIVE) == Fact.V_NON_NEGATIVE) app.facts |= Fact.V_NON_NEGATIVE;
	}
	def visitIntAnd(opcode: Opcode.IntAnd, it: IntType) {
		norm_intbinop(app);
		if (m.yzero) return reduceTo(m.y);                    // x & 0 == 0
		if (m.fold) return reduceTo(fold2i(int.&, long.&)); // K & K == K
		if (m.yconst && m.yis(-1)) return reduceTo(m.x);        // x & -1 == x
		// (nonneg & x) => nonneg
		app.facts |= ((m.x.facts | m.y.facts) & Fact.V_NON_NEGATIVE);
	}
	def visitIntOr(opcode: Opcode.IntOr, it: IntType) {
		norm_intbinop(app);
		if (m.yzero) return reduceTo(m.x);                    // x | 0 == x
		if (m.fold) return reduceTo(fold2i(int.|, long.|)); // K | K == K
		if (m.yconst && m.yis(-1)) return reduceTo(m.y);        // x | -1 == -1
		// (neg | x) => neg, (nonzero | x) => nonzero
		app.facts |= ((m.x.facts | m.y.facts) & (Fact.V_BELOW_ZERO | Fact.V_NON_ZERO));
	}
	def visitIntXor(opcode: Opcode.IntXor, it: IntType) {
		norm_intbinop(app);
		if (m.yzero) return reduceTo(m.x);                     // x ^ 0 == x
		if (m.x == m.y) return reduceTo(ssa.graph.nullConst(m.inttype));    // x ^ x == 0
		if (m.fold) return reduceTo(fold2i(int.^, long.^));  // K ^ K == K
		app.facts |= (m.x.facts & m.y.facts & Fact.V_NON_NEGATIVE);  // (nonneg ^ nonneg) => nonneg
		if ((m.x.facts & m.y.facts & Fact.V_BELOW_ZERO) == Fact.V_NON_NEGATIVE) app.facts |= Fact.V_NON_NEGATIVE;
	}
	// XXX: optimize x << (y & 0x1F) if target automatically masks shiftor values
	def visitIntShl(opcode: Opcode.IntShl, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.yzero) return reduceTo(m.x); // x << 0 == x
		if (m.fold) {          // K << K == K
			if (m.wide) {
				var y6 = u6.view(m.ylong);
				return reduceTo(if(m.ylong == y6, l_const(m.xlong << y6), ssa.graph.nullConst(m.inttype)));
			} else {
				var y5 = u5.view(yint);
				return reduceTo(if(yint == y5, i_const(m.xint << y5), ssa.graph.nullConst(m.inttype)));
			}
		}
		if (m.yconst) {
			if (m.yrange(0, m.inttype.width - 1)) app.facts |= Fact.O_NO_SHIFT_CHECK;
			else return reduceTo(ssa.graph.nullConst(m.inttype));
		} else {
			shiftcheck(app, m.y);
		}
	}
	// XXX: optimize x >> (y & 0x1F) if target automatically masks shiftor values
	def visitIntSar(opcode: Opcode.IntSar, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.yzero) return reduceTo(m.x);  // x >> 0 == x
		if (m.fold) {           // K >> K == K
			if (m.wide) {
				var y6 = u6.view(if(u64.view(m.ylong) > 63, 63, m.ylong));
				return reduceTo(l_const(m.xlong >> y6));
			} else {
				var y5 = u5.view(if(u32.view(yint) > 31, 31, yint));
				return reduceTo(i_const(m.xint >> y5));
			}
		}
		if (m.yconst) {
			if (!m.yrange(0, m.inttype.width - 1)) {
				if (m.x.facts.V_NON_NEGATIVE) return reduceTo(ssa.graph.nullConst(m.inttype));
				if (m.x.facts.V_BELOW_ZERO) return reduceTo(ssa.graph.intConst(-1));
				app.inputs[1].update(ssa.graph.intConst(m.inttype.width - 1));
			}
			app.facts |= Fact.O_NO_SHIFT_CHECK;
		} else {
			shiftcheck(app, m.y);
		}
	}
	// XXX: optimize x >>> (y & 0x1F) if target automatically masks shiftor values
	def visitIntShr(opcode: Opcode.IntShr, it: IntType) {
		var yint = norm_intbinop(app);
		if (m.yzero) return reduceTo(m.x); // x >>> 0 = x
		if (m.fold) {          // K >>> K = K
			if (m.wide) {
				var y6 = u6.view(m.ylong);
				if (m.ylong == y6) return reduceTo(l_const(Eval.doIntTruncU64(m.inttype, m.xlong) >>> y6));
				return reduceTo(ssa.graph.nullConst(m.inttype));
			} else {
				var y5 = u5.view(yint);
				if (yint == y5) return reduceTo(i_const(Eval.doIntTruncU32(m.inttype, m.xint) >>> y5));
				return reduceTo(ssa.graph.nullConst(m.inttype));
			}
		}
		if (m.yconst) {
			if (m.yrange(0, m.inttype.width - 1)) app.facts |= Fact.O_NO_SHIFT_CHECK;
			else return reduceTo(ssa.graph.nullConst(m.inttype));
		} else {
			shiftcheck(app, m.y);
		}
		if (m.y.facts.V_NON_ZERO) app.facts |= Fact.V_NON_NEGATIVE;
	}
	def visitIntLt(opcode: Opcode.IntLt, it: IntType) {
		norm_intbinop(app);
		// XXX: range analysis for comparisons against constants, particularly 0
		if (m.fold) return reduceTo(fold4b(int.<, u32.<, long.<, u64.<));
	}
	def visitIntLteq(opcode: Opcode.IntLteq, it: IntType) {
		norm_intbinop(app);
		// XXX: range analysis for comparisons against constants, particularly 0
		if (m.fold) return reduceTo(fold4b(int.<=, u32.<=, long.<=, u64.<=));
	}
	def visitFloatEq(opcode: Opcode.FloatEq, ft: FloatType) {
		norm_binop(app);
		if (m.xconst && Float.isNan(m.xval)) return reduceTo(ssa.graph.falseConst()); // nan == y == false
		if (m.yconst && Float.isNan(m.yval)) return reduceTo(ssa.graph.falseConst()); // x == nan == false
	}
	def visitFloatNe(opcode: Opcode.FloatNe, ft: FloatType) {
		norm_binop(app);
		if (m.xconst && Float.isNan(m.xval)) return reduceTo(ssa.graph.trueConst()); // nan != y == true
		if (m.yconst && Float.isNan(m.yval)) return reduceTo(ssa.graph.trueConst()); // x != nan == true
	}
	def visitIntViewI(opcode: Opcode.IntViewI, ft: IntType, tt: IntType) {
		var xval = m.unop(app);
		if (m.xconst) return reduceTo(ssa.graph.valConst(tt, Eval.doIntView(ft, tt, xval)));
	}
	def visitRefEq(opcode: Opcode.RefEq, t: Type)	{ reduceEq(); }
	def visitTupleCreate(opcode: Opcode.TupleCreate, tt: TupleType) {
		if (op.isPolymorphic()) return;
		m.n_op(app);
		if (!m.fold) return;
		// (K, ..., K) => K
		var inputs = app.inputs;
		var vals = Array<Val>.new(inputs.length);
		for (j < inputs.length) vals[j] = SsaConst.!(inputs[j].dest).val;
		return reduceTo(ssa.graph.valConst(op.sig.returnType(), BoxVal.new(vals)));
	}
	def visitTupleGetElem(opcode: Opcode.TupleGetElem, tt: TupleType) {
		var xval = m.unop(app);
		if (m.xconst) {
			// fold K.N
			var val = BoxVal.!(xval), t = Lists.get(tt.nested, opcode.index);
			return reduceTo(ssa.graph.valConst(t, if(val != null, val.values[opcode.index], null)));
		}
		if (m.x.optag() == Opcode.TupleCreate.tag) {
			// TupleGetElem[n](x:TupleCreate(...)) => x[n]
			return reduceTo(SsaApplyOp.!(m.x).inputs[opcode.index].dest);
		}
	}
	def visitArrayAlloc(opcode: Opcode.ArrayAlloc, at: ArrayType) {
		var len = app.input0();
		if (len.facts.V_NON_NEGATIVE) app.facts |= Fact.O_NO_NEGATIVE_CHECK;
		if (remove_pure_ops && app.useList == null) { // unused array allocation
			if (!app.facts.O_NO_NEGATIVE_CHECK) {
				var op = IntType.!(len.getType()).opLt();
				var check = addBinop(op, len, ssa.graph.zeroConst());
				return reduceTo(addConditionalThrow(app.source, V3Exception.LengthCheck, check));
			}
			return reduceTo(killUnused(app));
		}
		if (state != null) state.init(app, ARRAY_LENGTH_FIELD, app.input0());
	}
	def visitArrayInit(opcode: Opcode.ArrayInit, at: ArrayType) {
		if (op.isPolymorphic()) return;
		m.n_op(app);
		if (remove_pure_ops && app.useList == null) return reduceTo(killUnused(app)); // unused empty array init
		if (true || !m.fold) return; // TODO: can fold array init if identity not observed
		var record = context.prog.newRecord(at, app.inputs.length);
		for (j < app.inputs.length) record.values[j] = SsaConst.!(app.inputs[j].dest).val;
		return reduceTo(ssa.graph.recordConst(record));
	}
	def visitArrayGetElem(opcode: Opcode.ArrayGetElem, at: ArrayType, it: IntType) {
		var receiver = boundscheck(app);
		if (end()) return reduceTo(receiver);
		if (!app.facts.O_PURE) return;
		var yval = norm_binop(app);
		// ArrayGetElem(#array, #index) => K
		var values: Array<Val>;
		match (m.xval) {
			x: Record => values = x.values;
			x: Address<Record> => values = x.val.values;
			_ => ;
		}
		if (m.fold) return reduceTo(ssa.graph.valConst(app.getType(), values[V3.unboxI32(yval)]));
	}
	def visitArraySetElem(opcode: Opcode.ArraySetElem, at: ArrayType, it: IntType, et: Type) {
		var receiver = boundscheck(app);
		if (end()) return reduceTo(receiver);
		if (optimize_loads && state != null) state.killArrayElems();
	}
	def visitArraySetElemElem(opcode: Opcode.ArraySetElemElem, at: ArrayType, it: IntType, et: Type)	{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitArrayGetLength(opcode: Opcode.ArrayGetLength, at: ArrayType) {
		var receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		var xval = m.unop(app);
		if (m.xconst) return reduceTo(ssa.graph.intConst(Record.!(xval).values.length));
		if (receiver.optag() == Opcode.ArrayInit.tag) {
			// ArrayGetLength(ArrayInit(...)) => |...|
			return reduceTo(ssa.graph.intConst(receiver.inputs.length));
		}
		if (receiver.optag() == Opcode.ArrayAlloc.tag) {
			// ArrayGetLength(ArrayAlloc(x)) => x
			return reduceTo(receiver.input0());
		}
		if (optimize_loads && state != null) return reduceTo(state.load(receiver, ARRAY_LENGTH_FIELD, app));
	}
	def visitRangeSetElem(opcode: Opcode.RangeSetElem, rt: RangeType, it: IntType, et: Type)	{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitNormRangeSetElem(opcode: Opcode.NormRangeSetElem, at: ArrayType, it: IntType)		{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitNormRangeSetElemElem(opcode: Opcode.NormRangeSetElemElem, at: ArrayType, it: IntType)	{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitInit(opcode: Opcode.Init) {
		if (!optimize_inits || state == null) return;
		for (l = state.inits; l != null; l = l.tail) {
			if (l.head == opcode.method) return reduceTo(null);  // init[m]; init[m] => init[m]
		}
		state.inits = List.new(opcode.method, state.inits);
	}
	def visitComponentGetField(opcode: Opcode.ComponentGetField, ct: ComponentType) {
		var sf = VstField.!(opcode.field.source);
		if (sf != null && sf.writability == Writability.READ_ONLY) {
			if (Literal.?(sf.init)) {  // C.f => K
				var lit = Literal.!(sf.init);
				var const = ssa.graph.valConst(lit.exactType, lit.val);
				return reduceTo(if(lit.exactType != opcode.field.fieldType, convert(const, opcode.field.fieldType), const));
			}
		}
		if (optimize_loads && state != null) return reduceTo(state.load(null, opcode.field, app));
	}
	def visitComponentSetField(opcode: Opcode.ComponentSetField, ct: ComponentType) {
		if (optimize_loads && state != null) state.store(null, opcode.field, app, app.input1());  // forward stores
	}
	def visitClassAlloc(opcode: Opcode.ClassAlloc, ct: ClassType) {
		if (remove_pure_ops && app.useList == null) return reduceTo(killUnused(app)); // unused empty alloc
	}
	def visitClassNew(opcode: Opcode.ClassNew, ct: ClassType) {
		if (!app.facts.O_PURE && state != null) state.kill(); // XXX: Fact.O_NO_SIDEFFECT
	}
	def visitClassGetField(opcode: Opcode.ClassGetField, ct: ClassType) {
		// XXX: optimize ClassGetField[descriptor](ClassAlloc(x, ...) => x
		var receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		if (opcode.field.isConst()) {
			if (SsaConst.?(receiver)) {
				// ClassGetField(#K) => #K
				var record = asRecord(receiver);
				var ftype = opcode.field.fieldType;
				if (ftype.open()) ftype = IrSpec.new(record.rtype, TypeUtil.NO_TYPES, opcode.field).getFieldType();
				return reduceTo(ssa.graph.valConst(ftype, record.values[opcode.field.index]));
			}
			app.setFactIf(Fact.O_NO_NULL_CHECK, Fact.O_PURE);
			app.facts |= Fact.O_FOLDABLE;
			if (remove_pure_ops && app.facts.O_PURE && app.useList == null) return reduceTo(killUnused(app));
		}
		if (optimize_loads && state != null) return reduceTo(state.load(receiver, opcode.field, app));
	}
	def visitClassInitField(opcode: Opcode.ClassInitField, ct: ClassType) {
		app.facts |= Fact.O_NO_NULL_CHECK;
		if (optimize_loads && state != null) state.init(app.input0(), opcode.field, app.input1());  // forward stores
	}
	def visitClassSetField(opcode: Opcode.ClassSetField, ct: ClassType) {
		var receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		if (optimize_loads && state != null) state.store(receiver, opcode.field, app, app.input1());  // forward stores
	}
	def visitClassGetMethod(opcode: Opcode.ClassGetMethod, meth: IrSpec) {
		var receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		if (op.isPolymorphic()) return;
		var xval = m.unop(app);
		if (m.xconst) {
			// ClassGetMethod[m](#K) => (m, #K)
			var obj = Record.!(xval);
			return reduceTo(ssa.graph.valConst(meth.getBoundType(), Closure.new(obj, meth)));
		}
	}
	def visitClassGetVirtual(opcode: Opcode.ClassGetVirtual, meth: IrSpec) {
		var receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		var dv = devirtualize(meth, receiver);
		if (dv != null) {
			var xval = m.unop(app);
			if (m.xconst && !op.isPolymorphic()) {  // ClassGetVirtual[m](K) => (m, K)
				var obj = Record.!(xval);
				return reduceTo(ssa.graph.valConst(dv.getBoundType(), Closure.new(obj, dv)));
			}
			return reduceTo(replaceOp(app, V3Op.newClassGetMethod(dv)));  // ClassGetVirtual[m](K) => ClassGetMethod[m](K)
		}
	}
	// XXX: combine with ClassGetVirtual
	def visitClassGetSelector(opcode: Opcode.ClassGetSelector, meth: IrSpec) {
		var receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		var dv = devirtualize(meth, receiver);
		if (dv != null) {
			var val = if(!dv.member.flags.M_UNREACHABLE, FuncVal.new(dv));
			return reduceTo(ssa.graph.valConst(dv.getFuncType(), val));
		}
	}
	def visitVariantEq(opcode: Opcode.VariantEq, vt: ClassType) {
		norm_binop(app);
		if (m.fold) return reduceTo(ssa.graph.boolConst(Values.equal(m.xval, m.yval)));
		// XXX: look through type casts and subsumes for VariantEq
		var and = m.x.facts & m.y.facts, or = m.x.facts | m.y.facts;
		if (Facts.NONE != (and & Fact.V_ZERO)) return reduceTo(ssa.graph.trueConst()); // 0 == 0 == true
	}
	def visitVariantGetTag(opcode: Opcode.VariantGetTag, vt: ClassType) {
		var xval = m.unop(app);
		if (m.fold) {
			// GetVariantTag(#K) => #K
			if (Record.?(xval)) return reduceTo(ssa.graph.intConst(V3.getVariantTag(Record.!(xval).rtype)));
			return reduceTo(ssa.graph.intConst(V3.unboxI32(xval)));
		}
	}
	def visitVariantAlloc(opcode: Opcode.VariantAlloc, vt: ClassType) {
		if (op.isPolymorphic()) return;
		m.n_op(app);
		if (!m.fold) return;
		// VariantAlloc(#K, #K ..) => #K (variant)
		var ic = context.prog.ir.getIrClass(vt);
		if (ic == null) return;  // TODO: can occur for closure classes
		var record = context.prog.newRecord(vt, ic.fields.length);
		if (ic.fields.length != app.inputs.length) {
			// Ugly, adapt for tuple arity mismatch
			if (app.inputs.length == 1) {
				var v = BoxVal.!(SsaConst.!(app.inputs[0].dest).val);
				for (j < record.values.length) record.values[j] = v.values[j];
			} else if (ic.fields.length == 1) {
				var values = Array<Val>.new(app.inputs.length);
				if (app.inputs.length > 0) {
					for (j < app.inputs.length) values[j] = SsaConst.!(app.inputs[j].dest).val;
					record.values[0] = BoxVal.new(values);
				}
			} else {
				return; // TODO: arity mismatch should never happen, but conservatively don't fold.
			}
		} else {
			for (j < app.inputs.length) record.values[j] = SsaConst.!(app.inputs[j].dest).val;
		}
		if (ic != null) ic.flags |= IrFlag.C_HEAP;
		return reduceTo(ssa.graph.recordConst(record));
	}
	def visitVariantGetField(opcode: Opcode.VariantGetField, vt: ClassType) {
		var receiver = app.input0();
		if (end()) return reduceTo(receiver);
		if (SsaConst.?(receiver)) {
			// VariantGetField(#K) => #K
			var record = asRecord(receiver);
			var ftype = opcode.field.fieldType;
			if (ftype.open()) ftype = IrSpec.new(record.rtype, TypeUtil.NO_TYPES, opcode.field).getFieldType();
			return reduceTo(ssa.graph.valConst(ftype, if(record != null, record.values[opcode.field.index])));
		}
		if (!opcode.field.flags.F_POINTED_AT) app.facts |= Fact.O_PURE;
		if (receiver.optag() == Opcode.VariantAlloc.tag) {
			// VariantGetField[n](x:VariantAlloc(...)) => x[n]
			var r = SsaApplyOp.!(receiver);
			var ic = context.prog.ir.getIrClass(vt);
			// Ugly: avoid arity mismatch problems for tuple/void fields
			if (ic != null && r.inputs.length == ic.fields.length) return reduceTo(r.inputs[opcode.field.index].dest);
		}
		if (optimize_loads && state != null) return reduceTo(state.load(receiver, opcode.field, app));
	}
	def visitVariantGetMethod(opcode: Opcode.VariantGetMethod, meth: IrSpec) {
		var receiver = app.input0();
		if (op.isPolymorphic()) return;
		var xval = m.unop(app);
		if (m.xconst) {
			// VariantGetMethod[m](#K) => (m, #K)
			var obj = Record.!(xval);
			var val = if(!meth.member.flags.M_UNREACHABLE, Closure.new(obj, meth));
			return reduceTo(ssa.graph.valConst(meth.getBoundType(), val));
		}
	}
	// XXX: also optimize VariantGetSelector
	def visitVariantGetVirtual(opcode: Opcode.VariantGetVirtual, meth: IrSpec) {
		var receiver = app.input0();
		var dv = devirtualize(meth, receiver);
		if (dv != null) {
			var xval = m.unop(app);
			if (m.xconst && !op.isPolymorphic()) {  // VariantGetVirtual[m](K) => (m, K)
				var obj = Record.!(xval);
				var val = if(!dv.member.flags.M_UNREACHABLE, Closure.new(obj, dv));
				return reduceTo(ssa.graph.valConst(dv.getBoundType(), val));
			}
			return reduceTo(replaceOp(app, V3Op.newCreateClosure(dv, op.typeArgs[0])));  // VariantGetVirtual[m](K) => CreateClosure[m](K)
		}
	}
	def visitNullCheck(opcode: Opcode.NullCheck, t: Type) {
		var receiver = nullcheck(app);
		if (app.facts.O_NO_NULL_CHECK) return reduceTo(receiver);
	}
	def visitBoundsCheck(opcode: Opcode.BoundsCheck, t: Type) {
		var receiver = boundscheck(app);
		if (end()) return reduceTo(receiver);
		if (app.checkFact(Facts.O_SAFE_BOUNDS)) return reduceTo(Ssa.killInstr(app));
	}
	def visitConditionalThrow(opcode: Opcode.ConditionalThrow) {
		var xval = m.unop(app);
		if (!m.fold) return;
		// ConditionalThrow(#K) => throw | nop
		if (Bool.unbox(xval)) return reduceTo(addThrow(app.source, opcode.exception));
		else return reduceTo(Ssa.killInstr(app));
	}
	def visitOverloadedEq(opcode: Opcode.OverloadedEq, t: Type) {
		norm_binop(app);
		if (m.fold) return reduceTo(ssa.graph.boolConst(Values.equal(m.xval, m.yval)));
		var and = m.x.facts & m.y.facts;
		if (Facts.NONE != (and & Fact.V_ZERO)) return reduceTo(ssa.graph.trueConst()); // 0 == 0 == true
		// XXX: look through type casts subsumes for OverloadedEq
	}
	def visitTypeCast(opcode: Opcode.TypeCast, f: Type, t: Type) {
		var ft = op.sig.paramTypes[0], tt = op.sig.returnType();
		if (ft == tt) return reduceTo(app.input0());
		var cast = TypeSystem.newTypeCast(ft, tt);
		if (CLOptions.PRINT_WRAP_EXTRA.get()) {
			FunctionWrapping.printWrap()
				.put3("SsaOptimizer TypeCast from %q  to %q  cast %s", ft.render, tt.render, cast.name)
				.put2("  xconst %z  # inputs %d", m.xconst, app.inputs.length).outln();
		}
		if (app.inputs.length == 0) {
			// special cast of casting void -> X
			if (cast == TypeCast.THROW) return reduceTo(addThrow(app.source, V3Exception.TypeCheck)); // fold TypeCast
			return;
		}
		var xval = m.unop(app);
		if (m.xconst && cast != TypeCast.UNKNOWN_CAST) {
			var r = Eval.doCast(cast, ft, tt, xval);
			if (r.0) return reduceTo(ssa.graph.valConst(tt, r.1));
			else return reduceTo(addThrow(app.source, V3Exception.TypeCheck));
		}

		// TODO consider using TypeSystem.computeCast
		match (cast) {
			TRUE, SUBSUME => {
				if (context.compiler.NormConfig.WrapFuncTypeSubsume && Function_TypeCon.?(tt.typeCon)) return;
				return reduceTo(m.x); // fold TypeCast
			}
			THROW => {
				return reduceTo(addThrow(app.source, V3Exception.TypeCheck)); // fold TypeCast
			}
			THROW_IF_NOT_NULL => {
				// TypeCast -> ConditionalThrow(x != null)
				var cmp = addNot(addEqual(ft, m.x, ssa.graph.nullConst(ft)));
				addConditionalThrow(app.source, V3Exception.TypeCheck, cmp);
				return reduceTo(ssa.graph.nullConst(tt));
			}
			INT_VIEW_I => {
				return reduceTo(replaceOp(app, V3Op.newIntViewI(ft, tt)));
			}
			ENUM_TO_SET => {
				return reduceTo(addEnumToSet(EnumSetType.!(tt), m.x));
			}
			_ => {
				if (m.x.facts.V_NON_ZERO) {
					app.facts |= Fact.O_NO_NULL_CHECK | Fact.V_NON_ZERO;
				}
			}
		}
	}
	def visitTypeQuery(opcode: Opcode.TypeQuery, ft: Type, tt: Type) {
		var query = TypeSystem.newTypeQuery(ft, tt);
		if (app.inputs.length == 0) {
			// special cast of querying void -> X
			if (query == TypeQuery.TRUE) return reduceTo(ssa.graph.trueConst());
			if (query == TypeQuery.FALSE) return reduceTo(ssa.graph.falseConst());
			return;
		}
		var xval = m.unop(app);
		if (m.xconst && query != TypeQuery.UNKNOWN_QUERY) {
			return reduceTo(ssa.graph.boolConst(Eval.doQuery(query, ft, tt, xval)));
		}
		if (query == TypeQuery.TRUE) return reduceTo(ssa.graph.trueConst());
		if (query == TypeQuery.FALSE) return reduceTo(ssa.graph.falseConst());
		if (query == TypeQuery.TRUE_IF_NOT_NULL) return reduceTo(addNotEqual(ft, m.x, ssa.graph.nullConst(ft)));
		if (m.x.facts.V_NON_ZERO) app.facts |= Fact.O_NO_NULL_CHECK;
	}
	def visitTypeSubsume(opcode: Opcode.TypeSubsume, ft: Type, tt: Type) {
		var xval = m.unop(app);
		if (m.xconst) return reduceTo(ssa.graph.valConst(tt, xval));
		if (ft == tt) return reduceTo(m.x); // fold TypeSubsume<T, T>(x)
		if (tt == m.x.getType()) return reduceTo(m.x); // fold TypeSubsume<F, T>(x: T)
		match (tt.typeCon.kind) {
			CLASS, VARIANT => {
				if (ft == Null.TYPE) return reduceTo(ssa.graph.nullConst(tt));
				if (TypeSystem.isSubtype(ft, tt)) return reduceTo(m.x); // remove redundant subsume of class
			}
			ENUM_SET => {
				return reduceTo(addEnumToSet(EnumSetType.!(tt), m.x));
			}
			_ => ;
			// XXX: int subsume and tuples
		}
		if (m.x.facts.V_NON_ZERO) {
			app.facts |= Fact.O_NO_NULL_CHECK | Fact.V_NON_ZERO;
		}
	}
	def visitCallMethod(opcode: Opcode.CallMethod, spec: IrSpec) {
		app.facts |= opcode.method.facts & Fact.O_PURE;
		if (app.inputs.length > 0 && app.input0().facts.V_NON_ZERO) app.facts |= Fact.O_NO_NULL_CHECK;
		if (state != null) state.kill();
	}
	def visitCallClassMethod(opcode: Opcode.CallClassMethod, spec: IrSpec) {
		app.facts |= opcode.method.facts & Fact.O_PURE;
		var target = nullcheck(app);
		if (state != null) state.kill();
		if (SsaThrow.?(target) || end()) return reduceTo(target);
		var x = app.input0();
		if (x == null) Terminal.put2("@%d:CallClassMethod(0) == null, end=%z\n", app.uid, end());
		if (app.inputs.length > 0 && app.input0().facts.V_NON_ZERO) app.facts |= Fact.O_NO_NULL_CHECK;
	}
	def visitCallClassVirtual(opcode: Opcode.CallClassVirtual, meth: IrSpec) {
		var receiver = app.input0();
		receiver = nullcheck(app);
		if (end()) return reduceTo(receiver);
		if (app.input0().facts.V_NON_ZERO) app.facts |= Fact.O_NO_NULL_CHECK;
		var dv = devirtualize(meth, receiver);
		if (state != null) state.kill();
		if (dv != null) return reduceTo(replaceOp(app, V3Op.newCallClassMethod(dv)));  // CallClassVirtual[m](K) => CallClassMethod[m](k)
	}
	def visitCallVariantVirtual(opcode: Opcode.CallVariantVirtual, meth: IrSpec) {
		var receiver = app.input0();
		if (app.input0().facts.V_NON_ZERO) app.facts |= Fact.O_NO_NULL_CHECK;
		var dv = devirtualize(meth, receiver);
		if (state != null) state.kill();
		if (dv != null) return reduceTo(replaceOp(app, V3Op.newCallMethod(dv)));  // CallVariantVirtual[m](K) => CallMethod[m](k)
	}
	// XXX: optimize CallVariantSelector
	def visitCallVariantSelector(opcode: Opcode.CallVariantSelector, spec: IrSpec)	{ if (state != null) state.kill(); }
	def visitCallClosure(opcode: Opcode.CallClosure, ft: FuncType) {
		var target = nullcheck(app);
		if (state != null) state.kill();
		if (SsaThrow.?(target) || end()) return reduceTo(target);
		var xval = m.unop(app), xop: Operator;
		var i_recvr: SsaInstr, newOp: Operator, newFacts: Fact.set;
		if (m.xconst) {
			var d = Closure.!(xval);
			if (d == null) return reduceTo(addThrow(app.source, V3Exception.NullCheck));
			// CallClosure(K) => CallMethod[K.m]
			i_recvr = ssa.graph.valConst(d.memberRef.getClosureReceiver(), d.val);
			newOp = V3Op.newCallMethod(d.memberRef);
			newFacts = Fact.O_NO_NULL_CHECK;
		} else if (SsaApplyOp.?(m.x)) match ((xop = SsaApplyOp.!(m.x).op).opcode) {
			// XXX: look through TypeCast / TypeSubsume of functions
			ClassGetMethod(method) => {
				// CallClosure(GetClassMethod[m]) => CallMethod[m]
				var spec = V3Op.extractIrSpec(xop, method);
				newOp = V3Op.newCallMethod(spec);
				i_recvr = m.x.input0();
				newFacts = app.facts & Fact.O_NO_NULL_CHECK;
			}
			ClassGetVirtual(method) => {
				// CallClosure(GetClassVirtual[m]) => CallClassVirtual[m]
				var spec = V3Op.extractIrSpec(xop, method);
				newOp = V3Op.newCallClassVirtual(spec);
				i_recvr = m.x.input0();
				newFacts = app.facts & Fact.O_NO_NULL_CHECK;
			}
			CreateClosure(method) => {
				// CallClosure(CreateClosure[m](p), ...) => CallMethod[m](p, ...);
				var spec = V3Op.extractIrSpec(xop, method);
				newOp = V3Op.newCallMethod(spec);
				i_recvr = if (V3.isComponent(spec.receiver), ssa.graph.nullReceiver(), m.x.input0());
				if (V3.isComponent(spec.receiver)) newFacts |= Fact.O_NO_NULL_CHECK;
				else newFacts |= m.x.facts & Fact.O_NO_NULL_CHECK;
			}
			_ => {
				if (!app.facts.O_PURE && state != null) state.kill();
			}
		}
		if (newOp != null) return reduceTo(replaceWithDirectCall(app, newOp, i_recvr, app.inputs[1 ...]).setFact(newFacts));
	}
	def visitCallFunction(opcode: Opcode.CallFunction, ft: FuncType) {
		var target = nullcheck(app);
		if (SsaThrow.?(target)) return reduceTo(target);
		if (state != null) state.kill();
		var xval = m.unop(app);
		if (m.xconst && FuncVal.?(xval)) {
			var d = FuncVal.!(xval);
			if (d == null) return reduceTo(addThrow(app.source, V3Exception.NullCheck));
			// CallFunction(#K) => CallMethod
			var newOp = V3Op.newCallMethod(d.memberRef);
			var i_recvr: SsaInstr = null;
			return reduceTo(replaceWithDirectCall(app, newOp, i_recvr, app.inputs[1 ...]).setFact(Fact.O_NO_NULL_CHECK));
		}
	}
	def visitCreateClosure(opcode: Opcode.CreateClosure, spec: IrSpec) {
		if (op.isPolymorphic()) return;
		var xval = m.unop(app);
		if (!m.fold) return;
		// CreateClosure(#K) => #K
		return reduceTo(ssa.graph.valConst(spec.getBoundType(), Closure.new(xval, spec)));
	}
	def visitRefLayoutSetField(opcode: Opcode.RefLayoutSetField, rt: RefType, ft: Type)			{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitRefLayoutSetRepeatedField(opcode: Opcode.RefLayoutSetRepeatedField, rt: RefType, ft: Type)	{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitByteArraySetField(opcode: Opcode.ByteArraySetField, ft: Type, startType: Type)			{ if (optimize_loads && state != null) state.killArrayElems(); }
	def visitSystemCall(opcode: Opcode.SystemCall)								{ if (state != null) state.kill(); }
	def visitPtrAdd(opcode: Opcode.PtrAdd, pt: Type, it: IntType) {
		m.binop(app);
		if (m.yzero) return reduceTo(m.x);
		if (!m.fold) return;
		if (!Addr.?(m.xval)) return;
		var a = Addr.!(m.xval);
		match (m.yval) {
			yi: Box<int> => { // TODO(addr64)
				var na: Addr;
				if (a != null) {
					na = a.add(yi.val);
				} else if (MachProgram.?(context.prog.tprog)) {
					na = Addr.new(MachProgram.!(context.prog.tprog).dataRegion, null, yi.val);
					na.absolute = yi.val;
				}
				if (na != null) return reduceTo(ssa.graph.valConst(app.getType(), na));
			}
		}
	}
	def visitPtrCmpSwp(opcode: Opcode.PtrCmpSwp, pt: PointerType, vt: Type) {
		nullcheck(app);
		if (state != null) state.kill();
	}
	// XXX: PtrAdd, PtrSub, PtrLt
	def visitPtrLoad(opcode: Opcode.PtrLoad, pt: Type, vt: Type) {
		var ptr = nullcheck(app);
		// XXX: use Fact.O_FOLDABLE to indicate a load of an immutable value
		if (optimize_loads && state != null) {
			return reduceTo(state.loadPtr(ptr, vt, app));
		}
	}
	def visitPtrStore(opcode: Opcode.PtrStore, pt: Type, vt: Type) {
		var ptr = nullcheck(app);
		if (state != null) {
			state.killArrayElems();
			state.killPointedAt();
		}
		// XXX: use a fact to indicate an initializing store that cannot kill previous loads
		// a store of zero or multiple scalars has no single value to forward
		if (optimize_loads && state != null && app.inputs.length == 2) {
			state.storePtr(ptr, vt, app, app.input1());
		}
	}
	def visitCallAddress(opcode: Opcode.CallAddress, pt: PointerType) {
		var t = app.input0();
		if (SsaConst.?(t)) {
			var target = SsaConst.!(t).val;
			if (target == null) return reduceTo(addThrow(app.source, V3Exception.NullCheck));
			// XXX: CallAddress(#K) => CallMethod
		}
		if (state != null) state.kill();
	}
	def visitCallKernel(opcode: Opcode.CallKernel, typeArgs: Array<Type>)	{ if (state != null) state.kill(); }
	def visitDefaultOp(op: Operator)					{ if (!app.facts.O_PURE && state != null) state.kill(); }
	def reduceEq() {
		def ABOVE_BELOW_ZERO = Fact.V_NON_ZERO | Fact.V_NON_NEGATIVE | Fact.V_BELOW_ZERO;
		norm_binop(app);
		if (m.fold) return reduceTo(ssa.graph.boolConst(Values.equal(m.xval, m.yval)));
		if (m.x == m.y) return reduceTo(ssa.graph.trueConst());
		// XXX: look through type casts and subsumes for RefEq
		var and = m.x.facts & m.y.facts, or = m.x.facts | m.y.facts;
		if (Facts.NONE != (and & Fact.V_ZERO)) return reduceTo(ssa.graph.trueConst()); // 0 == 0 == true
		if (ABOVE_BELOW_ZERO == (or & ABOVE_BELOW_ZERO)) return reduceTo(ssa.graph.falseConst()); // neg == pos == false
	}
	def tryEval(apply: SsaApplyOp) -> SsaInstr {
		for (i in apply.inputs) if (!SsaConst.?(i.dest)) return null; // only evaluate if all inputs are constants
		if (foldingArgs == null) foldingArgs = FoldingArguments.new(context.prog);
		if (apply.inputs.length != apply.op.sig.paramTypes.length) {
			// XXX: attempt normalization first.
			return null;
		}
		foldingArgs.reset(apply);
		var result = Eval.doOp(apply.op, foldingArgs);
		if (foldingArgs.not_foldable) return null;
		match (result) {
			ex: Exception => {
				if (ex.error == V3Exception.NotFoldable) return null;
				if (ex.error == V3Exception.InternalError) {
					context.fail(Strings.format2("failed folding %q: %s", apply.op.render, ex.msg));
					return null;
				}
				return addThrow(apply.source, ex.error);
			}
			val: Val => return ssa.graph.valConst(apply.getType(), val);
//TODO			null => return ssa.graph.valConst(apply.getType(), null);
			_ => return null;
		}
	}
	def norm_binop(i: SsaApplyOp) -> Val {
		if (i.inputs.length != 2) norm2(i);
		return m.binop(i);
	}
	def norm_intbinop(i: SsaApplyOp) -> int {
		if (i.inputs.length != 2) norm2(i);
		return m.intbinop(i);
	}
	def norm2(i: SsaApplyOp) {
		var t = i.input0();
		var x = SsaApplyOp.new(null, V3Op.newTupleGetElem(t.getType(), 0), [t]);
		var y = SsaApplyOp.new(null, V3Op.newTupleGetElem(t.getType(), 1), [t]);
		i.inputs[0].update(null);
		x.insertBefore(i);
		y.insertBefore(i);
		i.setInputs([x, y]);
	}
	def fold4b(s: (int, int) -> bool, u: (u32, u32) -> bool, sl: (long, long) -> bool, ul: (u64, u64) -> bool) -> SsaInstr {
		if (!m.wide) return ssa.graph.boolConst(if(m.inttype.signed, s(m.xint, m.yint), u(u32.view(m.xint), u32.view(m.yint))));
		else return ssa.graph.boolConst(if(m.inttype.signed, sl(m.xlong, m.ylong), ul(u64.view(m.xlong), u64.view(m.ylong))));
	}
	def fold4i(s: (int, int) -> int, u: (u32, u32) -> u32, sl: (long, long) -> long, ul: (u64, u64) -> u64) -> SsaInstr {
		if (!m.wide) return if(m.inttype.signed, i_const(s(m.xint, m.yint)), u_const(u(u32.view(m.xint), u32.view(m.yint))));
		else return if(m.inttype.signed, l_const(sl(m.xlong, m.ylong)), lu_const(ul(u64.view(m.xlong), u64.view(m.ylong))));
	}
	def fold2i(s: (int, int) -> int, sl: (long, long) -> long) -> SsaInstr {
		return if(m.wide, l_const(sl(m.xlong, m.ylong)), i_const(s(m.xint, m.yint)));
	}

	def replaceWithDirectCall(i_old: SsaApplyOp, newOp: Operator, i_recvr: SsaInstr, ai_old: Range<SsaDfEdge>) -> SsaInstr {
		var oldRetType = i_old.getType();
		var paramTypes = newOp.sig.paramTypes;
		var ai_new = Array<SsaInstr>.new(paramTypes.length);
		var i = 0;
		if (i_recvr != null) ai_new[i++] = i_recvr;
		var numParams = paramTypes.length - i;
		match (numParams) {
			0 => ; // nothing to do
			1 => {
				if (ai_old.length == 0) ai_new[i++] = ssa.graph.nullConst(paramTypes[i]);
				else if (ai_old.length == 1) ai_new[i++] = ai_old[0].dest;
				else {
					var tt = TupleType.!(paramTypes[i]);
					var args = Ranges.map(ai_old, SsaDfEdge.dest);
					ai_new[i++] = add(i_old.source, V3Op.newTupleCreate(tt), args);
				}
			}
			_ => {
				if (ai_old.length == numParams) {
					for (j < ai_old.length) ai_new[i++] = ai_old[j].dest;
				} else {
					var tt = TupleType.!(ai_old[0].dest.getType());
					for (j < numParams) ai_new[i++] = add(i_old.source, V3Op.newTupleGetElem(tt, j), [ai_old[0].dest]);
				}
			}
		}

		for (i < paramTypes.length) {
			var arg = ai_new[i];
			var op = opSubsume(arg.getType(), paramTypes[i]);
			if (op != null) ai_new[i] = add(i_old.source, op, [arg]);
		}
		var i_new = add(i_old.source, newOp, ai_new);
		var op = opSubsume(newOp.sig.returnType(), oldRetType);
		if (op != null) i_new = add(i_old.source, op, [i_new]);
		return i_new;
	}
	def opSubsume(ft: Type, tt: Type) -> Operator { // TODO: refactor to use SsaBuilder
		if (ft == tt) return null;
		if (FuncType.?(ft) || FuncType.?(tt)) return V3Op.newTypeSubsume(ft, tt);
		if (TupleType.?(ft) || TupleType.?(tt)) return V3Op.newTypeSubsume(ft, tt);
		return null;
	}
	def copyInputs(i: SsaInstr, prepend: SsaInstr, start: int) -> Array<SsaInstr> {
		var extra = if(prepend != null, 1);
		var inputs = Array<SsaInstr>.new(i.inputs.length - start + extra);
		if (extra > 0) inputs[0] = prepend;
		for (j = extra; j < inputs.length; j++) inputs[j] = i.inputs[j + start - extra].dest;
		return inputs;
	}

	def i_const(v: int) -> SsaInstr {
		return ssa.graph.intConst(Eval.doIntTrunc32(m.inttype, v));
	}
	def u_const(v: u32) -> SsaInstr {
		return ssa.graph.intConst(Eval.doIntTrunc32(m.inttype, int.view(v)));
	}
	def l_const(v: long) -> SsaInstr {
		return ssa.graph.valConst(m.inttype, Long.box(Eval.doIntTrunc64(m.inttype, v)));
	}
	def lu_const(v: u64) -> SsaInstr {
		return ssa.graph.valConst(m.inttype, Long.box(Eval.doIntTrunc64(m.inttype, long.view(v))));
	}
	def shiftcheck(i: SsaApplyOp, y: SsaInstr) -> SsaInstr {
		var bound = posIntBound(y);
		if (bound >= 0 && bound < IntType.!(i.op.sig.returnType()).width) {
			i.facts |= Fact.O_NO_SHIFT_CHECK;
		}
		return i;
	}
	def boundscheck(i: SsaApplyOp) -> SsaInstr {
		var receiver = nullcheck(i);
		if (!optimize_bounds) return i;
		// XXX: introduce partial bounds checks when length is a known constant.
		if (end()) return receiver;
		if (state != null && findPriorBoundsCheck(i, receiver, i.input1())) return receiver;
		// Initialize the match state for {x} and {y}.
		var yval = m.binop(i);
		if (m.yconst && V3.unboxI32(yval) < 0) {
			// will always throw out of bounds, but might need a null check first.
			if (!i.facts.O_NO_NULL_CHECK) addExplicitNullCheck(i.source, receiver);
			return addThrow(i.source, V3Exception.BoundsCheck);
		}
		// Compute the constant length of the array if possible.
		var length = -1;
		if (m.xconst) {
			match (m.xval) {
				x: Record => length = x.values.length;
				x: Address<Record> => length = x.val.values.length;
				_ => return receiver;
			}
		} else if (m.x.optag() == Opcode.ArrayAlloc.tag) {
			var l = m.x.inputs[0].dest;
			if (!SsaConst.?(l)) return receiver;
			length = l.unbox<int>();
		} else if (m.x.optag() == Opcode.ArrayInit.tag) {
			length = m.x.inputs.length;
		} else {
			return receiver;
		}

		if (m.yconst) {
			// Array length and index are constants. Static bounds check.
			var index = V3.unboxI32(yval);
			if (index < length) {
				i.facts |= Facts.O_SAFE_BOUNDS;
				return receiver;
			}
			return addThrow(i.source, V3Exception.BoundsCheck);
		}
		// Array length is a constant, try range analysis of the index.
		var bound = posIntBound(m.y);
		if (bound >= 0 && bound < length) i.facts |= Facts.O_SAFE_BOUNDS;
		return receiver;
	}
	def findPriorBoundsCheck(i: SsaInstr, x: SsaInstr, y: SsaInstr) -> bool {
		for (l = state.inbounds; l != null; l = l.tail) {
			var t = l.head;
			if (t.0 == x) {
				i.facts |= Fact.O_NO_NULL_CHECK;
				if (t.1 == y) {
					i.facts |= Fact.O_NO_BOUNDS_CHECK;
					return true;
				}
				if (SsaConst.?(t.1) && SsaConst.?(y)) {
					var p = V3.unboxI32(SsaConst.!(t.1).val), yy = V3.unboxI32(SsaConst.!(y).val);
					if (p >= 0 && p >= yy) {
						i.facts |= Fact.O_NO_BOUNDS_CHECK;
						return true;
					}
				}
			}
		}
		state.inbounds = List.new((x, y), state.inbounds);
		return false;
	}
	def addExplicitNullCheck(source: Source, receiver: SsaInstr) -> SsaInstr {
		var t = receiver.getType();
		var check = add(source, V3Op.newEqual(t), [receiver, ssa.graph.nullConst(t)]);
		return add(source, V3Op.newConditionalThrow(V3Exception.NullCheck), [check]);
	}
	def posIntBound(x: SsaInstr) -> int {
		if (SsaConst.?(x)) {
			var val = SsaConst.!(x).val;
			if (val == null) return 0;
			if (Box<int>.?(val)) return Box<int>.!(val).val;
			return -1;
		}
		var bound = posIntBoundFromType(x);
		if (!SsaApplyOp.?(x)) return bound;
		var i = SsaApplyOp.!(x);
		match (i.op.opcode) {
			IntAnd => {
				var lb = posIntBound(i.input0()), rb = posIntBound(i.input1());
				if (bound < 0 || (lb >= 0 && lb < bound)) bound = lb;
				if (bound < 0 || (rb >= 0 && rb < bound)) bound = rb;
			}
			VariantGetTag => {
				var c = ClassType.!(i.op.typeArgs[0]).classDecl;
				var b = c.maxTag;
				if (b < bound) bound = b;
			}
			IntViewI, TypeSubsume, TypeCast => {
				var b = posIntBound(i.input0());
				if (bound < 0 || (b >= 0 && b < bound)) {
					var t = i.getType();
					if (IntType.?(t)) {
						// conversion to smaller signed type might overflow.
						var it = IntType.!(t);
						if (it.signed && it.width <= 32 && b > V3.unboxI32(it.max)) b = bound;
					}
					bound = b;
				}
			}
			_ => ;
		}
		return bound;
	}
	def posIntBoundFromType(x: SsaInstr) -> int {
		var t = x.getType();
		if (IntType.?(t)) {
			var it = IntType.!(t);
			if (it.width > 32) return -1;
			if (!it.signed || x.facts.V_NON_NEGATIVE) return V3.unboxI32(it.max);
		}
		if (EnumType.?(t)) {
			return EnumType.!(t).enumDecl.cases.length - 1;
		}
		return -1;
	}

	def nullcheck(i: SsaApplyOp) -> SsaInstr {
		var receiver = i.input0();
		if (i.facts.O_NO_NULL_CHECK) return receiver;
		if (receiver.facts.V_NON_ZERO) {
			i.facts |= Fact.O_NO_NULL_CHECK;
			return receiver;
		}
		if (receiver.facts.V_ZERO) return addThrow(i.source, V3Exception.NullCheck);
		if (!optimize_nullchecks || state == null) return receiver;
		for (l = state.nonnull; l != null; l = l.tail) {
			if (l.head == receiver) {
				i.facts |= Fact.O_NO_NULL_CHECK;
				return receiver;
			}
		}
		state.nonnull = List.new(receiver, state.nonnull);
		return receiver;
	}
	def devirtualize(m: IrSpec, x: SsaInstr) -> IrSpec {
		// Try to devirtualize based on the class hierachy first.
		if (!m.member.flags.M_OVERRIDDEN) return m;
		var optag = x.optag();
		// Look through TypeSubsumes at a potentially more precise receiver.
		while (optag == Opcode.TypeSubsume.tag) {
			x = SsaApplyOp.!(x).inputs[0].dest;
			optag = x.optag();
		}
		// Try to constant-fold.
		var r = asRecord(x);
		if (r != null) 	return context.prog.ir.resolveMethodImpl(r.rtype, m); // devirtualize K
		// Pattern-match allocations.
		if (optag == Opcode.ClassAlloc.tag || optag == Opcode.VariantAlloc.tag) {
			return context.prog.ir.resolveMethodImpl(SsaApplyOp.!(x).op.typeArgs[0], m); // devirtualize {Class,Variant}Alloc
		}
		// Try resolving on the (potentially more precise) static type of the receiver.
		var xt = x.getType();
		if (TypeSystem.isSubtype(xt, m.receiver)) {
			var xm = context.prog.ir.resolveMethodImpl(xt, m);
			if (!xm.member.flags.M_OVERRIDDEN) return xm;
		}
		return null;
	}

	def asRecord(i: SsaInstr) -> Record {
		return if(SsaConst.?(i), Record.!(SsaConst.!(i).val));
	}
	def getFieldType(op: Operator, field: IrField) -> Type {
		return if(op.isPolymorphic(), V3Op.extractIrSpec(op, field).getFieldType(), field.fieldType);
	}

	//======================================================================
	// Editing helpers
	//======================================================================
	def addThrow(source: Source, exception: string) -> SsaInstr {
		if (end()) return null;
		ssa.addThrow(source, exception);
		return ssa.graph.nop();
	}
	def addConditionalThrow(source: Source, exception: string, cond: SsaInstr) -> SsaInstr {
		return add(source, V3Op.newConditionalThrow(exception), [cond]);
	}
	def addBinop(op: Operator, x: SsaInstr, y: SsaInstr) -> SsaInstr {
		return add(null, op, [x, y]);
	}
	def replaceOp(i: SsaApplyOp, op: Operator) -> SsaInstr {
		var args = Array<SsaInstr>.new(i.inputs.length);
		for (j < args.length) args[j] = i.inputs[j].dest;
		var ni = add(i.source, op, args);
		ni.facts |= i.facts;
		return ni;
	}
	def convert(i: SsaConst, t: Type) -> SsaInstr {
		if (i.vtype == t) return i;
		var r = Eval.doCast0(i.vtype, t, i.val);
		return ssa.graph.valConst(t, r.1);
	}
	def addEqual(t: Type, x: SsaInstr, y: SsaInstr) -> SsaInstr {
		return if(!end(), addBinop(V3Op.newEqual(t), x, y));
	}
	def addNotEqual(t: Type, x: SsaInstr, y: SsaInstr) -> SsaInstr {
		return if(!end(), addNot(addBinop(V3Op.newEqual(t), x, y)));
	}
	def addNot(x: SsaInstr) -> SsaInstr {
		return if(!end(), add(null, V3Op.opBoolNot, [x]));
	}
	def addEnumToSet(tc: EnumSetType, x: SsaInstr) -> SsaInstr {
		// XXX: reduce duplication with V3EnumSet_TypeCon
		var one = ssa.graph.valConst(tc.repType, tc.repType.box(1));
		var i = add(null, tc.repType.opShl(), [one, x]);
		i.facts |= Fact.O_NO_SHIFT_CHECK;
		return i;
	}
	// Inserts a new instruction, which is not optimized again.
	def add(source: Source, op: Operator, args: Array<SsaInstr>) -> SsaInstr {
		if (end()) return null;
		var i = SsaApplyOp.new(source, op, args);
		i.facts |= Opcodes.facts(op.opcode);
		ssa.append(i);
		return i;
	}
	def killUnused(i_old: SsaInstr) -> SsaInstr {
		if (i_old.useList != null) i_old.replace(ssa.graph.nullConst(i_old.getType()));
		i_old.kill();
		i_old.remove();
		return ssa.graph.nop();
	}
	//======================================================================
	// Control flow optimizations on a completed graph
	//======================================================================
	def optControlFlow() {
		// visit all the blocks of the graph
		// 1. reduce phis with identical inputs
		// 2. merge straight-line blocks (may introduce critical edges)
		// 3. optimize diamond-if patterns arising from if(a && b) patterns
		// 4. XXX iteratively reduce/fold code
		// 5. collapse if-chains into switches, esp if(T.?(e)) ...
		// 6. XXX remove useless branches
		mark = ++context.graph.markGen;
		queue.resize(0);
		queueBlock(context.graph.startBlock);
		for (i < queue.length) optBlock(queue[i]);
	}
	def queueBlock(block: SsaBlock) {
		if (block.mark < mark) {
			block.mark = mark;
			queue.put(block);
		}
	}
	def optBlock(block: SsaBlock) {
		if (block.facts.O_KILLED) return;
		var next = block.next;
		while (true) {
			if (!SsaPhi.?(next)) break;
			var nn = next.next;
			optPhi(SsaPhi.!(next));
			next = nn;
		}
		var i = 0, succ = block.succs();
		while (i < succ.length) {
			if (optEdge(succ[i])) {
				i = 0;
				succ = block.succs();
			} else {
				i++;
			}
		}
		var end = block.end();
		if (SsaIf.?(end)) {
			optIf(block, SsaIf.!(end));
		}
		for (s in block.succs()) {
			if (s.dest != null) queueBlock(s.dest);
		}
	}
	def optPhi(phi: SsaPhi) -> bool {
		var inputs = phi.inputs;
		if (inputs.length == 0) return true; // phi has no remaining inputs
		var i0 = inputs[0].dest;
		if (i0 == null || phi.useList == null) {
			// one of the inputs is dead, or the phi is unused
			Ssa.killInstr(phi);
			return true;
		}
		return reducePhi(phi);
	}
	def optIf(block: SsaBlock, sw: SsaIf) {
		var e = sw.inputs[0], v = e.dest;
		if (SsaApplyOp.?(v)) {
			var cond = SsaApplyOp.!(v);
			if (Opcode.TypeQuery.?(cond.op.opcode)) {
				// propagate type query success on true successor
				var queryTypes = cond.op.typeArgs;
				applyDominatorOptForInput0(cond.input0(), sw.succs[0], optFoldCast(_, queryTypes));
			} else if (Opcode.RefEq.?(cond.op.opcode)) {
				tryPropagatingCmpNonZero(cond, sw.succs[0], sw.succs[1]);
			} else if (Opcode.IntEq.?(cond.op.opcode)) {
				tryPropagatingCmpNonZero(cond, sw.succs[0], sw.succs[1]);
				tryBuildingSwitch(block, sw, cond.op.typeArgs[0], cond);
			}
			return;
		}
		// Fold branches.
		if (SsaConst.?(v)) {
			var cond = SsaConst.!(v);
			replaceWithGoto(block, sw, block.succ(if(cond.unbox<bool>(), 0, 1)));
			return;
		}

		// match and simplify a control flow pattern where the input to a switch
		// is the merge of a previous branch; e.g. this occurs in if(a && b)

		if (block.next != v) return; // condition not defined as only phi in this block
		if (v.next != sw) return; // more instructions in this block
		if (!SsaPhi.?(v)) return; // branch condition is not a phi
		var phi = SsaPhi.!(v);
		if (!e.isOnlyEdge()) return; // condition is used elsewhere as well

		// search for and remove inputs to the phi that are constants
		var ivec = Vector<SsaInstr>.new(), evec = Vector<SsaCfEdge>.new();
		var inputs = phi.inputs, edges = block.preds;
		for (i < inputs.length) {
			var input = inputs[i], edge = edges[i];
			if (SsaConst.?(input.dest)) {
				// redirect incoming edge to outgoing edge
				var succ = sw.findSucc(SsaConst.!(input.dest).val);
				appendPhiInput(succ.dest, succ.desti);
				edge.connect(succ.dest);
				optEdge(edge);
				input.update(null); // kill the use of the value
			} else {
				ivec.put(input.dest);
				evec.put(edge);
			}
		}

		if (ivec.length == phi.inputs.length) return; // no updates
		if (ivec.length == 0) return killBlock(block); // no predecessors remain
		block.preds = evec.extract();
		if (ivec.length == 1) {
			e.update(ivec[0]); // only one input remains
			optEdge(block.preds[0]);
		} else {
			// more than one input to this phi is remaining, build a new phi
			var newPhi = SsaPhi.new(phi.getType(), block, ivec.extract());
			block.prepend(newPhi);
			e.update(newPhi);
		}
		phi.kill();
		phi.remove();
	}
	def tryPropagatingCmpNonZero(cmp: SsaApplyOp, eqEdge: SsaCfEdge, neEdge: SsaCfEdge) {
		var left = cmp.input0(), right = cmp.input1();
		if (left.facts.V_NON_ZERO) {
			return applyDominatorOptForInput0(right, eqEdge, optNullCheck);
		}
		if (left.facts.V_ZERO) {
			return applyDominatorOptForInput0(right, neEdge, optNullCheck);
		}
		if (right.facts.V_NON_ZERO) {
			return applyDominatorOptForInput0(left, eqEdge, optNullCheck);
		}
		if (right.facts.V_ZERO) {
			return applyDominatorOptForInput0(left, neEdge, optNullCheck);
		}
	}
	def matchSwitchCmp(key: SsaInstr, block: SsaBlock) -> SwitchCmp {
		// XXX: match commute constants, etc.
		var end = block.end();
		if (!SsaIf.?(end)) return null;
		var i = SsaIf.!(end);
		var edge = i.inputs[0];
		if (!edge.isOnlyEdge()) return null;
		var cmp = edge.dest;
		if (cmp.optag() != Opcode.IntEq.tag) return null;
		if (cmp.inputs[0].dest != key) return null;
		var r = cmp.inputs[1].dest;
		if (!SsaConst.?(r)) return null;
		return SwitchCmp.new(V3.unboxI32(SsaConst.!(r).val), cmp, i, block.succ(0), block.succ(1));
	}
	def verifySwitchCmpBlock(cmp: SwitchCmp, block: SsaBlock) -> bool {
		for (i = block.next; i != block; i = i.next) {
			if (i != cmp.cmp && i != cmp.end) return false;
		}
		return true;
	}
	def tryBuildingSwitch(block: SsaBlock, sw: SsaIf, t: Type, cmp: SsaInstr) {
		if (!context.compiler.EmitSwitch) return;
		if (!IntType.?(t)) return;
		var it = IntType.!(t);
		if (it.width > 32) return;
		var key = cmp.input0();
		var cmp = matchSwitchCmp(key, block);
		if (cmp == null) return;
		var vec = Vector<SwitchCmp>.new();
		vec.put(cmp);
		// add switch case candidates to the list.
		while (true) {
			if (cmp.fSucc.dest.preds.length != 1) break;
			var block = cmp.fSucc.dest;
			cmp = matchSwitchCmp(key, block);
			if (cmp == null) break;
			if (!verifySwitchCmpBlock(cmp, block)) break;
			vec.put(cmp);
		}

		// determine if building a table would be profitable.
		if (vec.length < 4) return;  // not enough cases.
		var min = Int.MAX_VALUE, max = Int.MIN_VALUE;
		for (i < vec.length) {
			var v = vec[i].val;
			if (v < min) min = v;
			if (v > max) max = v;
		}
		var diff = (long.view(max) - long.view(min)) + 1; // avoid overflow
		if (diff > vec.length * 2) return; // table would be less than 50% full.
		if (diff > int.max) return;  // table would be too large.
		var size = int.view(diff);
		var table = Array<SsaCfEdge>.new(size);
		// build dispatch table.
		for (i = vec.length - 1; i >= 0; i--) {
			var c = vec[i], index = c.val - min;
			var p = table[index];
			if (p != null) Ssa.removeEdge(p, true);
			table[index] = c.tSucc;
		}
		if (min != 0) {
			var sub = SsaApplyOp.new(null, it.opSub(), [key, context.graph.valConst(it, Int.box(min))]);
			key = sub;
			block.append(sub);
			max = max - min;
			min = 0;
		}
		var sw = SsaSwitch.new(key.getType(), max, key);
		// build array of successor edges.
		var dmerge: SsaBlock;
		for (i < size) {
			var e = table[i];
			if (e == null) {  // hole in the table; go to default
				if (dmerge == null) dmerge = SsaBlock.new();
				sw.succs[i].connect(dmerge);
			} else {
				replaceEdge(e, sw.succs[i]);
			}
		}
		// set up default edge.
		var defedge = vec[vec.length - 1].fSucc;
		if (dmerge != null) {
			sw.succs[size].connect(dmerge);
			var goto = SsaGoto.new(null);
			dmerge.append(goto);
			replaceEdge(defedge, goto.succs[0]);
		} else {
			replaceEdge(defedge, sw.succs[size]);
		}

		// Remove the ifs and comparisons from the end of the blocks.
		for (i < vec.length) {
			var c = vec[i];
			c.end.kill();
			c.end.remove();
			c.cmp.kill();
			c.cmp.remove();
		}

		// Replace the first if with a switch.
		block.append(sw);
	}
	// Kills the blocks reachable only through {edges}, after removing {edges}.
	def killSuccs(edges: Array<SsaCfEdge>) {
		Ssa.killSuccs(edges);
	}
	def killBlock(block: SsaBlock) {
		Ssa.killBlock(block);
	}
	def optEdge(edge: SsaCfEdge) -> bool {
		var src = edge.src, dest = edge.dest;
		if (dest == null) return false; // edge may have already been optimized away
		if (dest.preds.length > 1) return false; // destination has more than one predecessor
		if (src.succs.length > 1) {
			// try to skip the destination block
			if (dest.succs().length != 1) return false;	// doesn't end with a goto
			if (!dest.empty()) return false;		// is not empty
			var destdest = dest.succ(0).dest;
			if (destdest.hasPhis()) return false;		// has phis
			Ssa.simplifyPhis(dest);
			edge.connect(destdest);				// redirect edge
			killBlock(dest);				// try to kill the destination
			return true;
		}
		// Kill the end of the previous block
		var block = src.block();
		if (block == null) return V3.fail1("block of @%d is null", src.uid);
		src.kill();
		src.remove();

		// Move destination instructions, including end, into source
		Ssa.simplifyPhis(dest);
		var first = dest.next, end = dest.end();
		first.prev = null;
		end.next = null;
		if (first != null) block.appendN(first);
		return true;
	}
	def appendPhiInput(dest: SsaBlock, index: int) {
		// add a new edge X -> B, using A's input to each phi as X's input
		var next = dest.next;
		while (true) {
			if (!SsaPhi.?(next)) break;
			// for each phi, add a new input corresponding to this edge
			var phi = SsaPhi.!(next);
			var input = phi.inputs[index].dest;
			phi.inputs = Arrays.append(SsaDfEdge.new(phi, input), phi.inputs);
			next = next.next;
		}
	}
	def replaceEdge(abEdge: SsaCfEdge, xbEdge: SsaCfEdge) {
		// replace the old edge A -> B with a new edge X -> B
		xbEdge.replace(abEdge);
	}
	def removeUnmarkedPredecessors(block: SsaBlock) {
		var i = 0;
		while (i < block.preds.length) {
			var e = block.preds[i], p = e.src.block();
			if (p.mark < 0) Ssa.removeEdge(e, true);
			else i++;
		}
	}
	// fold away a type cast if dominated by a type query that evaluates to true
	def optFoldCast(i: SsaInstr, queryTypes: Array<Type>) -> SsaInstr {
		if (i.optag() == Opcode.TypeCast.tag) {
			// fold away a type cast
			var cast = SsaApplyOp.!(i), castTypes = cast.op.typeArgs;
			if (TypeSystem.isSubtype(queryTypes[1], castTypes[1])) {
				return SsaApplyOp.new(cast.source, V3Op.newTypeSubsume(castTypes[0], castTypes[1]), [i.input0()]);
			} else {
				i.facts |= Fact.O_NO_NULL_CHECK;
			}
		}
		return optNullCheck(i);
	}
	// eliminate a null check on this instruction
	def optNullCheck(i: SsaInstr) -> SsaInstr {
		if (!SsaApplyOp.?(i)) return i;
		match (SsaApplyOp.!(i).op.opcode) {
			NullCheck,
			BoundsCheck,
			ArrayGetElem,
			ArraySetElem,
			ArrayGetLength,
			TypeCast,
			TypeQuery,
			ClassGetMethod,
			ClassGetVirtual,
			CallMethod,
			CallClassMethod,
			CallClassVirtual,
			CallClassSelector,
			CallVariantVirtual,
			CallVariantSelector,
			VariantGetField,
			VariantGetVirtual,
			VariantGetSelector,
			ClassGetField,
			ClassSetField => {
				i.facts |= Fact.O_NO_NULL_CHECK;
			}
			_ => ;
		}
		return i;
	}
	// apply the function "f" to every dominated instruction i where i.input0() == obj
	def applyDominatorOptForInput0(obj: SsaInstr, edge: SsaCfEdge, f: SsaInstr -> SsaInstr) {
		if (edge.dest.preds.length > 1) return;
		var block = edge.dest;
		// search this block for instructions to optimize
		// XXX: employ useList and domination numbers to only inspect instructions
		// that use this value
		for (l = block.next; l != block; l = l.next) {
			if (!SsaInstr.?(l)) continue;
			var i = SsaInstr.!(l);
			if (i.inputs.length < 1) continue; // instr doesn't involve obj
			if (i.input0() != obj) continue; // instr doesn't involve obj
			var ni = f(i);
			if (ni != i) {
				ni.insertBefore(i);
				i.remove();
				i.replace(ni);
				i.kill();
				l = ni;
			}
		}
		// XXX: propagate the fact to blocks dominated by this block
	}
	def replaceWithGoto(block: SsaBlock, end: SsaEnd, target: SsaCfEdge) {
		// Kill the previous end
		var oldsucc = end.succs;
		end.kill();
		end.remove();
		// Add a goto
		var goto = SsaGoto.new(null);
		goto.succs[0].replace(target);
		block.append(goto);
		// Optimize the dead branches
		for (dead in oldsucc) {
			if (dead == target) continue;
			var dest = dead.dest;
			Ssa.removeEdge(dead, true);
			if (!dest.hasPred()) killBlock(dest);
		}
	}
}

def ARRAY_LENGTH_FIELD = IrField.new(V3.stringType, Int.TYPE).setFlag(IrFlag.F_VALUE);

// Matches various patterns of SSA instructions, recording the state of the match
// in the exposed fields.
class SsaInstrMatcher {
	var x: SsaInstr;	// First input
	var y: SsaInstr;	// Second input
	var xconst: bool;	// true if {x} is a constant
	var yconst: bool;	// true if {y} is a constant
	var fold: bool;		// true if all inputs are constants
	var wide: bool;		// true if this is a long int operation
	var xval: Val;		// if {x} is a constant, then its value
	var yval: Val;		// if {y} is a constant, then its value
	var xint: int;		// if {x} is an int constant, then its value
	var yint: int;		// if {y} is an int constant, then its value
	var xlong: long;	// if {x} is a long constant, then its value
	var ylong: long;	// if {y} is a long constant, then its value
	var yzero: bool;        // true if {y} is zero
	var inttype: IntType;	// if this is an integer operation, the result type

	// Resets this matcher
	def clear() {
		x = y = null;
		xval = yval = null;
		inttype = null;
		xconst = yconst = yzero = fold = wide = false;
		xint = yint = 0;
		xlong = ylong = 0;
	}
	// Initializes the match state for a binary operation and returns {yval}.
	def binop(i: SsaApplyOp) -> Val {
		x = i.input0();
		y = i.input1();
		yzero = y.facts.V_ZERO;
		fold = false;
		if (xconst = SsaConst.?(x)) {
			xval = SsaConst.!(x).val;
			if (yconst = SsaConst.?(y)) {
				fold = true;
				return yval = SsaConst.!(y).val;
			} else if (i.facts.O_COMMUTATIVE) {
				i.inputs[0].update(y);
				i.inputs[1].update(x);
				xconst = false;
				yconst = true;
				var t = x;
				x = y;
				y = t;
				yval = xval;
				xval = null;
				yzero = y.facts.V_ZERO;
				return yval;
			} else {
				return yval = null;
			}
		}
		return yval = if(yconst = SsaConst.?(y), SsaConst.!(y).val);
	}
	// Initializes the match state for an integer binary operation and returns {yint}.
	def intbinop(i: SsaApplyOp) -> int {
		binop(i);
		inttype = IntType.!(i.op.sig.paramTypes[0]);
		if (inttype.width <= 32) {
			wide = false;
			if (xconst) xint = V3.unboxI32(xval);
			if (yconst) {
				yint = V3.unboxI32(yval);
				yzero = yint == 0;
			}
		} else {
			wide = true;
			if (xconst) xlong = Long.unboxSU(xval, inttype.signed);
			if (yconst) {
				ylong = Long.unboxSU(yval, inttype.signed);
				yzero = ylong == 0;
			}
		}
		return yint;
	}
	// Initializes the match state for an integer binary operation and returns {yint}.
	def boolbinop(i: SsaApplyOp) -> int {
		binop(i);
		inttype = null;
		if (xconst) xint = if(Bool.unbox(xval), 1);
		if (yconst) {
			yint = if(Bool.unbox(yval), 1);
			yzero = yint == 0;
		}
		return yint;
	}
	// Initializes the match state for a unary operation and returns {xval}.
	def unop(i: SsaApplyOp) -> Val {
		x = i.input0();
		return xval = if(fold = xconst = SsaConst.?(x), SsaConst.!(x).val);
	}
	// Initializes the match state for an n-ary operation and returns {xval}.
	def n_op(i: SsaApplyOp) -> Val {
		fold = true;
		var max = i.inputs.length;
		for (j < max) {
			if (!SsaConst.?(i.inputs[j].dest)) return (fold = false, null).last;
		}
		if (max >= 1) {
			x = i.input0();
			xconst = true;
			xval = SsaConst.!(x).val;
		}
		if (max >= 2) {
			y = i.input1();
			yconst = true;
			yval = SsaConst.!(y).val;
		}
		return xval;
	}
	def yis(val: int) -> bool {
		return yconst && if(wide, ylong == val, yint == val);
	}
	def yrange(min: int, max: int) -> bool {
		if (Debug.PARANOID && !yconst) return V3.fail("not const");
		if (wide) return min <= ylong && ylong <= max;
		else return min <= yint && yint <= max;
	}
	def yisPowerOf2() -> bool {
		return yconst && if(wide, (ylong & (ylong - 1)) == 0, (yint & (yint - 1)) == 0);
	}
	def ylog2() -> int {
		if (Debug.PARANOID && !yconst) return V3.fail("not const");
		return if(wide, Longs.log(u64.view(ylong)), Ints.log(u32.view(yint)));
	}
}

// Flow-sensitive state for local optimizations.
class SsaBlockState {
	var inbounds: List<(SsaInstr, SsaInstr)>;
	var nonnull: List<SsaInstr>;
	var inits: List<IrMethod>;
	def pure_loads = Vector<(SsaInstr, IrMember, SsaInstr)>.new();
	def impure_loads = Vector<(SsaInstr, IrMember, SsaInstr)>.new();
	def ptr_loads = Vector<(SsaInstr, Type, SsaInstr)>.new();

	def clear() -> this {
		nonnull = null;
		inits = null;
		inbounds = null;
		pure_loads.resize(0);
		impure_loads.resize(0);
		ptr_loads.resize(0);
	}
	def kill() -> this {
		impure_loads.resize(0);
		ptr_loads.resize(0);
	}
	def load(obj: SsaInstr, m: IrMember, apply: SsaApplyOp) -> SsaInstr {
//TODO:dce	if (apply.useList == null && apply.facts.O_NO_NULL_CHECK) {
//			apply.replace(null);
//			return context.graph.zeroConst();  // XXX: recursively delete dead code
//		}
		var val = find(obj, m);
		if (val != null) return val;
		if (m.isConst() || IrMethod.?(m) && !m.flags.F_POINTED_AT) pure_loads.put(obj, m, apply);
		else impure_loads.put(obj, m, apply);
		return apply;
	}
	def loadPtr(ptr: SsaInstr, loadType: Type, apply: SsaApplyOp) -> SsaInstr {
		var prev = find0(ptr_loads, ptr, loadType);
		if (prev != null) return prev;
		ptr_loads.put(ptr, loadType, apply);
		return apply;
	}
	def store(obj: SsaInstr, field: IrField, apply: SsaApplyOp, val: SsaInstr) -> SsaInstr {
		var prev = find(obj, field);
		if (prev == val) { // redundant store of previous value to field
			apply.remove();
			apply.kill();
			return null;
		}
		killField(field);
		impure_loads.put(obj, field, val);
		return apply;
	}
	def storePtr(ptr: SsaInstr, storeType: Type, apply: SsaApplyOp, val: SsaInstr) -> SsaInstr {
		var prev = find0(ptr_loads, ptr, storeType);
		if (prev == val) { // redundant store of previous value to field
			apply.remove();
			apply.kill();
			return null;
		}
		ptr_loads.resize(0); // XXX: improve pointer alias analysis, distinguish initializing stores
		if (!isNarrowingStore(storeType, val)) ptr_loads.put(ptr, storeType, val); // XXX: cache narrowing stores properly
		return apply;
	}
	def isNarrowingStore(storeType: Type, val: SsaInstr) -> bool {
		match (storeType) {
			x: PrimType => match (val.getType()) {
				y: PrimType => return x.width != y.width;
			}
		}
		return false;
	}
	def init(obj: SsaInstr, f: IrField, val: SsaInstr) {
		if (f.isConst() && !f.flags.F_POINTED_AT) pure_loads.put(obj, f, val);
		else impure_loads.put(obj, f, val);
	}
	def copy() -> SsaBlockState {
		var that = SsaBlockState.new();
		that.inbounds = this.inbounds;
		that.nonnull = this.nonnull;
		that.inits = this.inits;
		that.pure_loads.putv(this.pure_loads);
		that.impure_loads.putv(this.impure_loads);
		that.ptr_loads.putv(this.ptr_loads);
		return that;
	}
	def find(obj: SsaInstr, m: IrMember) -> SsaInstr {
		var r = find0(pure_loads, obj, m);
		if (r == null) r = find0(impure_loads, obj, m);
		return r;
	}
	def find0<T>(v: Vector<(SsaInstr, T, SsaInstr)>, obj: SsaInstr, m: T) -> SsaInstr {
		for (i < v.length) {
			var t = v[i];
			if (t.0 == obj && t.1 == m) return t.2;
		}
		return null;
	}
	def killField(f: IrField) {
		var v = impure_loads, i = 0;
		for (j < v.length) {
			var t = v[i];
			if (t.1 != f) {
				if (i != j) v[i] = t;
				i++;
			}
		}
		v.resize(i);
	}
	def killPointedAt() {
		var v = impure_loads, i = 0;
		for (j < v.length) {
			var t = v[i];
			if (!t.1.flags.F_POINTED_AT) {
				if (i != j) v[i] = t;
				i++;
			}
		}
		v.resize(i);
	}
	def killArrayElems() {
		ptr_loads.resize(0); // assume pointer loads could alias array elements.
	}
}
class SwitchCmp(val: int, cmp: SsaInstr, end: SsaIf, tSucc: SsaCfEdge, fSucc: SsaCfEdge) { }

def reducePhi(i_phi: SsaPhi) -> bool {
	var i0 = i_phi.input0(), facts = i0.facts, same = true;
	for (n = 1; n < i_phi.inputs.length; n++) {
		var iN = i_phi.inputs[n].dest;
		facts &= iN.facts;
		if (iN != i0 && iN != i_phi) same = false;
	}
	if (same) {
		// phi(x, phi, x...) => x
		i_phi.replace(i0);
		i_phi.remove();
		return false;
	}
	i_phi.facts |= facts;
	return true;
}

// Performs optimizations on loops.
// 1. eliminate rendundant bounds checks for induction variables.
// 2. XXX eliminate redundant null checks.
// 3. XXX loop rotation (move loop test condition to end of loop)
// 4. XXX loop-invariant code motion (move code out of loops)
// 5. XXX loop peeling (copy first iteration of loop)
// 6. XXX induction variable simplifications
// 7. XXX remove useless loops
class SsaLoopOptimizer {
	def graph: SsaGraph;
	def header: SsaBlock;	// start of loop (ends with loop condition)
	def loopBody: SsaBlock; // first block of loop body
	def loopEnd: SsaBlock;  // first block outside of loop
	def context: SsaContext;
	def headerMark = ++graph.markGen;
	def gvn = Gvn.new(graph);
	var marker: SsaExternalMarker;
	var blockOrdering: SsaBlockOrder;

	new(graph, header, loopBody, loopEnd, context) {
		marker = SsaExternalMarker.new();
		blockOrdering = SsaBlockOrder.new(graph, false, marker);
		blockOrdering.computeDominators();
	}

	def optimize() {
		// XXX: optimize phis in header first
		// XXX: pull loop-invariant code out of header
		var c = findLoopControl(), cond = c.0, condTrue = c.1;
		var ivs = findLinearIvs();
		for (l = ivs; l != null; l = l.tail) {
			var iv = l.head;
			if (cond != null) tryBoundingIv(iv, cond, condTrue);
		}

	}
	def licm() {
		if (context.shouldPrintLicm()) Terminal.putln("===== LICM =====");

		if (blockOrdering == null || blockOrdering.order == null || blockOrdering.order.length <= 1) return; 
		marker = SsaExternalMarker.!(blockOrdering.marker);
		// Go through each block; accumulate loop depth info; and hoist invariants
		var loopsInScope: Vector<SsaLoopInfo> = Vector<SsaLoopInfo>.new();
		var outermostLoopBlockMark: u31;
		for (i = 0; i < blockOrdering.order.length; i++) {
			def ssa: SsaBlock = blockOrdering.order[i];
			context.block = ssa;

			def ssaMark = (marker.getMark(ssa));
			for (curLink = ssa.next; curLink != SsaLink.!(ssa); curLink = curLink.next) {
				marker.setMark(curLink, u31.!(ssaMark));
			}
			// Case 1.) The block is the first block in the loop (header)
			if (ssa.info.loop != null) {
				def loopInfo: SsaLoopInfo = ssa.info.loop;
				loopsInScope.put(loopInfo);
				continue;
			}
			// Case 2.) The block is the exit node of the loop => need to update loopsInScope
			while (loopsInScope.length > 0 && loopsInScope[loopsInScope.length - 1].end == i) {
				def recentLoop: SsaLoopInfo = loopsInScope[loopsInScope.length-1];
				loopsInScope.resize(loopsInScope.length - 1);
			}
			// Case 3.) The block is not in a loop 
			if (loopsInScope.length == 0) continue;
			// Case 4.) The block is in the body of the loop 
			// Scan the block for invariants to hoist 
			if (blockDominatesExitsAndBackedge(ssa, loopsInScope[loopsInScope.length - 1])) {
				var nextLink: SsaLink;
				for (link = ssa.next; link != ssa; link = nextLink) {
					// Grab the next link in the current block. `link` could be hoisted elsewhere. 
					nextLink = link.next;
					if (link.facts.O_PURE && SsaApplyOp.?(link)) {
						//Hoist the instruction to outermostHoistLocation
						hoistInstrToOuterScope(blockOrdering.order, loopsInScope, SsaInstr.!(link), ssa);
					}
				}
			}
			
		}
		
	}

	def blockDominatesExitsAndBackedge(ssa: SsaBlock, loopInfo: SsaLoopInfo) -> bool {
		def header: SsaBlock = blockOrdering.order[loopInfo.start];
		// def exits: Array<SsaCfEdge> = Lists.toArray(loopInfo.exits);
		// Check that block dominates all exits except for the default exit. Only the header dominates default exit 
		for (exits = loopInfo.exits; exits != null; exits = exits.tail) {
			var exit = exits.head;
			// Ignore the default exit from the loop header 
			if (exit.src == header.end()) { 
				continue; 
			}
			def dominatesExit: bool = blockOrdering.isDominator(ssa.info, exit.dest.info);
			if (!dominatesExit) return false;
		}
		// Check that block dominates the block before the backedge 
		for (predEdge in header.preds) {
			def predBlock = SsaBlock.!(predEdge.src.next);
			// Ignore if the predecessor is outside of the loop 
			if (!loopInfo.contains(predBlock)) { continue; }
			// Check the current block dominates the predecessor 
			def dominatesPred: bool = blockOrdering.isDominator(ssa.info, predBlock.info);
			if (!dominatesPred) return false;
		}
		return true;
	}
	// Precondition: loopsInScope is a vector of the loops that ssa is nested in
	def hoistInstrToOuterScope(order: Vector<SsaBlock>, loopsInScope: Vector<SsaLoopInfo>, curInstr: SsaInstr, ssa: SsaBlock) {
		if (loopsInScope == null || loopsInScope.length == 0) return;
		// Get the mark of the start of the outermost loop. 
		// All inputs must be previously explored because they're dominators (perhaps not always strict dominators)
		def outerLoopBlockMark: u31 = u31.!(marker.getMark(order[loopsInScope[0].start])); 
		// Calculate the innermost depth
		// The outermost loop to hoist the instruction **outside of**. If we cannot hoist, then set the outermostHoistableLoop to null 
		var outermostHoistableLoop: SsaLoopInfo = loopsInScope[0];  
		for (input in curInstr.inputs) {
			// Case 1.) The input is outside of the loop 
			// Change this to instead check if the input block is actually before the start node of the first block (a dominator or predecessor)
			if (marker.getMark(input.dest) < outerLoopBlockMark) {continue;}
			// Case 2.) The input is within the loop 
			// Identify which loop the input is in; Note that instructions have the same mark as their block
			// Case on the input type to decide whether you need to find the location of the instruction
			match (input.dest) {
				instr: SsaParam => continue; 
				instr: SsaApplyOp => {
					outermostHoistableLoop = updateOuterMostHoistableLoopGivenInput(instr, order, loopsInScope, outermostHoistableLoop);
				}
				instr: SsaCheckpoint => continue;
				instr: SsaProbe => continue;
				instr: SsaNewVar => continue;
				instr: SsaUpdateVar => continue;
				instr: SsaDeleteVar => continue;
				instr: SsaConst =>  continue; 
				instr: SsaPhi => {
					outermostHoistableLoop = updateOuterMostHoistableLoopGivenInput(instr, order, loopsInScope, outermostHoistableLoop);
				}
			}

			// Instruction has input from innermost loop => cannot hoist
			if (outermostHoistableLoop == null) { return; }
		}
		// Hoistable case 
		// Remove the instruction from the current block 
		curInstr.remove();
		// Find the predecessor that's not in the loop (not a backedge)	
		def loopBlock: SsaBlock = order[outermostHoistableLoop.start];
		for (predCfEdge in loopBlock.preds) {
			def predEnd: SsaEnd = predCfEdge.src;
			if (marker.getMark(predEnd) < marker.getMark(loopBlock)) {
				def predBlock:SsaBlock = SsaBlock.!(predEnd.next);
				predBlock.append(curInstr);
				if (context.shouldPrintLicm()) {
					Terminal.put3("\tHoisting SsaInstr UID: %d | From SsaBlock UID: %d --> To SsaBlock UID: %d\n", curInstr.uid, ssa.uid, predBlock.uid);
					Terminal.put2("\t\tOrigin loop depth: %d | Hoist outside loop depth: %d\n", loopsInScope[loopsInScope.length-1].depth, outermostHoistableLoop.depth);
				}
				return;
			}
		}
	}
	// Constrain where the instruction-to-hoist can go based on where the inputInstr is. 
	// Note that the last element in loopsInScope is the same loop that the original instruction is in. 
	def updateOuterMostHoistableLoopGivenInput(inputInstr: SsaInstr, order: Vector<SsaBlock>, loopsInScope: Vector<SsaLoopInfo>, currentOutermostLoop: SsaLoopInfo) -> SsaLoopInfo {
		if (currentOutermostLoop == null) { return null; }
		var outermostHoistableLoop = currentOutermostLoop;
		def blockOfUse: SsaBlock  = order[marker.getMark(inputInstr)]; 
		for (i = 0; i < loopsInScope.length; i++) {
			// Input instr is in the same loop as the original 
			def loopInfo: SsaLoopInfo = loopsInScope[i];
			if ( i < loopsInScope.length - 1 && loopInfo.contains(blockOfUse) && loopInfo.depth >= outermostHoistableLoop.depth) {
				outermostHoistableLoop = loopsInScope[i+1];
			} else if (i == loopsInScope.length - 1 && loopInfo.contains(blockOfUse)) {
				outermostHoistableLoop  = null;
			}
		}

		return outermostHoistableLoop;
	}
	def tryBoundingIv(iv: SsaLinearIv, cond: SsaInstr, condTrue: bool) {
		var op: BoundOp;
		match (cond.optag()) {
			Opcode.IntLt.tag => op = BoundOp.Lt;
			Opcode.IntLteq.tag => op = BoundOp.Lteq;
			_ => return;
		}
		boundIvInequality(iv, op, cond, condTrue);
		optBoundedIv(iv);
	}
	def boundIvInequality(iv: SsaLinearIv, op: BoundOp, cond: SsaInstr, condTrue: bool) {
		iv.bound = cond.input1();
		if (iv.bound == iv.phi) {
			iv.bound = cond.input0();
			op = op.commute();
		}
		if (!condTrue) op = op.inverse();
		iv.boundOp = op;
	}
	// identify the control condition of the loop
	def findLoopControl() -> (SsaInstr, bool) {
		var e = header.end();
		if (SsaIf.?(e)) {
			var sw = SsaIf.!(e);
			if (sw.trueBlock() == loopBody) return (sw.input0(), true);
			if (sw.falseBlock() == loopBody) return (sw.input0(), false);
		}
		return (null, false);
	}
	// find simple induction variables of the form v = phi(v, v + N, v + N)
	def findLinearIvs() -> List<SsaLinearIv> {
		var list: List<SsaLinearIv>;
		var next = header.next;
		while (true) {
			if (!SsaPhi.?(next)) break;
			list = matchIv(SsaPhi.!(next), list);
			next = next.next;
		}
		return list;
	}
	// find a linear induction variable
	def matchIv(phi: SsaPhi, prev: List<SsaLinearIv>) -> List<SsaLinearIv> {
		var init: SsaInstr, step: Box<int>;
		for (i in phi.inputs) {
			var pi = i.dest;
			if (hasInput(pi, phi)) {
				// check increment matches in each induction
				var n = gvn.matchInc(pi);
				if (n == null) step = null;
				else if (step == null) step = n;
				else if (step.val != n.val) return prev;
			} else if (init != null) {
				if (pi != null) return prev;
			} else {
				init = pi;
			}
		}
		if (init == null || step == null) return prev;
		return List.new(SsaLinearIv.new(phi, init, step.val), prev);
	}
	// check whether x has i as one of its inputs
	def hasInput(x: SsaInstr, i: SsaInstr) -> bool {
		for (xi in x.inputs) {
			if (xi.dest == i) return true;
		}
		return false;
	}
	// optimize uses of a bounded linear induction variable
	def optBoundedIv(iv: SsaLinearIv) {
		if (iv.step > 0) {
			// XXX: what about uses before the condition is checked?
			iv.phi.setFact(iv.init.facts & iv.bound.facts & Fact.V_NON_NEGATIVE);
		}
		markHeader(headerMark); // XXX: only mark header once?
		for (u: Edge<SsaInstr> = iv.phi.useList; u != null; u = u.next) {
			var use = u.src;
			if (use.mark != headerMark) optBoundedIvUse(iv, use);
		}
		markHeader(-1);
	}
	def optBoundedIvUse(iv: SsaLinearIv, use: SsaInstr) {
		var opcode = use.optag();
		// XXX: optimize inequalities, especially MachOp.opUgteq
		if (opcode == Opcode.BoundsCheck.tag ||
		    opcode == Opcode.ArrayGetElem.tag ||
		    opcode == Opcode.ArraySetElem.tag) {
			if (use.input1() == iv.phi) optBoundsCheck(iv, use, use.input0());
		}
	}
	def optBoundsCheck(iv: SsaLinearIv, use: SsaInstr, array: SsaInstr) {
		match(iv.boundOp) {
			Lt, Lteq => {
				if (iv.step < 0) return; // must be counting up
				if (!iv.init.facts.V_NON_NEGATIVE) return; // init must be >= 0
				var isBounded = if(iv.boundOp == BoundOp.Lt, gvn.lteqArrayLength, gvn.ltArrayLength);
				if (isBounded(iv.bound, array)) use.setFact(Facts.O_SAFE_BOUNDS);
			}
			Gt, Gteq => {
				if (iv.step > 0) return; // must be counting down
				if (!iv.bound.facts.V_NON_NEGATIVE) return; // bound must be >= 0
				if (gvn.ltArrayLength(iv.init, array)) use.setFact(Facts.O_SAFE_BOUNDS);
			}
		}
	}
	// mark instructions in header, not in body or after loop end
	def markHeader(mark: int) {
		markBlocks(header, [loopBody, loopEnd], mark);
	}
	// mark instructions in body, not in header or after loop end
	def markBody(mark: int) {
		markBlocks(loopBody, [header, loopEnd], mark);
	}
	// mark all the blocks up to but not including [end] with the given mark
	def markBlocks(block: SsaBlock, end: Array<SsaBlock>, mark: int) {
		for (e in end) if (block == e) return; // reached an end block
		if (block.mark == mark) return; // already marked
		block.mark = mark;
		markBlockInstrs(block, mark); // mark phis and instructions block
		for (s in block.succs()) markBlocks(s.dest, end, mark); // recursively mark successors
	}
	// mark all the instructions in a block with a given mark
	def markBlockInstrs(block: SsaBlock, mark: int) {
		for (i = block.next; i != block; i = i.next) i.mark = mark;
	}
}
// an induction variable "x = I + N * i" with optional bound of the form
// x <op> bound, e.g. x < a.length, x >= 3, etc
class SsaLinearIv {
	def phi: SsaPhi;	// x
	def init: SsaInstr;	// I
	def step: int;		// N
	var boundOp: BoundOp;	// operator of bound
	var bound: SsaInstr;	// value of bound
	new(phi, init, step) {}
}
type BoundOp {
	case Lt;
	case Lteq;
	case Gt;
	case Gteq;
	def inverse() -> BoundOp {
		match (this) {
			Lt => return BoundOp.Gteq;
			Lteq => return BoundOp.Gt;
			Gt => return BoundOp.Lteq;
			Gteq => return BoundOp.Lt;
		}
	}
	def commute() -> BoundOp {
		match (this) {
			Lt => return BoundOp.Gt;
			Lteq => return BoundOp.Gteq;
			Gt => return BoundOp.Lt;
			Gteq => return BoundOp.Lteq;
		}
	}
}

// Arguments passed Eval.doOp() when constant-folding operators.
class FoldingArguments(prog: Program) extends Arguments {
	var apply: SsaApplyOp;
	var thrown: Exception;
	var not_foldable: bool;

	def reset(a: SsaApplyOp) -> this {
		this.apply = a;
		var inputs = apply.inputs; 
		var arity = inputs.length;
		var a = vals_storage;
		if (arity > a.length) a = vals_storage = Array.new(a.length + arity + 16); // XXX: move to Arguments
		for (i < inputs.length) match (inputs[i].dest) {
			x: SsaConst => a[i] = x.val;
			_ => a[i] = Values.BOTTOM;
		}
		vals = vals_storage[0 ... arity];
		not_foldable = false;
		thrown = null;
	}
	def notFoldable(msg: string) -> Result {
		not_foldable = true;
		return null;
	}
	def getTypeArg(i: int) -> Type {
		return apply.op.typeArgs[i];
	}
	def getTypeArgs() -> Array<Type> {
		return Arrays.dup(apply.op.typeArgs);
	}
	def getProgram() -> Program {
		return prog;
	}
	def tailCall(spec: IrSpec, recvr: Val, startArg: int, endArg: int) -> Result {
		not_foldable = true;
		return null;
	}
	def throw(ex: string, msg: string) -> Exception {
		return thrown = Exception.new(ex, msg, List.new(apply.source, null));
	}
}
