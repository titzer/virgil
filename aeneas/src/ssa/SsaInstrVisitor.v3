// A visitor over SSA instructions, with one method per kind of instruction and,
// through {OpcodeVisitor}, one method per opcode for {SsaApplyOp} instructions.
class SsaInstrVisitor extends OpcodeVisitor {
	var instr: SsaInstr;	// the instruction currently being visited
	var apply: SsaApplyOp;	// the current apply instruction

	def visit(i: SsaInstr) {
		instr = i;
		apply = null;
		match (i) {
			x: SsaApplyOp => { apply = x; visitApplyOp(x); }
			x: SsaConst => visitConst(x);
			x: SsaParam => visitParam(x);
			x: SsaPhi => visitPhi(x);
			x: SsaCheckpoint => visitCheckpoint(x);
			x: SsaProbe => visitProbe(x);
			x: SsaNewVar => visitNewVar(x);
			x: SsaDeleteVar => visitDeleteVar(x);
			x: SsaUpdateVar => visitUpdateVar(x);
			x: SsaThrow => visitThrow(x);
			x: SsaReturn => visitReturn(x);
			x: SsaIf => visitIf(x);
			x: SsaSwitch => visitSwitch(x);
			x: SsaGoto => visitGoto(x);
			x: SsaEnd => visitEnd(x);
			_ => visitDefault(i);
		}
	}
	def visitBlock(block: SsaBlock) {
		for (i = block.next; i != block; ) {
			var next = i.next;
			visit(SsaInstr.!(i));
			i = next;
		}
	}
	def visitDefault(i: SsaInstr)		{ }
	def visitDefaultOp(op: Operator)	{ visitDefault(apply); }
	def visitApplyOp(i: SsaApplyOp)		{ visitOp(i.op); }
	def visitConst(i: SsaConst)		{ visitDefault(i); }
	def visitParam(i: SsaParam)		{ visitDefault(i); }
	def visitPhi(i: SsaPhi)			{ visitDefault(i); }
	def visitCheckpoint(i: SsaCheckpoint)	{ visitDefault(i); }
	def visitProbe(i: SsaProbe)		{ visitDefault(i); }
	def visitNewVar(i: SsaNewVar)		{ visitDefault(i); }
	def visitDeleteVar(i: SsaDeleteVar)	{ visitDefault(i); }
	def visitUpdateVar(i: SsaUpdateVar)	{ visitDefault(i); }
	// Visit methods for ends
	def visitEnd(i: SsaEnd)			{ visitDefault(i); }
	def visitThrow(i: SsaThrow)		{ visitEnd(i); }
	def visitReturn(i: SsaReturn)		{ visitEnd(i); }
	def visitIf(i: SsaIf)			{ visitEnd(i); }
	def visitSwitch(i: SsaSwitch)		{ visitEnd(i); }
	def visitGoto(i: SsaGoto)		{ visitEnd(i); }
}
