			var noffset = offset + scale * index;
			if (ref == null) return ByteArrayOffset.new(null, noffset);
			return ByteArrayOffset.new(ref.array, ref.offset + noffset);
		}
		RefLayoutGetRepeatedField(_, offset, scale, max, order, fieldType) => {
			var ref = args.ref(0);
			var index = args.i(1);
			if (u32.view(index) >= u32.view(max)) return args.throw(V3Exception.BoundsCheck, null);
			return doRefLayoutGetField(args, PrimType.!(args.inst(fieldType)), ref, offset + scale * index, order);
		}
		RefLayoutSetRepeatedField(_, offset, scale, max, order, fieldType) => {
			var ref = args.ref(0);
			var index = args.i(1);
			if (u32.view(index) >= u32.view(max)) return args.throw(V3Exception.BoundsCheck, null);
			return doRefLayoutSetField(args, PrimType.!(args.inst(fieldType)), ref, offset + scale * index, order, args.vals[2]);
		}
		ByteArrayGetField(fieldType, _, offset, order) => {
			var array = args.r(0);
			var i_offset: int;
			match (args.vals[1]) {
				x: ArrayRangeStart => i_offset = x.start;
				x: PointerRangeStart => return args.throw(V3Exception.NullCheck, null); // null-based ref
				_ => i_offset = args.i(1);
			}
			// XXX: Refactor so no intermediate ByteArrayOffset object needed
			return doRefLayoutGetField(args, PrimType.!(args.inst(fieldType)), ByteArrayOffset.new(array, offset), i_offset, order);
		}
		ByteArraySetField(fieldType, _, offset, order) => {
			var array = args.r(0);
			var i_offset: int;
			match (args.vals[1]) {
				x: ArrayRangeStart => i_offset = x.start;
				x: PointerRangeStart => return args.throw(V3Exception.NullCheck, null); // null-based ref
				_ => i_offset = args.i(1);
			}
			// XXX: Refactor so no intermediate ByteArrayOffset object needed
			return doRefLayoutSetField(args, PrimType.!(args.inst(fieldType)), ByteArrayOffset.new(array, offset), i_offset, order, args.vals[2]);
		}

//----------------------------------------------------------------------------
		PtrAdd(t, _) => {
			var base = args.vals[0], loff = args.l(1), off = int.view(loff);
			if (off != loff) return args.notFoldable("pointer offset too large");
			if (off == 0) return base;
			match (base) {
				null => if (off > 0) {
					// a null range start is index 0 of an array, not an address
					if (t.typeCon.kind == Kind.RANGE_START) return Int.box(off);
					var addr = Addr.new(null, null, off);
					addr.absolute = off;
					return addr;
				}
				x: Addr => return x.add(off);
				x: Box<int> => return Int.box(x.val + off); // XXX: PtrAdd could be used with a RangeStart
				_ => ;
			}
			return args.notFoldable("not a pointer");
		}
		PtrSub(_, it) => {
			var msg = "unfoldable pointer subtraction";
			var it = it, a = args.vals[0], b = args.vals[1];
			if (a == b) return Int.ZERO;
			if (CiRuntime_Address.?(a) || !Addr.?(a)) return args.notFoldable(msg);
			var p = Addr.!(a);
			if (b == null && p.base == null) return it.box(p.offset);
			if (CiRuntime_Address.?(b) || !Addr.?(b)) return args.notFoldable(msg);
			var q = Addr.!(b);
			if (p.base == q.base) return it.box(p.offset - q.offset);
			if (p.base == q) return it.box(p.offset);
			return args.notFoldable(msg);
		}
//----------------------------------------------------------------------------
		SystemCall(syscall, _, _) => {
			var prog = args.getProgram();
			var sys = prog.system;
			if (sys == null) prog.system = sys = SystemCallState.new();
			return syscall.eval(sys, args);
		}
//----------------------------------------------------------------------------
		WasmFunctionId => {
			var prog = args.getProgram();
			var del = Closure.!(args.vals[0]);
			if (del == null) return args.throw(V3Exception.NullCheck, null);
			return Int.box(prog.makeFunctionId(del.memberRef));
		}
		KillRegisters => return Values.BOTTOM; // nop
		ForceGc => return Values.BOTTOM; // nop; no GC in the interpreter
		_ => ;
	}
	return args.unimplemented();
}

def doRefLayoutGetField(args: Arguments, fieldType: PrimType, ref: ByteArrayOffset, offset: int, order: ByteOrder) -> Result {
	if (ref == null || ref.array == null) return args.throw(V3Exception.NullCheck, null);
	var v = ref.read(order, offset, fieldType.packedByteSize);
	match (fieldType) {
		x: BoolType => {
			return Bool.box((v & 1) != 0);
		}
		x: IntType => {
			match (x.rank) {
				SUBI32 =>	return Int.box(int.view(v) << x.ishift >> x.ishift);
				SUBU32 =>	return Int.box(int.view(v) << x.ishift >>> x.ishift);
				I32, U32 =>	return Int.box(int.view(v));
				SUBI64 =>	return Long.box(long.view(v) << x.lshift >> x.lshift);
				SUBU64 =>	return Long.box(long.view(v) << x.lshift >>> x.lshift);
				I64, U64 =>	return Long.box(long.view(v));
			}
		}
		x: EnumType => {
			if (v >= x.enumDecl.cases.length) v = 0; // out-of-bounds tag => 0
			return Int.box(int.view(v)); // note: no long enum values
		}
		x: FloatType => {
			if (x.is64) return Float64Val.new(v);
			else return Float32Val.new(u32.view(v));
		}
		_ => return args.throw("EvalException", Strings.format1("invalid RefLayoutField type %q", fieldType.render));
	}
}
def doRefLayoutSetField(args: Arguments, fieldType: PrimType, ref: ByteArrayOffset, offset: int, order: ByteOrder, val: Val) -> Result {
	if (ref == null || ref.array == null) return args.throw(V3Exception.NullCheck, null);
	var bits: u64 = 0, signed = false;
	match (val) {
		v: Box<bool> =>		bits = if(v.val, 1, 0);
		v: Box<int> =>		bits = u32.view(v.val);
		v: Box<long> =>		bits = u64.view(v.val);
		v: Float32Val =>	bits = v.bits;
		v: Float64Val =>	bits = v.bits;
	}
	ref.write(order, offset, fieldType.packedByteSize, bits);
	return Values.BOTTOM;
}

def convert_d(itt: IntType, d: double) -> (Val, /*saturated*/bool, /*rounded*/bool) {
	if (d >= Float.FLOAT64.maxplus1d(itt)) return (itt.max, true, false);
	if (d < Float.FLOAT64.mind(itt)) return (itt.min, true, false);
	match (itt.rank) {
		SUBI32, I32 => {
			var iv = int.truncd(d), v = Int.box(iv);
			if (u64.view(double.roundi(iv)) == u64.view(d)) return (v, false, false);
			return (v, false, true);
		}
		SUBU32, U32 => {
			var iv = u32.truncd(d), v = Int.box(int.view(iv));
			if (u64.view(double.roundi(iv)) == u64.view(d)) return (v, false, false);
			return (v, false, true);
		}
		SUBI64, I64 => {
			var iv = long.truncd(d), v = Long.box(iv);
			if (u64.view(double.roundi(iv)) == u64.view(d)) return (v, false, false);
			return (v, false, true);
		}
		SUBU64, U64 => {
			var iv = u64.truncd(d), v = Long.box(long.view(iv));
			if (u64.view(double.roundi(iv)) == u64.view(d)) return (v, false, false);
			return (v, false, true);
		}
	}
}

def boxf(f: float) -> Val { return Float32Val.new(u32.view(f)); }
def boxd(d: double) -> Val { return Float64Val.new(u64.view(d)); }
def fround_i(isDouble: bool, itt: IntType, v: Val) -> (Val, /*rounded*/bool) {
	match (itt.rank) {
		SUBI32, I32 => {
			var iv = Int.unbox(v);
			if (isDouble) { var d = double.roundi(iv); return (boxd(d), false); }
			else { var f = float.roundi(iv); return (boxf(f), iv == int.max || iv != int.truncf(f)); }
		}
		SUBU32, U32 => {
			var iv = u32.view(Int.unbox(v));
			if (isDouble) { var d = double.roundi(iv); return (boxd(d), false); }
			else { var f = float.roundi(iv); return (boxf(f), iv == u32.max || iv != u32.truncf(f)); }
		}
		SUBI64, I64 => {
			var iv = Long.unboxSU(v, true), ismax = iv == long.max;
			if (isDouble) { var d = double.roundi(iv); return (boxd(d), ismax || iv != long.truncd(d)); }
			else { var f = float.roundi(iv); return (boxf(f), ismax || iv != long.truncf(f)); }
		}
		SUBU64, U64 => {
			var iv = u64.view(Long.unboxSU(v, false)), ismax = iv == u64.max;
			if (isDouble) { var d = double.roundi(iv); return (boxd(d), ismax || iv != u64.truncd(d)); }
			else { var f = float.roundi(iv); return (boxf(f), ismax || iv != u64.truncf(f)); }
		}
	}
}
def lookupMtable(args: Arguments, object: Record, mtable: IrMtable, typeArgs: Array<Type>) -> IrSpec {
	var receiver = object.rtype;
	var ic = args.getProgram().ir.makeIrClass(receiver);
	var id = ic.minClassId - mtable.rootId;
	var typeArgs = Arrays.dup(typeArgs);
	typeArgs[0] = receiver;
	return IrSpec.new(receiver, typeArgs, mtable.table[id]);
}
def lookupVtable(args: Arguments, object: Record, spec: IrSpec) -> IrSpec {
	return args.getProgram().ir.resolveMethodImpl(object.rtype, spec);
}
def getRecordReceiver(args: Arguments) -> Record {
	// TODO: this a giant hack for adapting arguments to void calls
	var r = args.vals[0];
	if (Record.?(r)) return Record.!(r);
	if (BoxVal.?(r)) return Record.!(BoxVal.!(r).values[0]);
	if (r != null) args.throw(V3Exception.InternalError, "expected record receiver for call");
	return null;
}
def getReceiver(args: Arguments) -> Val {
	// TODO: this a giant hack for adapting arguments to void calls
	var r = args.vals[0];
	if (BoxVal.?(r)) return BoxVal.!(r).values[0];
	return r;
}
