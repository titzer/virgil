// A visitor over operators with one method per opcode. The dispatch method {visitOp}
// matches on the opcode of an operator and passes the opcode, typed as its specific case,
// to the opcode-specific method, which reads the types it needs from the opcode's fields
// (e.g. {opcode.t} of {Opcode.IntAdd} is an {IntType}).
//
// Every opcode method defaults to calling {visitDefaultOp}, so a subclass only needs
// to override the opcodes (and/or the default) that it handles. Parts of the compiler
// that match on opcodes, such as reachability analysis, normalization, and machine
// lowering, can be expressed as subclasses of this visitor.
class OpcodeVisitor {
	var op: Operator; // the operator currently being visited

	// Dispatch on the opcode of {op}.
	def visitOp(op: Operator) {
		this.op = op;
		match (op.opcode) {
			x: Opcode.BoolEq =>			visitBoolEq(x);
			x: Opcode.BoolAnd =>			visitBoolAnd(x);
			x: Opcode.BoolOr =>			visitBoolOr(x);
			x: Opcode.BoolNot =>			visitBoolNot(x);
			x: Opcode.IntEq =>			visitIntEq(x);
			x: Opcode.IntAdd =>			visitIntAdd(x);
			x: Opcode.IntSub =>			visitIntSub(x);
			x: Opcode.IntMul =>			visitIntMul(x);
			x: Opcode.IntDiv =>			visitIntDiv(x);
			x: Opcode.IntMod =>			visitIntMod(x);
			x: Opcode.IntAnd =>			visitIntAnd(x);
			x: Opcode.IntOr =>			visitIntOr(x);
			x: Opcode.IntXor =>			visitIntXor(x);
			x: Opcode.IntShl =>			visitIntShl(x);
			x: Opcode.IntSar =>			visitIntSar(x);
			x: Opcode.IntShr =>			visitIntShr(x);
			x: Opcode.IntLt =>			visitIntLt(x);
			x: Opcode.IntLteq =>			visitIntLteq(x);
			x: Opcode.IntWide =>			visitIntWide(x);
			x: Opcode.FloatAdd =>			visitFloatAdd(x);
			x: Opcode.FloatSub =>			visitFloatSub(x);
			x: Opcode.FloatMul =>			visitFloatMul(x);
			x: Opcode.FloatDiv =>			visitFloatDiv(x);
			x: Opcode.FloatBitEq =>			visitFloatBitEq(x);
			x: Opcode.FloatEq =>			visitFloatEq(x);
			x: Opcode.FloatNe =>			visitFloatNe(x);
			x: Opcode.FloatLt =>			visitFloatLt(x);
			x: Opcode.FloatLteq =>			visitFloatLteq(x);
			x: Opcode.FloatAbs =>			visitFloatAbs(x);
			x: Opcode.FloatCeil =>			visitFloatCeil(x);
			x: Opcode.FloatFloor =>			visitFloatFloor(x);
			x: Opcode.FloatSqrt =>			visitFloatSqrt(x);
			x: Opcode.IntCastF =>			visitIntCastF(x);
			x: Opcode.IntQueryF =>			visitIntQueryF(x);
			x: Opcode.IntViewI =>			visitIntViewI(x);
			x: Opcode.IntViewB =>			visitIntViewB(x);
			x: Opcode.IntViewP =>			visitIntViewP(x);
			x: Opcode.EnumViewI =>			visitEnumViewI(x);
			x: Opcode.EnumSetViewI =>		visitEnumSetViewI(x);
			x: Opcode.IntViewF =>			visitIntViewF(x);
			x: Opcode.IntTruncF =>			visitIntTruncF(x);
			x: Opcode.FloatCastI =>			visitFloatCastI(x);
			x: Opcode.FloatCastD =>			visitFloatCastD(x);
			x: Opcode.FloatQueryI =>		visitFloatQueryI(x);
			x: Opcode.FloatQueryD =>		visitFloatQueryD(x);
			x: Opcode.FloatPromoteI =>		visitFloatPromoteI(x);
			x: Opcode.FloatPromoteF =>		visitFloatPromoteF(x);
			x: Opcode.FloatViewI =>			visitFloatViewI(x);
			x: Opcode.FloatRoundI =>		visitFloatRoundI(x);
			x: Opcode.FloatRound =>			visitFloatRound(x);
			x: Opcode.FloatRoundD =>		visitFloatRoundD(x);
			x: Opcode.RefEq =>			visitRefEq(x);
			x: Opcode.DefaultValue =>		visitDefaultValue(x);
			x: Opcode.TupleCreate =>		visitTupleCreate(x);
			x: Opcode.TupleGetElem =>		visitTupleGetElem(x);
			x: Opcode.ArrayAlloc =>			visitArrayAlloc(x);
			x: Opcode.ArrayFill =>			visitArrayFill(x);
			x: Opcode.ArrayInit =>			visitArrayInit(x);
			x: Opcode.ArrayTupleInit =>		visitArrayTupleInit(x);
			x: Opcode.ArrayGetElem =>		visitArrayGetElem(x);
			x: Opcode.ArraySetElem =>		visitArraySetElem(x);
			x: Opcode.ArrayGetElemElem =>		visitArrayGetElemElem(x);
			x: Opcode.ArraySetElemElem =>		visitArraySetElemElem(x);
			x: Opcode.ArrayGetLength =>		visitArrayGetLength(x);
			x: Opcode.RangeFromTo =>		visitRangeFromTo(x);
			x: Opcode.RangeFromPlus =>		visitRangeFromPlus(x);
			x: Opcode.RangeGetElem =>		visitRangeGetElem(x);
			x: Opcode.RangeSetElem =>		visitRangeSetElem(x);
			x: Opcode.RangeGetLength =>		visitRangeGetLength(x);
			x: Opcode.RangeStartPlusIndex =>	visitRangeStartPlusIndex(x);
			x: Opcode.NormRangeGetElem =>		visitNormRangeGetElem(x);
			x: Opcode.NormRangeGetElemElem =>	visitNormRangeGetElemElem(x);
			x: Opcode.NormRangeSetElem =>		visitNormRangeSetElem(x);
			x: Opcode.NormRangeSetElemElem =>	visitNormRangeSetElemElem(x);
			x: Opcode.Init =>			visitInit(x);
			x: Opcode.ComponentGetField =>		visitComponentGetField(x);
			x: Opcode.ComponentSetField =>		visitComponentSetField(x);
			x: Opcode.ClassAlloc =>			visitClassAlloc(x);
			x: Opcode.ClassAllocWithDescriptor =>	visitClassAllocWithDescriptor(x);
			x: Opcode.ClassNew =>			visitClassNew(x);
			x: Opcode.ClassGetField =>		visitClassGetField(x);
			x: Opcode.ClassInitField =>		visitClassInitField(x);
			x: Opcode.ClassSetField =>		visitClassSetField(x);
			x: Opcode.ClassGetMethod =>		visitClassGetMethod(x);
			x: Opcode.ClassGetVirtual =>		visitClassGetVirtual(x);
			x: Opcode.ClassGetSelector =>		visitClassGetSelector(x);
			x: Opcode.VariantEq =>			visitVariantEq(x);
			x: Opcode.VariantGetTag =>		visitVariantGetTag(x);
			x: Opcode.VariantRepTag =>		visitVariantRepTag(x);
			x: Opcode.VariantGetRepTag =>		visitVariantGetRepTag(x);
			x: Opcode.VariantAlloc =>		visitVariantAlloc(x);
			x: Opcode.VariantGetField =>		visitVariantGetField(x);
			x: Opcode.VariantGetMethod =>		visitVariantGetMethod(x);
			x: Opcode.VariantGetVirtual =>		visitVariantGetVirtual(x);
			x: Opcode.VariantGetSelector =>		visitVariantGetSelector(x);
			x: Opcode.NullCheck =>			visitNullCheck(x);
			x: Opcode.BoundsCheck =>		visitBoundsCheck(x);
			x: Opcode.DescriptorCheck =>		visitDescriptorCheck(x);
			x: Opcode.ConditionalThrow =>		visitConditionalThrow(x);
			x: Opcode.OverloadedEq =>		visitOverloadedEq(x);
			x: Opcode.TypeCast =>			visitTypeCast(x);
			x: Opcode.TypeQuery =>			visitTypeQuery(x);
			x: Opcode.TypeSubsume =>		visitTypeSubsume(x);
			x: Opcode.CallMethod =>			visitCallMethod(x);
			x: Opcode.CallClassMethod =>		visitCallClassMethod(x);
			x: Opcode.CallClassVirtual =>		visitCallClassVirtual(x);
			x: Opcode.CallClassSelector =>		visitCallClassSelector(x);
			x: Opcode.CallVariantVirtual =>		visitCallVariantVirtual(x);
			x: Opcode.CallVariantSelector =>	visitCallVariantSelector(x);
			x: Opcode.CallClosure =>		visitCallClosure(x);
			x: Opcode.CallFunction =>		visitCallFunction(x);
			x: Opcode.CreateClosure =>		visitCreateClosure(x);
			x: Opcode.ForgeClosure =>		visitForgeClosure(x);
			x: Opcode.UnpackClosure =>		visitUnpackClosure(x);
			x: Opcode.ReturnTo =>			visitReturnTo(x);
			x: Opcode.RefLayoutAt =>		visitRefLayoutAt(x);
			x: Opcode.RefLayoutOf =>		visitRefLayoutOf(x);
			x: Opcode.RefLayoutIn =>		visitRefLayoutIn(x);
			x: Opcode.RefLayoutGetField =>		visitRefLayoutGetField(x);
			x: Opcode.RefLayoutSetField =>		visitRefLayoutSetField(x);
			x: Opcode.RefLayoutAtRepeatedField =>	visitRefLayoutAtRepeatedField(x);
			x: Opcode.RefLayoutGetRepeatedField =>	visitRefLayoutGetRepeatedField(x);
			x: Opcode.RefLayoutSetRepeatedField =>	visitRefLayoutSetRepeatedField(x);
			x: Opcode.ByteArrayGetField =>		visitByteArrayGetField(x);
			x: Opcode.ByteArraySetField =>		visitByteArraySetField(x);
			x: Opcode.ForgeRange =>			visitForgeRange(x);
			x: Opcode.SetAuxTag =>			visitSetAuxTag(x);
			x: Opcode.GetAuxTag =>			visitGetAuxTag(x);
			x: Opcode.SetRefTag =>			visitSetRefTag(x);
			x: Opcode.GetRefTag =>			visitGetRefTag(x);
			x: Opcode.SetDescriptorExtension =>	visitSetDescriptorExtension(x);
			x: Opcode.SystemCall =>			visitSystemCall(x);
			x: Opcode.VstSugar =>			visitVstSugar(x);
			x: Opcode.PtrAdd =>			visitPtrAdd(x);
			x: Opcode.PtrSub =>			visitPtrSub(x);
			x: Opcode.PtrLt =>			visitPtrLt(x);
			x: Opcode.PtrLteq =>			visitPtrLteq(x);
			x: Opcode.PtrAtContents =>		visitPtrAtContents(x);
			x: Opcode.PtrAtLength =>		visitPtrAtLength(x);
			x: Opcode.PtrAtObject =>		visitPtrAtObject(x);
			x: Opcode.PtrAtRangeElem =>		visitPtrAtRangeElem(x);
			x: Opcode.PtrAtArrayElem =>		visitPtrAtArrayElem(x);
			x: Opcode.PtrAtEnd =>			visitPtrAtEnd(x);
			x: Opcode.PtrAtRef =>			visitPtrAtRef(x);
			x: Opcode.PtrAtComponentField =>	visitPtrAtComponentField(x);
			x: Opcode.PtrAtObjectField =>		visitPtrAtObjectField(x);
			x: Opcode.PtrAtRefLayoutField =>	visitPtrAtRefLayoutField(x);
			x: Opcode.PtrAtUnboxedObjectField =>	visitPtrAtUnboxedObjectField(x);
			x: Opcode.PtrAtUnboxedComponentField =>	visitPtrAtUnboxedComponentField(x);
			x: Opcode.PtrCmpSwp =>			visitPtrCmpSwp(x);
			x: Opcode.PtrLoad =>			visitPtrLoad(x);
			x: Opcode.PtrStore =>			visitPtrStore(x);
			x: Opcode.PtrAddRangeStart =>		visitPtrAddRangeStart(x);
			x: Opcode.CallerIp =>			visitCallerIp(x);
			x: Opcode.CallerSp =>			visitCallerSp(x);
			x: Opcode.Alloc =>			visitAlloc(x);
			x: Opcode.WasmFunctionTypeId =>		visitWasmFunctionTypeId(x);
			x: Opcode.WasmFunctionId =>		visitWasmFunctionId(x);
			x: Opcode.KillRegisters =>		visitKillRegisters(x);
			x: Opcode.ForceGc =>			visitForceGc(x);
			x: Opcode.CallAddress =>		visitCallAddress(x);
			x: Opcode.CallKernel =>			visitCallKernel(x);
		}
	}

	// Called by every opcode method that is not overridden.
	def visitDefaultOp(op: Operator)				{ }
	// Boolean operators
	def visitBoolEq(opcode: Opcode.BoolEq)				{ visitDefaultOp(op); }
	def visitBoolAnd(opcode: Opcode.BoolAnd)			{ visitDefaultOp(op); }
	def visitBoolOr(opcode: Opcode.BoolOr)				{ visitDefaultOp(op); }
	def visitBoolNot(opcode: Opcode.BoolNot)			{ visitDefaultOp(op); }
	// Integer arithmetic and conversions
	def visitIntEq(opcode: Opcode.IntEq)				{ visitDefaultOp(op); }
	def visitIntAdd(opcode: Opcode.IntAdd)				{ visitDefaultOp(op); }
	def visitIntSub(opcode: Opcode.IntSub)				{ visitDefaultOp(op); }
	def visitIntMul(opcode: Opcode.IntMul)				{ visitDefaultOp(op); }
	def visitIntDiv(opcode: Opcode.IntDiv)				{ visitDefaultOp(op); }
	def visitIntMod(opcode: Opcode.IntMod)				{ visitDefaultOp(op); }
	def visitIntAnd(opcode: Opcode.IntAnd)				{ visitDefaultOp(op); }
	def visitIntOr(opcode: Opcode.IntOr)				{ visitDefaultOp(op); }
	def visitIntXor(opcode: Opcode.IntXor)				{ visitDefaultOp(op); }
	def visitIntShl(opcode: Opcode.IntShl)				{ visitDefaultOp(op); }
	def visitIntSar(opcode: Opcode.IntSar)				{ visitDefaultOp(op); }
	def visitIntShr(opcode: Opcode.IntShr)				{ visitDefaultOp(op); }
	def visitIntLt(opcode: Opcode.IntLt)				{ visitDefaultOp(op); }
	def visitIntLteq(opcode: Opcode.IntLteq)			{ visitDefaultOp(op); }
	def visitIntWide(opcode: Opcode.IntWide)			{ visitDefaultOp(op); }
	// Floating point arithmetic
	def visitFloatAdd(opcode: Opcode.FloatAdd)			{ visitDefaultOp(op); }
	def visitFloatSub(opcode: Opcode.FloatSub)			{ visitDefaultOp(op); }
	def visitFloatMul(opcode: Opcode.FloatMul)			{ visitDefaultOp(op); }
	def visitFloatDiv(opcode: Opcode.FloatDiv)			{ visitDefaultOp(op); }
	def visitFloatBitEq(opcode: Opcode.FloatBitEq)			{ visitDefaultOp(op); }
	def visitFloatEq(opcode: Opcode.FloatEq)			{ visitDefaultOp(op); }
	def visitFloatNe(opcode: Opcode.FloatNe)			{ visitDefaultOp(op); }
	def visitFloatLt(opcode: Opcode.FloatLt)			{ visitDefaultOp(op); }
	def visitFloatLteq(opcode: Opcode.FloatLteq)			{ visitDefaultOp(op); }
	def visitFloatAbs(opcode: Opcode.FloatAbs)			{ visitDefaultOp(op); }
	def visitFloatCeil(opcode: Opcode.FloatCeil)			{ visitDefaultOp(op); }
	def visitFloatFloor(opcode: Opcode.FloatFloor)			{ visitDefaultOp(op); }
	def visitFloatSqrt(opcode: Opcode.FloatSqrt)			{ visitDefaultOp(op); }
	// Integer casts and conversions
	def visitIntCastF(opcode: Opcode.IntCastF)			{ visitDefaultOp(op); }
	def visitIntQueryF(opcode: Opcode.IntQueryF)			{ visitDefaultOp(op); }
	def visitIntViewI(opcode: Opcode.IntViewI)			{ visitDefaultOp(op); }
	def visitIntViewB(opcode: Opcode.IntViewB)			{ visitDefaultOp(op); }
	def visitIntViewP(opcode: Opcode.IntViewP)			{ visitDefaultOp(op); }
	def visitEnumViewI(opcode: Opcode.EnumViewI)			{ visitDefaultOp(op); }
	def visitEnumSetViewI(opcode: Opcode.EnumSetViewI)		{ visitDefaultOp(op); }
	def visitIntViewF(opcode: Opcode.IntViewF)			{ visitDefaultOp(op); }
	def visitIntTruncF(opcode: Opcode.IntTruncF)			{ visitDefaultOp(op); }
	// Floating point casts and conversions
	def visitFloatCastI(opcode: Opcode.FloatCastI)			{ visitDefaultOp(op); }
	def visitFloatCastD(opcode: Opcode.FloatCastD)			{ visitDefaultOp(op); }
	def visitFloatQueryI(opcode: Opcode.FloatQueryI)		{ visitDefaultOp(op); }
	def visitFloatQueryD(opcode: Opcode.FloatQueryD)		{ visitDefaultOp(op); }
	def visitFloatPromoteI(opcode: Opcode.FloatPromoteI)		{ visitDefaultOp(op); }
	def visitFloatPromoteF(opcode: Opcode.FloatPromoteF)		{ visitDefaultOp(op); }
	def visitFloatViewI(opcode: Opcode.FloatViewI)			{ visitDefaultOp(op); }
	def visitFloatRoundI(opcode: Opcode.FloatRoundI)		{ visitDefaultOp(op); }
	def visitFloatRound(opcode: Opcode.FloatRound)			{ visitDefaultOp(op); }
	def visitFloatRoundD(opcode: Opcode.FloatRoundD)		{ visitDefaultOp(op); }
	// Reference equality
	def visitRefEq(opcode: Opcode.RefEq)				{ visitDefaultOp(op); }
	// Default value operator
	def visitDefaultValue(opcode: Opcode.DefaultValue)		{ visitDefaultOp(op); }
	// Tuple operations
	def visitTupleCreate(opcode: Opcode.TupleCreate)		{ visitDefaultOp(op); }
	def visitTupleGetElem(opcode: Opcode.TupleGetElem)		{ visitDefaultOp(op); }
	// Array operations
	def visitArrayAlloc(opcode: Opcode.ArrayAlloc)			{ visitDefaultOp(op); }
	def visitArrayFill(opcode: Opcode.ArrayFill)			{ visitDefaultOp(op); }
	def visitArrayInit(opcode: Opcode.ArrayInit)			{ visitDefaultOp(op); }
	def visitArrayTupleInit(opcode: Opcode.ArrayTupleInit)		{ visitDefaultOp(op); }
	def visitArrayGetElem(opcode: Opcode.ArrayGetElem)		{ visitDefaultOp(op); }
	def visitArraySetElem(opcode: Opcode.ArraySetElem)		{ visitDefaultOp(op); }
	def visitArrayGetElemElem(opcode: Opcode.ArrayGetElemElem)	{ visitDefaultOp(op); }
	def visitArraySetElemElem(opcode: Opcode.ArraySetElemElem)	{ visitDefaultOp(op); }
	def visitArrayGetLength(opcode: Opcode.ArrayGetLength)		{ visitDefaultOp(op); }
	// Range operations
	def visitRangeFromTo(opcode: Opcode.RangeFromTo)		{ visitDefaultOp(op); }
	def visitRangeFromPlus(opcode: Opcode.RangeFromPlus)		{ visitDefaultOp(op); }
	def visitRangeGetElem(opcode: Opcode.RangeGetElem)		{ visitDefaultOp(op); }
	def visitRangeSetElem(opcode: Opcode.RangeSetElem)		{ visitDefaultOp(op); }
	def visitRangeGetLength(opcode: Opcode.RangeGetLength)		{ visitDefaultOp(op); }
	def visitRangeStartPlusIndex(opcode: Opcode.RangeStartPlusIndex)	{ visitDefaultOp(op); }
	// Normalized Range operations
	def visitNormRangeGetElem(opcode: Opcode.NormRangeGetElem)	{ visitDefaultOp(op); }
	def visitNormRangeGetElemElem(opcode: Opcode.NormRangeGetElemElem)	{ visitDefaultOp(op); }
	def visitNormRangeSetElem(opcode: Opcode.NormRangeSetElem)	{ visitDefaultOp(op); }
	def visitNormRangeSetElemElem(opcode: Opcode.NormRangeSetElemElem)	{ visitDefaultOp(op); }
	// Component operations
	def visitInit(opcode: Opcode.Init)				{ visitDefaultOp(op); }
	def visitComponentGetField(opcode: Opcode.ComponentGetField)	{ visitDefaultOp(op); }
	def visitComponentSetField(opcode: Opcode.ComponentSetField)	{ visitDefaultOp(op); }
	// Class operations
	def visitClassAlloc(opcode: Opcode.ClassAlloc)			{ visitDefaultOp(op); }
	def visitClassAllocWithDescriptor(opcode: Opcode.ClassAllocWithDescriptor)	{ visitDefaultOp(op); }
	def visitClassNew(opcode: Opcode.ClassNew)			{ visitDefaultOp(op); }
	def visitClassGetField(opcode: Opcode.ClassGetField)		{ visitDefaultOp(op); }
	def visitClassInitField(opcode: Opcode.ClassInitField)		{ visitDefaultOp(op); }
	def visitClassSetField(opcode: Opcode.ClassSetField)		{ visitDefaultOp(op); }
	def visitClassGetMethod(opcode: Opcode.ClassGetMethod)		{ visitDefaultOp(op); }
	def visitClassGetVirtual(opcode: Opcode.ClassGetVirtual)	{ visitDefaultOp(op); }
	def visitClassGetSelector(opcode: Opcode.ClassGetSelector)	{ visitDefaultOp(op); }
	// Variant operations
	def visitVariantEq(opcode: Opcode.VariantEq)			{ visitDefaultOp(op); }
	def visitVariantGetTag(opcode: Opcode.VariantGetTag)		{ visitDefaultOp(op); }
	def visitVariantRepTag(opcode: Opcode.VariantRepTag)		{ visitDefaultOp(op); }
	def visitVariantGetRepTag(opcode: Opcode.VariantGetRepTag)	{ visitDefaultOp(op); }
	def visitVariantAlloc(opcode: Opcode.VariantAlloc)		{ visitDefaultOp(op); }
	def visitVariantGetField(opcode: Opcode.VariantGetField)	{ visitDefaultOp(op); }
	def visitVariantGetMethod(opcode: Opcode.VariantGetMethod)	{ visitDefaultOp(op); }
	def visitVariantGetVirtual(opcode: Opcode.VariantGetVirtual)	{ visitDefaultOp(op); }
	def visitVariantGetSelector(opcode: Opcode.VariantGetSelector)	{ visitDefaultOp(op); }
	// Safety checks
	def visitNullCheck(opcode: Opcode.NullCheck)			{ visitDefaultOp(op); }
	def visitBoundsCheck(opcode: Opcode.BoundsCheck)		{ visitDefaultOp(op); }
	def visitDescriptorCheck(opcode: Opcode.DescriptorCheck)	{ visitDefaultOp(op); }
	def visitConditionalThrow(opcode: Opcode.ConditionalThrow)	{ visitDefaultOp(op); }
	// Overloaded, polymorphic casts
	def visitOverloadedEq(opcode: Opcode.OverloadedEq)		{ visitDefaultOp(op); }
	def visitTypeCast(opcode: Opcode.TypeCast)			{ visitDefaultOp(op); }
	def visitTypeQuery(opcode: Opcode.TypeQuery)			{ visitDefaultOp(op); }
	def visitTypeSubsume(opcode: Opcode.TypeSubsume)		{ visitDefaultOp(op); }
	// Closure and call operations
	def visitCallMethod(opcode: Opcode.CallMethod)			{ visitDefaultOp(op); }
	def visitCallClassMethod(opcode: Opcode.CallClassMethod)	{ visitDefaultOp(op); }
	def visitCallClassVirtual(opcode: Opcode.CallClassVirtual)	{ visitDefaultOp(op); }
	def visitCallClassSelector(opcode: Opcode.CallClassSelector)	{ visitDefaultOp(op); }
	def visitCallVariantVirtual(opcode: Opcode.CallVariantVirtual)	{ visitDefaultOp(op); }
	def visitCallVariantSelector(opcode: Opcode.CallVariantSelector)	{ visitDefaultOp(op); }
	def visitCallClosure(opcode: Opcode.CallClosure)		{ visitDefaultOp(op); }
	def visitCallFunction(opcode: Opcode.CallFunction)		{ visitDefaultOp(op); }
	def visitCreateClosure(opcode: Opcode.CreateClosure)		{ visitDefaultOp(op); }
	def visitForgeClosure(opcode: Opcode.ForgeClosure)		{ visitDefaultOp(op); }
	def visitUnpackClosure(opcode: Opcode.UnpackClosure)		{ visitDefaultOp(op); }
	def visitReturnTo(opcode: Opcode.ReturnTo)			{ visitDefaultOp(op); }
	// RefLayout operations
	def visitRefLayoutAt(opcode: Opcode.RefLayoutAt)		{ visitDefaultOp(op); }
	def visitRefLayoutOf(opcode: Opcode.RefLayoutOf)		{ visitDefaultOp(op); }
	def visitRefLayoutIn(opcode: Opcode.RefLayoutIn)		{ visitDefaultOp(op); }
	def visitRefLayoutGetField(opcode: Opcode.RefLayoutGetField)	{ visitDefaultOp(op); }
	def visitRefLayoutSetField(opcode: Opcode.RefLayoutSetField)	{ visitDefaultOp(op); }
	def visitRefLayoutAtRepeatedField(opcode: Opcode.RefLayoutAtRepeatedField)	{ visitDefaultOp(op); }
	def visitRefLayoutGetRepeatedField(opcode: Opcode.RefLayoutGetRepeatedField)	{ visitDefaultOp(op); }
	def visitRefLayoutSetRepeatedField(opcode: Opcode.RefLayoutSetRepeatedField)	{ visitDefaultOp(op); }
	// Byte array field operations
	def visitByteArrayGetField(opcode: Opcode.ByteArrayGetField)	{ visitDefaultOp(op); }
	def visitByteArraySetField(opcode: Opcode.ByteArraySetField)	{ visitDefaultOp(op); }
	// Tagging and forging operations
	def visitForgeRange(opcode: Opcode.ForgeRange)			{ visitDefaultOp(op); }
	def visitSetAuxTag(opcode: Opcode.SetAuxTag)			{ visitDefaultOp(op); }
	def visitGetAuxTag(opcode: Opcode.GetAuxTag)			{ visitDefaultOp(op); }
	def visitSetRefTag(opcode: Opcode.SetRefTag)			{ visitDefaultOp(op); }
	def visitGetRefTag(opcode: Opcode.GetRefTag)			{ visitDefaultOp(op); }
	def visitSetDescriptorExtension(opcode: Opcode.SetDescriptorExtension)	{ visitDefaultOp(op); }
	// System operations
	def visitSystemCall(opcode: Opcode.SystemCall)			{ visitDefaultOp(op); }
	// Container for VST operations
	def visitVstSugar(opcode: Opcode.VstSugar)			{ visitDefaultOp(op); }
	// Pointer operations
	def visitPtrAdd(opcode: Opcode.PtrAdd)				{ visitDefaultOp(op); }
	def visitPtrSub(opcode: Opcode.PtrSub)				{ visitDefaultOp(op); }
	def visitPtrLt(opcode: Opcode.PtrLt)				{ visitDefaultOp(op); }
	def visitPtrLteq(opcode: Opcode.PtrLteq)			{ visitDefaultOp(op); }
	def visitPtrAtContents(opcode: Opcode.PtrAtContents)		{ visitDefaultOp(op); }
	def visitPtrAtLength(opcode: Opcode.PtrAtLength)		{ visitDefaultOp(op); }
	def visitPtrAtObject(opcode: Opcode.PtrAtObject)		{ visitDefaultOp(op); }
	def visitPtrAtRangeElem(opcode: Opcode.PtrAtRangeElem)		{ visitDefaultOp(op); }
	def visitPtrAtArrayElem(opcode: Opcode.PtrAtArrayElem)		{ visitDefaultOp(op); }
	def visitPtrAtEnd(opcode: Opcode.PtrAtEnd)			{ visitDefaultOp(op); }
	def visitPtrAtRef(opcode: Opcode.PtrAtRef)			{ visitDefaultOp(op); }
	def visitPtrAtComponentField(opcode: Opcode.PtrAtComponentField)	{ visitDefaultOp(op); }
	def visitPtrAtObjectField(opcode: Opcode.PtrAtObjectField)	{ visitDefaultOp(op); }
	def visitPtrAtRefLayoutField(opcode: Opcode.PtrAtRefLayoutField)	{ visitDefaultOp(op); }
	def visitPtrAtUnboxedObjectField(opcode: Opcode.PtrAtUnboxedObjectField)	{ visitDefaultOp(op); }
	def visitPtrAtUnboxedComponentField(opcode: Opcode.PtrAtUnboxedComponentField)	{ visitDefaultOp(op); }
	def visitPtrCmpSwp(opcode: Opcode.PtrCmpSwp)			{ visitDefaultOp(op); }
	def visitPtrLoad(opcode: Opcode.PtrLoad)			{ visitDefaultOp(op); }
	def visitPtrStore(opcode: Opcode.PtrStore)			{ visitDefaultOp(op); }
	def visitPtrAddRangeStart(opcode: Opcode.PtrAddRangeStart)	{ visitDefaultOp(op); }
	// Get caller instruction pointer or stack pointer
	def visitCallerIp(opcode: Opcode.CallerIp)			{ visitDefaultOp(op); }
	def visitCallerSp(opcode: Opcode.CallerSp)			{ visitDefaultOp(op); }
	// Allocate raw memory
	def visitAlloc(opcode: Opcode.Alloc)				{ visitDefaultOp(op); }
	// Wasm target
	def visitWasmFunctionTypeId(opcode: Opcode.WasmFunctionTypeId)	{ visitDefaultOp(op); }
	def visitWasmFunctionId(opcode: Opcode.WasmFunctionId)		{ visitDefaultOp(op); }
	// For testing
	def visitKillRegisters(opcode: Opcode.KillRegisters)		{ visitDefaultOp(op); }
	def visitForceGc(opcode: Opcode.ForceGc)			{ visitDefaultOp(op); }
	// Machine-level calls
	def visitCallAddress(opcode: Opcode.CallAddress)		{ visitDefaultOp(op); }
	def visitCallKernel(opcode: Opcode.CallKernel)			{ visitDefaultOp(op); }
}
