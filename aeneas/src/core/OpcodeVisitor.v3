// A visitor over operators with one method per opcode. The dispatch method {visitOp}
// matches on the opcode of an operator and unpacks the operator's type arguments,
// passing them to the opcode-specific method with their appropriate static types
// (e.g. {IntType} for integer arithmetic, {ClassType} for class field accesses).
//
// Every opcode method defaults to calling {visitDefaultOp}, so a subclass only needs
// to override the opcodes (and/or the default) that it handles. Parts of the compiler
// that match on opcodes, such as reachability analysis, normalization, and machine
// lowering, can be expressed as subclasses of this visitor.
//
// The type arguments passed to each method mirror the operator's {typeArgs} array
// as constructed by {V3Op}; methods for opcodes whose operators carry no type
// arguments receive only the opcode.
class OpcodeVisitor {
	var op: Operator; // the operator currently being visited

	// Dispatch on the opcode of {op}, unpacking its type arguments.
	def visitOp(op: Operator) {
		this.op = op;
		var t = op.typeArgs;
		match (op.opcode) {
			x: Opcode.BoolEq =>			visitBoolEq(x);
			x: Opcode.BoolAnd =>			visitBoolAnd(x);
			x: Opcode.BoolOr =>			visitBoolOr(x);
			x: Opcode.BoolNot =>			visitBoolNot(x);
			x: Opcode.IntEq =>			visitIntEq(x, t[0]);
			x: Opcode.IntAdd =>			visitIntAdd(x, IntType.!(t[0]));
			x: Opcode.IntSub =>			visitIntSub(x, IntType.!(t[0]));
			x: Opcode.IntMul =>			visitIntMul(x, IntType.!(t[0]));
			x: Opcode.IntDiv =>			visitIntDiv(x, IntType.!(t[0]));
			x: Opcode.IntMod =>			visitIntMod(x, IntType.!(t[0]));
			x: Opcode.IntAnd =>			visitIntAnd(x, IntType.!(t[0]));
			x: Opcode.IntOr =>			visitIntOr(x, IntType.!(t[0]));
			x: Opcode.IntXor =>			visitIntXor(x, IntType.!(t[0]));
			x: Opcode.IntShl =>			visitIntShl(x, IntType.!(t[0]));
			x: Opcode.IntSar =>			visitIntSar(x, IntType.!(t[0]));
			x: Opcode.IntShr =>			visitIntShr(x, IntType.!(t[0]));
			x: Opcode.IntLt =>			visitIntLt(x, IntType.!(t[0]));
			x: Opcode.IntLteq =>			visitIntLteq(x, IntType.!(t[0]));
			x: Opcode.IntWide =>			visitIntWide(x);
			x: Opcode.FloatAdd =>			visitFloatAdd(x, FloatType.!(t[0]));
			x: Opcode.FloatSub =>			visitFloatSub(x, FloatType.!(t[0]));
			x: Opcode.FloatMul =>			visitFloatMul(x, FloatType.!(t[0]));
			x: Opcode.FloatDiv =>			visitFloatDiv(x, FloatType.!(t[0]));
			x: Opcode.FloatBitEq =>			visitFloatBitEq(x, FloatType.!(t[0]));
			x: Opcode.FloatEq =>			visitFloatEq(x, FloatType.!(t[0]));
			x: Opcode.FloatNe =>			visitFloatNe(x, FloatType.!(t[0]));
			x: Opcode.FloatLt =>			visitFloatLt(x, FloatType.!(t[0]));
			x: Opcode.FloatLteq =>			visitFloatLteq(x, FloatType.!(t[0]));
			x: Opcode.FloatAbs =>			visitFloatAbs(x, FloatType.!(t[0]));
			x: Opcode.FloatCeil =>			visitFloatCeil(x, FloatType.!(t[0]));
			x: Opcode.FloatFloor =>			visitFloatFloor(x, FloatType.!(t[0]));
			x: Opcode.FloatSqrt =>			visitFloatSqrt(x, FloatType.!(t[0]));
			x: Opcode.IntCastF =>			visitIntCastF(x, FloatType.!(t[0]), IntType.!(t[1]));
			x: Opcode.IntQueryF =>			visitIntQueryF(x, FloatType.!(t[0]), IntType.!(t[1]));
			x: Opcode.IntViewI =>			visitIntViewI(x, IntType.!(t[0]), IntType.!(t[1]));
			x: Opcode.IntViewB =>			visitIntViewB(x, IntType.!(t[1]));
			x: Opcode.IntViewP =>			visitIntViewP(x, PointerType.!(t[0]), IntType.!(t[1]));
			x: Opcode.EnumViewI =>			visitEnumViewI(x, IntType.!(t[0]), EnumType.!(t[1]));
			x: Opcode.EnumSetViewI =>		visitEnumSetViewI(x, IntType.!(t[0]), EnumSetType.!(t[1]));
			x: Opcode.IntViewF =>			visitIntViewF(x, FloatType.!(t[0]));
			x: Opcode.IntTruncF =>			visitIntTruncF(x, FloatType.!(t[0]), IntType.!(t[1]));
			x: Opcode.FloatCastI =>			visitFloatCastI(x, IntType.!(t[0]), FloatType.!(t[1]));
			x: Opcode.FloatCastD =>			visitFloatCastD(x);
			x: Opcode.FloatQueryI =>		visitFloatQueryI(x, IntType.!(t[0]), FloatType.!(t[1]));
			x: Opcode.FloatQueryD =>		visitFloatQueryD(x);
			x: Opcode.FloatPromoteI =>		visitFloatPromoteI(x, IntType.!(t[0]), FloatType.!(t[1]));
			x: Opcode.FloatPromoteF =>		visitFloatPromoteF(x);
			x: Opcode.FloatViewI =>			visitFloatViewI(x, IntType.!(t[0]), FloatType.!(t[1]));
			x: Opcode.FloatRoundI =>		visitFloatRoundI(x, IntType.!(t[0]), FloatType.!(t[1]));
			x: Opcode.FloatRound =>			visitFloatRound(x, FloatType.!(t[0]));
			x: Opcode.FloatRoundD =>		visitFloatRoundD(x);
			x: Opcode.RefEq =>			visitRefEq(x, t[0]);
			x: Opcode.DefaultValue =>		visitDefaultValue(x, t[0]);
			x: Opcode.TupleCreate =>		visitTupleCreate(x, TupleType.!(t[0]));
			x: Opcode.TupleGetElem =>		visitTupleGetElem(x, TupleType.!(t[0]));
			x: Opcode.ArrayAlloc =>			visitArrayAlloc(x, ArrayType.!(t[0]));
			x: Opcode.ArrayFill =>			visitArrayFill(x, ArrayType.!(t[0]));
			x: Opcode.ArrayInit =>			visitArrayInit(x, ArrayType.!(t[0]));
			x: Opcode.ArrayTupleInit =>		visitArrayTupleInit(x, ArrayType.!(t[0]));
			x: Opcode.ArrayGetElem =>		visitArrayGetElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.ArraySetElem =>		visitArraySetElem(x, ArrayType.!(t[0]), IntType.!(t[1]), t[2]);
			x: Opcode.ArrayGetElemElem =>		visitArrayGetElemElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.ArraySetElemElem =>		visitArraySetElemElem(x, ArrayType.!(t[0]), IntType.!(t[1]), t[2]);
			x: Opcode.ArrayGetLength =>		visitArrayGetLength(x, ArrayType.!(t[0]));
			x: Opcode.RangeFromTo =>		visitRangeFromTo(x, RangeType.!(t[0]), IntType.!(t[1]), IntType.!(t[2]));
			x: Opcode.RangeFromPlus =>		visitRangeFromPlus(x, RangeType.!(t[0]), IntType.!(t[1]), IntType.!(t[2]));
			x: Opcode.RangeGetElem =>		visitRangeGetElem(x, RangeType.!(t[0]), IntType.!(t[1]));
			x: Opcode.RangeSetElem =>		visitRangeSetElem(x, RangeType.!(t[0]), IntType.!(t[1]), t[2]);
			x: Opcode.RangeGetLength =>		visitRangeGetLength(x, RangeType.!(t[0]));
			x: Opcode.RangeStartPlusIndex =>	visitRangeStartPlusIndex(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.NormRangeGetElem =>		visitNormRangeGetElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.NormRangeGetElemElem =>	visitNormRangeGetElemElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.NormRangeSetElem =>		visitNormRangeSetElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.NormRangeSetElemElem =>	visitNormRangeSetElemElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.Init =>			visitInit(x);
			x: Opcode.ComponentGetField =>		visitComponentGetField(x, ComponentType.!(t[0]));
			x: Opcode.ComponentSetField =>		visitComponentSetField(x, ComponentType.!(t[0]));
			x: Opcode.ClassAlloc =>			visitClassAlloc(x, ClassType.!(t[0]));
			x: Opcode.ClassAllocWithDescriptor =>	visitClassAllocWithDescriptor(x, ClassType.!(t[0]));
			x: Opcode.ClassNew =>			visitClassNew(x, ClassType.!(t[0]));
			x: Opcode.ClassGetField =>		visitClassGetField(x, ClassType.!(t[0]));
			x: Opcode.ClassInitField =>		visitClassInitField(x, ClassType.!(t[0]));
			x: Opcode.ClassSetField =>		visitClassSetField(x, ClassType.!(t[0]));
			x: Opcode.ClassGetMethod =>		visitClassGetMethod(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.ClassGetVirtual =>		visitClassGetVirtual(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.ClassGetSelector =>		visitClassGetSelector(x, V3Op.extractIrSpec(op, x.selector));
			x: Opcode.VariantEq =>			visitVariantEq(x, ClassType.!(t[0]));
			x: Opcode.VariantGetTag =>		visitVariantGetTag(x, ClassType.!(t[0]));
			x: Opcode.VariantRepTag =>		visitVariantRepTag(x, ClassType.!(t[0]));
			x: Opcode.VariantGetRepTag =>		visitVariantGetRepTag(x, ClassType.!(t[0]));
			x: Opcode.VariantAlloc =>		visitVariantAlloc(x, ClassType.!(t[0]));
			x: Opcode.VariantGetField =>		visitVariantGetField(x, ClassType.!(t[0]));
			x: Opcode.VariantGetMethod =>		visitVariantGetMethod(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.VariantGetVirtual =>		visitVariantGetVirtual(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.VariantGetSelector =>		visitVariantGetSelector(x, V3Op.extractIrSpec(op, x.selector));
			x: Opcode.NullCheck =>			visitNullCheck(x, t[0]);
			x: Opcode.BoundsCheck =>		visitBoundsCheck(x, t[0]);
			x: Opcode.DescriptorCheck =>		visitDescriptorCheck(x, ClassType.!(t[0]));
			x: Opcode.ConditionalThrow =>		visitConditionalThrow(x);
			x: Opcode.OverloadedEq =>		visitOverloadedEq(x, t[0]);
			x: Opcode.TypeCast =>			visitTypeCast(x, t[0], t[1]);
			x: Opcode.TypeQuery =>			visitTypeQuery(x, t[0], t[1]);
			x: Opcode.TypeSubsume =>		visitTypeSubsume(x, t[0], t[1]);
			x: Opcode.CallMethod =>			visitCallMethod(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.CallClassMethod =>		visitCallClassMethod(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.CallClassVirtual =>		visitCallClassVirtual(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.CallClassSelector =>		visitCallClassSelector(x, V3Op.extractIrSpec(op, x.selector));
			x: Opcode.CallVariantVirtual =>		visitCallVariantVirtual(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.CallVariantSelector =>	visitCallVariantSelector(x, V3Op.extractIrSpec(op, x.selector));
			x: Opcode.CallClosure =>		visitCallClosure(x, FuncType.!(t[0]));
			x: Opcode.CallFunction =>		visitCallFunction(x, FuncType.!(t[0]));
			x: Opcode.CreateClosure =>		visitCreateClosure(x, V3Op.extractIrSpec(op, x.method));
			x: Opcode.ForgeClosure =>		visitForgeClosure(x, t[0], t[1], t[2]);
			x: Opcode.UnpackClosure =>		visitUnpackClosure(x, t[0], t[1], t[2]);
			x: Opcode.ReturnTo =>			visitReturnTo(x, t[0], PointerType.!(t[1]));
			x: Opcode.RefLayoutAt =>		visitRefLayoutAt(x, RefType.!(t[0]));
			x: Opcode.RefLayoutOf =>		visitRefLayoutOf(x, RefType.!(t[0]));
			x: Opcode.RefLayoutIn =>		visitRefLayoutIn(x, RefType.!(t[0]), RefType.!(t[1]));
			x: Opcode.RefLayoutGetField =>		visitRefLayoutGetField(x, RefType.!(t[0]), t[1]);
			x: Opcode.RefLayoutSetField =>		visitRefLayoutSetField(x, RefType.!(t[0]), t[1]);
			x: Opcode.RefLayoutAtRepeatedField =>	visitRefLayoutAtRepeatedField(x, RefType.!(t[0]), RefType.!(t[1]));
			x: Opcode.RefLayoutGetRepeatedField =>	visitRefLayoutGetRepeatedField(x, RefType.!(t[0]), t[1]);
			x: Opcode.RefLayoutSetRepeatedField =>	visitRefLayoutSetRepeatedField(x, RefType.!(t[0]), t[1]);
			x: Opcode.ByteArrayGetField =>		visitByteArrayGetField(x, t[0], t[1]);
			x: Opcode.ByteArraySetField =>		visitByteArraySetField(x, t[0], t[1]);
			x: Opcode.ForgeRange =>			visitForgeRange(x, t[0], PointerType.!(t[1]));
			x: Opcode.SetAuxTag =>			visitSetAuxTag(x, PointerType.!(t[0]), t[1]);
			x: Opcode.GetAuxTag =>			visitGetAuxTag(x, PointerType.!(t[0]));
			x: Opcode.SetRefTag =>			visitSetRefTag(x, PointerType.!(t[0]), t[1]);
			x: Opcode.GetRefTag =>			visitGetRefTag(x, PointerType.!(t[0]), IntType.!(t[1]));
			x: Opcode.SetDescriptorExtension =>	visitSetDescriptorExtension(x, t[0]);
			x: Opcode.SystemCall =>			visitSystemCall(x);
			x: Opcode.VstSugar =>			visitVstSugar(x, t);
			x: Opcode.PtrAdd =>			visitPtrAdd(x, t[0], IntType.!(t[1]));
			x: Opcode.PtrSub =>			visitPtrSub(x, PointerType.!(t[0]), IntType.!(t[1]));
			x: Opcode.PtrLt =>			visitPtrLt(x, PointerType.!(t[0]));
			x: Opcode.PtrLteq =>			visitPtrLteq(x, PointerType.!(t[0]));
			x: Opcode.PtrAtContents =>		visitPtrAtContents(x, RangeType.!(t[0]));
			x: Opcode.PtrAtLength =>		visitPtrAtLength(x, ArrayType.!(t[0]));
			x: Opcode.PtrAtObject =>		visitPtrAtObject(x, t[0]);
			x: Opcode.PtrAtRangeElem =>		visitPtrAtRangeElem(x, RangeType.!(t[0]), IntType.!(t[1]));
			x: Opcode.PtrAtArrayElem =>		visitPtrAtArrayElem(x, ArrayType.!(t[0]), IntType.!(t[1]));
			x: Opcode.PtrAtEnd =>			visitPtrAtEnd(x, t[0]);
			x: Opcode.PtrAtRef =>			visitPtrAtRef(x, RefType.!(t[0]));
			x: Opcode.PtrAtComponentField =>	visitPtrAtComponentField(x, ComponentType.!(t[0]));
			x: Opcode.PtrAtObjectField =>		visitPtrAtObjectField(x, ClassType.!(t[0]));
			x: Opcode.PtrAtRefLayoutField =>	visitPtrAtRefLayoutField(x, RefType.!(t[0]));
			x: Opcode.PtrAtUnboxedObjectField =>	visitPtrAtUnboxedObjectField(x, ClassType.!(t[0]));
			x: Opcode.PtrAtUnboxedComponentField =>	visitPtrAtUnboxedComponentField(x, ComponentType.!(t[0]));
			x: Opcode.PtrCmpSwp =>			visitPtrCmpSwp(x, PointerType.!(t[0]), t[1]);
			x: Opcode.PtrLoad =>			visitPtrLoad(x, t[0], t[1]);
			x: Opcode.PtrStore =>			visitPtrStore(x, t[0], t[1]);
			x: Opcode.PtrAddRangeStart =>		visitPtrAddRangeStart(x, PointerType.!(t[0]));
			x: Opcode.CallerIp =>			visitCallerIp(x);
			x: Opcode.CallerSp =>			visitCallerSp(x);
			x: Opcode.Alloc =>			visitAlloc(x, t[0]);
			x: Opcode.WasmFunctionTypeId =>		visitWasmFunctionTypeId(x, t[0], t[1]);
			x: Opcode.WasmFunctionId =>		visitWasmFunctionId(x, t[0], t[1]);
			x: Opcode.KillRegisters =>		visitKillRegisters(x);
			x: Opcode.ForceGc =>			visitForceGc(x);
			x: Opcode.CallAddress =>		visitCallAddress(x, PointerType.!(t[0]));
			x: Opcode.CallKernel =>			visitCallKernel(x, t);
		}
	}

	// Called by every opcode method that is not overridden.
	def visitDefaultOp(op: Operator)				{ }
	// Boolean operators
	def visitBoolEq(opcode: Opcode.BoolEq)				{ visitDefaultOp(op); }
	def visitBoolAnd(opcode: Opcode.BoolAnd)			{ visitDefaultOp(op); }
	def visitBoolOr(opcode: Opcode.BoolOr)				{ visitDefaultOp(op); }
	def visitBoolNot(opcode: Opcode.BoolNot)			{ visitDefaultOp(op); }
	// Integer arithmetic and conversions; {t} of {IntEq} is an {IntType}, {EnumType}, or {EnumSetType}
	def visitIntEq(opcode: Opcode.IntEq, t: Type)			{ visitDefaultOp(op); }
	def visitIntAdd(opcode: Opcode.IntAdd, it: IntType)		{ visitDefaultOp(op); }
	def visitIntSub(opcode: Opcode.IntSub, it: IntType)		{ visitDefaultOp(op); }
	def visitIntMul(opcode: Opcode.IntMul, it: IntType)		{ visitDefaultOp(op); }
	def visitIntDiv(opcode: Opcode.IntDiv, it: IntType)		{ visitDefaultOp(op); }
	def visitIntMod(opcode: Opcode.IntMod, it: IntType)		{ visitDefaultOp(op); }
	def visitIntAnd(opcode: Opcode.IntAnd, it: IntType)		{ visitDefaultOp(op); }
	def visitIntOr(opcode: Opcode.IntOr, it: IntType)		{ visitDefaultOp(op); }
	def visitIntXor(opcode: Opcode.IntXor, it: IntType)		{ visitDefaultOp(op); }
	def visitIntShl(opcode: Opcode.IntShl, it: IntType)		{ visitDefaultOp(op); }
	def visitIntSar(opcode: Opcode.IntSar, it: IntType)		{ visitDefaultOp(op); }
	def visitIntShr(opcode: Opcode.IntShr, it: IntType)		{ visitDefaultOp(op); }
	def visitIntLt(opcode: Opcode.IntLt, it: IntType)		{ visitDefaultOp(op); }
	def visitIntLteq(opcode: Opcode.IntLteq, it: IntType)		{ visitDefaultOp(op); }
	def visitIntWide(opcode: Opcode.IntWide)			{ visitDefaultOp(op); }
	// Floating point arithmetic
	def visitFloatAdd(opcode: Opcode.FloatAdd, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatSub(opcode: Opcode.FloatSub, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatMul(opcode: Opcode.FloatMul, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatDiv(opcode: Opcode.FloatDiv, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatBitEq(opcode: Opcode.FloatBitEq, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatEq(opcode: Opcode.FloatEq, ft: FloatType)		{ visitDefaultOp(op); }
	def visitFloatNe(opcode: Opcode.FloatNe, ft: FloatType)		{ visitDefaultOp(op); }
	def visitFloatLt(opcode: Opcode.FloatLt, ft: FloatType)		{ visitDefaultOp(op); }
	def visitFloatLteq(opcode: Opcode.FloatLteq, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatAbs(opcode: Opcode.FloatAbs, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatCeil(opcode: Opcode.FloatCeil, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatFloor(opcode: Opcode.FloatFloor, ft: FloatType)	{ visitDefaultOp(op); }
	def visitFloatSqrt(opcode: Opcode.FloatSqrt, ft: FloatType)	{ visitDefaultOp(op); }
	// Integer casts and conversions ({ft} = from type, {tt} = to type)
	def visitIntCastF(opcode: Opcode.IntCastF, ft: FloatType, tt: IntType)			{ visitDefaultOp(op); }
	def visitIntQueryF(opcode: Opcode.IntQueryF, ft: FloatType, tt: IntType)		{ visitDefaultOp(op); }
	def visitIntViewI(opcode: Opcode.IntViewI, ft: IntType, tt: IntType)			{ visitDefaultOp(op); }
	def visitIntViewB(opcode: Opcode.IntViewB, tt: IntType)					{ visitDefaultOp(op); }
	def visitIntViewP(opcode: Opcode.IntViewP, ft: PointerType, tt: IntType)		{ visitDefaultOp(op); }
	def visitEnumViewI(opcode: Opcode.EnumViewI, ft: IntType, tt: EnumType)			{ visitDefaultOp(op); }
	def visitEnumSetViewI(opcode: Opcode.EnumSetViewI, ft: IntType, tt: EnumSetType)	{ visitDefaultOp(op); }
	def visitIntViewF(opcode: Opcode.IntViewF, ft: FloatType)				{ visitDefaultOp(op); }
	def visitIntTruncF(opcode: Opcode.IntTruncF, ft: FloatType, tt: IntType)		{ visitDefaultOp(op); }
	// Floating point casts and conversions ({ft} = from type, {tt} = to type)
	def visitFloatCastI(opcode: Opcode.FloatCastI, ft: IntType, tt: FloatType)		{ visitDefaultOp(op); }
	def visitFloatCastD(opcode: Opcode.FloatCastD)						{ visitDefaultOp(op); }
	def visitFloatQueryI(opcode: Opcode.FloatQueryI, ft: IntType, tt: FloatType)		{ visitDefaultOp(op); }
	def visitFloatQueryD(opcode: Opcode.FloatQueryD)					{ visitDefaultOp(op); }
	def visitFloatPromoteI(opcode: Opcode.FloatPromoteI, ft: IntType, tt: FloatType)	{ visitDefaultOp(op); }
	def visitFloatPromoteF(opcode: Opcode.FloatPromoteF)					{ visitDefaultOp(op); }
	def visitFloatViewI(opcode: Opcode.FloatViewI, ft: IntType, tt: FloatType)		{ visitDefaultOp(op); }
	def visitFloatRoundI(opcode: Opcode.FloatRoundI, ft: IntType, tt: FloatType)		{ visitDefaultOp(op); }
	def visitFloatRound(opcode: Opcode.FloatRound, ft: FloatType)				{ visitDefaultOp(op); }
	def visitFloatRoundD(opcode: Opcode.FloatRoundD)					{ visitDefaultOp(op); }
	// Reference equality
	def visitRefEq(opcode: Opcode.RefEq, t: Type)					{ visitDefaultOp(op); }
	// Default value operator
	def visitDefaultValue(opcode: Opcode.DefaultValue, t: Type)			{ visitDefaultOp(op); }
	// Tuple operations
	def visitTupleCreate(opcode: Opcode.TupleCreate, tt: TupleType)			{ visitDefaultOp(op); }
	def visitTupleGetElem(opcode: Opcode.TupleGetElem, tt: TupleType)		{ visitDefaultOp(op); }
	// Array operations ({at} = array type, {it} = index type, {et} = element type)
	def visitArrayAlloc(opcode: Opcode.ArrayAlloc, at: ArrayType)					{ visitDefaultOp(op); }
	def visitArrayFill(opcode: Opcode.ArrayFill, at: ArrayType)					{ visitDefaultOp(op); }
	def visitArrayInit(opcode: Opcode.ArrayInit, at: ArrayType)					{ visitDefaultOp(op); }
	def visitArrayTupleInit(opcode: Opcode.ArrayTupleInit, at: ArrayType)				{ visitDefaultOp(op); }
	def visitArrayGetElem(opcode: Opcode.ArrayGetElem, at: ArrayType, it: IntType)			{ visitDefaultOp(op); }
	def visitArraySetElem(opcode: Opcode.ArraySetElem, at: ArrayType, it: IntType, et: Type)	{ visitDefaultOp(op); }
	def visitArrayGetElemElem(opcode: Opcode.ArrayGetElemElem, at: ArrayType, it: IntType)		{ visitDefaultOp(op); }
	def visitArraySetElemElem(opcode: Opcode.ArraySetElemElem, at: ArrayType, it: IntType, et: Type)	{ visitDefaultOp(op); }
	def visitArrayGetLength(opcode: Opcode.ArrayGetLength, at: ArrayType)				{ visitDefaultOp(op); }
	// Range operations ({rt} = range type, {it} = index type, {et} = element type)
	def visitRangeFromTo(opcode: Opcode.RangeFromTo, rt: RangeType, startType: IntType, endType: IntType)		{ visitDefaultOp(op); }
	def visitRangeFromPlus(opcode: Opcode.RangeFromPlus, rt: RangeType, startType: IntType, lengthType: IntType)	{ visitDefaultOp(op); }
	def visitRangeGetElem(opcode: Opcode.RangeGetElem, rt: RangeType, it: IntType)					{ visitDefaultOp(op); }
	def visitRangeSetElem(opcode: Opcode.RangeSetElem, rt: RangeType, it: IntType, et: Type)			{ visitDefaultOp(op); }
	def visitRangeGetLength(opcode: Opcode.RangeGetLength, rt: RangeType)						{ visitDefaultOp(op); }
	def visitRangeStartPlusIndex(opcode: Opcode.RangeStartPlusIndex, at: ArrayType, it: IntType)			{ visitDefaultOp(op); }
	// Normalized Range operations; {at} is the type of the array underlying the range
	def visitNormRangeGetElem(opcode: Opcode.NormRangeGetElem, at: ArrayType, it: IntType)		{ visitDefaultOp(op); }
	def visitNormRangeGetElemElem(opcode: Opcode.NormRangeGetElemElem, at: ArrayType, it: IntType)	{ visitDefaultOp(op); }
	def visitNormRangeSetElem(opcode: Opcode.NormRangeSetElem, at: ArrayType, it: IntType)		{ visitDefaultOp(op); }
	def visitNormRangeSetElemElem(opcode: Opcode.NormRangeSetElemElem, at: ArrayType, it: IntType)	{ visitDefaultOp(op); }
	// Component operations ({ct} = receiver component type)
	def visitInit(opcode: Opcode.Init)			{ visitDefaultOp(op); }
	def visitComponentGetField(opcode: Opcode.ComponentGetField, ct: ComponentType)			{ visitDefaultOp(op); }
	def visitComponentSetField(opcode: Opcode.ComponentSetField, ct: ComponentType)			{ visitDefaultOp(op); }
	// Class operations ({ct} = receiver class type, {spec} = method or selector with receiver and type args)
	def visitClassAlloc(opcode: Opcode.ClassAlloc, ct: ClassType)					{ visitDefaultOp(op); }
	def visitClassAllocWithDescriptor(opcode: Opcode.ClassAllocWithDescriptor, ct: ClassType)	{ visitDefaultOp(op); }
	def visitClassNew(opcode: Opcode.ClassNew, ct: ClassType)					{ visitDefaultOp(op); }
	def visitClassGetField(opcode: Opcode.ClassGetField, ct: ClassType)				{ visitDefaultOp(op); }
	def visitClassInitField(opcode: Opcode.ClassInitField, ct: ClassType)				{ visitDefaultOp(op); }
	def visitClassSetField(opcode: Opcode.ClassSetField, ct: ClassType)				{ visitDefaultOp(op); }
	def visitClassGetMethod(opcode: Opcode.ClassGetMethod, spec: IrSpec)				{ visitDefaultOp(op); }
	def visitClassGetVirtual(opcode: Opcode.ClassGetVirtual, spec: IrSpec)				{ visitDefaultOp(op); }
	def visitClassGetSelector(opcode: Opcode.ClassGetSelector, spec: IrSpec)			{ visitDefaultOp(op); }
	// Variant operations ({vt} = variant type, {spec} = method or selector with receiver and type args)
	def visitVariantEq(opcode: Opcode.VariantEq, vt: ClassType)			{ visitDefaultOp(op); }
	def visitVariantGetTag(opcode: Opcode.VariantGetTag, vt: ClassType)		{ visitDefaultOp(op); }
	def visitVariantRepTag(opcode: Opcode.VariantRepTag, vt: ClassType)		{ visitDefaultOp(op); }
	def visitVariantGetRepTag(opcode: Opcode.VariantGetRepTag, vt: ClassType)	{ visitDefaultOp(op); }
	def visitVariantAlloc(opcode: Opcode.VariantAlloc, vt: ClassType)		{ visitDefaultOp(op); }
	def visitVariantGetField(opcode: Opcode.VariantGetField, vt: ClassType)		{ visitDefaultOp(op); }
	def visitVariantGetMethod(opcode: Opcode.VariantGetMethod, spec: IrSpec)	{ visitDefaultOp(op); }
	def visitVariantGetVirtual(opcode: Opcode.VariantGetVirtual, spec: IrSpec)	{ visitDefaultOp(op); }
	def visitVariantGetSelector(opcode: Opcode.VariantGetSelector, spec: IrSpec)	{ visitDefaultOp(op); }
	// Safety checks
	def visitNullCheck(opcode: Opcode.NullCheck, t: Type)			{ visitDefaultOp(op); }
	def visitBoundsCheck(opcode: Opcode.BoundsCheck, t: Type)		{ visitDefaultOp(op); }
	def visitDescriptorCheck(opcode: Opcode.DescriptorCheck, dt: ClassType)	{ visitDefaultOp(op); }
	def visitConditionalThrow(opcode: Opcode.ConditionalThrow)		{ visitDefaultOp(op); }
	// Overloaded, polymorphic casts ({ft} = from type, {tt} = to type)
	def visitOverloadedEq(opcode: Opcode.OverloadedEq, t: Type)		{ visitDefaultOp(op); }
	def visitTypeCast(opcode: Opcode.TypeCast, ft: Type, tt: Type)		{ visitDefaultOp(op); }
	def visitTypeQuery(opcode: Opcode.TypeQuery, ft: Type, tt: Type)	{ visitDefaultOp(op); }
	def visitTypeSubsume(opcode: Opcode.TypeSubsume, ft: Type, tt: Type)	{ visitDefaultOp(op); }
	// Closure and call operations ({spec} = method or selector with receiver and type args)
	def visitCallMethod(opcode: Opcode.CallMethod, spec: IrSpec)					{ visitDefaultOp(op); }
	def visitCallClassMethod(opcode: Opcode.CallClassMethod, spec: IrSpec)				{ visitDefaultOp(op); }
	def visitCallClassVirtual(opcode: Opcode.CallClassVirtual, spec: IrSpec)			{ visitDefaultOp(op); }
	def visitCallClassSelector(opcode: Opcode.CallClassSelector, spec: IrSpec)			{ visitDefaultOp(op); }
	def visitCallVariantVirtual(opcode: Opcode.CallVariantVirtual, spec: IrSpec)			{ visitDefaultOp(op); }
	def visitCallVariantSelector(opcode: Opcode.CallVariantSelector, spec: IrSpec)			{ visitDefaultOp(op); }
	def visitCallClosure(opcode: Opcode.CallClosure, ft: FuncType)					{ visitDefaultOp(op); }
	def visitCallFunction(opcode: Opcode.CallFunction, ft: FuncType)				{ visitDefaultOp(op); }
	def visitCreateClosure(opcode: Opcode.CreateClosure, spec: IrSpec)				{ visitDefaultOp(op); }
	def visitForgeClosure(opcode: Opcode.ForgeClosure, receiver: Type, param: Type, result: Type)	{ visitDefaultOp(op); }
	def visitUnpackClosure(opcode: Opcode.UnpackClosure, receiver: Type, param: Type, result: Type)	{ visitDefaultOp(op); }
	def visitReturnTo(opcode: Opcode.ReturnTo, returnType: Type, pt: PointerType)			{ visitDefaultOp(op); }
	// RefLayout operations ({rt} = ref type, {ft} = field type)
	def visitRefLayoutAt(opcode: Opcode.RefLayoutAt, rt: RefType)							{ visitDefaultOp(op); }
	def visitRefLayoutOf(opcode: Opcode.RefLayoutOf, rt: RefType)							{ visitDefaultOp(op); }
	def visitRefLayoutIn(opcode: Opcode.RefLayoutIn, rt: RefType, result: RefType)					{ visitDefaultOp(op); }
	def visitRefLayoutGetField(opcode: Opcode.RefLayoutGetField, rt: RefType, ft: Type)				{ visitDefaultOp(op); }
	def visitRefLayoutSetField(opcode: Opcode.RefLayoutSetField, rt: RefType, ft: Type)				{ visitDefaultOp(op); }
	def visitRefLayoutAtRepeatedField(opcode: Opcode.RefLayoutAtRepeatedField, rt: RefType, result: RefType)	{ visitDefaultOp(op); }
	def visitRefLayoutGetRepeatedField(opcode: Opcode.RefLayoutGetRepeatedField, rt: RefType, ft: Type)		{ visitDefaultOp(op); }
	def visitRefLayoutSetRepeatedField(opcode: Opcode.RefLayoutSetRepeatedField, rt: RefType, ft: Type)		{ visitDefaultOp(op); }
	// Byte array field operations ({ft} = field type, {startType} = int or range start type)
	def visitByteArrayGetField(opcode: Opcode.ByteArrayGetField, ft: Type, startType: Type)		{ visitDefaultOp(op); }
	def visitByteArraySetField(opcode: Opcode.ByteArraySetField, ft: Type, startType: Type)		{ visitDefaultOp(op); }
	// Tagging and forging operations ({pt} = pointer type)
	def visitForgeRange(opcode: Opcode.ForgeRange, et: Type, pt: PointerType)			{ visitDefaultOp(op); }
	def visitSetAuxTag(opcode: Opcode.SetAuxTag, pt: PointerType, tagType: Type)			{ visitDefaultOp(op); }
	def visitGetAuxTag(opcode: Opcode.GetAuxTag, pt: PointerType)					{ visitDefaultOp(op); }
	def visitSetRefTag(opcode: Opcode.SetRefTag, pt: PointerType, tagType: Type)			{ visitDefaultOp(op); }
	def visitGetRefTag(opcode: Opcode.GetRefTag, pt: PointerType, it: IntType)			{ visitDefaultOp(op); }
	def visitSetDescriptorExtension(opcode: Opcode.SetDescriptorExtension, dt: Type)		{ visitDefaultOp(op); }
	// System operations
	def visitSystemCall(opcode: Opcode.SystemCall)					{ visitDefaultOp(op); }
	// Container for VST operations
	def visitVstSugar(opcode: Opcode.VstSugar, typeArgs: Array<Type>)		{ visitDefaultOp(op); }
	// Pointer operations ({pt} = pointer type, {it} = index type or integer type). Machine lowering
	// also applies {PtrAdd}, {PtrLoad}, and {PtrStore} directly to references, so {pt} is a {Type} there.
	def visitPtrAdd(opcode: Opcode.PtrAdd, pt: Type, it: IntType)						{ visitDefaultOp(op); }
	def visitPtrSub(opcode: Opcode.PtrSub, pt: PointerType, it: IntType)					{ visitDefaultOp(op); }
	def visitPtrLt(opcode: Opcode.PtrLt, pt: PointerType)							{ visitDefaultOp(op); }
	def visitPtrLteq(opcode: Opcode.PtrLteq, pt: PointerType)						{ visitDefaultOp(op); }
	def visitPtrAtContents(opcode: Opcode.PtrAtContents, rt: RangeType)					{ visitDefaultOp(op); }
	def visitPtrAtLength(opcode: Opcode.PtrAtLength, at: ArrayType)						{ visitDefaultOp(op); }
	def visitPtrAtObject(opcode: Opcode.PtrAtObject, t: Type)						{ visitDefaultOp(op); }
	def visitPtrAtRangeElem(opcode: Opcode.PtrAtRangeElem, rt: RangeType, it: IntType)			{ visitDefaultOp(op); }
	def visitPtrAtArrayElem(opcode: Opcode.PtrAtArrayElem, at: ArrayType, it: IntType)			{ visitDefaultOp(op); }
	def visitPtrAtEnd(opcode: Opcode.PtrAtEnd, t: Type)							{ visitDefaultOp(op); }
	def visitPtrAtRef(opcode: Opcode.PtrAtRef, rt: RefType)							{ visitDefaultOp(op); }
	def visitPtrAtComponentField(opcode: Opcode.PtrAtComponentField, ct: ComponentType)			{ visitDefaultOp(op); }
	def visitPtrAtObjectField(opcode: Opcode.PtrAtObjectField, ct: ClassType)				{ visitDefaultOp(op); }
	def visitPtrAtRefLayoutField(opcode: Opcode.PtrAtRefLayoutField, rt: RefType)				{ visitDefaultOp(op); }
	def visitPtrAtUnboxedObjectField(opcode: Opcode.PtrAtUnboxedObjectField, ct: ClassType)			{ visitDefaultOp(op); }
	def visitPtrAtUnboxedComponentField(opcode: Opcode.PtrAtUnboxedComponentField, ct: ComponentType)	{ visitDefaultOp(op); }
	def visitPtrCmpSwp(opcode: Opcode.PtrCmpSwp, pt: PointerType, vt: Type)					{ visitDefaultOp(op); }
	def visitPtrLoad(opcode: Opcode.PtrLoad, pt: Type, vt: Type)						{ visitDefaultOp(op); }
	def visitPtrStore(opcode: Opcode.PtrStore, pt: Type, vt: Type)						{ visitDefaultOp(op); }
	def visitPtrAddRangeStart(opcode: Opcode.PtrAddRangeStart, pt: PointerType)				{ visitDefaultOp(op); }
	// Get caller instruction pointer or stack pointer
	def visitCallerIp(opcode: Opcode.CallerIp)			{ visitDefaultOp(op); }
	def visitCallerSp(opcode: Opcode.CallerSp)			{ visitDefaultOp(op); }
	// Allocate raw memory ({t} = type of the object being allocated)
	def visitAlloc(opcode: Opcode.Alloc, t: Type)			{ visitDefaultOp(op); }
	// Wasm target
	def visitWasmFunctionTypeId(opcode: Opcode.WasmFunctionTypeId, paramType: Type, resultType: Type)	{ visitDefaultOp(op); }
	def visitWasmFunctionId(opcode: Opcode.WasmFunctionId, paramType: Type, resultType: Type)		{ visitDefaultOp(op); }
	// For testing
	def visitKillRegisters(opcode: Opcode.KillRegisters)			{ visitDefaultOp(op); }
	def visitForceGc(opcode: Opcode.ForceGc)				{ visitDefaultOp(op); }
	// Machine-level calls ({pt} = pointer-to-function type of the callee)
	def visitCallAddress(opcode: Opcode.CallAddress, pt: PointerType)	{ visitDefaultOp(op); }
	def visitCallKernel(opcode: Opcode.CallKernel, typeArgs: Array<Type>)	{ visitDefaultOp(op); }
}
