// An operator represents a computation from argument values to a result value
// with possible side-effects. It wraps an {Opcode} and caches its signature. The signature
// of a closure call over a lambda's unflattened parameters differs from the one
// {Opcode.CallClosure} computes, so the signature is passed in rather than recomputed.
class Operator(opcode: Opcode, sig: Signature) {
	private var openness: Open;			// lazily computed open / closed

	def checkOpenness() -> Open {
		if (openness != Open.UNKNOWN) return openness;
		// XXX: bail out earlier if a nested type is open
		TypeHashes.hash = 0;
		for (t in sig.paramTypes) TypeHashes.add(t);
		for (t in sig.returnTypes) TypeHashes.add(t);
		opcode.subst(TypeHashes.add);
		return openness = if((TypeHashes.hash & TypeConst.OPEN_MASK) != 0, Open.OPEN, Open.CLOSED);
	}
	def isPolymorphic() -> bool {
		return checkOpenness() == Open.OPEN;
	}
	def subst(f: Type -> Type) -> Operator {
		if (openness == Open.CLOSED) return this;
		if (checkOpenness() == Open.OPEN) {
			return Operator.new(opcode.subst(f), sig.subst(f));
		}
		return this;
	}
	def equals(that: Operator) -> bool {
		return this == that || this.opcode.equals(that.opcode);
	}
	def render(buf: StringBuilder) -> StringBuilder {
		if (TerminalBuffer.?(buf)) TerminalBuffer.!(buf).green();
		Opcodes.render(opcode, buf);
		if (TerminalBuffer.?(buf)) TerminalBuffer.!(buf).end();
		return buf;
	}
}

// Accumulates the hashes of types, whose bits include whether any of them is open.
// Shared by all operators so that checking openness allocates no collector.
component TypeHashes {
	var hash: int;
	def add(t: Type) -> Type {
		hash |= t.hash;
		return t;
	}
}

// Whether an operator is known to contain any open (polymorphic) types.
enum Open { UNKNOWN, OPEN, CLOSED }

def renderList<T>(sb: StringBuilder, lst: List<T>,
		  rfunc: (T, StringBuilder) -> StringBuilder, sep: string) -> StringBuilder {
	for (node = lst; node != null; node = node.tail) {
		sb = rfunc(node.head, sb).puts(if(node.tail == null, "", sep));
	}
	return sb;
}
