// Represents the statically-known part of an operation, including its types, which is the
// minimal information to evaluate the operation on a program state. An opcode is normally
// wrapped into an {Operator}, which caches its signature.
// Fields are typed as narrowly as every construction site allows; a field is a plain {Type}
// where a template operator holds a type parameter there until it is instantiated.
type Opcode {
	def facts() -> Fact.set { return Facts.NONE; }			// optimization facts
	def sig() -> Signature;						// computes a new signature
	def subst(f: Type -> Type) -> Opcode { return this; }		// perform a type substitution
	def op() -> Operator { return Operator.new(this, sig()); }	// create an operator from this opcode

	// Boolean operators
	case BoolEq 			{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_y(Bool.TYPE, Bool.TYPE); }
	case BoolAnd			{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(Bool.TYPE); }
	case BoolOr			{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(Bool.TYPE); }
	case BoolNot			{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_x(Bool.TYPE); }
	// Integer arithmetic and conversions; {t} of {IntEq} is an {IntType}, {EnumType}, or {EnumSetType}
	case IntEq(t: Type)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_y(t, Bool.TYPE); def subst(f: Type -> Type) -> Opcode => Opcode.IntEq(f(t)); }
	case IntAdd(t: IntType)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case IntSub(t: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_x(t); }
	case IntMul(t: IntType)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case IntDiv(t: IntType)		{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sxx_x(t); }
	case IntMod(t: IntType)		{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sxx_x(t); }
	case IntAnd(t: IntType)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case IntOr(t: IntType)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case IntXor(t: IntType)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case IntShl(t: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxy_x(t, Byte.TYPE); }
	case IntSar(t: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxy_x(t, Byte.TYPE); }
	case IntShr(t: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxy_x(t, Byte.TYPE); }
	case IntLt(t: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case IntLteq(t: IntType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	// A wide (multi-word) arithmetic operation over the normalized parts of {wideOp}'s operands.
	case IntWide(wideOp: Operator, paramTypes: Array<Type>, resultType: Type) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sa_x(paramTypes, resultType);
	}
	// Floating point arithmetic
	case FloatAdd(t: FloatType)	{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case FloatSub(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_x(t); }
	case FloatMul(t: FloatType)	{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_x(t); }
	case FloatDiv(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_x(t); }
	case FloatBitEq(t: FloatType)	{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case FloatEq(t: FloatType)	{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case FloatNe(t: FloatType)	{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case FloatLt(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case FloatLteq(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case FloatAbs(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_x(t); }
	case FloatCeil(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_x(t); }
	case FloatFloor(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_x(t); }
	case FloatSqrt(t: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_x(t); }
	// Integer casts and conversions
	case IntCastF(from: FloatType, to: IntType)		{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sx_y(from, to); }
	case IntQueryF(from: FloatType, to: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(from, Bool.TYPE); }
	case IntViewI(from: IntType, to: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(from, to); }
	case IntViewB(to: IntType)				{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(Bool.TYPE, to); }
	case IntViewP(from: PointerType, to: IntType)		{ def sig() -> Signature => Sx_y(from, to); }
	// Map an integer tag to an enum, out-of-range => tag 0.
	case EnumViewI(from: IntType, to: EnumType)		{ def facts() -> Fact.set => PURE|NONNEG; def sig() -> Signature => Sx_y(from, to); }
	// Reinterpret an integer as an enum set's bit representation.
	case EnumSetViewI(from: Type, to: EnumSetType) {
		def facts() -> Fact.set => PURE|NONNEG;
		def sig() -> Signature => Sx_y(from, to);
		def subst(f: Type -> Type) -> Opcode => Opcode.EnumSetViewI(f(from), to);
	}
	// The result is the unsigned integer type of the same width as {from}.
	case IntViewF(from: FloatType)				{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(from, Int.getType(false, from.width)); }
	case IntTruncF(from: FloatType, to: IntType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(from, to); }
	// Floating point casts and conversions
	case FloatCastI(from: IntType, to: FloatType)		{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sx_y(from, to); }
	case FloatCastD						{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sx_y(Float.FLOAT64, Float.FLOAT32); }
	case FloatQueryI(from: IntType, to: FloatType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(from, Bool.TYPE); }
	case FloatQueryD					{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(Float.FLOAT64, Bool.TYPE); }
	case FloatPromoteI(from: IntType, to: FloatType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(from, to); }
	case FloatPromoteF					{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(Float.FLOAT32, Float.FLOAT64); }
	case FloatViewI(from: Type, to: FloatType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(from, to);
		def subst(f: Type -> Type) -> Opcode => Opcode.FloatViewI(f(from), to);
	}
	case FloatRoundI(from: Type, to: FloatType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(from, to);
		def subst(f: Type -> Type) -> Opcode => Opcode.FloatRoundI(f(from), to);
	}
	case FloatRound(t: FloatType)				{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_x(t); }
	case FloatRoundD					{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sx_y(Float.FLOAT64, Float.FLOAT32); }
	// Reference equality
	case RefEq(t: Type)		{ def facts() -> Fact.set => PURE|COMM; def sig() -> Signature => Sxx_y(t, Bool.TYPE); def subst(f: Type -> Type) -> Opcode => Opcode.RefEq(f(t)); }
	// Default value operator
	case DefaultValue(t: Type)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => S_x(t); def subst(f: Type -> Type) -> Opcode => Opcode.DefaultValue(f(t)); }
	// Tuple operations
	case TupleCreate(t: TupleType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sa_x(Lists.toArray(t.nested), t);
		def subst(f: Type -> Type) -> Opcode => Opcode.TupleCreate(TupleType.!(f(t)));
	}
	case TupleGetElem(t: TupleType, index: int) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(t, Lists.get(t.nested, index));
		def subst(f: Type -> Type) -> Opcode => Opcode.TupleGetElem(TupleType.!(f(t)), index);
	}
	// Array operations
	case ArrayAlloc(t: ArrayType) {
		def facts() -> Fact.set => NONZERO;
		def sig() -> Signature => Sx_y(Int.TYPE, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayAlloc(ArrayType.!(f(t)));
	}
	case ArrayFill(t: ArrayType) {
		def facts() -> Fact.set => NONZERO;
		def sig() -> Signature => Sxy_x(t, t.elementType());
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayFill(ArrayType.!(f(t)));
	}
	case ArrayInit(t: ArrayType, length: int) {
		def facts() -> Fact.set => NONZERO;
		def sig() -> Signature => Sa_x(repeatType(t.elementType(), length), t);
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayInit(ArrayType.!(f(t)), length);
	}
	// Initializes an array of tuples from {length} groups of {elems} flattened tuple elements.
	case ArrayTupleInit(t: ArrayType, elems: int, length: int) {
		def sig() -> Signature => Sa_x(tupleElemsRepeat(t, elems, length), t);
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayTupleInit(ArrayType.!(f(t)), elems, length);
	}
	case ArrayGetElem(t: ArrayType, it: IntType) {
		def sig() -> Signature => Sxy_z(t, it, t.elementType());
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayGetElem(ArrayType.!(f(t)), it);
	}
	case ArraySetElem(t: ArrayType, it: IntType) {
		def sig() -> Signature => Sxyz_w(t, it, t.elementType(), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ArraySetElem(ArrayType.!(f(t)), it);
	}
	case ArrayGetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() -> Signature => Sxy_z(t, it, tupleElem(t, index));
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayGetElemElem(ArrayType.!(f(t)), it, index);
	}
	case ArraySetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() -> Signature => Sxyz_w(t, it, tupleElem(t, index), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ArraySetElemElem(ArrayType.!(f(t)), it, index);
	}
	case ArrayGetLength(t: ArrayType) {
		def facts() -> Fact.set => FOLD|NONNEG;
		def sig() -> Signature => Sx_y(t, Int.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ArrayGetLength(ArrayType.!(f(t)));
	}
	// Range operations
	case RangeFromTo(t: RangeType, startType: IntType, endType: IntType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sxyz_w(t, startType, endType, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.RangeFromTo(RangeType.!(f(t)), startType, endType);
	}
	case RangeFromPlus(t: RangeType, startType: IntType, lengthType: IntType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sxyz_w(t, startType, lengthType, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.RangeFromPlus(RangeType.!(f(t)), startType, lengthType);
	}
	case RangeGetElem(t: RangeType, it: IntType) {
		def sig() -> Signature => Sxy_z(t, it, t.elementType());
		def subst(f: Type -> Type) -> Opcode => Opcode.RangeGetElem(RangeType.!(f(t)), it);
	}
	case RangeSetElem(t: RangeType, it: IntType) {
		def sig() -> Signature => Sxyz_w(t, it, t.elementType(), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.RangeSetElem(RangeType.!(f(t)), it);
	}
	case RangeGetLength(t: RangeType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(t, Int.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.RangeGetLength(RangeType.!(f(t)));
	}
	// Normalized range operations; {t} is the type of the array underlying the range, whose
	// start is passed as a separate #RangeStart parameter.
	case RangeStartPlusIndex(t: ArrayType, it: IntType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sxyz_w(t, V3Range.START_TYPE, it, V3Range.START_TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.RangeStartPlusIndex(ArrayType.!(f(t)), it);
	}
	case NormRangeGetElem(t: ArrayType, it: IntType) {
		def sig() -> Signature => Sxyz_w(t, V3Range.START_TYPE, it, t.elementType());
		def subst(f: Type -> Type) -> Opcode => Opcode.NormRangeGetElem(ArrayType.!(f(t)), it);
	}
	case NormRangeGetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() -> Signature => Sxyz_w(t, V3Range.START_TYPE, it, tupleElem(t, index));
		def subst(f: Type -> Type) -> Opcode => Opcode.NormRangeGetElemElem(ArrayType.!(f(t)), it, index);
	}
	case NormRangeSetElem(t: ArrayType, it: IntType) {
		def sig() -> Signature => Sxyzw_v(t, V3Range.START_TYPE, it, t.elementType(), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.NormRangeSetElem(ArrayType.!(f(t)), it);
	}
	case NormRangeSetElemElem(t: ArrayType, it: IntType, index: int) {
		def sig() -> Signature => Sxyzw_v(t, V3Range.START_TYPE, it, tupleElem(t, index), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.NormRangeSetElemElem(ArrayType.!(f(t)), it, index);
	}
	// Component operations
	case Init(method: IrMethod) 				{ def sig() -> Signature => S_x(method.receiver); }
	case ComponentGetField(t: ComponentType, field: IrField) { def facts() -> Fact.set => NOCHK; def sig() -> Signature => Sx_y(t, fieldType(t, field)); }
	case ComponentSetField(t: ComponentType, field: IrField) { def facts() -> Fact.set => NOCHK; def sig() -> Signature => Sxy_z(t, fieldType(t, field), Void.TYPE); }
	// Class operations
	case ClassAlloc(t: ClassType) {
		def facts() -> Fact.set => NONZERO;
		def sig() -> Signature => S_x(t);
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassAlloc(ClassType.!(f(t)));
	}
	case ClassAllocWithDescriptor(t: ClassType, descType: Type) {
		def facts() -> Fact.set => NONZERO;
		def sig() -> Signature => Sx_y(descType, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassAllocWithDescriptor(ClassType.!(f(t)), f(descType));
	}
	case ClassNew(spec: IrSpec) {
		def sig() -> Signature => Sa_x(Function.getParamTypeArray(spec.getBoundType()), spec.receiver);
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassNew(spec.subst(f));
	}
	case ClassGetField(t: ClassType, field: IrField) {
		def sig() -> Signature => Sx_y(t, fieldType(t, field));
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassGetField(ClassType.!(f(t)), field);
	}
	case ClassInitField(t: ClassType, field: IrField) {
		def facts() -> Fact.set => NOCHK;
		def sig() -> Signature => Sxy_z(t, fieldType(t, field), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassInitField(ClassType.!(f(t)), field);
	}
	case ClassSetField(t: ClassType, field: IrField) {
		def sig() -> Signature => Sxy_z(t, fieldType(t, field), Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassSetField(ClassType.!(f(t)), field);
	}
	case ClassGetMethod(spec: IrSpec) {
		def facts() -> Fact.set => NONZERO|FOLD;
		def sig() -> Signature => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassGetMethod(spec.subst(f));
	}
	case ClassGetVirtual(spec: IrSpec) {
		def facts() -> Fact.set => NONZERO|FOLD;
		def sig() -> Signature => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassGetVirtual(spec.subst(f));
	}
	case ClassGetSelector(spec: IrSpec) {
		def facts() -> Fact.set => NONZERO|FOLD;
		def sig() -> Signature => Sx_y(spec.receiver, spec.getFuncType());
		def subst(f: Type -> Type) -> Opcode => Opcode.ClassGetSelector(spec.subst(f));
	}
	// Variant operations
	case VariantEq(t: ClassType) {
		def facts() -> Fact.set => PURE|COMM;
		def sig() -> Signature => Sxx_y(t, Bool.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantEq(ClassType.!(f(t)));
	}
	case VariantGetTag(t: ClassType) {
		def facts() -> Fact.set => PURE|NONNEG;
		def sig() -> Signature => Sx_y(t, V3.classDecl(t).tagType);
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantGetTag(ClassType.!(f(t)));
	}
	// The (constant) representation tag of a specific variant case.
	case VariantRepTag(t: ClassType) {
		def facts() -> Fact.set => PURE|NONNEG;
		def sig() -> Signature => S_x(Int.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantRepTag(ClassType.!(f(t)));
	}
	// Extract the representation tag from a (possibly packed) variant value.
	case VariantGetRepTag(t: ClassType) {
		def facts() -> Fact.set => PURE|NONNEG;
		def sig() -> Signature => Sx_y(t, Int.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantGetRepTag(ClassType.!(f(t)));
	}
	case VariantAlloc(t: ClassType, fieldTypes: Array<Type>) {
		def sig() -> Signature => Sa_x(fieldTypes, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantAlloc(ClassType.!(f(t)), Arrays.map(fieldTypes, f));
	}
	case VariantGetField(t: ClassType, field: IrField) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(t, fieldType(t, field));
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantGetField(ClassType.!(f(t)), field);
	}
	case VariantGetMethod(spec: IrSpec) {
		def facts() -> Fact.set => NONZERO|PURE;
		def sig() -> Signature => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantGetMethod(spec.subst(f));
	}
	case VariantGetVirtual(spec: IrSpec) {
		def facts() -> Fact.set => NONZERO|PURE;
		def sig() -> Signature => Sx_y(spec.receiver, spec.getBoundType());
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantGetVirtual(spec.subst(f));
	}
	case VariantGetSelector(spec: IrSpec) {
		def facts() -> Fact.set => NONZERO|PURE;
		def sig() -> Signature => Sx_y(spec.receiver, spec.getFuncType());
		def subst(f: Type -> Type) -> Opcode => Opcode.VariantGetSelector(spec.subst(f));
	}
	// Safety checks
	case NullCheck(t: Type)		{ def facts() -> Fact.set => FOLD|NONZERO; def sig() -> Signature => Sx_x(t); def subst(f: Type -> Type) -> Opcode => Opcode.NullCheck(f(t)); }
	case BoundsCheck(t: Type)	{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sxy_z(t, Int.TYPE, Void.TYPE); def subst(f: Type -> Type) -> Opcode => Opcode.BoundsCheck(f(t)); }
	case DescriptorCheck(t: ClassType) {
		def facts() -> Fact.set => FOLD|NONZERO;
		def sig() -> Signature => Sx_x(t);
		def subst(f: Type -> Type) -> Opcode => Opcode.DescriptorCheck(ClassType.!(f(t)));
	}
	case ConditionalThrow(exception: string)	{ def facts() -> Fact.set => FOLD; def sig() -> Signature => Sx_y(Bool.TYPE, Void.TYPE); }
	// Overloaded, polymorphic casts. A substitution keeps the cast or query computed for the
	// original types; the optimizer recomputes it for the new types.
	case OverloadedEq(t: Type) {
		def facts() -> Fact.set => PURE|COMM;
		def sig() -> Signature => Sxx_y(t, Bool.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.OverloadedEq(f(t));
	}
	case TypeCast(cast: TypeCast, from: Type, to: Type) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sx_y(from, to);
		def subst(f: Type -> Type) -> Opcode => Opcode.TypeCast(cast, f(from), f(to));
	}
	case TypeQuery(query: TypeQuery, from: Type, to: Type) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(from, Bool.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.TypeQuery(query, f(from), f(to));
	}
	case TypeSubsume(from: Type, to: Type) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(from, to);
		def subst(f: Type -> Type) -> Opcode => Opcode.TypeSubsume(f(from), f(to));
	}
	// Closure and call operations
	case CallMethod(spec: IrSpec) 		{ def sig() -> Signature => unboundSig(spec); def subst(f: Type -> Type) -> Opcode => Opcode.CallMethod(spec.subst(f)); }
	case CallClassMethod(spec: IrSpec) 	{ def sig() -> Signature => unboundSig(spec); def subst(f: Type -> Type) -> Opcode => Opcode.CallClassMethod(spec.subst(f)); }
	case CallClassVirtual(spec: IrSpec) 	{ def sig() -> Signature => unboundSig(spec); def subst(f: Type -> Type) -> Opcode => Opcode.CallClassVirtual(spec.subst(f)); }
	case CallClassSelector(spec: IrSpec) 	{ def sig() -> Signature => unboundSig(spec); def subst(f: Type -> Type) -> Opcode => Opcode.CallClassSelector(spec.subst(f)); }
	case CallVariantVirtual(spec: IrSpec) 	{ def sig() -> Signature => unboundSig(spec); def subst(f: Type -> Type) -> Opcode => Opcode.CallVariantVirtual(spec.subst(f)); }
	case CallVariantSelector(spec: IrSpec) 	{ def sig() -> Signature => unboundSig(spec); def subst(f: Type -> Type) -> Opcode => Opcode.CallVariantSelector(spec.subst(f)); }
	// The closure is passed as the first argument.
	case CallClosure(t: FuncType) {
		def sig() -> Signature => Sa_x(Arrays.prepend<Type>(t, Function.getParamTypeArray(t)), t.returnType());
		def subst(f: Type -> Type) -> Opcode => Opcode.CallClosure(FuncType.!(f(t)));
	}
	// The function reference is passed as the first argument.
	case CallFunction(t: FuncType) {
		def sig() -> Signature => Sa_x(Arrays.prepend<Type>(t, Function.getParamTypeArray(t)), t.returnType());
		def subst(f: Type -> Type) -> Opcode => Opcode.CallFunction(FuncType.!(f(t)));
	}
	// Binds {spec} to an object of type {t}.
	case CreateClosure(spec: IrSpec, t: Type) {
		def facts() -> Fact.set => NONZERO|PURE|NOCHK;
		def sig() -> Signature => Sx_y(t, spec.getBoundType());
		def subst(f: Type -> Type) -> Opcode => Opcode.CreateClosure(spec.subst(f), f(t));
	}
	case ForgeClosure(ptrType: PointerType, receiver: Type, param: Type, result: Type) {
		def facts() -> Fact.set => PURE|NOCHK;
		def sig() -> Signature => Sxy_z(ptrType, receiver, Function.newType(param, result));
		def subst(f: Type -> Type) -> Opcode => Opcode.ForgeClosure(ptrType, f(receiver), f(param), f(result));
	}
	case UnpackClosure(ptrType: PointerType, receiver: Type, param: Type, result: Type) {
		def facts() -> Fact.set => PURE|NOCHK;
		def sig() -> Signature => Sx_y(Function.newType(param, result), Tuple.newType(Lists.cons2(ptrType, receiver)));
		def subst(f: Type -> Type) -> Opcode => Opcode.UnpackClosure(ptrType, f(receiver), f(param), f(result));
	}
	case ForgeRange(elemType: Type, ptrType: PointerType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sxy_z(ptrType, Int.TYPE, V3Range.newType(elemType));
		def subst(f: Type -> Type) -> Opcode => Opcode.ForgeRange(f(elemType), ptrType);
	}
	// Return a value to a (previously captured) return address.
	case ReturnTo(returnType: Type, ptrType: PointerType) {
		def sig() -> Signature => Sxy_z(ptrType, returnType, Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ReturnTo(f(returnType), ptrType);
	}
	// RefLayout operations
	case RefLayoutAt(t: RefType)					{ def facts() -> Fact.set => NONZERO|FOLD; def sig() -> Signature => Sxy_z(V3.arrayByteType, Int.TYPE, t); }
	case RefLayoutOf(t: RefType)					{ def sig() -> Signature => Sx_y(V3.rangeByteType, t); }
	case RefLayoutIn(t: RefType, offset: int, result: RefType)	{ def facts() -> Fact.set => PURE|FOLD; def sig() -> Signature => Sx_y(t, result); }
	case RefLayoutGetField(t: RefType, offset: int, order: ByteOrder, fieldType: Type) {
		def sig() -> Signature => Sx_y(t, fieldType);
		def subst(f: Type -> Type) -> Opcode => Opcode.RefLayoutGetField(t, offset, order, f(fieldType));
	}
	case RefLayoutSetField(t: RefType, offset: int, order: ByteOrder, fieldType: Type) {
		def sig() -> Signature => Sxy_z(t, fieldType, Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.RefLayoutSetField(t, offset, order, f(fieldType));
	}
	case RefLayoutAtRepeatedField(t: RefType, offset: int, scale: int, max: int, result: RefType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sxy_z(t, Int.TYPE, result);
	}
	case RefLayoutGetRepeatedField(t: RefType, offset: int, scale: int, max: int, order: ByteOrder, fieldType: Type) {
		def sig() -> Signature => Sxy_z(t, Int.TYPE, fieldType);
		def subst(f: Type -> Type) -> Opcode => Opcode.RefLayoutGetRepeatedField(t, offset, scale, max, order, f(fieldType));
	}
	case RefLayoutSetRepeatedField(t: RefType, offset: int, scale: int, max: int, order: ByteOrder, fieldType: Type) {
		def sig() -> Signature => Sxyz_w(t, Int.TYPE, fieldType, Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.RefLayoutSetRepeatedField(t, offset, scale, max, order, f(fieldType));
	}
	// {startType} is {int} or #RangeStart.
	case ByteArrayGetField(fieldType: Type, startType: Type, offset: int, order: ByteOrder) {
		def sig() -> Signature => Sxy_z(V3.arrayByteType, startType, fieldType);
		def subst(f: Type -> Type) -> Opcode => Opcode.ByteArrayGetField(f(fieldType), f(startType), offset, order);
	}
	case ByteArraySetField(fieldType: Type, startType: Type, offset: int, order: ByteOrder) {
		def sig() -> Signature => Sxyz_w(V3.arrayByteType, startType, fieldType, Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.ByteArraySetField(f(fieldType), f(startType), offset, order);
	}
	// Pointer tagging operations (for unboxing and descriptor tricks)
	case SetAuxTag(t: PointerType, tagType: Type) {
		def sig() -> Signature => Sxy_z(t, tagType, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.SetAuxTag(t, f(tagType));
	}
	case GetAuxTag(t: PointerType, it: IntType)	{ def sig() -> Signature => Sx_y(t, it); }
	case SetRefTag(t: PointerType, tagType: Type) {
		def sig() -> Signature => Sxy_z(t, tagType, t);
		def subst(f: Type -> Type) -> Opcode => Opcode.SetRefTag(t, f(tagType));
	}
	case GetRefTag(t: PointerType, it: IntType)	{ def sig() -> Signature => Sx_y(t, it); }
	// setDescriptorExtension<D>(desc: D, refmap: int, byteSize: int) -> void
	case SetDescriptorExtension(t: Type) {
		def sig() -> Signature => Sxyz_w(t, Int.TYPE, Int.TYPE, Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.SetDescriptorExtension(f(t));
	}
	// System operations
	// The parameter and result types are normalized along with the program.
	case SystemCall(syscall: SystemCall, paramTypes: Array<Type>, resultType: Type) {
		def sig() -> Signature => Sa_x(paramTypes, resultType);
		def subst(f: Type -> Type) -> Opcode => Opcode.SystemCall(syscall, Arrays.map(paramTypes, f), f(resultType));
	}
	// Container for VST operations
	case VstSugar(vstOp: VstOperator, typeArgs: Array<Type>, paramTypes: Array<Type>, resultType: Type) {
		def sig() -> Signature => Sa_x(paramTypes, resultType);
		def subst(f: Type -> Type) -> Opcode => Opcode.VstSugar(vstOp, Arrays.map(typeArgs, f), Arrays.map(paramTypes, f), f(resultType));
	}

// ------- Machine-level operations ---------------------------------------------
	// Pointer arithmetic. Machine lowering also applies {PtrAdd}, {PtrLoad}, and {PtrStore}
	// directly to references, so their {t} is a {Type}.
	case PtrAdd(t: Type, it: IntType)		{ def facts() -> Fact.set => FOLD|REMOV; def sig() -> Signature => Sxy_x(t, it); def subst(f: Type -> Type) -> Opcode => Opcode.PtrAdd(f(t), it); }
	case PtrSub(t: PointerType, it: IntType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, it); }
	case PtrLt(t: PointerType)			{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	case PtrLteq(t: PointerType)			{ def facts() -> Fact.set => PURE; def sig() -> Signature => Sxx_y(t, Bool.TYPE); }
	// Pointer-to-interior operations (compute addresses within objects/arrays/ranges)
	case PtrAtContents(t: RangeType, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtContents(RangeType.!(f(t)), ptrType);
	}
	case PtrAtLength(t: ArrayType, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtLength(ArrayType.!(f(t)), ptrType);
	}
	case PtrAtObject(t: Type, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtObject(f(t), ptrType);
	}
	case PtrAtRangeElem(t: RangeType, it: IntType, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sxy_z(t, it, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtRangeElem(RangeType.!(f(t)), it, ptrType);
	}
	case PtrAtArrayElem(t: ArrayType, it: IntType, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sxy_z(t, it, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtArrayElem(ArrayType.!(f(t)), it, ptrType);
	}
	case PtrAtEnd(t: Type, ptrType: PointerType) {
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtEnd(f(t), ptrType);
	}
	// {t} is a {RefType} once instantiated.
	case PtrAtRef(t: Type, ptrType: PointerType) {
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtRef(f(t), ptrType);
	}
	case PtrAtComponentField(t: ComponentType, field: IrField, ptrType: PointerType)	{ def facts() -> Fact.set => PURE; def sig() -> Signature => S_x(ptrType); }
	case PtrAtObjectField(t: ClassType, field: IrField, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtObjectField(ClassType.!(f(t)), field, ptrType);
	}
	case PtrAtRefLayoutField(t: RefType, offset: int, ptrType: PointerType)	{ def sig() -> Signature => Sx_y(t, ptrType); }
	// Address of a field reached through a chain of unboxed (inlined) fields
	case PtrAtUnboxedObjectField(t: ClassType, fields: List<IrField>, ptrType: PointerType) {
		def facts() -> Fact.set => FOLD;
		def sig() -> Signature => Sx_y(t, ptrType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrAtUnboxedObjectField(ClassType.!(f(t)), fields, ptrType);
	}
	case PtrAtUnboxedComponentField(t: ComponentType, fields: List<IrField>, ptrType: PointerType) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(t, ptrType);
	}
	// Pointer memory operations
	case PtrCmpSwp(t: PointerType, valType: Type) {
		def sig() -> Signature => Sxyz_w(t, valType, valType, Bool.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrCmpSwp(t, f(valType));
	}
	case PtrLoad(t: Type, valType: Type) {
		def sig() -> Signature => Sx_y(t, valType);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrLoad(f(t), f(valType));
	}
	case PtrStore(t: Type, valType: Type) {
		def sig() -> Signature => Sxy_z(t, valType, Void.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.PtrStore(f(t), f(valType));
	}
	case PtrAddRangeStart(t: PointerType)		{ def facts() -> Fact.set => FOLD|REMOV; def sig() -> Signature => Sxy_x(t, V3Range.START_TYPE); }
	// Get caller instruction pointer or stack pointer
	case CallerIp(ptrType: PointerType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => S_x(ptrType); }
	case CallerSp(ptrType: PointerType)		{ def facts() -> Fact.set => PURE; def sig() -> Signature => S_x(ptrType); }
	// Allocate raw memory for an object of type {t}
	case Alloc(t: Type)				{ def sig() -> Signature => Sx_y(Int.TYPE, t); def subst(f: Type -> Type) -> Opcode => Opcode.Alloc(f(t)); }
	// Wasm target
	case WasmFunctionTypeId(paramType: Type, resultType: Type) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => S_x(Int.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.WasmFunctionTypeId(f(paramType), f(resultType));
	}
	case WasmFunctionId(paramType: Type, resultType: Type) {
		def facts() -> Fact.set => PURE;
		def sig() -> Signature => Sx_y(Function.newType(paramType, resultType), Int.TYPE);
		def subst(f: Type -> Type) -> Opcode => Opcode.WasmFunctionId(f(paramType), f(resultType));
	}
	// For testing the register allocator and the garbage collector
	case KillRegisters			{ def sig() -> Signature => Sv_v(); }
	case ForceGc				{ def sig() -> Signature => Sv_v(); }
	// Machine-level calls
	case CallAddress(rep: Mach_FuncRep) {
		def sig() -> Signature => Sa_x(rep.paramTypes, Function.getReturnType(rep.machType.nested.head));
	}
	// Kernel.syscall<T>(number: int, args: T) -> resultType
	case CallKernel(kernel: Kernel, t: Type, resultType: Type) {
		def sig() -> Signature => Signature.new(null, [Int.TYPE, t], Tuple.toTypeArray(resultType));
		def subst(f: Type -> Type) -> Opcode => Opcode.CallKernel(kernel, f(t), resultType);
	}

	// Structural equality, comparing the specializations of members and arrays of types by value.
	def equals(that: Opcode) -> bool {
		if (this == that) return true;
		if (this.tag != that.tag) return false;
		match (this) {
			IntWide(wideOp, paramTypes, resultType) => {
				var x = Opcode.IntWide.!(that);
				return wideOp == x.wideOp && Arrays.equal(paramTypes, x.paramTypes) && resultType == x.resultType;
			}
			VariantAlloc(t, fieldTypes) => {
				var x = Opcode.VariantAlloc.!(that);
				return t == x.t && Arrays.equal(fieldTypes, x.fieldTypes);
			}
			SystemCall(syscall, paramTypes, resultType) => {
				var x = Opcode.SystemCall.!(that);
				return syscall == x.syscall && Arrays.equal(paramTypes, x.paramTypes) && resultType == x.resultType;
			}
			VstSugar(vstOp, typeArgs, paramTypes, resultType) => {
				var x = Opcode.VstSugar.!(that);
				return vstOp == x.vstOp && Arrays.equal(typeArgs, x.typeArgs)
					&& Arrays.equal(paramTypes, x.paramTypes) && resultType == x.resultType;
			}
			CreateClosure(spec, t) => {
				var x = Opcode.CreateClosure.!(that);
				return t == x.t && spec.equals(x.spec);
			}
			_ => {
				var a = Opcodes.specOf(this);
				return a != null && a.equals(Opcodes.specOf(that));
			}
		}
	}
}

component Opcodes {
	// Renders the name of {op} and the members, types, and constants it carries.
	def render(op: Opcode, buf: StringBuilder) -> StringBuilder {
		buf.puts(op.name);
		match (op) {
			IntEq(t)	=> appendT(t, buf);
			IntAdd(t)	=> appendT(t, buf);
			IntSub(t)	=> appendT(t, buf);
			IntMul(t)	=> appendT(t, buf);
			IntDiv(t)	=> appendT(t, buf);
			IntMod(t)	=> appendT(t, buf);
			IntAnd(t)	=> appendT(t, buf);
			IntOr(t)	=> appendT(t, buf);
			IntXor(t)	=> appendT(t, buf);
			IntShl(t)	=> appendT(t, buf);
			IntSar(t)	=> appendT(t, buf);
			IntShr(t)	=> appendT(t, buf);
			IntLt(t)	=> appendT(t, buf);
			IntLteq(t)	=> appendT(t, buf);
			IntWide(wideOp, paramTypes, resultType) => buf.putc('[').puts(wideOp.opcode.name).putc(']');
			FloatAdd(t)	=> appendT(t, buf);
			FloatSub(t)	=> appendT(t, buf);
			FloatMul(t)	=> appendT(t, buf);
			FloatDiv(t)	=> appendT(t, buf);
			FloatBitEq(t)	=> appendT(t, buf);
			FloatEq(t)	=> appendT(t, buf);
			FloatNe(t)	=> appendT(t, buf);
			FloatLt(t)	=> appendT(t, buf);
			FloatLteq(t)	=> appendT(t, buf);
			FloatAbs(t)	=> appendT(t, buf);
			FloatCeil(t)	=> appendT(t, buf);
			FloatFloor(t)	=> appendT(t, buf);
			FloatSqrt(t)	=> appendT(t, buf);
			IntCastF(from, to)	=> appendTT(from, to, buf);
			IntQueryF(from, to)	=> appendTT(from, to, buf);
			IntViewI(from, to)	=> appendTT(from, to, buf);
			IntViewB(to)		=> appendT(to, buf);
			IntViewP(from, to)	=> appendTT(from, to, buf);
			EnumViewI(from, to)	=> appendTT(from, to, buf);
			EnumSetViewI(from, to)	=> appendTT(from, to, buf);
			IntViewF(from)		=> appendT(from, buf);
			IntTruncF(from, to)	=> appendTT(from, to, buf);
			FloatCastI(from, to)	=> appendTT(from, to, buf);
			FloatQueryI(from, to)	=> appendTT(from, to, buf);
			FloatPromoteI(from, to)	=> appendTT(from, to, buf);
			FloatViewI(from, to)	=> appendTT(from, to, buf);
			FloatRoundI(from, to)	=> appendTT(from, to, buf);
			FloatRound(t)		=> appendT(t, buf);
			RefEq(t)		=> appendT(t, buf);
			DefaultValue(t)		=> appendT(t, buf);
			TupleCreate(t)		=> appendT(t, buf);
			TupleGetElem(t, index)	=> appendIdxT(index, t, buf);
			ArrayAlloc(t)		=> appendT(t, buf);
			ArrayFill(t)		=> appendT(t, buf);
			ArrayInit(t, length)	=> appendIdxT(length, t, buf);
			ArrayTupleInit(t, elems, length) => {
				buf.putc('[').putd(elems).putc(',').putd(length).putc(']');
				appendT(t, buf);
			}
			ArrayGetElem(t, it)		=> appendTT(t, it, buf);
			ArraySetElem(t, it)		=> appendTT(t, it, buf);
			ArrayGetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			ArraySetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			ArrayGetLength(t)		=> appendT(t, buf);
			RangeFromTo(t, startType, endType)	=> appendTTT(t, startType, endType, buf);
			RangeFromPlus(t, startType, lengthType)	=> appendTTT(t, startType, lengthType, buf);
			RangeGetElem(t, it)		=> appendTT(t, it, buf);
			RangeSetElem(t, it)		=> appendTT(t, it, buf);
			RangeGetLength(t)		=> appendT(t, buf);
			RangeStartPlusIndex(t, it)	=> appendTT(t, it, buf);
			NormRangeGetElem(t, it)			=> appendTT(t, it, buf);
			NormRangeGetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			NormRangeSetElem(t, it)			=> appendTT(t, it, buf);
			NormRangeSetElemElem(t, it, index)	=> appendIdxTT(index, t, it, buf);
			Init(method)			=> appendMember(method, buf);
			ComponentGetField(t, field)	=> appendMember(field, buf);
			ComponentSetField(t, field)	=> appendMember(field, buf);
			ClassAlloc(t)			=> appendT(t, buf);
			ClassAllocWithDescriptor(t, d)	=> appendTT(t, d, buf);
			ClassNew(spec)			=> appendSpec(spec, buf);
			ClassGetField(t, field)		=> appendMemberT(field, t, buf);
			ClassInitField(t, field)	=> appendMemberT(field, t, buf);
			ClassSetField(t, field)		=> appendMemberT(field, t, buf);
			ClassGetMethod(spec)		=> appendSpec(spec, buf);
			ClassGetVirtual(spec)		=> appendSpec(spec, buf);
			ClassGetSelector(spec)		=> appendSpec(spec, buf);
			VariantEq(t)			=> appendT(t, buf);
			VariantGetTag(t)		=> appendT(t, buf);
			VariantRepTag(t)		=> appendT(t, buf);
			VariantGetRepTag(t)		=> appendT(t, buf);
			VariantAlloc(t, fieldTypes)	=> appendT(t, buf);
			VariantGetField(t, field)	=> appendMemberT(field, t, buf);
			VariantGetMethod(spec)		=> appendSpec(spec, buf);
			VariantGetVirtual(spec)		=> appendSpec(spec, buf);
			VariantGetSelector(spec)	=> appendSpec(spec, buf);
			NullCheck(t)		=> appendT(t, buf);
			BoundsCheck(t)		=> appendT(t, buf);
			DescriptorCheck(t)	=> appendT(t, buf);
			ConditionalThrow(exception) => buf.putc('[').puts(exception).putc(']');
			OverloadedEq(t)		=> appendT(t, buf);
			TypeCast(cast, from, to)	=> { buf.putc('[').puts(cast.name).putc(']'); appendTT(from, to, buf); }
			TypeQuery(query, from, to)	=> { buf.putc('[').puts(query.name).putc(']'); appendTT(from, to, buf); }
			TypeSubsume(from, to)		=> appendTT(from, to, buf);
			CallMethod(spec)		=> appendSpec(spec, buf);
			CallClassMethod(spec)		=> appendSpec(spec, buf);
			CallClassVirtual(spec)		=> appendSpec(spec, buf);
			CallClassSelector(spec)		=> appendSpec(spec, buf);
			CallVariantVirtual(spec)	=> appendSpec(spec, buf);
			CallVariantSelector(spec)	=> appendSpec(spec, buf);
			CallClosure(t)			=> appendT(t, buf);
			CallFunction(t)			=> appendT(t, buf);
			CreateClosure(spec, t)		=> { appendSpec(spec, buf); appendT(t, buf); }
			ForgeClosure(ptrType, receiver, param, result)	=> appendTTT(receiver, param, result, buf);
			UnpackClosure(ptrType, receiver, param, result)	=> appendTTT(receiver, param, result, buf);
			ForgeRange(elemType, ptrType)		=> appendTT(elemType, ptrType, buf);
			ReturnTo(returnType, ptrType)		=> appendTT(returnType, ptrType, buf);
			RefLayoutAt(t)				=> appendT(t, buf);
			RefLayoutOf(t)				=> appendT(t, buf);
			RefLayoutIn(t, offset, result)		=> appendIdxTT(offset, t, result, buf);
			RefLayoutGetField(t, offset, order, fieldType)	=> appendIdxOrderTT(offset, order, t, fieldType, buf);
			RefLayoutSetField(t, offset, order, fieldType)	=> appendIdxOrderTT(offset, order, t, fieldType, buf);
			RefLayoutAtRepeatedField(t, offset, scale, max, result) => {
				buf.putc('[').putd(offset).putc(',').putd(scale).putc(']');
				appendTT(t, result, buf);
			}
			RefLayoutGetRepeatedField(t, offset, scale, max, order, fieldType) => {
				buf.putc('[').putd(offset).putc(',').putd(scale).putc(',').puts(order.name).putc(']');
				appendTT(t, fieldType, buf);
			}
			RefLayoutSetRepeatedField(t, offset, scale, max, order, fieldType) => {
				buf.putc('[').putd(offset).putc(',').putd(scale).putc(',').puts(order.name).putc(']');
				appendTT(t, fieldType, buf);
			}
			ByteArrayGetField(fieldType, startType, offset, order)	=> appendIdxOrderTT(offset, order, fieldType, startType, buf);
			ByteArraySetField(fieldType, startType, offset, order)	=> appendIdxOrderTT(offset, order, fieldType, startType, buf);
			SetAuxTag(t, tagType)		=> appendTT(t, tagType, buf);
			GetAuxTag(t, it)		=> appendTT(t, it, buf);
			SetRefTag(t, tagType)		=> appendTT(t, tagType, buf);
			GetRefTag(t, it)		=> appendTT(t, it, buf);
			SetDescriptorExtension(t)	=> appendT(t, buf);
			SystemCall(syscall, paramTypes, resultType)	=> buf.putc('[').puts(syscall.name).putc(']');
			VstSugar(vstOp, typeArgs, paramTypes, resultType) => buf.putc('[').puts(vstOp.name).putc(']');
			PtrAdd(t, it)		=> appendTT(t, it, buf);
			PtrSub(t, it)		=> appendTT(t, it, buf);
			PtrLt(t)		=> appendT(t, buf);
			PtrLteq(t)		=> appendT(t, buf);
			PtrAtContents(t, ptrType)		=> appendTT(t, ptrType, buf);
			PtrAtLength(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtObject(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtRangeElem(t, it, ptrType)		=> appendTTT(t, it, ptrType, buf);
			PtrAtArrayElem(t, it, ptrType)		=> appendTTT(t, it, ptrType, buf);
			PtrAtEnd(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtRef(t, ptrType)			=> appendTT(t, ptrType, buf);
			PtrAtComponentField(t, field, ptrType)	=> appendMember(field, buf);
			PtrAtObjectField(t, field, ptrType)	=> appendMemberT(field, t, buf);
			PtrAtRefLayoutField(t, offset, ptrType)	=> appendIdxTT(offset, t, ptrType, buf);
			PtrAtUnboxedObjectField(t, fields, ptrType)	=> appendMembers(fields, buf);
			PtrAtUnboxedComponentField(t, fields, ptrType)	=> appendMembers(fields, buf);
			PtrCmpSwp(t, valType)	=> appendTT(t, valType, buf);
			PtrLoad(t, valType)	=> appendTT(t, valType, buf);
			PtrStore(t, valType)	=> appendTT(t, valType, buf);
			PtrAddRangeStart(t)	=> appendT(t, buf);
			CallerIp(ptrType)	=> appendT(ptrType, buf);
			CallerSp(ptrType)	=> appendT(ptrType, buf);
			Alloc(t)		=> appendT(t, buf);
			WasmFunctionTypeId(paramType, resultType)	=> appendTT(paramType, resultType, buf);
			WasmFunctionId(paramType, resultType)		=> appendTT(paramType, resultType, buf);
			CallAddress(rep)	=> appendT(rep.machType, buf);
			CallKernel(kernel, t, resultType) => { buf.putc('[').puts(kernel.name).putc(']'); appendT(t, buf); }
			_ => ;  // name only: Bool*, FloatCastD, FloatQueryD, FloatPromoteF, FloatRoundD, KillRegisters, ForceGc
		}
		return buf;
	}
	// The member specialization carried by {opcode}, if any.
	def specOf(opcode: Opcode) -> IrSpec {
		match (opcode) {
			ClassNew(spec) => return spec;
			ClassGetMethod(spec) => return spec;
			ClassGetVirtual(spec) => return spec;
			ClassGetSelector(spec) => return spec;
			VariantGetMethod(spec) => return spec;
			VariantGetVirtual(spec) => return spec;
			VariantGetSelector(spec) => return spec;
			CallMethod(spec) => return spec;
			CallClassMethod(spec) => return spec;
			CallClassVirtual(spec) => return spec;
			CallClassSelector(spec) => return spec;
			CallVariantVirtual(spec) => return spec;
			CallVariantSelector(spec) => return spec;
			CreateClosure(spec, t) => return spec;
			_ => return null;
		}
	}
	// Equality for {t}, which depends on the kind of the type.
	def newEqual(t: Type) -> Operator {
		match (t.typeCon.kind) {
			BOOL => return Opcode.BoolEq.op();
			ENUM, ENUM_SET, INT => return Opcode.IntEq(t).op();
			FLOAT => return Opcode.FloatEq(FloatType.!(t)).op();
			POINTER, ARRAY, CLASS, ANYREF, ANYFUNC, FUNCREF, RANGE_START => return Opcode.RefEq(t).op();
			VARIANT => return Opcode.VariantEq(ClassType.!(t)).op();
			_ => return Opcode.OverloadedEq(t).op();
		}
	}
	def newTypeCast(from: Type, to: Type) -> Operator {
		return Opcode.TypeCast(TypeSystem.newTypeCast(from, to), from, to).op();
	}
	def newTypeQuery(from: Type, to: Type) -> Operator {
		return Opcode.TypeQuery(TypeSystem.newTypeQuery(from, to), from, to).op();
	}
	// Element access and length of an array or a range {t}.
	def newArrayGetElem(t: Type, it: IntType) -> Operator {
		if (V3.isArray(t)) return Opcode.ArrayGetElem(ArrayType.!(t), it).op();
		return Opcode.RangeGetElem(RangeType.!(t), it).op();
	}
	def newArraySetElem(t: Type, it: IntType) -> Operator {
		if (V3.isArray(t)) return Opcode.ArraySetElem(ArrayType.!(t), it).op();
		return Opcode.RangeSetElem(RangeType.!(t), it).op();
	}
	def newArrayGetLength(t: Type) -> Operator {
		if (V3.isArray(t)) return Opcode.ArrayGetLength(ArrayType.!(t)).op();
		return Opcode.RangeGetLength(RangeType.!(t)).op();
	}
	// A call through a function reference of type {t}, whose first parameter is the receiver.
	def newCallFunction(t: Type) -> Operator {
		var ft = Function.funcRefType(Function.prependParamType(MachModule.getAnyRefType(), t));
		if (ft.typeCon.kind != Kind.FUNCREF) return V3.fail("only function types allowed");
		return Opcode.CallFunction(FuncType.!(ft)).op();
	}
	// Call, closure, or selector for {spec}, devirtualized if the member is not overridden.
	def bestCallVirtual(spec: IrSpec) -> Operator {
		var overridden = spec.member.flags.M_OVERRIDDEN;
		if (spec.receiver.typeCon.kind == Kind.CLASS) {
			return (if(overridden, Opcode.CallClassVirtual(spec), Opcode.CallClassMethod(spec))).op();
		}
		return (if(overridden, Opcode.CallVariantVirtual(spec), Opcode.CallMethod(spec))).op();
	}
	def bestGetVirtual(spec: IrSpec) -> Operator {
		var overridden = spec.member.flags.M_OVERRIDDEN;
		if (spec.receiver.typeCon.kind == Kind.CLASS) {
			return (if(overridden, Opcode.ClassGetVirtual(spec), Opcode.ClassGetMethod(spec))).op();
		}
		return (if(overridden, Opcode.VariantGetVirtual(spec), Opcode.VariantGetMethod(spec))).op();
	}
	def bestGetSelector(spec: IrSpec) -> Operator {
		if (spec.receiver.typeCon.kind == Kind.CLASS) return Opcode.ClassGetSelector(spec).op();
		return Opcode.VariantGetSelector(spec).op();
	}
	// Append <t>
	def appendT(t: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('<');
		t.render(buf);
		return buf.putc('>');
	}
	// Append <t1,t2>
	def appendTT(t1: Type, t2: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('<');
		t1.render(buf);
		buf.putc(',');
		t2.render(buf);
		return buf.putc('>');
	}
	// Append <t1,t2,t3>
	def appendTTT(t1: Type, t2: Type, t3: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('<');
		t1.render(buf);
		buf.putc(',');
		t2.render(buf);
		buf.putc(',');
		t3.render(buf);
		return buf.putc('>');
	}
	// Append [n]<t>
	def appendIdxT(n: int, t: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('[').putd(n).putc(']');
		return appendT(t, buf);
	}
	// Append [n]<t1,t2>
	def appendIdxTT(n: int, t1: Type, t2: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('[').putd(n).putc(']');
		return appendTT(t1, t2, buf);
	}
	// Append [n,order]<t1,t2>
	def appendIdxOrderTT(n: int, order: ByteOrder, t1: Type, t2: Type, buf: StringBuilder) -> StringBuilder {
		buf.putc('[').putd(n).putc(',').puts(order.name).putc(']');
		return appendTT(t1, t2, buf);
	}
	// Append [member]
	def appendMember(m: IrMember, buf: StringBuilder) -> StringBuilder {
		buf.putc('[');
		m.render(buf);
		return buf.putc(']');
	}
	// Append [member]<t>
	def appendMemberT(m: IrMember, t: Type, buf: StringBuilder) -> StringBuilder {
		appendMember(m, buf);
		return appendT(t, buf);
	}
	// Append [member,member,...]
	def appendMembers(members: List<IrField>, buf: StringBuilder) -> StringBuilder {
		buf.putc('[');
		for (l = members; l != null; l = l.tail) {
			l.head.render(buf);
			if (l.tail != null) buf.putc(',');
		}
		return buf.putc(']');
	}
	// Append [spec]
	def appendSpec(spec: IrSpec, buf: StringBuilder) -> StringBuilder {
		buf.putc('[');
		spec.render(buf);
		return buf.putc(']');
	}
}

// Shorthands for the optimization facts of opcodes.
def FOLD = Fact.O_FOLDABLE;
def PURE = Fact.O_PURE | Fact.O_FOLDABLE; // pure => foldable
def COMM = Fact.O_COMMUTATIVE;
def REMOV = Fact.O_REMOVABLE;
def NONZERO = Fact.V_NON_ZERO;
def NONNEG = Fact.V_NON_NEGATIVE;
def NOCHK = Fact.O_NO_NULL_CHECK;

// Shorthands for building signatures; e.g. {Sxy_z} is (x, y) -> z.
def Sa_x(paramTypes: Array<Type>, returnType: Type) -> Signature {
	return Signature.new(null, paramTypes, [returnType]);
}
def S_x(x: Type) -> Signature { return Sa_x(TypeUtil.NO_TYPES, x); }
def Sx_x(x: Type) -> Signature { return Sa_x([x], x); }
def Sx_y(x: Type, y: Type) -> Signature { return Sa_x([x], y); }
def Sxx_x(x: Type) -> Signature { return Sa_x([x, x], x); }
def Sxx_y(x: Type, y: Type) -> Signature { return Sa_x([x, x], y); }
def Sxy_x(x: Type, y: Type) -> Signature { return Sa_x([x, y], x); }
def Sxy_z(x: Type, y: Type, z: Type) -> Signature { return Sa_x([x, y], z); }
def Sxyz_w(x: Type, y: Type, z: Type, w: Type) -> Signature { return Sa_x([x, y, z], w); }
def Sxyzw_v(x: Type, y: Type, z: Type, w: Type, v: Type) -> Signature { return Sa_x([x, y, z, w], v); }
def Sv_v() -> Signature { return Signature.new(null, TypeUtil.NO_TYPES, TypeUtil.NO_TYPES); }

// The signature of a direct call to {spec}.
def unboundSig(spec: IrSpec) -> Signature {
	var t = spec.getUnboundType();
	return Sa_x(Function.getParamTypeArray(t), Function.getReturnType(t));
}
// The type of {field} in an object of type {receiver}.
def fieldType(receiver: Type, field: IrField) -> Type {
	return IrSpec.new(receiver, [receiver], field).getFieldType();
}
// The flattened parameter types of an {ArrayTupleInit}: the array's tuple element
// types, concatenated {length} times.
def tupleElemsRepeat(t: ArrayType, elems: int, length: int) -> Array<Type> {
	var types = Tuple.toTypeArray(t.elementType());
	var result = Array<Type>.new(elems * length);
	var i = 0;
	for (j < length) {
		for (k < types.length) result[i++] = types[k];
	}
	return result;
}
// The {index}th component of an array's tuple element type.
def tupleElem(t: ArrayType, index: int) -> Type {
	return Tuple.elementType(t.elementType(), index);
}
def repeatType(t: Type, length: int) -> Array<Type> {
	var result = Array<Type>.new(length);
	for (i < length) result[i] = t;
	return result;
}
