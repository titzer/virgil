// A Result represents the result of evaluating an expression, which can either
// be a Val or an Exception.
class Result { }
// A Val represents a runtime value, such as integer, object reference, tuple, etc.
class Val extends Result {
	def equals(val: Val) -> bool { return this == val; }
	def identical(val: Val) -> bool { return equals(val); }
	def hash() -> int { return 0; }
}
// An Exception represents an exceptional result (i.e. not a value), for example a
// safety violation such as !NullCheckException or !DivideByZeroException.
class Exception(error: string, msg: string, trace: List<Source>) extends Result { }
// The Box class provides a utility to simplify using first-order values
// (e.g. the integer 0) as meta-level values (e.g. the Constant #0).
class Box<T>(val: T) extends Val {
	def equals(other: Val) -> bool {
		if (other == this) return true;
		if (other == Values.BOTTOM) {
			var none: T;
			return this.val == none;
		}
		return Box<T>.?(other) && this.val == Box<T>.!(other).val;
	}
	def hash() -> int {
		if (Box<int>.?(this)) return Box<int>.!(this).val;
		if (Box<bool>.?(this)) return if(Box<bool>.!(this).val, 111111);
		if (Box<long>.?(this)) {
			var v = Box<long>.!(this).val;
			return int.view(v ^ v >> 32);
		}
		return 0;
	}
}
// The source position in a method, such as for an exception stacktrace.
class Source(mdecl: VstMethod, line: int, column: int, tail: Source, range: FileRange) {
	def render(buf: StringBuilder) -> StringBuilder {
		mdecl.renderLong(buf.puts("in ")).puts("()");
		if (line >= 0) buf.put3(" [%s @ %d:%d]", mdecl.token.fileName, line, column);
		return buf;
	}
}
// Utility methods for values.
component Values {
	var BOTTOM: Val = null;
	def equal(a: Val, b: Val) -> bool {
		return if(a != null, a.equals(b), b == null || b.equals(null));
	}
	def identical(a: Val, b: Val) -> bool {
		return if(a != null, a.identical(b), b == null || b.identical(null));
	}
	def deepEqual(x: Array<Val>, y: Array<Val>) -> bool {
		return Arrays.allTrue(x, y, equal);
	}
	def deepIdentical(x: Array<Val>, y: Array<Val>) -> bool {
		return Arrays.allTrue(x, y, identical);
	}
	def deepEqualBottom(vals: Array<Val>) -> bool {
		for (v in vals) {
			if (v == null) continue;
			if (!v.equals(null)) return false;
		}
		return true;
	}
	def deepIdenticalBottom(vals: Array<Val>) -> bool {
		for (v in vals) if (!identical(v, null)) return false;
		return true;
	}
	def hash(v: Val) -> int {
		return if(v != null, v.hash());
	}
	def isZero(v: Val) -> bool {
		return v == null || v.identical(null);
	}
	def isReflexive(v: Val) -> bool {
		return v == null || v.equals(v);
	}
}

// A tuple value, which is always compared for structural equivalence, i.e. two {BoxVal}s are
// equivalent if all their values are equivalent. This is tricky because they can contain
// floating point values, which have NaN values where none is equivalent to any other, including itself.
// {BoxVals} are immutable and cannot be recursive.
class BoxVal(values: Array<Val>) extends Val {
	private var id: int;		// 0 is unset, < 0 implies non-reflexive, > 0 implies reflexive
	private var h0: int = 0;

	def equals(other: Val) -> bool {
		if (this == other) return isReflexive();
		if (this.id < 0) return false;				// non-reflexive; equal to nothing
		match (other) {
			that: BoxVal => {
				if (that.id < 0) return false;		// non-reflexive; equal to nothing
				if (this.id > 0 && this.id == that.id) return true;
				if (!Values.deepEqual(this.values, that.values)) return false;
				unify(that);
				return true;
			}
			null => {
				if (!Values.deepEqualBottom(values)) return false;
				if (id == 0) id = UID.next++;		// all-bottom, hence reflexive
				return true;
			}
			_ => return false;
		}
	}
	// Memoize whether this value is equal to itself, i.e. contains no NaN.
	private def isReflexive() -> bool {
		if (id == 0) id = if(Values.deepEqual(values, values), UID.next++, -1);
		return id > 0;
	}
	// Join two deeply-equal values into one equivalence class, so later compares are cheap.
	private def unify(that: BoxVal) {
		var m = this.id;
		if (m == 0 || (that.id > 0 && that.id < m)) m = that.id;
		if (m == 0) m = UID.next++;
		this.id = that.id = m;
	}
	def identical(other: Val) -> bool {
		if (other == this) return true;
		if (other == null) return Values.deepIdenticalBottom(values);
		if (!BoxVal.?(other)) return false;
		return Values.deepIdentical(this.values, BoxVal.!(other).values);
	}
	def hash() -> int {
		if (h0 != 0) return h0;
		return h0 = int.max & Arrays.hash(0, values, Values.hash);	// all-bottom hashes to 0, like null
	}
}
