// A Result represents the result of evaluating an expression, which can either
// be a Val or an Exception.
class Result { }
// A Val represents a runtime value, such as integer, object reference, tuple, etc.
class Val extends Result {
	def equals(val: Val) -> bool { return this == val; }
	def hash() -> int { return 0; }
}
// An Exception represents an exceptional result (i.e. not a value), for example a
// safety violation such as !NullCheckException or !DivideByZeroException.
class Exception(error: string, msg: string, trace: List<Source>) extends Result { }
// The Box class provides a utility to simplify using first-order values
// (e.g. the integer 0) as meta-level values (e.g. the Constant #0).
class Box<T>(val: T) extends Val {
	def equals(other: Val) -> bool {
		if (other == this) return true;
		if (other == Values.BOTTOM) {
			var none: T;
			return this.val == none;
		}
		return Box<T>.?(other) && this.val == Box<T>.!(other).val;
	}
	def hash() -> int {
		if (Box<int>.?(this)) return Box<int>.!(this).val;
		if (Box<bool>.?(this)) return if(Box<bool>.!(this).val, 111111);
		if (Box<long>.?(this)) {
			var v = Box<long>.!(this).val;
			return int.view(v ^ v >> 32);
		}
		return 0;
	}
}
// The source position in a method, such as for an exception stacktrace.
class Source(mdecl: VstMethod, line: int, column: int, tail: Source, range: FileRange) {
	def render(buf: StringBuilder) -> StringBuilder {
		mdecl.renderLong(buf.puts("in ")).puts("()");
		if (line >= 0) buf.put3(" [%s @ %d:%d]", mdecl.token.fileName, line, column);
		return buf;
	}
}
// Utility methods for values.
component Values {
	var BOTTOM: Val = null;
	def equal(val1: Val, val2: Val) -> bool {
		if (val1 == null) return val2 == null || val2.equals(null);
		return val1.equals(val2);
	}
	def deepEqual(vals1: Array<Val>, vals2: Array<Val>) -> bool {
		if (vals1.length != vals2.length) return false;
		for (i < vals1.length) {
			var v1 = vals1[i], v2 = vals2[i];
			if (v1 == null) {
				if (v2 != null && !v2.equals(v1)) return false;
			} else if (!v1.equals(v2)) {
				return false;
			}
		}
		return true;
	}
	def deepEqualBottom(vals: Array<Val>) -> bool {
		for (v in vals) {
			if (v == null) continue;
			if (!v.equals(null)) return false;
		}
		return true;
	}
	def hash(v: Val) -> int {
		return if(v != null, v.hash());
	}
	// Representation identity, as opposed to language-level equality. Constant
	// interning must not merge values that `equal` considers equal but that have
	// distinct representations, e.g. -0 and +0.
	def identical(v1: Val, v2: Val) -> bool {
		if (v1 == v2) return true;
		if (v1 == null || v2 == null) return false;
		match (v1) {
			x: Float32Val => return Float32Val.?(v2) && Float32Val.!(v2).bits == x.bits;
			x: Float64Val => return Float64Val.?(v2) && Float64Val.!(v2).bits == x.bits;
			x: BoxVal => {
				if (!BoxVal.?(v2)) return false;
				var y = BoxVal.!(v2);
				if (x.t != y.t) return false;
				if (x.values.length != y.values.length) return false;
				for (i < x.values.length) if (!identical(x.values[i], y.values[i])) return false;
				return true;
			}
			x: Record => return false; // records have identity; handled by v1 == v2 above
			_ => return v1.equals(v2);
		}
	}
	def isZero(v: Val) -> bool {
		return v == null || identical(v, null);
	}
}

def RECURSIVE_HASH = -2;
def UNINIT_BOX_ID = -1;
def NON_REFLEXIVE_VALUE = -2;
class BoxVal(t: Type, values: Array<Val>) extends Val {
	private var id = UNINIT_BOX_ID;
	private var h0: int = 0;

	def equals(other: Val) -> bool {
		if (id == NON_REFLEXIVE_VALUE) return false; // value isn't even equal to itself, e.g. because NaN field
		if (other == this) {
			if (id >= 0) return true;
			if (Values.deepEqual(this.values, this.values)) { id = UID.next++; return true; }
			else { id = NON_REFLEXIVE_VALUE; return false; }
		}
		match (other) {
			that: BoxVal => {
				if (id >= 0 && this.id == that.id) return true;	// already checked this pair
				if (this.t != that.t) return false;		// types must match (XXX: type is always null)
				if (this.hash() != that.hash()) return false;	// hashes must match
				if (Values.deepEqual(this.values, that.values)) {
					// All values are equal. Make both have the same, smallest ID.
					if (this.id < 0) {
						if (that.id >= 0) this.id = that.id;
						else this.id = that.id = UID.next++;
					} else if (that.id < 0 || this.id < that.id) {
						that.id = this.id;
					} else if (that.id < this.id) {
						this.id = that.id;
					}
					return true;
				}
				return false;
			}
			null => {
				if (t != null) return false;
				if (Values.deepEqualBottom(this.values)) {
					if (this.id < 0) this.id = UID.next++;
					return true;
				}
				return false;
			}
			_ => return false;
		}
	}
	def hash() -> int {
		if (h0 >= 0) return h0;
		var nhash = if(t == null, values.length, t.hash);	// initial new hash
		if (h0 == RECURSIVE_HASH) return h0 = int.max & nhash | 0x4000_0000;	// cycle check
		h0 = RECURSIVE_HASH;
		for (v in values) {
			nhash = nhash * 33 + Values.hash(v);		// recursive hash
			if (h0 >= 0) return h0;				// recursive cycle detected
		}
		return h0 = int.max & nhash | 0x4000_0000;
	}
}
