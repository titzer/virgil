// Where an annotation is attached. Mirrors the TargetKind enum in
// lib/annotations/TargetKind.v3, which is what a user writes in "@target(...)"; this is
// the compiler's own copy, because a site must be classified whether or not the standard
// annotations have been loaded.
enum AnnotationTarget {
	Program, File, AnnotationType, AnnotationField,
	Class, Component, Variant, Enum, VariantCase, EnumCase,
	Field, Method, Constructor, Parameter,
	TypeUse, Block,
	// Not accepted by the parser; present so the two enums correspond.
	Formal, Actual, Local, Statement, Expression,
	// No TargetKind counterpart: an annotation used as a VALUE, inside another
	// annotation's arguments, is not attached to anything, so @target does not apply.
	Value
}

// Binds every use of "@name" to its declaration.
//
// The target kind is derived from a top-down walk rather than stored on the annotation by
// the parser: a stored field would be redundant, could drift from the parser, and cannot
// separate the three things that share VarDecl -- a local, a value parameter, and an
// annotation field.
//
// Checking a use against its declaration's @target is NOT done here. That needs @target's
// argument evaluated, and its argument names TargetKind, which lives in
// lib/annotations/TargetKind.v3 and is only present once the standard annotations are
// loaded. See doc/annotations-verifier.md.
//
// See doc/annotations-verifier.md section 4.
class AnnotationResolver(ERROR: ErrorGen, prog: Program, env: AnnotationEnv) {
	// Every use, in the order found, so later passes need no second walk of the AST.
	def uses = Vector<VstAnnotation>.new();

	def resolveProgram() {
		var vst = prog.vst;
		for (f in vst.files) resolveFile(f);
		for (i < vst.annotationDecls.length) {
			var d = vst.annotationDecls[i];
			resolveList(d.file, d.annotations, AnnotationTarget.AnnotationType);
			if (d.fields != null) {
				for (l = d.fields.list; l != null; l = l.tail) {
					resolveList(d.file, l.head.annotations, AnnotationTarget.AnnotationField);
				}
			}
		}
		for (i < vst.annotationAliases.length) {
			var a = vst.annotationAliases[i];
			resolveList(a.file, a.annotations, AnnotationTarget.AnnotationType);
		}
		for (i < vst.components.length) resolveCompound(vst.components[i], AnnotationTarget.Component);
		for (i < vst.classes.length) {
			var c = vst.classes[i];
			// Case classes lifted to top level carry the same annotations as the
			// VstCaseMember they came from, which the member walk already visits.
			if (c.isSynthetic) continue;
			resolveCompound(c, if(c.kind == Kind.VARIANT, AnnotationTarget.Variant, AnnotationTarget.Class));
		}
		for (i < vst.enums.length) resolveCompound(vst.enums[i], AnnotationTarget.Enum);
		for (i < vst.layouts.length) resolveCompound(vst.layouts[i], AnnotationTarget.Class);
		for (i < vst.packings.length) resolveCompound(vst.packings[i], AnnotationTarget.Class);
	}
	private def resolveFile(file: VstFile) {
		if (file == null) return;
		for (i < file.annotations.length) resolve(file, file.annotations[i], AnnotationTarget.File);
	}
	private def resolveCompound(c: VstCompound, target: AnnotationTarget) {
		var file = fileOf(c);
		resolveList(file, c.annotations, target);
		for (t = c.typeParams; t != null; t = t.tail) {
			resolveList(file, t.head.annotations, AnnotationTarget.Parameter);
		}
		for (l = c.members; l != null; l = l.tail) resolveMember(file, l.head);
	}
	private def resolveMember(file: VstFile, m: VstMember) {
		var target: AnnotationTarget;
		match (m) {
			x: VstNew => target = AnnotationTarget.Constructor;
			x: VstMethod => target = AnnotationTarget.Method;
			x: VstEnumCase => target = AnnotationTarget.EnumCase;
			x: VstCaseMember => target = AnnotationTarget.VariantCase;
			_ => target = AnnotationTarget.Field;
		}
		resolveList(file, m.annotations, target);
		match (m) {
			x: VstMethod => {
				if (x.func != null && x.func.params != null) {
					for (l = x.func.params.list; l != null; l = l.tail) {
						resolveList(file, l.head.annotations, AnnotationTarget.Formal);
					}
				}
			}
			_ => ;
		}
	}
	// Called from resolveType for annotations on a type reference, and from the type
	// checker for a block.
	def resolveAt(file: VstFile, list: VstList<VstAnnotation>, target: AnnotationTarget) {
		resolveList(file, list, target);
	}
	private def resolveList(file: VstFile, list: VstList<VstAnnotation>, target: AnnotationTarget) {
		if (list == null) return;
		for (l = list.list; l != null; l = l.tail) resolve(file, l.head, target);
		checkRepeats(file, list);
	}
	// "Attached twice at the same position" is exactly one list, and whether a declaration
	// is @repeatable is syntactic, so this needs no evaluation.
	private def checkRepeats(file: VstFile, list: VstList<VstAnnotation>) {
		for (l = list.list; l != null; l = l.tail) {
			for (m = l.tail; m != null; m = m.tail) {
				if (!Strings.equal(l.head.name.image, m.head.name.image)) continue;
				if (isRepeatable(m.head.binding)) continue;
				err(file, m.head.name).set("AnnotationError",
					Strings.format1("\"@%s\" is not @repeatable but is attached more than once", m.head.name.image));
				return;
			}
		}
	}
	private def isRepeatable(b: AnnotationBinding) -> bool {
		var anns: VstList<VstAnnotation>;
		match (b) {
			Decl(d) => anns = d.annotations;
			Alias(a) => anns = a.annotations;
			_ => return true; // unresolved; do not pile on
		}
		if (anns == null) return false;
		for (l = anns.list; l != null; l = l.tail) {
			if (Strings.equal(l.head.name.image, "repeatable")) return true;
		}
		return false;
	}
	// An annotation may appear as a value inside another's arguments, e.g.
	// "@clones_type(@atomic)". Those are reached here rather than by the site walk, since
	// they are attached to nothing.
	private def resolveNested(file: VstFile, e: Expr) {
		if (e == null) return;
		match (e) {
			x: AnnotationExpr => {
				resolve(file, x.ann, AnnotationTarget.Value);
				resolveArgs(file, x.ann);
			}
			x: AnnotatedExpr => {
				resolveList(file, x.annotations, AnnotationTarget.TypeUse);
				resolveNested(file, x.expr);
			}
			x: VarExpr => resolveNested(file, x.expr);
			x: AppExpr => {
				resolveNested(file, x.func);
				resolveNested(file, x.args);
			}
			x: TupleExpr => { for (l = x.exprs.list; l != null; l = l.tail) resolveNested(file, l.head); }
			x: ArrayExpr => { for (l = x.exprs.list; l != null; l = l.tail) resolveNested(file, l.head); }
			x: BinOpExpr => { resolveNested(file, x.left); resolveNested(file, x.right); }
			_ => ;
		}
	}
	private def resolveArgs(file: VstFile, a: VstAnnotation) {
		if (a.args == null) return;
		for (l = a.args.list; l != null; l = l.tail) resolveNested(file, l.head.value);
	}
	private def resolve(file: VstFile, a: VstAnnotation, target: AnnotationTarget) {
		if (a.binding.tag != AnnotationBinding.None.tag) return; // already resolved
		a.target = target;
		a.file = file;
		uses.put(a);
		var name = a.name.image;
		var found = env.lookup(name, file);
		if (found == null) {
			// A program may declare and use its own annotations without the standard
			// ones, so a missing name is normally just undeclared. But a missing
			// STANDARD name almost always means lib/annotations was not loaded, and
			// "not declared" would send the reader looking in the wrong place.
			if (isStandardName(name)) {
				err(file, a.name).set("AnnotationError",
					Strings.format1("annotation \"@%s\" is not declared; the standard annotations are not loaded (see -lang.annotation-files)", name));
			} else {
				err(file, a.name).set("AnnotationError",
					Strings.format1("annotation \"@%s\" is not declared", name));
			}
			return;
		}
		if (found.tail != null) {
			// Overloaded. Choosing needs @target evaluated, so leave the candidates for
			// AnnotationChecker and resolve the arguments regardless.
			a.candidates = found;
			resolveArgs(file, a);
			return;
		}
		a.binding = found.head;
		resolveArgs(file, a);
	}
	// The meta-annotations declared in lib/annotations/Standard.v3.
	private def isStandardName(name: string) -> bool {
		match (name.length) {
			6 => return Strings.equal(name, "target");
			8 => return Strings.equal(name, "required") || Strings.equal(name, "implicit");
			9 => return Strings.equal(name, "retention");
			10 => return Strings.equal(name, "repeatable");
			11 => return Strings.equal(name, "clones_type");
		}
		return false;
	}
	private def fileOf(c: VstCompound) -> VstFile {
		// VstCompound has no file back-pointer; find it by scanning. Declarations are few
		// and this runs once, so a scan is cheaper than a new field on every compound.
		for (f in prog.vst.files) {
			if (f == null) continue;
			for (i < f.classes.length) if (f.classes[i] == c) return f;
			for (i < f.components.length) if (f.components[i] == c) return f;
			for (i < f.enums.length) if (f.enums[i] == c) return f;
			for (i < f.layouts.length) if (f.layouts[i] == c) return f;
			for (i < f.packings.length) if (f.packings[i] == c) return f;
		}
		return null;
	}
	private def err(file: VstFile, token: Token) -> SourceCodeError {
		var range = token.range();
		var line = if(file != null, file.extractLine(range.beginLine));
		var obj = SourceCodeError.new(range, line);
		ERROR.addErrorObj(obj);
		return obj;
	}
}
