#!/usr/bin/env bash

BIN=$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)
V3C=${V3C:=$BIN/v3c}

if [ ! -t 0 ] || [ ! -t 1 ] || ! STTY=$(stty -g 2> /dev/null); then
    exec $V3C -run -debug "$@"
fi

# Let the debugger edit lines itself, which enables history and tab completion.
# Keep signals, so that ctrl-C still stops a runaway program.
trap 'stty "$STTY"' EXIT
stty -icanon -echo min 1 time 0
$V3C -run -debug -debug-tty "$@"
