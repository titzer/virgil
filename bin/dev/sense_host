#!/usr/bin/env bash

BIN=$(cd $(dirname ${BASH_SOURCE[0]}) && pwd)
V3C_LINK=$BIN/v3c

PLATFORM=$(uname -sm)

HOSTS=""

# Rosetta 2 allows arm64 Darwin machines to run x86-64 Darwin binaries.
# Set USE_ROSETTA2=1 to assume it is available, USE_ROSETTA2=0 to ignore it;
# otherwise sense it by looking for the runtime that its installer puts down.
ROSETTA2_RUNTIME=/Library/Apple/usr/libexec/oah/libRosettaRuntime

function has_rosetta2() {
    if [ -n "$USE_ROSETTA2" ]; then
	[ "$USE_ROSETTA2" = 1 ]
	return
    fi
    [ -f "$ROSETTA2_RUNTIME" ]
}

# Is this script itself running as an x86-64 process translated by Rosetta 2?
function is_translated() {
    [ "$(sysctl -n sysctl.proc_translated 2> /dev/null)" = 1 ]
}

if [[ "$PLATFORM" = "Darwin i386" ]]; then
    HOSTS="x86-darwin $HOSTS"
fi

if [[ "$PLATFORM" = "Darwin x86_64" ]]; then
    MAJOR=$(uname -r | cut -d. -f1)
    if [[ "$MAJOR" -lt "19" ]] ; then # Darwin 19 removed support for 32-bit
	HOSTS="x86-64-darwin x86-darwin $HOSTS"
    elif is_translated; then # the underlying machine is arm64
	HOSTS="x86-64-darwin arm64-darwin $HOSTS"
    else
	HOSTS="x86-64-darwin $HOSTS"
    fi
fi

if [[ "$PLATFORM" = "Darwin arm64" ]]; then
    if has_rosetta2; then
        HOSTS="arm64-darwin x86-64-darwin $HOSTS"
    else
        HOSTS="arm64-darwin $HOSTS"
    fi
fi

if [[ "$PLATFORM" = "Linux i386" || "$PLATFORM" = "Linux i686" ]]; then
    HOSTS="x86-linux $HOSTS"
fi

if [[ "$PLATFORM" = "Linux x86_64" ]]; then
    HOSTS="x86-linux x86-64-linux $HOSTS"
fi

if [[ "$PLATFORM" = "Linux aarch64" ]]; then
    HOSTS="arm64-linux $HOSTS"
fi

JAVA=$(which java)

if [ ! -z "$JAVA" ]; then
    HOSTS="$HOSTS jar"
fi

if [ -n "$HOSTS" ]; then
   echo $HOSTS
else
   echo unknown platform: $PLATFORM
   exit 1
fi
