#!/usr/bin/env bash
BIN=$(dirname ${BASH_SOURCE[0]})
BIN=$(cd $BIN && pwd)
RT=$(cd $BIN/../rt/jvm/bin && pwd)
V3C=${V3C:=$BIN/v3c}
LIB=$(cd $BIN/../lib && pwd)
# Standard annotation declarations; only used when -lang:annotations is on, and
# ignored by compilers built before the option existed.
ANN_FILES=$(echo $LIB/annotations/*.v3)
exec $V3C -lang.annotation-files="$ANN_FILES" -target=jar -jvm.script -jvm.rt-path=$RT "$@"
