def msg = "Hello, Linux!\n";

def main() -> int {
	var sysnum = if (Pointer.SIZE == 8, 1, 4);
	var ptr = Pointer.atContents(msg);
	var t = Linux.syscall(sysnum, (1, ptr, msg.length));
	return retval(t);
}

def retval<T>(v: T) -> int {
	match (v) {
		x: (int, int) => return x.0;
		x: (long, long) => return int.view(x.0);
		_ => return 42;
	}
}
