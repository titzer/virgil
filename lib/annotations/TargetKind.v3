// Target kinds and retentions for the annotation facility.
//
// This half of the standard annotations uses no annotation syntax, so it parses
// under any compiler, including one built before annotations existed. Only its
// companion, Standard.v3, needs -lang:annotations. Keeping the split means the
// bootstrap compiler can never be handed syntax it cannot read, and that a stale
// compiler fed the annotated half fails in a file containing nothing but
// annotation declarations, which is self-explanatory.
//
// See doc/annotations-syntax.md.

// Where an annotation may be attached.
enum TargetKind {
	// Whole compilation units
	Program,			// the program, via -@program= on the command line
	File,				// one source file, via @file(...)

	// Annotation declarations themselves (meta-annotations)
	AnnotationType,			// prefixed to @type
	AnnotationField,		// a field of an annotation type

	// Type and namespace declarations
	Class,
	Component,
	Variant,
	Enum,
	VariantCase,			// 'case X' inside a variant, including 'case _'
	EnumCase,			// a case inside an enum body

	// Members
	Field,				// of a class, component, variant, or enum
	Method,
	Constructor,			// 'new'
	Parameter,			// a formal *type* parameter: <@ann T>

	// Uses and code
	TypeUse,			// a type reference: @ann Array<int>
	Block,				// a '{ ... }' statement

	// Declared for completeness; the parser does not accept annotations at
	// these positions. See doc/annotations-syntax.md section 10.
	Formal,				// a value parameter of a method
	Actual,				// an argument expression at a call
	Local,				// a local variable
	Statement,
	Expression
}

// How far through compilation an annotation is retained.
enum Retention {
	Source,				// checked, then dropped after verification
	Compiler			// kept through SSA and normalization
}

// Named groupings of target kinds. These are ordinary enum-set constants, so a
// user may union them freely: @target(TargetKinds.Container | TargetKind.Field).
//
// Note these live in a component rather than at file scope: a top-level 'def'
// becomes a member of the file's synthetic component, which is file-scoped and
// so would not be visible to user programs.
component TargetKinds {
	// Everything that declares a name.
	def Declaration: TargetKind.set =
		TargetKind.Class | TargetKind.Component | TargetKind.Variant |
		TargetKind.Enum | TargetKind.VariantCase | TargetKind.EnumCase |
		TargetKind.Field | TargetKind.Method | TargetKind.Constructor |
		TargetKind.Parameter | TargetKind.Formal | TargetKind.Local;

	// Everything that contains other declarations.
	def Container: TargetKind.set =
		TargetKind.Program | TargetKind.File | TargetKind.Class |
		TargetKind.Component | TargetKind.Variant | TargetKind.Enum;

	// Everything that carries executable code.
	def Code: TargetKind.set =
		TargetKind.Method | TargetKind.Constructor | TargetKind.Block |
		TargetKind.Statement | TargetKind.Expression;

	// The kinds the parser actually accepts. An annotation whose @target lies
	// wholly outside this set can never be used, and is diagnosed at its
	// declaration rather than at a use site.
	def Supported: TargetKind.set =
		TargetKind.Program | TargetKind.File | TargetKind.AnnotationType |
		TargetKind.AnnotationField | TargetKind.Class | TargetKind.Component |
		TargetKind.Variant | TargetKind.Enum | TargetKind.VariantCase |
		TargetKind.EnumCase | TargetKind.Field | TargetKind.Method |
		TargetKind.Constructor | TargetKind.Parameter | TargetKind.TypeUse |
		TargetKind.Block;
}
