// The standard meta-annotations.
//
// STATUS: PROPOSED. This file does not compile yet -- it uses the annotation
// syntax proposed in doc/annotations-syntax.md, which is not implemented. It is
// written as real Virgil source, rather than as a sketch, so that it serves as
// the first end-to-end test of that syntax.
//
// Requires -lang:annotations, and requires TargetKind.v3, which holds the parts
// that need no annotation syntax. Do NOT add this file to aeneas/DEPS or to any
// unconditional wrapper-script glob: a compiler built before annotations existed
// cannot parse it, and the bootstrap's first stage runs exactly such a compiler.
//
// Three things are deliberately NOT declared here:
//
//   @file, @apply  -- reserved by the grammar itself (doc/annotations-syntax.md
//                     sections 5 and 3.3). The compiler knows them structurally,
//                     so declaring them would be misleading.
//   @this, @outer  -- not annotations at all. They are target designators in the
//                     annotation-value sublanguage, valid only to the left of a
//                     '.@name' query. No @type declaration could describe them.
//
// All six declarations below are interpreted by the compiler, which finds them
// by name in this file. Because annotation names form a single program-wide
// namespace, these names are effectively unique.
//
// Several are annotated with themselves -- @target is @target-ed. Virgil is a
// whole-program compiler and declaration order is not significant, so the
// self-reference is well-formed, exactly as Java's @Target is itself @Target.

// Constrains where an annotation may be attached. An annotation type with no
// @target may be attached anywhere in TargetKinds.Supported.
//
// @repeatable, so both of the design note's spellings work, and a third comes
// free from enum sets:
//     @target(TargetKind.Class) @target(TargetKind.Variant)   -- repeated
//     @target(TargetKind.Class | TargetKind.Variant)          -- unioned
//     @target(TargetKinds.Container)                          -- a grouping
// Repetitions are unioned. Note that this removes the need for the array form
// '@target([TargetKind.Class, ...])' the design note contemplated.
@target(TargetKind.AnnotationType)
@repeatable
@type target(value: TargetKind.set);

// Allows an annotation to be attached more than once at the same position.
@target(TargetKind.AnnotationType)
@type repeatable;

// Marks a field of an annotation type as having no default: omitting it at a use
// site is an error. A field with neither @required nor an initializer defaults to
// the default value of its type.
@target(TargetKind.AnnotationField)
@type required;

// How far through compilation the annotation survives.
@target(TargetKind.AnnotationType)
@type retention(value: Retention = Retention.Compiler);

// Supplies a value wherever an explicit annotation is absent, which is what makes
// an annotation propagate inward from containers without being written at every
// position.
//
// @repeatable, and repetitions are tried in source order: the first whose value
// fully resolves wins. This replaces the design note's @or -- absence is
// discharged here and only here, so "unavailable" never has to propagate through
// arbitrary compile-time expressions. See doc/annotations-syntax.md section 11C.
//
//     @implicit(@outer.@atomicity)
//     @implicit(@atomicity(Atomicity.Nonatomic))
//     @type atomicity(value: Atomicity);
//
// The last repetition should be unconditional, or the annotation can still be
// absent after implicit resolution.
@target(TargetKind.AnnotationType)
@repeatable
@type implicit(value: Annotation);

// Declares that annotating a type use produces a distinct *clone* of that type,
// carrying the annotations named here. Distinct annotation values yield distinct
// clones. @repeatable, so several annotations may be placed on the clone.
@target(TargetKind.AnnotationType)
@repeatable
@type clones_type(value: Annotation);
