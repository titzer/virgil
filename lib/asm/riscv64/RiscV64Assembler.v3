// Assembler for the 64-bit RISC-V architecture (RV64IMAFD + Zicsr + Zifencei).
// See "The RISC-V Instruction Set Manual, Volume I: Unprivileged ISA" for encodings.
//
// Every instruction is a fixed 32-bit little-endian word in one of six formats
// (R, I, S, B, U, J), plus the R4 format used by fused multiply-add. Immediates are
// always sign-extended and, for branches and jumps, are byte offsets from the
// instruction's own address that must be even.

// A general purpose register, x0-x31. {name} is the ABI name that assemblers and
// disassemblers use (zero, ra, sp, gp, tp, t0-t6, s0-s11, a0-a7).
class RiscV64Gpr(name: string, regnum: u5) {}
// A floating point register, f0-f31 (ABI names ft0-ft11, fs0-fs11, fa0-fa7).
class RiscV64Fpr(name: string, regnum: u5) {}

// Global constants for all RISC-V registers.
component RiscV64Regs {
	def ZERO = RiscV64Gpr.new("zero", 0);
	def RA = RiscV64Gpr.new("ra", 1);
	def SP = RiscV64Gpr.new("sp", 2);
	def GP = RiscV64Gpr.new("gp", 3);
	def TP = RiscV64Gpr.new("tp", 4);
	def T0 = RiscV64Gpr.new("t0", 5), T1 = RiscV64Gpr.new("t1", 6), T2 = RiscV64Gpr.new("t2", 7);
	def S0 = RiscV64Gpr.new("s0", 8), S1 = RiscV64Gpr.new("s1", 9);
	def A0 = RiscV64Gpr.new("a0", 10), A1 = RiscV64Gpr.new("a1", 11);
	def A2 = RiscV64Gpr.new("a2", 12), A3 = RiscV64Gpr.new("a3", 13);
	def A4 = RiscV64Gpr.new("a4", 14), A5 = RiscV64Gpr.new("a5", 15);
	def A6 = RiscV64Gpr.new("a6", 16), A7 = RiscV64Gpr.new("a7", 17);
	def S2 = RiscV64Gpr.new("s2", 18), S3 = RiscV64Gpr.new("s3", 19);
	def S4 = RiscV64Gpr.new("s4", 20), S5 = RiscV64Gpr.new("s5", 21);
	def S6 = RiscV64Gpr.new("s6", 22), S7 = RiscV64Gpr.new("s7", 23);
	def S8 = RiscV64Gpr.new("s8", 24), S9 = RiscV64Gpr.new("s9", 25);
	def S10 = RiscV64Gpr.new("s10", 26), S11 = RiscV64Gpr.new("s11", 27);
	def T3 = RiscV64Gpr.new("t3", 28), T4 = RiscV64Gpr.new("t4", 29);
	def T5 = RiscV64Gpr.new("t5", 30), T6 = RiscV64Gpr.new("t6", 31);
	def FP = S0;

	def FT0 = RiscV64Fpr.new("ft0", 0), FT1 = RiscV64Fpr.new("ft1", 1);
	def FT2 = RiscV64Fpr.new("ft2", 2), FT3 = RiscV64Fpr.new("ft3", 3);
	def FT4 = RiscV64Fpr.new("ft4", 4), FT5 = RiscV64Fpr.new("ft5", 5);
	def FT6 = RiscV64Fpr.new("ft6", 6), FT7 = RiscV64Fpr.new("ft7", 7);
	def FS0 = RiscV64Fpr.new("fs0", 8), FS1 = RiscV64Fpr.new("fs1", 9);
	def FA0 = RiscV64Fpr.new("fa0", 10), FA1 = RiscV64Fpr.new("fa1", 11);
	def FA2 = RiscV64Fpr.new("fa2", 12), FA3 = RiscV64Fpr.new("fa3", 13);
	def FA4 = RiscV64Fpr.new("fa4", 14), FA5 = RiscV64Fpr.new("fa5", 15);
	def FA6 = RiscV64Fpr.new("fa6", 16), FA7 = RiscV64Fpr.new("fa7", 17);
	def FS2 = RiscV64Fpr.new("fs2", 18), FS3 = RiscV64Fpr.new("fs3", 19);
	def FS4 = RiscV64Fpr.new("fs4", 20), FS5 = RiscV64Fpr.new("fs5", 21);
	def FS6 = RiscV64Fpr.new("fs6", 22), FS7 = RiscV64Fpr.new("fs7", 23);
	def FS8 = RiscV64Fpr.new("fs8", 24), FS9 = RiscV64Fpr.new("fs9", 25);
	def FS10 = RiscV64Fpr.new("fs10", 26), FS11 = RiscV64Fpr.new("fs11", 27);
	def FT8 = RiscV64Fpr.new("ft8", 28), FT9 = RiscV64Fpr.new("ft9", 29);
	def FT10 = RiscV64Fpr.new("ft10", 30), FT11 = RiscV64Fpr.new("ft11", 31);

	// All GPRs in register-number order; GPRS[0] is the hardwired zero register.
	def GPRS = [
		ZERO, RA, SP, GP, TP, T0, T1, T2, S0, S1, A0, A1, A2, A3, A4, A5,
		A6, A7, S2, S3, S4, S5, S6, S7, S8, S9, S10, S11, T3, T4, T5, T6
	];
	// All FPRs in register-number order.
	def FPRS = [
		FT0, FT1, FT2, FT3, FT4, FT5, FT6, FT7, FS0, FS1, FA0, FA1, FA2, FA3, FA4, FA5,
		FA6, FA7, FS2, FS3, FS4, FS5, FS6, FS7, FS8, FS9, FS10, FS11, FT8, FT9, FT10, FT11
	];
}

// Floating point rounding modes (the {rm} field of FP instructions).
enum RiscV64Rm(code: u3, str: string) {
	RNE(0, "rne"),	// round to nearest, ties to even
	RTZ(1, "rtz"),	// round towards zero
	RDN(2, "rdn"),	// round down (towards -inf)
	RUP(3, "rup"),	// round up (towards +inf)
	RMM(4, "rmm"),	// round to nearest, ties to max magnitude
	DYN(7, "dyn")	// use the dynamic rounding mode in the fcsr
}

// Memory ordering bits for fence instructions.
enum RiscV64Fence(bits: u4, str: string) {
	I(8, "i"), O(4, "o"), R(2, "r"), W(1, "w"),
	RW(3, "rw"), IORW(15, "iorw")
}

// A condition for use in conditional branches. Conditions whose {swap} flag is set
// have no encoding of their own and are emitted as the inverse comparison with the
// two source registers exchanged (e.g. a > b is encoded as b < a).
class RiscV64Cond(name: string, f3: u3, swap: bool) {
	var negate: RiscV64Cond;
	var commute: RiscV64Cond;
}

component RiscV64Conds {
	def EQ  = RiscV64Cond.new("eq", 0, false);
	def NE  = RiscV64Cond.new("ne", 1, false);
	def LT  = RiscV64Cond.new("lt", 4, false);
	def GE  = RiscV64Cond.new("ge", 5, false);
	def LTU = RiscV64Cond.new("ltu", 6, false);
	def GEU = RiscV64Cond.new("geu", 7, false);
	def GT  = RiscV64Cond.new("gt", 4, true);
	def LE  = RiscV64Cond.new("le", 5, true);
	def GTU = RiscV64Cond.new("gtu", 6, true);
	def LEU = RiscV64Cond.new("leu", 7, true);

	new() {
		neg(EQ, NE); neg(LT, GE); neg(LTU, GEU); neg(GT, LE); neg(GTU, LEU);
		com(EQ, EQ); com(NE, NE); com(LT, GT); com(GE, LE); com(LTU, GTU); com(GEU, LEU);
	}
	def neg(a: RiscV64Cond, b: RiscV64Cond) { a.negate = b; b.negate = a; }
	def com(a: RiscV64Cond, b: RiscV64Cond) { a.commute = b; b.commute = a; }

	def all = [EQ, NE, LT, GE, LTU, GEU, GT, LE, GTU, LEU];
}

// CSR numbers used by user-level code.
component RiscV64Csrs {
	def FFLAGS: u12 = 0x001;
	def FRM: u12 = 0x002;
	def FCSR: u12 = 0x003;
	def CYCLE: u12 = 0xC00;
	def TIME: u12 = 0xC01;
	def INSTRET: u12 = 0xC02;
}

// Major opcodes (bits 6:0).
def OP_LOAD: u7 = 0x03;
def OP_LOAD_FP: u7 = 0x07;
def OP_MISC_MEM: u7 = 0x0F;
def OP_IMM: u7 = 0x13;
def OP_AUIPC: u7 = 0x17;
def OP_IMM_32: u7 = 0x1B;
def OP_STORE: u7 = 0x23;
def OP_STORE_FP: u7 = 0x27;
def OP_AMO: u7 = 0x2F;
def OP_OP: u7 = 0x33;
def OP_LUI: u7 = 0x37;
def OP_32: u7 = 0x3B;
def OP_MADD: u7 = 0x43;
def OP_MSUB: u7 = 0x47;
def OP_NMSUB: u7 = 0x4B;
def OP_NMADD: u7 = 0x4F;
def OP_FP: u7 = 0x53;
def OP_BRANCH: u7 = 0x63;
def OP_JALR: u7 = 0x67;
def OP_JAL: u7 = 0x6F;
def OP_SYSTEM: u7 = 0x73;

// Implements an assembler capable of emitting single RISC-V instructions at a time.
// Multi-instruction idioms ({li}, {call}, etc.) are provided as helpers that are
// clearly documented as such.
class RiscV64Assembler(w: DataWriter) {
	def pos() -> int { return w.pos; }

	//=={ Instruction formats }==========================================================
	// R-type:  funct7[31:25] rs2[24:20] rs1[19:15] funct3[14:12] rd[11:7] opcode[6:0]
	def emit_r(opcode: u7, rd: u5, f3: u3, rs1: u5, rs2: u5, f7: u7) {
		emit(int.pack<(u7, u5, u5, u3, u5, u7)>((f7, rs2, rs1, f3, rd, opcode)));
	}
	// R4-type: rs3[31:27] fmt[26:25] rs2[24:20] rs1[19:15] rm[14:12] rd[11:7] opcode[6:0]
	def emit_r4(opcode: u7, rd: u5, rm: u3, rs1: u5, rs2: u5, fmt: u2, rs3: u5) {
		emit(int.pack<(u5, u2, u5, u5, u3, u5, u7)>((rs3, fmt, rs2, rs1, rm, rd, opcode)));
	}
	// I-type:  imm[31:20] rs1[19:15] funct3[14:12] rd[11:7] opcode[6:0]
	def emit_i(opcode: u7, rd: u5, f3: u3, rs1: u5, imm: i12) {
		emit(int.pack<(i12, u5, u3, u5, u7)>((imm, rs1, f3, rd, opcode)));
	}
	// S-type:  imm[11:5]@[31:25] rs2[24:20] rs1[19:15] funct3[14:12] imm[4:0]@[11:7] opcode[6:0]
	def emit_s(opcode: u7, f3: u3, rs1: u5, rs2: u5, imm: i12) {
		emit(encodeS(opcode, f3, rs1, rs2, imm));
	}
	// B-type:  imm[12]@31 imm[10:5]@[30:25] rs2[24:20] rs1[19:15] funct3[14:12] imm[4:1]@[11:8] imm[11]@7 opcode[6:0]
	def emit_b(opcode: u7, f3: u3, rs1: u5, rs2: u5, imm: i13) {
		emit(encodeB(opcode, f3, rs1, rs2, imm));
	}
	// U-type:  imm[31:12] rd[11:7] opcode[6:0]
	def emit_u(opcode: u7, rd: u5, imm: u20) {
		emit(int.pack<(u20, u5, u7)>((imm, rd, opcode)));
	}
	// J-type:  imm[20]@31 imm[10:1]@[30:21] imm[11]@20 imm[19:12]@[19:12] rd[11:7] opcode[6:0]
	def emit_j(opcode: u7, rd: u5, imm: i21) {
		emit(encodeJ(opcode, rd, imm));
	}
	def emit(bits: int) { w.put_b32(bits); }

	// The S, B, and J formats scatter the immediate: {unpack} splits it into the pieces
	// named in the comment and {pack} places each at its position.
	def encodeS(opcode: u7, f3: u3, rs1: u5, rs2: u5, imm: i12) -> int {
		def i = i12.unpack<(u7, u5)>(imm); // imm[11:5], imm[4:0]
		return int.pack<(u7, u5, u5, u3, u5, u7)>((i.0, rs2, rs1, f3, i.1, opcode));
	}
	def encodeB(opcode: u7, f3: u3, rs1: u5, rs2: u5, imm: i13) -> int {
		def i = i13.unpack<(u1, u1, u6, u4, u1)>(imm); // imm[12], imm[11], imm[10:5], imm[4:1], imm[0]
		return int.pack<(u1, u6, u5, u5, u3, u4, u1, u7)>((i.0, i.2, rs2, rs1, f3, i.3, i.1, opcode));
	}
	def encodeJ(opcode: u7, rd: u5, imm: i21) -> int {
		def i = i21.unpack<(u1, u8, u1, u10, u1)>(imm); // imm[20], imm[19:12], imm[11], imm[10:1], imm[0]
		return int.pack<(u1, u10, u1, u8, u5, u7)>((i.0, i.3, i.2, i.1, rd, opcode));
	}

	//=={ Patching of previously-emitted instructions }=================================
	// Read the instruction word at {pos}.
	def get_b32(pos: int) -> int {
		return int.pack<(byte, byte, byte, byte)>((w.data[pos + 3], w.data[pos + 2], w.data[pos + 1], w.data[pos]));
	}
	private def put_b32_at(pos: int, bits: int) {
		def oldPos = w.pos;
		w.at(pos);
		w.put_b32(bits);
		w.at(oldPos);
	}
	// Replace the 12-bit immediate of the I-type instruction at {pos}.
	def patch_i_imm(pos: int, imm: i12) -> this {
		put_b32_at(pos, (get_b32(pos) & 0x000FFFFF) | (int.view(imm) << 20));
	}
	// Replace the 12-bit immediate of the S-type instruction at {pos}.
	def patch_s_imm(pos: int, imm: i12) -> this {
		put_b32_at(pos, (get_b32(pos) & 0x01FFF07F) | encodeS(0, 0, 0, 0, imm));
	}
	// Replace the 20-bit immediate of the U-type (lui/auipc) instruction at {pos}.
	def patch_u_imm(pos: int, imm: u20) -> this {
		put_b32_at(pos, (get_b32(pos) & 0x00000FFF) | (int.view(imm) << 12));
	}
	// Replace the 13-bit byte offset of the B-type (branch) instruction at {pos}.
	def patch_b_imm(pos: int, imm: i13) -> this {
		put_b32_at(pos, (get_b32(pos) & 0x01FFF07F) | encodeB(0, 0, 0, 0, imm));
	}
	// Replace the 21-bit byte offset of the J-type (jal) instruction at {pos}.
	def patch_j_imm(pos: int, imm: i21) -> this {
		put_b32_at(pos, (get_b32(pos) & 0x00000FFF) | encodeJ(0, 0, imm));
	}
	// Patch an {auipc}/{lui} at {pos} and the I-type instruction following it so that
	// together they add the signed 32-bit {delta} to the base (pc or zero).
	def patch_hi20_lo12_i(pos: int, delta: int) -> this {
		patch_u_imm(pos, hi20(delta));
		patch_i_imm(pos + 4, lo12(delta));
	}
	// As {patch_hi20_lo12_i}, but the second instruction is an S-type store.
	def patch_hi20_lo12_s(pos: int, delta: int) -> this {
		patch_u_imm(pos, hi20(delta));
		patch_s_imm(pos + 4, lo12(delta));
	}
	// The upper 20 bits of {v}, adjusted so that {hi20(v) << 12 + lo12(v) == v}
	// despite {lo12} being sign-extended.
	def hi20(v: int) -> u20 { return u20.view((v + 0x800) >> 12); }
	def lo12(v: int) -> i12 { return i12.view(v); }
	// Returns true if {v} fits in a sign-extended 12-bit immediate.
	def fitsI12(v: long) -> bool { return v >= -2048 && v < 2048; }
	// Returns true if {v} fits in a sign-extended 32-bit immediate (lui + addiw).
	def fitsI32(v: long) -> bool { return v == long.view(int.view(v)); }

	//=={ RV64I: upper immediates, jumps, and branches }=================================
	def lui(rd: RiscV64Gpr, imm: u20) -> this { emit_u(OP_LUI, rd.regnum, imm); }
	def auipc(rd: RiscV64Gpr, imm: u20) -> this { emit_u(OP_AUIPC, rd.regnum, imm); }
	// {imm} is a byte offset from this instruction, +-1MB.
	def jal(rd: RiscV64Gpr, imm: i21) -> this { emit_j(OP_JAL, rd.regnum, imm); }
	def jalr(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_JALR, rd.regnum, 0, rs1.regnum, imm); }
	// {imm} is a byte offset from this instruction, +-4KB.
	def beq(rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this { emit_b(OP_BRANCH, 0, rs1.regnum, rs2.regnum, imm); }
	def bne(rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this { emit_b(OP_BRANCH, 1, rs1.regnum, rs2.regnum, imm); }
	def blt(rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this { emit_b(OP_BRANCH, 4, rs1.regnum, rs2.regnum, imm); }
	def bge(rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this { emit_b(OP_BRANCH, 5, rs1.regnum, rs2.regnum, imm); }
	def bltu(rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this { emit_b(OP_BRANCH, 6, rs1.regnum, rs2.regnum, imm); }
	def bgeu(rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this { emit_b(OP_BRANCH, 7, rs1.regnum, rs2.regnum, imm); }
	// Branch on {cond}, swapping the operands for conditions that have no direct encoding.
	def bcond(cond: RiscV64Cond, rs1: RiscV64Gpr, rs2: RiscV64Gpr, imm: i13) -> this {
		if (cond.swap) emit_b(OP_BRANCH, cond.f3, rs2.regnum, rs1.regnum, imm);
		else emit_b(OP_BRANCH, cond.f3, rs1.regnum, rs2.regnum, imm);
	}

	//=={ RV64I: loads and stores }=====================================================
	def lb(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 0, rs1.regnum, imm); }
	def lh(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 1, rs1.regnum, imm); }
	def lw(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 2, rs1.regnum, imm); }
	def ld(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 3, rs1.regnum, imm); }
	def lbu(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 4, rs1.regnum, imm); }
	def lhu(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 5, rs1.regnum, imm); }
	def lwu(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD, rd.regnum, 6, rs1.regnum, imm); }
	def sb(rs2: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_s(OP_STORE, 0, rs1.regnum, rs2.regnum, imm); }
	def sh(rs2: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_s(OP_STORE, 1, rs1.regnum, rs2.regnum, imm); }
	def sw(rs2: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_s(OP_STORE, 2, rs1.regnum, rs2.regnum, imm); }
	def sd(rs2: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_s(OP_STORE, 3, rs1.regnum, rs2.regnum, imm); }

	//=={ RV64I: integer register-immediate }============================================
	def addi(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM, rd.regnum, 0, rs1.regnum, imm); }
	def slti(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM, rd.regnum, 2, rs1.regnum, imm); }
	def sltiu(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM, rd.regnum, 3, rs1.regnum, imm); }
	def xori(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM, rd.regnum, 4, rs1.regnum, imm); }
	def ori(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM, rd.regnum, 6, rs1.regnum, imm); }
	def andi(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM, rd.regnum, 7, rs1.regnum, imm); }
	// 64-bit shifts by immediate take a 6-bit shift amount.
	def slli(rd: RiscV64Gpr, rs1: RiscV64Gpr, shamt: u6) -> this { emit_i(OP_IMM, rd.regnum, 1, rs1.regnum, i12.view(shamt)); }
	def srli(rd: RiscV64Gpr, rs1: RiscV64Gpr, shamt: u6) -> this { emit_i(OP_IMM, rd.regnum, 5, rs1.regnum, i12.view(shamt)); }
	def srai(rd: RiscV64Gpr, rs1: RiscV64Gpr, shamt: u6) -> this { emit_i(OP_IMM, rd.regnum, 5, rs1.regnum, i12.pack<(u6, u6)>((0b010000, shamt))); }
	// 32-bit (word) operations sign-extend their 32-bit result to 64 bits.
	def addiw(rd: RiscV64Gpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_IMM_32, rd.regnum, 0, rs1.regnum, imm); }
	def slliw(rd: RiscV64Gpr, rs1: RiscV64Gpr, shamt: u5) -> this { emit_i(OP_IMM_32, rd.regnum, 1, rs1.regnum, i12.view(shamt)); }
	def srliw(rd: RiscV64Gpr, rs1: RiscV64Gpr, shamt: u5) -> this { emit_i(OP_IMM_32, rd.regnum, 5, rs1.regnum, i12.view(shamt)); }
	def sraiw(rd: RiscV64Gpr, rs1: RiscV64Gpr, shamt: u5) -> this { emit_i(OP_IMM_32, rd.regnum, 5, rs1.regnum, i12.pack<(u6, u6)>((0b010000, shamt))); }

	//=={ RV64I: integer register-register }=============================================
	def add(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 0, rs1.regnum, rs2.regnum, 0); }
	def sub(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 0, rs1.regnum, rs2.regnum, 0x20); }
	def sll(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 1, rs1.regnum, rs2.regnum, 0); }
	def slt(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 2, rs1.regnum, rs2.regnum, 0); }
	def sltu(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 3, rs1.regnum, rs2.regnum, 0); }
	def xor(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 4, rs1.regnum, rs2.regnum, 0); }
	def srl(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 5, rs1.regnum, rs2.regnum, 0); }
	def sra(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 5, rs1.regnum, rs2.regnum, 0x20); }
	def or(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 6, rs1.regnum, rs2.regnum, 0); }
	def and(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 7, rs1.regnum, rs2.regnum, 0); }
	def addw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 0, rs1.regnum, rs2.regnum, 0); }
	def subw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 0, rs1.regnum, rs2.regnum, 0x20); }
	def sllw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 1, rs1.regnum, rs2.regnum, 0); }
	def srlw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 5, rs1.regnum, rs2.regnum, 0); }
	def sraw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 5, rs1.regnum, rs2.regnum, 0x20); }

	//=={ RV64I: memory ordering and system }============================================
	def fence(pred: RiscV64Fence, succ: RiscV64Fence) -> this {
		emit_i(OP_MISC_MEM, 0, 0, 0, i12.pack<(u4, u4)>((pred.bits, succ.bits)));
	}
	def fence_tso() -> this { emit(0x8330000F); }
	def fence_i() -> this { emit_i(OP_MISC_MEM, 0, 1, 0, 0); }
	// Permanently undefined instruction (csrrw x0, cycle, x0); raises SIGILL.
	def unimp() -> this { emit(0xC0001073); }
	def ecall() -> this { emit_i(OP_SYSTEM, 0, 0, 0, 0); }
	def ebreak() -> this { emit_i(OP_SYSTEM, 0, 0, 0, 1); }
	// Zicsr: CSR access. {csr} is the 12-bit CSR number; the "i" forms take a 5-bit immediate.
	def csrrw(rd: RiscV64Gpr, csr: u12, rs1: RiscV64Gpr) -> this { emit_i(OP_SYSTEM, rd.regnum, 1, rs1.regnum, i12.view(csr)); }
	def csrrs(rd: RiscV64Gpr, csr: u12, rs1: RiscV64Gpr) -> this { emit_i(OP_SYSTEM, rd.regnum, 2, rs1.regnum, i12.view(csr)); }
	def csrrc(rd: RiscV64Gpr, csr: u12, rs1: RiscV64Gpr) -> this { emit_i(OP_SYSTEM, rd.regnum, 3, rs1.regnum, i12.view(csr)); }
	def csrrwi(rd: RiscV64Gpr, csr: u12, uimm: u5) -> this { emit_i(OP_SYSTEM, rd.regnum, 5, uimm, i12.view(csr)); }
	def csrrsi(rd: RiscV64Gpr, csr: u12, uimm: u5) -> this { emit_i(OP_SYSTEM, rd.regnum, 6, uimm, i12.view(csr)); }
	def csrrci(rd: RiscV64Gpr, csr: u12, uimm: u5) -> this { emit_i(OP_SYSTEM, rd.regnum, 7, uimm, i12.view(csr)); }

	//=={ RV64M: multiply and divide }===================================================
	def mul(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 0, rs1.regnum, rs2.regnum, 1); }
	def mulh(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 1, rs1.regnum, rs2.regnum, 1); }
	def mulhsu(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 2, rs1.regnum, rs2.regnum, 1); }
	def mulhu(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 3, rs1.regnum, rs2.regnum, 1); }
	def div(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 4, rs1.regnum, rs2.regnum, 1); }
	def divu(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 5, rs1.regnum, rs2.regnum, 1); }
	def rem(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 6, rs1.regnum, rs2.regnum, 1); }
	def remu(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_OP, rd.regnum, 7, rs1.regnum, rs2.regnum, 1); }
	def mulw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 0, rs1.regnum, rs2.regnum, 1); }
	def divw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 4, rs1.regnum, rs2.regnum, 1); }
	def divuw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 5, rs1.regnum, rs2.regnum, 1); }
	def remw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 6, rs1.regnum, rs2.regnum, 1); }
	def remuw(rd: RiscV64Gpr, rs1: RiscV64Gpr, rs2: RiscV64Gpr) -> this { emit_r(OP_32, rd.regnum, 7, rs1.regnum, rs2.regnum, 1); }

	//=={ RV64A: atomics }===============================================================
	// {aq} and {rl} are the acquire and release ordering bits. The .w forms sign-extend
	// their 32-bit result; the .d forms operate on 64 bits.
	private def emit_amo(funct5: u5, aq: bool, rl: bool, f3: u3, rd: u5, rs1: u5, rs2: u5) {
		emit_r(OP_AMO, rd, f3, rs1, rs2, u7.pack<(u5, bool, bool)>((funct5, aq, rl)));
	}
	def lr_w(rd: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x02, aq, rl, 2, rd.regnum, rs1.regnum, 0); }
	def lr_d(rd: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x02, aq, rl, 3, rd.regnum, rs1.regnum, 0); }
	def sc_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x03, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def sc_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x03, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoswap_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x01, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoswap_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x01, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoadd_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x00, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoadd_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x00, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoxor_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x04, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoxor_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x04, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoand_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x0C, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoand_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x0C, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoor_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x08, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amoor_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x08, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amomin_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x10, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amomin_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x10, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amomax_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x14, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amomax_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x14, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amominu_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x18, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amominu_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x18, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }
	def amomaxu_w(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x1C, aq, rl, 2, rd.regnum, rs1.regnum, rs2.regnum); }
	def amomaxu_d(rd: RiscV64Gpr, rs2: RiscV64Gpr, rs1: RiscV64Gpr, aq: bool, rl: bool) -> this { emit_amo(0x1C, aq, rl, 3, rd.regnum, rs1.regnum, rs2.regnum); }

	//=={ RV64F / RV64D: floating point loads, stores, and arithmetic }==================
	// The "_s" suffix denotes single precision, "_d" double precision. Instructions that
	// can round take an explicit rounding mode {rm}; pass {RiscV64Rm.DYN} for the usual
	// dynamic mode.
	def flw(rd: RiscV64Fpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD_FP, rd.regnum, 2, rs1.regnum, imm); }
	def fld(rd: RiscV64Fpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_i(OP_LOAD_FP, rd.regnum, 3, rs1.regnum, imm); }
	def fsw(rs2: RiscV64Fpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_s(OP_STORE_FP, 2, rs1.regnum, rs2.regnum, imm); }
	def fsd(rs2: RiscV64Fpr, rs1: RiscV64Gpr, imm: i12) -> this { emit_s(OP_STORE_FP, 3, rs1.regnum, rs2.regnum, imm); }

	// Fused multiply-add: rd = +-(rs1 * rs2) +- rs3.
	def fmadd_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_MADD, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0, rs3.regnum); }
	def fmadd_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_MADD, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 1, rs3.regnum); }
	def fmsub_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_MSUB, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0, rs3.regnum); }
	def fmsub_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_MSUB, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 1, rs3.regnum); }
	def fnmsub_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_NMSUB, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0, rs3.regnum); }
	def fnmsub_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_NMSUB, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 1, rs3.regnum); }
	def fnmadd_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_NMADD, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0, rs3.regnum); }
	def fnmadd_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rs3: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_r4(OP_NMADD, rd.regnum, rm.code, rs1.regnum, rs2.regnum, 1, rs3.regnum); }

	private def emit_fp(rd: u5, f3: u3, rs1: u5, rs2: u5, f7: u7) { emit_r(OP_FP, rd, f3, rs1, rs2, f7); }
	def fadd_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x00); }
	def fadd_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x01); }
	def fsub_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x04); }
	def fsub_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x05); }
	def fmul_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x08); }
	def fmul_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x09); }
	def fdiv_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x0C); }
	def fdiv_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, rs2.regnum, 0x0D); }
	def fsqrt_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 0, 0x2C); }
	def fsqrt_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 0, 0x2D); }
	// Sign injection: rd = |rs1| with the sign of rs2 (fsgnj), its inverse (fsgnjn), or
	// the xor of both signs (fsgnjx). These implement fmv, fneg, and fabs.
	def fsgnj_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, rs2.regnum, 0x10); }
	def fsgnj_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, rs2.regnum, 0x11); }
	def fsgnjn_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, rs2.regnum, 0x10); }
	def fsgnjn_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, rs2.regnum, 0x11); }
	def fsgnjx_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 2, rs1.regnum, rs2.regnum, 0x10); }
	def fsgnjx_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 2, rs1.regnum, rs2.regnum, 0x11); }
	def fmin_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, rs2.regnum, 0x14); }
	def fmin_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, rs2.regnum, 0x15); }
	def fmax_s(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, rs2.regnum, 0x14); }
	def fmax_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, rs2.regnum, 0x15); }
	// Precision conversions. Widening (fcvt.d.s) is exact and has no rounding mode.
	def fcvt_s_d(rd: RiscV64Fpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 1, 0x20); }
	def fcvt_d_s(rd: RiscV64Fpr, rs1: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 0, 0x21); }
	// Comparisons write 0 or 1 to a GPR. All are quiet on NaN except that flt/fle signal.
	def feq_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 2, rs1.regnum, rs2.regnum, 0x50); }
	def feq_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 2, rs1.regnum, rs2.regnum, 0x51); }
	def flt_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, rs2.regnum, 0x50); }
	def flt_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, rs2.regnum, 0x51); }
	def fle_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, rs2.regnum, 0x50); }
	def fle_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rs2: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, rs2.regnum, 0x51); }
	def fclass_s(rd: RiscV64Gpr, rs1: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, 0, 0x70); }
	def fclass_d(rd: RiscV64Gpr, rs1: RiscV64Fpr) -> this { emit_fp(rd.regnum, 1, rs1.regnum, 0, 0x71); }
	// Float to integer conversions, rounding according to {rm}. Results saturate and NaN
	// converts to the maximum positive value. w = 32-bit (sign-extended), l = 64-bit, u = unsigned.
	def fcvt_w_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 0, 0x60); }
	def fcvt_wu_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 1, 0x60); }
	def fcvt_l_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 2, 0x60); }
	def fcvt_lu_s(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 3, 0x60); }
	def fcvt_w_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 0, 0x61); }
	def fcvt_wu_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 1, 0x61); }
	def fcvt_l_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 2, 0x61); }
	def fcvt_lu_d(rd: RiscV64Gpr, rs1: RiscV64Fpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 3, 0x61); }
	// Integer to float conversions. 32-bit integers convert to double exactly, so
	// fcvt.d.w and fcvt.d.wu have no rounding mode.
	def fcvt_s_w(rd: RiscV64Fpr, rs1: RiscV64Gpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 0, 0x68); }
	def fcvt_s_wu(rd: RiscV64Fpr, rs1: RiscV64Gpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 1, 0x68); }
	def fcvt_s_l(rd: RiscV64Fpr, rs1: RiscV64Gpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 2, 0x68); }
	def fcvt_s_lu(rd: RiscV64Fpr, rs1: RiscV64Gpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 3, 0x68); }
	def fcvt_d_w(rd: RiscV64Fpr, rs1: RiscV64Gpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 0, 0x69); }
	def fcvt_d_wu(rd: RiscV64Fpr, rs1: RiscV64Gpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 1, 0x69); }
	def fcvt_d_l(rd: RiscV64Fpr, rs1: RiscV64Gpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 2, 0x69); }
	def fcvt_d_lu(rd: RiscV64Fpr, rs1: RiscV64Gpr, rm: RiscV64Rm) -> this { emit_fp(rd.regnum, rm.code, rs1.regnum, 3, 0x69); }
	// Bit-for-bit moves between integer and floating point registers.
	def fmv_x_w(rd: RiscV64Gpr, rs1: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 0, 0x70); }
	def fmv_x_d(rd: RiscV64Gpr, rs1: RiscV64Fpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 0, 0x71); }
	def fmv_w_x(rd: RiscV64Fpr, rs1: RiscV64Gpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 0, 0x78); }
	def fmv_d_x(rd: RiscV64Fpr, rs1: RiscV64Gpr) -> this { emit_fp(rd.regnum, 0, rs1.regnum, 0, 0x79); }

	//=={ Single-instruction pseudo-instructions }=======================================
	def nop() -> this { addi(RiscV64Regs.ZERO, RiscV64Regs.ZERO, 0); }
	def mv(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { addi(rd, rs, 0); }
	def not(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { xori(rd, rs, -1); }
	def neg(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { sub(rd, RiscV64Regs.ZERO, rs); }
	def negw(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { subw(rd, RiscV64Regs.ZERO, rs); }
	def sext_w(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { addiw(rd, rs, 0); }
	def seqz(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { sltiu(rd, rs, 1); }
	def snez(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { sltu(rd, RiscV64Regs.ZERO, rs); }
	def sltz(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { slt(rd, rs, RiscV64Regs.ZERO); }
	def sgtz(rd: RiscV64Gpr, rs: RiscV64Gpr) -> this { slt(rd, RiscV64Regs.ZERO, rs); }
	def beqz(rs: RiscV64Gpr, imm: i13) -> this { beq(rs, RiscV64Regs.ZERO, imm); }
	def bnez(rs: RiscV64Gpr, imm: i13) -> this { bne(rs, RiscV64Regs.ZERO, imm); }
	def blez(rs: RiscV64Gpr, imm: i13) -> this { bge(RiscV64Regs.ZERO, rs, imm); }
	def bgez(rs: RiscV64Gpr, imm: i13) -> this { bge(rs, RiscV64Regs.ZERO, imm); }
	def bltz(rs: RiscV64Gpr, imm: i13) -> this { blt(rs, RiscV64Regs.ZERO, imm); }
	def bgtz(rs: RiscV64Gpr, imm: i13) -> this { blt(RiscV64Regs.ZERO, rs, imm); }
	def j(imm: i21) -> this { jal(RiscV64Regs.ZERO, imm); }
	def jr(rs: RiscV64Gpr) -> this { jalr(RiscV64Regs.ZERO, rs, 0); }
	def ret() -> this { jalr(RiscV64Regs.ZERO, RiscV64Regs.RA, 0); }
	def fmv_s(rd: RiscV64Fpr, rs: RiscV64Fpr) -> this { fsgnj_s(rd, rs, rs); }
	def fmv_d(rd: RiscV64Fpr, rs: RiscV64Fpr) -> this { fsgnj_d(rd, rs, rs); }
	def fneg_s(rd: RiscV64Fpr, rs: RiscV64Fpr) -> this { fsgnjn_s(rd, rs, rs); }
	def fneg_d(rd: RiscV64Fpr, rs: RiscV64Fpr) -> this { fsgnjn_d(rd, rs, rs); }
	def fabs_s(rd: RiscV64Fpr, rs: RiscV64Fpr) -> this { fsgnjx_s(rd, rs, rs); }
	def fabs_d(rd: RiscV64Fpr, rs: RiscV64Fpr) -> this { fsgnjx_d(rd, rs, rs); }
	def frflags(rd: RiscV64Gpr) -> this { csrrs(rd, RiscV64Csrs.FFLAGS, RiscV64Regs.ZERO); }
	def fsflags(rs: RiscV64Gpr) -> this { csrrw(RiscV64Regs.ZERO, RiscV64Csrs.FFLAGS, rs); }
	def frrm(rd: RiscV64Gpr) -> this { csrrs(rd, RiscV64Csrs.FRM, RiscV64Regs.ZERO); }
	def fsrm(rs: RiscV64Gpr) -> this { csrrw(RiscV64Regs.ZERO, RiscV64Csrs.FRM, rs); }

	//=={ Multi-instruction idioms }=====================================================
	// Load the 32-bit sign-extended constant {val} into {rd} with lui + addiw (1-2 instructions).
	def li32(rd: RiscV64Gpr, val: int) -> this {
		if (fitsI12(val)) { addi(rd, RiscV64Regs.ZERO, i12.view(val)); return; }
		lui(rd, hi20(val));
		if ((val & 0xFFF) != 0) addiw(rd, rd, lo12(val));
	}
	// Load the arbitrary 64-bit constant {val} into {rd}. Values that sign-extend from
	// 32 bits take at most 2 instructions. Other values are built recursively from the
	// top: {val} = ({val} - lo12) >> 12 is loaded first, then shifted left by 12 and the
	// signed low 12 bits added back. This takes at most 8 instructions.
	def li(rd: RiscV64Gpr, val: long) -> this {
		if (fitsI32(val)) { li32(rd, int.view(val)); return; }
		def lo = i12.view(val);
		def hi = (val - lo) >> 12;
		li(rd, hi);
		slli(rd, rd, 12);
		if (lo != 0) addi(rd, rd, lo);
	}
	// Loads the signed 32-bit pc-relative {delta} (from this instruction) plus pc into {rd}.
	def la_pcrel(rd: RiscV64Gpr, delta: int) -> this {
		auipc(rd, hi20(delta));
		addi(rd, rd, lo12(delta));
	}
	// Call the routine at pc-relative {delta}, +-2GB, saving the return address in ra.
	def call_pcrel(delta: int) -> this {
		auipc(RiscV64Regs.RA, hi20(delta));
		jalr(RiscV64Regs.RA, RiscV64Regs.RA, lo12(delta));
	}
	// Jump to pc-relative {delta}, +-2GB, clobbering {tmp}.
	def tail_pcrel(tmp: RiscV64Gpr, delta: int) -> this {
		auipc(tmp, hi20(delta));
		jalr(RiscV64Regs.ZERO, tmp, lo12(delta));
	}
}
