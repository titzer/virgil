// The set of general purpose registers on MIPS.
type MipsReg {
	case R0;  case R1;  case R2;  case R3;
	case R4;  case R5;  case R6;  case R7;
	case R8;  case R9;  case R10; case R11;
	case R12; case R13; case R14; case R15;
	case R16; case R17; case R18; case R19;
	case R20; case R21; case R22; case R23;
	case R24; case R25; case R26; case R27;
	case R28; case R29; case R30; case R31;
}
def R0 = MipsReg.R0;
// Opcodes for I-type and J-type instructions, and the REGIMM branch condition codes.
def OP_REGIMM: u6 = 0x01;
def OP_J: u6 = 0x02;
def OP_JAL: u6 = 0x03;
def OP_BEQ: u6 = 0x04;
def OP_BNE: u6 = 0x05;
def OP_BLEZ: u6 = 0x06;
def OP_BGTZ: u6 = 0x07;
def OP_ADDI: u6 = 0x08;
def OP_ADDIU: u6 = 0x09;
def OP_SLTI: u6 = 0x0a;
def OP_SLTIU: u6 = 0x0b;
def OP_ANDI: u6 = 0x0c;
def OP_ORI: u6 = 0x0d;
def OP_XORI: u6 = 0x0e;
def OP_LUI: u6 = 0x0f;
def OP_BEQL: u6 = 0x14;
def OP_BNEL: u6 = 0x15;
def OP_BLEZL: u6 = 0x16;
def OP_BGTZL: u6 = 0x17;
def OP_LB: u6 = 0x20;
def OP_LH: u6 = 0x21;
def OP_LW: u6 = 0x23;
def OP_LBU: u6 = 0x24;
def OP_LHU: u6 = 0x25;
def OP_SB: u6 = 0x28;
def OP_SH: u6 = 0x29;
def OP_SW: u6 = 0x2b;
def RT_BLTZ: u5 = 0x00;
def RT_BGEZ: u5 = 0x01;
def RT_BLTZL: u5 = 0x02;
def RT_BGEZL: u5 = 0x03;
def RT_BLTZAL: u5 = 0x10;
def RT_BGEZAL: u5 = 0x11;
def RT_BLTZALL: u5 = 0x12;
def RT_BGEZALL: u5 = 0x13;

class MipsAssembler(w: DataWriter) {
	def pos() -> int { return w.pos; }

	// Arithmetic instructions
	def add(rd: MipsReg, rs: MipsReg, rt: MipsReg)  { emit_r(rs, rt, rd, 0, 0x20); }
	def addi(rd: MipsReg, rs: MipsReg, imm: i16)    { emit_i(OP_ADDI, rs, rd, u16.view(imm)); }
	def addiu(rd: MipsReg, rs: MipsReg, imm: u16)   { emit_i(OP_ADDIU, rs, rd, imm); }
	def addu(rd: MipsReg, rs: MipsReg, rt: MipsReg) { emit_r(rs, rt, rd, 0, 0x21); }
	def and(rd: MipsReg, rs: MipsReg, rt: MipsReg)  { emit_r(rs, rt, rd, 0, 0x24); }
	def andi(rd: MipsReg, rs: MipsReg, imm: u16)    { emit_i(OP_ANDI, rs, rd, imm); }
	def div(rs: MipsReg, rt: MipsReg)               { emit_r(rs, rt, R0, 0, 0x1a); }
	def divu(rs: MipsReg, rt: MipsReg)              { emit_r(rs, rt, R0, 0, 0x1b); }
	def mult(rs: MipsReg, rt: MipsReg)              { emit_r(rs, rt, R0, 0, 0x18); }
	def multu(rs: MipsReg, rt: MipsReg)             { emit_r(rs, rt, R0, 0, 0x19); }
	def or(rd: MipsReg, rs: MipsReg, rt: MipsReg)   { emit_r(rs, rt, rd, 0, 0x25); }
	def ori(rd: MipsReg, rs: MipsReg, imm: u16)     { emit_i(OP_ORI, rs, rd, imm); }
	def sll(rd: MipsReg, rt: MipsReg, imm: u5)      { emit_r(R0, rt, rd, imm, 0x00); }
	def sllv(rd: MipsReg, rs: MipsReg, rt: MipsReg) { emit_r(rs, rt, rd, 0, 0x04); }
	def sra(rd: MipsReg, rt: MipsReg, imm: u5)      { emit_r(R0, rt, rd, imm, 0x03); }
	def srav(rd: MipsReg, rs: MipsReg, rt: MipsReg) { emit_r(rs, rt, rd, 0, 0x07); }
	def srl(rd: MipsReg, rt: MipsReg, imm: u5)      { emit_r(R0, rt, rd, imm, 0x02); }
	def srlv(rd: MipsReg, rs: MipsReg, rt: MipsReg) { emit_r(rs, rt, rd, 0, 0x06); }
	def xor(rd: MipsReg, rs: MipsReg, rt: MipsReg)  { emit_r(rs, rt, rd, 0, 0x26); }
	def xori(rd: MipsReg, rs: MipsReg, imm: u16)    { emit_i(OP_XORI, rs, rd, imm); }
	def sub(rd: MipsReg, rs: MipsReg, rt: MipsReg)  { emit_r(rs, rt, rd, 0, 0x22); }
	def subu(rd: MipsReg, rs: MipsReg, rt: MipsReg) { emit_r(rs, rt, rd, 0, 0x23); }

	// Set instructions
	def slt(rd: MipsReg, rs: MipsReg, rt: MipsReg)  { emit_r(rs, rt, rd, 0, 0x2a); }
	def slti(rd: MipsReg, rs: MipsReg, imm: i16)    { emit_i(OP_SLTI, rs, rd, u16.view(imm)); }
	def sltiu(rd: MipsReg, rs: MipsReg, imm: u16)   { emit_i(OP_SLTIU, rs, rd, imm); }
	def sltu(rd: MipsReg, rs: MipsReg, rt: MipsReg) { emit_r(rs, rt, rd, 0, 0x2b); }

	// Branch instructions
	def beq(rs: MipsReg, rt: MipsReg, off: i16)  { emit_i(OP_BEQ, rs, rt, u16.view(off)); }
	def beql(rs: MipsReg, rt: MipsReg, off: i16) { emit_i(OP_BEQL, rs, rt, u16.view(off)); }
	def bgez(rs: MipsReg, off: i16)    { emit_regimm(RT_BGEZ, rs, off); }
	def bgezal(rs: MipsReg, off: i16)  { emit_regimm(RT_BGEZAL, rs, off); }
	def bgezall(rs: MipsReg, off: i16) { emit_regimm(RT_BGEZALL, rs, off); }
	def bgezl(rs: MipsReg, off: i16)   { emit_regimm(RT_BGEZL, rs, off); }
	def bgtz(rs: MipsReg, off: i16)    { emit_i(OP_BGTZ, rs, R0, u16.view(off)); }
	def bgtzl(rs: MipsReg, off: i16)   { emit_i(OP_BGTZL, rs, R0, u16.view(off)); }
	def blez(rs: MipsReg, off: i16)    { emit_i(OP_BLEZ, rs, R0, u16.view(off)); }
	def blezl(rs: MipsReg, off: i16)   { emit_i(OP_BLEZL, rs, R0, u16.view(off)); }
	def bltz(rs: MipsReg, off: i16)    { emit_regimm(RT_BLTZ, rs, off); }
	def bltzal(rs: MipsReg, off: i16)  { emit_regimm(RT_BLTZAL, rs, off); }
	def bltzall(rs: MipsReg, off: i16) { emit_regimm(RT_BLTZALL, rs, off); }
	def bltzl(rs: MipsReg, off: i16)   { emit_regimm(RT_BLTZL, rs, off); }
	def bne(rs: MipsReg, rt: MipsReg, off: i16)  { emit_i(OP_BNE, rs, rt, u16.view(off)); }
	def bnel(rs: MipsReg, rt: MipsReg, off: i16) { emit_i(OP_BNEL, rs, rt, u16.view(off)); }

	def brk(code: u20) { w.put_b32be(int.pack<(u6, u20, u6)>((0, code, 0x0d))); }

	def j(target: u26) { emit_j(OP_J, target); }
	def jal(target: u26) { emit_j(OP_JAL, target); }
	def jalr(rd: MipsReg, rs: MipsReg) { emit_r(rs, R0, rd, 0, 0x09); }
	def jr(target: MipsReg) { emit_r(target, R0, R0, 0, 0x08); }

	// Trap instructions
	def teq(rs: MipsReg, rt: MipsReg, code: u10)  { emit_trap(rs, rt, code, 0x34); }
	def tne(rs: MipsReg, rt: MipsReg, code: u10)  { emit_trap(rs, rt, code, 0x36); }
	def tlt(rs: MipsReg, rt: MipsReg, code: u10)  { emit_trap(rs, rt, code, 0x32); }
	def tltu(rs: MipsReg, rt: MipsReg, code: u10) { emit_trap(rs, rt, code, 0x33); }
	def tge(rs: MipsReg, rt: MipsReg, code: u10)  { emit_trap(rs, rt, code, 0x30); }
	def tgeu(rs: MipsReg, rt: MipsReg, code: u10) { emit_trap(rs, rt, code, 0x31); }

	// Loads and stores: {rt} is the value register and {base} the address register
	def lb(rt: MipsReg, base: MipsReg, offset: u16)  { emit_i(OP_LB, base, rt, offset); }
	def lbu(rt: MipsReg, base: MipsReg, offset: u16) { emit_i(OP_LBU, base, rt, offset); }
	def lh(rt: MipsReg, base: MipsReg, offset: u16)  { emit_i(OP_LH, base, rt, offset); }
	def lhu(rt: MipsReg, base: MipsReg, offset: u16) { emit_i(OP_LHU, base, rt, offset); }
	def lui(rt: MipsReg, imm: u16)                   { emit_i(OP_LUI, R0, rt, imm); }
	def lw(rt: MipsReg, base: MipsReg, offset: u16)  { emit_i(OP_LW, base, rt, offset); }
	def sb(rt: MipsReg, base: MipsReg, offset: u16)  { emit_i(OP_SB, base, rt, offset); }
	def sh(rt: MipsReg, base: MipsReg, offset: u16)  { emit_i(OP_SH, base, rt, offset); }
	def sw(rt: MipsReg, base: MipsReg, offset: u16)  { emit_i(OP_SW, base, rt, offset); }

	// Access $LO and $HI registers
	def mfhi(rd: MipsReg) { emit_r(R0, R0, rd, 0, 0x10); }
	def mflo(rd: MipsReg) { emit_r(R0, R0, rd, 0, 0x12); }

	def move(rd: MipsReg, rs: MipsReg) { or(rd, rs, R0); }

	def syscall(code: u20) { w.put_b32be(int.pack<(u6, u20, u6)>((0, code, 0x0c))); }

	// R-type: op[31:26]=0 rs[25:21] rt[20:16] rd[15:11] sa[10:6] funct[5:0]
	private def emit_r(rs: MipsReg, rt: MipsReg, rd: MipsReg, sa: u5, funct: u6) {
		w.put_b32be(int.pack<(u6, u5, u5, u5, u5, u6)>((0, rs.tag, rt.tag, rd.tag, sa, funct)));
	}
	// I-type: op[31:26] rs[25:21] rt[20:16] imm[15:0]
	private def emit_i(op: u6, rs: MipsReg, rt: MipsReg, imm: u16) {
		w.put_b32be(int.pack<(u6, u5, u5, u16)>((op, rs.tag, rt.tag, imm)));
	}
	// J-type: op[31:26] target[25:0]
	private def emit_j(op: u6, target: u26) {
		w.put_b32be(int.pack<(u6, u26)>((op, target)));
	}
	// REGIMM branches: op[31:26]=1 rs[25:21] cond[20:16] off[15:0]
	private def emit_regimm(cond: u5, rs: MipsReg, off: i16) {
		w.put_b32be(int.pack<(u6, u5, u5, u16)>((OP_REGIMM, rs.tag, cond, u16.view(off))));
	}
	// Traps: op[31:26]=0 rs[25:21] rt[20:16] code[15:6] funct[5:0]
	private def emit_trap(rs: MipsReg, rt: MipsReg, code: u10, funct: u6) {
		w.put_b32be(int.pack<(u6, u5, u5, u10, u6)>((0, rs.tag, rt.tag, code, funct)));
	}
}
