// x87 register-operand arithmetic, in ModRM.reg order.
def X87_ARITH = ["fadd", "fmul", "fcom", "fcomp", "fsub", "fsubr", "fdiv", "fdivr"];
// The 0xDC forms reverse the sense of the non-commutative operations.
def X87_ARITH_R = ["fadd", "fmul", "fcom", "fcomp", "fsubr", "fsub", "fdivr", "fdiv"];
def X87_ARITHP = ["faddp", "fmulp", "fcomp", null, "fsubrp", "fsubp", "fdivrp", "fdivp"];
// 0xD9 with ModRM.reg 4-7 and mod == 3: a fixed operation per ModRM.rm.
def X87_D9 = [
	"fchs", "fabs", null, null, "ftst", "fxam", null, null,
	"fld1", "fldl2t", "fldl2e", "fldpi", "fldlg2", "fldln2", "fldz", null,
	"f2xm1", "fyl2x", "fptan", "fpatan", "fxtract", "fprem1", "fdecstp", "fincstp",
	"fprem", "fyl2xp1", "fsqrt", "fsincos", "frndint", "fscale", "fsin", "fcos"
];
// 0xDA with mod == 3: the conditional moves.
def X87_DA = ["fcmovb", "fcmove", "fcmovbe", "fcmovu", null, null, null, null];

// Renders disassembled instructions as text, in an Intel/NASM-like syntax:
// {[lock] [rep] mnemonic dest, src}, with memory operands written as
// {size [base+index*scale+disp]}. Segment overrides are rendered as a leading
// prefix word, since the addressing mode itself does not model them.
class X86_64DisassemblyPrinter(buf: StringBuilder) extends X86_64DisVisitor {
	var ok: bool;		// false if the last instruction was illegal or unsupported

	def visit(p: X86_64Prefix.set, name: string, mode: X86_64AddrMode) {
		ok = true;
		putPrefixes(p);
		buf.puts(name);
		if (mode != X86_64AddrMode.none) mode.renderWith(buf.sp(), p.ADDRESS_SIZE_OVERRIDE);
	}
	def unsupported(msg: string) {
		ok = false;
		buf.puts("(unsupported: ").puts(msg).putc(')');
	}
	def illegal(bytes: Range<byte>) {
		ok = false;
		buf.puts("(bad)");
	}
	private def putPrefixes(p: X86_64Prefix.set) {
		if (p.LOCK) buf.puts("lock ");
		if (p.REP) buf.puts("rep ");
		if (p.REPNE) buf.puts("repne ");
		if (p.CS_OVERRIDE) buf.puts("cs ");
		if (p.SS_OVERRIDE) buf.puts("ss ");
		if (p.DS_OVERRIDE) buf.puts("ds ");
		if (p.ES_OVERRIDE) buf.puts("es ");
		if (p.FS_OVERRIDE) buf.puts("fs ");
		if (p.GS_OVERRIDE) buf.puts("gs ");
	}
}

// The comparison predicates of 0x0F 0xC2, indexed by (encoding kind * 8 + imm8).
def CMP_SSE = [
	"cmpeqps", "cmpltps", "cmpleps", "cmpunordps", "cmpneqps", "cmpnltps", "cmpnleps", "cmpordps",
	"cmpeqpd", "cmpltpd", "cmplepd", "cmpunordpd", "cmpneqpd", "cmpnltpd", "cmpnlepd", "cmpordpd",
	"cmpeqss", "cmpltss", "cmpless", "cmpunordss", "cmpneqss", "cmpnltss", "cmpnless", "cmpordss",
	"cmpeqsd", "cmpltsd", "cmplesd", "cmpunordsd", "cmpneqsd", "cmpnltsd", "cmpnlesd", "cmpordsd"
];
def CMP_SSE_GENERIC = ["cmpps", "cmppd", "cmpss", "cmpsd"];

// The eight MMX registers, modelled as SSE registers so that they can share the
// same operand shapes. They alias the x87 stack and are never REX-extended.
def MMX_REGS = [
	X86_64Xmmr.new("mm0", 0), X86_64Xmmr.new("mm1", 1),
	X86_64Xmmr.new("mm2", 2), X86_64Xmmr.new("mm3", 3),
	X86_64Xmmr.new("mm4", 4), X86_64Xmmr.new("mm5", 5),
	X86_64Xmmr.new("mm6", 6), X86_64Xmmr.new("mm7", 7)
];

// The 3DNow! opcode map. These instructions place their opcode in a byte that
// follows the operands rather than preceding them.
def AMD_3DNOW = buildAmd3DNow();
def buildAmd3DNow() -> Array<string> {
	var t = Array<string>.new(256);
	t[0x0C] = "pi2fw";	t[0x0D] = "pi2fd";	t[0x1C] = "pf2iw";
	t[0x1D] = "pf2id";	t[0x8A] = "pfnacc";	t[0x8E] = "pfpnacc";
	t[0x90] = "pfcmpge";	t[0x94] = "pfmin";	t[0x96] = "pfrcp";
	t[0x97] = "pfrsqrt";	t[0x9A] = "pfsub";	t[0x9E] = "pfadd";
	t[0xA0] = "pfcmpgt";	t[0xA4] = "pfmax";	t[0xA6] = "pfrcpit1";
	t[0xA7] = "pfrsqit1";	t[0xAA] = "pfsubr";	t[0xAE] = "pfacc";
	t[0xB0] = "pfcmpeq";	t[0xB4] = "pfmul";	t[0xB6] = "pfrcpit2";
	t[0xB7] = "pmulhrw";	t[0xBB] = "pswapd";	t[0xBF] = "pavgusb";
	return t;
}

// The named forms of pclmulqdq, indexed by the immediate. Only the combinations
// that use no reserved bits have a mnemonic of their own.
def PCLMUL = buildPclmul();
def buildPclmul() -> Array<string> {
	var t = Array<string>.new(256);
	t[0x00] = "pclmullqlqdq";
	t[0x01] = "pclmulhqlqdq";
	t[0x10] = "pclmullqhqdq";
	t[0x11] = "pclmulhqhqdq";
	return t;
}
