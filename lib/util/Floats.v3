// Utilities for rendering and parsing 32-bit floating point numbers in decimal.
// See {FpConv} for the algorithms.
component Floats {
	private def MBITS = 24;
	private def BIAS = 127;

	// Render {val} into the array {a} starting at {pos}, using the shortest decimal
	// that parses back to {val}. Returns the number of characters output.
	def renderFloat(val: float, a: Array<byte>, pos: int) -> int {
		return FpConv.render(u32.view(val), MBITS, BIAS, a, pos);
	}
	// Render {val} correctly rounded to {dd} decimal places into the array {a}
	// starting at {pos}. Digits past the 9th significant digit are rendered as zero.
	// Returns the number of characters output.
	def renderFloatDecimalDigits(val: float, dd: u32, a: Array<byte>, pos: int) -> int {
		return FpConv.renderDecimals(u32.view(val), MBITS, BIAS, int.!(dd), 9, a, pos);
	}
	// Parse a decimal floating point number "[-]digits[.digits][(e|E)[+|-]digits]",
	// "[-]Infinity", or "[-]NaN" beginning at {a[pos]}, rounding to the nearest float.
	// Returns the number of characters read (<= 0 on failure) and the value.
	def parseFloat(a: Array<byte>, pos: int) -> (int, float) {
		var r = FpConv.parseDecimal(a, pos, MBITS, BIAS);
		return (r.0, float.view(u32.view(r.1)));
	}
	// Compute the shortest decimal {d * 10^p} that parses back to {val}, which must
	// be finite and nonzero.
	def shortest(val: float) -> (u64, int) {
		var r = FpConv.unpack(u32.view(val), MBITS, BIAS);
		return FpConv.shortest(r.0, r.1, MBITS, BIAS);
	}
}
