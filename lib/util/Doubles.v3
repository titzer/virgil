// Utilities for rendering and parsing 64-bit floating point numbers in decimal.
// See {FpConv} for the algorithms.
component Doubles {
	private def MBITS = 53;
	private def BIAS = 1023;

	// Render {val} into the array {a} starting at {pos}, using the shortest decimal that parses
	// back to {val}. Returns the number of characters output.
	def renderDouble(val: double, a: Array<byte>, pos: int) -> int {
		return FpConv.render(u64.view(val), MBITS, BIAS, a, pos);
	}
	// Render {val} correctly rounded to {dd} decimal places into the array {a} starting at {pos}.
	// Digits past the 17th significant digit are zero. Returns the number of characters output.
	def renderDoubleDecimalDigits(val: double, dd: u32, a: Array<byte>, pos: int) -> int {
		return FpConv.renderDecimals(u64.view(val), MBITS, BIAS, int.!(dd), 17, a, pos);
	}
	// Parse a decimal floating point number "[-]digits[.digits][(e|E)[+|-]digits]", "[-]Infinity",
	// or "[-]NaN" beginning at {a[pos]}, rounding to the nearest double. Returns the number of
	// characters read (<= 0 on failure) and the value.
	def parseDouble(a: Array<byte>, pos: int) -> (int, double) {
		var r = FpConv.parseDecimal(a, pos, MBITS, BIAS);
		return (r.0, double.view(r.1));
	}
	// Compute the shortest {d * 10^p} that parses back to {val}, which must be finite and nonzero.
	def shortest(val: double) -> (u64, int) {
		return FpConv.shortest(u64.view(val), MBITS, BIAS);
	}
}
